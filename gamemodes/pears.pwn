	{
		ShowDialog(playerid,560,DIALOG_STYLE_LIST,"{0088ff}Коньки на прокат","{ff9000}* {FFFFFF}10 минут {00cc00}[ 800$ ]\n{ff9000}* {FFFFFF}20 минут {00cc00}[ 1300$ ]\n{ff9000}* {FFFFFF}30 минут {00cc00}[ 3000$ ]\n{ff9000}* {FFFFFF}1 час {00cc00}[ 5000$ ]","Выбор","Отмена");
