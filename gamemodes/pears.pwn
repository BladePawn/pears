        format(stro,sizeof(stro),"\n\n\n{444444}- Чем выше ваш навык силы, тем больше предметов вы сможете носить на спине"), strcat(sctringo,stro);
        format(stro,sizeof(stro),"\n{444444}- Любые предметы, собранные на месте крушения НЛО, вы можете использовать"), strcat(sctringo,stro);
