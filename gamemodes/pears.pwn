stock ShowMapBus(playerid, station)
{
	if(GetPVarInt(playerid,"antiflood") > 0) return ErrorMessage(playerid, "{FF6347}Пожалуйста, подождите 3 секунды и повторите попытку");
	TP[0][playerid] = station;
    PlayerPlaySound(playerid,40405,0,0,0);
    UpdateDriverBus(playerid);
    OnlineInfo[playerid][oShowInterface] = 10;
    TextDrawShowForPlayer(playerid, BusDraw[0]);
    TextDrawShowForPlayer(playerid, BusDraw[1]);
    //TextDrawShowForPlayer(playerid, BusDraw[2]);
    //TextDrawShowForPlayer(playerid, BusDraw[3]);
    TextDrawShowForPlayer(playerid, BusDraw[4]);
    TextDrawShowForPlayer(playerid, BusDraw[5]);
    
    /*InfoBusDraw[0][playerid] = CreatePlayerTextDraw(playerid, 207.459976, 388.866546, "0"); // Сколько водителей на дежурстве
	PlayerTextDrawLetterSize(playerid, InfoBusDraw[0][playerid], 0.310903, 1.557997);
	PlayerTextDrawAlignment(playerid, InfoBusDraw[0][playerid], TEXT_DRAW_ALIGN:1);
	PlayerTextDrawColour(playerid, InfoBusDraw[0][playerid], -1061109505);
	PlayerTextDrawUseBox(playerid, InfoBusDraw[0][playerid], true);
	PlayerTextDrawBoxColour(playerid, InfoBusDraw[0][playerid], 0);
	PlayerTextDrawSetShadow(playerid, InfoBusDraw[0][playerid], 0);
	PlayerTextDrawSetOutline(playerid, InfoBusDraw[0][playerid], 0);
	PlayerTextDrawBackgroundColour(playerid, InfoBusDraw[0][playerid], 51);
	PlayerTextDrawFont(playerid, InfoBusDraw[0][playerid], TEXT_DRAW_FONT:1);
	PlayerTextDrawSetProportional(playerid, InfoBusDraw[0][playerid], true);

	InfoBusDraw[1][playerid] = CreatePlayerTextDraw(playerid, 262.324066, 388.799865, "00:00"); // Через сколько приедет транспорт
	PlayerTextDrawLetterSize(playerid, InfoBusDraw[1][playerid], 0.310903, 1.557997);
	PlayerTextDrawAlignment(playerid, InfoBusDraw[1][playerid], TEXT_DRAW_ALIGN:1);
	PlayerTextDrawColour(playerid, InfoBusDraw[1][playerid], -1061109505);
	PlayerTextDrawUseBox(playerid, InfoBusDraw[1][playerid], true);
	PlayerTextDrawBoxColour(playerid, InfoBusDraw[1][playerid], 0);
	PlayerTextDrawSetShadow(playerid, InfoBusDraw[1][playerid], 0);
	PlayerTextDrawSetOutline(playerid, InfoBusDraw[1][playerid], 0);
	PlayerTextDrawBackgroundColour(playerid, InfoBusDraw[1][playerid], 51);
	PlayerTextDrawFont(playerid, InfoBusDraw[1][playerid], TEXT_DRAW_FONT:1);
	PlayerTextDrawSetProportional(playerid, InfoBusDraw[1][playerid], true);*/

	// Остановки
	for(new sta = 1; sta < MAX_BUSSTATION; sta++)
	{
		if(BusStationInfo[sta][bsActive] != 1)
		{
			continue;
		}
	    new Float:b_pos[2];
		b_pos[0] = BusStationInfo[sta][bsCordX], b_pos[1] = BusStationInfo[sta][bsCordY];
 		GetCoordMapDraw(b_pos[0], b_pos[1]);
		StationBusDraw[sta][playerid] = CreatePlayerTextDraw(playerid, b_pos[0], b_pos[1], "hud:radar_light"); // Остановка
		PlayerTextDrawLetterSize(playerid, StationBusDraw[sta][playerid], 0.013872, 0.004666);
		PlayerTextDrawTextSize(playerid, StationBusDraw[sta][playerid], 9.748093, 11.666679);
		PlayerTextDrawAlignment(playerid, StationBusDraw[sta][playerid], TEXT_DRAW_ALIGN:1);
		PlayerTextDrawColour(playerid, StationBusDraw[sta][playerid], -5963521);
		PlayerTextDrawSetShadow(playerid, StationBusDraw[sta][playerid], 0);
		PlayerTextDrawSetOutline(playerid, StationBusDraw[sta][playerid], 0);
		PlayerTextDrawFont(playerid, StationBusDraw[sta][playerid], TEXT_DRAW_FONT:4);
		PlayerTextDrawSetSelectable(playerid, StationBusDraw[sta][playerid], true);
		PlayerTextDrawShow(playerid, StationBusDraw[sta][playerid]);
	}
    
    new Float:b_pos[2];
	b_pos[0] = Protect_X[playerid], b_pos[1] = Protect_Y[playerid];
 	GetCoordMapDraw(b_pos[0], b_pos[1]);
 	PlayerBusDraw[playerid] = CreatePlayerTextDraw(playerid, b_pos[0], b_pos[1], "hud:radar_centre"); // Я отмечен на карте
	PlayerTextDrawLetterSize(playerid, PlayerBusDraw[playerid], 0.013872, 0.004666);
	PlayerTextDrawTextSize(playerid, PlayerBusDraw[playerid], 6.748680, 7.933344);
	PlayerTextDrawAlignment(playerid, PlayerBusDraw[playerid], TEXT_DRAW_ALIGN:1);
	PlayerTextDrawColour(playerid, PlayerBusDraw[playerid], -16776961);
	PlayerTextDrawSetShadow(playerid, PlayerBusDraw[playerid], 0);
	PlayerTextDrawSetOutline(playerid, PlayerBusDraw[playerid], 0);
	PlayerTextDrawFont(playerid, PlayerBusDraw[playerid], TEXT_DRAW_FONT:4);
	PlayerTextDrawShow(playerid, PlayerBusDraw[playerid]);
	
    SelectColorDraw(playerid);
	return 1;
}
stock CloseMapBus(playerid)
{
    SetPVarInt(playerid,"antiflood",3);
	OnlineInfo[playerid][oShowInterface] = 0;
    TextDrawHideForPlayer(playerid, BusDraw[0]);
    TextDrawHideForPlayer(playerid, BusDraw[1]);
    //TextDrawHideForPlayer(playerid, BusDraw[2]);
    //TextDrawHideForPlayer(playerid, BusDraw[3]);
    TextDrawHideForPlayer(playerid, BusDraw[4]);
    TextDrawHideForPlayer(playerid, BusDraw[5]);

    //PlayerTextDrawHide(playerid, InfoBusDraw[0][playerid]), PlayerTextDrawDestroy(playerid, InfoBusDraw[0][playerid]);
    //PlayerTextDrawHide(playerid, InfoBusDraw[1][playerid]), PlayerTextDrawDestroy(playerid, InfoBusDraw[1][playerid]);
    PlayerTextDrawHide(playerid, PlayerBusDraw[playerid]), PlayerTextDrawDestroy(playerid, PlayerBusDraw[playerid]);

    // Остановки и Автобусы
    for(new sta = 1; sta < MAX_BUSSTATION; sta++) PlayerTextDrawHide(playerid, StationBusDraw[sta][playerid]), PlayerTextDrawDestroy(playerid, StationBusDraw[sta][playerid]);
    for(new bdr = 0; bdr < MAX_BUSDRIVER; bdr++) PlayerTextDrawHide(playerid, BusBusDraw[bdr][playerid]), PlayerTextDrawDestroy(playerid, BusBusDraw[bdr][playerid]);
	return 1;
}
stock GetCoordMapDraw(&Float:X, &Float:Y)
{
    // (верх низ Y) 82,200187
	// (лево право X) 181,714752
	// DeathDraw[5] = TextDrawCreate(181.714752, 82.200187, "hud:radar_centre"); // Верхний Левый 		X = -3000.0, Y = 3000.0
	// DeathDraw[6] = TextDrawCreate(446.663360, 82.200187, "hud:radar_centre"); // Верхний Правый  	X = 3000.0, Y = 3000.0
	// DeathDraw[7] = TextDrawCreate(181.714752, 380.066833, "hud:radar_centre"); // Нижний Левый      X = -3000.0, Y = -3000.0
	// DeathDraw[8] = TextDrawCreate(446.663360, 380.066833, "hud:radar_centre"); // Нижний Правый     X = 3000.0, Y = -3000.0
    /*new Float:distmap_X = 264,948608;
	new Float:distmap_Y = 297,866646;
	new Float:onedel_X = distmap_X/6000.0;
	new Float:onedel_Y = distmap_Y/6000.0;*/
	
	
	if(X <= -3000.0) X = 181.714752;
	else if(X >= 3000.0) X = 446.663360;
	else
	{
		if(X < 0.0) X = 3000.0-floatabs(X);
		else X += 3000.0;
	    new Float:koef_pos = 6000/X;
    	new Float:proc_pos = 100/koef_pos;
	    new Float:koef_map = 264.948608/100;
	    new Float:proc_map = proc_pos*koef_map;
		X = 181.714752+proc_map-2.5;
	}
	
	if(Y <= -3000.0) Y = 380.066833;
	else if(Y >= 3000.0) Y = 82.200187;
	else
	{
	    if(Y < 0.0) Y = 3000.0-floatabs(Y);
		else Y += 3000.0;
	    new Float:koef_pos = 6000/Y;
    	new Float:proc_pos = 100/koef_pos;
	    new Float:koef_map = 297.866646/100;
	    new Float:proc_map = proc_pos*koef_map;
		Y = 380.066833-proc_map-2.0;
	}
	return 1;
}
stock UpdateDriverBus(playerid)
{
	for(new i = 0; i < MAX_BUSDRIVER; i++)
	{
	    if(OnlineInfo[playerid][oShowInterface] == 10) PlayerTextDrawHide(playerid, BusBusDraw[i][playerid]), PlayerTextDrawDestroy(playerid, BusBusDraw[i][playerid]);
		new Float:b_pos[2];
		if(busdriverid[i] > 0) b_pos[0] = Protect_X[busdriverid[i]-1], b_pos[1] = Protect_Y[busdriverid[i]-1];
        GetCoordMapDraw(b_pos[0], b_pos[1]);
    	BusBusDraw[i][playerid] = CreatePlayerTextDraw(playerid, b_pos[0], b_pos[1], "hud:radar_impound"); // Автобусы и Водители
		PlayerTextDrawLetterSize(playerid, BusBusDraw[i][playerid], 0.013872, 0.004666);
		PlayerTextDrawTextSize(playerid, BusBusDraw[i][playerid], 7.873460, 9.333343);
		PlayerTextDrawAlignment(playerid, BusBusDraw[i][playerid], TEXT_DRAW_ALIGN:1);
		PlayerTextDrawColour(playerid, BusBusDraw[i][playerid], -1);
		PlayerTextDrawUseBox(playerid, BusBusDraw[i][playerid], true);
		PlayerTextDrawBoxColour(playerid, BusBusDraw[i][playerid], 0);
		PlayerTextDrawSetShadow(playerid, BusBusDraw[i][playerid], 0);
		PlayerTextDrawSetOutline(playerid, BusBusDraw[i][playerid], 0);
		PlayerTextDrawFont(playerid, BusBusDraw[i][playerid], TEXT_DRAW_FONT:4);
		PlayerTextDrawSetSelectable(playerid, BusBusDraw[i][playerid], true);
		if(busdriverid[i] > 0) PlayerTextDrawShow(playerid, BusBusDraw[i][playerid]);
 	}
	return 1;
}
stock PosSpecDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    
    if(setting_pos_draw[playerid] == 14 || setting_size_draw[playerid] == 14) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	else sized_x = PlayerInfo[playerid][pDrawSize_X][13], sized_y = PlayerInfo[playerid][pDrawSize_Y][13];
	if(Device[playerid] == 1) sized_y += DrawSizeSmart_Y[13];
    
    if(setting_pos_draw[playerid] == 14 || setting_size_draw[playerid] == 14) positiond_x = specdraw_x+set_pos_x[playerid], positiond_y = specdraw_y-(41.0+sized_y)+set_pos_y[playerid];
    else positiond_x = specdraw_x+PlayerInfo[playerid][pDrawPos_X][13], positiond_y = specdraw_y-(41.0+sized_y)+PlayerInfo[playerid][pDrawPos_Y][13];
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[13], positiond_y += DrawPosSmart_Y[13];
	
	new Float:vrem_x, Float:vrem_y, Float:vrem_x2, Float:vrem_y2;
	new Float:otstyp_y = 7.0+sized_y/4;
	new Float:textsize_x = 0.147433+sized_x*(0.147433/80), Float:textsize_y = 0.741333+sized_y*(0.741333/50);
	// 190,0 407,0
	
	// Нулевой Блок
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[0][playerid], positiond_x, positiond_y); // фон основной панели
    PlayerTextDrawTextSize(playerid, PlayerSpecDraw[0][playerid], 145.0+sized_x*2, 41.0+sized_y);
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[1][playerid], positiond_x+3.0, positiond_y+3.0); // имя игрока + id
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[1][playerid], 0.182677+sized_x*(0.182677/100), 0.913999+sized_y*(0.913999/50));
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[8][playerid], positiond_x+3.0, positiond_y+14.0+sized_y/3); // моделька скина игрока
    PlayerTextDrawTextSize(playerid, PlayerSpecDraw[8][playerid], 23.0+sized_x/4, 23.0+sized_y/2);
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[3][playerid], positiond_x+4.0+23.0+sized_x/4+4.0, positiond_y+14.0+sized_y/4); // хп и броня игрока
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[3][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // хп и броня игрока
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[2][playerid], positiond_x+4.0+23.0+sized_x/4+4.0, positiond_y+14.2+sized_y/4+otstyp_y); // оружие и патроны в руках
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[2][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // оружие и патроны в руках
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[12][playerid], positiond_x+4.0+23.0+sized_x/4+4.0, positiond_y+14.4+sized_y/4+otstyp_y*2); // баны, варны на аккаунте
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[12][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // баны, варны на аккаунте
   	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[3][playerid], vrem_x, vrem_y);
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[5][playerid], (positiond_x+145.0+sized_x*2)-4.0, vrem_y); // пинг
   	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[5][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // пинг
   	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[2][playerid], vrem_x, vrem_y);
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[6][playerid], (positiond_x+145.0+sized_x*2)-4.0, vrem_y); // loss
   	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[6][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // loss
   	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[12][playerid], vrem_x, vrem_y);
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[9][playerid], (positiond_x+145.0+sized_x*2)-4.0, vrem_y); // afk
   	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[9][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // afk
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[15][playerid], (positiond_x+145.0+sized_x*2)-4.0, positiond_y+4.0); // текущее время
   	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[15][playerid], 0.147433+sized_x*(0.147433/80), 0.741333+sized_y*(0.741333/50)); // текущее время
   	
   	// Первый Блок (Транспорт)
   	PlayerTextDrawTextSize(playerid, PlayerSpecDraw[20][playerid], 145.0+sized_x*2, 41.0+sized_y);
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[20][playerid], positiond_x, positiond_y-(41.0+sized_y)-1.0); // фон основной панели
   	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[20][playerid], vrem_x, vrem_y);
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[21][playerid], vrem_x+3.0, vrem_y+14.0+sized_y/3); // картинка транспорта
    PlayerTextDrawTextSize(playerid, PlayerSpecDraw[21][playerid], 23.0+sized_x/4, 23.0+sized_y/2);
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[22][playerid], vrem_x+3.0, vrem_y+3.0); // название транспорт, его id и модель
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[22][playerid], 0.182677+sized_x*(0.182677/100), 0.913999+sized_y*(0.913999/50));
   	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[23][playerid], vrem_x+4.0+23.0+sized_x/4+4.0, vrem_y+14.0+sized_y/4); // hp транспорта
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[23][playerid], textsize_x, textsize_y); // hp транспорта
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[24][playerid], vrem_x+4.0+23.0+sized_x/4+4.0, vrem_y+14.2+sized_y/4+otstyp_y); // топливо
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[24][playerid], textsize_x, textsize_y); // топливо
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[25][playerid], vrem_x+4.0+23.0+sized_x/4+4.0, vrem_y+14.4+sized_y/4+otstyp_y*2); // статус двигателя
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[25][playerid], textsize_x, textsize_y); // статус двигателя
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[26][playerid], (vrem_x+145.0+sized_x*2)-4.0, vrem_y+14.0+sized_y/4); // текущая скорость
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[26][playerid], textsize_x, textsize_y); // текущая скорость
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[27][playerid], (vrem_x+145.0+sized_x*2)-4.0, vrem_y+14.2+sized_y/4+otstyp_y); // подпись km/h
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[27][playerid], textsize_x, textsize_y); // подпись km/h
    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[28][playerid], (vrem_x+145.0+sized_x*2)-4.0, vrem_y+14.4+sized_y/4+otstyp_y*2); // максимальная скорость этого транспорта
    PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[28][playerid], textsize_x, textsize_y); // максимальная скорость этого транспорта
    
	// Кнопка More
	new Float:razm_left_x, Float:razm_left_y;
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[0][playerid], vrem_x, vrem_y);
	PlayerTextDrawTextSize(playerid, PlayerSpecDraw[29][playerid], 41.0+sized_x, 41.0+sized_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[29][playerid], vrem_x-(41.0+sized_x)-1.0, vrem_y); // кнопка more (меню админов)
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[29][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlayerSpecDraw[29][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[30][playerid], vrem_x+razm_left_x/2, (vrem_y+razm_left_y/2)-4.0-sized_y/8); // надпись more
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[30][playerid], 0.241165+sized_x*(0.241165/80), 1.100667+sized_y*(1.100667/50)); // надпись more
	
	// Второй Блок (Организация игрока)
    UpdateBlock1(playerid);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[4][playerid], vrem_x, vrem_y);
	PlayerTextDrawTextSize(playerid, PlayerSpecDraw[14][playerid], 14.0+sized_x/4, 16.0+sized_y/2);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[4][playerid], vrem_x2, vrem_y2);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[3][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[10][playerid], vrem_x2+3.0, vrem_y); // название организации
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[10][playerid], textsize_x, textsize_y);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[2][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[11][playerid], vrem_x2+3.0, vrem_y); // ранг в организации
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[11][playerid], textsize_x, textsize_y);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[12][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[13][playerid], vrem_x2+3.0, vrem_y); // выговоры
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[13][playerid], textsize_x, textsize_y);
	
	// Третий Блок (Геопозиция игрока)
	UpdateBlock2(playerid);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[7][playerid], vrem_x, vrem_y);
	PlayerTextDrawTextSize(playerid, PlayerSpecDraw[16][playerid], 14.0+sized_x/4, 16.0+sized_y/2);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[7][playerid], vrem_x2, vrem_y2);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[3][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[17][playerid], vrem_x2+3.0, vrem_y); // ip
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[17][playerid], textsize_x, textsize_y);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[2][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[18][playerid], vrem_x2+3.0, vrem_y); // страна
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[18][playerid], textsize_x, textsize_y);
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[12][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[19][playerid], vrem_x2+3.0, vrem_y); // город
	PlayerTextDrawLetterSize(playerid, PlayerSpecDraw[19][playerid], textsize_x, textsize_y);
	return 1;
}
stock UpdateBlock2(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 14 || setting_size_draw[playerid] == 14) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	else sized_x = PlayerInfo[playerid][pDrawSize_X][13], sized_y = PlayerInfo[playerid][pDrawSize_Y][13];
	if(Device[playerid] == 1) sized_y += DrawSizeSmart_Y[13];
    
    if(setting_pos_draw[playerid] == 14 || setting_size_draw[playerid] == 14) positiond_x = specdraw_x+set_pos_x[playerid], positiond_y = (specdraw_y-(41.0+sized_y))+set_pos_y[playerid];
    else positiond_x = specdraw_x+PlayerInfo[playerid][pDrawPos_X][13], positiond_y = (specdraw_y-(41.0+sized_y))+PlayerInfo[playerid][pDrawPos_Y][13];
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[13], positiond_y += DrawPosSmart_Y[13];

    new Float:razm_left_x, Float:razm_left_y, Float:razm_left_x2, Float:razm_left_y2;
    PlayerTextDrawGetTextSize(playerid, PlayerSpecDraw[0][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawGetTextSize(playerid, PlayerSpecDraw[4][playerid], razm_left_x2, razm_left_y2);
	if(PlayerInfo[playerid][pAspecBlock2] == false)
	{
	    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[7][playerid], positiond_x+razm_left_x+1.0+razm_left_x2+1.0, positiond_y); // фон скрытой информации игрока (ip и город)
		PlayerTextDrawTextSize(playerid, PlayerSpecDraw[7][playerid], 66.0+sized_x, razm_left_y);
		PlayerTextDrawSetPreviewRot(playerid, PlayerSpecDraw[16][playerid], 0.000000, 0.000000, 90.000000, 1.000000);
	}
	else
	{
	    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[7][playerid], positiond_x+razm_left_x+1.0+razm_left_x2+1.0, positiond_y+razm_left_y/2); // фон скрытой информации игрока (ip и город)
	    PlayerTextDrawTextSize(playerid, PlayerSpecDraw[7][playerid], 66.0+sized_x, razm_left_y/2);
	    PlayerTextDrawSetPreviewRot(playerid, PlayerSpecDraw[16][playerid], 0.000000, 180.000000, 90.000000, 1.000000);
	}
	new Float:vrem_x, Float:vrem_y;
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[7][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[16][playerid], vrem_x+((66.0+sized_x)/2)-((18.0+sized_x/4)/2), vrem_y-sized_y/8); // кнопка скрыть второе меню
	return 1;
}
stock UpdateBlock1(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 14 || setting_size_draw[playerid] == 14) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	else sized_x = PlayerInfo[playerid][pDrawSize_X][13], sized_y = PlayerInfo[playerid][pDrawSize_Y][13];
	if(Device[playerid] == 1) sized_y += DrawSizeSmart_Y[13];
    
    if(setting_pos_draw[playerid] == 14 || setting_size_draw[playerid] == 14) positiond_x = specdraw_x+set_pos_x[playerid], positiond_y = (specdraw_y-(41.0+sized_y))+set_pos_y[playerid];
    else positiond_x = specdraw_x+PlayerInfo[playerid][pDrawPos_X][13], positiond_y = (specdraw_y-(41.0+sized_y))+PlayerInfo[playerid][pDrawPos_Y][13];
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[13], positiond_y += DrawPosSmart_Y[13];

	new Float:razm_left_x, Float:razm_left_y;
    PlayerTextDrawGetTextSize(playerid, PlayerSpecDraw[0][playerid], razm_left_x, razm_left_y);
	if(PlayerInfo[playerid][pAspecBlock1] == false)
	{
	    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[4][playerid], positiond_x+razm_left_x+1.0, positiond_y); // фон скрытой информации аккаунта (организация)
		PlayerTextDrawTextSize(playerid, PlayerSpecDraw[4][playerid], 66.0+sized_x, razm_left_y);
		PlayerTextDrawSetPreviewRot(playerid, PlayerSpecDraw[14][playerid], 0.000000, 0.000000, 90.000000, 1.000000);
	}
	else
	{
	    PlayerTextDrawSetPos(playerid, PlayerSpecDraw[4][playerid], positiond_x+razm_left_x+1.0, positiond_y+razm_left_y/2); // фон скрытой информации аккаунта (организация)
	    PlayerTextDrawTextSize(playerid, PlayerSpecDraw[4][playerid], 66.0+sized_x, razm_left_y/2);
	    PlayerTextDrawSetPreviewRot(playerid, PlayerSpecDraw[14][playerid], 0.000000, 180.000000, 90.000000, 1.000000);
	}
	new Float:vrem_x, Float:vrem_y;
	PlayerTextDrawGetPos(playerid, PlayerSpecDraw[4][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSpecDraw[14][playerid], vrem_x+((66.0+sized_x)/2)-((18.0+sized_x/4)/2), vrem_y-sized_y/8); // кнопка скрыть первое меню
	return 1;
}
stock UpdateSpecSkin(playerid, para)
{
    if(IsOnline(para)) PlayerTextDrawSetPreviewModel(playerid, PlayerSpecDraw[8][playerid], GetSkinPresentation(playerid, para)), PlayerTextDrawShow(playerid, PlayerSpecDraw[8][playerid]);
}
stock UpdateSpecEngine(playerid, para)
{
    if(IsOnline(para))
    {
    	if(GetPlayerState(para) == PLAYER_STATE_DRIVER)
        {
       		new vehicleid = GetPlayerVehicleID(para);
            if(VehInfo[vehicleid][vEngine] == 0) PlayerTextDrawSetString(playerid, PlayerSpecDraw[25][playerid], "Engine:_Off");
            else PlayerTextDrawSetString(playerid, PlayerSpecDraw[25][playerid], "Engine:_On");
            PlayerTextDrawShow(playerid, PlayerSpecDraw[25][playerid]); // статус двигателя
        }
    }
}
stock HideSpecBlock0(playerid)
{
    PlayerTextDrawHide(playerid, PlayerSpecDraw[20][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[21][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[22][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[23][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[24][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[25][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[26][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[27][playerid]);
    PlayerTextDrawHide(playerid, PlayerSpecDraw[28][playerid]);
	return 1;
}
stock ShowSpecPlayer(stat, playerid, para)
{
	new string[100];
	if(stat == 0)
	{
		PlayerTextDrawShow(playerid, PlayerSpecDraw[0][playerid]); // фон основной панели
		format(string, sizeof(string), "%s_[id:_%d]", PlayerInfo[para][pName], para);
	    PlayerTextDrawSetString(playerid, PlayerSpecDraw[1][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[1][playerid]); // имя игрока + id
		format(string, sizeof(string), "BAN:_%d/5_WARN:_%d/%d", PlayerInfo[para][pBanMonzz], PlayerInfo[para][pWarns], MAX_WARNS);
	    PlayerTextDrawSetString(playerid, PlayerSpecDraw[12][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[12][playerid]); // баны, варны на аккаунте
		UpdateSpecBlock0(playerid, para);
		UpdateSpecSkin(playerid, para);
		if(PlayerInfo[playerid][pAspecBlock3] == false)
		{
			PlayerTextDrawShow(playerid, PlayerSpecDraw[29][playerid]); // Кнопка More
			PlayerTextDrawShow(playerid, PlayerSpecDraw[30][playerid]); // Надпись More
		}
	}
	else if(stat == 1)
	{
	    if(GetPlayerState(para) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(para);
	    	PlayerTextDrawShow(playerid, PlayerSpecDraw[20][playerid]); // фон информации о транспорте
	    	PlayerTextDrawSetPreviewModel(playerid, PlayerSpecDraw[21][playerid], GetVehicleModelSync(playerid, VehInfo[vehicleid][vModel]));
	    	PlayerTextDrawSetPreviewVehicleColours(playerid, PlayerSpecDraw[21][playerid], VehInfo[vehicleid][vVehcol1], VehInfo[vehicleid][vVehcol2]);
	    	PlayerTextDrawShow(playerid, PlayerSpecDraw[21][playerid]); // картинка транспорта
	    	format(string, sizeof(string), "%s_[id:_%d]___Model:_%d", GetVehicleName(VehInfo[vehicleid][vModel]), vehicleid, VehInfo[vehicleid][vModel]);
	    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[22][playerid], string);
			PlayerTextDrawShow(playerid, PlayerSpecDraw[22][playerid]); // название транспорт, его id и модель
			UpdateSpecEngine(playerid, para);
			PlayerTextDrawShow(playerid, PlayerSpecDraw[27][playerid]); // подпись km/h
			format(string, sizeof(string), "Max_Speed:_%d", GetVehicleSpeedMax(GetVehModelOriginal(VehInfo[vehicleid][vModel])));
	    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[28][playerid], string);
			PlayerTextDrawShow(playerid, PlayerSpecDraw[28][playerid]);
			UpdateSpecBlock1(playerid, para);
		}
	}
	else if(stat == 2)
	{
	    PlayerTextDrawShow(playerid, PlayerSpecDraw[4][playerid]);
	    PlayerTextDrawShow(playerid, PlayerSpecDraw[14][playerid]); // Кнопка Скрыть Меню
	    format(string, sizeof(string), "%s_[id:_%d]", frakDraw[fraction(para)], fraction(para));
    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[10][playerid], string);
    	format(string, sizeof(string), "Rank:_%d", PlayerInfo[para][pRank]);
    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[11][playerid], string);
    	format(string, sizeof(string), "Vig:_%d/5", PlayerInfo[para][pVig]);
    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[13][playerid], string);
	    if(PlayerInfo[playerid][pAspecBlock1] == false)
	    {
		    PlayerTextDrawShow(playerid, PlayerSpecDraw[10][playerid]); // название организации
		    PlayerTextDrawShow(playerid, PlayerSpecDraw[11][playerid]); // ранг в организации
		    PlayerTextDrawShow(playerid, PlayerSpecDraw[13][playerid]); // выговоры
	    }
	}
	else if(stat == 3)
	{
	    PlayerTextDrawShow(playerid, PlayerSpecDraw[7][playerid]);
	    PlayerTextDrawShow(playerid, PlayerSpecDraw[16][playerid]); // Кнопка Скрыть Меню
	    format(string, sizeof(string), "%s", PlayerInfo[para][pPlaIP]);
    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[17][playerid], string);
    	format(string, sizeof(string), "%s", GetPlayerCountry(para));
    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[18][playerid], string);
    	format(string, sizeof(string), "%s", GetPlayerCity(para));
    	PlayerTextDrawSetString(playerid, PlayerSpecDraw[19][playerid], string);
	    if(PlayerInfo[playerid][pAspecBlock2] == false)
	    {
		    PlayerTextDrawShow(playerid, PlayerSpecDraw[17][playerid]); // ip
		    PlayerTextDrawShow(playerid, PlayerSpecDraw[18][playerid]); // страна
		    PlayerTextDrawShow(playerid, PlayerSpecDraw[19][playerid]); // город
	    }
	}
	return 1;
}
stock UpdateSpecBlock0(playerid, para)
{
	new string[100];
    if(IsOnline(para))
	{
	    format(string, sizeof(string), "Weapon:_%s_[id:_%d]_Ammo:_%d", gunDraw[GetPlayerWeapon(para)], GetPlayerWeapon(para), GetPlayerAmmo(para));
		PlayerTextDrawSetString(playerid, PlayerSpecDraw[2][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[2][playerid]); // оружие и патроны в руках
		format(string, sizeof(string), "HP:_%.2f_ARMOR:_%.2f", HealthAC[para], PlayerInfo[para][pArmor]);
		PlayerTextDrawSetString(playerid, PlayerSpecDraw[3][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[3][playerid]); // хп и броня игрока
		format(string, sizeof(string), "Ping:_%d", GetPlayerPing(para));
		PlayerTextDrawSetString(playerid, PlayerSpecDraw[5][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[5][playerid]); // пинг
		format(string, sizeof(string), "Loss:_%.3f", NetStats_PacketLossPercent(para));
		PlayerTextDrawSetString(playerid, PlayerSpecDraw[6][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[6][playerid]); // loss

		new tmin = 0, sek = 0, year, month, day, tmphour, tmpminute, tmpsecond;
		getdate(year, month, day);
		gettime(tmphour, tmpminute, tmpsecond);
		if(GetPVarInt(para,"afksystem") >= 3)
		{
			tmin = GetPVarInt(para,"afksystem")/60;
			sek = GetPVarInt(para,"afksystem")-(tmin*60);
		}
		format(string, sizeof(string), "AFK:_%02d:%02d", tmin, sek);
		PlayerTextDrawSetString(playerid, PlayerSpecDraw[9][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[9][playerid]); // afk
		format(string, sizeof(string), "%02d.%02d.%d_%02d:%02d:%02d", day, month, year, tmphour, tmpminute, tmpsecond);
		PlayerTextDrawSetString(playerid, PlayerSpecDraw[15][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSpecDraw[15][playerid]); // текущее время
	}
	return 1;
}
stock UpdateSpecBlock1(playerid, para)
{
	if(IsOnline(para))
	{
	    if(GetPlayerState(para) == PLAYER_STATE_DRIVER)
		{
			new string[30];
		    new vehicleid = GetPlayerVehicleID(para), Float:health;
		    GetVehicleHealth(vehicleid, health);
	    	format(string, sizeof(string), "Health:_%.2f", health);
			PlayerTextDrawSetString(playerid, PlayerSpecDraw[23][playerid], string);
			PlayerTextDrawShow(playerid, PlayerSpecDraw[23][playerid]); // hp транспорта
			format(string, sizeof(string), "Benz:_%d_Helium:_%d", VehInfo[vehicleid][vGas], VehInfo[vehicleid][vGelium]);
			PlayerTextDrawSetString(playerid, PlayerSpecDraw[24][playerid], string);
			PlayerTextDrawShow(playerid, PlayerSpecDraw[24][playerid]); // топливо
		}
	}
	return 1;
}
stock SpecColorBackground(playerid, drawid)
{
	if(PlayerInfo[playerid][pAspecCol] == 1) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], 100); // Черный
	else if(PlayerInfo[playerid][pAspecCol] == 2) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], -156); // Белый
	else if(PlayerInfo[playerid][pAspecCol] == 3) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], -65446); // Желтый
	else if(PlayerInfo[playerid][pAspecCol] == 4) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], -16777126); // Красный
	else if(PlayerInfo[playerid][pAspecCol] == 5) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], 13827930); // Синий
	else if(PlayerInfo[playerid][pAspecCol] == 6) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], 2086141786); // Сереневый
	else if(PlayerInfo[playerid][pAspecCol] == 7) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], 617089882); // Зеленый
	else if(PlayerInfo[playerid][pAspecCol] == 8) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], -8397990); // Розовый
	else if(PlayerInfo[playerid][pAspecCol] == 9) PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], -8454054); // Оранжевый
	else PlayerTextDrawBackgroundColour(playerid, PlayerSpecDraw[drawid][playerid], 1521338467); // Стандартный
}
stock SpecColorText(playerid, drawid)
{
	if(PlayerInfo[playerid][pAspecText] == 1) PlayerTextDrawColour(playerid, PlayerSpecDraw[drawid][playerid], -1); // Белый
	else if(PlayerInfo[playerid][pAspecText] == 2) PlayerTextDrawColour(playerid, PlayerSpecDraw[drawid][playerid], -2139062017); // Серый
	else PlayerTextDrawColour(playerid, PlayerSpecDraw[drawid][playerid], 505290495); // Черный
}
stock UpdateIcaDraw(playerid, targetid)
{
	new string[64];
	format(string,sizeof(string),RusToGame("CallSign:_%s"),PlayerInfo[targetid][pCallSign]);
	PlayerTextDrawSetString(playerid, IcaSpecDraw[0][playerid], string);

	if(gSign[targetid] == true) format(string,sizeof(string),"Sign:_%s",GetName(targetid));
	else format(string,sizeof(string),"Sign:_Off");
	PlayerTextDrawSetString(playerid, IcaSpecDraw[1][playerid], string);
	
	if(NameTag[targetid] == true) format(string,sizeof(string),"Nametag:_On");
	else format(string,sizeof(string),"Nametag:_Off");
    PlayerTextDrawSetString(playerid, IcaSpecDraw[2][playerid], string);
    
	new r;
	if(PlayerInfo[targetid][pRank] >= 1) r = PlayerInfo[targetid][pRank]-1;
	format(string,sizeof(string),RusToGame("Rank:_%s[%d]"), RankOrg[8][r], PlayerInfo[targetid][pRank]);
    PlayerTextDrawSetString(playerid, IcaSpecDraw[3][playerid], string);
    
    PlayerTextDrawShow(playerid, IcaSpecDraw[0][playerid]);
    PlayerTextDrawShow(playerid, IcaSpecDraw[1][playerid]);
    PlayerTextDrawShow(playerid, IcaSpecDraw[2][playerid]);
    PlayerTextDrawShow(playerid, IcaSpecDraw[3][playerid]);
	return 1;
}
