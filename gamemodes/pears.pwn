stock infobiz(playerid, b)
{
	new str[214],sctring[4096];
	new year, month,day;
	getdate(year, month, day);
	format(str,sizeof(str),"{ffffff}[%02d.%02d.%d]",day,month,year), strcat(sctring,str);
 	format(str,sizeof(str),"\n\n{0088ff}* %s № %d", bizname(b), b), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Владелец: {ff9000}%s",BizzInfo[b][bVlad]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Сумма на счёте: {99ff66}%d$ [%s]",BizzInfo[b][bSchet], get_k(BizzInfo[b][bSchet])), strcat(sctring,str);
   	if(BizzInfo[b][bDeposit] < 50000) format(str,sizeof(str),"\n{cccccc}Депозит Бизнеса: {FF6347}%d$ [%s] | Требуется Пополнить!",BizzInfo[b][bDeposit], get_k(BizzInfo[b][bDeposit])), strcat(sctring,str);
   	else format(str,sizeof(str),"\n{cccccc}Депозит Бизнеса: {99ff66}%d$ [%s]",BizzInfo[b][bDeposit], get_k(BizzInfo[b][bDeposit])), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Прибыль за последний час: {cccccc}%d$",BizzInfo[b][bBablo]), strcat(sctring,str);
   	if(BizzInfo[b][bGold] > 0) format(str,sizeof(str),"\n{cccccc}Стоимость Бизнеса: {99ff66}%d$ {cccccc}(%s) {ffcc00}[ %dG ]",biz_cena(b), get_k(biz_cena(b)), BizzInfo[b][bGold]), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Стоимость Бизнеса: {99ff66}%d$ {cccccc}(%s)",biz_cena(b), get_k(biz_cena(b))), strcat(sctring,str);
   	if(IsABizInteriorFrame(b))
	{
	    new kolobj = 0;
		for(new oba = 0; oba < MAX_OBJECT_INT_BIZ; oba++)
		{
			if(BizzInfo[b][bOmodel][oba] >= 1) kolobj ++;
  		}
  		format(str,sizeof(str),"\n{cccccc}Объектов: {ffffff}%d/%d", kolobj, GetMaxBizObjects(b)), strcat(sctring,str);
	}
   	
   	if(b >= 13 && b <= 41 || b >= 123 && b <= 142 || b >= 42 && b <= 52 || b >= 62 && b <= 66 || b >= 67 && b <= 76 || b >= 163 && b <= 172) // Супермаркет, Оружейный Магазин, Аптека, Магазин с Техникой, Аренда, Банкоматы
 	{
   	    new bcity = getbiz_city(b);
   	    if(bcity == 0) format(str,sizeof(str),"\n{cccccc}Город: {cccccc}Los Santos"), strcat(sctring,str);
   	    else if(bcity == 1) format(str,sizeof(str),"\n{cccccc}Город: {cccccc}San Fierro"), strcat(sctring,str);
   	    else if(bcity == 2) format(str,sizeof(str),"\n{cccccc}Город: {cccccc}Las Venturas"), strcat(sctring,str);
   	}
   	
   	if(BizzInfo[b][bWarn] == 4) format(str,sizeof(str),"\n{cccccc}Предупреждения: {cccccc}%d/5 {FF6347}[Следующее предупреждение арестует бизнес]",BizzInfo[b][bWarn]), strcat(sctring,str);
   	else format(str,sizeof(str),"\n{cccccc}Предупреждения: {cccccc}%d/5",BizzInfo[b][bWarn]), strcat(sctring,str);
   	if(BizzInfo[b][bFam] >= 1)
  	{
  	    new f = BizzInfo[b][bFam];
  	    if(FamilyInfo[f][fSost] >= 1) format(str,sizeof(str),"\n{cccccc}Привязана Семья: {ff9000}%s [%d]",FamilyInfo[f][fName],f), strcat(sctring,str);
  	    else BizzInfo[b][bFam] = 0;
	}
	else format(str,sizeof(str),"\n{cccccc}Привязана Семья: {444444}нет"), strcat(sctring,str);

	if(BizzInfo[b][bMafia] > 0) 
	{
		format(str,sizeof(str),"\n\n{cccccc}Под контролем: %s", frakName[BizzInfo[b][bMafia]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{666666}Мафия забирает %d %% от каждого пополнения денег в бизнес\n", MAFIA_BABKI), strcat(sctring,str);
	}

   	if(BizzInfo[b][bArest] >= 1)
 	{
 		new tyear, tmonth, tday, thour, tminute, tsecond, tyear2, tmonth2, tday2, thour2, tminute2, tsecond2;
		stamp2datetime(BizzInfo[b][bArest], tyear, tmonth, tday, thour, tminute, tsecond, 3);
		stamp2datetime(BizzInfo[b][bArTime], tyear2, tmonth2, tday2, thour2, tminute2, tsecond2, 3);
  		format(str,sizeof(str),"\n{cccccc}Статус Бизнеса: {FF6347}Арестован [Прибыль заблокирована!]"), strcat(sctring,str);
  		format(str,sizeof(str),"\n{cccccc}Арестован До: {FF6347}[ %02d.%02d.%d %02d:%02d ]", tday, tmonth, tyear, thour, tminute), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Дата и время ареста: {444444}[ %02d.%02d.%d %02d:%02d ]", tday2, tmonth2, tyear2, thour2, tminute2), strcat(sctring,str);
	 	if(BizzInfo[b][bLien] >= 1) format(str,sizeof(str),"\n{cccccc}Залог: {99ff66}%d$ [ Bank >> Налоги ]\n\n", BizzInfo[b][bLien]), strcat(sctring,str);
	 	else format(str,sizeof(str),"\n{cccccc}Залог: {444444}Невозможен\n\n"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Причина: {ffffff}%s", BizzInfo[b][bArReason]), strcat(sctring,str);
	}
	else
	{
		if(BizzInfo[b][bStat] == 0) format(str,sizeof(str),"\n{cccccc}Статус Бизнеса: {99ff66}[Открыт]"), strcat(sctring,str);
		else if(BizzInfo[b][bStat] == 1) format(str,sizeof(str),"\n{cccccc}Статус Бизнеса {ffcc00}[Ожидает Одобрения]\n"), strcat(sctring,str);
		else if(BizzInfo[b][bStat] == 2)
		{
			format(str,sizeof(str),"\n{cccccc}Статус Бизнеса {FF6347}[Отказано в Установке]\n"), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Причина: {ffffff}%s", BizzInfo[b][bStatReason]), strcat(sctring,str);
		}
	}
	if(BizzInfo[b][bSost] > 0 && (BizzInfo[b][bSost] == PlayerInfo[playerid][pID] || PlayerInfo[playerid][pSoska] >= 20))
	{
	    if(BizzInfo[b][bFreeze] == 0)
	    {
			new osall = BizzInfo[b][bData]-gettime();
			new osday = osall/86400;
			new oshour = (osall-osday*86400)/3600;
			if(osday >= 20) format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {ffffff}%d/10 {99ff66}[ Слив Через: %d дней %d часов ] ", BizzInfo[b][bPastime], osday, oshour), strcat(sctring,str);
			else if(osday <= 19 && osday >= 10) format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {ffffff}%d/10 {ffcc00}[ Слив Через: %d дней %d часов ] ", BizzInfo[b][bPastime], osday, oshour), strcat(sctring,str);
			else format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {ffffff}%d/10 {FF6347}[ Слив Через: %d дней %d часов ] ", BizzInfo[b][bPastime], osday, oshour), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Каждые собранные 10 часов счётчик сбрасывается (Возвращаются 30 дней)"), strcat(sctring,str);
		}
		else format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {99ff66}Слив бизнеса заморожен"), strcat(sctring,str);
	}
	format(str,sizeof(str),"\n\n{ff9000}Откуда идёт прибыль с бизнеса?"), strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}Игроки пользуются услугами вашего бизнеса"), strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}Приобретают товары или используют оборудование"), strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}Все это напрямую приносит вам прибыль"), strcat(sctring,str);
	if(b <= 12)
	{
		format(str,sizeof(str),"\n\n{444444}Литр топлива по гос. цене: {0088ff}%d$",friskPrice[178]), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}Одна доставка = 10.000 литров топлива"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}На депозите должна быть сумма для оплаты дальнобойщику и стоимость 10к литров топлива"), strcat(sctring,str);
	}
	else if(b >= 42 && b <= 76)
	{
	    format(str,sizeof(str),"\n\n{444444}Тип вашего бизнеса: Аренда транспорта"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{444444}Литр топлива по гос. цене: {0088ff}%d$",friskPrice[178]), strcat(sctring,str);
	    format(str,sizeof(str),"\n{444444}Деньги с депозита уходят на оплату топлива в момент аренды транспорта"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{444444}Если на депозите недостаточно средств, топливо оплачивает правительство"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{444444}Соотвественно и прибыль с аренды будет уходить в гос. казну"), strcat(sctring,str);
	}
	format(str,sizeof(str),"\n\n{cccccc}/showbiz - показать статистику бизнеса"), strcat(sctring,str);
	if(IsABizInteriorFrame(b)) 
	{
		format(str,sizeof(str),"\n{cccccc}/bedit - редактор объектов (без использования ноутбука)"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/eo - переместить объект"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/rx /ry /rz - вращать объект"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/dobject - удалить объект"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/to - ретекстур объекта"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/io - информация об объекте"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/cmat /pmat - копировать и применить ретекстур"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}/oclone - клонировать объект"), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}/myint {cccccc}- личный архив интерьеров"), strcat(sctring,str);
	}
	ShowDialog(playerid,679,DIALOG_STYLE_MSGBOX,"{ff9000}Бизнес",sctring,"*","");
	return 1;
}
