stock update_textdraw_card_player(desk, place) // Создаём текстдравы карт игроку
{
	new Float:plusx;
	new playerid = DeskInfo[desk][Playerid][place];
    if(IsOnline(playerid))
	{
	    for(new cd = 0; cd < 52; cd++)
		{
		    PlayerTextDrawDestroy(playerid, PlayerCardDraw[cd][playerid]);
		    if(CardPlayer[cd][desk][place] == 0) PlayerCardDraw[cd][playerid] = CreatePlayerTextDraw(playerid, 1.0, 1.0, cardtextDraw[0]);
		    else
			{
				PlayerCardDraw[cd][playerid] = CreatePlayerTextDraw(playerid, PosX_CardDraw[QuanCardPlayer[desk][place]][0]+plusx, 286.266540, cardtextDraw[CardPlayer[cd][desk][place]]);
				plusx += PosX_CardDraw[QuanCardPlayer[desk][place]][1];
			}
			PlayerTextDrawLetterSize(playerid, PlayerCardDraw[cd][playerid], 0.006748, 0.065333);
			PlayerTextDrawTextSize(playerid, PlayerCardDraw[cd][playerid], 27.369649, 45.266716);
			PlayerTextDrawAlignment(playerid, PlayerCardDraw[cd][playerid], TEXT_DRAW_ALIGN:1);
			PlayerTextDrawColour(playerid, PlayerCardDraw[cd][playerid], -1);
			PlayerTextDrawUseBox(playerid, PlayerCardDraw[cd][playerid], true);
			PlayerTextDrawBoxColour(playerid, PlayerCardDraw[cd][playerid], 0);
			PlayerTextDrawSetShadow(playerid, PlayerCardDraw[cd][playerid], 0);
			PlayerTextDrawSetOutline(playerid, PlayerCardDraw[cd][playerid], 0);
			PlayerTextDrawFont(playerid, PlayerCardDraw[cd][playerid], TEXT_DRAW_FONT:4);
			if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) PlayerTextDrawSetSelectable(playerid, PlayerCardDraw[cd][playerid], true);
			else if(DeskInfo[desk][Game] == 3) PlayerTextDrawSetSelectable(playerid, PlayerCardDraw[cd][playerid], false);
			
		    if(CardPlayer[cd][desk][place] > 0) PlayerTextDrawShow(playerid, PlayerCardDraw[cd][playerid]);
		}
		update_hudtwoplayer_desk(desk, place);
		if(QuanCardPlayer[desk][place] > 0)
		{
			new string[8];
			format(string,sizeof(string),"%d", QuanCardPlayer[desk][place]);
			SetDynamicObjectMaterialText(TextPlayerDesk[desk][place], 0, string, 140, "Arial", 100, 1, 0xFF333333, 0x00000000, 1);
		}
		else SetDynamicObjectMaterialText(TextPlayerDesk[desk][place], 0, " ", 140, "Arial", 100, 1, 0xFF333333, 0x00000000, 1);
	}
	return 1;
}
stock create_textdraw_deskcard(playerid, game)
{
	if(game == 1 || game == 2)
	{
	    for(new tdc = 0; tdc < 12; tdc++)
	    {
	        DeskCardDraw[tdc][playerid] = CreatePlayerTextDraw(playerid, HudDeskCard_Durak[tdc][0], HudDeskCard_Durak[tdc][1], "ld_poke:cdback");
			PlayerTextDrawLetterSize(playerid, DeskCardDraw[tdc][playerid], 0.006748, 0.065333);
			PlayerTextDrawTextSize(playerid, DeskCardDraw[tdc][playerid], 27.369649, 45.266716);
			PlayerTextDrawAlignment(playerid, DeskCardDraw[tdc][playerid], TEXT_DRAW_ALIGN:1);
			PlayerTextDrawColour(playerid, DeskCardDraw[tdc][playerid], 200);
			PlayerTextDrawUseBox(playerid, DeskCardDraw[tdc][playerid], true);
			PlayerTextDrawBoxColour(playerid, DeskCardDraw[tdc][playerid], 0);
			PlayerTextDrawSetShadow(playerid, DeskCardDraw[tdc][playerid], 0);
			PlayerTextDrawSetOutline(playerid, DeskCardDraw[tdc][playerid], 0);
			PlayerTextDrawFont(playerid, DeskCardDraw[tdc][playerid], TEXT_DRAW_FONT:4);
			PlayerTextDrawSetSelectable(playerid, DeskCardDraw[tdc][playerid], true);
	    }
   	}
   	else if(game == 3)
	{
	    for(new tdc = 0; tdc < 5; tdc++)
	    {
	        DeskCardDraw[tdc][playerid] = CreatePlayerTextDraw(playerid, HudDeskCard_Poker[tdc][0], HudDeskCard_Poker[tdc][1], "ld_poke:cdback");
			PlayerTextDrawLetterSize(playerid, DeskCardDraw[tdc][playerid], 0.006748, 0.065333);
			PlayerTextDrawTextSize(playerid, DeskCardDraw[tdc][playerid], 27.369649, 45.266716);
			PlayerTextDrawAlignment(playerid, DeskCardDraw[tdc][playerid], TEXT_DRAW_ALIGN:1);
			PlayerTextDrawColour(playerid, DeskCardDraw[tdc][playerid], 200);
			PlayerTextDrawUseBox(playerid, DeskCardDraw[tdc][playerid], true);
			PlayerTextDrawBoxColour(playerid, DeskCardDraw[tdc][playerid], 0);
			PlayerTextDrawSetShadow(playerid, DeskCardDraw[tdc][playerid], 0);
			PlayerTextDrawSetOutline(playerid, DeskCardDraw[tdc][playerid], 0);
			PlayerTextDrawFont(playerid, DeskCardDraw[tdc][playerid], TEXT_DRAW_FONT:4);
			PlayerTextDrawSetSelectable(playerid, DeskCardDraw[tdc][playerid], false);
	    }
	    for(new tdc2 = 5; tdc2 < 12; tdc2++)
	    {
	        DeskCardDraw[tdc2][playerid] = CreatePlayerTextDraw(playerid, 100.0, 100.0, "ld_poke:cdback");
			PlayerTextDrawLetterSize(playerid, DeskCardDraw[tdc2][playerid], 0.006748, 0.065333);
			PlayerTextDrawTextSize(playerid, DeskCardDraw[tdc2][playerid], 27.369649, 45.266716);
			PlayerTextDrawAlignment(playerid, DeskCardDraw[tdc2][playerid], TEXT_DRAW_ALIGN:1);
			PlayerTextDrawColour(playerid, DeskCardDraw[tdc2][playerid], 200);
			PlayerTextDrawUseBox(playerid, DeskCardDraw[tdc2][playerid], true);
			PlayerTextDrawBoxColour(playerid, DeskCardDraw[tdc2][playerid], 0);
			PlayerTextDrawSetShadow(playerid, DeskCardDraw[tdc2][playerid], 0);
			PlayerTextDrawSetOutline(playerid, DeskCardDraw[tdc2][playerid], 0);
			PlayerTextDrawFont(playerid, DeskCardDraw[tdc2][playerid], TEXT_DRAW_FONT:4);
			PlayerTextDrawSetSelectable(playerid, DeskCardDraw[tdc2][playerid], false);
	    }
   	}
	return 1;
}
stock destroy_textdraw_deskcard(playerid)
{
	for(new tdc = 0; tdc < 12; tdc++) PlayerTextDrawHide(playerid, DeskCardDraw[tdc][playerid]), PlayerTextDrawDestroy(playerid, DeskCardDraw[tdc][playerid]);
	return 1;
}
stock create_textdraw_hudleader(playerid, place)
{
    new Float:pos_draw[2];
	if(place == 0 || place == 5) 		pos_draw[0] = HudDeskDraw_0_5[place][0], 	pos_draw[1] = HudDeskDraw_0_5[place][1];
	else if(place == 1) 				pos_draw[0] = HudDeskDraw_1[place][0], 	pos_draw[1] = HudDeskDraw_1[place][1];
	else if(place == 2 || place == 3) 	pos_draw[0] = HudDeskDraw_2_3[place][0], 	pos_draw[1] = HudDeskDraw_2_3[place][1];
	else if(place == 4) 				pos_draw[0] = HudDeskDraw_4[place][0], 	pos_draw[1] = HudDeskDraw_4[place][1];
	
	DeskLeaderDraw[playerid] = CreatePlayerTextDraw(playerid, pos_draw[0]-28.994003, pos_draw[1], "LD_SPAC:white");
	PlayerTextDrawLetterSize(playerid, DeskLeaderDraw[playerid], 0.015371, 0.088666);
	PlayerTextDrawTextSize(playerid, DeskLeaderDraw[playerid], 26.994720, 34.066650);
	PlayerTextDrawAlignment(playerid, DeskLeaderDraw[playerid], TEXT_DRAW_ALIGN:1);
	PlayerTextDrawColour(playerid, DeskLeaderDraw[playerid], -1);
	PlayerTextDrawUseBox(playerid, DeskLeaderDraw[playerid], true);
	PlayerTextDrawBoxColour(playerid, DeskLeaderDraw[playerid], 0);
	PlayerTextDrawSetShadow(playerid, DeskLeaderDraw[playerid], 0);
	PlayerTextDrawSetOutline(playerid, DeskLeaderDraw[playerid], 0);
	PlayerTextDrawBackgroundColour(playerid, DeskLeaderDraw[playerid], 0);
	PlayerTextDrawFont(playerid, DeskLeaderDraw[playerid], TEXT_DRAW_FONT:5);
	PlayerTextDrawSetProportional(playerid, DeskLeaderDraw[playerid], true);
	PlayerTextDrawSetSelectable(playerid, DeskLeaderDraw[playerid], true);
	PlayerTextDrawSetPreviewModel(playerid, DeskLeaderDraw[playerid], 3096);
	PlayerTextDrawSetPreviewRot(playerid, DeskLeaderDraw[playerid], 0.000000, 0.000000, 0.000000, 1.000000);
	return 1;
}
stock show_dialog_help(playerid, stat)
{
    new stro[86],sctringo[860];
    format(stro,sizeof(stro),"{ff9000}Добро пожаловать!"), strcat(sctringo,stro);
    if(stat == 1)
	{
		format(stro,sizeof(stro),"\n{cccccc}Вы присоединились к столу в качестве лидера"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n\n{99ff66}%s {cccccc}- Открыть меню и панель управления играми",buttonName[Device[playerid]]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{FF6347}F {cccccc}- Покинуть стол"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n\n{ff9000}Откройте меню %s, после чего нажмите на кнопку с гаечным ключём",buttonName[Device[playerid]]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{ff9000}В меню настройках выберите игру и ознакомьтесь с другими возможностями.\n"), strcat(sctringo,stro);
	}
    else
	{
		format(stro,sizeof(stro),"\n{cccccc}Вы присоединились к столу в качестве участника"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n\n{99ff66}%s {cccccc}- Открыть меню и панель управления играми",buttonName[Device[playerid]]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{FF6347}F {cccccc}- Покинуть стол"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n\n{ff9000}Дождитесь завершения уже существующей игры или нажмите GO! если готовы\n"), strcat(sctringo,stro);
	}
    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Казино",sctringo,"Ок","");
    return 1;
}
stock create_object_chips(desk, place) // Объекты фишек на столе
{
	new Float:chiX[6], Float:chiY[6];
	if(place == 0)
	{
		chiX[0] = ChipsPos_0[0][0], chiY[0] = ChipsPos_0[0][1];
		chiX[1] = ChipsPos_0[1][0], chiY[1] = ChipsPos_0[1][1];
		chiX[2] = ChipsPos_0[2][0], chiY[2] = ChipsPos_0[2][1];
		chiX[3] = ChipsPos_0[3][0], chiY[3] = ChipsPos_0[3][1];
		chiX[4] = ChipsPos_0[4][0], chiY[4] = ChipsPos_0[4][1];
		chiX[5] = ChipsPos_0[5][0], chiY[5] = ChipsPos_0[5][1];
	}
	else if(place == 1)
	{
		chiX[0] = ChipsPos_1[0][0], chiY[0] = ChipsPos_1[0][1];
		chiX[1] = ChipsPos_1[1][0], chiY[1] = ChipsPos_1[1][1];
		chiX[2] = ChipsPos_1[2][0], chiY[2] = ChipsPos_1[2][1];
		chiX[3] = ChipsPos_1[3][0], chiY[3] = ChipsPos_1[3][1];
		chiX[4] = ChipsPos_1[4][0], chiY[4] = ChipsPos_1[4][1];
		chiX[5] = ChipsPos_1[5][0], chiY[5] = ChipsPos_1[5][1];
	}
	else if(place == 2)
	{
		chiX[0] = ChipsPos_2[0][0], chiY[0] = ChipsPos_2[0][1];
		chiX[1] = ChipsPos_2[1][0], chiY[1] = ChipsPos_2[1][1];
		chiX[2] = ChipsPos_2[2][0], chiY[2] = ChipsPos_2[2][1];
		chiX[3] = ChipsPos_2[3][0], chiY[3] = ChipsPos_2[3][1];
		chiX[4] = ChipsPos_2[4][0], chiY[4] = ChipsPos_2[4][1];
		chiX[5] = ChipsPos_2[5][0], chiY[5] = ChipsPos_2[5][1];
	}
	else if(place == 3)
	{
		chiX[0] = ChipsPos_3[0][0], chiY[0] = ChipsPos_3[0][1];
		chiX[1] = ChipsPos_3[1][0], chiY[1] = ChipsPos_3[1][1];
		chiX[2] = ChipsPos_3[2][0], chiY[2] = ChipsPos_3[2][1];
		chiX[3] = ChipsPos_3[3][0], chiY[3] = ChipsPos_3[3][1];
		chiX[4] = ChipsPos_3[4][0], chiY[4] = ChipsPos_3[4][1];
		chiX[5] = ChipsPos_3[5][0], chiY[5] = ChipsPos_3[5][1];
	}
	else if(place == 4)
	{
		chiX[0] = ChipsPos_4[0][0], chiY[0] = ChipsPos_4[0][1];
		chiX[1] = ChipsPos_4[1][0], chiY[1] = ChipsPos_4[1][1];
		chiX[2] = ChipsPos_4[2][0], chiY[2] = ChipsPos_4[2][1];
		chiX[3] = ChipsPos_4[3][0], chiY[3] = ChipsPos_4[3][1];
		chiX[4] = ChipsPos_4[4][0], chiY[4] = ChipsPos_4[4][1];
		chiX[5] = ChipsPos_4[5][0], chiY[5] = ChipsPos_4[5][1];
	}
	else if(place == 5)
	{
		chiX[0] = ChipsPos_5[0][0], chiY[0] = ChipsPos_5[0][1];
		chiX[1] = ChipsPos_5[1][0], chiY[1] = ChipsPos_5[1][1];
		chiX[2] = ChipsPos_5[2][0], chiY[2] = ChipsPos_5[2][1];
		chiX[3] = ChipsPos_5[3][0], chiY[3] = ChipsPos_5[3][1];
		chiX[4] = ChipsPos_5[4][0], chiY[4] = ChipsPos_5[4][1];
		chiX[5] = ChipsPos_5[5][0], chiY[5] = ChipsPos_5[5][1];
	}

	ObjectChips[desk][0][place] = CreateDynamicObject(1901, chiX[0], chiY[0], ChipsPosZ, 0.0, 0.0, 0.0, desk+1, 199, -1, 20.00, 20.00), ObjectChipsStat[desk][0][place] = 1;
	ObjectChips[desk][1][place] = CreateDynamicObject(1901, chiX[1], chiY[1], ChipsPosZ, 0.0, 0.0, 0.0, desk+1, 199, -1, 20.00, 20.00), ObjectChipsStat[desk][1][place] = 1;
	ObjectChips[desk][2][place] = CreateDynamicObject(1901, chiX[2], chiY[2], ChipsPosZ, 0.0, 0.0, 0.0, desk+1, 199, -1, 20.00, 20.00), ObjectChipsStat[desk][2][place] = 1;
	ObjectChips[desk][3][place] = CreateDynamicObject(1901, chiX[3], chiY[3], ChipsPosZ, 0.0, 0.0, 0.0, desk+1, 199, -1, 20.00, 20.00), ObjectChipsStat[desk][3][place] = 1;
	ObjectChips[desk][4][place] = CreateDynamicObject(1901, chiX[4], chiY[4], ChipsPosZ, 0.0, 0.0, 0.0, desk+1, 199, -1, 20.00, 20.00), ObjectChipsStat[desk][4][place] = 1;
	ObjectChips[desk][5][place] = CreateDynamicObject(1901, chiX[5], chiY[5], ChipsPosZ, 0.0, 0.0, 0.0, desk+1, 199, -1, 20.00, 20.00), ObjectChipsStat[desk][5][place] = 1;
	update_object_chips(desk, place);
	streamer_update_object_member(desk);
	return 1;
}
stock chips_retexture_object(desk, p, ch, texture_id, stat)
{
	new object;
	if(stat == 0) object = ObjectChips[desk][ch][p];
	else if(stat == 1) object = ChipsBankObject[desk][ch];
    if(texture_id == 0) SetDynamicObjectMaterial(object, 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	else if(texture_id == 1) SetDynamicObjectMaterial(object, 0, 1859, "chips2", "chip_stck4", 0x00000000);
	else if(texture_id == 2) SetDynamicObjectMaterial(object, 0, 1859, "chips2", "chip_stck6", 0x00000000);
	else if(texture_id == 3) SetDynamicObjectMaterial(object, 0, 1859, "chips2", "chip_stck5", 0x00000000);
	else if(texture_id == 4) SetDynamicObjectMaterial(object, 0, 1859, "chips2", "chip_stck2", 0x00000000);
	else if(texture_id == 5) SetDynamicObjectMaterial(object, 0, 1859, "chips2", "chip_stck1", 0x00000000);
	else if(texture_id == 6) SetDynamicObjectMaterial(object, 0, 1859, "chips2", "chip_stck3", 0x00000000);
	return 1;
}
stock chips_id_reload_object(desk, p, chquan, texture_id, stat)
{
	if(chquan >= 21 && chquan <= 40) chquan -= chquan-20;
	else if(chquan >= 41 && chquan <= 59) chquan -= chquan-20;
	else if(chquan >= 61 && chquan <= 80) chquan -= chquan-20;
	else if(chquan >= 81 && chquan <= 100) chquan -= chquan-20;
	else if(chquan >= 101 && chquan <= 120) chquan -= chquan-20;
	else if(chquan >= 121) chquan = 20;
    new Float:ob_pos[3];
    if(stat == 0)
    {
	    for(new ch = 0; ch < MAX_CHIPS_PLAYER; ch++)
		{
	        if(ChipsSet[desk][ch][p] == 0)
	        {
	    		GetDynamicObjectPos(ObjectChips[desk][ch][p], ob_pos[0], ob_pos[1], ob_pos[2]);
	    		SetDynamicObjectPos(ObjectChips[desk][ch][p], ob_pos[0], ob_pos[1], (ChipsPosZ-0.0065) + chquan*0.0065);
	    		chips_retexture_object(desk, p, ch, texture_id, stat);
	    		ChipsSet[desk][ch][p] = texture_id;
	    		break;
			}
		}
	}
	else if(stat == 1)
    {
	    for(new ch = 0; ch < MAX_CHIPS_PLAYER; ch++)
		{
	        if(ChipsBankSet[desk][ch] == 0)
	        {
	    		GetDynamicObjectPos(ChipsBankObject[desk][ch], ob_pos[0], ob_pos[1], ob_pos[2]);
	    		SetDynamicObjectPos(ChipsBankObject[desk][ch], ob_pos[0], ob_pos[1], (ChipsBankZ-0.0065) + chquan*0.0065);
	    		chips_retexture_object(desk, p, ch, texture_id, stat);
	    		ChipsBankSet[desk][ch] = texture_id;
	    		break;
			}
		}
	}
	return 1;
}
stock chips_id_reload(desk, p, chquan, texture_id, stat)
{
	if(chquan >= 1) chips_id_reload_object(desk, p, chquan, texture_id, stat); // Первая Фишка
	if(chquan >= 21) chips_id_reload_object(desk, p, chquan, texture_id, stat); // Вторая Фишка
	if(chquan >= 41) chips_id_reload_object(desk, p, chquan, texture_id, stat); // Третья Фишка
	if(chquan >= 61) chips_id_reload_object(desk, p, chquan, texture_id, stat); // Четвёртая Фишка
	if(chquan >= 81) chips_id_reload_object(desk, p, chquan, texture_id, stat); // Пятая Фишка
    if(chquan >= 101) chips_id_reload_object(desk, p, chquan, texture_id, stat); // Шестая Фишка
	return 1;
}
stock find_reload_chips_object(desk, p, quanchips, six, five, four, three, two, one, stat)
{
    new chips_quan[MAX_CHIPS_PLAYER], aga[MAX_CHIPS_PLAYER];
    // Фишки ID 6
    chips_quan[5] = quanchips/six;
    if(chips_quan[5] > 0) aga[5] = 1, chips_id_reload(desk, p, chips_quan[5], 6, stat);

    // Фишки ID 5
    if(aga[5] == 1) quanchips -= chips_quan[5]*six;
    chips_quan[4] = quanchips/five;
    if(chips_quan[4] > 0) aga[4] = 1, chips_id_reload(desk, p, chips_quan[4], 5, stat);

    // Фишки ID 4
    if(aga[4] == 1) quanchips -= chips_quan[4]*five;
    chips_quan[3] = quanchips/four;
    if(chips_quan[3] > 0) aga[3] = 1, chips_id_reload(desk, p, chips_quan[3], 4, stat);

    // Фишки ID 3
    if(aga[3] == 1) quanchips -= chips_quan[3]*four;
    chips_quan[2] = quanchips/three;
    if(chips_quan[2] > 0) aga[2] = 1, chips_id_reload(desk, p, chips_quan[2], 3, stat);

    // Фишки ID 2
    if(aga[2] == 1) quanchips -= chips_quan[2]*three;
    chips_quan[1] = quanchips/two;
    if(chips_quan[1] > 0) aga[1] = 1, chips_id_reload(desk, p, chips_quan[1], 2, stat);

    // Фишки ID 1
    if(aga[1] == 1) quanchips -= chips_quan[1]*two;
    chips_quan[0] = quanchips/one;
    if(chips_quan[0] > 0) aga[0] = 1, chips_id_reload(desk, p, chips_quan[0], 1, stat);
    
    if(stat == 0)
    {
	    for(new ch = 0; ch < MAX_CHIPS_PLAYER; ch++)
		{
	        if(ChipsSet[desk][ch][p] == 0) chips_retexture_object(desk, p, ch, 0, stat);
		}
	}
	else if(stat == 1)
    {
	    for(new ch = 0; ch < MAX_CHIPS_PLAYER; ch++)
		{
		    if(ChipsBankSet[desk][ch] == 0) chips_retexture_object(desk, p, ch, 0, stat);
		}
	}
	return 1;
}
stock update_object_chips(desk, p)
{
    if(DeskInfo[desk][Playerstatus][p] > 0)
	{
		ChipsSet[desk][0][p] = 0, ChipsSet[desk][1][p] = 0, ChipsSet[desk][2][p] = 0;
		ChipsSet[desk][3][p] = 0, ChipsSet[desk][4][p] = 0, ChipsSet[desk][5][p] = 0;
		new memberid = DeskInfo[desk][Playerid][p];
	    if(IsOnline(memberid))
		{
			if(DeskInfo[desk][Typebid] == 0)
			{
	            if(DeskInfo[desk][Betsize] == 0) find_reload_chips_object(desk, p, PlayerInfo[memberid][pAmmos1], 5000, 1000, 500, 100, 50, 10, 0);
	            else if(DeskInfo[desk][Betsize] == 1) find_reload_chips_object(desk, p, PlayerInfo[memberid][pAmmos1], 500000, 100000, 50000, 10000, 5000, 100, 0);
			}
			else if(DeskInfo[desk][Typebid] == 1) find_reload_chips_object(desk, p, PlayerInfo[memberid][pAmmos8], 500, 100, 50, 10, 5, 1, 0);
		}
	}
	return 1;
}
stock update_bank_chips(desk)
{
	if(DeskInfo[desk][Bank] > 0)
	{
		if(DeskInfo[desk][Typebid] == 0)
		{
	        if(DeskInfo[desk][Betsize] == 0) find_reload_chips_object(desk, 0, DeskInfo[desk][Bank], 5000, 1000, 500, 100, 50, 10, 1);
	        else if(DeskInfo[desk][Betsize] == 1) find_reload_chips_object(desk, 0, DeskInfo[desk][Bank], 500000, 100000, 50000, 10000, 5000, 1000, 1);
		}
		else if(DeskInfo[desk][Typebid] == 1) find_reload_chips_object(desk, 0, DeskInfo[desk][Bank], 500, 100, 50, 10, 5, 1, 1);
	}
	else
	{
	 	SetDynamicObjectMaterial(ChipsBankObject[desk][0], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	 	SetDynamicObjectMaterial(ChipsBankObject[desk][1], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	 	SetDynamicObjectMaterial(ChipsBankObject[desk][2], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	 	SetDynamicObjectMaterial(ChipsBankObject[desk][3], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	 	SetDynamicObjectMaterial(ChipsBankObject[desk][4], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	 	SetDynamicObjectMaterial(ChipsBankObject[desk][5], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
	}
	return 1;
}
