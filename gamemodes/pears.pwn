forward Call_logs(playerid, parama);
public Call_logs(playerid, parama)
{
	new rows, str[480], sctring[12800], datad1[24], datad2[24], datad3[24], datad6[24], kol, qwer[60], datun[64], datro;
	cache_get_row_count(rows);
	if(PlayerInfo[playerid][pSoska] >= 1)
	{
		for(new i = 0; i < rows; i++)
		{
			cache_get_value_name(i, "action", datad1, 24);

			new bool:is_null;
			cache_is_value_name_null(i, "primary_player_name", is_null);
			if(is_null == false)
			{
				cache_get_value_name(i, "primary_player_name", datad2, 24);
				cache_get_value_name(i, "primary_player_ip", datad3, 24);
			}

			cache_get_value_name(i, "timestamp_fmt", datun, sizeof(datun));
			cache_get_value_name_int(i, "row", datro);
			cache_get_value_name(i, "rows_1251", datad6, 64);
			format(str,sizeof(str),"{cccccc}[ %s ] %s %s %s %d %s\n", datun, datad1, datad2, datad3, datro, datad6), strcat(sctring,str);
			kol ++;
	    }
    }
    else
	{
		for(new i = 0; i < rows; i++)
		{
			cache_get_value_name(i, "action", datad1, 24);

			new bool:is_null;
			cache_is_value_name_null(i, "primary_player_name", is_null);
			if(is_null == false) cache_get_value_name(i, "primary_player_name", datad2, 24);

			cache_get_value_name(i, "timestamp_fmt", datun, sizeof(datun));
			cache_get_value_name_int(i, "row", datro);
			cache_get_value_name(i, "rows_1251", datad6, 64);
			format(str,sizeof(str),"{cccccc}[ %s ] %s %s %d %s\n", datun, datad1, datad2, datro, datad6), strcat(sctring,str);
			kol ++;
	    }
    }
    new casik;
	if(DP[0][playerid] == 1) casik = 893;
	else casik = 1742;
    if(kol >= 1)
    {
    	if(PlayerInfo[playerid][pDom] == parama) format(qwer,sizeof(qwer),"{ff9000}Мой Дом № %d",parama);
		else format(qwer,sizeof(qwer),"{0088ff}Лог Дома № %d",parama);
		ShowDialog(playerid,casik,DIALOG_STYLE_MSGBOX,qwer,sctring,"Ок","");
    }
    else if(kol == 0) ShowDialog(playerid,casik,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}По запросу ничего не найдено","Ок","");
	return 1;
}
stock logdom(playerid, idom)
{
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	new casik, string[400];
	if(DP[0][playerid] == 1) casik = 893;
	else casik = 1742;
	ShowDialog(playerid,casik,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}Поиск логов...","*","");
	mysql_format(pearsq_2, string, sizeof(string), "SELECT *, DATE_FORMAT(timestamp, \'%%d.%%c.%%Y %%H:%%i:%%s\', \'Europe/Moscow\') AS timestamp_fmt, \
		convertCharset(`rows`, \'utf-8\', \'windows-1251\') AS rows_1251 \
		FROM `house_logs` WHERE `house_id` = '%d' AND `house_type` = 'house' ORDER BY `timestamp` DESC LIMIT 40", idom);
	mysql_tquery(pearsq_2, string, "Call_logs", "dd", playerid, idom);
	return 1;
}
