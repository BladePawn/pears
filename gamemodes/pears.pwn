			if(DP[1][playerid] == 1) // Личный
			{
				mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `pp_cars` WHERE `sost` = '%d' AND `slot` = '%d'", PlayerInfo[playerid][pID], DP[0][playerid]);
				mysql_tquery(pearsq, string, "LoadCar", "ddddd", playerid, DP[0][playerid], g_MysqlRaceCheck[playerid], 0, 1);
			}
			else if(DP[1][playerid] == 2) // Ключи
			{
				new unix = gettime();
				if(unix > PlayerInfo[playerid][pKeyVeh][3])
				{
					ErrorMessage(playerid, "{FF6347}Закончилось время доступа к транспорту");
					PlayerInfo[playerid][pKeyVeh][0] = 0;
