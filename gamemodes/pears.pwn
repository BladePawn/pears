				 		|| EffectTime[i] == 1700  || EffectTime[i] == 1750 || EffectTime[i] == 1800 || EffectTime[i] == 1850 || EffectTime[i] == 1900 || EffectTime[i] == 1950 || EffectTime[i] == 2000 || EffectTime[i] == 2050
