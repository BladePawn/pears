		    else if(PlayerInfo[playerid][pYapon] >= 2 && PlayerInfo[playerid][pYapon] <= 9) PlayerInfo[playerid][pYapon] ++, end = 2;
		    else if(PlayerInfo[playerid][pYapon] >= 10) PlayerInfo[playerid][pYapon] = 1, end = 3;
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Yapon`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pYapon] ,PlayerInfo[playerid][pID]);
			query_empty(pearsq, f_str);
		}
		case 8:
		{
			atext = "Знание итальянского языка";
		    if(PlayerInfo[playerid][pItaly] == 0) PlayerInfo[playerid][pItaly] = 2, end = 2;
		    else if(PlayerInfo[playerid][pItaly] >= 2 && PlayerInfo[playerid][pItaly] <= 9) PlayerInfo[playerid][pItaly] ++, end = 2;
		    else if(PlayerInfo[playerid][pItaly] >= 10) PlayerInfo[playerid][pItaly] = 1, end = 3;
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Italy`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pItaly] ,PlayerInfo[playerid][pID]);
