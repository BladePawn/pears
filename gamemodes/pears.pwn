CMD:respcar(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	if(!sscanf(params, "i", params[0]))
	{
	    if(params[0] < 0 || params[0] >= 2000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверный ID транспорта");
	    if(VehInfo[params[0]][vModel] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этого транспорта не существует");
		if(params[0] == train || params[0] == train + 1 || params[0] == train + 2 || params[0] == train + 3
			|| IsAVehicleNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Этот транспорт нельзя зареспавнить");
		new string[124];
		format(string, sizeof(string), "[ Мысли ADM ]: %s [ID: %d] отправлен на спавн",GetVehicleName(VehInfo[params[0]][vModel]), params[0]), SendClientMessage(playerid, COLOR_GREY, string);
	  	if(VehInfo[params[0]][vSost] == PlayerInfo[playerid][pID] || VehInfo[params[0]][vKey] == PlayerInfo[playerid][pID] && VehInfo[params[0]][vKeyUnix] > gettime()) SaveMyVehiclePos(params[0]);
		PP_SetVehicleToRespawn(params[0]);
	}
	else
	{
		if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нужно сидеть в транспорте или указать его ID");
		new vehid = GetPlayerVehicleID(playerid), string[124];
		if(vehid == train || vehid == train + 1 || vehid == train + 2 || vehid == train + 3
			|| IsAVehicleNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Этот транспорт нельзя зареспавнить");
		new Float:X,Float:Y,Float:Z;
		GetVehiclePos(vehid, X,Y,Z);
  		PPSetPlayerPos(playerid, X, Y, Z);
		if(VehInfo[vehid][vSost] == PlayerInfo[playerid][pID] || VehInfo[vehid][vKey] == PlayerInfo[playerid][pID] && VehInfo[vehid][vKeyUnix] > gettime()) SaveMyVehiclePos(vehid);
		format(string, sizeof(string), "[ Мысли ADM ]: %s [ID: %d] отправлен на спавн",GetVehicleName(VehInfo[vehid][vModel]), vehid), SendClientMessage(playerid, COLOR_GREY, string);
	  	PP_SetVehicleToRespawn(vehid);
	}
	return 1;
}

alias:respawn("rac")
CMD:respawn(playerid, const params[])
{
 	if(PlayerInfo[playerid][pSoska] < 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	new bool:unwanted[MAX_CARS];
	foreach(Player, i)
	{
       	if(IsPlayerInAnyVehicle(i)) unwanted[GetPlayerVehicleID(i)] = true;
       	if(IsTrailerAttachedToVehicle(GetPlayerVehicleID(i))) unwanted[GetVehicleTrailer(GetPlayerVehicleID(i))] = true;
	}
	for(new car = 1; car < MAX_CARS; car++)
	{
		if(car == train || car == train + 1 || car == train + 2 || car == train + 3) continue; // Игнорим поезд и все вагоны
		if(VehInfo[car][vNospawn] != 0
			|| IsAVehicleNPC(car)) continue; // Игнорим транспорт с запретом на спавн
		if(!unwanted[car]) PP_SetVehicleToRespawn(car);
	}

	new string[90];
	format(string, sizeof(string), "[PP]: Администратор %s зареспавнил транспорт на сервере.", PlayerInfo[playerid][pName]);
	AllMessage(COLOR_LIGHTRED,string);
    AdminLog("respawn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	PlayerPlaySound(playerid, 5461, 0.0, 0.0, 0.0);
	return 1;
}

alias:respawngro("racgro", "rg")
CMD:respawngro(playerid, const params[])
{
	new Float:X,Float:Y,Float:Z;
    GetPlayerPos(playerid, X, Y, Z);
 	if(PlayerInfo[playerid][pSoska] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	new bool:unwanted[MAX_CARS];
	foreach(Player,player)
	{
       	if(IsPlayerInAnyVehicle(player)) unwanted[GetPlayerVehicleID(player)] = true;
       	if(IsTrailerAttachedToVehicle(GetPlayerVehicleID(player))) unwanted[GetVehicleTrailer(GetPlayerVehicleID(player))] = true;
	}
	for(new car = 1; car < MAX_CARS; car++)
	{
		if(car == train || car == train + 1 || car == train + 2 || car == train + 3) continue; // Игнорим поезд и все вагоны
		if(IsAVehicleNPC(car)) continue;
		if(!unwanted[car] && VehInfo[car][vNospawn] == 0 && VehInfo[car][vSellcar] == 0)
		{
			 if(GetVehicleDistanceFromPoint(car, X, Y, Z) <= 70 && GetPlayerVirtualWorld(playerid) == GetVehicleVirtualWorld(car)) PP_SetVehicleToRespawn(car);
		}
	}
    SetPlayerChatBubble(playerid,"Автомобилиус - респавниус!",COLOR_TALK_PLAYER,35.0,10000);
    new string[144];
    format(string, sizeof(string), " [ ADM ]: %s заспавнил транспорт в радиусе 70 метров", PlayerInfo[playerid][pName]);
    ABroadCast(COLOR_ADM,string,1);
    AdminLog("respawngo", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	PlayerPlaySound(playerid, 5461, 0.0, 0.0, 0.0);
	return 1;
}
CMD:fuelgro(playerid, const params[])
{
	new Float:X,Float:Y,Float:Z;
    GetPlayerPos(playerid, X, Y, Z);
 	if(PlayerInfo[playerid][pSoska] <= 3 && PlayerInfo[playerid][pMedia] < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	for(new car = 1; car < MAX_CARS; car++)
	{
 		if(GetVehicleDistanceFromPoint(car, X, Y, Z) <= 30.0 && GetPlayerVirtualWorld(playerid) == GetVehicleVirtualWorld(car)) VehInfo[car][vGas] = GasMax - VehInfo[car][vGelium];
	}
    SetPlayerChatBubble(playerid,"Автомобилиус - запрявлятус!",COLOR_TALK_PLAYER,35.0,10000);
    new string[144];
    format(string, sizeof(string), " [ ADM ]: %s заправил транспорт в радиусе 30 метров от себя", PlayerInfo[playerid][pName]);
    ABroadCast(COLOR_ADM,string,1);
    AdminLog("fuelgro", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	return 1;
}
CMD:srvstop228(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	aasyka = 1; // Закрываем его
	if(server == 1) SendRconCommand("name Pears Project [ ТЕХ.РАБОТЫ ]");
	else SendRconCommand("name Pears Test [ ТЕХ.РАБОТЫ ]");
	SendRconCommand("password Y78yndq78nsdnqq8"); // Активируем на сервер Пароль
	SendClientMessage(playerid, COLOR_LIGHTBLUE, "{cccccc}[ {0088ff}Server {cccccc}]: {FF0000}РЕЗЕРВНОЕ ОТКЛЮЧЕНИЕ СЕРВЕРА АКТИВИРОВАНО!");
	SaveStuff(); // Сохраняем файл
	new string[164];
 	format(string, sizeof(string), " [ ADM ]: %s {ff0000}активировал резервное отключение сервера",  PlayerInfo[playerid][pName]);
 	ABroadCast(COLOR_ADM,string,1);
	AdminLog("REZERV", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Отрубил Сервер");
	foreach(Player, i) Kickx(i);
	return 1;
}
CMD:sdelka(playerid, const params[])
{
	if(GetPlayerInterior(playerid) != 100 && GetPlayerVirtualWorld(playerid) != 100) return 1;
	if(IsPlayerInRangeOfPoint(playerid,2.0,1259.8324,-14.1610,1000.9254) || IsPlayerInRangeOfPoint(playerid,2.0,1265.6425,-14.0832,1000.9254)
	|| IsPlayerInRangeOfPoint(playerid,2.0,1265.5808,-29.7895,1000.9254) || IsPlayerInRangeOfPoint(playerid,2.0,1259.7842,-29.9404,1000.9254))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
  		if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
		if(PlayerInfo[playerid][pTstat] == 0) return ErrorMessage(playerid, "{FF6347}Вам необходимо создать сделку [ /trade ]");
		if(PlayerInfo[playerid][pTid] >= 0) return ErrorMessage(playerid, "{FF6347}У вас уже есть с кем-то сделка");
	    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Предложить пройти в комнату для сделок [ /sdelka ID ]");
	    if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
	    if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING || !ProxDetectorS(3.0, playerid, params[0])
		|| GetPlayerInterior(playerid) != GetPlayerInterior(params[0]) || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	    if(Sdelka[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы уже находитесь в комнате для сделок");
	    if(Sdelka[params[0]] >= 1) return ErrorMessage(playerid, "{FF6347}Игрок уже находится в комнате для сделок");
		if(GetPVarInt(params[0],"afksystem") >= 2 && server != 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
		if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете предложить сделку себе");
	 	if(PlayerInfo[params[0]][pTid] >= 0) return ErrorMessage(playerid, "{FF6347}У игрока уже есть с кем-то сделка");
	 	if(PlayerInfo[params[0]][pTstat] == 0) return ErrorMessage(playerid, "{FF6347}Игроку необходимо создать сделку");
	 	if(PlayerInfo[playerid][pTslot][0] == 0 && PlayerInfo[playerid][pTslot][1] == 0 && PlayerInfo[playerid][pTslot][2] == 0) return ErrorMessage(playerid, "{FF6347}В вашей сделке нет товаров");
	 	if(PlayerInfo[params[0]][pTslot][0] == 0 && PlayerInfo[params[0]][pTslot][1] == 0 && PlayerInfo[params[0]][pTslot][2] == 0) return ErrorMessage(playerid, "{FF6347}В сделке игрока сделке нет товаров");

		if(IsPlayerInRangeOfPoint(playerid,2.0,1259.8324,-14.1610,1000.9254)) DP[0][playerid] = 0, DP[0][params[0]] = 0;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1265.6425,-14.0832,1000.9254)) DP[0][playerid] = 1, DP[0][params[0]] = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1265.5808,-29.7895,1000.9254)) DP[0][playerid] = 2, DP[0][params[0]] = 2;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1259.7842,-29.9404,1000.9254)) DP[0][playerid] = 3, DP[0][params[0]] = 3;
	 	new string[144];
	 	format(string, sizeof(string), "{ff9000}%s {cccccc}предлагает вам пройти в комнату для сделок\n{cccccc}Вы согласны?",PlayerInfo[playerid][pName]);
		ShowDialog(params[0],779,DIALOG_STYLE_MSGBOX,"{FF9000}Комната Сделок",string,"Да","Нет");
		format(string, sizeof(string), "[ Мысли ]: Я предлагаю %s пройти в комнату для сделок",PlayerInfo[params[0]][pName]);
		SendClientMessage(playerid, COLOR_GREY, string);
		Leadset2[params[0]] = playerid;
	}
	else ErrorMessage(playerid, "{FF6347}Вы далеко от комнаты для сделок");
	return 1;
}
stock gender(playerid)
{
	new atext[2];
	if(PlayerInfo[playerid][pSex] == 2) atext = "а";
	return atext;
}

stock NoCollisionForAll(playerid, message)
{
	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);

	DisableRemoteVehicleCollisions(playerid, true);
	OnlineInfo[playerid][oCollisionTime] = 20;
	foreach(Player, i)
	{
	    if(OnlineInfo[i][oLogged] != 0
			&& GetPlayerState(i) == PLAYER_STATE_DRIVER
			&& IsPlayerInRangeOfPoint(i, 20.0, pos[0], pos[1], pos[2])
			&& GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i)
			&& GetPlayerInterior(playerid) == GetPlayerInterior(i))
		{
			DisableRemoteVehicleCollisions(i, true);
			OnlineInfo[i][oCollisionTime] = 20;

			if(message) SendClientMessage(i, COLOR_GRAD1, "Вам отключена коллизия транспорта на 20 секунд");
		}
	}
	return 1;
}

CMD:nocollision(playerid)
{
	if(PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Вы не за рулём");

	new string[100];
	format(string, sizeof(string), " [ ADM ]: %s выключил коллизию транспорта игрокам возле себя на 20 секунд", PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,2);

	NoCollisionForAll(playerid, 1);
	return 1;
}

CMD:shop(playerid)
{
	PlayerPlaySound(playerid,40405,0,0,0);
	new str[100],sctring[400];
	if(Goods[playerid] == 0) format(str,sizeof(str),"{99ff66}Начать {cccccc}Торговлю\n"), strcat(sctring,str);
	else format(str,sizeof(str),"{FF6347}Завершить {cccccc}Торговлю\n"), strcat(sctring,str);
    format(str,sizeof(str),"{cccccc}Журнал торговли\n"), strcat(sctring,str);

   	if(PlayerInfo[playerid][pShop] == 0) format(str,sizeof(str),"{cccccc}Купить Лавку {99ff66}69000$\n"), strcat(sctring,str);
	ShowDialog(playerid,1099,DIALOG_STYLE_LIST,"{ff9000}Торговля",sctring,"Выбрать","Отмена");
	return 1;
}
CMD:play(playerid)
{
	if(DicePlayer[playerid] == 0 || DiceStat[playerid] == 0) return DicePlayer[playerid] = 0, ErrorMessage(playerid, "{FF6347}У вас нет предложения сыграть в кости");
	new seller = DicePlayer[playerid]-1;
	if(IsOnline(seller))
	{
        if(oGetPlayerMoney(playerid) < DicePrice[seller]) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
        if(oGetPlayerMoney(seller) < DicePrice[seller]) return ErrorMessage(playerid, "{FF6347}Игроку, который хочет с вами играть в кости, не хватает денег");
        if(GetPVarInt(seller,"afksystem") >= 3 && server != 0) return ErrorMessage(playerid, "{FF6347}Этот игрок AFK (отошел)");
        if(IsPlayerInRangeOfPoint(playerid,50.0,1377.0898,1582.1823,10.8416) && GetPlayerInterior(playerid) == INT_CASINO_ROOM && GetPlayerVirtualWorld(playerid) >= 1 && GetPlayerVirtualWorld(playerid) <= 10
		|| GetPlayerVirtualWorld(playerid) == 2001 && GetPlayerInterior(playerid) == INT_CASINO_HOL)
		{
		    if(DicePrice[seller] < 1 || DicePrice[seller] > 10000000) return ErrorMessage(playerid, "{FF6347}Сумма не меньше 1$ и не больше 10.000.000$");
		}
		else
		{
		    if(DicePrice[seller] < 1 || DicePrice[seller] > 100000) return ErrorMessage(playerid, "{FF6347}Сумма не меньше 1$ и не больше 100.000$ \n{cccccc}[ Для игр на большие суммы необходимо находиться в казино ]");
		}
        switch(random(3))
     	{
			case 0: around_player_audio(playerid, 33401, 0, 5.0, 0);
			case 1: around_player_audio(playerid, 33402, 0, 5.0, 0);
			case 2: around_player_audio(playerid, 33403, 0, 5.0, 0);
		}
		new planum1, planum2;
		planum1 = 1+random(11);
		planum2 = 1+random(11);

		new string[80];
		format(string,sizeof(string),"кидает кости и на них выпадает число %d", planum1);
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,6000);
		format(string,sizeof(string),"кидает кости и на них выпадает число %d", planum2);
		SetPlayerChatBubble(seller,string,COLOR_PURPLE,20.0,6000);

		new str[54],sctring[162];
		format(str,sizeof(str),"{cccccc}Игроки бросают кости:\n"), strcat(sctring,str);
		if(planum1 == planum2)
		{
		    format(str,sizeof(str),"{ff9000}%s: {99ff66}%d", rpplayername(playerid), planum1), strcat(sctring,str);
		    format(str,sizeof(str),"\n{ff9000}%s: {99ff66}%d", rpplayername(seller), planum2), strcat(sctring,str);
		    format(str,sizeof(str),"\n\n{ffffff}Ничья!"), strcat(sctring,str);
		}
		else if(planum1 > planum2)
		{
		    format(str,sizeof(str),"{ff9000}%s: {99ff66}%d", rpplayername(playerid), planum1), strcat(sctring,str);
		    format(str,sizeof(str),"\n{ff9000}%s: {FF6347}%d", rpplayername(seller), planum2), strcat(sctring,str);
		    format(str,sizeof(str),"\n\n{ffffff}Победитель: {99ff66}%s", rpplayername(playerid)), strcat(sctring,str);
		    oGivePlayerMoney(playerid, DicePrice[seller]), SendClientMessage(playerid, COLOR_GREY, "{ffcc66}Вы выиграли {99ff66}%d$ (%s)", DicePrice[seller], get_k(DicePrice[seller]));
		    oGivePlayerMoney(seller, -DicePrice[seller]), SendClientMessage(seller, COLOR_GREY, "{ffcc66}Вы проиграли {FF6347}%d$ (%s)", DicePrice[seller], get_k(DicePrice[seller]));
 			
			MoneyLog("dice", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[seller][pID], PlayerInfo[seller][pName], PlayerInfo[seller][pPlaIP], DicePrice[seller], "");
			MoneyLog("dice", PlayerInfo[seller][pID], PlayerInfo[seller][pName], PlayerInfo[seller][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -DicePrice[seller], "");
		}
		else if(planum2 > planum1)
		{
		    format(str,sizeof(str),"{ff9000}%s: {99ff66}%d", rpplayername(seller), planum2), strcat(sctring,str);
		    format(str,sizeof(str),"\n{ff9000}%s: {FF6347}%d", rpplayername(playerid), planum1), strcat(sctring,str);
		    format(str,sizeof(str),"\n\n{ffffff}Победитель: {99ff66}%s", rpplayername(seller)), strcat(sctring,str);
		    oGivePlayerMoney(seller, DicePrice[seller]), SendClientMessage(seller, COLOR_GREY, "{ffcc66}Вы выиграли {99ff66}%d$ (%s)", DicePrice[seller], get_k(DicePrice[seller]));
		    oGivePlayerMoney(playerid, -DicePrice[seller]), SendClientMessage(playerid, COLOR_GREY, "{ffcc66}Вы проиграли {FF6347}%d$ (%s)", DicePrice[seller], get_k(DicePrice[seller]));
		    
			MoneyLog("dice", PlayerInfo[seller][pID], PlayerInfo[seller][pName], PlayerInfo[seller][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], DicePrice[seller], "");
			MoneyLog("dice", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[seller][pID], PlayerInfo[seller][pName], PlayerInfo[seller][pPlaIP], -DicePrice[seller], "");
		}
  		ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Кости",sctring,"Oк","");
  		ShowDialog(seller,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Кости",sctring,"Oк","");
  		DicePlayer[playerid] = 0, DicePlayer[seller] = 0;
  		DiceStat[playerid] = 0, DiceStat[seller] = 0;
  		DicePrice[playerid] = 0, DicePrice[seller] = 0;
	}
	else DicePlayer[playerid] = 0, ErrorMessage(playerid, "{FF6347}Игрок, который предложил играть в кости куда-то делся");
	return 1;
}
CMD:not(playerid)
{
	if(DicePlayer[playerid] == 0) return ErrorMessage(playerid, "{FF6347}У вас нет предложения сыграть в кости");
	new seller = DicePlayer[playerid]-1;
	if(IsOnline(seller))
	{
	    DicePlayer[seller] = 0;
		PlayerPlaySound(seller,6801,0,0,0);
		if(DicePlayer[playerid] == 1)
		{
			SendClientMessage(seller, COLOR_GREY, "[ Мысли ]: %s {FF6347}отказывается {cccccc}от игры в кости", rpplayername(playerid));
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {FF6347}отказываюсь {cccccc}от игры в кости с %s", rpplayername(seller));
		}
		else
		{
			SendClientMessage(seller, COLOR_GREY, "[ Мысли ]: %s {FF6347}отменяет {cccccc}игру в кости", rpplayername(playerid));
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {FF6347}отменяю {cccccc}игру в кости с %s", rpplayername(seller));
		}
	}
 	else
 	{
 		if(DicePlayer[playerid] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {FF6347}отказываюсь {cccccc}от игры в кости");
 		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {FF6347}отменяю {cccccc}игру в кости");
	}
	PlayerPlaySound(playerid,6801,0,0,0);
	DicePlayer[playerid] = 0, DiceStat[playerid] = 0;
	return 1;
}
CMD:yes(playerid)
{
	if(OnlineInfo[playerid][oSaleThing] == 0) return ErrorMessage(playerid, "{FF6347}Вам никто не предлагал купить предметы");
	new giveplayerid = OnlineInfo[playerid][oSaleSeller];
	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Продавец вышел из игры"), OnlineInfo[playerid][oSaleThing] = 0;
	if(GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING || !ProxDetectorS(5.0, playerid,giveplayerid)) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока {cccccc}[ Не дальше 5-ти метров ]");
	
 	new inva = OnlineInfo[playerid][oSaleInva], fpick = OnlineInfo[playerid][oSaleThing], fpara = OnlineInfo[playerid][oSalePara];
	new fqara = OnlineInfo[playerid][oSaleQara], fquan = OnlineInfo[playerid][oSaleQuan], thingType = OnlineInfo[playerid][oSaleType];
	new thingPack = OnlineInfo[playerid][oSalePack], thingPrice = OnlineInfo[playerid][oSalePrice];
  	if(PlayerInfo[giveplayerid][pInven][inva] != fpick || PlayerInfo[giveplayerid][pInvenPara][inva] != fpara
  		|| fquan > 0 && PlayerInfo[giveplayerid][pInvenQuan][inva] < fquan || PlayerInfo[giveplayerid][pInvenType][inva] != thingType) return ErrorMessage(playerid, "{FF6347}Продавец переместил или использовал предмет в инвентаре {cccccc}[ Отмена покупки ]"), OnlineInfo[playerid][oSaleThing] = 0;

	if(oGetPlayerMoney(playerid) < OnlineInfo[playerid][oSalePrice]) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
    if(GetPVarInt(playerid,"svzyal") >= 1 || GetPVarInt(giveplayerid,"svzyal") >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя передавать предметы во время покупок в супермаркете");
		
    if(fpick == 48 && thingType == 0 && (OnlineInfo[giveplayerid][oInflatableBoat] != NON
		|| GetPVarInt(giveplayerid,"Arobsklad") == 3)) return ErrorMessage(playerid, "{FF6347}Продавцу нужно сдуть лодку, прежде чем её продать");
    
    // Проверка на наличие особых аксессуаров (Каска и Броня)
	if(IsArmor(fpick) && thingType == 2 && PlayerInfo[playerid][pArmor] >= 1) return ErrorMessage(playerid, "{FF6347}У меня уже есть этот предмет");

	new string[180];
    // Проверка на лимиты количественного предмета
	new yes = 1, quanThing;
	if(thingType == 0) // Обычный предмет
	{
	    if(CheckThingQuan(fpick) == 1) // Предмет имеет количество
		{
		    quanThing = 1;
		    new getQuan, getLimit;
		    i_limit(playerid, fpick, getQuan, getLimit);
		    if(getQuan+fquan > getLimit) return format(string,sizeof(string),"{FF6347}У вас нет места в инвентаре\nЛимит для этого предмета: %d\n\n{cccccc}Предметы учитываются из раздела торговли и упаковок с подарками и рюкзаков", getLimit), ErrorMessage(playerid, string);
		}
	}

    // Передача предмета
	if(yes == 1)
	{
	    if(JustOneThingInventory(fpick, thingType) && get_invent(playerid, fpick, thingType) > 0) return ErrorMessage(playerid, "{FF6347}У меня уже есть этот предмет");

	    new put_inva = GiveThingPlayer(playerid, fpick, fquan, fpara, fqara, thingType, thingPack, 9999); // Выдаём предмет игроку
	    if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет

	    if(quanThing == 1) take_away(giveplayerid, fquan, inva); // Отнимаем предмет (по количеству)
	    else i_del(giveplayerid, inva); // Отнимаем предмет (целиком)

        format(string,sizeof(string),"[ Мысли ]: Я купил%s {99ff66}%s {cccccc}у %s за {99ff66}%d$ [%s]", gender(playerid), GetNameThing(0, fpick, thingType, 0), rpplayername(giveplayerid), thingPrice, get_k(thingPrice));
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: %s купил%s у меня %s за {99ff66}%d$ [%s]", rpplayername(playerid), gender(playerid), GetNameThing(1, fpick, thingType, 0), thingPrice, get_k(thingPrice));
		SendClientMessage(giveplayerid, COLOR_GREY, string);
		
		format(string, sizeof(string), "* %s достаёт %s и передаёт %s.", playername(giveplayerid), GetNameThing(0, fpick, thingType, 0), playername(playerid));
		ProxDetector(20.0, giveplayerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		if(GetPlayerState(giveplayerid) == PLAYER_STATE_ONFOOT) payanim(playerid, 0);
		PlayerPlaySound(playerid,6401,0,0,0), PlayerPlaySound(giveplayerid,6401,0,0,0);
		
		oGivePlayerMoney(playerid, -OnlineInfo[playerid][oSalePrice]);
		oGivePlayerMoney(giveplayerid, OnlineInfo[playerid][oSalePrice]);
		OnlineInfo[playerid][oSaleThing] = 0, OnlineInfo[playerid][oSaleQuan] = 0, OnlineInfo[playerid][oSalePara] = 0;
		OnlineInfo[playerid][oSaleQara] = 0, OnlineInfo[playerid][oSaleInva] = 0, OnlineInfo[playerid][oSalePrice] = 0;
		OnlineInfo[playerid][oSaleSeller] = 0, OnlineInfo[playerid][oSaleType] = 0, OnlineInfo[playerid][oSalePack] = 0;

		// Формируем инфу логов
		new string_sell[100];
		format(string_sell,sizeof(string_sell),"Продал: %s [%d$]",GetNameThing(1, fpick, thingType, 0), thingPrice);
		new string_buy[100];
		format(string_buy,sizeof(string_buy),"Купил: %s [%d$]",GetNameThing(1, fpick, thingType, 0), thingPrice);

		// Логируем бабки
		MoneyLog("sell", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], OnlineInfo[playerid][oSalePrice], string_sell);
		MoneyLog("buy", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], -OnlineInfo[playerid][oSalePrice], string_buy);

		// Логируем передачу
		UserLog("sell", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], fquan, string_sell);
		UserLog("buy", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], fquan, string_buy);
	}
	return 1;
}
CMD:no(playerid)
{
	if(OnlineInfo[playerid][oSaleThing] == 0) return ErrorMessage(playerid, "{FF6347}Вам никто не предлагал купить предметы");
	new giveplayerid = OnlineInfo[playerid][oSaleSeller];
	if(IsOnline(giveplayerid))
	{
		PlayerPlaySound(giveplayerid,6801,0,0,0);
		SendClientMessage(giveplayerid, COLOR_GREY, "[ Мысли ]: %s {FF6347}отказывается {cccccc}от покупки", rpplayername(playerid));
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {FF6347}отказываюсь {cccccc}от покупки у %s", rpplayername(giveplayerid));
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {FF6347}отказываюсь {cccccc}от покупки");
	PlayerPlaySound(playerid,6801,0,0,0);
	OnlineInfo[playerid][oSaleThing] = 0, OnlineInfo[playerid][oSaleQuan] = 0, OnlineInfo[playerid][oSalePara] = 0;
	OnlineInfo[playerid][oSaleQara] = 0, OnlineInfo[playerid][oSaleInva] = 0, OnlineInfo[playerid][oSalePrice] = 0;
	OnlineInfo[playerid][oSaleSeller] = 0, OnlineInfo[playerid][oSaleType] = 0, OnlineInfo[playerid][oSalePack] = 0;
	return 1;
}
CMD:givedrugs(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "iii", params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать игроку вещества [ /givedrugs Вещество ID количество ]");
    if(!IsOnline(params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
    if(params[2] > 10000 || params[2] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество не меньше 1 и не больше 10.000");
	if(params[0] > 4 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер вещества не меньше 1 и не больше 4");
	new string[144];
	if(params[0] == 1)
	{
		if(CheckInvent(params[1]) && get_invent2(params[1], 4, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его инвентарь заполнен");
		if(get_invent2(params[1], 4, 0)+params[2] > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет места для такого количества травы [ Лимит: 1000 ]");
		GiveThingPlayer(params[1], 4, params[2], 0, 0, 0, 0, 9999);
		format(string, sizeof(string), " [ ADM ]: Админ %s выдал %s %d грамм травы", PlayerInfo[playerid][pName],PlayerInfo[params[1]][pName],params[2]);
		ABroadCast(COLOR_ADM,string,2);
		AdminLog("givedrugs", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[1]][pID], PlayerInfo[params[1]][pName], PlayerInfo[params[1]][pPlaIP], params[2], "Выдал траву");
	}
	else if(params[0] == 2)
	{
		if(CheckInvent(params[1]) && get_invent2(params[1], 5, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его инвентарь заполнен");
		if(get_invent2(params[1], 5, 0)+params[2] > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет места для такого количества спидов [ Лимит: 1000 ]");
		GiveThingPlayer(params[1], 5, params[2], 0, 0, 0, 0, 9999);
		format(string, sizeof(string), " [ ADM ]: Админ %s выдал %s %d таблеток", PlayerInfo[playerid][pName],PlayerInfo[params[1]][pName],params[2]);
		ABroadCast(COLOR_ADM,string,2);
		AdminLog("givedrugs", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[1]][pID], PlayerInfo[params[1]][pName], PlayerInfo[params[1]][pPlaIP], params[2], "Выдал таблетки");
	}
	else if(params[0] == 3)
	{
		if(CheckInvent(params[1]) && get_invent2(params[1], 6, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его инвентарь заполнен");
		if(get_invent2(params[1], 6, 0)+params[2] > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет места для такого количества грибов [ Лимит: 1000 ]");
		GiveThingPlayer(params[1], 6, params[2], 0, 0, 0, 0, 9999);
		format(string, sizeof(string), " [ ADM ]: Админ %s выдал %s %d грибов", PlayerInfo[playerid][pName],PlayerInfo[params[1]][pName],params[2]);
		ABroadCast(COLOR_ADM,string,2);
		AdminLog("givedrugs", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[1]][pID], PlayerInfo[params[1]][pName], PlayerInfo[params[1]][pPlaIP], params[2], "Выдал грибы");
	}
	else if(params[0] == 4)
	{
		if(CheckInvent(params[1]) && get_invent2(params[1], 7, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его инвентарь заполнен");
		if(get_invent2(params[1], 7, 0)+params[2] > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет места для такого количества порошка [ Лимит: 1000 ]");
		GiveThingPlayer(params[1], 7, params[2], 0, 0, 0, 0, 9999);
		format(string, sizeof(string), " [ ADM ]: Админ %s выдал %s %d грамм порошка", PlayerInfo[playerid][pName],PlayerInfo[params[1]][pName],params[2]);
		ABroadCast(COLOR_ADM,string,2);
		AdminLog("givedrugs", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[1]][pID], PlayerInfo[params[1]][pName], PlayerInfo[params[1]][pPlaIP], params[2], "Выдал порошок");
	}
	return 1;
}
CMD:makehelper(playerid, const params[])
{
    new para1;
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "u", para1)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Назначит хелпера /makehelper ID");
	if(!IsOnline(para1)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет");
	if(PlayerInfo[para1][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это уже администратор или хелпер");
	if(PlayerInfo[para1][pGoogle] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
	if(PlayerInfo[para1][pLeader] >= 1 || PlayerInfo[para1][pMember] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его нужно уволить из организации или снять с лидерки [ /au /ml ]");
	if(PlayerInfo[para1][pHidden] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это скрытый аккаунт");
	
	PlayerInfo[para1][pSoska] = 1;
	MakeadminPlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pSoska]);

	#if defined SAMPVOICE_COMPILE_3 
	Sampvoice3AttachAdmin(playerid);
	#endif
	
	new give_skin_id = PlayerInfo[para1][pSex] == 1 ? 385 : 389;
	new put_inva = GiveThingPlayer(para1, give_skin_id, 1, 0, 0, 3, 0, 9999);
	if(put_inva == -1)
	{
		Throw(para1, give_skin_id, 1, 0, 0, 3, 0);
		SendClientMessage(para1, COLOR_GREY, "{0088ff}[ Подарок ]: {ffcc66}Вы получили подарок [В инвентаре нет места, подарок упал на землю]");
	}

	PlayerPlaySound(para1,31204,0,0,0);
	new string[144];
	format(string, sizeof(string), "{ffffff}* {ffffff}[ {ffcc66}Server {ffffff}] {ffcc66}%s {ffffff}назначил вас хелпером {0088ff}[ Подарок Одежда ]", PlayerInfo[playerid][pName]);
	SendClientMessage(para1, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "{00cc00}[ {ffffff}Мысли {00cc00}]{ffffff}: Я назначил хелпером игрока {00cc00}%s.",PlayerInfo[para1][pName]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	new str[100],sctring[400];
	format(str,sizeof(str),"{ffcc66}* {ffffff}Вы были назначены хелпером\n"), strcat(sctring,str);
	format(str,sizeof(str),"{ffcc66}* {ffffff}Ознакомтесь с правилами хелперов на форуме в течении 3 ёх часов\n"), strcat(sctring,str);
	ShowDialog(para1,1995,DIALOG_STYLE_MSGBOX,"{0088ff}Хелпер",sctring,"*","");
	mysql_save(para1, 10);
	AdminLog("makehelper", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 1, "");
	return 1;
}
CMD:showgold(playerid, const params[])
{
	new giveplayerid, string[256];
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(box[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я на ринге");
 	if (!sscanf(params, "u", giveplayerid))
 	{
 		if(IsOnline(giveplayerid))
   		{
	   		if (ProxDetectorS(5.0, playerid, giveplayerid))
	  	    {
                if(GetPVarInt(playerid,"antiflood") > 0) return SendClientMessage(playerid, COLOR_RED, " Не Флуди! ");
                if(GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && PlayerInfo[giveplayerid][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
	          	PlayerPlaySound(playerid,40405,0,0,0);
               	PlayerPlaySound(giveplayerid, 1057, 0.0, 0.0, 0.0);
               	new str[256],sctring[2000];
               	format(str,sizeof(str),"{000000}.\n");
           		strcat(sctring,str);
           		format(str,sizeof(str),"{0088ff}_______________________________________________________________\n");
           		strcat(sctring,str);
           		format(str,sizeof(str),"{FFFFFF}*{FF6000}Золото {00ff09}%d грамм.\n",PlayerInfo[playerid][pDonateMoney]);
           		strcat(sctring,str);
           		format(str,sizeof(str),"{0088ff}_______________________________________________________________\n");
           		strcat(sctring,str);
           		format(str,sizeof(str),"{000000}.\n");
           		strcat(sctring,str);
           		new lol[256];
           		format(lol,sizeof(lol),"{94ddff}Золото: {FF6000}%s",PlayerInfo[playerid][pName]);
           		ShowDialog(giveplayerid,1700,DIALOG_STYLE_MSGBOX,lol,sctring,"Ок","");
           		if(PlayerInfo[playerid][pSex] == 1)
           		{
				  format(string, sizeof(string), "* %s показал вам свой мешочек с золотом.", PlayerInfo[playerid][pName]);
				  SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
		        }
		        else if(PlayerInfo[playerid][pSex] == 2)
           		{
				  format(string, sizeof(string), "* %s показала вас свой мешочек с золотом.", PlayerInfo[playerid][pName]);
				  SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
		        }
				format(string, sizeof(string), "* Вы показали свой мешочек с золотом %s.", PlayerInfo[giveplayerid][pName]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
				format(string, sizeof(string), "* %s показывает свой мешочек с золотом %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName]);
	       		ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	       		SetPVarInt(playerid,"antiflood",5);
	   		}
	   		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он далеко от меня");
  		}
  		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
   	}
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать золото /showgold ID");
    return 1;
}

stock get_slotmap_free()
{
    if(MapInfo[0][mapload] == 0) return 0;
	else if(MapInfo[1][mapload] == 0) return 1;
	else if(MapInfo[2][mapload] == 0) return 2;
	else if(MapInfo[3][mapload] == 0) return 3;
	else if(MapInfo[4][mapload] == 0) return 4;
	return -1;
}
forward Call_getnamemap(playerid, stat);
public Call_getnamemap(playerid, stat)
{
	new rows,datad1[64];
	cache_get_row_count(rows);
	if(rows)
	{
	    cache_get_value_name(0, "namemap", datad1, 24);

		new string_mysql[140];
	    if(stat == 0)
    	{
	        mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `pp_map` WHERE `namemap` = '%e'", datad1);
            mysql_tquery(pearsq, string_mysql, "LoadMap", "dsdd", playerid, datad1, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
     	}
     	else if(stat == 1)
    	{
	        mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `pp_map` WHERE `namemap` = '%e'", datad1);
   			mysql_tquery(pearsq, string_mysql, "DeleteMap", "ds", playerid, datad1);
     	}
	}
	return 1;
}
forward LoadMap(playerid, const map_name[], map_world, map_int);
public LoadMap(playerid, const map_name[], map_world, map_int)
{
	new rows;
	cache_get_row_count(rows);
	if(MapInfo[0][mapload] > 0 && MapInfo[1][mapload] > 0 && MapInfo[2][mapload] > 0 && MapInfo[3][mapload] > 0 && MapInfo[4][mapload] > 0) return ErrorMessage(playerid, "{FF6347}Нет свободных слотов для загрузки карты");
	if(strfind(MapInfo[0][mapload],map_name,true) != (-1) || strfind(MapInfo[1][mapload],map_name,true) != (-1) || strfind(MapInfo[2][mapload],map_name,true) != (-1)
	|| strfind(MapInfo[3][mapload],map_name,true) != (-1) || strfind(MapInfo[4][mapload],map_name,true) != (-1)) return ErrorMessage(playerid, "{FF6347}Эта карта уже загружена на сервер");
	
	new string[100];
	if(rows)
	{
	    pc_cmd_map(playerid);
	    new map_id = create_map(map_name, map_world, map_int, rows);
		
		for(new ob = 0; ob < MAX_MAPOBJECT; ob++)
		{
			if(IsValidDynamicObject(MapInfo[map_id][mapobject][ob])) ObjectMapLabelAll(0, ob);
		}

		format(string, sizeof(string), " [ ADM ]: %s загрузил карту %s",PlayerInfo[playerid][pName],map_name);
		ABroadCast(COLOR_ADM,string,1);
		format(string, sizeof(string), "{0088ff}Карта загружена: {ffcc66}%s [ID карты: %d]",map_name, map_id);
		SendClientMessage(playerid, COLOR_GREY, string);
		AdminLog("loadmap", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, map_name);
	}
	else format(string,sizeof(string), "{FF6347}Этой карты не существует: %s", map_name), ErrorMessage(playerid, string);
	return 1;
}

forward Call_create_map(const map_name[], map_world, map_int);
public Call_create_map(const map_name[], map_world, map_int)
{
    new rows;
	cache_get_row_count(rows);
	if(rows) create_map(map_name, map_world, map_int, rows);
	return 1;
}
stock create_map(const map_name[], map_world, map_int, rows)
{
    new f_str[144], idx, model, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, map_id = get_slotmap_free();
	for(new f; f < rows; ++f)
	{
		cache_get_value_name(f, "option", f_str, 144);
		if(idx < MAX_MAPOBJECT)
		{
			sscanf(f_str, "p<,>iffffff",model,x,y,z,rx,ry,rz);
			if(model > 0)
			{
				MapInfo[map_id][mapobject][MapInfo[map_id][quanobject]] = CreateDynamicObject(model, x,y,z,rx,ry,rz, map_world, map_int, -1, 300.00, 300.00);
				MapInfo[map_id][quanobject] ++;
				idx ++;
			}
		}
	}
	MapInfo[map_id][mapload] = 1;
	format(MapInfo[map_id][mapname], 64, "%s",map_name);
	
	new string_mysql[140];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `s_maps` WHERE `namemap` = '%e'", map_name);
	mysql_tquery(pearsq, string_mysql, "Call_infomaps", "sdddd", map_name, 0, map_world, map_int, MapInfo[map_id][quanobject]);
	return map_id;
}
forward DeleteMap(playerid, const map_name[]);
public DeleteMap(playerid, const map_name[])
{
	new rows, string[160];
	cache_get_row_count(rows);
	if(rows)
	{
	    pc_cmd_map(playerid);
		for(new f; f < rows; ++f) 
		{
			mysql_format(pearsq, string,sizeof(string),"DELETE FROM `pp_map` WHERE `namemap` = '%e'" ,map_name);
			query_empty(pearsq, string);
		}
  		format(string, sizeof(string), " [ ADM ]: %s удалил из базы карту %s",PlayerInfo[playerid][pName],map_name);
      	ABroadCast(COLOR_ADM,string,1);
		AdminLog("deletemap", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, map_name);
		
		mysql_format(pearsq, string,sizeof(string),"DELETE FROM `s_maps` WHERE `namemap` = '%e'", map_name);
		query_empty(pearsq, string);
    }
	else format(string,sizeof(string), "{FF6347}Этой карты не существует: %s", map_name), ErrorMessage(playerid, string);
	return 1;
}
forward SaveMap(playerid, const map_name[]);
public SaveMap(playerid, const map_name[])
{
	new rows;
	cache_get_row_count(rows);
    if(MapInfo[0][quanobject] <= 0) return ErrorMessage(playerid, "{FF6347}На сервере нет ни одного созданного объекта");
    if(getmaploaded() >= 2) return ErrorMessage(playerid, "{FF6347}Загружено одновременно две карты или более");
    new string[340];
    pc_cmd_map(playerid);
	if(rows) // Карта уже существует
	{
	    for(new f; f < rows; ++f) 
		{
			mysql_format(pearsq, string,sizeof(string),"DELETE FROM `pp_map` WHERE `namemap` = '%e'" ,map_name);
			query_empty(pearsq, string);
		}
    }
    new Float:dobject_pos[3], Float:dobject_rot[3], obj_modelid, obj_world, obj_int;
	for(new i = 0; i < MAX_MAPOBJECT; i++)
    {
        if(IsValidDynamicObject(MapInfo[0][mapobject][i]))
        {
    		obj_world = Streamer_GetIntData(STREAMER_TYPE_OBJECT, MapInfo[0][mapobject][i], E_STREAMER_WORLD_ID);
    		obj_int = Streamer_GetIntData(STREAMER_TYPE_OBJECT, MapInfo[0][mapobject][i], E_STREAMER_INTERIOR_ID);
            GetDynamicObjectPos(MapInfo[0][mapobject][i], dobject_pos[0], dobject_pos[1], dobject_pos[2]);
            GetDynamicObjectRot(MapInfo[0][mapobject][i], dobject_rot[0], dobject_rot[1], dobject_rot[2]);
            obj_modelid = Streamer_GetIntData(STREAMER_TYPE_OBJECT, MapInfo[0][mapobject][i], E_STREAMER_MODEL_ID);
            mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_map` SET `namemap` = '%e', `option` = '%d,%f,%f,%f,%f,%f,%f'",map_name,obj_modelid,dobject_pos[0], dobject_pos[1], dobject_pos[2],dobject_rot[0], dobject_rot[1], dobject_rot[2]);
			query_empty(pearsq, string);
        }
    }
  	format(string, sizeof(string), " [ ADM ]: %s сохранил карту %s [%d объектов]",PlayerInfo[playerid][pName], map_name, MapInfo[0][quanobject]);
  	ABroadCast(COLOR_ADM,string,1);
 	format(string, sizeof(string), "{0088ff}Карта Сохранена: {ffcc66}%s [%d объектов]",map_name, MapInfo[0][quanobject]);
  	SendClientMessage(playerid, COLOR_GREY, string);
  	AdminLog("savemap", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", MapInfo[0][quanobject], map_name);
  	
  	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `s_maps` WHERE `namemap` = '%e'", map_name);
	mysql_tquery(pearsq, string, "Call_infomaps", "sdddd", map_name, 1, obj_world, obj_int, MapInfo[0][quanobject]);
	return 1;
}
CMD:hotel(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid,3.0,1276.8934,-44.6260,1000.9280) 
		&& (GetPlayerVirtualWorld(playerid) == 3 || GetPlayerVirtualWorld(playerid) == 6) && GetPlayerInterior(playerid) == 3)
 	{
		new city;
		if(GetPlayerVirtualWorld(playerid) == 3) city = 1;
		else if(GetPlayerVirtualWorld(playerid) == 6) city = 3;

 	    PlayerPlaySound(playerid,40405,0,0,0);
 	    if(PlayerInfo[playerid][pKomnata] == 9999 || PlayerInfo[playerid][pKomnata] == 0 || PlayerInfo[playerid][pKomnataCity] != city)
 	    {
			DP[0][playerid] = city;
			ShowDialog(playerid,628,DIALOG_STYLE_MSGBOX,"{ff9000}Отель","{ff9000}Вы уверены, что хотите снять номер в отеле?\n{99ff66}Стоимость: 100$ в час","Да","Нет");
		}
		else
		{
			new string[110];
		    format(string,sizeof(string),"{FF6347}Вы уверены, что хотите выселиться из номера в отеле?\n{cccccc}Вы снимаете: %d номер",PlayerInfo[playerid][pKomnata]);
			ShowDialog(playerid,628,DIALOG_STYLE_MSGBOX,"{ff9000}Отель",string,"Да","Нет");
		}
  	}
	return 1;
}
stock GetPlayerVip(p)
{
	new vip;
	if(PlayerInfo[p][pDonateRank] == 0) vip = 0;
	else if(PlayerInfo[p][pDonateRank] == 1 || PlayerInfo[p][pDonateRank] == 2)
	{
	    if(PlayerInfo[p][pUpgrade] >= gettime()) vip = 1;
		else vip = 0;
	}
	else if(PlayerInfo[p][pDonateRank] == 3 || PlayerInfo[p][pDonateRank] == 4) vip = 4;
	return vip;
}
stock getunix(unix, &day, &hour, &minute, &second)
{
    new vrhour, vrmin;
    day = unix/86400; // Дни
    
    vrhour = unix-day*86400;
    hour = vrhour/3600; // Часы
    
    vrmin = vrhour-hour*3600;
    minute = vrmin/60; // Минуты
    
    second = vrmin-minute*60; // Секунды
}
CMD:vip(playerid)
{
	PlayerPlaySound(playerid,40405,0,0,0);
	new stro[100],sctroing[1300];
	if(GetPlayerVip(playerid) == 0) format(stro,sizeof(stro),"\n{ffcc00}VIP {FF6347}[ Отсутствует ]"),strcat(sctroing,stro);
	else if(GetPlayerVip(playerid) >= 3) format(stro,sizeof(stro),"\n{7474da}Platinum VIP {99ff66}[ Приобретен ]"),strcat(sctroing,stro);
	else if(GetPlayerVip(playerid) == 1 || GetPlayerVip(playerid) == 2)
	{
		new day, hour, minute, second;
		getunix(PlayerInfo[playerid][pUpgrade]-gettime(), day, hour, minute, second);
		format(stro,sizeof(stro),"\n{ffcc00}Временная VIP {99ff66}[ Приобретена ]"),strcat(sctroing,stro);
		format(stro,sizeof(stro),"\n{444444}Осталось: {cccccc}%02d дней, %02d часов, %02d минут, %02d секунд", day, hour, minute, second),strcat(sctroing,stro);
	}
	format(stro,sizeof(stro),"\n\n{ffffff}Какие возможности у VIP аккаунта?"),strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Доставка личного транспорта на ближайшую парковку спустя время {ff9000}[ /car ]"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Все скилы повышаются в два раза быстрее {ff9000}[ /skill ]"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- VIP Рекламные объявления {ff9000}[ /ad ]"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Возможность выключать Сим Карту [ /togwh или Y >> Меню ]"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Каждый 5-ый час в игре +1 Опыт {ff9000}[ /stats ]"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Возможность открыть багажник или капот личного транспорта, не отпирая двери"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Возможность продавать транспорт возле центра обмена и не находиться рядом с ним"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Возможность уволиться самостоятельно {444444}[ /leave ] {7474da}Только Platinum VIP"), strcat(sctroing,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Подсвечивание ближайших скоростных радаров на мини-карте {7474da}Только Platinum VIP"), strcat(sctroing,stro);

	format(stro,sizeof(stro),"\n"), strcat(sctroing,stro);
	ShowDialog(playerid,2002,DIALOG_STYLE_MSGBOX,"Меню {ff9000}Donate",sctroing,"Ок","");
	return 1;
}
