stock PosInterDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 2 || setting_size_draw[playerid] == 2) positiond_x = interdraw_x+set_pos_x[playerid], positiond_y = interdraw_y+set_pos_y[playerid];
    else positiond_x = interdraw_x+PlayerInfo[playerid][pDrawPos_X][1], positiond_y = interdraw_y+PlayerInfo[playerid][pDrawPos_Y][1];
    
    if(setting_pos_draw[playerid] == 2 || setting_size_draw[playerid] == 2) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][1], sized_y = PlayerInfo[playerid][pDrawSize_Y][1];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[1], positiond_y += DrawPosSmart_Y[1], sized_y += DrawSizeSmart_Y[1];

    PlayerTextDrawSetPos(playerid, PlaInter[0][playerid], positiond_x, positiond_y); // Фон Интерактирования
    PlayerTextDrawSetPos(playerid, PlaInter[1][playerid], positiond_x+39.897522+sized_x/2, positiond_y+0.911106); // Передать
    PlayerTextDrawSetPos(playerid, PlaInter[2][playerid], positiond_x+39.897522+sized_x/2, positiond_y+23.377781+sized_y/2); // Продать
    PlayerTextDrawSetPos(playerid, PlaInter[3][playerid], positiond_x+19.901184+sized_x/4, positiond_y+0.777723); // Имя
    PlayerTextDrawSetPos(playerid, PlaInter[4][playerid], positiond_x-0.345002-sized_x/4, positiond_y+4.044428); // Скин Взаимодействия
    
    PlayerTextDrawTextSize(playerid, PlaInter[0][playerid], 60.996505+sized_x, 45.888893+sized_y); // Фон Интерактирования
    PlayerTextDrawTextSize(playerid, PlaInter[1][playerid], 20.246061+sized_x/2, 21.466651+sized_y/2); // Передать
    PlayerTextDrawTextSize(playerid, PlaInter[2][playerid], 20.246061+sized_x/2, 21.466651+sized_y/2); // Продать
    PlayerTextDrawLetterSize(playerid, PlaInter[3][playerid], 0.102442+sized_x*(0.102442/50), 0.512666+sized_y*(0.512666/40)); // Имя
    PlayerTextDrawTextSize(playerid, PlaInter[4][playerid], 38.992401+sized_x, 41.533325+sized_y);
	return 1;
}
