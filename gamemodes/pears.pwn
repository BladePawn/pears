stock close_remindufo(stat, playerid, killerid)
{
	PlayerPlaySound(playerid, 1084, 0,0,0);
    if(stat == 1) 
	{
		new string[60];
		format(string, sizeof(string), " SMS от NASA: {99ff33}%s сбил НЛО!", rpplayername(killerid));
		SendClientMessage(playerid, COLOR_YELLOW, string);
	}
    else SendClientMessage(playerid, COLOR_YELLOW, " SMS от NASA: {99ff33}НЛО было потеряно радарами");
	return 1;
}
stock show_remindufo(playerid)
{
    PlayerPlaySound(playerid, 1084, 0,0,0);
    if(ufo_city == 0) SendClientMessage(playerid, COLOR_YELLOW, " SMS от NASA: {99ff33}над городом Los Santos замечено НЛО");
    else if(ufo_city == 1) SendClientMessage(playerid, COLOR_YELLOW, " SMS от NASA: {99ff33}над городом San Fierro замечено НЛО");
    else if(ufo_city == 2) SendClientMessage(playerid, COLOR_YELLOW, " SMS от NASA: {99ff33}над городом Las Venturas замечено НЛО");
	return 1;
}
function ufo_timer()
{
	if(ufo_stat == 1)
	{
	    new u_time;
		ufo_stat = 2;
		if(ufo_city == 0) u_time = MoveDynamicObject(ufo_object, 583.8641,-2909.3708,199.9167, 50.0);
		else if(ufo_city == 1) u_time = MoveDynamicObject(ufo_object, -3577.3682,361.9860,268.5614, 50.0);
		else if(ufo_city == 2) u_time = MoveDynamicObject(ufo_object, 1751.3425,3712.1072,368.7820, 50.0);
		ufo_tims = SetTimer("ufo_timer", u_time, false);
		foreach(Player, i)
		{
			if(OnlineInfo[i][oLogged] == 1 && PlayerInfo[i][pAbilStat][1] >= 5) close_remindufo(0, i, i);
		}
	}
	else if(ufo_stat == 2) DestroyDynamicObject(ufo_object), ufo_stat = 0;
	else if(ufo_stat == 3)
	{
		new Float:upos[3], Float:urpos[3];
		GetDynamicObjectPos(ufo_object, upos[0], upos[1], upos[2]);
		GetDynamicObjectRot(ufo_object, urpos[0], urpos[1], urpos[2]);
		CreateExplosion(upos[0], upos[1], upos[2], 7, 70.0);
		DestroyDynamicObject(ufo_smoke);
		ufo_stat = 4;
		ufo_tims = SetTimer("ufo_timer", 3000, false);
	}
	else if(ufo_stat == 4)
	{
		new Float:upos[3], Float:urpos[3];
		GetDynamicObjectPos(ufo_object, upos[0], upos[1], upos[2]);
		GetDynamicObjectRot(ufo_object, urpos[0], urpos[1], urpos[2]);
		ufo_detail[0] = CreateDynamicObject(854, upos[0]+2.296, upos[1]-0.962, upos[2]+0.318, -2.583274, urpos[1], 49.969429, 0, 0, -1, 300.00, 300.00);
		SetDynamicObjectMaterial(ufo_detail[0], 0, 11696, "hill250x250rocky3", "cw2_mountdirtscree3", 0x00000000);
		ufo_detail[1] = CreateDynamicObject(854, upos[0]+1.985, upos[1]-1.529, upos[2]+0.318, 4.592479, urpos[1], 101.413566, 0, 0, -1, 300.00, 300.00);
		SetDynamicObjectMaterial(ufo_detail[1], 0, 11696, "hill250x250rocky3", "cw2_mountdirtscree3", 0x00000000);
		ufo_detail[2] = CreateDynamicObject(854, upos[0]+1.307, upos[1]-1.969, upos[2]+0.318, 8.285668, urpos[1], 154.959564, 0, 0, -1, 300.00, 300.00);
		SetDynamicObjectMaterial(ufo_detail[2], 0, 11696, "hill250x250rocky3", "cw2_mountdirtscree3", 0x00000000);
		ufo_detail[3] = CreateDynamicObject(854, upos[0]+0.296, upos[1]-2.19, upos[2]+0.318, -8.120587, urpos[1], -33.929996, 0, 0, -1, 300.00, 300.00);
		SetDynamicObjectMaterial(ufo_detail[3], 0, 11696, "hill250x250rocky3", "cw2_mountdirtscree3", 0x00000000);
		ufo_detail[4] = CreateDynamicObject(854, upos[0]-0.5, upos[1]-2.315, upos[2]+0.318, 1.662750, urpos[1], -123.490547, 0, 0, -1, 300.00, 300.00);
		SetDynamicObjectMaterial(ufo_detail[4], 0, 11696, "hill250x250rocky3", "cw2_mountdirtscree3", 0x00000000);
		ufo_detail[5] = CreateDynamicObject(854, upos[0]-1.287, upos[1]-1.988, upos[2]+0.318, 1.662750, urpos[1], -123.490547, 0, 0, -1, 300.00, 300.00);
		SetDynamicObjectMaterial(ufo_detail[5], 0, 11696, "hill250x250rocky3", "cw2_mountdirtscree3", 0x00000000);
		ufo_detail[6] = CreateDynamicObject(18691, upos[0]+0.683, upos[1]-0.074, upos[2]-0.44, 0.0, 0.0, 0.0, 0, 0, -1, 300.00, 300.00);
		ufo_detail[7] = CreateDynamicObject(18691, upos[0]-1.611, upos[1]-0.691, upos[2]-1.469, 0.0, 0.0, 0.0, 0, 0, -1, 300.00, 300.00);
		SetThrow(-1, 60, 60, 8+random(8), 1, 0, 0, 0, 0, 0, upos[0]+0.797, upos[1]-2.066, upos[2]+0.674, 0.0, 0.0, 0.0, 600, 0, 0);
		SetThrow(-1, 60, 60, 8+random(8), 1, 0, 0, 0, 0, 0, upos[0]-0.064, upos[1]-2.34, upos[2]+0.729, 0.0, 0.0, 0.0, 600, 0, 0);
		SetThrow(-1, 60, 60, 8+random(8), 1, 0, 0, 0, 0, 0, upos[0]+1.758586, upos[1]-1.683, upos[2]+0.607, 0.0, 0.0, 0.0, 600, 0, 0);
		SetThrow(-1, 238, 60, 3+random(5), 1, 0, 0, 0, 0, 0, upos[0]+1.738586, upos[1]-1.892, upos[2]+0.607, 0.0, 0.0, 0.0, 600, 0, 0);
		SetThrow(-1, 238, 60, 3+random(5), 1, 0, 0, 0, 0, 0, upos[0]-0.164, upos[1]-2.01, upos[2]+0.674, 0.0, 0.0, 0.0, 600, 0, 0);
		SetThrow(-1, 61, 61, 50, 1, 0, 0, 0, 0, 0, upos[0]-1.006414, upos[1]-2.532, upos[2]+0.717, 0.0, 0.0, 0.0, 600, 0, 0);
		ufo_stat = 5;
		ufo_label = CreateDynamic3DTextLabel("{444444}UFO\n{cccccc}[ Инвентарь N >> Рядом ]",0xA9C4E4FF,upos[0], upos[1], upos[2]+1.5,9.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0);
		ufo_tims = SetTimer("ufo_timer", 600000, false);
	}
	else if(ufo_stat == 5)
	{
		new Float: upos[3];
		GetDynamicObjectPos(ufo_object, upos[0], upos[1], upos[2]);
		CreateExplosion(upos[0], upos[1], upos[2], 7, 70.0);
		DestroyDynamicObject(ufo_object), ufo_stat = 0;
		DestroyDynamicObject(ufo_detail[0]), DestroyDynamicObject(ufo_detail[1]), DestroyDynamicObject(ufo_detail[2]), DestroyDynamicObject(ufo_detail[3]);
		DestroyDynamicObject(ufo_detail[4]), DestroyDynamicObject(ufo_detail[5]), DestroyDynamicObject(ufo_detail[6]), DestroyDynamicObject(ufo_detail[7]);
		DestroyDynamic3DTextLabel(ufo_label);
	}
	return 1;
}
stock fall_ufo(stat)
{
	ufo_stat = 3;
	new Float:upos[3], fall_pos, u_time;
	GetDynamicObjectPos(ufo_object, upos[0], upos[1], upos[2]);
	CreateExplosion(upos[0], upos[1], upos[2], 7, 100.0);
	ufo_smoke = CreateDynamicObject(18723, upos[0], upos[1], upos[2], 0.000000, 0.000000, 0.000000, 0, 0, -1, 1000.00, 1000.00);
	StopDynamicObject(ufo_object);
	KillTimer(ufo_tims);
	if(stat == -1) fall_pos = findfall_pos(ufo_object);
	else fall_pos = stat;
	u_time = MoveDynamicObject(ufo_object, FallPos[fall_pos][0], FallPos[fall_pos][1], FallPos[fall_pos][2], 30.0, FallPos[fall_pos][3], FallPos[fall_pos][4], FallPos[fall_pos][5]);
	MoveDynamicObject(ufo_smoke, FallPos[fall_pos][0], FallPos[fall_pos][1], FallPos[fall_pos][2], 30.0);
	ufo_tims = SetTimer("ufo_timer", u_time, false);
	return 1;
}
stock findfall_pos(objectid)
{
	new Float:objpos, Float:findpos, kakoi;
	objpos = GetDynamicObjectDistancePoint(objectid, FallPos[0][0], FallPos[0][1], FallPos[0][2]);
	for(new i = 1; i < sizeof(FallPos); ++i)
	{
		if(objpos <= (findpos = GetDynamicObjectDistancePoint(objectid, FallPos[i][0], FallPos[i][1], FallPos[i][2]))) continue;
		objpos = findpos;
		kakoi = i;
	}
	return kakoi;
}
stock Nasabat(playerid)
{
    new current_tick = GetTickCount();
	new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
	if(interval > 300)
	{
		new numbat = -1;
		if(IsPlayerInRangeOfPoint(playerid, 2.0, 1401.267333, 2443.013427, 1457.779052)) numbat = 0;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1389.142089, 2450.013916, 1457.779052)) numbat = 1;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1395.204223, 2446.513916, 1457.779052)) numbat = 2;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1407.329345, 2439.513916, 1457.779052)) numbat = 3;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1397.766845, 2436.951416, 1457.779052)) numbat = 4;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1385.642333, 2443.951904, 1457.779052)) numbat = 5;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1391.704223, 2440.451904, 1457.779052)) numbat = 6;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1403.828979, 2433.452392, 1457.779052)) numbat = 7;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1394.266845, 2430.889892, 1457.779052)) numbat = 8;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1382.142089, 2437.889404, 1457.779052)) numbat = 9;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1388.204711, 2434.389404, 1457.779052)) numbat = 10;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1400.329345, 2427.388916, 1457.779052)) numbat = 11;
		// Солнечные Батареи на Луне
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -1.834280, 3013.850585, 957.779113)) numbat = 12;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -13.959418, 3020.851074, 957.779113)) numbat = 13;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -7.897362, 3017.351074, 957.779113)) numbat = 14;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 4.227774, 3010.351074, 957.779113)) numbat = 15;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -5.334688, 3007.788574, 957.779113)) numbat = 16;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -17.459278, 3014.789062, 957.779113)) numbat = 17;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -11.397309, 3011.289062, 957.779113)) numbat = 18;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 0.727451, 3004.289550, 957.779113)) numbat = 19;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -8.834785, 3001.727050, 957.779113)) numbat = 20;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -20.959461, 3008.726562, 957.779113)) numbat = 21;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -14.896859, 3005.226562, 957.779113)) numbat = 22;
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, -2.772269, 2998.226074, 957.779113)) numbat = 23;
		if(numbat >= 0)
		{
			if(sunp_time[numbat] <= 1)
			{
			    if(Dei[playerid] != 2) return ErrorMessage(playerid, "{FF6347}Возьмите швабру в жилом модуле");
				new string[80];
				sunp_stat[numbat] += 1+random(3);
				format(string, sizeof(string), RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~%d/100"),sunp_stat[numbat]), GameTextForPlayer(playerid,string, 1500, 3);
			 	PlayerPlaySound(playerid,20800,0,0,0);
		   		ApplyAnimation(playerid,"PED","flee_lkaround_01",4.0, false, false, false, false, false, SYNC_ALL);
				if(sunp_stat[numbat] >= 100)
				{
					sunp_time[numbat] = 600;
					PlayerInfo[playerid][pHataCena] += 10, PlayerPlaySound(playerid,6401,0,0,0);
					update_ability(playerid, 1, 10);
					if(numbat < 12)
					{
						format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+10~n~~w~NASA JOB: ~r~%d",PlayerInfo[playerid][pHataCena]);
						GameTextForPlayer(playerid,string,5000,3);
						UpdateDynamic3DTextLabelText(sunp_label[numbat],0xA9C4E4FF,"{ff9000}Солнечная Батарея\n{99ff66}[ Чистая ]");
						SetDynamicObjectMaterial(sunp_object[numbat], 0, 1697, "moregenroofstuff", "solar_panel_1", 0x00000000);
					}
					else
					{
						format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+10~n~~w~NASA JOB: ~b~%d",PlayerInfo[playerid][pHataCena]);
						GameTextForPlayer(playerid,string,5000,3);
						UpdateDynamic3DTextLabelText(sunp_label[numbat],0xA9C4E4FF,"{0088ff}Солнечная Батарея\n{99ff66}[ Чистая ]");
		  				SetDynamicObjectMaterial(sunp_object[numbat], 0, 1697, "moregenroofstuff", "solar_panel_1", 0x00000000);
					}
					mysql_save(playerid, 52);
		  			sunp_stat[numbat] = 0;

					// Чистить солнечные панели
					CompletingDaily(playerid, 9, 1);
				}
			}
		}
		Aftextdraw[playerid] = current_tick;
	}
   	return 1;
}
stock UpdateNasa()
{
	for(new sp = 0; sp < 24; sp++)
	{
		if(sunp_time[sp] >= 1) sunp_time[sp]--;
		if(sunp_time[sp] == 1)
		{
		    if(sp < 12)
		    {
	      		UpdateDynamic3DTextLabelText(sunp_label[sp],0xA9C4E4FF,"{ff9000}Солнечная Батарея\n{FF6347}[ Покрыта Пылью ]\n\n{cccccc}[ ALT + Швабра в Руках ]");
	      		SetDynamicObjectMaterial(sunp_object[sp], 0, 11395, "corvinsign_sfse", "rustb256128", 0x00000000);
	   		}
	   		else
		    {
	      		UpdateDynamic3DTextLabelText(sunp_label[sp],0xA9C4E4FF,"{0088ff}Солнечная Батарея\n{FF6347}[ Покрыта Пылью ]\n\n{cccccc}[ ALT + Швабра в Руках ]");
	      		SetDynamicObjectMaterial(sunp_object[sp], 0, 6282, "beafron2_law2", "concretenewb256128", 0x00000000);
	   		}
	      	sunp_stat[sp] = 0;
		}
	}
	for(new m = 0; m < 100; m++)
	{
		if(marsr_stat[m] == 1)
		{
		    if(marsr_time[m] > 0) marsr_time[m] --;
		    else if(marsr_time[m] == 0)
			{
				marsr_object[m] = CreateDynamicObject(3930, RockPos[m][RockPos_X], RockPos[m][RockPos_Y], RockPos[m][RockPos_Z], 0.000000, 0.000000, 34.000003, 222, 222, -1, 100.00, 100.00), marsr_stat[m] = 0;
				marsr_label[m] = CreateDynamic3DTextLabel("{ff9000}Валун\n{cccccc}[ Разбить: ALT + Кувалда в руках ]",0xA9C4E4FF,RockPos[m][RockPos_X], RockPos[m][RockPos_Y], RockPos[m][RockPos_Z],7.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,222,222);
			}
		}
	}
	for(new k = 0; k < 44; k++)
	{
		if(kmarssaj[k] == 1)
		{
			if(kmarssajtim[k] >= 1)
			{
				kmarssajtim[k] --; // 1455.278320
				if(kmarssajtim[k] == 450 || kmarssajtim[k] == 350 || kmarssajtim[k] == 150)
				{
					new Float:k_pos[3];
					GetDynamicObjectPos(kmarssajobj[k], k_pos[0], k_pos[1], k_pos[2]);
					MoveDynamicObject(kmarssajobj[k], k_pos[0], k_pos[1], k_pos[2]+0.580, 0.2);
				}
			}
			if(kmarssajtim[k] == 0)
			{
				kmarssaj[k] = 2;
				UpdateDynamic3DTextLabelText(kmarssajlab[k],-1,"{ff9000}Картофель {99ff66}[ Созрел ]\n{cccccc}[ ALT + Лопата в руках ]");
				MoveDynamicObject(kmarssajobj[k], PotatoMars[k][0], PotatoMars[k][1],1457.019531, 0.2);
			}
		}
	}
	for(new mu = 0; mu < MAX_MUSHROOMS; mu++)
	{
		if(mushrooms_stat[mu] == 1)
		{
		    if(mushrooms_time[mu] > 0) mushrooms_time[mu] --;
		    else if(mushrooms_time[mu] == 0)
			{
				mushrooms_object[mu] = CreateDynamicObject(1603, MushroomsPos[mu][MushroomsPos_X], MushroomsPos[mu][MushroomsPos_Y], MushroomsPos[mu][MushroomsPos_Z], 0.0, 0.0, 0.0, 0, 0, -1, 200.00, 200.00), mushrooms_stat[mu] = 0;
				mushrooms_label[mu] = CreateDynamic3DTextLabel("{ff9000}Гриб\n{cccccc}[ ALT ]",0xA9C4E4FF,MushroomsPos[mu][MushroomsPos_X], MushroomsPos[mu][MushroomsPos_Y], MushroomsPos[mu][MushroomsPos_Z],5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
			}
		}
	}
	new anworld;
	for(new an = 0; an < MAX_ANTIQUITIES; an++)
	{
		if(antiquities_stat[an] == 0)
		{
		    if(antiquities_time[an] > 0) antiquities_time[an] --;
		    else if(antiquities_time[an] == 0)
			{
			    if(an <= 58) anworld = 226;
			    else anworld = 227;
			    switch(random(2))
			    {
			        case 0: antiquities_object[an] = CreateDynamicObject(14705, AntiquitiesPos[an][AntiquitiesPos_X], AntiquitiesPos[an][AntiquitiesPos_Y], AntiquitiesPos[an][AntiquitiesPos_Z], 0.0, 0.0, 0.0, anworld, anworld, -1, 200.00, 200.00), antiquities_stat[an] = 1;
			        case 1: antiquities_object[an] = CreateDynamicObject(2709, AntiquitiesPos[an][AntiquitiesPos_X], AntiquitiesPos[an][AntiquitiesPos_Y], AntiquitiesPos[an][AntiquitiesPos_Z], 0.0, 0.0, 0.0, anworld, anworld, -1, 200.00, 200.00), antiquities_stat[an] = 2;
       			}
				antiquities_label[an] = CreateDynamic3DTextLabel("{ff9000}Древний Артефакт\n{cccccc}[ ALT ]",0xA9C4E4FF,AntiquitiesPos[an][AntiquitiesPos_X], AntiquitiesPos[an][AntiquitiesPos_Y], AntiquitiesPos[an][AntiquitiesPos_Z],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,anworld,anworld);
			}
		}
	}
	
	// Сад на Ферме
	for(new gar = 0; gar < MAX_GARDEN; gar++)
	{
	    if(garden_stat[gar] == 0 && garden_time[gar] > 0)
	    {
	        garden_time[gar] --;
	        if(garden_time[gar] == 0)
	        {
	        	garden_stat[gar] = 1;
	        	garden_quan[gar] = 20+random(10);
	        	fruitapp += garden_quan[gar];
	        	update_garden(gar);
	        }
	    }
	}
	return 1;
}
stock get_mushrooms(playerid)
{
	for(new mu = 0; mu < MAX_MUSHROOMS; mu++)
	{
		if(mushrooms_stat[mu] == 0)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5, MushroomsPos[mu][MushroomsPos_X], MushroomsPos[mu][MushroomsPos_Y], MushroomsPos[mu][MushroomsPos_Z]))
			{
			    give_mushrooms(playerid, mu);
				break;
			}
		}
	}
	return 1;
}
stock give_mushrooms(playerid, mu)
{
    new getQuan, getLimit;
	i_limit(playerid, 6, getQuan, getLimit);
	if(getQuan+1 > getLimit)
	{
		new string[160];
		format(string,sizeof(string),"{FF6347}У вас нет места в инвентаре\nЛимит для этого предмета: %d\n\n{cccccc}Предметы учитываются из раздела торговли и упаковок с подарками и рюкзаков", getLimit);
		ErrorMessage(playerid, string);
		return 1;
	}

	new put_inva = GiveThingPlayer(playerid, 6, 1, gettime()+1209600, 0, 0, 0, 9999); // Выдаём предмет игроку
    if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет

    DestroyDynamicObject(mushrooms_object[mu]);
	DestroyDynamic3DTextLabel(mushrooms_label[mu]);
	mushrooms_stat[mu] = 1, mushrooms_time[mu] = 600;
	ApplyAnimation(playerid,"CARRY","liftup05",2.0, false, true, true, false, false, SYNC_ALL);
	PlayerPlaySound(playerid,5600,0,0,0);
	return 1;
}
stock get_antiquities(playerid)
{
	for(new an = 0; an < MAX_ANTIQUITIES; an++)
	{
		if(antiquities_stat[an] > 0)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5, AntiquitiesPos[an][AntiquitiesPos_X], AntiquitiesPos[an][AntiquitiesPos_Y], AntiquitiesPos[an][AntiquitiesPos_Z]))
			{
				new antiqId;
				if(antiquities_stat[an] == 1) antiqId = 92;
				else if(antiquities_stat[an] == 2) antiqId = 93;
				
				new put_inva = GiveThingPlayer(playerid, antiqId, 1, 0, 0, 0, 0, 9999);
				if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре\n{cccccc}Продайте все найденные артефакты в вагончике для трудоустройства");
				
				ApplyAnimation(playerid,"CARRY","liftup05",2.0, false, true, true, false, false, SYNC_ALL);
				PlayerPlaySound(playerid,5600,0,0,0);
				DestroyDynamicObject(antiquities_object[an]);
				DestroyDynamic3DTextLabel(antiquities_label[an]);
				antiquities_stat[an] = 0, antiquities_time[an] = 120;

				// Собирать древние артефакты
				CompletingDaily(playerid, 15, 1);
				break;
			}
		}
	}
	return 1;
}
stock around_update(Float:radius, Float:x, Float:y, Float:z, world, inteior)
{
	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 
			&& GetPlayerVirtualWorld(i) == world 
			&& GetPlayerInterior(i) == inteior 
			&& IsPlayerInRangeOfPoint(i,radius, x, y, z))
		{
			Streamer_Update(i, STREAMER_TYPE_OBJECT);
		}
	}
	return 1;
}
stock around_audio(audioid, timer, Float:radius, Float:x, Float:y, Float:z, interior, world, stopid = 1069)
{
	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && GetPVarInt(i,"afksystem") <= 2 && GetPlayerVirtualWorld(i) == world && GetPlayerInterior(i) == interior && IsPlayerInRangeOfPoint(i,radius, x, y, z))
		{
			PlayerPlaySound(i,audioid,x,y,z);
			if(timer > 0) SetTimerEx("around_audiostop", timer, false, "dd", i, stopid);
		}
	}
	return 1;
}
stock around_player_audio(playerid, audioid, timer, Float:radius, launcher = 0)
{
	new Float:pos[3], world = GetPlayerVirtualWorld(playerid), interior = GetPlayerInterior(playerid);
    GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && GetPVarInt(i,"afksystem") <= 2 
			&& GetPlayerVirtualWorld(i) == world && GetPlayerInterior(i) == interior 
			&& IsPlayerInRangeOfPoint(i,radius, pos[0],pos[1],pos[2]))
		{
			if(launcher == 0 || launcher == 1 && IsPlayerSyncModels(i))
			{
				PlayerPlaySound(i,audioid,pos[0],pos[1],pos[2]);
				if(timer > 0) SetTimerEx("around_audiostop", timer, false, "dd", i, 1069);
			}
		}
	}
	return 1;
}

function around_audiostop(playerid, stopid)
{
	if(IsOnline(playerid)) PlayerPlaySound(playerid, stopid, 0, 0, 0);
}
stock reset_trash(playerid, tra, stat)
{
	if(trash_stat[tra] == 0)
	{
		new type_trash;
		if(tra <= 199) type_trash = 1332;
		else if(tra >= 200 && tra <= 349) type_trash = 1334;
		else if(tra >= 350 && tra <= 500) type_trash = 1333;
		trash_object[tra] = CreateDynamicObject(type_trash, TrashPos[tra][TrashPos_X], TrashPos[tra][TrashPos_Y], TrashPos[tra][TrashPos_Z], TrashPos[tra][TrashPos_RX], TrashPos[tra][TrashPos_RY], TrashPos[tra][TrashPos_RZ], 0, 0, -1, 200.00, 200.00);
		Streamer_SetIntData(STREAMER_TYPE_OBJECT, trash_object[tra], STREAMER_TRASHBOX_OBJECT, tra);
		SetDynamicObjectNoCameraCol(trash_object[tra]);
		trash_stat[tra] = 1, trash_player[tra] = 0;
		name_trash(tra);
	}
	if(trash_stat[tra] == 2 || trash_stat[tra] == 3)
	{
		KillTimer(trash_timer[tra]);
		StopDynamicObject(trash_object[tra]);
		SetDynamicObjectPos(trash_object[tra], TrashPos[tra][TrashPos_X], TrashPos[tra][TrashPos_Y], TrashPos[tra][TrashPos_Z]);
		SetDynamicObjectRot(trash_object[tra], TrashPos[tra][TrashPos_RX], TrashPos[tra][TrashPos_RY], TrashPos[tra][TrashPos_RZ]);
		trash_stat[tra] = 1, trash_player[tra] = 0;
		name_trash(tra);
	}
	else if(trash_stat[tra] == 4)
	{
		SetDynamicObjectPos(trash_object[tra], TrashPos[tra][TrashPos_X], TrashPos[tra][TrashPos_Y], TrashPos[tra][TrashPos_Z]);
		SetDynamicObjectRot(trash_object[tra], TrashPos[tra][TrashPos_RX], TrashPos[tra][TrashPos_RY], TrashPos[tra][TrashPos_RZ]);
		trash_stat[tra] = 1, trash_player[tra] = 0;
		name_trash(tra);
	}
	if(playerid >= 0)
	{
		if(Dei[playerid] == 9 || Dei[playerid] == 11)
		{
			RemovePlayerAttachedObject(playerid,1), PPP15[playerid] = 0;
			ClearAnimations(playerid), ClearAnim(playerid);
			ApplyAnimation(playerid,"PED","facanger",4.0, false, true, true, true, true, SYNC_ALL);
			TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
		}
		if(Dei[playerid] == 10) Dei[playerid] = 0, DeiStat[playerid] = 0;
		if(stat == 1) ErrorMessage(playerid, "{FF6347}Мусоровоз заспавнился!");
		else if(stat == 2) ErrorMessage(playerid, "{FF6347}Мусоровоз взорвался!");
		else if(stat == 3) ErrorMessage(playerid, "{FF6347}Мусоровоз сдвинулся!");
	}
	return 1;
}
stock name_trash(tra)
{
	if(trash_stat[tra] == 1)
	{
		new quan_trash;
		for(new t = 0; t < 20; t++)
		{
		    if(gTrash[t][tra] > 0) quan_trash ++;
		}
		if(quan_trash > 0) UpdateDynamic3DTextLabelText(trash_label[tra],0xA9C4E4FF,"{ff9000}Мусорный Бак\n{99ff66}[ Есть Мусор ]\n\n{cccccc}[ Посмотреть: N >> Мусор ]\n{444444}[ Погрузить в мусоровоз: ALT ]"), trash_empty[tra] = 1;
		else UpdateDynamic3DTextLabelText(trash_label[tra],0xA9C4E4FF,"{ff9000}Мусорный Бак\n{FF6347}[ Пустой ]\n\n{cccccc}[ Посмотреть: N >> Мусор ]\n{444444}[ Погрузить в мусоровоз: ALT ]"), trash_empty[tra] = 0;
	}
	else UpdateDynamic3DTextLabelText(trash_label[tra],0xA9C4E4FF,"{cccccc}Мусорный Бак\n{FF6347}[ Не на месте ]\n\n{444444}[ Поставить на место: ALT ]");
	return 1;
}
stock put_boottrash(playerid, v)
{
	RemovePlayerAttachedObject(playerid,1), PPP15[playerid] = 0;
	ClearAnimations(playerid), ClearAnim(playerid);
	ApplyAnimation(playerid,"PED","facanger",4.0, false, true, true, true, true, SYNC_ALL);
	new Float:pos[4], mytra = DeiStat[playerid], type_trash;
	if(trash_stat[mytra] != 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Мусорный контейнер куда-то делся.."), Dei[playerid] = 0;
	Dei[playerid] = 10;
	GetCoordTrashVehicle(v, pos[0], pos[1], pos[2]);
	GetVehicleZAngle(v, pos[3]);
	VehInfo[v][vNospawn] = 1;
	VehInfo[v][vJob] = 8, VehInfo[v][vJobStat] = 1, VehInfo[v][vJobID] = mytra;
	GetVehiclePos(v, VehInfo[v][VehJob_X], VehInfo[v][VehJob_Y], VehInfo[v][VehJob_Z]);
	if(mytra <= 199) type_trash = 1332;
	else if(mytra >= 200 && mytra <= 349) type_trash = 1334;
	else if(mytra >= 350 && mytra <= 500) type_trash = 1333;
	trash_stat[mytra] = 2;
	trash_object[mytra] = CreateDynamicObject(type_trash, pos[0], pos[1], pos[2], 0.0, 0.0, pos[3], 0, 0, -1, 100.00, 100.00);
	//SetDynamicObjectNoCameraCol(trash_object[mytra]);
	new t_time = MoveDynamicObject(trash_object[mytra], pos[0], pos[1], pos[2]+2.0, 0.5, -30.0, 0.0, pos[3]);
	around_update(50.0, pos[0], pos[1], pos[2]+2.0, 0, 0);
	around_audio(6800, t_time, 30.0, pos[0], pos[1], pos[2], 0, 0, 6802);

	new Float:f_pos[4];
    backme(playerid, 0.6, f_pos[0], f_pos[1], f_pos[2], f_pos[3]);
	PPSetPlayerPos(playerid, f_pos[0], f_pos[1], f_pos[2]);
	PPSetPlayerFacingAngle(playerid, f_pos[3]);

	trash_timer[mytra] = SetTimerEx("discharge_timer", t_time, false, "ddd", playerid, mytra, v);
	return 1;
}
function discharge_timer(playerid, tra, v)
{
	if(trash_stat[tra] == 2)
	{
		trash_stat[tra] = 3;
		new Float:pos[4];
		GetCoordTrashVehicle(v, pos[0], pos[1], pos[2]);
		GetVehicleZAngle(v, pos[3]);
		new t_time = MoveDynamicObject(trash_object[tra], pos[0], pos[1], pos[2]-0.5, 0.5, 0.0, 0.0, pos[3]);
		around_audio(6800, t_time, 30.0, pos[0], pos[1], pos[2], 0, 0, 6802);
		trash_timer[tra] = SetTimerEx("discharge_timer", t_time, false, "ddd", playerid, tra, v);
	}
	else if(trash_stat[tra] == 3)
	{
		trash_stat[tra] = 4;
		new Float:pos[4];
		GetCoordTrashVehicle(v, pos[0], pos[1], pos[2]);
		GetVehicleZAngle(v, pos[3]);
		VehInfo[v][vJob] = 8, VehInfo[v][vJobStat] = 2;
		VehInfo[v][vProcess] ++;
		if(VehInfo[v][v3dstat] == 6000)
		{
		    new string[28];
			format(string,sizeof(string),"{444444}Мусоровоз [%d/10]", VehInfo[v][vProcess]), UpdateDynamic3DTextLabelText(VehLabel[v],-1,string);
		}
		MoveDynamicObject(trash_object[tra], pos[0], pos[1], pos[2]-0.5, 0.5, 0.0, 0.0, pos[3]);
		for(new t = 0; t < 20; t++)
		{
		    if(gTrash[t][tra] > 0) gTrash[t][tra] = 0, gTrashKol[t][tra] = 0, gTrashType[t][tra] = 0, gTrashPara[t][tra] = 0, gTrashQara[t][tra] = 0, gTrashType[t][tra] = 0, gTrashPack[t][tra] = 0;
		}
		around_audio(12200, 0, 30.0, pos[0], pos[1], pos[2], 0, 0);
		if(PlayerInfo[playerid][pJobHint]) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Заберите мусорный контейнер - Y и поставьте на место","*","");
	}
	return 1;
}
stock get_boottrash(playerid, v)
{
	new mytra = DeiStat[playerid];
	PPP15[playerid] = 8;
	Dei[playerid] = 11;
	VehInfo[v][vNospawn] = 0;
	VehInfo[v][vJob] = 0, VehInfo[v][vJobStat] = 0, VehInfo[v][vJobID] = 0;
	if(mytra <= 199) SetPlayerAttachedObject(playerid, 1, 1332, 1, -0.111999, 1.043999, 0.000000, 1.199998, 87.899963, -1.099990, 0.611000, 0.636000, 0.720999, 0, 0);
	else if(mytra >= 200 && mytra <= 349) SetPlayerAttachedObject(playerid, 1, 1334, 1, -0.115999, 1.143999, 0.000000, 1.199998, 87.899963, -1.099990, 0.611000, 0.636000, 0.682999, 0, 0);
	else if(mytra >= 350 && mytra <= 500) SetPlayerAttachedObject(playerid, 1, 1333, 1, -0.162999, 1.056999, 0.000000, 1.199998, 87.899963, -1.099990, 0.611000, 0.636000, 0.682999, 0, 0);
	ApplyAnimation(playerid,"MISC","bmx_idleloop_02",4.1, true, true, true, true, true);
	trash_stat[mytra] = 0;
	DestroyDynamicObject(trash_object[mytra]);
	CreateGps(playerid, TrashPos[mytra][TrashPos_X], TrashPos[mytra][TrashPos_Y], TrashPos[mytra][TrashPos_Z], 0, 0, 5.0);
	TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
	return 1;
}
stock wash_trashroad(playerid, v)
{
	if(VehInfo[v][vJob] == 9) return ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}*","{FF6347}Вы уже моете дорогу, дождитесь завершения","*","");
	if(GetPVarInt(playerid,"qwesttime") >= 1) return ErrorMessage(playerid, "{FF6347}Сейчас не момент! [Запущен сценарий по таймеру, дождитесь его завершения]");
	new tquan, there;
	for(new tr = 0; tr < MAX_TRASHROAD; tr++)
	{
	    if(trashroad_stat[tr] > 0)
		{
			tquan ++;
			if(IsPlayerInRangeOfPoint(playerid,3.0, TrashRoad[tr][TrashRoad_X], TrashRoad[tr][TrashRoad_Y], TrashRoad[tr][TrashRoad_Z]))
			{
				TogglePlayerControllable(playerid, false);
				around_audio(6800, 3000, 30.0, TrashRoad[tr][TrashRoad_X], TrashRoad[tr][TrashRoad_Y], TrashRoad[tr][TrashRoad_Z], 0, 0, 6802);
				VehInfo[v][vJob] = 9, VehInfo[v][vJobStat] = 1, VehInfo[v][vJobID] = tr;
				SetPVarInt(playerid, "qweststat", 63), SetPVarInt(playerid, "qwesttime", 3);
				if(PlayerInfo[playerid][pJobHint]) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Пожалуйста подождите, Sweeper чистит дорогу от мусора..","*","");
				there ++;
				break;
			}
		}
	}
	if(tquan == 0) return ErrorMessage(playerid, "{FF6347}Все дороги в штате чистые! [Дороги загрязняются со временем]");
	if(there == 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от мусора на дороге [Следуйте к GPS метке]");
	return 1;
}
stock unload_trash(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 	{
		new v = GetPlayerVehicleID(playerid);
		if(VehInfo[v][vModel] != 408) return ErrorMessage(playerid, "{FF6347}Это точка для разгрузки мусоровоза");
		if(GetPVarInt(playerid,"job_stat") != 8) return ErrorMessage(playerid, "{FF6347}Вы не на рабочей смене [ Начать Работу в Будке ]");
		if(VehInfo[v][vProcess] < 10) return ErrorMessage(playerid, "{FF6347}Мусоровоз не заполнен");
		VehInfo[v][vProcess] = 0;
		if(VehInfo[v][v3dstat] == 6000) UpdateDynamic3DTextLabelText(VehLabel[v],-1,"{444444}Мусоровоз [0/10]");
		if(PlayerInfo[playerid][pPlacement] == 0 || PlayerInfo[playerid][pPlacement] == 8)
	    {
			PlayerInfo[playerid][pPlacement] = 8;
			new zp;
			if(ServerInfo[59] <= 0) zp = 400;
			else zp = ServerInfo[59];
			PlayerInfo[playerid][pSalary] += zp;
			PlayerPlaySound(playerid,6401,0,0,0);
			new string[84];
			format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d$~n~~w~JOB: ~g~%d$",zp,PlayerInfo[playerid][pSalary]), GameTextForPlayer(playerid,string,7000,3);
		}
		FindTrash(playerid);
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{00cc00}*","{99ff66}Мусоровоз разгружен\nВы можете продолжить работу или получить зарплату! \n\n{cccccc}[Оплата сохраняется, даже если вы заберёте её потом]","*","");
	
		// Работать мусоровозом
		CompletingDaily(playerid, 19, 1);
	}
	return 1;
}
stock get_trash(playerid)
{
	if(Dei[playerid] == 9 || Dei[playerid] == 11) // Возвращаем Мусорный Бак на Место
	{
		if(TrashBakHand[playerid] == 0) return false;

	    new mytra = DeiStat[playerid], type_trash, quan_trash;
		if(IsPlayerInRangeOfPoint(playerid,2.5, TrashPos[mytra][TrashPos_X], TrashPos[mytra][TrashPos_Y], TrashPos[mytra][TrashPos_Z]) && trash_stat[mytra] == 0)
		{
			if(mytra <= 199) type_trash = 1332;
			else if(mytra >= 200 && mytra <= 349) type_trash = 1334;
			else if(mytra >= 350 && mytra <= 500) type_trash = 1333;
			trash_object[mytra] = CreateDynamicObject(type_trash, TrashPos[mytra][TrashPos_X], TrashPos[mytra][TrashPos_Y], TrashPos[mytra][TrashPos_Z], TrashPos[mytra][TrashPos_RX], TrashPos[mytra][TrashPos_RY], TrashPos[mytra][TrashPos_RZ], 0, 0, -1, 200.00, 200.00);
			Streamer_SetIntData(STREAMER_TYPE_OBJECT, trash_object[mytra], STREAMER_TRASHBOX_OBJECT, mytra);
			SetDynamicObjectNoCameraCol(trash_object[mytra]);
			for(new t = 0; t < 20; t++)
			{
			    if(gTrash[t][mytra] > 0) quan_trash ++;
			}
			TrashBakHand[playerid] = 0; // Игрок вернул мусорный бак
			trash_stat[mytra] = 1;
			trash_player[mytra] = 0;
			name_trash(mytra);
			RemovePlayerAttachedObject(playerid,1), PPP15[playerid] = 0;
			ClearAnim(playerid), ClearAnimations(playerid);
			ApplyAnimation(playerid,"PED","facanger",4.0, false, true, true, true, true, SYNC_ALL);
			Streamer_Update(playerid);
			PlayerPlaySound(playerid,32600,TrashPos[mytra][TrashPos_X], TrashPos[mytra][TrashPos_Y], TrashPos[mytra][TrashPos_Z]);
			TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
			if(Dei[playerid] == 11)
			{
			    if(PlayerInfo[playerid][pPlacement] == 0 || PlayerInfo[playerid][pPlacement] == 8)
			    {
					PlayerInfo[playerid][pPlacement] = 8;
					new zp;
					if(ServerInfo[59] <= 0) zp = 400;
					else zp = ServerInfo[59];
					PlayerInfo[playerid][pSalary] += zp;
					PlayerPlaySound(playerid,6401,0,0,0);
					new string[84];
					format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d$~n~~w~JOB: ~g~%d$",zp,PlayerInfo[playerid][pSalary]), GameTextForPlayer(playerid,string,7000,3);
				}
				trash_none[mytra] = gettime()+600;
			}
			Dei[playerid] = 0, DeiStat[playerid] = 0;
		}
 	}
	else
	{
		for(new tra = 0; tra < 500; tra++)
		{
			if(IsPlayerInRangeOfPoint(playerid,2.5, TrashPos[tra][TrashPos_X], TrashPos[tra][TrashPos_Y], TrashPos[tra][TrashPos_Z]))
			{
				if(GetPVarInt(playerid,"job_stat") != 8) return ErrorMessage(playerid, "{FF6347}Вы не работаете в Городской Клининговой Службе [ /job ]");
				if(Dei[playerid] >= 1 && Dei[playerid] != 11 || Hand[playerid] >= 1 || Hold[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
				if(trash_stat[tra] == 0) return ErrorMessage(playerid, "{FF6347}У вас в руках нет мусорного бака");
				else if(trash_stat[tra] == 1)
				{
				    new quan_trash;
					for(new t = 0; t < 20; t++)
					{
					    if(gTrash[t][tra] > 0) quan_trash ++;
					}
					if(quan_trash == 0) return ErrorMessage(playerid, "{FF6347}Этот мусорный бак пустой");
					TrashBakHand[playerid] = tra + 1; // Игрок упёр мусорный бак
					PPP15[playerid] = 8;
					Dei[playerid] = 9;
					DeiStat[playerid] = tra;
					PlayerPlaySound(playerid,32600,TrashPos[tra][TrashPos_X], TrashPos[tra][TrashPos_Y], TrashPos[tra][TrashPos_Z]);
					if(tra <= 199) SetPlayerAttachedObject(playerid, 1, 1332, 1, -0.111999, 1.043999, 0.000000, 1.199998, 87.899963, -1.099990, 0.611000, 0.636000, 0.720999, 0, 0);
					else if(tra >= 200 && tra <= 349) SetPlayerAttachedObject(playerid, 1, 1334, 1, -0.115999, 1.143999, 0.000000, 1.199998, 87.899963, -1.099990, 0.611000, 0.636000, 0.682999, 0, 0);
					else if(tra >= 350 && tra <= 500) SetPlayerAttachedObject(playerid, 1, 1333, 1, -0.162999, 1.056999, 0.000000, 1.199998, 87.899963, -1.099990, 0.611000, 0.636000, 0.682999, 0, 0);
					ApplyAnimation(playerid,"MISC","bmx_idleloop_02",4.1, true, true, true, true, true);
					trash_stat[tra] = 0;
					trash_player[tra] = playerid;
					DestroyDynamicObject(trash_object[tra]);
					name_trash(tra);
					if(PlayerInfo[playerid][pJobHint]) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Подойдите к мусоровозу сзади и нажмите Y, чтобы погрузить мусор","*","");
					TextDrawShowForPlayer(playerid, MindDraw[3]), PlayerTextDrawSetString(playerid, HintButton, "Y"), PlayerTextDrawShow(playerid, HintButton);
					foreach(Player,i)
					{
						if(OnlineInfo[i][oLogged] == 1 && OnlineInfo[i][oShowInterface] == 1 && OnlineInfo[i][oShowTabs] == tra && Tabs_Load[i] == 8) ErrorMessage(i, "{FF6347}Кто-то забрал мусорный бак"), closetab(i, 1);
					}
				}
				break;
			}
		}
	}
	return 1;
}
function LoadPromo()
{
	new time = GetTickCount(), unix = gettime();
	new rows;
	cache_get_row_count(rows);
	for(new f; f < min(rows, MAX_PROMO); ++f)
	{
		cache_get_value_name_int(f, "newid", PromoInfo[f][roNewid]);
		cache_get_value_name(f, "name", PromoInfo[f][roName], 64);
		cache_get_value_name_int(f, "activ", PromoInfo[f][roActiv]);
		cache_get_value_name_int(f, "unixcreate", PromoInfo[f][roUnixcreate]);
		cache_get_value_name_int(f, "unixbegin", PromoInfo[f][roUnixbegin]);
		cache_get_value_name_int(f, "unixend", PromoInfo[f][roUnixend]);
		cache_get_value_name_int(f, "unixstart", PromoInfo[f][roUnixstart]);
		cache_get_value_name_int(f, "level", PromoInfo[f][roLevel]);
		cache_get_value_name_int(f, "roinsert", PromoInfo[f][roInsert]);
		cache_get_value_name_int(f, "par0", PromoInfo[f][roPar][0]);
		cache_get_value_name_int(f, "par1", PromoInfo[f][roPar][1]);
		cache_get_value_name_int(f, "par2", PromoInfo[f][roPar][2]);
		cache_get_value_name_int(f, "par3", PromoInfo[f][roPar][3]);
		cache_get_value_name_int(f, "par4", PromoInfo[f][roPar][4]);
		cache_get_value_name_int(f, "stat0", PromoInfo[f][roStat][0]);
		cache_get_value_name_int(f, "stat1", PromoInfo[f][roStat][1]);
		cache_get_value_name_int(f, "stat2", PromoInfo[f][roStat][2]);
		cache_get_value_name_int(f, "stat3", PromoInfo[f][roStat][3]);
		cache_get_value_name_int(f, "stat4", PromoInfo[f][roStat][4]);
		cache_get_value_name_int(f, "number", PromoInfo[f][roNumber]);
		cache_get_value_name(f, "text", PromoInfo[f][roText], 84);
		cache_get_value_name_int(f, "voice", PromoInfo[f][roVoice]);
		
		PromoInfo[f][roID] = f;
		if(unix > PromoInfo[f][roUnixend]) PromoInfo[f][roActiv] = 0;
	}
	PromoNumber = rows;

	printf("[MODE]: Промокоды [%d Quan][%d ms]", rows, GetTickCount() - time);
	return 1;
}
