    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, reason,28,kolv);
      	return 1;
 	}
	return 1;
}
CMD:reproof(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 10)
	{
		new tmp[144], result[144], giveplayerid, string[144];
		if(sscanf(params, "s[144]s[144]", tmp, result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать предупреждение Reproof [ /reproof ID Причина ]");
		if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
		if(strlen(result) > 60) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинная причина [ Лимит 60 символов ]");
		giveplayerid = ReturnUser(tmp, 1);
		if(IsOnline(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pLeader] >= 1 && PlayerInfo[giveplayerid][pSoska] == 0)
			{
				if(admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER) || admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_ADMIN))
				{
					PlayerInfo[giveplayerid][pReproof] ++;
					format(string, sizeof(string), " [ ADM ]: %s предупредил лидера %s (Reproof). Причина: %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName], result);
			 		ABroadCast(COLOR_ADM,string,1);
			 		format(string, sizeof(string), "Вы предупредили лидера %s, причина: %s", PlayerInfo[giveplayerid][pName], result);
					SendClientMessage(playerid, COLOR_LIGHTRED, string);
					format(string, sizeof(string), "Вас предупредил администратор %s, причина: %s", PlayerInfo[playerid][pName], result);
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
      				AdminLog("reproof", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pReproof], result);
					if(PlayerInfo[giveplayerid][pReproof] >= 3)
					{
						PlayerInfo[giveplayerid][pReproof] = 0;
						format(string, sizeof(string), "%d %s", giveplayerid, result);
			            pc_cmd_leadvig(playerid, string);
			            return 1;
					}
					format(string, sizeof(string),"{FFcc00}[!!!] Вас предупредил администратор: %s. Причина: %s", PlayerInfo[playerid][pName], result);
      				ShowDialog(giveplayerid, 2018, 0, "{FF0000}**** {ffcc66}Предупреждение! {FF0000}****", string, "Ок", "");
					mysql_save(giveplayerid, 9);
				}
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу предупредить лидера [ Только ответственные администраторы ]");
			}
			else if(PlayerInfo[giveplayerid][pSoska] >= 1)
			{
					if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу предупредить администратора");
					if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу предупредить себя");
					if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу предупредить администратора своего уровня или выше");
					PlayerInfo[giveplayerid][pReproof] ++;
					format(string, sizeof(string), " [ ADM ]: %s предупредил %s (Reproof). Причина: %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName], result);
			 		ABroadCast(COLOR_ADM,string,1);
			 		format(string, sizeof(string), "Вы предупредили администратора %s, причина: %s", PlayerInfo[giveplayerid][pName], result);
					SendClientMessage(playerid, COLOR_LIGHTRED, string);
					format(string, sizeof(string), "Вас предупредил администратор %s, причина: %s", PlayerInfo[playerid][pName], result);
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
					AdminLog("reproof", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pReproof], result);
					if(PlayerInfo[giveplayerid][pReproof] >= 3)
					{
						PlayerInfo[giveplayerid][pReproof] = 0;
						format(string, sizeof(string), "%d %s", giveplayerid, result);
			            pc_cmd_admwarn(playerid, string);
					}
					mysql_save(giveplayerid, 10);
			}
		}
		else
	 	{
	  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, result,29,0);
	      	return 1;
	 	}
 	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не могу это сделать");
	return 1;
}
CMD:unreproof(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 10)
	{
		new tmp[144], giveplayerid, string[144];
		if(sscanf(params, "s[144]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять предупреждение Reproof [ /unreproof ID ]");
		if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
		giveplayerid = ReturnUser(tmp, 1);
		if(IsOnline(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pLeader] >= 1 && PlayerInfo[giveplayerid][pSoska] == 0) // Лидер
			{
				if(admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER) || admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_ADMIN))
				{
					if(PlayerInfo[giveplayerid][pReproof] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У лидера нет предупреждений Reproof");
					PlayerInfo[giveplayerid][pReproof] -=1;
					format(string, sizeof(string), " [ ADM ]: %s снял предупреждение с лидера %s (Reproof)", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName]);
			 		ABroadCast(COLOR_ADM,string,1);
			 		format(string, sizeof(string), "Вы сняли предупреждение с лидера %s", PlayerInfo[giveplayerid][pName]);
					SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
					format(string, sizeof(string), "%s снял с вас предупреждение", PlayerInfo[playerid][pName]);
					SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
					mysql_save(giveplayerid, 9);
					AdminLog("unreproof", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pReproof], "");
				}
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снять предупреждение [ Только ответственные администраторы ]");
			}
			else if(PlayerInfo[giveplayerid][pSoska] >= 1)
			{
				if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снимать предупреждения с администратора");
				if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снять предупреждения с себя");
				if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снять предупреждение с администратора своего уровня или выше");
				if(PlayerInfo[giveplayerid][pReproof] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У администратора нет предупреждений Reproof");
				PlayerInfo[giveplayerid][pReproof] -=1;
				format(string, sizeof(string), " [ ADM ]: %s снял предупреждение с %s (Reproof)", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName]);
		 		ABroadCast(COLOR_ADM,string,1);
		 		format(string, sizeof(string), "Вы сняли предупреждение с %s", PlayerInfo[giveplayerid][pName]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
				format(string, sizeof(string), "%s снял с вас предупреждение", PlayerInfo[playerid][pName]);
				SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
				mysql_save(giveplayerid, 10);
				AdminLog("unreproof", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pReproof], "");
			}
		}
		else
	 	{
	  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,30,0);
	      	return 1;
	 	}
 	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не могу это сделать");
	return 1;
}
alias:admwarn("awarn")
CMD:admwarn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не могу это сделать");
    new giveplayerid,tmp[24],result[64],string[180];
	if(sscanf(params, "s[24]s[64]", tmp,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать ADM Warn [ /admwarn ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
 	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
		if(PlayerInfo[giveplayerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это вообще не администратор");
		if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать ADM Warn администратору своего уровня или выше");
		PlayerInfo[giveplayerid][pAdmWarns] += 1;
		format(string, sizeof(string), " [ ADM ]: %s получает ADM-warn от администратора %s", PlayerInfo[giveplayerid][pName], PlayerInfo[playerid][pName]);
 		ABroadCast(COLOR_ADM,string,1);
		format(string, sizeof(string), "Вы выдали ADM-WARN администратору %s, причина: %s", PlayerInfo[giveplayerid][pName], result);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы получили ADM-WARN от Главного Администратора %s, причина: %s", PlayerInfo[playerid][pName], result);
		SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
  		AdminLog("admwarn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pAdmWarns], result);
  		if(PlayerInfo[giveplayerid][pAdmWarns] == 3)
		{
			SendClientMessage(giveplayerid,COLOR_LIGHTRED, "Вы были понижены в должности, Причина: 3 ADM Warn");
			PlayerInfo[giveplayerid][pSoska] --;
			format(string, sizeof(string), "%s понижен в должности Администратора, Причина: {ff0000}3 ADM Warn", PlayerInfo[giveplayerid][pName]);
			SendClientMessage(playerid, COLOR_LIGHTRED, string);
			AdminLog("makeadmin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pSoska], "Понижен: 3 ADM Warn");
		}
		else if(PlayerInfo[giveplayerid][pAdmWarns] >= 6)
		{
			SendClientMessage(giveplayerid,COLOR_LIGHTRED, "Вы были сняты с должности Администратора, так как получили 6-ой ADM Warn");
			PlayerInfo[giveplayerid][pSoska] = 0;
			// sampvoice
			//CreateVoice(giveplayerid, 228, 1);
			format(string, sizeof(string), "%s снят с должности Администратора, Причина: {ff0000}6 ADM Warns", PlayerInfo[giveplayerid][pName]);
			SendClientMessage(playerid, COLOR_LIGHTRED, string);

			MakeadminPlayerBridge(PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pSoska]);

			AdminLog("makeadmin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "Снят: 6 ADM Warn");
		}
		mysql_save(giveplayerid, 10);
	}
	else
 	{
  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, result,3,0);
      	return 1;
 	}
	return 1;
}
CMD:unadmwarn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не могу это сделать");
    new giveplayerid,tmp[24],result[64],string[180];
	if(sscanf(params, "s[24]s[64]", tmp,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять ADM Warn [ /unadmwarn ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
 	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
		if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снять с самого себя ADM Warn");
		if(PlayerInfo[giveplayerid][pAdmWarns] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет ADM Warn");
		if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снять ADM Warn с администратора своего уровня или выше");
		PlayerInfo[giveplayerid][pAdmWarns] -= 1;
		format(string, sizeof(string), "Вы сняли ADM-WARN с администратора %s, причина: %s", PlayerInfo[giveplayerid][pName], result);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string), " [ ADM ]: Админ %s снимает ADM-warn с администратора %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		format(string, sizeof(string), "Главный Администратор %s снял с вас ADM WARN, причина: %s", PlayerInfo[playerid][pName], result);
		SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
		AdminLog("unadmwarn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pAdmWarns], result);
		mysql_save(giveplayerid, 30);
	}
	else
 	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, result,4,0);
		return 1;
	}
	return 1;
}
forward Call_warn(playerid, str_name[], reason[]);
public Call_warn(playerid, str_name[], reason[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid,datad1,datad2,f_str[256],string[244];
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Warns", datad1);
		cache_get_value_name_int(0, "Soska", datad2);
		if(datad2 >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу дать warn главному админу");
		GivePlayerWarn(datadid, .offline = true);
		datad1++;
		if(datad1 >= MAX_WARNS) // Если у игрока превысилось количество варнов
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Warns` = '0' WHERE `Name` = '%e'",str_name);
			query_empty(pearsq, f_str);
			mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Banned, BanDayz, BanMonzz, ConnectTime, BanAdmin, BanData, BanResult FROM \
				`pp_igroki` WHERE `Name` = '%e'", str_name);
			mysql_tquery(pearsq, string, "Call_offban", "dsds", playerid, str_name, WARNS_BAN_TIME, reason);
			return 1;
		}
		format(string, sizeof(string), "[PP]: %s предупредил%s игрока %s, причина: %s", PlayerInfo[playerid][pName], gender(playerid), str_name,reason);
		AllMessage(COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы предупредили %s, причина: %s", str_name, reason);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Игрок находился Offline. Аккаунт сохранён");
		SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
		AddWrong(playerid, 1, str_name,1);
		AdminLog("warn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", datad1+1, reason);
		work_admin(playerid, 17);
		update_admpoint(playerid, ServerInfo[15]);
		format(string, sizeof(string), "Вам выдан Warn. Причина: %s",reason);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
forward Call_gunwarn(playerid, str_name[], reason[]);
public Call_gunwarn(playerid, str_name[], reason[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid,datad1,datad2,warns,f_str[256],string[244];
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "GunWarns", datad1);
		cache_get_value_name_int(0, "Warns", warns);
		cache_get_value_name_int(0, "Soska", datad2);
		if(datad2 >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу дать gunwarn главному админу");
		GivePlayerGunWarn(datadid, .offline = true);
		datad1++;
		if(datad1 >= MAX_GUN_WARNS) // Если у игрока превысилось количество ганварнов
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `GunWarns` = '0', `GunWarnsZZTime` = '0' WHERE `Name` = '%e'",str_name);
			query_empty(pearsq, f_str);

			mysql_format(pearsq, f_str,sizeof(f_str),"SELECT user_id, Warns, Soska FROM `pp_igroki` WHERE `Name` = '%e'", str_name);
      		mysql_tquery(pearsq, f_str, "Call_warn", "dss", playerid, str_name, reason);
			
			warns++;
			if (warns >= MAX_WARNS)
			{
				mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Banned, BanDayz, BanMonzz, ConnectTime, BanAdmin, BanData, BanResult FROM \
				`pp_igroki` WHERE `Name` = '%e'", str_name);
				mysql_tquery(pearsq, string, "Call_offban", "dsds", playerid, str_name, WARNS_BAN_TIME, reason);
			}
			return 1;
		}
		format(string, sizeof(string), "[PP]: %s предупредил%s игрока %s (GunWarn), причина: %s", PlayerInfo[playerid][pName], gender(playerid), str_name,reason);
		AllMessage(COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы предупредили %s (GunWarn), причина: %s", str_name, reason);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Игрок находился Offline. Аккаунт сохранён");
		SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
		AddWrong(playerid, 4, str_name,1);
		AdminLog("gunwarn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", datad1+1, reason);
		work_admin(playerid, 18);
		update_admpoint(playerid, ServerInfo[69]);
		format(string, sizeof(string), "Вам выдан GunWarn. Причина: %s",reason);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}

stock CalculateGunWarnsZZTime(warns)
{
	switch (warns)
	{
		case 1: return (60 * 60 * 24 * 2);
		case 2: return (60 * 60 * 24 * 7);
		case 3: return (60 * 60 * 24 * 14);
		default: {}
	}
	return 0;
}

stock CalculateWarnClearTime(warns)
{
	switch (warns)
	{
		case 1: return (60 * 60 * 24 * 10); // 10 дней
		case 2: return (60 * 60 * 24 * 15); // 15 дней
		case 3: return (60 * 60 * 24 * 30); // 30 дней
		default: {}
	}
	return 0;
}

function Call_OfflineTakePlayerWarn(user_id)
{
	new rows;
	cache_get_row_count(rows);
	if (rows == 0) return 0;

	new warns;
	cache_get_value_name_int(0, "Warns", warns);

	warns--;
	if (warns < 0) warns = 0;

	new clear_time = gettime() + CalculateWarnClearTime(warns);

	new f_str[144];
	mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Warns` = %d, `WarnClearTime` = %d WHERE `user_id` = %d", warns, clear_time, user_id);
	query_empty(pearsq, f_str);

	return 1;
}

function Call_OfflineGivePlayerGunWarn(user_id)
{
	new rows;
	cache_get_row_count(rows);
	if (rows == 0) return 0;

	new gunwarns, current_zztime;
	cache_get_value_name_int(0, "GunWarns", gunwarns);
	cache_get_value_name_int(0, "GunWarnsZZTime", current_zztime);

	gunwarns++;
	if (gunwarns >= MAX_GUN_WARNS) {
		gunwarns = 0;
	}

	new unix = gettime();
	new zztime = CalculateGunWarnsZZTime(gunwarns);
	if (unix + zztime < current_zztime)
	{
		current_zztime += zztime;
	}
	else
	{
		current_zztime = unix + zztime;
	}

	new f_str[144];
	mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `GunWarns` = '%d', `GunWarnsZZTime` = '%d' WHERE `user_id` = %d", gunwarns, current_zztime, user_id);
	query_empty(pearsq, f_str);

	return 1;
}

function Call_OfflineGivePlayerWarn(user_id)
{
	new rows;
	cache_get_row_count(rows);
	if (rows == 0) return 0;

	new warns, name[MAX_PLAYER_NAME + 1];
	cache_get_value_name_int(0, "Warns", warns);
	cache_get_value_name(0, "Name", name);

	warns++;
	
	new clear_time = gettime() + CalculateWarnClearTime(warns);
	if (warns >= MAX_WARNS)
	{
		warns = 0;
		clear_time = 0;
	}

	mysql_tquery(pearsq, "START TRANSACTION;");

	new f_str[144];
	mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Warns` = '%d', `WarnClearTime` = '%d' WHERE `user_id` = %d", warns, clear_time, user_id);
	query_empty(pearsq, f_str);

	if (warns >= 2)
	{
		new leader, rank, soska, expert;
		cache_get_value_name_int(0, "Leader", leader);
		cache_get_value_name_int(0, "Rank", rank);
		cache_get_value_name_int(0, "Soska", soska);
		cache_get_value_name_int(0, "Expert", expert);

		if (leader > 0)
		{
			UnmakeleaderPlayerBridge(user_id, leader, rank);
			mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Member` = `Leader`, `Leader` = 0, `Rank` = `Rank` - 1 WHERE `user_id` = %d", user_id);
			query_empty(pearsq, f_str);
 
			format(f_str, sizeof(f_str), "[ ADM ]: %s отстранен с должности лидера [2+ Warns]", name);
			ABroadCast(COLOR_ADM, f_str, 2);

			AdminLog("makeleader", user_id, name, "", 0, "", "", 0, "Снят Offline: 2+ Warns");
		}

		if (soska == 1)
		{
			MakeadminPlayerBridge(user_id, 0);
			mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Soska` = 0 WHERE `user_id` = %d", user_id);
			query_empty(pearsq, f_str);

			format(f_str, sizeof(f_str), "[ ADM ]: %s отстранен с должности хелпера [2+ Warns]", name);
			ABroadCast(COLOR_ADM, f_str, 2);

			AdminLog("makeadmin", user_id, name, "", 0, "", "", 0, "Снят Offline: 2+ Warns");
		}

		if (expert >= 1)
		{
			mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Expert` = 0 WHERE `user_id` = %d", user_id);
			query_empty(pearsq, f_str);

			format(f_str, sizeof(f_str), "[ ADM ]: %s отстранен с должности эксперта [2+ Warns]", name);
			ABroadCast(COLOR_ADM, f_str, 2);

			AdminLog("makeexpert", user_id, name, "", 0, "", "", 0, "Снят Offline: 2+ Warns");
		}

		mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Member` = 0, `Rank` = 0 WHERE `user_id` = %d AND `Member` > 0", user_id);
		query_empty(pearsq, f_str);
	}

	mysql_tquery(pearsq, "COMMIT;");

	return 1;
}

stock GivePlayerWarn(playerid, bool: offline = false)
{
	if (offline)
	{
		new f_str[128];
		mysql_format(pearsq, f_str, sizeof(f_str), "SELECT Warns, Soska, Expert, Leader, Rank, Name FROM pp_igroki WHERE user_id = %d LIMIT 1", playerid);
		mysql_tquery(pearsq, f_str, "Call_OfflineGivePlayerWarn", "d", playerid);
		return 1;
	}

	PlayerInfo[playerid][pWarns]++;
	PlayerInfo[playerid][pWarnClearTime] = gettime() + CalculateWarnClearTime(PlayerInfo[playerid][pWarns]);

	if (PlayerInfo[playerid][pWarns] < MAX_WARNS)
	{
		mysql_save(playerid, 20);
	}

	if (PlayerInfo[playerid][pWarns] >= 2)
	{
		new a_str[128];

		if (PlayerInfo[playerid][pLeader] > 0)
		{
			UnmakeleaderPlayerBridge(PlayerInfo[playerid][pID], PlayerInfo[playerid][pLeader], PlayerInfo[playerid][pRank]);
			
			PlayerInfo[playerid][pMember] = PlayerInfo[playerid][pLeader];
			PlayerInfo[playerid][pLeader] = 0;
			PlayerInfo[playerid][pRank]--;
			mysql_save(playerid, 9);
			SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Server ]: {ff9000}%s отстранен с должности лидера: 2+ Warns", PlayerInfo[playerid][pName]);

			format(a_str, sizeof(a_str), "[ ADM ]: %s[%d] отстранен с должности лидера [2+ Warns]", PlayerInfo[playerid][pName], playerid);
			ABroadCast(COLOR_ADM, a_str, 2);

			AdminLog("makeleader", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Снят: 2+ Warns");
		}

		if (PlayerInfo[playerid][pSoska] == 1)
		{
			MakeadminPlayerBridge(PlayerInfo[playerid][pID], 0);

			PlayerInfo[playerid][pSoska] = 0;
			mysql_save(playerid, 10);
			SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Server ]: {ff9000}%s отстранен с должности хелпера: 2+ Warns", PlayerInfo[playerid][pName]);
		
			format(a_str, sizeof(a_str), "[ ADM ]: %s[%d] отстранен с должности хелпера [2+ Warns]", PlayerInfo[playerid][pName], playerid);
			ABroadCast(COLOR_ADM, a_str, 2);

			AdminLog("makeadmin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Снят: 2+ Warns");
		}

		if (PlayerInfo[playerid][pExpert] >= 1)
		{
			PlayerInfo[playerid][pExpert] = 0;
			mysql_save(playerid, 16);
			SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Server ]: {ff9000}%s отстранен с должности эксперта: 2+ Warns", PlayerInfo[playerid][pName]);

			format(a_str, sizeof(a_str), "[ ADM ]: %s[%d] отстранен с должности эксперта [2+ Warns]", PlayerInfo[playerid][pName], playerid);
			ABroadCast(COLOR_ADM, a_str, 2);

			AdminLog("makeexpert", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Снят: 2+ Warns");
		}
		
		if (PlayerInfo[playerid][pMember] > 0)
		{
			Uninvite(playerid, 0);
		}
	}

	return 1;
}

stock TakePlayerWarn(playerid, bool: offline = false)
{
	if (offline)
	{
		new f_str[128];
      	mysql_format(pearsq, f_str, sizeof(f_str), "SELECT Warns FROM `pp_igroki` WHERE `user_id` = %d", playerid);
		mysql_tquery(pearsq, f_str, "Call_OfflineTakePlayerWarn", "d", playerid);
		return 1;
	}

	PlayerInfo[playerid][pWarns]--;
	new clear_time = CalculateWarnClearTime(PlayerInfo[playerid][pWarns]);

	new unix = gettime();
	// Если варн должен быть снят достаточно давно
	if (abs(unix - PlayerInfo[playerid][pWarnClearTime]) >= clear_time) {
		// Отсчет от последнего запланированного снятия варна
		PlayerInfo[playerid][pWarnClearTime] += clear_time;
	} else {
		// Отсчет от этого снятия варна
		PlayerInfo[playerid][pWarnClearTime] = unix + clear_time;
	}

	mysql_save(playerid, 20);

	return 1;
}

stock GivePlayerGunWarn(playerid, bool: offline = false)
{
	if (offline)
	{
		new f_str[128];
		mysql_format(pearsq, f_str, sizeof(f_str), "SELECT GunWarns, GunWarnsZZTime FROM pp_igroki WHERE user_id = %d LIMIT 1", playerid);
		mysql_tquery(pearsq, f_str, "Call_OfflineGivePlayerGunWarn", "d", playerid);
		return 1;
	}

	PlayerInfo[playerid][pGunWarns]++;

	new unix = gettime();
	new zztime = CalculateGunWarnsZZTime(PlayerInfo[playerid][pGunWarns]);
	if (unix + zztime < PlayerInfo[playerid][pGunWarnsZZTime])
	{
		PlayerInfo[playerid][pGunWarnsZZTime] += zztime;
	}
	else
	{
		PlayerInfo[playerid][pGunWarnsZZTime] = unix + zztime;
	}
	GunWarnTakeWeapon(playerid, true);

	if (PlayerInfo[playerid][pGunWarns] < MAX_GUN_WARNS)
	{
		mysql_save(playerid, 21);
	}

	return 1;
}

stock TakePlayerGunWarn(playerid, bool: offline = false)
{
	if (offline)
	{
		new f_str[128];
      	mysql_format(pearsq, f_str, sizeof(f_str),
			"UPDATE `pp_igroki` SET `GunWarns` = GREATEST(`GunWarns` - 1, 0), `GunWarnsZZTime` = 0 WHERE `user_id` = %d",
			playerid
		);
		query_empty(pearsq, f_str);
		return 1;
	}

	PlayerInfo[playerid][pGunWarns] = max(PlayerInfo[playerid][pGunWarns] - 1, 0);
	PlayerInfo[playerid][pGunWarnsZZTime] = 0;
	GunWarnTakeWeapon(playerid, false);
	mysql_save(playerid, 21);

	return 1;
}

CMD:gunwarn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new giveplayerid,tmp[24],result[64];
	if(sscanf(params, "s[24]s[64]", tmp,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать GunWarn игроку [ /gunwarn ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
    giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		if(IsARealNPC(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Это NPC");
		if(OnlineInfo[giveplayerid][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок не залогинился");
		
		if (server == 0 && playerid == giveplayerid) {}
		else if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return ErrorMessage(playerid, "{FF6347}Нельзя выдать gunwarn администратору вашего уровня или выше");

		// Антипидор
		if(AntiPidor(playerid, 6)) return 1;
		GivePlayerGunWarn(giveplayerid);

		new string[500];
		if(PlayerInfo[giveplayerid][pGunWarns] >= MAX_GUN_WARNS) {
			PlayerInfo[giveplayerid][pGunWarns] = 0;
			mysql_save(giveplayerid, 21);
			
			pc_cmd_warn(playerid, params);
			return 1;
		}
		format(string, sizeof(string), "[PP]: %s предупредил%s игрока %s (GunWarn), причина: %s", PlayerInfo[playerid][pName], gender(playerid), PlayerInfo[giveplayerid][pName], result);
		AllMessage(COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы предупредили %s (GunWarn), причина: %s", PlayerInfo[giveplayerid][pName], result);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы были предупреждены %s (GunWarn), причина: %s", PlayerInfo[playerid][pName], result);
		SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string),
			"{FF0000}Вы получили предупреждение(GUNWARN) от %s\n" \
			"{0088ff}Причина: {FF0000}%s\n" \
			"{FFffff}%d GunWarns = 1 WARN\n" \
			"{ffffff}Снимите GunWarn, чтобы избежать этого: {0088ff}/donate\n\n" \
			\
			"{ff6347}* {cccccc}1-й GunWarn не даёт вам пользоваться оружием в течение 2 дней\n" \
			"{ff6347}* {cccccc}2-й GunWarn не даёт вам пользоваться оружием в течение 7 дней\n" \
			"{ff6347}* {cccccc}3-й GunWarn не даёт вам пользоваться оружием в течение 14 дней\n",
			
			PlayerInfo[playerid][pName],
			result,
			MAX_GUN_WARNS
		);
		ShowDialog(giveplayerid,1700, 0, "******* {FF0000}*Вы Получили Предупреждение* {FFFFFF}*******", string, "Ок", "");
        SendClientMessage(playerid, COLOR_LIGHTRED, "{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
  		gMysqlSaveCheck[playerid] = 1;
  		GF_OnPlayerUpdate(giveplayerid);
  		AddWrong(playerid, 4, PlayerInfo[giveplayerid][pName], 1);
		AdminLog("gunwarn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pWarns], result);
		work_admin(playerid, 18);
		SendClientMessage(giveplayerid, COLOR_GREY, "{0088ff}[ Server ]: {ff9000}%d GunWarns = 1 WARN. {cccccc}Вы можете снять свой GunWarn {ffcc00}[ /donate ]", MAX_GUN_WARNS);
		update_admpoint(playerid, ServerInfo[69]);
		return 1;
	}
	else
	{
      if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	  new string_mysql[200];
	  mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id, GunWarns, Warns, Soska FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
      mysql_tquery(pearsq, string_mysql, "Call_gunwarn", "dss", playerid, tmp,result);
	}
	return 1;
}

CMD:warn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new giveplayerid,tmp[24],result[64];
	if(sscanf(params, "s[24]s[64]", tmp,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать Warn игроку [ /warn ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
    giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		if(IsARealNPC(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Это NPC");
		if(OnlineInfo[giveplayerid][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок не залогинился");
		
		if (server == 0 && playerid == giveplayerid) {}
		else if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return ErrorMessage(playerid, "{FF6347}Нельзя выдать warn администратору вашего уровня или выше");

		// Антипидор
		if(AntiPidor(playerid, 6)) return 1;
		GivePlayerWarn(giveplayerid);

		new string[500];
		if(PlayerInfo[giveplayerid][pWarns] >= MAX_WARNS) return PlayerInfo[giveplayerid][pWarns] = 0, PlayerInfo[giveplayerid][pWarnClearTime] = 0, BanPlayer(playerid, giveplayerid, WARNS_BAN_TIME, result);
		format(string, sizeof(string), "[PP]: %s предупредил%s игрока %s, причина: %s", PlayerInfo[playerid][pName], gender(playerid), PlayerInfo[giveplayerid][pName], result);
		AllMessage(COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы предупредили %s, причина: %s", PlayerInfo[giveplayerid][pName], result);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string), "Вы были предупреждены %s, причина: %s", PlayerInfo[playerid][pName], result);
		SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string),
			"{FF0000}Вы получили предупреждение(WARN) от %s\n" \
			"{0088ff}Причина: {FF0000}%s\n" \
			"{FFffff}%d Warns = Бан аккаунта на %d дней\n\n" \
			\
			"{ff6347}* {cccccc}1 Warn снимается самостоятельно через %d дней\n" \
			"{ff6347}* {cccccc}2 Warn снимается самостоятельно через %d дней\n" \
			"{ff6347}* {cccccc}3 Warn снимается самостоятельно через %d дней\n",
			
			PlayerInfo[playerid][pName],
			result,
			MAX_WARNS, WARNS_BAN_TIME,
			CalculateWarnClearTime(1)/24/60/60,
			CalculateWarnClearTime(2)/24/60/60,
			CalculateWarnClearTime(3)/24/60/60
		);
		ShowDialog(giveplayerid,1700, 0, "******* {FF0000}*Вы Получили Предупреждение* {FFFFFF}*******", string, "Ок", "");
        SendClientMessage(playerid, COLOR_LIGHTRED, "{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
  		gMysqlSaveCheck[playerid] = 1;
  		GF_OnPlayerUpdate(giveplayerid);
  		AddWrong(playerid, 1, PlayerInfo[giveplayerid][pName],1);
		AdminLog("warn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pWarns], result);
		work_admin(playerid, 17);
		SendClientMessage(giveplayerid, COLOR_GREY, "{0088ff}[ Server ]: {ff9000}%d Предупреждений = BAN Аккаунта.", MAX_WARNS);
		update_admpoint(playerid, ServerInfo[15]);
		return 1;
	}
	else
	{
      if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	  new string_mysql[200];
	  mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id, Warns, Soska FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
      mysql_tquery(pearsq, string_mysql, "Call_warn", "dss", playerid, tmp,result);
	}
	return 1;
}
forward Call_ungunwarn(playerid, str_name[], reason[]);
public Call_ungunwarn(playerid, str_name[], reason[])
{
	new rows, datad1;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid, string[144];
		cache_get_value_name_int(0, "GunWarns", datad1);
		cache_get_value_name_int(0, "user_id", datadid);
		if(datad1 <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет GunWarns");
		TakePlayerGunWarn(datadid, .offline = true);
		format(string, sizeof(string), "[ ADM ]: %s снимает один GUNWARN с игрока %s, причина: %s", PlayerInfo[playerid][pName],str_name,reason);
		ABroadCast(COLOR_YELLOW,string,1);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Игрок находился Offline. Аккаунт сохранён");
		AdminLog("ungunwarn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, reason);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:ungunwarn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 6) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new tmp[121], result[121];
	if(sscanf(params, "s[121]s[121]",tmp,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять GunWarn [ /ungunwarn ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	if(strlen(result) > 60) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинная причина [ Лимит 60 символов ]");
	new giveplayerid, string[144];
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
 	{
		if(PlayerInfo[giveplayerid][pGunWarns] <= 0 && PlayerInfo[giveplayerid][pGunWarnsZZTime] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет GunWarns");
		TakePlayerGunWarn(giveplayerid);
		format(string, sizeof(string), "Вы сняли предупреждение с %s (GunWarn), причина: %s", PlayerInfo[giveplayerid][pName], result);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string), "[ ADM ]: %s снимает один GUNWARN с игрока %s, причина: %s", PlayerInfo[playerid][pName],PlayerInfo[giveplayerid][pName], result);
		ABroadCast(COLOR_ADM,string,1);
		format(string, sizeof(string), "Вам снял(а) одно предупреждение (GunWarn) администратор %s, причина: %s", PlayerInfo[playerid][pName], result);
		SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string),"{0088ff}Вам снял(а) одно предупреждение(GUNWARN) администратор %s\n{0088ff}Причина: {FF0000}%s", PlayerInfo[playerid][pName],result);
		ShowDialog(giveplayerid,1700, 0, "******* {0088ff}*Вам сняли Предупреждение* {FFFFFF}*******", string, "Ок", "");
		AdminLog("ungunwarn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, result);
  		return 1;
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, GunWarns FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_ungunwarn", "dss", playerid, tmp, result);
	}
	return 1;
}

