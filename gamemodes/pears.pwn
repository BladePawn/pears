CMD:kamera(playerid, const params[])
{
	if(PlayerInfo[playerid][pLeader] == 9 || PlayerInfo[playerid][pMember] == 9 && PlayerInfo[playerid][pRank] >= 2)
	{
		  if(cnnkam == playerid)
		  {
		  			if(CnnVed[playerid] == 0)
		  			{
		  				CnnVed[playerid] = 2;
						ApplyAnimation(playerid,"PED","phone_in",4.0, false, true, true, true, true);
						SetPlayerAttachedObject(playerid, 1, 19623, 6, 0.126999, 0.066999, -0.042000, -5.600003, 52.599964, 87.400001, 1.000000, 1.000000, 1.000000, 0, 0);
						if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я достал и включил видеокамеру");
						else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я достала и включила видеокамеру");
						AttachObjectToPlayer(camcnn2,playerid, 0.0, 0.12, 0.7, 0.0, 0.0, 0.0);
		  			}
		  			else if(CnnVed[playerid] == 2)
		  			{
		  				CnnVed[playerid] = 0;
						ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
					    RemovePlayerAttachedObject(playerid,1);
						if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я убрал и выключил видеокамеру");
						else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я убрала и выключила видеокамеру");
						if(cnnchan == 2) // Включаем студию
					  	{
								cnnchan = 1;
								foreach (Player, i)
				  				{
				 					if(OnlineInfo[i][oLogged] == 1 && CnnVed[i] == 12) OpenTv(i); // Снова открываем
								}
						}
		  			}
		  }
		  else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет видеокамеры");
	}
	return 1;
}
CMD:tv(playerid, const params[])
{
	if(GetPlayerVirtualWorld(playerid) <= 1000 || GetPlayerVirtualWorld(playerid) > 2000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Смотреть эфир можно только на телевизоре в доме!");
	if(!GetTVObject(GetPlayerVirtualWorld(playerid)-1000)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В доме нет телевизора [ Y >> GPS >> Услуги >> IKEA ]");
	if(DomInfo[GetPlayerVirtualWorld(playerid)-1000][dElectroConnect] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Дом не подключен к электростанции");
	//	if(get_invent4(playerid, 26, 0) <= 0 && CnnVed[playerid] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	//	if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника]");
	//	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу смотреть новости сидя в машине");
	if(howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо...");
	if(GetPVarInt(playerid, "Boot") > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в багажнике");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(Ash[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу смотреть новости во время обучения");
	if(cnnchan == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телеканал CNN сейчас ничего не показывает");
	if(CnnVed[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я ведущий и не могу смотреть новости");
	if(CnnVed[playerid] == 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я оператор и не могу смотреть новости");
	if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192) return 1;
	if(IsPlayerEditObject(playerid) || MenuInfo[playerid][zStat] == 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят редактированием объекта");
	if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
	if(CnnVed[playerid] == 0)
	{
		if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
        if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
		new Float:X, Float:Y, Float:Z, Float:A;
		GetPlayerPos(playerid, X, Y, Z);
		GetPlayerFacingAngle(playerid, A);
		SpA[playerid]=A;
		SpX[playerid]=X;
		SpY[playerid]=Y;
		SpZ[playerid]=Z;
	    SpInt[playerid]=GetPlayerInterior(playerid);
	    SpWorld[playerid]=GetPlayerVirtualWorld(playerid);
		OpenTv(playerid);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выключить CNN Channel {ff9000}[ /tv ]");
	}
	else if(CnnVed[playerid] >= 11) CloseTv(playerid);
	return 1;
}
CMD:channel(playerid)
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(65, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник CNN");
	if(!GetAccessRankOrg(playerid, g, 65, NO_FBI)) return 1;

	PlayerPlaySound(playerid,40405,0,0,0);
	new str[100],sctring[400];
	format(str,sizeof(str),"{0088ff}* {FFFFFF}Музыка Новостей\n");
	strcat(sctring,str);
	format(str,sizeof(str),"{0088ff}* {FFFFFF}Зрители TV\n");
	strcat(sctring,str);
	if(cnnchan >= 1)format(str,sizeof(str),"{0088ff}* {FFFFFF}Прямой Эфир [ {00cc00}On ]\n");
	else if(cnnchan == 0)format(str,sizeof(str),"{0088ff}* {FFFFFF}Прямой Эфир [ {ff0000}Off ]\n");
	strcat(sctring,str);
	if(cnnchan == 1) format(str,sizeof(str),"{0088ff}* {FFFFFF}Трансляция [ Студия ]\n");
	else if(cnnchan == 2) format(str,sizeof(str),"{0088ff}* {FFFFFF}Трансляция [ Камера ]\n");
	strcat(sctring,str);
	ShowDialog(playerid,541,DIALOG_STYLE_LIST,"{0088ff}Cnn Channel",sctring,"Выбор","Отмена");
	return 1;
}
CMD:news(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(64, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник CNN");
	if(!GetAccessRankOrg(playerid, g, 64, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pTransmitterOff][9] == true) return ErrorMessage(playerid, "{FF6347}У вас выключен этот чат\n{cccccc}Y >> Меню >> Настройки Чата");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(sscanf(params, "s[144]",params[0])) return  SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Новости CNN [ /news Текст ]");

	new newcar = GetPlayerVehicleID(playerid);
	if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу вести новости [ С 3 ранга ]");
	if(newcar >= cnncar[0] && newcar <= cnncar[1] || Cars[newcar] == 9
		|| IsPlayerInRangeOfPoint(playerid,10.0,1432.6202,-1189.6243,124.0505) 
			&& GetPlayerVirtualWorld(playerid) == WORLD_CNN_2LVL && GetPlayerInterior(playerid) == INT_CNN_2LVL)
	{
		if(AntiFloodText(playerid, params[0])) return 1;

		format(string, sizeof(string), "* [ CNN ] {ffffff}Ведущий %s[%d]: {9ACD32}%s *", PlayerInfo[playerid][pName], playerid, params[0]);
		OOCNews(COLOR_LIGHTGREEN,string);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не в Студии или Транспорте CNN");
 	return 1;
}
CMD:live(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(66, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник CNN");
	if(!GetAccessRankOrg(playerid, g, 66, NO_FBI)) return 1;

 	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Взять интервью [ /live ID ]");
 	new string[144];
	if(IsOnline(params[0]))
	{
		if(TalkingLive[playerid] != 9999)
		{
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Интервью: {ff0000}Завершено");
			format(string, sizeof(string), "благодарит %s за интервью", playername(TalkingLive[playerid]));
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,3000);
			SendClientMessage(TalkingLive[playerid], COLOR_GREY, "[ Мысли ]: Интервью: {ff0000}Завершено");
			TogglePlayerControllable(playerid, true);
			TogglePlayerControllable(TalkingLive[playerid], true);
			TalkingLive[TalkingLive[playerid]] = 9999;
			TalkingLive[playerid] = 9999;
			return 1;
		}
		if(ProxDetectorS(5.0, playerid, params[0]))
		{
			if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не взять интервью у себя");
			format(string, sizeof(string), "[ Мысли ]: Я хочу взять интервью у %s", playername(params[0]));
			SendClientMessage(playerid, COLOR_GREY, string);
			LiveOffer[params[0]] = playerid;
			format(string, sizeof(string), "хочет взять интервью у %s", playername(params[0]));
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,3000);
			format(string, sizeof(string), "{ffffff}Репортёр %s хочет взять у вас интервью\n\n{cccccc}Вы согласны ?", playername(playerid));
   			ShowDialog(params[0],540,DIALOG_STYLE_MSGBOX,"Репортёр",string,"Да","Нет");
		}
		else
		{
	  		format(string, sizeof(string), "[ Мысли ]: {ff0000}%s {cccccc}далеко от меня находится", playername(params[0]));
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
	}
	else
	{
		if(TalkingLive[playerid] != 9999)
		{
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Интервью: {ff0000}Завершено");
			SetPlayerChatBubble(playerid,"завершает интервью",COLOR_PURPLE,20.0,3000);
			TogglePlayerControllable(playerid, true);
			TalkingLive[playerid] = 9999;
			return 1;
		}
		else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	}
	return 1;
}
CMD:zoidberg(playerid, const params[])
{
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid,COLOR_YELLOW2,"Используйте /zoidberg [1-2]");
 	if(GetPlayerSpeed(playerid) > 3) return 1;
 	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в транспорте");
  	if(NoAnim[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
	if(params[0] < 1 || params[0] > 2) SendClientMessage(playerid,COLOR_YELLOW2,"Используйте /zoidberg [1-2]");
 	if(params[0] == 1)  ApplyAnimation(playerid,"BSKTBALL","BBALL_def_stepL",4.1, true, true, true, true, true);
	else if(params[0] == 2)  ApplyAnimation(playerid,"BSKTBALL","BBALL_def_stepR",4.1, true, true, true, true, true);
  	return 1;
}
CMD:rap(playerid, const params[])
{
	new animationplayed;
	if (!sscanf(params, "i", animationplayed))
 	{
 	    if(GetPlayerSpeed(playerid) > 3) return 1;
 	    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в транспорте");
 	    if(NoAnim[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
		if(animationplayed < 1 || animationplayed > 10) SendClientMessage(playerid,COLOR_YELLOW2,"Используйте /rap [1-10]");
        if(animationplayed == 1) {
        ApplyAnimation(playerid,"benchpress","gym_bp_celebrate",4.1, true, true, true, true, true);
        }else if(animationplayed == 2) {
        ApplyAnimation(playerid,"MD_END","END_SC2_RYD",4.1, true, true, true, true, true);
        }else if(animationplayed == 3) {
        ApplyAnimation(playerid,"MD_END","END_SC2_SWE",4.0, false, true, true, true, true);
        }else if(animationplayed == 4) {
        ApplyAnimation(playerid,"Freeweights","gym_free_celebrate",4.1, false, false, false, false, false);
        }else if(animationplayed == 5) {
        ApplyAnimation(playerid,"STRIP","PUN_LOOP",4.1, true, true, true, true, true);
        }else if(animationplayed == 6) {
        ApplyAnimation(playerid,"PED","WALK_player",4.1, true, true, true, true, true);
        }else if(animationplayed == 7) {
        ApplyAnimation(playerid,"PED","WOMAN_walknorm",4.1, true, true, true, true, true);
        }else if(animationplayed == 8) {
        ApplyAnimation(playerid,"PED","WOMAN_walkpro",4.1, true, true, true, true, true);
        }else if(animationplayed == 9) {
        ApplyAnimation(playerid,"PED","WALK_gang2",4.1, true, true, true, true, true);
        }else if(animationplayed == 10) {
        ApplyAnimation(playerid,"PED","WALK_gang1",4.1, true, true, true, true, true);
		}
  	}
  	else SendClientMessage(playerid,COLOR_YELLOW2,"Используйте /rap [1-10]");
   	return 1;
}

CMD:vote(playerid)
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(ViborInfo[vstat] == 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В данный момент ведутся выборы сенаторов в палату конгресса");
	PlayerPlaySound(playerid,40405,0,0,0);
	new str[31],sctring[93];
	if(ViborInfo[vstat] == 0) format(str,sizeof(str),"{99ff66}Открыть Выборы");
	else if(ViborInfo[vstat] == 1) format(str,sizeof(str),"{FF6347}Завершить Выборы");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Название Выборов");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Кандидаты");
	strcat(sctring,str);
	ShowDialog(playerid,523,DIALOG_STYLE_LIST,"{0088ff}Управление Выборами",sctring,"Выбор","Отмена");
