stock ShowDialog(playerid, dialogid, style, const caption[], const info[], const button1[], const button2[])
{
	OnlineInfo[playerid][oDialogID] = dialogid;
	OnlineInfo[playerid][oDialogStyle] = style;
	OnlineInfo[playerid][oDialogClosed] = false;

	if (dialogid < 0 || isnull(info)) {
		OnlineInfo[playerid][oDialogClosed] = true;
		return false;
	}

    return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE: style, caption, info, button1, button2);
}
stock GetName(playerid)
{
	new PlayerName[24];
	GetPlayerName(playerid,PlayerName,sizeof(PlayerName));
	return PlayerName;
}
stock playername(playerid)
{
	new PlayerName[21];
	if(NameTag[playerid] == true)
	{
		if(PlayerInfo[playerid][pSex] == 1) format(PlayerName,sizeof(PlayerName),"Незнакомец");
		else format(PlayerName,sizeof(PlayerName),"Незнакомка");
	}
	else
	{
		if(gSign[playerid] == true) GetPlayerName(playerid,PlayerName,sizeof(PlayerName));
		else format(PlayerName,sizeof(PlayerName),PlayerInfo[playerid][pName]);
	}
	return PlayerName;
}
stock rpplayername(playerid)
{
	new PlayerName[MAX_PLAYER_NAME + 1];
	if(IsOnline(playerid))
	{
		if(gSign[playerid] == true) GetPlayerName(playerid, PlayerName, sizeof(PlayerName));
		else format(PlayerName, sizeof(PlayerName), PlayerInfo[playerid][pName]);
	}
	else format(PlayerName, sizeof(PlayerName), "Неизвестен");
	return PlayerName;
}
stock entvhod(playerid, stat)
{
	if(PlayerInfo[playerid][pMember] != 3 && PlayerInfo[playerid][pLeader] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не боец NGSA");
 	if(stat == 0) PPSetPlayerPos(playerid,-1557.8134,280.7719,7.1875); // Зашли в Будку ВМС 1
 	else if(stat == 1) PPSetPlayerPos(playerid,-1554.1683,280.7910,7.1875); // Вышли из Будки ВМС 1
 	else if(stat == 2) PPSetPlayerPos(playerid,-1559.9225,278.9256,7.1875); // Зашли в Будку ВМС 2
 	else if(stat == 3) PPSetPlayerPos(playerid,-1559.8580,275.7828,7.1875); // Вышли из Будки ВМС 2
	return 1;
}
stock rate(stat , money)
{
	new lave;
	if(stat == 1) lave = money;
	else if(stat == 2) lave = money*8000;
	else if(stat == 3) lave = money*100000;
	else if(stat == 4) lave = GetVehiclePriceGos(VehInfo[money][vModel]); // Сумма Авто в $
	else if(stat == 6) lave = DomInfo[money][dSost2];
	//else if(stat == 7) lave = RoomInfo[money][rSost2];
	else if(stat == 8) lave = biz_cena(money);
	else if(stat == 9) lave = money*40;
	else if(stat == 10)
	{
		lave = 500*8000;
		if(FamilyInfo[money][fStatusUch] >= 1) lave += 100*8000;
		if(FamilyInfo[money][fStatusSpawn] >= 1) lave += 300*8000;
		if(FamilyInfo[money][fStatusRank] >= 1) lave += 500*8000;
	 	if(FamilyInfo[money][fStatusGarage] >= 1) lave += 900*8000;
	}
  	return lave;
}

stock biz_cena(b) // Стоимости бизнесов по гос цене
{
	if(BizzInfo[b][bCost] > 0) return BizzInfo[b][bCost];

	new cena;
	new mani;
	for(new h = 0; h < 30; h++)
	{
		mani += BizzInfo[b][bHiscome][h];
		if(BizzInfo[b][bHiscome][h] > 0) mani += BizzInfo[b][bHiscome][h];
		else mani += BizzInfo[b][bIncome];
	}
	mani += BizzInfo[b][bIncome];
	cena = mani*2;
	if(cena < 50000) cena = 10000000;
 	return cena;
}

stock BizType(b) // Тип Бизнес
{
	new klass;
	switch(b)
	{
		case 1..12: klass = 0; // Заправки
		case 13..26: klass = 1; // Супермаркеты
		case 27..41: klass = 2; // Оружейные Магазины
		case 42..52: klass = 3; // Аренда Транспорта (Автомобили)
		case 53..56: klass = 4; // Аренда Самолётов (Самолёты)
		case 57..61: klass = 5; // Аренда Катеров (Катера)
		case 62..66: klass = 6; // Аренда Мотоциклов (Мотоциклы)
		case 67..76: klass = 7; // Аренда Скутеров (Скутеры)
		case 77..81: klass = 8; // Автосалон (Автомобили)
		case 82..86: klass = 9; // Мотосалон (Мотоциклы)
		case 87..89: klass = 10; // Авиасалон (Продажа Самолётов и Вертолётов)
		case 90..92: klass = 11; // Салон Катеров (Продажа Водного Транспорта)
		case 93..102: klass = 12; // Бар / Клуб / Стрипклуб
		case 103..117: klass = 13; // Закусочные (Хавчик Обычный)
		case 118..122: klass = 14; // Рестораны (Для Будущих Мафий)
		case 123..132: klass = 15; // Аптеки
		case 133..142: klass = 16; // Магазины с Техникой (Мобилы, Фотики, Рация, Фонарики и Ноутбуки)
		case 143..152: klass = 17; // Электростанции (1 Станция, на каждые 100 домов и так до 1000)
		case 153..162: klass = 18; // Переносные Ларьки с Хавкой (Шаурма, Бургеры и Прочее)
		case 163..172: klass = 19; // Банк (Установка банкоматов и у каждого банка своя Комиссия)
		case 173..182: klass = 20; // Магазины с Одеждой и Аксессуарами
		case 183..192: klass = 21; // Автосервисы (Ремонт и Тюнинг)
		case 193..196: klass = 22; // Сервис Авиатранспорта (Ремонт и Заправка)
		case 197..199: klass = 23; // Сервис Катеров (Ремонт и Заправка)
		case 200: klass = 24; // Казино
	}
 	return klass;
}
stock bizTypeMin(t, &minB, &maxB) // Получаем по классу минимальный id бизнеса
{
	switch(t)
	{
		case 0: minB = 1, maxB = 12; // Заправки
		case 1: minB = 13, maxB = 26; // Супермаркеты
		case 2: minB = 27, maxB = 41; // Оружейные Магазины
		case 3: minB = 42, maxB = 52; // Аренда Транспорта
		case 4: minB = 53, maxB = 56; // Аренда Самолётов
		case 5: minB = 57, maxB = 61; // Аренда Катеров
		case 6: minB = 62, maxB = 66; // Аренда Мотоциклов
		case 7: minB = 67, maxB = 76; // Аренда Скутеров
		case 8: minB = 77, maxB = 81; // Автосалон
		case 9: minB = 82, maxB = 86; // Мотосалон
		case 10: minB = 87, maxB = 89; // Авиасалон
		case 11: minB = 90, maxB = 92; // Салон Катеров
		case 12: minB = 93, maxB = 102; // Бар / Клуб / Стрипклуб
		case 13: minB = 103, maxB = 117; // Закусочные
		case 14: minB = 118, maxB = 122; // Рестораны
		case 15: minB = 123, maxB = 132; // Аптеки
		case 16: minB = 133, maxB = 142; // Магазины с Техникой
		case 17: minB = 143, maxB = 152; // Электростанции
		case 18: minB = 153, maxB = 162; // Переносные Ларьки с Хавкой
		case 19: minB = 163, maxB = 172; // Банк
		case 20: minB = 173, maxB = 182; // Магазины с Одеждой и Аксессуарами
		case 21: minB = 183, maxB = 192; // Автосервисы
		case 22: minB = 193, maxB = 196; // Сервис Авиатранспорта
		case 23: minB = 197, maxB = 199; // Сервис Катеров
		case 24: minB = 200, maxB = 200; // Казино
		default: minB = 0, maxB = 0;
	}
}

stock GetBizMin(bizType)
{
	new minB, maxB;
	bizTypeMin(bizType, minB, maxB);
	return minB;
}

