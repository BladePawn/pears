    else positiond_x = hintdraw_x+PlayerInfo[playerid][pDrawPos_X][9], positiond_y = hintdraw_y+PlayerInfo[playerid][pDrawPos_Y][9];

	if(setting_pos_draw[playerid] == 10 || setting_size_draw[playerid] == 10) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	else sized_x = PlayerInfo[playerid][pDrawSize_X][9], sized_y = PlayerInfo[playerid][pDrawSize_Y][9];
	
	if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[9], positiond_y += DrawPosSmart_Y[9], sized_y += DrawSizeSmart_Y[9];

