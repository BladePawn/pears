	mysql_tquery(pearsq, string_mysql, "Call_DelGangObject", "ddd", g, mapid, slot);
	return 1;
}
function Call_DelGangObject(g, mapid, slot)
{
	new rows;
	cache_get_row_count(rows);
	if(rows) 
	{
		new string_mysql[160];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql),"DELETE FROM `pp_mapfrak` WHERE `frakid`='%d' AND `mapid`='%d' AND `slot`='%d'", g, mapid, slot);
		query_empty(pearsq, string_mysql);
	}
	return 1;
}
stock UpdateGangObject(g, mapid, slot)
{
	new string_mysql[160];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `pp_mapfrak` WHERE `frakid`='%d' AND `mapid`='%d' AND `slot`='%d'", g, mapid, slot);
	mysql_tquery(pearsq, string_mysql, "Call_UpdateGangObject", "ddd", g, mapid, slot);
	return 1;
}
function Call_UpdateGangObject(g, mapid, slot)
{
	new rows, org = g-13;
	cache_get_row_count(rows);

	new Float:pos[3], Float:rot[3];
	GetDynamicObjectPos(ObjectInfo[org][gObject][slot], pos[0], pos[1], pos[2]);
	GetDynamicObjectRot(ObjectInfo[org][gObject][slot], rot[0], rot[1], rot[2]);
	if(!rows)
	{
		new string_mysql[240];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `pp_mapfrak` SET `frakid`='%d',`mapid`='%d',`user`='%d',`model`='%d',`slot`='%d',`ox`='%f',`oy`='%f',`oz`='%f',`orx`='%f',`ory`='%f',`orz`='%f'",
	 	g, mapid, ObjectInfo[org][gUser][slot], ObjectInfo[org][gOmodel][slot], slot, pos[0], pos[1], pos[2], rot[0], rot[1], rot[2]);
	 	query_empty(pearsq, string_mysql);
	}
	else
	{
		new string_mysql[240];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_mapfrak` SET `user`='%d',`model`='%d',`ox`='%f',`oy`='%f',`oz`='%f',`orx`='%f',`ory`='%f',`orz`='%f' WHERE `frakid`='%d' AND `mapid`='%d' AND `slot`='%d'",
	 	ObjectInfo[org][gUser][slot], ObjectInfo[org][gOmodel][slot], pos[0], pos[1], pos[2], rot[0], rot[1], rot[2],
	 	g, mapid, slot);
	 	query_empty(pearsq, string_mysql);
	}
	return 1;
}
