	mysql_tquery(pearsq, "SELECT * FROM `criminal_code`", "LoadCriminalCode", ""); // Загрузка кодекса правонарушений
	mysql_tquery(pearsq, "SELECT * FROM `division`", "LoadDivision", ""); // Загрузка подфракций
