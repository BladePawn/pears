forward Call_unrentdom(playerid, idacc);
public Call_unrentdom(playerid, idacc)
{
	new rows, f_str[128], string[144];
	cache_get_row_count(rows);
	if(rows)
	{
		if(PlayerInfo[playerid][pDom] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Владелец дома неожиданно потерял свой дом..");
 		new nd = PlayerInfo[playerid][pDom];
		new datad1[24],datad2,giveplayerid;
		cache_get_value_name(0, "Name", datad1, 24);
		cache_get_value_name_int(0, "Spawnchange", datad2);
        if(datad2 == 4) datad2 = 0;
        mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Houserent` = '0', `Spawnchange` = '%d' WHERE `user_id` = '%d'", datad2, idacc);
		query_empty(pearsq, f_str);
        giveplayerid = ReturnUser(datad1, 1);
        if(IsOnline(giveplayerid))
		{
			PlayerInfo[giveplayerid][pHouserent] = 0;
			if(PlayerInfo[giveplayerid][pSelectspawn] == 7) PlayerInfo[giveplayerid][pSelectspawn] = 0;
			if(OnlineInfo[giveplayerid][oLogged] == 1)
			{
				format(string, sizeof(string), "[ Мысли ]: Владелец {ff9000}%s {cccccc}выселил меня",PlayerInfo[playerid][pName]);
 				SendClientMessage(giveplayerid, COLOR_GREY, string);
 				format(string, sizeof(string), "Владелец {ff9000}%s {cccccc}выселил вас",PlayerInfo[playerid][pName]);
				ShowDialog(giveplayerid,1996,DIALOG_STYLE_MSGBOX,"{FF9000}Выселение",string,"*","");
				mysql_save(giveplayerid, 4);
			}
		}
		new qwer[54];
		format(qwer, sizeof(qwer), "Выселил %s",datad1);
		HouseLog(0, "domrent", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], nd, 0, qwer);
		format(qwer, sizeof(qwer), "Вас выселили из дома № %d", nd);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], idacc, datad1, qwer);
		DomInfo[nd][dLodger] --;
  		SaveDom(nd);
		format(string, sizeof(string), "[ Мысли ]: {ffcc00}%s {cccccc}больше не живёт в моём доме", datad1);
  		SendClientMessage(playerid, COLOR_GREY, string);
  		pc_cmd_mydom(playerid);
	}
	return true;
}

