				SendRadioMessage(3, COLOR_GREY, string);
				new Float:X,Float:Y,Float:Z,Float:A;
				GetPlayerPos(playerid, X,Y,Z);
				GetPlayerFacingAngle(playerid,A);
				X=X+0.5*floatsin(-A,degrees);
        		Y=Y+0.5*floatcos(-A,degrees);
				PizdaX = X, PizdaY = Y, PizdaZ = Z;
