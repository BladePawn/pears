CMD:setcolor(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(48, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(!GetAccessRankOrg(playerid, g, 48, PlayerInfo[playerid][pFbi])) return 1;

	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: /setcolor [ номер организации 1 - 22 ]");
	if(params[0] > 22 || params[0] < 1 || params[0] == 8
		|| params[0] == 17
		|| params[0] == 19
		|| params[0] == 20) return ErrorMessage(playerid, "{FF6347}Не меньше 1 и не больше 22 [ 8, 17, 19, 20 - Исключение ]");
	
	SetPlayerColor(playerid, GetFractionColor(params[0]));
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Внешняя маскировка: [ %s {cccccc}]", frakName[params[0]]);

    return 1;
}

CMD:color(playerid)
{
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	new string[144];

	new g = fraction(playerid);
	if(GetPlayerColor(playerid) != GetFractionColor(g))
	{
  		if(g == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
  		if(PlayerInfo[playerid][pMember] == 8) return ErrorMessage(playerid, "{FF6347}Ваша организация секретна и вы не можете использовать значки отличия");

		switch(g)
		{
			case 1, 11, 21:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s прикрепил значок полицейского.", playername(playerid));
	    		else format(string, sizeof(string), "* %s прикрепила значок полицейского.", playername(playerid));
			}
			case 2, 4, 7, 9:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s прикрепил бейджик.", playername(playerid));
	    		else format(string, sizeof(string), "* %s прикрепила бейджик.", playername(playerid));
			}
			case 3:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел каску.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела каску.", playername(playerid));
			}
			case 5:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел перстень Cosa Nostra.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела перстень Cosa Nostra.", playername(playerid));
			}
			case 6:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел перстень Yakuza Mafia.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела перстень Yakuza Mafia.", playername(playerid));
			}
			case 10:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел перстень Triada Mafia.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела перстень Triada Mafia.", playername(playerid));
			}
			case 12:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел перстень Russian Mafia.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела перстень Russian Mafia.", playername(playerid));
			}
			case 13:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел бандану Grove Street.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела бандану Grove Street.", playername(playerid));
			}
			case 14:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел бандану Ballas Gang.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела бандану Ballas Gang.", playername(playerid));
			}
			case 15:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел бандану Vagos Gang.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела бандану Vagos Gang.", playername(playerid));
			}
			case 16:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел бандану Los Aztecas Gang.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела бандану Los Aztecas Gang.", playername(playerid));
			}
			case 17:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел бандану Rifa Gang.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела бандану Rifa Gang.", playername(playerid));
			}
			case 18:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел перстень Arabian Mafia.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела перстень Arabian Mafia.", playername(playerid));
			}
			case 19:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s прикрепил нашивку Street Racers.", playername(playerid));
	    		else format(string, sizeof(string), "* %s прикрепила нашивку Street Racers.", playername(playerid));
			}
			case 20:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s надел бандану Bikers.", playername(playerid));
	    		else format(string, sizeof(string), "* %s надела бандану Bikers.", playername(playerid));
			}
			case 22:
			{
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "* %s прикрепил жетон бойца SWAT.", playername(playerid));
	    		else format(string, sizeof(string), "* %s прикрепила жетон бойца SWAT.", playername(playerid));
			}
			default: { }
  		}
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
  		SetPlayerToTeamColor(playerid);
	}
	else
	{
		if(fraction(playerid) >= 1 && Kapt[fraction(playerid)] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Меня могут убить свои, если я избавлюсь от банданы во время битвы");
		SetPlayerColor(playerid,INV_COLOR);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Значок отличия выключен");
	}
  	return 1;
}
