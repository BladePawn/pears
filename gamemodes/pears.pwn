stock ExitInteriorsFunction(playerid)
{
	// Вырубаем все лейблы интерьера
	if(LabelsInfo[playerid][labelCreate] != 0) ClosePlayer3DLabelAll(playerid);

	// Редактор Текстур (Закрываем отображение слотов текстур)
	if(MenuInfo[playerid][zStat] == 1)
	{
		Destroy3DMenu(playerid);
		Close3DMenu(playerid);
	}

	// Отрубаем редактор объектов
	CloseEditObject(playerid);
	return true;
}

stock EjectDom(d, playerid = -1, bool:andMe = true)
{
	if(d <= 0 || d >= MAX_DOM) return false;

	foreach(Player,i)
	{
		if(i == playerid && andMe == false)
		{
			ExitInteriorsFunction(i);

			// Ставим игрока у входа в дом
			PPSetPlayerPos(i, DomInfo[d][dEnterX],DomInfo[d][dEnterY],DomInfo[d][dEnterZ]);
			PPSetPlayerFacingAngle(playerid, DomInfo[d][dEnterA]);
		}

		if(i == playerid && andMe == false) continue; // Пропускаем одного игрока

		if(PlayerInHouse(i) == d)
		{
			if(IsPlayerInRangeOfPoint(i, 300.0,DomInfo[d][dEnterX],DomInfo[d][dEnterY],DomInfo[d][dEnterZ]))
			{
				ExitInteriorsFunction(i);

				S_SetPlayerVirtualWorld(i,0,0);
				PPSetPlayerInterior(i,0);
				PPSetPlayerPos(i,DomInfo[d][dKoordinatX],DomInfo[d][dKoordinatY],DomInfo[d][dKoordinatZ]);
				PPSetPlayerFacingAngle(i, DomInfo[d][dKoordinatA]);
		 		if(OnlineInfo[i][oShowInterface] == 1) CloseFrisk(i), CancelSelectTextDraw(i);
		 		SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Меня попросили выйти из дома.. {ff9000}[ Изменился Интерьер ]");
				ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}В доме изменился интерьер\n\n{ff9000}Система установила вашу позицию у входа в этот дом ;)","Oк","");
	 		}
		}
	}
	return 1;
}
stock EjectBiz(b, playerid = -1, bool:andMe = true)
{
	if(b <= 0 || b >= MAX_BIZ) return false;

	foreach(Player,i)
	{
		if(i == playerid && andMe == false)
		{
			ExitInteriorsFunction(i);

			// Ставим игрока у входа в дом
			PPSetPlayerPos(i, BizzInfo[b][bInteriorX],BizzInfo[b][bInteriorY],BizzInfo[b][bInteriorZ]);
			PPSetPlayerFacingAngle(i, BizzInfo[b][bInteriorA]);
		}

		if(i == playerid && andMe == false) continue; // Пропускаем одного игрока

		if(PlayerInBusiness(i) == b)
		{
			if(IsPlayerInRangeOfPoint(i, 300.0,BizzInfo[b][bInteriorX],BizzInfo[b][bInteriorY],BizzInfo[b][bInteriorZ]))
			{
				ExitInteriorsFunction(i);

				S_SetPlayerVirtualWorld(i,0,0);
				PPSetPlayerInterior(i,0);
				PPSetPlayerPos(i,BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]);
				PPSetPlayerFacingAngle(i, BizzInfo[b][bEnterA]);
				if(OnlineInfo[i][oShowInterface] == 1) CloseFrisk(i), CancelSelectTextDraw(i);
		 		SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Меня попросили выйти из заведения {ff9000}[ Изменился Интерьер ]");
				ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{ffcc66}В заведении изменился интерьер\n\n{ff9000}Система установила вашу позицию у входа ;)","Oк","");
	 		}
		}
	}
	return 1;
}
stock bizint(b, interior)
{
	if(b <= 0 || b >= MAX_BIZ) return 1;
	EjectBiz(b);

	printf("[bizint]: biz %d", b);

	// Удаляем планировку 
	// по сути эта часть кода не требуется, ибо DestroyAllInteriorObjectsVBiz всё удаляет
	// однако, был какой-то баг странный из-за которого планировка, падлюка, не удалялась
	if(BizzInfo[b][bOmodel][0] >= 1)
	{
		for(new oba = 0; oba < IsAQuanInterior(BizzInfo[b][bOmodel][0]); oba++)
		{
			printf("[bizint]: DestroyDynamicObject %d, bOmodel %d", BizzInfo[b][bObject][oba], BizzInfo[b][bOmodel][oba]);
			DestroyDynamicObject(BizzInfo[b][bObject][oba]);
			BizzInfo[b][bObject][oba] = 0;
			BizzInfo[b][bOmodel][oba] = 0;
		}
	}

	// Начало транзакции
	mysql_tquery(pearsq, "START TRANSACTION;");

	// Удаляем все объекты
	DestroyAllInteriorObjectsVBiz(b);

	new frame = interior-10000;
	BizzInfo[b][bOmodel][0] = FrameInfo[frame][frModel];
	BizzInfo[b][bObject][0] = CreateDynamicObject(FrameInfo[frame][frModel], FrameInfo[frame][frX], FrameInfo[frame][frY], FrameInfo[frame][frZ], FrameInfo[frame][frRX], FrameInfo[frame][frRY], FrameInfo[frame][frRZ], b+3000, 90, -1, 100.00, 100.00);
	BizzInfo[b][bInteriorX] = 1387.4436, BizzInfo[b][bInteriorY] = -16.2143, BizzInfo[b][bInteriorZ] = 1000.8868 + FixPosInInteriorZ(b, 1), BizzInfo[b][bInteriorA] = 359.7609, BizzInfo[b][bInterior] = 90;

	printf("[bizint]: CreateDynamicObject %d, bOmodel %d", BizzInfo[b][bObject][0], BizzInfo[b][bOmodel][0]);

	UpdateObjectBiz(b, 0);
	SaveBizz(b);

	// Сбрасываем id интерьера из архива, поскольку теперь в нашем помещении новый интерьер
	SetBizThisInterior(b, 0);

	// Завершение транзакции
	mysql_tquery(pearsq, "COMMIT;");
	return 1;
}
stock domint(d, interior)
{
	if(d <= 0 || d >= MAX_DOM) return 1;
	EjectDom(d);

	printf("[domint]: dom %d", d);

	// Удаляем планировку
	// по сути эта часть кода не требуется, ибо DestroyAllInteriorObjectsDom всё удаляет
	// однако, был какой-то баг странный из-за которого планировка, падлюка, не удалялась
	if(DomInfo[d][dOmodel][0] >= 1)
	{
		for(new oba = 0; oba < IsAQuanInterior(DomInfo[d][dOmodel][0]); oba++)
		{
			printf("[domint]: DestroyDynamicObject %d, dOmodel %d", DomInfo[d][dObject][oba], DomInfo[d][dOmodel][oba]);
			DestroyDynamicObject(DomInfo[d][dObject][oba]);
			DomInfo[d][dObject][oba] = 0;
			DomInfo[d][dOmodel][oba] = 0;
		}
	}

	// Начало транзакции
	mysql_tquery(pearsq, "START TRANSACTION;");

	// Удаляем все объекты
	DestroyAllInteriorObjectsDom(d);

	// Очищаем взаимодействия с предметами
	DeleteInteractionDom(d);

	new frame = interior-10000;
	DomInfo[d][dOmodel][0] = FrameInfo[frame][frModel];
	DomInfo[d][dObject][0] = CreateDynamicObject(DomInfo[d][dOmodel][0], FrameInfo[frame][frX], FrameInfo[frame][frY], FrameInfo[frame][frZ], FrameInfo[frame][frRX], FrameInfo[frame][frRY], FrameInfo[frame][frRZ], d+1000, 90, -1, 100.00, 100.00);
	
	// Если каркас требует второй объект, ставим его
	if(IsASecondObject(DomInfo[d][dOmodel][0]) > 0)
	{
		DomInfo[d][dOmodel][1] = IsASecondObject(DomInfo[d][dOmodel][0]);
		DomInfo[d][dObject][1] = CreateDynamicObject(DomInfo[d][dOmodel][1], FrameInfo[frame][frX], FrameInfo[frame][frY], FrameInfo[frame][frZ], FrameInfo[frame][frRX], FrameInfo[frame][frRY], FrameInfo[frame][frRZ], d+1000, 90, -1, 100.00, 100.00);
		UpdateObject(d, 1);
	}
	
	DomInfo[d][dEnterX] = 1387.4436, DomInfo[d][dEnterY] = -16.2143, DomInfo[d][dEnterZ] = 1000.8868 + FixPosInInteriorZ(d, 0), DomInfo[d][dEnterA] = 359.7609, DomInfo[d][dInterior] = 90;
	printf("[domint]: CreateDynamicObject %d, dOmodel %d", DomInfo[d][dObject][0], DomInfo[d][dOmodel][0]);

	DomInfo[d][dInspa] = 0; // Вырубаем нахрен особый спавн, если такой был
	UpdateObject(d, 0);
	SaveDom(d);

	// Сбрасываем id интерьера из архива, поскольку теперь в нашем помещении новый интерьер
	SetDomThisInterior(d, 0);

	// Завершение транзакции
	mysql_tquery(pearsq, "COMMIT;");
	return 1;
}

stock CreateDynamic3DPcPos() // Создание лейблов компов (При загрузке сервера)
{
	new string[60];
	for(new pc = 0; pc < sizeof(PcPos); ++pc)
	{
		if(PcPos[pc][PcGov] > 0) format(string,sizeof(string),"{444444}Компьютер {cccccc}[ H ]\n{cccccc}[ /gov ]");
		else format(string,sizeof(string),"{444444}Компьютер {cccccc}[ H ]");

		CreateDynamic3DTextLabel(string,-1, PcPos[pc][PcPos_X], PcPos[pc][PcPos_Y], PcPos[pc][PcPos_Z], 1.5,INVALID_PLAYER_ID,INVALID_VEHICLE_ID, PcPos[pc][PcLos], PcPos[pc][PcWorld], PcPos[pc][PcInt]);
	}
	return 1;
}

stock ShowAllObject(playerid, dom, stat, page = 0)
{
	DP[4][playerid] = dom;
	SetPVarInt(playerid, "DomObjectPage", page);
	PlayerPlaySound(playerid,40405,0,0,0);
    new str[214],sctring[4096], atext[10];
	new maxpages = DomInfo[dom][dMoreIntObjects] ? 5 : 3;

	new item_index, max_page_index = maxpages - 1;
	if (page > 0) {
		strcat(sctring, "{cccccc}Назад <<\n");
		List[item_index++][playerid] = MAX_OBJECT_INT + 2;
	}
	if (page == 0) strcat(sctring,"{cccccc}0. Планировка\t\n"), List[item_index++][playerid] = 0;
    for (new oba = 1 + page * MAX_OBJECT_INLIST; oba < 1 + (page + 1) * MAX_OBJECT_INLIST; oba++)
    {
		if (oba >= MAX_OBJECT_INT) break;

		if(DomInfo[dom][dOmodel][oba] >= 1)
		{
			if(MenuInfo[playerid][zObject] == oba) atext = "{ff9000}";
			else atext = "{cccccc}";
			if(oba > 0) 
			{
				if(GetDynamicObjectVirtualWorld(DomInfo[dom][dObject][oba]) > 0 
					&& GetDynamicObjectInterior(DomInfo[dom][dObject][oba]) > 0) format(str,sizeof(str),"{cccccc}%d. %s%s\t\n", oba, atext, getIkeaObjectName(DomInfo[dom][dOmodel][oba])), strcat(sctring,str);
				else format(str,sizeof(str),"%s%d. %s\t{666666}Улица\n", atext, oba, getIkeaObjectName(DomInfo[dom][dOmodel][oba])), strcat(sctring,str);
			}
		}
		else format(str,sizeof(str),"{cccccc}%d. ...\t\n",oba), strcat(sctring,str);
		List[item_index++][playerid] = oba;
	}

	if (page < max_page_index) {
		strcat(sctring, "\n{cccccc}Далее >>");
		List[item_index][playerid] = MAX_OBJECT_INT + 1;
	}

    if(stat == 1 || stat == 4) ShowDialog(playerid,918,DIALOG_STYLE_TABLIST,"{cccccc}Список Объектов {ff9000}[Текстуры]",sctring,"Выбор","Отмена");
    else if(stat == 2) ShowDialog(playerid,918,DIALOG_STYLE_TABLIST,"{cccccc}Список Объектов {ff9000}[Переместить]",sctring,"Выбор","Отмена");
    else if(stat == 3) ShowDialog(playerid,918,DIALOG_STYLE_TABLIST,"{cccccc}Список Объектов {ff9000}[Убрать]",sctring,"Выбор","Отмена");
	return 1;
}

stock ShowAllObjectBiz(playerid, b, stat)
{
	DP[4][playerid] = b;
	PlayerPlaySound(playerid,40405,0,0,0);
    new str[214],sctring[4096], atext[10];
 	for(new oba = 0; oba < MAX_OBJECT_INT_BIZ; oba++)
	{
	    if(BizzInfo[b][bOmodel][oba] >= 1)
	    {
	        if(MenuInfo[playerid][zObject] == oba) atext = "{ff9000}";
	        else atext = "{cccccc}";
	        if(oba == 0) format(str,sizeof(str),"%s%d. Планировка\t\n", atext, oba), strcat(sctring,str);
	        else 
			{
				if(GetDynamicObjectVirtualWorld(BizzInfo[b][bObject][oba]) > 0 
					&& GetDynamicObjectInterior(BizzInfo[b][bObject][oba]) > 0) format(str,sizeof(str),"{cccccc}%d. %s%s\t\n", oba, atext, getIkeaObjectName(BizzInfo[b][bOmodel][oba])), strcat(sctring,str);
				else format(str,sizeof(str),"%s%d. %s\t{666666}Улица\n", atext, oba, getIkeaObjectName(BizzInfo[b][bOmodel][oba])), strcat(sctring,str);
			}
		}
		else format(str,sizeof(str),"{cccccc}%d. ...\t\n",oba), strcat(sctring,str);
	}
    if(stat == 1 || stat == 4) ShowDialog(playerid,1274,DIALOG_STYLE_TABLIST,"{cccccc}Список Объектов {ff9000}[Текстуры]",sctring,"Выбор","Отмена");
    else if(stat == 2) ShowDialog(playerid,1274,DIALOG_STYLE_TABLIST,"{cccccc}Список Объектов {ff9000}[Переместить]",sctring,"Выбор","Отмена");
    else if(stat == 3) ShowDialog(playerid,1274,DIALOG_STYLE_TABLIST,"{cccccc}Список Объектов {ff9000}[Убрать]",sctring,"Выбор","Отмена");
	return 1;
}

stock SetPlayerSkinEx(playerid, skinid)
{
    new Float:tmpPos[4], vehicleid = GetPlayerVehicleID(playerid), seatid = GetPlayerVehicleSeat(playerid), tmp;
	GetPlayerPos(playerid, tmpPos[0], tmpPos[1], tmpPos[2]);
	GetPlayerFacingAngle(playerid, tmpPos[3]);

	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DUCK)
	{
	    PPSetPlayerPos(playerid, tmpPos[0], tmpPos[1], tmpPos[2]);
		PPSetPlayerFacingAngle(playerid, tmpPos[3]);
		TogglePlayerControllable(playerid, true); // предотвращение любого фриза - опционально
		tmp = SetPlayerSkin(playerid, skinid);
	}
	else if(IsPlayerInAnyVehicle(playerid))
	{
	    RemovePlayerFromVehicle(playerid);
	    PPSetPlayerPos(playerid, tmpPos[0], tmpPos[1], tmpPos[2]);
		PPSetPlayerFacingAngle(playerid, tmpPos[3]);
		TogglePlayerControllable(playerid, true); // предотвращение любого фриза - важно - из-за анимации выхода из транспорта
		tmp = SetPlayerSkin(playerid, skinid);
		PutPlayerInVehicle(playerid, vehicleid, (seatid == 128) ? 0 : seatid);
	}
	else tmp = SetPlayerSkin(playerid, skinid);

	SpecInfo(playerid, 1, 0); // Если кто-то следит, оповещаем что скин был изменён
	return tmp;
}

stock PearsWeather(playerid)
{
	ChangeWeather(playerid, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	return 1;
}

stock ChangeWeather(playerid, world, interior)
{
	if(PlayerInInteriorManiac(playerid)) return SetPlayerManiacWeather(playerid);

	if(interior == 221 && (world == 221 || world >= COMPUTER_CLUB_MIN_WORLD && world <= COMPUTER_CLUB_MAX_WORLD)) return SetPlayerWeather(playerid,21); // Moon
	if(interior == 222 && (world == 222 || world == 223 || world >= COMPUTER_CLUB_MIN_WORLD && world <= COMPUTER_CLUB_MAX_WORLD))
	{
		if(IsPlayerSyncModels(playerid)) SetPlayerWeather(playerid,22); // Mars с лаунчером
		else SetPlayerWeather(playerid,23); // Mars
		return 1;
	}
	if(interior == INT_HALLOWEEN_QUEST_1 || interior == INT_HALLOWEEN_QUEST_2) return SetPlayerWeather(playerid,9);
	
	if(interior == 199 && world >= 1 && world <= 10 || interior == 55 && world == 2001 
		|| interior == 227 && world == 227 || interior == 195 && world == 195) return SetPlayerWeather(playerid,1); // Инты с дневным освещением
	
	if((Effect[playerid] == 1 || Effect[playerid] == 2 || Effect[playerid] == 3 || Effect[playerid] == 4 || Effect[playerid] == 5) && EffectTime[playerid] >= 1)
	{
		if(interior == 0 && world == 0)
		{
			if(IsPlayerSyncModels(playerid)) SetPlayerWeather(playerid,22);
			else SetPlayerWeather(playerid,230);
			return true;
		}
	}
	
	// Включаем погоду в зоне облака
	if(UpdateWeatherPlayer(playerid)) return true;

	// Включаем стандартную погоду
	SetPlayerWeather(playerid, Pogoda);
	return true;
}

stock PearsTime(playerid)
{
	if(OnlineInfo[playerid][oTempTime] == 0)
	{
    	ChangeTime(playerid, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	}
	return 1;
}
stock ChangeTime(playerid, world, interior)
{
	if(PlayerInInteriorManiac(playerid)) return SetPlayerManiacTime(playerid);
	if(MineWar_IsPlayerInside(playerid)) return MineWar_SetPlayerTime(playerid);
	if(Tomb_IsPlayerInside(playerid)) return Tomb_SetPlayerTime(playerid);
	if(Graves_IsBattleNpc(playerid)) return Graves_SetPlayerTime(playerid);
	if(NarcoSpotPlayer_IsInside(playerid)) return NarcoSpot_SetPlayerTime(playerid);
	
	new tmphour,tmpminute,tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	if(interior == 221 && (world == 221 || world >= COMPUTER_CLUB_MIN_WORLD && world <= COMPUTER_CLUB_MAX_WORLD)) return SetPlayerTime(playerid,7,0);
	if(interior == 222 && (world == 222 || world == 223 || world >= COMPUTER_CLUB_MIN_WORLD && world <= COMPUTER_CLUB_MAX_WORLD)) return SetPlayerTime(playerid,20,0);

	if(interior == 199 && world >= 1 && world <= 10
		|| interior == 55 && world == 2001 || interior == 227 && world == 227 || interior == 195 && world == 195 
		|| interior == 194 && world == 194 || interior == 193 && world == 193
		|| interior == 192 && world == 192) return SetPlayerTime(playerid,12,0); // Инты с дневным освещением

	if((Effect[playerid] == 1 || Effect[playerid] == 2 || Effect[playerid] == 3 || Effect[playerid] == 4 || Effect[playerid] == 5) && EffectTime[playerid] >= 1)
	{
		if(interior == 0 && world == 0) return SetPlayerTime(playerid, 19, 0);
		else return SetPlayerTime(playerid, tmphour, tmpminute);
	}

	if(world == 241 && interior == 241) return SetPlayerTime(playerid, 2, 0); // Поздемелье Зоны 51
	
	SetPlayerTime(playerid, tmphour, tmpminute);
	return 1;
}
stock isarepairdom(d)
{
	foreach(Player,i)
	{
		if(GetPlayerVirtualWorld(i) >= 1001 && GetPlayerVirtualWorld(i) <= 2000 && GetPlayerVirtualWorld(i)-1000 == d)
		{
			if(IsPlayerInRangeOfPoint(i, 100.0, DomInfo[d][dEnterX], DomInfo[d][dEnterY], DomInfo[d][dEnterZ]))
			{
				if(gRedakt[i] == REDAKT_TYPE_FURNITURE_SET || gRedakt[i] == REDAKT_TYPE_FURNITURE_MOVE || MenuInfo[i][zStat] == 1) return 1;
			}
		}
	}
	return 0;
}
stock isaplayerbiz(b)
{
	new intbiz;
	if(b >= 13 && b <= 26) intbiz = 206; // Супермаркет
	else if(b >= 27 && b <= 41) intbiz = 207; // Магазин с Техникой
	foreach(Player,i)
	{
		if(GetPlayerVirtualWorld(i) >= 1 && GetPlayerVirtualWorld(i) == b && intbiz == GetPlayerInterior(i)) return 1;
	}
	return 0;
}
stock update_admpoint(playerid, point)
{
	if(ServerInfo[12] >= 1) PlayerInfo[playerid][pAdmPoint] += point*2;
	else 
	{
		if((HasABustAks(playerid,4) != -1)) PlayerInfo[playerid][pAdmPoint] += point*2;
		else PlayerInfo[playerid][pAdmPoint] += point;
	}
	if(PlayerInfo[playerid][pAdmPoint] >= ServerInfo[23] && point >= 1)
	{
		PlayerInfo[playerid][pAdmScore] += 1;
		PlayerInfo[playerid][pAdmPoint] -= ServerInfo[23];
	}
	mysql_save(playerid, 30);
	return 1;
}
forward Call_setvac(playerid, begvac, days, const str_name[]);
public Call_setvac(playerid, begvac, days, const str_name[])
{
	new rows, f_str[144];
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datadid, string[144];
		cache_get_value_name_int(0, "Soska", datad1);
		cache_get_value_name_int(0, "Leader", datad2);
		cache_get_value_name_int(0, "user_id", datadid);
		new datvac;
		if(days == 0) datvac = DP[0][playerid]+86340;
		else datvac = DP[0][playerid]+days*86400;
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `VacBeg` = '%d',`VacEnd` = '%d' WHERE `Name` = '%e'",DP[0][playerid], datvac, str_name);
		query_empty(pearsq, f_str);
		new byear, bmonth, bday, bhour, bminute, bsecond, eyear, emonth, eday, ehour, eminute, esecond;
		stamp2datetime(DP[0][playerid], byear, bmonth, bday, bhour, bminute, bsecond, 3);
		stamp2datetime(datvac, eyear, emonth, eday, ehour, eminute, esecond, 3);
		new giveplayerid;
		giveplayerid = ReturnUser(str_name, 1);
		if(IsOnline(giveplayerid))
		{
			if(OnlineInfo[giveplayerid][oLogged] == 1)
		    {
		    	if(giveplayerid == playerid)
				{
					if(days == 0) format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}Неактив {99ff66}установлен {cccccc}[ %02d.%02d.%d ] на {0088ff}этот {cccccc}день", bday, bmonth, byear), SendClientMessage(playerid,COLOR_GREY,string);
					else if(days == 1) format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}Неактив {99ff66}установлен {cccccc} c [ %02d.%02d.%d ] до [ %02d.%02d.%d ] {0088ff}1 {cccccc}день", bday, bmonth, byear, eday, emonth, eyear), SendClientMessage(playerid,COLOR_GREY,string);
					else if(days >= 2 || days <= 4) format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}Неактив {99ff66}установлен {cccccc} c [ %02d.%02d.%d ] до [ %02d.%02d.%d ] {0088ff}%d {cccccc}дня", bday, bmonth, byear, eday, emonth, eyear, days), SendClientMessage(playerid,COLOR_GREY,string);
					else format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}Неактив {99ff66}установлен {cccccc} c [ %02d.%02d.%d ] до [ %02d.%02d.%d ] {0088ff}%d {cccccc}дней", bday, bmonth, byear, eday, emonth, eyear, days), SendClientMessage(playerid,COLOR_GREY,string);
				}
				else
				{
					if(days == 0) format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}%s {99ff66}установил {cccccc}вам неактив {cccccc}[ %02d.%02d.%d ] на {0088ff}этот {cccccc}день", bday, bmonth, byear), SendClientMessage(playerid,COLOR_GREY,string);
					else if(days == 1) format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}%s {99ff66}установил {cccccc}вам неактив {cccccc} c [ %02d.%02d.%d ] до [ %02d.%02d.%d ] {0088ff}1 {cccccc}день", bday, bmonth, byear, eday, emonth, eyear), SendClientMessage(playerid,COLOR_GREY,string);
					else if(days >= 2 || days <= 4) format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}%s {99ff66}установил {cccccc}вам неактив {cccccc} c [ %02d.%02d.%d ] до [ %02d.%02d.%d ] {0088ff}%d {cccccc}дня", bday, bmonth, byear, eday, emonth, eyear, days), SendClientMessage(playerid,COLOR_GREY,string);
					else format(string,sizeof(string),"{ff9000}[ Server ]: {cccccc}%s {99ff66}установил {cccccc}вам неактив {cccccc} c [ %02d.%02d.%d ] до [ %02d.%02d.%d ] {0088ff}%d {cccccc}дней", bday, bmonth, byear, eday, emonth, eyear, days), SendClientMessage(playerid,COLOR_GREY,string);
				}
		    }
		}
		format(string, sizeof(string), "Неактив %s {99ff66}установлен {FF6347}[ %02d.%02d.%d ] на {0088ff}%d {FF6347}дней", str_name, bday, bmonth, byear, days);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string,sizeof(string),"Неактив с %02d.%02d.%d на %d дней", bday, bmonth, byear, days);
		if(datad1 >= 1) AdminLog("vacation", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", days, string);
		else if(datad2 >= 1 && datad1 == 0) OrgLog(datad2, "vacation", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", days, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
forward Call_vacation(playerid, const str_name[]);
public Call_vacation(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		format(ListName[playerid], 24, "%s", str_name);
		new datad[2],str[100],sctring[300];
		cache_get_value_name_int(0, "VacBeg", datad[0]);
		cache_get_value_name_int(0, "VacEnd", datad[1]);
		if(datad[0] == 0) // Создать Неактив
    	{
    		new unixtime = gettime();
    		new tyear[11], tmonth[11], tday[11], thour[11], tminute[11], tsecond[11];
			stamp2datetime(unixtime-86400*5, tyear[0], tmonth[0], tday[0], thour[0], tminute[0], tsecond[0], 3); // -5 Дней
    		stamp2datetime(unixtime-86400*4, tyear[1], tmonth[1], tday[1], thour[1], tminute[1], tsecond[1], 3); // -4 Дня
    		stamp2datetime(unixtime-86400*3, tyear[2], tmonth[2], tday[2], thour[2], tminute[2], tsecond[2], 3); // -3 Дня
    		stamp2datetime(unixtime-86400*2, tyear[3], tmonth[3], tday[3], thour[3], tminute[3], tsecond[3], 3); // -2 Дня
    		stamp2datetime(unixtime-86400, tyear[4], tmonth[4], tday[4], thour[4], tminute[4], tsecond[4], 3); // -1 День
    		stamp2datetime(unixtime, tyear[5], tmonth[5], tday[5], thour[5], tminute[5], tsecond[5], 3); // Сегодня
    		stamp2datetime(unixtime+86400, tyear[6], tmonth[6], tday[6], thour[6], tminute[6], tsecond[6], 3); // +1 День
    		stamp2datetime(unixtime+86400*2, tyear[7], tmonth[7], tday[7], thour[7], tminute[7], tsecond[7], 3); // +2 Дня
    		stamp2datetime(unixtime+86400*3, tyear[8], tmonth[8], tday[8], thour[8], tminute[8], tsecond[8], 3); // +3 Дня
    		stamp2datetime(unixtime+86400*4, tyear[9], tmonth[9], tday[9], thour[9], tminute[9], tsecond[9], 3); // +4 Дня
    		stamp2datetime(unixtime+86400*5, tyear[10], tmonth[10], tday[10], thour[10], tminute[10], tsecond[10], 3); // +5 Дней

    		SendClientMessage(playerid,COLOR_GREY,"[ Неактив ]: Выберите дату {99ff66}начала {cccccc}неактива");
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[0], tmonth[0], tyear[0]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[1], tmonth[1], tyear[1]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[2], tmonth[2], tyear[2]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[3], tmonth[3], tyear[3]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[4], tmonth[4], tyear[4]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d {ff9000}[Сегодня]\n", tday[5], tmonth[5], tyear[5]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[6], tmonth[6], tyear[6]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[7], tmonth[7], tyear[7]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[8], tmonth[8], tyear[8]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[9], tmonth[9], tyear[9]), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}%02d.%02d.%d\n", tday[10], tmonth[10], tyear[10]), strcat(sctring,str);
    		new qwer[84];
   			format(qwer,sizeof(qwer),"{cccccc}Неактив {ff9000}%s",str_name);
			ShowDialog(playerid,934,DIALOG_STYLE_LIST,qwer,sctring,"Выбрать","Отмена");
    	}
    	else
    	{
    	    new byear, bmonth, bday, bhour, bminute, bsecond, eyear, emonth, eday, ehour, eminute, esecond;
    		stamp2datetime(datad[0], byear, bmonth, bday, bhour, bminute, bsecond, 3);
    		stamp2datetime(datad[1], eyear, emonth, eday, ehour, eminute, esecond, 3);

    		format(str,sizeof(str),"{FF6347}Завершить Неактив\n"), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}Продлить неактив\n"), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}Начало: {ff9000}[ %02d.%02d.%d %02d:%02d ]\n", bday, bmonth, byear, bhour, bminute), strcat(sctring,str);
    		format(str,sizeof(str),"{cccccc}Конец: {ff9000}[ %02d.%02d.%d %02d:%02d ]\n", eday, emonth, eyear, ehour, eminute), strcat(sctring,str);
    		new qwer[84];
   			format(qwer,sizeof(qwer),"{cccccc}Неактив {ff9000}%s",str_name);
			ShowDialog(playerid,936,DIALOG_STYLE_LIST,qwer,sctring,"Выбрать","Отмена");
    	}
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
