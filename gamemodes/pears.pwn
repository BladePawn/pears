stock arcar(playerid, slot)
{
	new unix = gettime();
	if(unix > PlayerInfo[playerid][pRent][slot]) return pc_cmd_car(playerid);
	DP[1][playerid] = slot;
	new str[78],sctring[214],qwer[44],item = PlayerInfo[playerid][pRentItem][slot], b = PlayerInfo[playerid][pRentBiz][slot];

	format(str,sizeof(str),"{cccccc}Найти Транспорт \t "), strcat(sctring,str);
	if(b > 0)
 	{
		format(str,sizeof(str),"\n{99ff66}Продлить Аренду \t {99ff66}[%d$]",BizzInfo[b][bPrice][item]), strcat(sctring,str);
	}
	else format(str,sizeof(str),"\n{99ff66}Продлить Аренду \t {cccccc}[Бесплатно]"), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Отменить Аренду \t "), strcat(sctring,str);
	format(qwer,sizeof(qwer),"{ff9000}%s {cccccc}Арендованный",GetVehicleName(PlayerInfo[playerid][pRentModel][slot]));
	ShowDialog(playerid,715,DIALOG_STYLE_TABLIST,qwer,sctring,"Выбрать","Выход");
	return 1;
}
CMD:cvet(playerid, const params[])
{
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(fraction(playerid) >= 1 && Kapt[fraction(playerid)] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Меня могут убить свои, если я избавлюсь от банданы во время битвы");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить клист [ /cvet 0-100 ]");
	if(params[0] > 100 || params[0] < 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить клист [ /cvet 0-100 ]");
	new string[120];
 	SetPlayerColor(playerid,playerColors[params[0]]);
  	format(string, sizeof(string), "{0088ff}Вы изменили свой цвет на {FFFFFF}%d.", params[0]);
	SendClientMessage(playerid, COLOR_GREY, string);
   	return 1;
}
CMD:facepalm(playerid)
{
    if(GetPlayerSpeed(playerid) > 3) return 1;
    if(NoAnim[playerid] == 1)  return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
    SetPlayerChatBubble(playerid, "Facepalm", COLOR_PURPLE, 30.0, 10000);
    ApplyAnimation(playerid,"MISC","plyr_shkhead",4.0, false, false, false, false, false, SYNC_ALL);
    return 1;
}

// Антифлуд на использование анимаций (Можно пихать не только в /hi или /kiss)
// ВАЖНО! В конце функции или команды, всегда добавлять: Afanimation[playerid] = gettime() + 20;
// Посмотри примеры CMD:hi( или CMD:kiss(
stock AFloodAnimation(playerid)
{
	new unix = gettime();
	if(Afanimation[playerid] > unix)
	{
		new string[120];
		format(string,sizeof(string),"{ff6347}Вы не можете сейчас использовать анимацию\n{cccccc}Повторите попытку через %d секунд", Afanimation[playerid] - unix);
		ErrorMessage(playerid, string);
		return 1;
	}
	return 0;
}

CMD:kiss(playerid)
{
	if(AFloodAnimation(playerid)) return 1;

	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT 
		|| box[playerid] >= 1 
		|| PlayerInfo[playerid][pBkyrenie] >= 2 
		|| howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сейчас не могу..");
	if(NoAnim[playerid] == 1)  return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
	new giveplayerid = GetClosestPlayer(playerid);
	if(giveplayerid == -1) return ErrorMessage(playerid,"{ff6347}Рядом с вами никого нет");
	if(GetDistanceBetweenPlayers(playerid, giveplayerid) > 2) return ErrorMessage(playerid,"{ff6347}Рядом с вами никого нет");
	if(GetPVarInt(giveplayerid,"afksystem") >= 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу поцеловать спящего человека");

	TurnPlayerFaceToPlayer(playerid, giveplayerid);
	TurnPlayerFaceToPlayer(giveplayerid, playerid);
	ApplyAnimation(playerid,"BD_FIRE","GRLFRD_KISS_03",4.0, false, false, false, false, false);
	ApplyAnimation(giveplayerid,"BD_FIRE","PLAYA_KISS_03",4.0, false, false, false, false, false);
	
	InfectForInteraction(playerid, giveplayerid);
	Afanimation[playerid] = gettime() + 4;
	return 1;
}

stock InfectForInteraction(playerid, giveplayerid)
{
	if(PlayerInfo[giveplayerid][pColdCD] < gettime())
	{
		new stope;
		if(getillness(playerid, 14) >= 0) infect(giveplayerid, 14, 10), stope = 1;
		if(getillness(playerid, 15) >= 0 && stope == 0) infect(giveplayerid, 15, 10), stope = 1;
		if(getillness(playerid, 16) >= 0 && stope == 0) infect(giveplayerid, 16, 10), stope = 1;
		if(getillness(playerid, 17) >= 0 && stope == 0) infect(giveplayerid, 17, 10);
		
		new stope2;
		if(getillness(giveplayerid, 14) >= 0) infect(playerid, 14, 10), stope2 = 1;
		if(getillness(giveplayerid, 15) >= 0 && stope2 == 0) infect(playerid, 15, 10), stope2 = 1;
		if(getillness(giveplayerid, 16) >= 0 && stope2 == 0) infect(playerid, 16, 10), stope2 = 1;
		if(getillness(giveplayerid, 17) >= 0 && stope2 == 0) infect(playerid, 17, 10);
	}
	return true;
}

CMD:hi(playerid, const params[])
{
	if(AFloodAnimation(playerid)) return 1;

	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT 
		|| box[playerid] >= 1 
		|| PlayerInfo[playerid][pBkyrenie] >= 2 
		|| howstun(playerid)
		|| NoAnim[playerid] == 1) return ErrorMessage(playerid,"{ff6347}Вы не можете сейчас использовать анимацию\n{cccccc}Возможно активно какое-то действие или вашему персонажу плохо");

	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поздароваться [ /hi 1 - 7 ]");
	if(params[0] < 1 || params[0] > 7) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поздароваться [ /hi 1 - 7 ]");
	new giveplayerid = GetClosestPlayer(playerid);

	if(giveplayerid == -1) return ErrorMessage(playerid,"{ff6347}Рядом с вами никого нет");
	if(GetDistanceBetweenPlayers(playerid, giveplayerid) > 2) return ErrorMessage(playerid,"{ff6347}Рядом с вами никого нет");
	if(NoAnim[giveplayerid] == 1)
	{
		new string[90];
		format(string,sizeof(string),"{ff6347}%s не может сейчас с вами поздороваться",playername(giveplayerid));
		ErrorMessage(playerid, string);
		return 1;
	}

	TurnPlayerFaceToPlayer(playerid, giveplayerid);
	TurnPlayerFaceToPlayer(giveplayerid, playerid);
	if(params[0] == 1) ApplyAnimation(playerid,"GANGS","hndshkaa",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkaa",4.0, false, false, false, false, false, SYNC_ALL);
	else if(params[0] == 2) ApplyAnimation(playerid,"GANGS","hndshkfa",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkfa",4.0, false, false, false, false, false, SYNC_ALL);
	else if(params[0] == 3) ApplyAnimation(playerid,"GANGS","hndshkba",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkba",4.0, false, false, false, false, false, SYNC_ALL);
	else if(params[0] == 4) ApplyAnimation(playerid,"GANGS","hndshkda",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkda",4.0, false, false, false, false, false, SYNC_ALL);
	else if(params[0] == 5) ApplyAnimation(playerid,"GANGS","hndshkca",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkca",4.0, false, false, false, false, false, SYNC_ALL);
	else if(params[0] == 6) ApplyAnimation(playerid,"GANGS","hndshkcb",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkcb",4.0, false, false, false, false, false, SYNC_ALL);
	else if(params[0] == 7) ApplyAnimation(playerid,"GANGS","hndshkea",4.0, false, false, false, false, false, SYNC_ALL), ApplyAnimation(giveplayerid,"GANGS","hndshkea",4.0, false, false, false, false, false, SYNC_ALL);
	
	Afanimation[playerid] = gettime() + 4;
	return 1;
}
