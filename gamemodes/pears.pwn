			{
				MineWar_Enter(playerid);
			}
		}
		else if(IsPlayerInRangeOfPoint(playerid, 1.0, -29.342605, 1177.124389, 1311.204589)) // Выход (Заброшеная Шахта)
		{
			if (!MineWar_IsPlayerInGame(playerid)) {
				if (GetPlayerInterior(playerid) > 0)
				{
					MineWar_Exit(playerid);
				}
			} else MineWar_Dialog_Exit(playerid);
		}

		// Гробница Фараона
		if(IsPlayerInRangeOfPoint(playerid, 1.0, -1261.844482, 2490.184570, 87.0468)) // Вход (Гробница Фараона)
