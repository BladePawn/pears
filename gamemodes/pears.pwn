function Call_OfflineCriminal(playerid, const reason[], zv, uk, p)
{
	new rows;
	cache_get_row_count(rows);

	if (!rows) {
		if (IsOnline(playerid)) ErrorMessage(playerid, "{FF6347}Личное дело подозреваемого не найдено");
		return 1;
	}

	new string[256], jailed, suspectid, suspectname[MAX_PLAYER_NAME + 1];
	cache_get_value_name_int(0, "user_id", suspectid);
	cache_get_value_name(0, "Name", suspectname);
	cache_get_value_name_int(0, "Jailed", jailed);

	if (!IsOnline(playerid)) playerid = _:COP_TYPE_NONE;
    if(IsOnline(playerid) && jailed != 0) return ErrorMessage(playerid, "{FF6347}Подозреваемый уже находится в заключении");

    if(IsOnline(playerid))
    {
        if(CriminalCodeInfo[uk][p][ccLevel] == 0 && CriminalCodeInfo[uk][p][ccFine] == 0) {
            return ErrorMessage(playerid, "{FF6347}У заголовка статьи нет розыска или штрафа");
        }
    }

	// Выписываем штраф
	new slotFine = -1;
	if(CriminalCodeInfo[uk][p][ccFine] != 0)
	{
		for (new i = 0; i < MAX_CRIME_PLAYER; i++)
		{
			format(string, sizeof(string), "wanTicketCrime%d", i);
			
			new crime;
			cache_get_value_name_int(0, string, crime);

			if (crime == 0)
			{
				slotFine = i;
				break;
			}
		}
	}

	if (slotFine > -1) {
		mysql_format(pearsq, string, sizeof(string), 
			"UPDATE `pp_igroki` SET Ammo11 = Ammo11 + %d WHERE user_id = %d",

			CriminalCodeInfo[uk][p][ccFine],
			suspectid
		);
		query_empty(pearsq, string);

		mysql_format(pearsq, string, sizeof(string),
			"UPDATE `pp_wanted` SET " \
			"wanTicketCrime%d = %d," \
			"wanTicketSubentry%d = %d," \
			"wanTicketUnix%d = %d " \
			\
			"WHERE playerid = %d",

			slotFine, uk + 1,
			slotFine, p,
			slotFine, gettime(),
			suspectid
		);
		query_empty(pearsq, string);
	}

	new slotUk = -1;
	for (new i = 0; i < MAX_CRIME_PLAYER; i++)
	{
		format(string, sizeof(string), "wanCrime%d", i);
		
		new crime;
		cache_get_value_name_int(0, string, crime);

		if (crime == 0)
		{
			slotUk = i;
			break;
		}
	}
	if (slotUk < 0) {
		if (IsOnline(playerid)) ErrorMessage(playerid, "{FF6347}У преступника максимальное количество статей в личном деле [ /wanted ]");
		return 1;
	}

	// Выдаём розыск
	if(CriminalCodeInfo[uk][p][ccLevel] != 0)
	{
		{
			new copname[MAX_PLAYER_NAME + 1];
			if (IsOnline(playerid)) strcat(copname, PlayerInfo[playerid][pName]);

			mysql_format(pearsq, string, sizeof(string),
				"UPDATE `pp_wanted` SET " \
				"wanCrime%d = %d," \
				"wanSubentry%d = %d," \
				"wanPoliceId%d = %d," \
				"wanUnix%d = %d," \
				"WantedPolice%d = '%e' " \
				\
				"WHERE playerid = %d",

				slotUk, uk + 1,
				slotUk, p,
				slotUk, (IsOnline(playerid) ? PlayerInfo[playerid][pID] : 0),
				slotUk, gettime(),
				slotUk, copname,
				suspectid
			);
			query_empty(pearsq, string);

			mysql_format(pearsq, string, sizeof(string),
				"UPDATE `pp_igroki` SET Crimes = LEAST(Crimes + %d, 50) WHERE user_id = %d", 

				zv,
				suspectid
			);
			query_empty(pearsq, string);
		}

		// Сообщение по рации для полицейских
        foreach (Player, i)
        {
            if(OnlineInfo[i][oLogged] == 0
                || PlayerInfo[i][pBkyrenie] >= 2
                || PlayerInfo[i][pTransmitterOff][5] == true) continue;

            if(IsPoliceMember(i) || PlayerInfo[i][pFbi] >= 1)
            {
                if(IsOnline(playerid)) {
                    format(string, sizeof(string), "[DEP]: По заявлению %s[%d], %s обвиняется в %s. {FF6347}Ур. розыска: [%d]", PlayerInfo[playerid][pName], playerid, suspectname, reason, zv);
                } else {
                    format(string, sizeof(string), "[DEP]: По анонимному заявлению, %s обвиняется в %s. {FF6347}Ур. розыска: [%d]", suspectname, reason, zv);
                }
                SendClientMessage(i, COLOR_LIGHTNEUTRALBLUE, string);
            }
        }

        // Сообщение по радиоперехватчику
        {
            format(string, sizeof(string), "Объявление в розыск гражданина %s: %s [Уровень розыска: %d]", suspectname, reason, zv);
            RadioInterceptor_SendMessage(RADIO_INTERCEPTOR_STATE_SU, 0xFFDEADFF, string);
        }

        new fractionid = 1; // SAPD (по умолчанию)
        if (IsOnline(playerid)) fractionid = fraction(playerid);
        else {
            if (!strcmp(reason, "Проникновение")) fractionid = 3; // NGSA
        }
        
        // Логирование выдачи розыска
		new log_string[128]; 
        if(IsOnline(playerid)) {
			format(log_string, sizeof(log_string), "Выдача розыска [%s] (Offline)", CriminalCodeInfo[uk][p][ccName]);
            OrgLog(fractionid, "su", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], suspectid, suspectname, "", CriminalCodeInfo[uk][p][ccLevel], log_string);
        } else {
            format(log_string, sizeof(log_string), "Выдача розыска системой [%s] (Offline)", CriminalCodeInfo[uk][p][ccName]);
            OrgLog(fractionid, "su", 0, "", "", suspectid, suspectname, "", CriminalCodeInfo[uk][p][ccLevel], log_string);
        }
	}

	return 1;
}

forward Call_Offline(playerid, str_name[], result[], paramsi, zapas);
public Call_Offline(playerid, str_name[], result[], paramsi, zapas)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid, datad2, datad3, datad4, datad5, datad6, string[256], f_str[256], google;
		cache_get_value_name_int(0, "Leader", datad2);
		cache_get_value_name_int(0, "Vig", datad3);
		cache_get_value_name_int(0, "Soska", datad4);
		cache_get_value_name_int(0, "AdmWarns", datad5);
		cache_get_value_name_int(0, "Ammo5", datad6);
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Google", google);
		if(paramsi == 1)
		{
			if(datad2 == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не лидер");
			if(datad3 >= 4)
			{
				new datadran;
				cache_get_value_name_int(0, "Rank", datadran);

				format(string, sizeof(string), " [ ADM ]: Админ %s выдал лидерский выговор %s [ Снят с лидерки ]",PlayerInfo[playerid][pName],str_name);
				ABroadCast(COLOR_ADM,string,1);
				format(string, sizeof(string), "{ffffff}[ {ff0000}ADM {ffffff}] Игрок {0088ff}%s {ffffff}снят с поста лидера. Причина: 5 выговоров", str_name);
				SendClientMessage(playerid, COLOR_WHITE, string);
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Leader` = '0',`Member` = '%d',`Rank` = '%d',`Vig` = '0' WHERE `Name` = '%e'", datad2, datadran-1,str_name);
				query_empty(pearsq, f_str);
				AdminLog("leadvig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", datad2, result);
				AdminLog("makeleader", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", datad2, "Снят: 5 Lead Vig");
				format(string, sizeof(string), "Вы сняты с должности лидера %s (5 выговоров). Причина: %s", orgName[datad2], result);
				notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);

				UnmakeleaderPlayerBridge(datadid, datad2, datadran-1);
			}
			else
			{
				format(string, sizeof(string), " [ ADM ]: Админ %s выдал лидерский выговор %s",PlayerInfo[playerid][pName],str_name);
				ABroadCast(COLOR_ADM,string,1);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Лидер {0088ff}%s {ffffff}получил 1 выговор. Причина: %s", str_name, result);
				SendClientMessage(playerid, COLOR_WHITE, string);

				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Vig` = '%d' WHERE `Name` = '%e'",datad3+1,str_name);
