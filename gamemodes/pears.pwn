stock IsAGObjectInSquare(g, Float:x, Float:y)
{
	if(g == 0 && IsPosInSquare(x, y, 2433.2783,-1724.6754,2542.0247,-1627.1913)) { return 1; }
	if(g == 1 && IsPosInSquare(x, y, 2419.3572,-2047.9777,2542.7771,-1976.6738)) { return 1; }
	if(g == 2 && IsPosInSquare(x, y, 2218.0447,-1478.7389,2283.1250,-1389.4178)) { return 1; }
	if(g == 3 && IsPosInSquare(x, y, 1652.4912,-2159.0833,1816.8947,-2073.8132)) { return 1; }
    return 0;
}
stock IsAGObject(o)
{
	if(o == 2845 || o == 2846 || o == 2843 || o == 2675 || o == 2676 || o == 2677 || o == 2674 || o == 639 || o == 716 || o == 874 || o == 864 || o == 5153 || o == 19601
