        		if(GetPlayerSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу устанавливать точку для удара во время движения"), pc_cmd_boom(playerid);
				if(IsAAntidm(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя нанести удар ядерной боеголовкой по зелёной зоне"), pc_cmd_boom(playerid);
