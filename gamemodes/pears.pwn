	else if(IsPlayerInRangeOfPoint(playerid,2.0,957.8069,1450.8712,1029.3549) && GetPlayerVirtualWorld(playerid) == WORLD_CNN_1LVL && GetPlayerInterior(playerid) == INT_CNN_1LVL)
