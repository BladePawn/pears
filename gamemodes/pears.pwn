stock PlayerPersonalDeath(playerid, killerid, reason)
{
	if(killerid == INVALID_PLAYER_ID) SpecInfo(playerid, 3, 9999);

	// SendDeath Администрации
	foreach(Player,i)
	{
		if(GetPVarInt(i,"Readkill") == 1 && OnlineInfo[i][oLogged] == 1) SendDeathMessageToPlayer(i,killerid,playerid,reason);
	}

	// Падаем с высоты
	if(reason == 54)
	{
		if(MPGO[playerid] == 0 && gYda[playerid] != 2) Broke(playerid); // Ломаем Технику
	}
	return 1;
}

stock FruitPlayerDeath(playerid, killerid, reason, resultDeath)
{
	PlayerDeath[playerid] = 1;
	DeathInfo[playerid][deathKiller] = killerid;

	if(VehShopInfo[playerid][vsTest]) return 0; // Блокируем смерть в Test Drive

	// Взаимодействие с Убийцей
	if(killerid != INVALID_PLAYER_ID && killerid < MAX_REALPLAYERS)
	{
  		if(IsOnline(killerid))
  		{
  			SpecInfo(playerid, 2, killerid);
  			if(MPGO[playerid] == 0 && MPGO[killerid] == 0) // Не на мероприятии
  			{
      			if(box[killerid] == 0) PlayerInfo[killerid][pKills] ++;
  			 	SendDeath(killerid, playerid, reason);

  			 	// Убийство Контракт
  			 	if(PlayerInfo[killerid][pMember] == 8)
  			 	{
	  			 	if(gHitMoney[playerid] >= 1 && gJerID[killerid] == playerid)
		   			{
		   				new string[144];
		   				if(PlayerInfo[killerid][pMember] == 8 || PlayerInfo[killerid][pLeader] == 8)
	    				{
							paysalary(killerid, gHitMoney[playerid], 1);
							MoneyLog("goc", PlayerInfo[killerid][pID], PlayerInfo[killerid][pName], PlayerInfo[killerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], gHitMoney[playerid], "Контракт Хит");
							format(string,sizeof(string),"{FF0000}<< {0088ff}Агент № %d выполнил контракт на %s, и получил {00BC12}%d$ {FF0000}>>",PlayerInfo[killerid][pID],PlayerInfo[playerid][pName],gHitMoney[playerid]);
				            SendRadioMessage(8, COLOR_GREY, string);
				            SendClientMessage(killerid, COLOR_GREY, "{0088ff}[Агентство]: {FFFFFF}Деньги перечислены на ваш банковский счёт");
				            SendClientMessage(playerid, COLOR_GREY, "{0088ff}[Незнакомец]: {FFFFFF}Ничего личного, это просто моя работа");
				            if(PlayerInfo[playerid][pAchieve][105] == 0) AchievePlayer(playerid, 105, 1);
	    				}
	    				gJerID[killerid] = 9999;
	    				gHitMoney[playerid] = 0, gHitID[playerid] = 9999, PlayerInfo[playerid][pTeam] = gettime()+3600;
		   			}
				}

				// Mafia War
				if(resultDeath == 0) // Только если умерли полностью
				{
  					if(IsMafiaMember(playerid) && gMifga[playerid] != 9999 && IsMafiaMember(killerid) && gMifga[killerid] != 9999) CheckMafKill(playerid, killerid, 0);
				}

				// Mafia War (Farm)
				if(resultDeath == 0)
				{
					new farmid = NarcoFarmGetNearest(playerid);
					if(farmid != INVALID_NARCOFARM_ID && NarcoFarmGetNearest(killerid) != INVALID_NARCOFARM_ID)
					{
						if (farmid == NarcoFarmGetNearest(killerid))
						{
							if (NarcoFarmIsBattleActive(farmid))
							{
								CheckMafFarmKill(playerid, killerid);
							}
						}
					}
				}

  				// Gang Zone
  				if(IsGangMember(playerid) && YjeSdoh[playerid] == 0 && Kapt[fraction(playerid)] >= 1) CheckGangKill(playerid, killerid);
    		}
  		}
	}

	if(resultDeath == 0)
	{
		// SendDeath Администрации
		foreach(Player,i)
		{
			if(GetPVarInt(i,"Readkill") == 1 && OnlineInfo[i][oLogged] == 1) SendDeathMessageToPlayer(i,killerid,playerid,reason);
		}
	}
	return 1;
}

// Может ли предмет разрушиться (при падении игрока)
stock IsThingCanBroke(thingId, thingType, thingPack) {
	if (thingType != 0 || thingPack != 0) return 0;
	return (thingId == 21 || thingId == 32 || thingId == 42 || thingId == 43 || thingId == 231 || thingId == 232);
}

stock Broke(p)
{
	if (PlayerInfo[p][pSoska] > 0 || PlayerInfo[p][pHidden]) return 0; // Если администратор - ничего не делаем
	if (random(2) != 0) return 0; // Если предмет не сломался (50/50) - ничего не делаем

	const MAX_BROKEN_ITEMS = 50;
	new teh[MAX_BROKEN_ITEMS] = {-1, ...},
		mteh[MAX_BROKEN_ITEMS] = {-1, ...},
		count = 0, mcount = 0;

	for(new inva = 0; inva < 40; inva++)
	{
		new thingId = PlayerInfo[p][pInven][inva],
			thingType = PlayerInfo[p][pInvenType][inva],
			thingPack = PlayerInfo[p][pInvenPack][inva];
		if (PlayerInfo[p][pInvenPara][inva] == 0 && IsThingCanBroke(thingId, thingType, thingPack))
		{
			for (new i = 0; i < sizeof(teh); i++) {
				if (teh[i] == -1) {
					teh[i] = inva;
					count++;
					break;
				}
			}
		}
	}

	// Если в основных слотах ничего не найдено - ищем в слотах лавки
	if (count == 0) {
		for (new inva = 0; inva < 20; inva++) {
			new thingId = PlayerInfo[p][pMarkInven][inva],
				thingType = PlayerInfo[p][pMarkInvenType][inva],
				thingPack = PlayerInfo[p][pMarkInvenPack][inva];
			if (PlayerInfo[p][pMarkInvenPara] == 0 && IsThingCanBroke(thingId, thingType, thingPack)) {
				for (new i = 0; i < sizeof(mteh); i++) {
					if (mteh[i] == -1) {
						mteh[i] = inva;
						mcount++;
						break;
					}
				}
			}
		}
	}

	// Ломаем рандомную технику (если нашли - из основного слота, если не нашли - из слота торговли)
	if (count > 0) {
		PlayerInfo[p][pInvenPara][teh[random(count)]] = 1;
	} else if (mcount > 0) {
		PlayerInfo[p][pMarkInvenPara][mteh[random(mcount)]] = 1;
	} else return 0;

	if(PlayerInfo[p][pAchieve][85] == 0) AchievePlayer(p, 85, 1);
	
	return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, WEAPON:weaponid, bodypart)
{
	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	if(IsPlayerNPC(playerid)) return 1;

	if(issuerid != INVALID_PLAYER_ID) // Если тот кто понижает нам хп - существует
	{
		if(IsOnline(issuerid))
		{
			if(GetPlayerLoadPet(playerid) > 0)
			{
				for(new pet = 0; pet < MAX_PETS_AT_PLAYER; pet++)
				{
					if(OnlineInfo[playerid][oPet][pet] == -1) continue;
					PetTaskAttac(OnlineInfo[playerid][oPet][pet],issuerid);
				}
			}
			if(weaponid == WEAPON:3 || weaponid == WEAPON:5) // Полицейская Дубинка или Бита
			{
				if(ProxDetectorS(10.0, issuerid, playerid) && !IsPlayerInAnyVehicle(playerid) && Stun[3][playerid] == 0 && MPGO[issuerid] == 0 && !IsAAntidm(issuerid)
				&& Kapt[fraction(issuerid)] == 0 && !howstun(issuerid) && GetPVarInt(playerid,"afksystem") < 3 && !howstun(playerid)
				&& !DeathInfo[playerid][deathStatus])
				{
					new current_tick = GetTickCount();
					new interval = GetTickDiff(current_tick, Aftextdraw[issuerid]);
					if(interval > 1000)
					{
						PoliceStick[0][playerid] ++;
						if(PoliceStick[0][playerid] >= 3) kicked(playerid, issuerid);
						Aftextdraw[issuerid] = current_tick;
					}
				}
			}
		}
	}
	return 1;
}
stock kicked(playerid, issuerid)
{
    new string[144];
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);

	if(PlayerInfo[issuerid][pSex] == 1)
	{
		format(string, sizeof(string), "сбил с ног %s, ударом по голове", playername(playerid));
		SetPlayerChatBubble(issuerid,string,COLOR_PURPLE,20.0,5000);
		format(string, sizeof(string), "* %s сбил с ног %s, ударом по голове", playername(issuerid), playername(playerid));
		ProxDetector(20.0, issuerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	else
	{
		format(string, sizeof(string), "сбила с ног %s, ударом по голове", playername(playerid));
		SetPlayerChatBubble(issuerid,string,COLOR_PURPLE,20.0,5000);
		format(string, sizeof(string), "* %s сбила с ног %s, ударом по голове", playername(issuerid), playername(playerid));
		ProxDetector(20.0, issuerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}

	new timeKnock = 25; // Время оглушения в секундах
	
	if(GetPlayerLoadPet(playerid) > 0)
	{
		for(new pet = 0; pet < MAX_PETS_AT_PLAYER; pet++)
		{
			if(OnlineInfo[playerid][oPet][pet] == -1) continue;
			if(PetSkillHandler(OnlineInfo[playerid][oPet][pet], 4)) 
			{
				timeKnock *= PetsFeaturesSetting[4][1]/100;
				break;
			}
		}
	}
	

	Stun[3][playerid] = 1;
	StunTime[3][playerid] = timeKnock;
	format(string, sizeof(string), "оглушён [%d]", StunTime[3][playerid]), SetPlayerChatBubble(playerid,string, COLOR_LIGHTRED,20.0,1500);
	if(IsPoliceMember(issuerid)) CuffedId[playerid] = issuerid;
	NoAnim[playerid] = 1;
	TogglePlayerControllable(playerid, false);
	ApplyAnimation(playerid,"CRACK","crckdeth2",4.0, false, true, true, true, true, SYNC_ALL);
	PoliceStick[0][playerid] = 0;

	new stro[104],sctringo[234];
	format(stro,sizeof(stro),"{FF6347}%s {cccccc}оглушил вас ударом по голове на %d секунд", playername(issuerid), timeKnock), strcat(sctringo,stro);

	new yesgang, yesmaf, yescity, yesghetto, dropid, unix = gettime(), nounix;
	if(IsGangMember(issuerid)) yesgang = 1;
	if(IsMafiaMember(issuerid)) yesmaf = 1;
	if(IsACity(issuerid)) yescity = 1;
	if(IsAGhetto(issuerid)) yesghetto = 1;
	if(PlayerInfo[playerid][pArob] > unix) nounix = 1;

	if((yesgang == 1 || yesmaf == 1) && (yescity == 0 || yesghetto == 1) && nounix == 0)
	{
 		new fpick, thingType, thingPack;
 		dropid = dropped(playerid, unix, fpick, thingType, thingPack);
		if(fpick > 0) format(stro,sizeof(stro),"\n{ffcc66}Из ваших карманов выпал предмет: {FF6347}%s", GetNameThing(0, fpick, thingType, thingPack)), strcat(sctringo,stro);
	}
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ffcc00}*",sctringo,"*","");

	new stra[104],sctringa[234];
	format(stra,sizeof(stra),"{cccccc}Вы оглушили {FF6347}%s {cccccc}ударом по голове на %d секунд", playername(playerid), timeKnock), strcat(sctringa,stra);
    if(dropid == 1) format(stra,sizeof(stra),"\n\n{99ff66}Из его карманов выпал предмет {cccccc}[ Вы можете забрать предмет - Это ограбление ]"), strcat(sctringa,stra), CompleteBattlePassTask(issuerid, 15, 1);
    else
    {
		if(yesgang == 0 && yesmaf == 0) format(stra,sizeof(stra),"\n\n{FF6347}Из его карманов ничего не выпало [ Вы не состоите в банде или мафии ]"), strcat(sctringa,stra);
		else if(yescity == 1 && yesghetto == 0) format(stra,sizeof(stra),"\n\n{FF6347}Из его карманов ничего не выпало [ Вы находитесь в городе ]"), strcat(sctringa,stra);
		else if(nounix == 1) format(stra,sizeof(stra),"\n\n{FF6347}Из его карманов ничего не выпало [ Его уже ограбили меньше 1-го часа назад ]"), strcat(sctringa,stra);
	}
	ShowDialog(issuerid,1742,DIALOG_STYLE_MSGBOX,"{ffcc00}*",sctringa,"*","");
	
	if(PlayerInfo[issuerid][pAchieve][96] == 0) AchievePlayer(issuerid, 96, 1);
	return 1;
}
stock dropped(playerid, unix, &fpick, &thingType, &thingPack)
{
    new inven[MAX_INVEN], mark[20], quaninv, quanmark, dropinven, dropmark, yes;

	// Инвентарь
    for(new i = 0; i < MAX_INVEN; i++)
	{
        if(is_a_yesdrop(PlayerInfo[playerid][pInven][i], PlayerInfo[playerid][pInvenType][i])) inven[quaninv] = i+1, quaninv ++;
        if(i < 20) // Мои Товары
	    {
	    	if(is_a_yesdrop(PlayerInfo[playerid][pMarkInven][i], PlayerInfo[playerid][pMarkInvenType][i])) mark[quanmark] = i+1, quanmark ++;
	    }
    }

	// Выбираем предмет из доступных и роняем на землю (инвентарь)
    if(quaninv > 0)
	{
		dropinven = inven[random(quaninv)]-1;
		if(dropinven >= 0)
		{
			fpick = PlayerInfo[playerid][pInven][dropinven];
			thingType = PlayerInfo[playerid][pInvenType][dropinven];
			if(thingType != 2) return yes;
			thingPack = PlayerInfo[playerid][pInvenPack][dropinven];
			PlayerInfo[playerid][pInvenQara][dropinven] = PlayerInfo[playerid][pID];
			Throw(playerid, fpick, PlayerInfo[playerid][pInvenQuan][dropinven], PlayerInfo[playerid][pInvenPara][dropinven], PlayerInfo[playerid][pInvenQara][dropinven], PlayerInfo[playerid][pInvenType][dropinven], PlayerInfo[playerid][pInvenPack][dropinven]);
			i_del(playerid, dropinven);
			if(thingType == 0) i_takehands(playerid, fpick);
			yes = 1;
		}
	}

	// Выбираем предмет из доступных и роняем на землю (мои товары)
	if(quanmark && yes == 0)
	{
	    dropmark = inven[random(quanmark)]-1;
		if(dropmark >= 0)
		{
			fpick = PlayerInfo[playerid][pMarkInven][dropmark];
			thingType = PlayerInfo[playerid][pMarkInvenType][dropmark];
			if(thingType != 2) return yes;
			thingPack = PlayerInfo[playerid][pMarkInvenPack][dropmark];
			PlayerInfo[playerid][pMarkInvenQara][dropmark] = PlayerInfo[playerid][pID];
			Throw(playerid, fpick, PlayerInfo[playerid][pMarkInvenQuan][dropmark], PlayerInfo[playerid][pMarkInvenPara][dropmark], PlayerInfo[playerid][pMarkInvenQara][dropmark], thingType, thingPack);
			ClearMyGoods(playerid, dropmark);
			PlayerInfo[playerid][pM_Update][dropmark] = true;
			item_second(playerid, 0, 0, dropmark, 1, 0, 0, 0, 0);
			yes = 1;
		}
	}
	if(yes == 1) PlayerInfo[playerid][pArob] = unix+3600, mysql_save(playerid, 68);
    return yes;
}
stock is_a_yesdrop(fpick, thingType)
{
	if(fpick == 0) return 0; // Предмет отсутствует
	if(NotGiveThing(fpick, thingType, 0)) return 0; // Запрет предметы

    if(thingType == 0)
	{
	    if(fpick == 9 || fpick == 10 || fpick == 11 || fpick == 12 || fpick == 43 || fpick == 48 || fpick == 51 || fpick == 61 || fpick == 63
		|| fpick >= 156 && fpick <= 162) return 0; // Запрет предметы
	    else return 1; // Все остальные можно
	}
	if(thingType == 1) // Оружие
	{
	    if(fpick == 34) return 0; // Снапу нельзя дропать
	    else return 1;
	}
	if(thingType == 2 && !IsABackPack(fpick)) return 1; // Аксессуары
	if(thingType == 3) return 1; // Одежда
	if(thingType == 4) return 1; // Мебель
	return 0;
}
stock DamagePlayerLog(playerid, shotid, weaponid, stat)
{
	for(new g = 199; g > 0; g--)
	{
		DamageLog[g][playerid] = DamageLog[g-1][playerid];
		DamageUnix[g][playerid] = DamageUnix[g-1][playerid];
		DamageStat[g][playerid] = DamageStat[g-1][playerid];
		DamageType[g][playerid] = DamageType[g-1][playerid];
		DamageWeapon[g][playerid] = DamageWeapon[g-1][playerid];
	}
	DamageLog[0][playerid] = shotid;
	DamageUnix[0][playerid] = gettime();
	DamageStat[0][playerid] = PlayerInfo[shotid][pID];
	DamageType[0][playerid] = stat; // 1 - Дамаг Персонажа, 2 - Дамаг Транспорта
	DamageWeapon[0][playerid] = weaponid; // Способ Дамага
	return 1;
}
stock IsADeathMatch(playerid, damagedid, stat)
{
	new nodm;
	if(MPGO[playerid] == 0 && MPGO[damagedid] == 0 && box[playerid] == 0 && box[damagedid] == 0)
	{
		if(ADUTY[damagedid] == 1) nodm = 1; // По админу на дежурстве
	    if(gJerID[damagedid] == playerid && gHitMoney[playerid] >= 1) nodm = 1; // Заказан хитом
		if(!IsPoliceMember(playerid) && IsPoliceMember(damagedid)) nodm = 1; // В законника
		if(IsPoliceMember(playerid) && !IsPoliceMember(damagedid) && PlayerInfo[damagedid][pCrimes] >= 1) nodm = 1; // В преступника
		if(fraction(playerid) >= 1 && fraction(damagedid) >= 1)
		{
			if(Kapt[fraction(playerid)] >= 1 && Kapt[fraction(damagedid)] >= 1) nodm = 1; // На капте
			for(new fr = 0; fr < 5; fr++)
			{
				if(orgwar[fraction(playerid)][fr] == fraction(damagedid)) nodm = 1; // Война
			}
		}
		if(IsMafiaMember(playerid) && gMifga[playerid] != 9999 && IsMafiaMember(damagedid) && gMifga[damagedid] != 9999) nodm = 1; // Мафиозная стрела
		if(IsPoliceMember(playerid) && fraction(damagedid) >= 1 && Zach[fraction(damagedid)] == 1) nodm = 1; // Законник по зачищаемым
		if(fraction(damagedid) >= 1 && Zach[fraction(damagedid)] == 1 && IsPoliceMember(playerid)) nodm = 1; // Зачищаемые по законникам
		if(GetPVarInt(damagedid,"afksystem") >= 3) nodm = 1; // Чел в афк стоит
		if(nodm == 0)
		{
			if(GetPVarInt(playerid,"antifloodcheat") == 0)
			{
			    new string[124];
				foreach (Player, i)
				{
					if(PlayerInfo[i][pSoska] >= 1 && GetPVarInt(i,"Readdm") == 1 && OnlineInfo[i][oLogged] == 1)
					{
						if(stat == 1) format(string, sizeof(string), "              {cccccc}%s[%d] {ffcc33}DM по {cccccc}%s[%d]", PlayerInfo[playerid][pName],playerid, PlayerInfo[damagedid][pName],damagedid);
						else if(stat == 2) format(string, sizeof(string), "              {cccccc}%s[%d] {ffcc33}DB по {cccccc}%s[%d]", PlayerInfo[playerid][pName],playerid, PlayerInfo[damagedid][pName],damagedid);
						SendClientMessage(i, COLOR_GREY, string);
					}
				}
				SetPVarInt(playerid,"antifloodcheat",3);
			}
			return 1;
		}
	}
	return 0;
}

public OnPlayerGiveDamage(playerid, damagedid, Float: amount, WEAPON: weaponid, bodypart)
{
	if(OnlineInfo[playerid][oLogged] == 0) return false;
	if(IsPlayerNPC(damagedid)) return false;
	if(OnlineInfo[damagedid][oAdminGM]) return false; // Admin GM
	if(PlayerInfo[damagedid][pJailed] == 2) return false; // В деморгане
	if(playerid == damagedid && weaponid == WEAPON: 51) return false; // во время взрывов игрок кидает урон на самого себя, баг сампа

	// Блокируем урон при фейк afk
	if(IsPlayerAfk(playerid))
	{
		AnticheatInfo[playerid][achFakeafk] ++;
		if(AnticheatInfo[playerid][achFakeafk] >= 3)
		{
			AnticheatInfo[playerid][achFakeafk] = 0;
			printf("[SProtect Kick]: FakeAFK Damage %s", PlayerInfo[playerid][pName]);
            SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [FakeAFK Damage]");
            ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [FakeAFK Damage]","*","");
            Kickx(playerid);
		}
		return false;
	}
	AnticheatInfo[playerid][achFakeafk] = 0;

	// Игра зомби
	if(damagedid != INVALID_PLAYER_ID)
	{
		if(IsOnline(damagedid) && ZombieGameStatus == 1) ZombieGameDamage(playerid, damagedid, weaponid);
	}
	
	// Обработка нанесения урона игрокам
	PlayerGiveDamageHandler(playerid, damagedid, amount, weaponid, bodypart);

    new string[164];
	if(damagedid != INVALID_PLAYER_ID)
	{
		if(IsOnline(damagedid))
     	{
			if(GetPlayerLoadPet(playerid) > 0)
			{
				for(new pet = 0; pet < MAX_PETS_AT_PLAYER; pet++)
				{
					if(OnlineInfo[playerid][oPet][pet] == -1) continue;
					PetTaskAttac(OnlineInfo[playerid][oPet][pet],damagedid);
				}
			}
			if(OnlineInfo[damagedid][oLogged] == 1)
			{
				// Античит от дамага не стреляющим оружием на дистанции
				AnticheatDistanceDamage(playerid, damagedid, weaponid);

				// Anti DM System
			    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && MPGO[playerid] == 0 && PlayerInfo[playerid][pSoska] == 0)
				{
				    new v = GetPlayerVehicleID(playerid);
				    if(VehInfo[v][vModel] != 520 && VehInfo[v][vModel] != 425 && VehInfo[v][vModel] != 432 && VehInfo[v][vModel] != 447 && VehInfo[v][vModel] != 430 && VehInfo[v][vModel] != 476 && VehInfo[v][vModel] != 464)
					{
					    ACSetPlayerHealth(damagedid, HealthAC[damagedid]);
  					 	if(GetPVarInt(playerid,"antifloodcheat") <= 1 && GetPVarInt(damagedid,"afksystem") <= 3 && YjeSdoh[damagedid] == 0 && !IsAVello(v) && !IsAPlane(v) && !IsABoat(v))
     			 		{
     			 		    SetPVarInt(playerid,"antifloodcheat",3);
     			 		    PlayerInfo[playerid][pDriveby] ++;
     			 		    SetPlayerChatBubble(playerid,"Нарушение Правил: {ff0000}DriveBy",COLOR_LIGHTRED,25.0,7000);
     			 		    format(string, sizeof(string), " [ ADM ]: %s[%d] нанёс урон транспортом %s[%d] {ff0000}[ Drive By ]", PlayerInfo[playerid][pName],playerid, PlayerInfo[damagedid][pName],damagedid);
		     				ABroadCast(COLOR_ADM,string,1);
		     				if(PlayerInfo[playerid][pDriveby] >= 20)
		     				{
		     				    if(get_lic(playerid, 156) >= 0)
		     				    {
		     				        DelInvent3(playerid,156);
		     						format(string, sizeof(string), "{FF6347}Вы нанесли дамаг игроку с помощью транспорта [ DrivBy ]\n\n{ff9000}%d/20 - Лишение водительских прав", PlayerInfo[playerid][pDriveby]);
		     						ErrorMessage(playerid, string);
		     						PlayerInfo[playerid][pDriveby] = 0;
		     						mysql_save(playerid, 71);

									new string_mysql[120];
		     						mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", PlayerInfo[playerid][pID], 34);
      								mysql_tquery(pearsq, string_mysql, "in_blacklist", "dsdddsdd", -1, PlayerInfo[playerid][pName], playerid, 14, 0, "DriveBy", 34, 1);
     							}
								else PlayerInfo[playerid][pDriveby] = 0;
	     					}
	     					else
				 			{
				 			    format(string, sizeof(string), "{FF6347}Вы нанесли дамаг игроку с помощью транспорта [ DrivBy ]\n\n{cccccc}%d/20 - после накопления, система лишит вас водительских прав", PlayerInfo[playerid][pDriveby]);
		     					ErrorMessage(playerid, string);
	     					}
     			 		}
					}
				}
			
				if(ProxDetectorS(100.0, playerid, damagedid) && (HealthAC[damagedid] >= 0.1 || PlayerInfo[damagedid][pArmor] >= 0.1))
				{
					if(IsADeathMatch(playerid, damagedid, 1))
					{
						DamagePlayerLog(damagedid, playerid, weaponid, 1);
					}
				}
				
				// Анти ДМ (ЗЗ)
				if(IsAAntidm(damagedid))
     			{
     				if(weaponid != WEAPON:23 && OnDuty[playerid] == 0)
     				{
      					ShowDialog(playerid,78,DIALOG_STYLE_MSGBOX,"{FF0000}Анти ДМ: предупреждение","{FFFFFF}* Игрок находится в {FF0000}зелёной зоне","Ок","");
        				ClearAnim(playerid);
        				return 0;
       				}
     			}
				new Float:health = HealthAC[damagedid];
				//new Float:armour = PlayerInfo[damagedid][pArmor];

				// Anti Spawn Kill
				if(ASK[damagedid] >= 1 && MPGO[damagedid] == 0 && gHitMoney[damagedid] == 0 && PlayerInfo[damagedid][pSoska] == 0) // ANTI SPAWN KILL
				{
					ACSetPlayerHealth(damagedid, HealthAC[damagedid]);
					SetPlayerChatBubble(damagedid,"ANTI Spawn Kill System",COLOR_GREEN,25.0,8000);
					ClearAnim(playerid);
					ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}Этот игрок под защитой Anti Spawn Kill System\n\n{cccccc}Он только, что заспавнился. Его нельзя сейчас убить!","Oк","");
					return 1;
				}

				// Ринг
				if(box[playerid] >= 1 && damagedid == boxid[playerid] && playerid == boxid[damagedid])
        		{
        			if(RingInfo[ringid[playerid]][rStat] <= 2) 
					{
						StopRing(ringid[playerid]);
						ErrorMessage(playerid, "{FF6347}Бой отменён из-за того, что вы ударили противника раньше времени");
					}
        			else if(RingInfo[ringid[playerid]][rStat]==3)
          	  		{
     	  				if(GetPlayerWeapon(playerid) >= WEAPON:2)
						{
							StopRing(ringid[playerid]);
							ErrorMessage(playerid, "{FF6347}Бой отменён из-за того, что вы ударили противника оружием");
						}
     	  				if(health <= 30.0)
       	  	 			{
               				GameTextForPlayer(damagedid,"~n~~n~~n~~n~~n~~n~~n~~n~~r~YOU LOSE",3000,3);
		                 	if(ringid[damagedid] <= 6)
		                 	{
							     RingInfo[ringid[damagedid]][rTimer]=0;
				        	     RingInfo[ringid[damagedid]][rStat]=0;
				        	     switch(ringid[damagedid])
								 {
				 					case 0: UpdateDynamic3DTextLabelText(RingText[ringid[damagedid]],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {00cc00}Grove Street {cccccc}[ ALT ]");
				    				case 1: UpdateDynamic3DTextLabelText(RingText[ringid[damagedid]],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {9900cc}Ballas Gang {cccccc}[ ALT ]");
				    				case 2: UpdateDynamic3DTextLabelText(RingText[ringid[damagedid]],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {ffcc33}Vagos Gang {cccccc}[ ALT ]");
				    				case 3: UpdateDynamic3DTextLabelText(RingText[ringid[damagedid]],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {00ffff}Los Aztecas {cccccc}[ ALT ]");
				    				case 4: UpdateDynamic3DTextLabelText(RingText[ringid[damagedid]],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {ff9000}MMA {cccccc}[ ALT ]");
				    				case 5: UpdateDynamic3DTextLabelText(RingText[ringid[damagedid]],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {ff9000}Тюрьма {cccccc}[ ALT ]");
								 }
	 	 					}
				         	update_power(playerid, 10);
				         	fatigue(playerid, 10);
				         	update_power(damagedid, 5);
				         	fatigue(damagedid, 20);
				         	oGivePlayerMoney(playerid, RingInfo[ringid[playerid]][rStatlave]); // Выдаём лаве
				         	MoneyLog("ring", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[damagedid][pID], PlayerInfo[damagedid][pName], PlayerInfo[damagedid][pPlaIP], RingInfo[ringid[playerid]][rStatlave], "Победил на Ринге");
				   	     	boxid[playerid]=9999;
				   	     	boxid[damagedid]=9999;
				   	     	box[damagedid] = 0;
				   	     	box[playerid]=0;
				   	     	ACSetPlayerHealth(playerid, GetMaxPlayerHealth(playerid));
				   	     	ACSetPlayerHealth(damagedid, GetMaxPlayerHealth(damagedid));
				   	     	PlayerPlaySound(playerid,17802,0,0,0);
				         	PlayerPlaySound(damagedid,17802,0,0,0);
				         	SetCameraBehindPlayer(damagedid);
				         	switch(ringid[damagedid])
						 	{
								case 0: {PPSetPlayerPos(damagedid, 2521.5925,-1695.1321,13.5004);PPSetPlayerFacingAngle(damagedid, 358.9003);}
								case 1: {PPSetPlayerPos(damagedid, 2507.9270,-1990.1370,13.5540);PPSetPlayerFacingAngle(damagedid, 96.2605);}
								case 2: {PPSetPlayerPos(damagedid, 2247.0574,-1456.7443,24.0029);PPSetPlayerFacingAngle(damagedid, 2.1147);}
								case 3: {PPSetPlayerPos(damagedid, 1712.9120,-2092.1843,13.5469);PPSetPlayerFacingAngle(damagedid, 183.8263);}
								case 4:
								{
									PPSetPlayerPos(damagedid, -1395.8237,96.5140,2044.1777);PPSetPlayerFacingAngle(damagedid, 90.8897);
									PPSetPlayerPos(playerid, -1367.4558,96.3671,2044.1429);PPSetPlayerFacingAngle(playerid, 271.0581);
								}
								case 5: {PPSetPlayerPos(damagedid, 1002.9324,2439.8857,10.8716);PPSetPlayerFacingAngle(damagedid, 270.7018);}
						 	}
      	 				}
          	  		}
        		}

			    // Удар Электрошокером из Руки
        		if(weaponid == WEAPON:0 && Hold[playerid] == 5 && GetPVarInt(playerid, "HideTazer") >= 2 && MPGO[playerid] == 0)
			    {
		    		if(ProxDetectorS(5.0, playerid, damagedid) && !IsPlayerInAnyVehicle(damagedid) && Stun[3][damagedid] == 0)
	    			{
	    				PlayerPlaySound(playerid, 6003, 0.0, 0.0, 0.0);
	    				format(string, sizeof(string), "* %s ударил электрошоком %s, и парализовал.", playername(playerid) ,playername(damagedid));
	   					ProxDetector(30.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	   					tazerplayer(playerid, damagedid);
 		 				SetPVarInt(playerid,"HideTazer",GetPVarInt(playerid,"HideTazer")-1);
					  	TakeInvent(playerid, 43, 1, 0, 999, false);
 		 				format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~Tazer: ~w~%d/10",GetPVarInt(playerid, "HideTazer")-1);
						GameTextForPlayer(playerid,string,5000,3);
						
 		 				if(GetPVarInt(playerid, "HideTazer") <= 1) i_takehands(playerid, 43);
	    			}
			    }

			    if(weaponid >= WEAPON:24 && weaponid <= WEAPON:34 || weaponid == WEAPON:38)
        		{
        			new atext[24], yeshit = 0;
        			switch(bodypart)
           			{
           				  case 3: atext = "торс", yeshit = 1;
              			  case 4: atext = "пах", yeshit = 1;
              			  case 5: atext = "левую руку", yeshit = 1;
              			  case 6: atext = "правую руку", yeshit = 1;
              			  case 7: atext = "левую ногу", yeshit = 1;
              			  case 8: atext = "правую ногу", yeshit = 1;
           				  case 9: atext = "голову", yeshit = 1;
			              default: { }
           			}
           			if(yeshit == 1)
		            {
			           foreach (Player, i)
			           {
			           		if(PlayerInfo[i][pSoska] >= 1 && OnlineInfo[i][oLogged] == 1 && GetPVarInt(i,"Readhit") == 1)
							{
								new readHitTarget = GetPVarInt(i,"ReadhitTarget");
								if (readHitTarget == -1 || readHitTarget == damagedid || readHitTarget == playerid)
								{
									format(string, sizeof(string), "              {cccccc}%s[%d] {ffcc33}попал в %s игроку {cccccc}%s[%d]", PlayerInfo[playerid][pName],playerid, atext, PlayerInfo[damagedid][pName],damagedid);
									SendClientMessage(i, COLOR_WHITE, string);
								}
							}
			   		   }
		   		    }
        		}
			}
		}
	}
	return 1;
}
stock CaptTakeHealth(playerid, damagedid, Float:hp)
{
	new org = fraction(playerid);
	new toorg = fraction(damagedid);
	if(CaptInfo[cAttack] == org && CaptInfo[cDefend] == toorg)
	{
		CaptInfo[cLogHealthA] += floatround(hp, floatround_round);
		PlayerInfo[playerid][pGangTemp][4] += floatround(hp, floatround_round); // Нанесено урона
		PlayerInfo[damagedid][pGangTemp][5] += floatround(hp, floatround_round); // Потеряно урона
	}
	if(CaptInfo[cDefend] == org && CaptInfo[cAttack] == toorg)
	{
		CaptInfo[cLogHealthD] += floatround(hp, floatround_round);
		PlayerInfo[playerid][pGangTemp][4] += floatround(hp, floatround_round); // Нанесено урона
		PlayerInfo[damagedid][pGangTemp][5] += floatround(hp, floatround_round); // Потеряно урона
	}
	return 1;
}
public OnVehicleMod(playerid,vehicleid, componentid)
{
	if(CallPublic(playerid, 11)) return false;

	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347} Система не позволяет устанавливать здесь тюнинг! [Code: 1014]");
		RemoveVehicleComponent(vehicleid,componentid);
		Kickx(playerid);
		return 0;
	}
	return 1;
}
stock UpdateGps(playerid)
{
	new Float:dist, string[44];
	dist = GetPlayerDistanceFromPoint(playerid, GPS_X[playerid], GPS_Y[playerid], GPS_Z[playerid]);
	ResetGps(playerid);
	format(string,sizeof(string),"{ff0000}GPS Метка\n{cccccc}%d метров", floatround(dist, floatround_round));
	UpdatePlayer3DTextLabelText(playerid, GpsLabel[playerid], 0xA9C4E4FF,string);
	return 1;
}
stock DestroyGps(playerid)
{
	if(zones_gpsstat[playerid] == true) DestroyDynamicArea(zones_gps[playerid]), zones_gpsstat[playerid] = false;
	if(GpsStat[playerid] > 0) DeletePlayer3DTextLabel(playerid, GpsLabel[playerid]), GpsStat[playerid] = 0, //DestroyDynamicPickup(GpsPick[playerid]);
	SetPVarInt(playerid,"GP",0), DisablePlayerCheckpoint(playerid);
	PlayerPlaySound(playerid,1150,0,0,0);
	if(Riches[playerid] >= 1 && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0)
	{
		new idrich = Riches[playerid]-1;
		if(IsPlayerInRangeOfPoint(playerid,6.0, RichPos[idrich][0],RichPos[idrich][1],RichPos[idrich][2]))
		{
			new string[90];
		    format(string,sizeof(string),"{ffcc66}Возьмите в руки лопату из вашего инвентаря N и начните копать {ff9000}%s", buttonName[Device[playerid]]);
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*",string,"*","");
			SetPVarInt(playerid,"oryjtemp", 0);
		}
	}
	return 1;
}
stock ResetGps(playerid)
{
	new Float:dist;
	dist = GetDistancePoint(GPS_X[playerid],GPS_Y[playerid],GPS_Z[playerid], Protect_X[playerid],Protect_Y[playerid],GPS_Z[playerid]);
	if(dist >= 800.0)
	{
		/*new Float:dist2 = GetPlayerDistanceFromPoint(playerid, GPS2_X[playerid], GPS2_Y[playerid], GPS2_Z[playerid]);
		if(dist2 >= 700.0 || dist2 <= 400.0)
		{*/
			if(GpsStat[playerid] > 0) DeletePlayer3DTextLabel(playerid, GpsLabel[playerid]); // Сначала Дел
			new Float:direction = atan2(GPS_Y[playerid]-Protect_Y[playerid], GPS_X[playerid]-Protect_X[playerid])-90.0;
			//new Float:direction = acos((GPS_X[playerid]-Protect_X[playerid]) / floatsqroot((GPS_X[playerid]-Protect_X[playerid])*(GPS_X[playerid]-Protect_X[playerid]) + (GPS_Y[playerid]-Protect_Y[playerid])*(GPS_Y[playerid]-Protect_Y[playerid]))) - 90.0;
			GPS2_X[playerid] = Protect_X[playerid]+550.0*floatsin(-direction,degrees);
			GPS2_Y[playerid] = Protect_Y[playerid]+550.0*floatcos(-direction,degrees);
			
			new Float:remote = 550.0;
			new Float:dist2 = dist-remote;
			new Float:proc = dist2/dist * 100;
			GPS2_Z[playerid] = Protect_Z[playerid]/100 * proc;
			
		 	GpsLabel[playerid] = CreatePlayer3DTextLabel(playerid, " ",0xA9C4E4FF, GPS2_X[playerid], GPS2_Y[playerid], GPS2_Z[playerid] + 1.0, 1000.0);
		 	GpsStat[playerid] = 2;
		//}
	}
	else
	{
		if(GpsStat[playerid] == 2)
		{
			if(GpsStat[playerid] > 0) DeletePlayer3DTextLabel(playerid, GpsLabel[playerid]); // Сначала Дел
			GPS2_X[playerid] = GPS_X[playerid], GPS2_Y[playerid] = GPS_Y[playerid], GPS2_Z[playerid] = GPS_Z[playerid];
			GpsLabel[playerid] = CreatePlayer3DTextLabel(playerid, " ",0xA9C4E4FF, GPS_X[playerid], GPS_Y[playerid], GPS_Z[playerid] + 1.0, 1000.0);
			GpsStat[playerid] = 1;
		}
	}
	return 1;
}
stock CreateGps(playerid, Float:fX, Float:fY, Float:fZ, world = -1, interior = -1, Float:radius = 2.0)
{
	if (world < 0) world = GetPlayerVirtualWorld(playerid);
	if (interior < 0) interior = GetPlayerInterior(playerid);

	if(GpsStat[playerid] > 0) DestroyGps(playerid);
 	if(GetPVarInt(playerid,"GP") > 0) DisablePlayerCheckpoint(playerid);
 	SetPVarInt(playerid,"GP",1), PlayerPlaySound(playerid,6400,0,0,0);
	SetPlayerCheckpoint(playerid, fX, fY, fZ, radius);
	//if(stat == 5)
	//{
	if(zones_gpsstat[playerid] == true) DestroyDynamicArea(zones_gps[playerid]), zones_gpsstat[playerid] = false;
	zones_gps[playerid] = CreateDynamicCircle(fX, fY, radius, world, interior, playerid);
	zones_gpsstat[playerid] = true;
	//}
	GPS_X[playerid] = fX, Float:GPS_Y[playerid] = fY, GPS_Z[playerid] = fZ;
	GPS2_X[playerid] = fX, Float:GPS2_Y[playerid] = fY, GPS2_Z[playerid] = fZ;
	GpsLabel[playerid] = CreatePlayer3DTextLabel(playerid, " ",0xA9C4E4FF, GPS_X[playerid], GPS_Y[playerid], GPS_Z[playerid] + 1.0, 1000.0);
	GpsStat[playerid] = 1;
	//GpsPick[playerid] = CreateDynamicPickup(19605, 1, fX, fY, fZ, world, interior, playerid);
	UpdateGps(playerid);
	return 1;
}

// Проверяем находится ли активная метка GPS в нужных координатах
stock IsNearlyCloseGps(playerid, Float:acceptDistance, Float:x, Float:y, Float:z, world, interior)
{
	new Float:dist = GetDistanceBetweenPoints3D(x, y, z, GPS_X[playerid], GPS_Y[playerid], GPS_Z[playerid]);
	if(dist <= acceptDistance 
		&& world == GpsWorld[playerid] 
		&& interior == GpsInterior[playerid]) return true;
	return false;
}


public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
	if(CallPublic(playerid, 2)) return false;

	if(OnlineInfo[playerid][oLogged] == 1)
	{
		if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо.. [ Отмена установки GPS маркера ]");
	    new Float:pos[3], Float:dist;
		pos[0] = fX, pos[1] = fY, pos[2] = fZ;
		dist = GetPlayerDistanceFromPoint(playerid, fX,fY,fZ);
		if(dist >= 300.0)
		{
		    CA_FindZ_For2DCoord(pos[0], pos[1], pos[2]);
			pos[2] += 1.0; // Поднимаем на метр (под размер игрока)
		}
		if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
		{
		    new v = GetPlayerVehicleID(playerid);
		    if(VehInfo[v][vSeat] > 0)
			{
				new dryaver = VehInfo[v][vSeat]-1;
		    	if(IsOnline(dryaver))
		    	{
		    	    new string[124];
					CreateGps(dryaver, pos[0], pos[1], pos[2], 0, 0, 10.0);
					format(string,sizeof(string),"{0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}%s {ffffff}отметил точку в вашем GPS навигаторе", playername(playerid));
					SendClientMessage(dryaver, COLOR_GREY,string);
					if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я отметил точку в GPS навигаторе водителя");
					else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я отметила точку в GPS навигаторе водителя");
					
					return 1;
		    	}
   			}
		}
		if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] == 0) 
		{
			CreateGps(playerid, pos[0], pos[1], pos[2], 0, 0, 10.0);
			SendClientMessage(playerid, COLOR_GREY,"{0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Точка {ffffff}установлена в GPS навигаторе [ Y >> GPS ]");
		} else {
			S_SetPlayerVirtualWorld(playerid, 0, 0);
			PPSetPlayerInterior(playerid, 0);

			if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
				PPSetVehiclePos(playerid, pos[0], pos[1], pos[2]);
			} else {
				PPSetPlayerPos(playerid, pos[0], pos[1], pos[2]);
			}
		}
	}
	return 1;
}
stock ExitGuard(playerid)
{
	guardmoney(playerid);
	OrganInfo[GuardOrg[playerid]][gGuOccup][Guard[playerid]-1] --;
	UpdateGuard(GuardOrg[playerid], Guard[playerid]-1);
	Guard[playerid] = 0, GuardTime[playerid] = 0, GuardOrg[playerid] = 0;
	TextDrawHideForPlayer(playerid, MindDraw[4]);
	PlayerTextDrawHide(playerid, MindDraw3);
}

//------------------------------------------------------------------------------------------------------
public OnPlayerDisconnect(playerid, reason)
{
    g_MysqlRaceCheck[playerid] ++;

	if(IsPlayerNPC(playerid)) // NPC отключился от сервера
	{
		OnNpcDisconnect(playerid);
		return 1;
	}

	// Офаем m custom
	DisconnectCustomSync(playerid);

	new string[144];
	if(OnlineInfo[playerid][oLogged] == 1)
    {
		switch(reason)
	    {
	        case 0: ConnectLog(playerid, "timeout");
	        case 1: ConnectLog(playerid, "quit");
	        case 2: ConnectLog(playerid, "kick");
	        default: { }
	    }
  	}

	// Сохранение монет континенталь
	ContinentalCoins_OnPlayerDisconnect(playerid);

	// Очистка данных о наркотиках для игроков
	Drugs_OnPlayerDisconnect(playerid);
	
	// Выключаем участие в игре зомби
	ExitPlayerZombie(playerid, true);

	// Очистка объявлений при дисконнекте (CNN)
	CNN_OnPlayerDisconnect(playerid);

	// Раскопка могил
	Graves_OnPlayerDisconnect(playerid);

	// Катана дуэль
	DestroyKatanaDuel(playerid);

	// Квест с маньяком при выходе из игры
	Maniac_OnPlayerDisconnect(playerid);

	// Halloween Quest
	DestroyHalloweenBallForPlayer(playerid);

	// NewYearQuest
	if(OnlineInfo[playerid][oNewYearQuest] == 1) DestroyQuestOneMan(playerid);
	if(OnlineInfo[playerid][oNewYearQuest] >= 4 && OnlineInfo[playerid][oNewYearQuest] <= 6) NewYearDeleteActor(playerid);

	// Выгружаем питомцев
	for(new i = 0; i < MAX_PETS_AT_PLAYER; i++) DestroyPet(playerid,i);


	// Чиним транспорт в автосервисе, если игрок в тестдрайве
	if (VehShopInfo[playerid][vsTest]) Autoservice_RepairVehicle(playerid);

	// Завершаем активную гонку (или гонка с домиником)
	if(OnlineInfo[playerid][oStatusRace] > 0 
		|| OnlineInfo[playerid][oDominicRace] > 0) ClearPlayerRace(playerid);
	
	// Удаляем неустановленный трейлер
	TrailerOnPlayerDisconnect(playerid);

	// Обрабатываем отключение игрока при игре в заброшенной шахте
	MineWar_OnPlayerDisconnect(playerid);

	// Обрабатываем отключение игрока при игре в гробнице фараона
	Tomb_OnPlayerDisconnect(playerid);

	// Завершаем тренировочный маршрут (NGSA)
	Obstacle_OnPlayerDisconnect(playerid);

	// Очищаем последние сообщения игрока
	OutgoingMessages_Clear(playerid);

	MuteSoundPlayers[playerid] = 0;

	// Очистка информации об игроке (система взлома базы данных)
	PDatabase_OnPlayerDisconnect(playerid);

	// Удаляем личные лейблы всех систем
	if(LabelsInfo[playerid][labelCreate] > 0) ClosePlayer3DLabelAll(playerid);

	// Удаляем все лейблы кастомных авто
	if(PlayerInfo[playerid][pCustomLabel] == 0) DestroyAllCustomVehicleLabels(playerid);

	// Удаляем все лейблы музыки в транспорте
	DestroyAllRadioVehicleLabels(playerid);

	// Выключаем активный квест
	if(QuestInfo[playerid][QuestBot]) CloseQuestJone(playerid);

	// Выключаем активный сценарий болтовни NPC
	if(QuestInfo[playerid][ActorTimer]) KillTimer(QuestInfo[playerid][ActorTimer]), QuestInfo[playerid][ActorTimer] = 0;

    // Включаем всем просмотр никнейма этого игрока
    if(NameTag[playerid] == true)
    {
    	NameTag[playerid] = false;
    	foreach(Player,i)
		{
			if(ADUTY[i] == 0) ShowPlayerNameTagForPlayer(i, playerid, true);
		}
    }
    if(ATimerStat[playerid] >= 1) ATimerStat[playerid] = 0, KillTimer(AutoTimer[playerid]);
    gWindowPass[playerid] = 0, CoordMaster_Warn[playerid] = 0, Fly_Warn[playerid] = 0;
    if(Guard[playerid] >= 1) ExitGuard(playerid);
    mysql_save(playerid, 12);
    if(GetPVarInt(playerid, "akula") >= 1) KillTimer(AkulaTimer[playerid]), DestroyDynamicObject(akula[playerid]), SetPVarInt(playerid, "akula", 0);
    if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;
    if(AeroTimer[playerid]) KillTimer(AeroTimer[playerid]), AeroTimer[playerid] = 0;
    SnowGo(playerid, 0);
    if(bespilot[playerid] >= 1) EjectBespilot(playerid);
    if(Piss[playerid] == 6) Piss[playerid] = 0; PissTime[playerid] = 0;
    foreach(Player,i)
	{
		if(GetPVarInt(i,"Readcon") == 1) SendDeathMessageToPlayer(i,INVALID_PLAYER_ID,playerid,201);
		if(OnlineInfo[i][oSaleThing] > 0 && OnlineInfo[i][oSaleSeller] == playerid) OnlineInfo[i][oSaleThing] = 0;//, SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Продавец куда-то делся [ Вышел из игры ]");
	}
	
	// Вытаскиваем игрока из багажника, если он в нем был
	new boot_vehicleid = GetPVarInt(playerid, "Boot");
 	if(boot_vehicleid > 0)
    {
    	if(IsValidVehicle(boot_vehicleid))
    	{
    		if(VehInfo[boot_vehicleid][vPeople] > 0 && VehInfo[boot_vehicleid][vPeople] - 1 == playerid) {
				EjectBoot(playerid, boot_vehicleid);
			}
    	}
		DeletePVar(playerid, "Boot");
    }

	if(HospBed[playerid] != 9999) ClearBedMed(playerid);

	for(new i;i< sizeof(friskDetailTypeName);i++)
	{
		TempDetail[playerid][i] = 0;
	}

	// Выключаем болтовню бота
    if(BotTalkStat[playerid] > 0) DeletePlayer3DTextLabel(playerid, BotTalk[playerid]), BotTalkStat[playerid] = 0;
    if(BotTalkTimer[playerid]) KillTimer(BotTalkTimer[playerid]), BotTalkTimer[playerid] = 0;

	// Очищаем стритрейсеров
	if(OnlineInfo[playerid][oStreetRaceSlot] > 0) LeaveRace(playerid,OnlineInfo[playerid][oStreetRaceSlot]-1);

	// Очищаем Сектанта в эфире
	if(SektaCNN[1] == playerid) SektaCNNClose();

	if(zaprcarElectroTimer[playerid] > 0) ElectroFillClose(playerid, 2);
	
	if(GetPVarInt(playerid,"job_electrician") > 0) CloseElectricianClear(playerid);

	if(ElectricianProcessTime[playerid] > 0) ElectricianStopProcess(playerid,0);

	if(PlayingWithPetProcessTime[playerid] > 0) PlayingWithPetStopProcess(playerid,0);

	// Отключаем отображение лейблов для старых ботов
	if(binfo[playerid] == 1)
    {
       for(new b = 0; b < MAX_BOTS; b++) DeletePlayer3DTextLabel(playerid, BotLabel[b]);
       binfo[playerid] = 0;
    }

	// Записываем последнюю позицию игрока
	if(OnlineInfo[playerid][oLogged] == 1 
		&& DeathInfo[playerid][deathStatus] == false 
		&& OnlineInfo[playerid][oKickSystem] == false) SaveLastPlayerPosition(playerid);

	if(computerClubPlayerInfo[playerid][ccpiInGame] == true) ComputerClubOnPlayerDisconnect(playerid); // Передача хоста в компьютерном клубе, очистка информации об игроке

	// Отключаем админское отображение 3d text объектов
	for(new i = 0; i < MAX_MAPOBJECT; i++)
	{
		DestroyDynamic3DTextLabel(MapLabel[i][playerid]);
	}
	labelobj[playerid] = false;

	// Очищаем принятый вызов при выходе из игры
	if(OnlineInfo[playerid][oTakeMake] != -1) MakeInfo[OnlineInfo[playerid][oTakeMake]][mkStatus] = 1;

	// Завершаем Намаз
	if(Namaz[playerid] >= 0) CloseNamaz(playerid);
	
	// Покидаем патруль
	if(PlayerInfo[playerid][patroolID] >= 0) ClosePatrool(playerid, -1);

	// Закрываем открытый багажник
	if(OnlineInfo[playerid][oShowInterface] == 1 && Tabs_Load[playerid] == 5) boot_close(playerid);

	// Удаляем заявку в суд от человека
	if(PlayerInfo[playerid][pCourtsStatus] > 0) CourtDeleteOrder(playerid);

	// Закрываем открытый капот
	if(OnlineInfo[playerid][oShowInterface] == 1 && Tabs_Load[playerid] == 10) bonet_close(playerid);

	// Удаляем интерьер личного редактора
	// if(peoInfo[playerid][peoQuanObjects] > 0 || peoInfo[playerid][peoQuanUpdates] > 0) DestroyPeoInterior(playerid), ClearPeoInfo(playerid);
    
	// Отменяем церемонию бракосочетания
	if(MarriageOffer[playerid] > 0) exit_propose(playerid);
	
	// Сбрасываем загруженные ачивки
	PlayerInfo[playerid][pAchieveLoad] = false;
	
	// Отменяем игру в кости
	if(DicePlayer[playerid] > 0)
	{
	    new seller = DicePlayer[playerid]-1;
	    if(IsOnline(seller))
		{
		    DicePlayer[seller] = 0, DiceStat[seller] = 0;
		    SendClientMessage(seller, COLOR_GREY, "[ Мысли ]: %s {FF6347}вышел из игры", rpplayername(playerid));
		}
		DicePlayer[playerid] = 0, DiceStat[playerid] = 0;
	}

	// Закрываем активный вызов сервисов
	if(OnlineInfo[playerid][oServiceMake][0] > 0) ExitCloseMake(playerid);
	
	// Возвращаем Положенные Предметы
	if(PlayerInfo[playerid][pID] > 0) back_item(playerid);
	
	// Отключаем Мысли Объектами
	if(MindStatObject[playerid] == true) close_mind_object(playerid);

	// Закрываем карту автобусов
	if(OnlineInfo[playerid][oShowInterface] == 10) OnlineInfo[playerid][oShowInterface] = 0; //CloseMapBus(playerid);
	
	// Отключаем Водителя Автобуса
	if(driverid[playerid] > 0) ExitBusDriver(playerid);
	
	// Возвращаем Никнейм
	if(gSign[playerid] == true) SetPlayerName(playerid, PlayerInfo[playerid][pName]), gSign[playerid] = false;

	// Возвращаем плот домой
	if(plot_player == playerid) plothome(plot_route);
   	
   	// Удаляем Объект от Игрока
   	if(object_stat[playerid] == 1) DestroyDynamicObject(player_object[playerid]), object_stat[playerid] = 0;

	// Удаляем /find
   	if(ZoneTimer[playerid] > 0) DestroyFindZone(playerid);

   	// Удаляем Простуду
   	if(zones_coldstat[playerid] > 0) DestroyDynamicArea(zones_cold[playerid]), zones_coldstat[playerid] = 0;
   	
   	// Очищаем Античит на Fly
   	for(new spe = 0; spe < 15; spe++) PSpeed[spe][playerid] = 0.0;
   	
   	// Очищаем дамаг лог
   	for(new d = 0; d < 200; d++)
   	{
		if(DamageStat[d][playerid] == 0) continue;
		DamageLog[d][playerid] = 0;
		DamageUnix[d][playerid] = 0;
		DamageStat[d][playerid] = 0;
		DamageType[d][playerid] = 0;
		DamageWeapon[d][playerid] = 0;
	}
	
	// Отключаем работу Мусоровоза
	if(TrashBakHand[playerid] > 0) reset_trash(playerid, TrashBakHand[playerid] - 1, 0);
	
   	// Отключаем метку в GPS
   	if(GpsStat[playerid] > 0) DestroyGps(playerid);
   	
   	// Удаляем КостёрИ
   	if(KosterInfo[playerid][kStat] == 1) KosterInfo[playerid][kStat] = 0, DestroyDynamicObject(KosterInfo[playerid][kObject]), DestroyDynamic3DTextLabel(KosterLabel[playerid]);
   	
	// Сбрасываем Занятость Авто
	if(Protect_Veh[playerid] != 9999) ResetInCar(playerid);

	// Удаляем Арендованный Транспорт (0)
	if(PlayerInfo[playerid][pRentVeh][0] > 0) DestroyRentVehicle(playerid, 0);
	
	// Удаляем Арендованный Транспорт (1)
	if(PlayerInfo[playerid][pRentVeh][1] > 0) DestroyRentVehicle(playerid, 1);

	// Закрываем лавку
	if(Goods[playerid] > 0) stopshop(playerid);

   	// Отменяем Доставку Товара
   	if(GetPVarInt(playerid,"delivery_biz") >= 1)
   	{
   		new b = GetPVarInt(playerid,"delivery_biz");
		BizzInfo[b][bDeliveryOrder] = -1;
		SetPVarInt(playerid,"delivery_biz",0);
	}

	// Отменяем инкассацию денег
	if(GetPVarInt(playerid,"job_collector") >= 1) CloseCollectorToBiz(playerid);

	// Удаляем Ловушку для акулы
	if(Trap[playerid] > 0) DeleteSharkTrap(playerid);
	
	// Удаляем Спутниковую Антенну
	if(Sate[playerid] > 0)
	{
		DestroyDynamic3DTextLabel(SateText[playerid]);
		DestroyDynamicObject(SateObj[0][playerid]);
		DestroyDynamicObject(SateObj[1][playerid]);
		DestroyDynamicObject(SateObj[2][playerid]);
		DestroyDynamicObject(SateObj[3][playerid]);
		Sate[playerid] = 0, SateTime[playerid] = 0;
	}

	// Village
	PlayerExitVillage(playerid);
	Village_Kills[playerid] = 0;

   	// Удаляем надувную лодку
   	if(OnlineInfo[playerid][oInflatableBoat] != NON) Close_InfBoat(playerid);

   	// Вырубаем SkyDive
   	if(SkyStat[playerid] > 0) stopsky(playerid);

   	// Вырубаем подсчёт участников организации Online
   	if(OnlineInfo[playerid][oLogged] == 1)
   	{
   		new g = fraction(playerid);
     	if(g > 0) Onli[g] --;
   	}
   	// Вырубаем спуск по верёвке
	if(RopeQuan[playerid] >= 2) ropedown(playerid, RopeVeh[playerid], RopeID[playerid], 0);

   	// Вырубаем вести за собой игрока
   	StopFollow(playerid);

   	// Отключаем Mapping Label
   	if(ObjLabStat[playerid] > 0) close_labelmap(ObjLabStat[playerid], playerid);
   	
   	// Отключаем Камеры Слежения
   	if(OverHear[playerid] >= 1 && OverHear[playerid] <= 999) OverHear[playerid] = 0, DestroyPlayerObject(playerid, CamObjectPlayer[playerid]);
   	
   	// Отключаем Стул
	if(SitPlayer[playerid] >= 1 || playerSeat[playerid]) exitsit(playerid, 0);
	
   	// Сбрасываем Супермаркет
	if(GetPVarInt(playerid,"svzyal") >= 1) Svalilizsm(playerid);
	
   	// Вырубаем 3DMenu
	if(MenuInfo[playerid][zStat] == 1) Destroy3DMenu(playerid);
	
	// Убираем текстурируемый объект
	if(Texture[playerid] == 1) RemoveObjectToTexture(playerid);
	
   	// Вырубаем FlyCam
   	if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY) CancelFlyMode(playerid);
   	
   	// Удаляем Action
   	for(new i = 0; i < MAX_PLAYER_ACTIONS; i++)
   	{
   		if(gAction[i][playerid]) DestroyDynamic3DTextLabel(ActionLabel[i][playerid]), gAction[i][playerid] = 0, ActionText[i][playerid][0] = EOS;
	}
	
   	// Отрубаем мойку пятен
   	if(Dei[playerid] == 2 && DeiStat[playerid] >= 1) DirtWash[DeiStat[playerid]-1] = -1;
   	
   	// Отключаем взлом двери
   	if(breakingDraw[playerid] == true) StopBreaking(playerid);

	// Удаляем транспорт из автосалона
	if(VehShopInfo[playerid][vsVehicleLoad]) destroyVehicle_VehicleShop(playerid);

   	if(Heal[playerid] == 7777) DestroyDynamic3DTextLabel(TradeLabel[playerid]), Heal[playerid] = 9999;
   	if(Pame[playerid] >= 1) DestroyDynamic3DTextLabel(PameLabel[playerid]);
   	if(Fame[playerid] == true)  DestroyDynamic3DTextLabel(FamLabel[playerid]);
   	if(Nolet[playerid] == 1) DestroyPlayerObject(playerid, NoletObj[playerid]), Nolet[playerid] = 0;
	if(Taxi[playerid] >= 1) StopTaxi(playerid);
    if(GolosVB[playerid] != 9999){ SetPVarInt(GolosVB[playerid],"VoteBan" ,GetPVarInt(GolosVB[playerid],"VoteBan") -1); GolosVB[playerid] = 9999; }

	// Чекаем количество участников в мафиозной стреле
    if(gMifga[playerid] != 9999) gMifga[playerid] = 9999, CheckMafWar(0, 0);

    if(Sex[playerid] >= 1 && Sex[playerid] <= 4) StopSex(playerid, 0);
	if(OnlineInfo[playerid][oSexBot] > 0) StopSexWhore(playerid);
    if(KtoKomy[playerid] != 9999)
    {
		if(IsOnline(KtoKomy[playerid])) KtoKomy[KtoKomy[playerid]] = 9999;
        KtoKomy[playerid] = 9999;
    }

    // Отключаем Сделку
    if(PlayerInfo[playerid][pTstat] >= 1) CloseTrade(playerid);

	// Выходим из спортзала
	if(GetPVarInt(playerid,"tips") > 0) CloseSport(playerid);

	new ara = 0;
	if(CuffedId[playerid] != 9999 && Stun[5][playerid] >= 1) // В психушку при выходе
	{
	   	if(PlayerInfo[playerid][pCrimes] >= 1 && PlayerInfo[playerid][pJailed] == 0)
		{
		    TempTake(playerid, 0);
		    PlayerInfo[playerid][pJailed] = 6;
			PlayerInfo[playerid][pJailTime] = PlayerInfo[playerid][pAmmos2]*10;
			PlayerInfo[playerid][pAmmos2] = 0;
	        if(IsOnline(CuffedId[playerid]))
		    {
				new mentid = CuffedId[playerid];
		   	 	format(string, sizeof(string), "* Вы отправили %s на лечение!", playername(playerid));
				SendClientMessage(mentid, COLOR_LIGHTBLUE, string);
				PlayerPlaySound(mentid,6401,0,0,0);
				format(string, sizeof(string), "<< Доктор %s отправил %s на принудительное лечение >>", playername(mentid), playername(playerid));
				OOCOff(COLOR_LIGHTRED, string);
				if(PlayerInfo[playerid][pMember] != 4 && PlayerInfo[playerid][pLeader] != 4)
				{
					bigint_add(OrganInfo[4][glave], 3000), OrganInfo[4][gUpdate] = 1;
 					GameTextForPlayer(mentid, "~n~~n~~n~~n~~n~~n~~n~~w~Њa‰њe®¦:~g~ O¦Јpaўћe®!~n~~r~ASGH:~g~ +3000$", 5000, 3);
  				}
	        }
	        ara = 1;
		}
	}
	if(ara == 0)
	{
	    if(PlayerInfo[playerid][pCrimes] >= 1)
	    {
	        new copid;
			if(PursuitTime[playerid] >= 1 || Stun[4][playerid] >= 1 && CuffedId[playerid] != 9999 || Stun[3][playerid] >= 1 && CuffedId[playerid] != 9999)
			{
			    if(PursuitTime[playerid] >= 1) copid = Pursuit[playerid];
			    else copid = CuffedId[playerid] != 9999;
			    if(IsOnline(copid))
			    {
			    	if(OnlineInfo[copid][oLogged] == 1) ArestPlayer(playerid, copid, AREST_TYPE_QUIT), ara = 1;
			    	else ArestPlayer(playerid, -1, AREST_TYPE_QUIT), ara = 1;
		    	}
		    	else ArestPlayer(playerid, -1, AREST_TYPE_QUIT), ara = 1;
			}
		}
	}
	if(ara == 0 && PlayerInfo[playerid][pJailed] == 0)
	{
		if(Stun[0][playerid] >= 1 || Stun[1][playerid] >= 1 || Stun[2][playerid] >= 1 || Stun[3][playerid] >= 1 || Stun[4][playerid] >= 1 || Stun[5][playerid] >= 1) // В госпиталь при выходе
		{
  			TempTake(playerid, 0);
			PlayerInfo[playerid][pJailed] = 8;
   			PlayerInfo[playerid][pJailTime] = 1800;
      		ara = 1;
		}
	}

	// Вышел из игры на ринге
    if(box[playerid] > 0) StopRing(ringid[playerid]);

	// Обрабатываем отключение владельца радаров
	Radar_OnPlayerDisconnect(playerid);

	// Приостанавливаем запущенные таймеры работы электрика
	Electrician_OnPlayerDisconnect(playerid);
	
	// Останавливаем запущенный таймер на игре с питомцем
	PlayingWithPet_OnPlayerDisconnect(playerid);

    // Бросаем Трубку
    if(GetPVarInt(playerid, "Mobile") != 9999 && GetPVarInt(playerid,"MobileStat") >= 1) hangup(playerid, 1);

	// Отмена редактирования объекта
	CloseEditObject(playerid);

	// Удаляем бота в магазине одежды
	if(OnlineInfo[playerid][oActorShop] != INVALID_VARIABLE) DestroyClothesActor(playerid);

	// Чистим Лобби
	if(LobbyInfo[playerid][lobbyLeader] != -1) LobbyDestroy(playerid, 0);
	if(OnlineInfo[playerid][oLobby] != 0) LeaveLobby(OnlineInfo[playerid][oLobby]-1, 0);
	
	// Ставим то что рюкзак не загружен
	BackPackInfo[playerid][backpackLoad] = 0;

	if(IceHoleStatus[playerid]) DestroyIceHole(playerid);
	// Личный Транспорт
    if(OnlineInfo[playerid][oLogged] != 0) 
    {
		if(IsPlayerInAnyVehicle(playerid)) // Записываем позицию транспорта, в котором сидим
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(VehInfo[vehicleid][vSost] == PlayerInfo[playerid][pID] || VehInfo[vehicleid][vKey] == PlayerInfo[playerid][pID] && VehInfo[vehicleid][vKeyUnix] > gettime()) 
			{
				if(gAutosalon[playerid] == 0) SaveMyVehiclePos(vehicleid);
			}
		}
		DestroyMyVehicles(playerid); // Удаляем все личные загруженные тачки
	}

    if(CnnVed[playerid] == 2)
	{
		CnnVed[playerid] = 0;
		cnnkam = 9999;
		if(cnnchan == 2) // Включаем студию
 		{
			cnnchan = 1;
			foreach (Player, i)
			{
				if(OnlineInfo[i][oLogged] == 1 && CnnVed[i] == 12) OpenTv(i); // Снова открываем
			}
		}
	}
	foreach (Player, i)
	{
	    if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && gSpectateID[i] == playerid && noclipdata[i][cameramode] == CAMERA_MODE_NONE)
		{
            StopSpectate(i);
			switch(reason)
			{
				case 0: GameTextForPlayer(i,"~r~…™pok ‹Ёћe¦eћ",3500,4);
				case 1: GameTextForPlayer(i,"~r~…™pok ‹ЁҐeћ",3500,4);
				case 2: GameTextForPlayer(i,"~r~…™pok Kњk/Ђa®",3500,4);
				default: GameTextForPlayer(i,"~r~…™pok ‹ЁҐeћ",3500,4);
			}
		}
	}
	if(gJerID[playerid] != 9999)
	{
    	if(IsOnline(gJerID[playerid]))
        {
	      gHitID[gJerID[playerid]] = 9999;
     	}
	}
	if(GetPVarInt(playerid,"kas") == 5 || GetPVarInt(playerid,"kas") == 6) ExitKasino3(playerid);
	if(gHitID[playerid] != 9999)
    {
    	if(IsOnline(gHitID[playerid]))
        {
	      if(PlayerInfo[gHitID[playerid]][pMember] == 8 || PlayerInfo[gHitID[playerid]][pLeader] == 8)
	      {
	   	      SendClientMessage(gHitID[playerid], COLOR_WHITE, "{950000}[ Агентство ]{444444}: Ваша цель покинула сервер!");
	          new str[128],sctring[512];
	          format(str,sizeof(str),"{950000}_______________[ {444444}Агентство {950000}]_______________");
	          strcat(sctring,str);
	          format(str,sizeof(str),"\n\n{444444}Ваша цель покинула сервер!");
	          strcat(sctring,str);
	          format(str,sizeof(str),"\n\n{950000}_______________________________________");
	          strcat(sctring,str);
	          ShowDialog(gHitID[playerid],1700,DIALOG_STYLE_MSGBOX,"           {000000}*",sctring,"*","");
	      }
	      gJerID[gHitID[playerid]] = 9999;
     	}
	}
	// Сохраняем временную информацию о капте
	if(CaptInfo[cCaptStat] == true)
	{
		if(PlayerInfo[playerid][pMember] == CaptInfo[cAttack] || PlayerInfo[playerid][pLeader] == CaptInfo[cAttack]
		|| PlayerInfo[playerid][pMember] == CaptInfo[cDefend] || PlayerInfo[playerid][pLeader] == CaptInfo[cDefend]) SavePlayerTemp(playerid);
	}
	// Сохраняем аккаунт при выходе из игры
	if(PlayerInfo[playerid][pBanned] != 3)
	{
        gMysqlSaveCheck[playerid] = 1;
		GF_OnPlayerUpdate(playerid);
	}

	// Сохраняем данные о вынесенных судебных решениях
	SavePlayerCourtDecisions(playerid);

	// Сохранение BattlePass
	StartAllSaveBattlePass(playerid);

	// Сохраняем статистику для топа
	if(OnlineInfo[playerid][oTopLoad]) SavePlayerTop(playerid);

	ZoneTimer[playerid] = 0;
	
	//===========================================
	//================[ SPEEDO ]=================
	//===========================================
	//#pragma unused reason
	if(PlayerInfo[playerid][pSped] == 0 && UpdateSpeed[playerid] >= 1) // Если 3D спидометр активирован и открыт
	{
		UpdateSpeed[playerid] = 0;
 		DestroyDynamicObject(SpdObj[playerid][0]);
  		DestroyDynamicObject(SpdObj[playerid][1]);
   		SpdObj[playerid][0] = INVALID_STREAMER_ID;
    	SpdObj[playerid][1] = INVALID_STREAMER_ID;
	}
	//===========================================
	//===========================================
	//===========================================
 	OnlineInfo[playerid][oLogged] = 0;

	// Ставим максимальное хп
	// Хоть оно и ставится в OnPlayerConnect, этого, по всей видимости, недостаточно
	// См. death.pwn -> SetPlayerDeath -> ACSetPlayerHealth(playerid, healthToSet);
	OnlineInfo[playerid][oMaxHealth] = 100.0;

	#if defined SAMPVOICE_COMPILE_3 
	Sampvoice3DestroyPlayer(playerid);
	#endif
	return 1;
}

stock GetFractionColor(g) {
	switch (g) {
		case 1: return COLOR_LSPD;
		case 3: return COLOR_ARMY;
		case 4: return COLOR_MED;
		case 5: return COLOR_LCN;
		case 6: return COLOR_YAK;
		case 7: return COLOR_PRAV;
		case 9: return COLOR_CNN;
		case 10: return COLOR_TRIAD;
		case 11: return COLOR_SFPD;
		case 12: return COLOR_RUSSIAN;
		case 13: return COLOR_GROVE;
		case 14: return COLOR_BALLAS;
		case 15: return COLOR_VAGOS;
		case 16: return COLOR_AZTEC;
		case 18: return COLOR_ALQ;
		case 21: return COLOR_LVPD;
		case 22: return COLOR_MIDNIGHTBLUE;
		default: return INV_COLOR;
	}
	
	return INV_COLOR;
}

stock GetDivisionColor(g, i) {
	if (g < 1 || i < 0) return INV_COLOR;

	new color_str[12];
	format(color_str, sizeof(color_str), "0x%sFF", DivisionInfo[g - 1][i][divColorHex]);
	
	new color;
	if(!sscanf(color_str, "x", color)) return color; // Цвет подфракции существует
	
	return INV_COLOR;
}

stock SetPlayerToTeamColor(playerid)
{
	if(ADUTY[playerid] == 1)
	{
		if(PlayerInfo[playerid][pSoska] == 1) SetPlayerColor(playerid, COLOR_HELPER);
		else if(PlayerInfo[playerid][pSoska] >= 2) SetPlayerColor(playerid,COLOR_ADMIN);
		return 1;
	}

	SetPlayerColor(playerid, GetFractionColor(fraction(playerid)));

	return 1;
}

stock SetPlayerHealthInHospital(playerid)
{
	if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7 || PlayerInfo[playerid][pJailed] == 8)
	{
		if(PlayerInfo[playerid][pJailed] == 8) ACSetPlayerHealth(playerid, GetMaxPlayerHealth(playerid));
		else ACSetPlayerHealth(playerid, GetMaxPlayerHealth(playerid) / 10.0);
	}
	else ACSetPlayerHealth(playerid, GetMaxPlayerHealth(playerid));
	return true;
}

public SetPlayerSpawn(playerid)
{
  if(OnlineInfo[playerid][oLogged] == 1)
  {
    if(gZaregal[playerid] == 2) return 1;

	//======================================================
	// Сюда помещаем выключение функций после полного спавна (потому что смерть с возвратом, это не полный спавн)

	// Вырубаем подсказку в худе
	if(IsPlayerSyncModels(playerid)) HidePlayerHudTask(playerid);

	// Очищаем гонку для игрока после полного спавна
	if(OnlineInfo[playerid][oStatusRace] > 0) ClearPlayerRace(playerid);

	//======================================================

    if(GameInfo[gamSpawn] == 1)
    {
		if(MPGO[playerid] == 1)
		{
			Protect_TakeGuns(playerid, 0);
			if(MPSpawn[playerid] == 1)
			{
				S_SetPlayerVirtualWorld(playerid,GameInfo[gamWorld],GameInfo[gamInt]);
				PPSetPlayerInterior(playerid,GameInfo[gamInt]);
				PPSetPlayerPos(playerid, GameInfo[gamX],GameInfo[gamY],GameInfo[gamZ]);
				if(GameInfo[gamSkin][0] > 0) m_custom_sync_SetPlayerSkin(playerid, GameInfo[gamSkin][0]);
				if(GameInfo[gamOffClist]) SetPlayerColor(playerid, 0xc8ff0000);
				else SetPlayerColor(playerid, 0xc8ff00AA);
				if(GameInfo[gamOffNick])
				{
					foreach(Player,i)
					{
						if(ADUTY[i] == 0) ShowPlayerNameTagForPlayer(i, playerid, false);
					}
				}
				PPSetPlayerFacingAngle(playerid, GameInfo[gamA]);
				ACSetPlayerHealth(playerid, 160); ACSetPlayerArmour(playerid,0);
				TogglePlayerControllable(playerid,false);
				Stopeee[playerid] = 1;Stopee[playerid] = 2;
				for(new i = 0; i < sizeof(GameInfo[gamGun]); i++) if(GameInfo[gamGun][i]>=1) Protect_GiveWeapons(playerid, GameInfo[gamGun][i], GameInfo[gamAmmo][i], GUN_HEALTH, 0);
			}
			else if(MPSpawn[playerid] == 2)
			{
				S_SetPlayerVirtualWorld(playerid,GameInfo[gamWorld],GameInfo[gamInt]);
				PPSetPlayerInterior(playerid,GameInfo[gamInt]);
				PPSetPlayerPos(playerid, GameInfo[gamX2],GameInfo[gamY2],GameInfo[gamZ2]);
				if(GameInfo[gamSkin][1] > 0) m_custom_sync_SetPlayerSkin(playerid, GameInfo[gamSkin][1]);
				if(GameInfo[gamOffClist]) SetPlayerColor(playerid, 0x00ff9900);
				else SetPlayerColor(playerid, 0x00ff99AA);
				if(GameInfo[gamOffNick])
				{
					foreach(Player,i)
					{
						if(ADUTY[i] == 0) ShowPlayerNameTagForPlayer(i, playerid, false);
					}
				}
				PPSetPlayerFacingAngle(playerid, GameInfo[gamA2]);
				ACSetPlayerHealth(playerid, 160); ACSetPlayerArmour(playerid,0);
				TogglePlayerControllable(playerid,false);
				Stopeee[playerid] = 1;Stopee[playerid] = 2;
				for(new i = 0; i < sizeof(GameInfo[gamGun]); i++) if(GameInfo[gamGun][i]>=1) Protect_GiveWeapons(playerid, GameInfo[gamGun][i], GameInfo[gamAmmo][i], GUN_HEALTH, 0);
			}
			return 1;
		}
    }
	if(fraction(playerid) >= 1)
	{
		if(Kapt[fraction(playerid)] >= 1) GiveUpdate(playerid, Kapt[fraction(playerid)]);
	}
    if(MPGO[playerid] == 1) // Спавн после мероприятия
	{
 		MPGO[playerid] = 0;
 		TempGive(playerid);
 		S_SetPlayerVirtualWorld(playerid, SpWorld[playerid], SpInt[playerid]), PPSetPlayerInterior(playerid, SpInt[playerid]);
	  	PPSetPlayerPos(playerid, SpX[playerid], SpY[playerid], SpZ[playerid]);
    	PPSetPlayerFacingAngle(playerid, SpA[playerid]);
		SetPosa[playerid] = 0;
		TogglePlayerControllable(playerid,false);
		SetCameraBehindPlayer(playerid);
		Stopeee[playerid] = 1;Stopee[playerid] = 2;
	 	SetPlayerToTeamColor(playerid);
		GangZoneHideForPlayer(playerid, GameInfo[gamGangzone]);
		showGangZones(playerid);
		return 1;
	}
    MPGO[playerid] = 0;

	if(PlayerInfo[playerid][pJailed] == 1) // Тюрьма
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,WORLD_PRISON_CELLS,INT_PRISON_CELLS), PPSetPlayerInterior(playerid,INT_PRISON_CELLS);
		if(PlayerInfo[playerid][pJailCell] == 1) PPSetPlayerPos(playerid,1056.0322,2438.1597,10.8639), PPSetPlayerFacingAngle(playerid,1.0755);
		else if(PlayerInfo[playerid][pJailCell] == 2) PPSetPlayerPos(playerid,1049.3568,2437.9927,10.8639), PPSetPlayerFacingAngle(playerid,1.0754);
		else if(PlayerInfo[playerid][pJailCell] == 3) PPSetPlayerPos(playerid,1042.5607,2438.0039,10.8639), PPSetPlayerFacingAngle(playerid,1.3887);
