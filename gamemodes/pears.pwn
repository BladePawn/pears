CMD:pames(playerid)
{
    if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pMedia] != 3) return ErrorMessage(playerid, "{FF6347}Эта команда доступна только администрации и Media 3+ уровня");
    new str[214],sctring[4096], quan;
	foreach (Player, i)
 	{
		if(Pame[i] >= 1)
		{
			format(str,sizeof(str),"{cccccc}%s[%d] {999999}(( %s )) (( %s ))",PlayerInfo[i][pName],i, PameText[i], PameText2[i]), strcat(sctring,str);
			format(str,sizeof(str),"\n"), strcat(sctring,str);
			quan ++;
		}
	}
	if(quan <= 0) return ErrorMessage(playerid, "{FF6347}На сервере нет игроков с включённым RP описанием");
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Pame Online",sctring,"Ок","");
	return 1;
}
CMD:pame(playerid)
{
	if(PlayerInfo[playerid][pLevel] <= 1) return ErrorMessage(playerid, "{FF6347}RP Описание доступно только со 2 уровня [ Y >> Меню >> Статистика ]\n\n{cccccc}Ограничение присутствует для защиты от\nрекламы и неадекватных подписей");
	if(PlayerInfo[playerid][pSoska] > 0 && PlayerInfo[playerid][pSoska] < 25) return ErrorMessage(playerid, "{FF6347}RP Описание недоступно для администраторов");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");

	new str[64],sctring[256], text[14];
	if(Pame[playerid] == 0) format(str,sizeof(str),"{cccccc}Отображение {FF6347}[ Off ]"), strcat(sctring,str);
	else if(Pame[playerid] == 1) format(str,sizeof(str),"{cccccc}Отображение {99ff66}[ On ]"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Посмотреть"), strcat(sctring,str);
	
	if(strlen(PameText[playerid]) > 0)
	{
	    format(text,sizeof(text),"%s", PameText[playerid]);
		format(str,sizeof(str),"\n{ff9000}[ 1 ] {faf75c}%s...", text), strcat(sctring,str);
	}
	else format(str,sizeof(str),"\n{cccccc}[ 1 ] Строка >> Изменить"), strcat(sctring,str);
	
	if(strlen(PameText2[playerid]) > 0)
	{
	    format(text,sizeof(text),"%s", PameText2[playerid]);
		format(str,sizeof(str),"\n{ff9000}[ 2 ] {faf75c}%s...", text), strcat(sctring,str);
	}
	else format(str,sizeof(str),"\n{cccccc}[ 2 ] Строка >> Изменить"), strcat(sctring,str);
	ShowDialog(playerid,1254,DIALOG_STYLE_TABLIST,"{ff9000}Описание Персонажа",sctring,"Выбрать","Выход");
	return 1;
}
CMD:delpame(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pMedia] != 3) return ErrorMessage(playerid, "{FF6347}Эта команда доступна только администрации и медиа 3 уровня");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Удалить описание персонажа [ /delpame ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети [ Неверный ID ]");
	if(Pame[params[0]] == 0) return ErrorMessage(playerid, "{FF6347}У этого игрока нет RP описания");
	Pame[params[0]] = 0;
	DestroyDynamic3DTextLabel(PameLabel[params[0]]);
	new string[128];
	format(string, sizeof(string), "* Администратор %s очистил ваше RP описание персонажа.", PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), " [ ADM ]: %s[%d] очистил RP описание %s[%d]", PlayerInfo[playerid][pName],playerid,PlayerInfo[params[0]][pName],params[0]);
	ABroadCast(COLOR_ADM,string,1);
	return 1;
}
CMD:action(playerid)
{
    if(PlayerInfo[playerid][pLevel] <= 2) return ErrorMessage(playerid, "{FF6347}RP Описание доступно только с 3 уровня [ Y >> Меню >> Статистика ]\n\n{cccccc}Ограничение присутствует для защиты от\nрекламы и неадекватного поведения");
	if(howstun(playerid) || HealthAC[playerid] <= 0 || Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо или он спит");
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	new str[114],sctring[2048], text[18], quan;
	format(str,sizeof(str),"{99ff66}Новое Действие\n"), strcat(sctring,str);

	new max_actions = GetMaxPlayerActions(playerid);
	for(new i = 0; i < max_actions; i++)
	{
		if (!gAction[i][playerid]) continue;
		
		List[quan][playerid] = i;
		format(text, sizeof(text), "%s", ActionText[i][playerid]);
		format(str,sizeof(str),"{ff9000}%d. {cccccc}%s\n", i+1, text), strcat(sctring,str);
		quan ++;
	}
	ShowDialog(playerid,1257,DIALOG_STYLE_TABLIST,"{ff9000}Действие",sctring,"Выбрать","Выход");
	return 1;
}
CMD:animset(playerid, const params[])
{
    new animationplayed;
	if (!sscanf(params, "i", animationplayed))
	{
		if(animationplayed < 1 || animationplayed > 7) SendClientMessage(playerid,0xFF0000FF,">Пишите /animset [1-7]");

		new Float:A;
		GetPlayerFacingAngle(playerid,A);
		if(animationplayed == 1)  ApplyAnimation(playerid,"PED","SEAT_down",4.0, false, false, false, true, false, SYNC_ALL), PPSetPlayerFacingAngle(playerid,A+180.0);
		else if(animationplayed == 2) ApplyAnimation(playerid,"PED","SEAT_idle",4.0, false, true, true, true, true, SYNC_ALL);
		else if(animationplayed == 3) ApplyAnimation(playerid,"PED","SEAT_up",4.0, false, true, true, true, true, SYNC_ALL);
		else if(animationplayed == 4) ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.1, false, false, false, false, false, SYNC_ALL);
		else if(animationplayed == 5) ApplyAnimation(playerid,"benchpress","gym_bp_geton",4.0, false, false, false, true, false, SYNC_ALL);
		else if(animationplayed == 6) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_geton",4.2, false, false, false, true, false, SYNC_ALL);
		else if(animationplayed == 7) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_geton",4.2, false, false, false, true, false, SYNC_ALL);
	}
	else SendClientMessage(playerid,0xFF0000FF,">Пишите /animset [1-7]");
	return 1;
}
//----------------------------------[Shout]-----------------------------------------------
CMD:s(playerid, const params[])
{
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1 || CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Ваш персонаж спит или чем-то занят");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кричать [ /s текст ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	format(string, sizeof(string), "%s кричит: %s!!", playername(playerid), params[0]);
	ProxDetectorScream(30.0, playerid, string,COLOR_WHITE,COLOR_WHITE,COLOR_WHITE,COLOR_FADE1,COLOR_FADE2, COLOR_FADE5);
	SetPlayerChatBubble(playerid,params[0],COLOR_TALK_PLAYER,30.0,10000);
	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"ON_LOOKERS","shout_in",4.0, false, true, true, false, false, SYNC_ALL);
	return 1;
}
CMD:wh(p, const params[])
{
	if(GetPlayerState(p) == PLAYER_STATE_SPECTATING && PlayerInfo[p][pSoska] == 0) return ErrorMessage(p, "{FF6347}Вы находитесь в слежке");
	new string[144];
	if(isamute(p) == 1) return 1;
	new tmp[144], s;
	if(!sscanf(params,"p<*>s[144]i",tmp,s))
	{
	    if(!IsOnline(s)) return ErrorMessage(p, "{FF6347}Этого игрока нет в сети");
		if(GetPlayerState(s) == PLAYER_STATE_SPECTATING && gSpectateID[s] != INVALID_PLAYER_ID || !ProxDetectorS(3.0, p,s)) return ErrorMessage(p, "{FF6347}Вы далеко от игрока");
		if(AntiFloodText(p, tmp)) return 1;
		
		format(string, sizeof(string), "Я шепчу на ухо %s[%d]: %s", playername(s),s,tmp);
		SendClientMessage(p, COLOR_FADE5, string);
		format(string, sizeof(string), "%s[%d] шепчет на ухо: %s", playername(p),p,tmp);
		SendClientMessage(s, COLOR_FADE5, string);
		format(string, sizeof(string), "что-то шепчет на ухо %s", playername(s));
		SetPlayerChatBubble(p, string,COLOR_TALK_PLAYER,20.0,10000);
	}
	else if(!sscanf(params, "s[144]",tmp))
	{
		if(AntiFloodText(p, tmp)) return 1;
		format(string, sizeof(string), "%s шепчет[%d]: %s", playername(p),p, tmp);
		ProxDetector(8.0, p, string,COLOR_FADE3,COLOR_FADE3,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
		SetPlayerChatBubble(p,"что-то шепчет",COLOR_TALK_PLAYER,20.0,10000);
	}
	else SendClientMessage(p,COLOR_GREY,"[ Мысли ]: Шептать [ /wh текст ] [ Шептать определённому человеку: *ID после текста ]");
	return 1;
}
//----------------------------------[Shout]-----------------------------------------------
CMD:m(playerid, const params[])
{
	if(GetPVarInt(playerid,"antiflood") > 0) return ErrorMessage(playerid, "{FF6347}Пожалуйста, не флудите [ 1 раз 3 секунды ]");
	if(!IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не за рулём служебного транспорта департамента");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Громкоговоритель [ /m текст ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	new v = GetPlayerVehicleID(playerid);
	if(v >= LSPDcar[0] && v <= LSPDcar[1] || v >= armcar[0] && v <= armcar[1] || v >= fbicar[0] && v <= fbicar[1]
	|| v >= swatcar[0] && v <= swatcar[1] || v == janswat[0] || v == janswat[1] || v == janswat[2] || v == janswat[3] || v >= SFPDcar[0] && v <= SFPDcar[1] || Cars[v] == 4 || Cars[v] == 3
	|| v >= NonLSCar[0] && v <= NonLSCar[1] || v >= NonSFCar[0] && v <= NonSFCar[1] || Cars[v] == 1 || Cars[v] == 11 || Cars[v] == 21 || Cars[v] == 22 || Cars[v] == 2 || Cars[v] == 28
	|| v >= Medcar[0] && v <= Medcar[1])
	{
	    if(PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 3 || PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pFbi]>=1
		|| PlayerInfo[playerid][pMember] == 11 || PlayerInfo[playerid][pLeader] == 11 || PlayerInfo[playerid][pMember] == 21 || PlayerInfo[playerid][pLeader] == 21 || PlayerInfo[playerid][pMember] == 4 || PlayerInfo[playerid][pLeader] == 4
 		|| PlayerInfo[playerid][pMember] == 22 || PlayerInfo[playerid][pLeader] == 22)
		{
			if(PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 11 || PlayerInfo[playerid][pLeader] == 11
		 	|| PlayerInfo[playerid][pMember] == 21 || PlayerInfo[playerid][pLeader] == 21) format(string, sizeof(string), "[Полицейский %s:-- %s]", PlayerInfo[playerid][pName], params[0]);
			else if(PlayerInfo[playerid][pMember] == 2||PlayerInfo[playerid][pLeader] == 2) format(string, sizeof(string), "[Агент %s:-- %s]", PlayerInfo[playerid][pName], params[0]);
			else if(PlayerInfo[playerid][pMember] == 3||PlayerInfo[playerid][pLeader] == 3) format(string, sizeof(string), "[Военный %s:-- %s]", PlayerInfo[playerid][pName], params[0]);
			else if(PlayerInfo[playerid][pMember] == 4||PlayerInfo[playerid][pLeader] == 4) format(string, sizeof(string), "[ASGH %s:-- %s]", PlayerInfo[playerid][pName], params[0]);
			else if(PlayerInfo[playerid][pMember] == 22||PlayerInfo[playerid][pLeader] == 22) format(string, sizeof(string), "[SWAT %s:-- %s]", PlayerInfo[playerid][pName], params[0]);
			ProxDetectorScream(60.0, playerid, string, COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW);
			format(string, sizeof(string), "{FFFFFF}[ {FFFF00}%s {FFFFFF}]",params[0]);
			SetPlayerChatBubble(playerid,string,COLOR_GREY,30.0,7000);
			SetPVarInt(playerid,"antiflood",3);
		}
		else ErrorMessage(playerid, "{FF6347}Вы не можете использовать громкоговоритель в транспорте");
	}
	else ErrorMessage(playerid, "{FF6347}Вы не за рулём служебного транспорта департамента");
	return 1;
}
stock dokaerols(playerid)
{
	new botid;
	if(IsPlayerInRangeOfPoint(playerid,3.0,1739.9813,-2421.0430,13.5767)) botid = 243;
	else if(IsPlayerInRangeOfPoint(playerid,3.0,1739.9819,-2425.4553,13.5767)) botid = 244;
	else if(IsPlayerInRangeOfPoint(playerid,3.0,1739.9834,-2429.8330,13.5767)) botid = 245;

	else if(IsPlayerInRangeOfPoint(playerid,3.0,1582.8757,1423.6699,10.8726)) botid = 98;
	else if(IsPlayerInRangeOfPoint(playerid,3.0,1578.5564,1423.7529,10.8726)) botid = 99;
	else if(IsPlayerInRangeOfPoint(playerid,3.0,1574.1172,1423.6882,10.8726)) botid = 107;

	if(botid)
	{
		SendDynamicActorMessage(playerid, BotPears[botid], "Здравствуйте. Добро пожаловать в наш штат");
		new Float:pos[3];
		GetDynamicActorPos(BotPears[botid], pos[0], pos[1], pos[2]);
		PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/aero_control/girl0.mp3",pos[0], pos[1], pos[2],6.0,true);
	}

	PlayerInfo[playerid][pQuest][0] = 1;
    SaveQuest(playerid);
	if(PlayerInfo[playerid][pKomnataCity] == 3) SuccessMessage(playerid, "{99ff66}Отлично! Добро пожаловать в Las Venturas\n\n{ff9000}Отправляйтесь на улицу и найдите отель для проживания\nВыход слева от паспортного контроля");
    else SuccessMessage(playerid, "{99ff66}Отлично! Добро пожаловать в Los Santos\n\n{ff9000}Отправляйтесь на улицу и найдите отель для проживания\nВыход слева от паспортного контроля");
    ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false);
	return 1;
}
CMD:zaim(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,3.0, 1625.8187,-2295.5776,13.5372) || IsPlayerInRangeOfPoint(playerid,3.0, 1736.7946,1408.7692,10.8467))
 	{
		new botId = 36;
		if(IsPlayerInRangeOfPoint(playerid,3.0, 1736.7946,1408.7692,10.8467)) botId = 80;

 	    ApplyAnimation(playerid,"PED","endchat_03",4.0, false, true, true, false, false);
		if(PlayerInfo[playerid][pLevel] <= 5)
		{
			if(oGetPlayerMoney(playerid) > 1000) return ErrorMessage(playerid, "{FF6347}Он помогает только нищим {cccccc}[ Деньги выдаются на проезд до работы ]");
			if(Zaim[playerid] == true) return ErrorMessage(playerid, "{FF6347}Вам уже выдавали в займы денег");
			oGivePlayerMoney(playerid, 1000);
			Zaim[playerid] = true;
			ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","\n{cccccc}Незнакомец помог мне и дал {99ff66}1000$\n","Oк","");
			PlayerPlaySound(playerid,6401,0,0,0);
			SendDynamicActorMessage(playerid, BotPears[botId],"Держи, дружище!");
		}
		else ErrorMessage(playerid, "{FF6347}Он помогает только приезжим {cccccc}[ Вы давно проживаете в этом штате ]");
	}
	return 1;
}
CMD:dps(playerid, const params[])
{
    if(IsPlayerInRangeOfPoint(playerid,1.5,66.0064,-1534.9113,5.1525))
	{
		if(PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 11 || PlayerInfo[playerid][pLeader] == 11
		|| PlayerInfo[playerid][pMember] == 21 || PlayerInfo[playerid][pLeader] == 21 || PlayerInfo[playerid][pMember] == 22 || PlayerInfo[playerid][pLeader] == 22)
		{
			if(PlayerInfo[playerid][pRank] <= 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу закрывать блок пост [ 4+ Ранг ]");
	        PlayerPlaySound(playerid,40405,0,0,0);
	        new str[100],sctring[200];
			if(dpsdoor[0] == 0) format(str,sizeof(str),"{0088ff}* {FFffff}Правая Полоса {00cc00}[ Открыта ]\n");
			else if(dpsdoor[0] == 1) format(str,sizeof(str),"{0088ff}* {FFffff}Правая Полоса {ff0000}[ Закрыта ]\n");
			strcat(sctring,str);
			if(dpsdoor[1] == 0) format(str,sizeof(str),"{0088ff}* {FFffff}Левая Полоса {00cc00}[ Открыта ]\n");
			else if(dpsdoor[1] == 1) format(str,sizeof(str),"{0088ff}* {FFffff}Левая Полоса {ff0000}[ Закрыта ]\n");
			strcat(sctring,str);
	    	ShowDialog(playerid,599,DIALOG_STYLE_LIST,"{0088ff}КПП LS-1",sctring,"Выбрать","Отмена");
  		}
	    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не работаю в полиции");
   	}
   	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1676.2721,-742.5251,41.8554))
	{
		if(PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 11 || PlayerInfo[playerid][pLeader] == 11
		|| PlayerInfo[playerid][pMember] == 21 || PlayerInfo[playerid][pLeader] == 21 || PlayerInfo[playerid][pMember] == 22 || PlayerInfo[playerid][pLeader] == 22)
		{
			if(PlayerInfo[playerid][pRank] <= 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу закрывать блок пост [ 4+ Ранг ]");
	        PlayerPlaySound(playerid,40405,0,0,0);
	        new str[100],sctring[200];
			if(dpsdoor[2] == 0) format(str,sizeof(str),"{0088ff}* {FFffff}Правая Полоса {00cc00}[ Открыта ]\n");
			else if(dpsdoor[2] == 1) format(str,sizeof(str),"{0088ff}* {FFffff}Правая Полоса {ff0000}[ Закрыта ]\n");
			strcat(sctring,str);
			if(dpsdoor[3] == 0) format(str,sizeof(str),"{0088ff}* {FFffff}Левая Полоса {00cc00}[ Открыта ]\n");
			else if(dpsdoor[3] == 1) format(str,sizeof(str),"{0088ff}* {FFffff}Левая Полоса {ff0000}[ Закрыта ]\n");
			strcat(sctring,str);
	    	ShowDialog(playerid,829,DIALOG_STYLE_LIST,"{0088ff}КПП SF-1",sctring,"Выбрать","Отмена");
  		}
	    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не работаю в полиции");
   	}
   	return 1;
}
CMD:shocker(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,3.0,1382.6935,1.2603,1000.9217) && GetPlayerInterior(playerid) == 5 && GetPlayerVirtualWorld(playerid) == 9 || IsPlayerInRangeOfPoint(playerid,2.0,1233.5215,-1415.9601,2001.0491))
	{
		if(PlayerInfo[playerid][pMember] == 4 && PlayerInfo[playerid][pRank] >= 2 || PlayerInfo[playerid][pLeader] == 4)
		{
			new string[144], weapons[2];
			GetPlayerWeaponData(playerid, WEAPON_SLOT:2, WEAPON:weapons[0], weapons[1]);
			new sl = Protect_Slot(23);
			if(GetPlayerWeaponInSlotAll(playerid, 24, sl) 
				|| GetPlayerWeaponInSlotAll(playerid, 22, sl)) return ErrorMessage(playerid, "{FF6347}У вас в руках уже оружие такого-же типа как электрошокер\n{cccccc}Deagle или Colt");
			if(OnDuty[playerid] == 10 && GetPlayerWeaponInSlotAll(playerid, 23, 2)) return ErrorMessage(playerid, "{FF6347}У вас есть электрошокер и он полностью заряжен");
			if(weapons[0] == 23 && weapons[1] >= 10000) { }
			else Protect_GiveWeapons(playerid, 23, 15000, 0, 0);
			OnDuty[playerid] = 10;
			format(string, sizeof(string), "* %s достаёт электрошокер из шкафчика", playername(playerid));
			ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		}
	}
	return 1;
}
CMD:duty(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,1.0,1567.8888,-1650.7128,16.2338) && GetPlayerVirtualWorld(playerid) == 255 || IsPlayerInRangeOfPoint(playerid,1.0,2544.0002,915.3004,1551.0039)
	|| IsPlayerInRangeOfPoint(playerid,1.0,-2005.2168,152.2048,1666.0313) || IsPlayerInRangeOfPoint(playerid,1.0,85.7679,-1557.3619,7.4719)
	|| IsPlayerInRangeOfPoint(playerid,1.0,-1583.8354,697.4504,13.9038) && GetPlayerVirtualWorld(playerid) == 209
	|| IsPlayerInRangeOfPoint(playerid,1.0,-1676.9396,-744.5724,41.8554))
	{
		if(PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi]>=1
		|| PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pMember] == 3 || PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 || PlayerInfo[playerid][pMember] == 11 || PlayerInfo[playerid][pLeader] == 11
	 	|| PlayerInfo[playerid][pMember] == 21 || PlayerInfo[playerid][pLeader] == 21|| PlayerInfo[playerid][pMember] == 22 || PlayerInfo[playerid][pLeader] == 22)
		{
			PlayerPlaySound(playerid,40405,0,0,0);
    		ShowDialog(playerid,863,DIALOG_STYLE_LIST,"{444444}Инвентарь Силовых Структур","{cccccc}Выстреливающий Электрошокер\n{cccccc}Ручной Электрошокер\n{cccccc}Рация","Выбор","Отмена");
		}
	}
	return 1;
}
stock aget_exam(playerid, stat)
{
	new net = 0;
	if(stat == 0)
	{
	    if(Exam[playerid] == 1) ShowDialog(playerid,1226,DIALOG_STYLE_MSGBOX,"{ff9000}Образовательный Центр","\n{cccccc}Вы уверены, что хотите начать экзамен для получения {ff9000}водительских прав?\n","Да","Нет");
	    else if(Exam[playerid] == 4) ShowDialog(playerid,1226,DIALOG_STYLE_MSGBOX,"{ff9000}Образовательный Центр","\n{cccccc}Вы уверены, что хотите начать экзамен для получения {ff9000}лицензии на мототранспорт?\n","Да","Нет");
	    else net = 1;
	}
    else if(stat == 1)
	{
	    if(Exam[playerid] == 2) ShowDialog(playerid,1226,DIALOG_STYLE_MSGBOX,"{ff9000}Образовательный Центр","\n{cccccc}Вы уверены, что хотите начать экзамен для получения {ff9000}лицензии пилота?\n","Да","Нет");
	    else net = 1;
	}
	else if(stat == 2)
	{
	    if(Exam[playerid] == 3) ShowDialog(playerid,1226,DIALOG_STYLE_MSGBOX,"{ff9000}Образовательный Центр","\n{cccccc}Вы уверены, что хотите начать экзамен для получения {ff9000}лицензии на управление водным транспортом?\n","Да","Нет");
	    else net = 1;
	}
	if(net == 1) ErrorMessage(playerid, "{FF6347}Это терминал для аренды транспорта образовательного центра {cccccc}[ Y >> GPS >> Образовательный Центр ]\n\n{cccccc}Чтобы начать экзамен, вам нужно подойти к преподавателю");
	return 1;
}
stock prepod(playerid)
{
	if(PlayerInfo[playerid][pBuyoc] <= 0) return ErrorMessage(playerid, "{FF6347}Вы не оплатили обучение {cccccc}[ Это можно сделать на первом этаже образовательного центра ]");
	if(PlayerInfo[playerid][pStopoc] > gettime()) return ErrorMessage(playerid, "{FF6347}Вы недавно обучались в образовательном цетре [ Доступно 1 раз в час /time ]");
	new fpick, string[254];
	if(PlayerInfo[playerid][pBuyoc] >= 1 && PlayerInfo[playerid][pBuyoc] <= 4) // Лицензии
	{
	    new Float:myskill, kniga;
	    if(PlayerInfo[playerid][pBuyoc] == 1) myskill = PlayerInfo[playerid][pCarLic], kniga = 145, fpick = 156;
	    if(PlayerInfo[playerid][pBuyoc] == 2) myskill = PlayerInfo[playerid][pFlyLic], kniga = 146, fpick = 157;
	    if(PlayerInfo[playerid][pBuyoc] == 3) myskill = PlayerInfo[playerid][pBoatLic], kniga = 148, fpick = 158;
	    if(PlayerInfo[playerid][pBuyoc] == 4) myskill = PlayerInfo[playerid][pMotoLic], kniga = 149, fpick = 159;
	    
	    if(myskill <= 99)
		{
		    if(get_invent2(playerid, kniga, 0) >= 1) return format(string, sizeof(string), "{99ff66}Отлично! Вы взяли учебник: %s\n\n{cccccc}Займите свободное место в аудитории", friskName[kniga]), SuccessMessage(playerid, string);
		    format(string, sizeof(string), "{FF6347}В коридоре есть библиотека. Возьмите там учебник: {ff9000}%s\n\n{cccccc}После чего возвращайтесь и займите свободное место в аудитории", friskName[kniga]), ErrorMessage(playerid, string);
			CreateGps(playerid,1474.7869,-1804.5490,21.0982, 196, 0, 5.0);
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно найти библиотеку и взять учебник: {ff9000}%s", friskName[kniga]);
		}
		else
		{
		    if(PlayerInfo[playerid][pProgless] == 0) // Не сдавал экзамен
		    {
		        if(PlayerInfo[playerid][pBuyoc] == 1 || PlayerInfo[playerid][pBuyoc] == 4)
		        {
		        	Lesson[playerid] = PlayerInfo[playerid][pBuyoc];
		        	SuccessMessage(playerid, "{99ff66}Отлично! Вы можете приступить к экзамену\n\n{ff9000}Займите свободное место в аудитории, чтобы начать экзамен");
	        	}
	        	else PlayerInfo[playerid][pProgless] = 1;
		    }
		    if(PlayerInfo[playerid][pProgless] == 1)
			{
   				Lesson[playerid] = 0;
                Exam[playerid] = PlayerInfo[playerid][pBuyoc];
                format(string, sizeof(string), "{99ff66}Вы можете приступить к практическому экзамену: {ff9000}%s\n\nДля этого отправляйтесь к терминалу аренды учебного транспорта\n\n{99ff66}Терминал для аренды {cccccc}[ Отмечен красной {FF6347}GPS Меткой {cccccc}]", ocName[PlayerInfo[playerid][pBuyoc]]), SuccessMessage(playerid, string);
                SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно отправиться к терминалу для аренды транспорта, чтобы начать экзамен");
                if(PlayerInfo[playerid][pBuyoc] == 1 || PlayerInfo[playerid][pBuyoc] == 4) CreateGps(playerid,1500.1600,-1764.5048,13.6153, 0, 0, 10.0);
                else if(PlayerInfo[playerid][pBuyoc] == 2) CreateGps(playerid,1981.8650,-2219.1890,13.5469, 0, 0, 10.0);
                else if(PlayerInfo[playerid][pBuyoc] == 3) CreateGps(playerid,2303.2781,-2387.8623,13.5688, 0, 0, 10.0);
			}
			if(PlayerInfo[playerid][pProgless] == 2)
			{
			    new put_inva = GiveThingPlayer(playerid, fpick, 1, PlayerInfo[playerid][pID], 0, 0, 0, 9999);
    			if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре");
			    
			    Exam[playerid] = 0;
			    PlayerInfo[playerid][pBuyoc] = 0, PlayerInfo[playerid][pProgless] = 0, PlayerInfo[playerid][pStopoc] = gettime()+3600;
			    ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
			    format(string, sizeof(string), "{99ff66}Поздравляю! Вы успешно сдали все экзамены. Вот ваши документы: {ff9000}%s", friskName[fpick]), SuccessMessage(playerid, string);
			    
			    mysql_save(playerid, 70);
			    if(fpick == 156)
			    {
			    	if(PlayerInfo[playerid][pAchieve][4] == 0) AchievePlayer(playerid, 4, 1);
		    	}
		    	if(PlayerInfo[playerid][pAchieve][97] == 0)
				{
				    new mylic[6];
					mylic[0] = get_lic(playerid, 156);
					mylic[1] = get_lic(playerid, 157);
					mylic[2] = get_lic(playerid, 158);
					mylic[3] = get_lic(playerid, 159);
					mylic[4] = get_lic(playerid, 162);
					mylic[5] = get_lic(playerid, 160);
					if(mylic[0] > 0 && mylic[1] > 0 && mylic[2] > 0 && mylic[3] > 0 && mylic[4] > 0 && mylic[5] > 0) AchievePlayer(playerid, 97, 1);
				}
			}
		}
	}
	else if(PlayerInfo[playerid][pBuyoc] == 7) // Высшее Образование
	{
		fpick = 160;
	    if(PlayerInfo[playerid][pProgless] == 0)
	    {
     		Lesson[playerid] = PlayerInfo[playerid][pBuyoc];
       		SuccessMessage(playerid, "{99ff66}Вы сразу можете приступить к экзамену\n\n{cccccc}Займите свободное место в аудитории, чтобы начать");
	    }
	    else
	    {
	    	new put_inva = GiveThingPlayer(playerid, fpick, 1, PlayerInfo[playerid][pID], 0, 0, 0, 9999);
   			if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре");
	    
		    Exam[playerid] = 0;
		    PlayerInfo[playerid][pBuyoc] = 0, PlayerInfo[playerid][pProgless] = 0, PlayerInfo[playerid][pStopoc] = gettime()+3600;
		    ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		    format(string, sizeof(string), "{99ff66}Поздравляю! Вы успешно сдали экзамен. Вот ваши документы: {ff9000}%s", friskName[fpick]), SuccessMessage(playerid, string);
		    
		    mysql_save(playerid, 70);
	    }
	}
	else if(PlayerInfo[playerid][pBuyoc] >= 8 && PlayerInfo[playerid][pBuyoc] <= 13) // Языки
	{
	    new kniga;
	    if(PlayerInfo[playerid][pBuyoc] == 8) kniga = 150;
	    if(PlayerInfo[playerid][pBuyoc] == 9) kniga = 151;
	    if(PlayerInfo[playerid][pBuyoc] == 10) kniga = 152;
	    if(PlayerInfo[playerid][pBuyoc] == 11) kniga = 153;
	    if(PlayerInfo[playerid][pBuyoc] == 12) kniga = 154;
	    if(PlayerInfo[playerid][pBuyoc] == 13) kniga = 155;
	    if(get_invent2(playerid, kniga, 0) >= 1) return format(string, sizeof(string), "{99ff66}Отлично! Вы взяли учебник: %s\n\n{cccccc}Займите свободное место в аудитории", friskName[kniga]), SuccessMessage(playerid, string);
	    format(string, sizeof(string), "{FF6347}В коридоре есть библиотека. Возьмите там учебник: {ff9000}%s\n\n{cccccc}После чего возвращайтесь и займите свободное место в аудитории", friskName[kniga]), ErrorMessage(playerid, string);
		CreateGps(playerid,1474.7869,-1804.5490,21.0982, 196, 0, 5.0);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно найти библиотеку и взять учебник: {ff9000}%s", friskName[kniga]);
	}
	return 1;
}
stock library(playerid)
{
    if(PlayerInfo[playerid][pStopoc] > gettime()) return ErrorMessage(playerid, "{FF6347}Вы недавно обучались в образовательном цетре [ Доступно 1 раз в час /time ]");
	new str[76],sctring[724];
	format(str,sizeof(str),"{cccccc}Учебник ПДД \t {444444}Правила дорожного движения"), strcat(sctring,str);
