// Получаем вирт мир динамической зоны
function GetDynamicAreaVirtualWorld(areaid) return Streamer_GetIntData(STREAMER_TYPE_AREA, areaid, E_STREAMER_WORLD_ID);

// Получаем инт динамической зоны
function GetDynamicAreaInterior(areaid) return Streamer_GetIntData(STREAMER_TYPE_AREA, areaid, E_STREAMER_INTERIOR_ID);

// Получаем вирт мир динамического объекта
function GetDynamicObjectVirtualWorld(objectid) return Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_WORLD_ID);
// Изменяем вирт мир динамического объекта
function SetDynamicObjectVirtualWorld(objectid, worldid) return Streamer_SetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_WORLD_ID, worldid);

// Изменяем инт динамического объекта
function SetDynamicObjectInterior(objectid, interiorid) return Streamer_SetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_INTERIOR_ID, interiorid);

// Получаем интерьер динамического объекта
function GetDynamicObjectInterior(objectid) return Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_INTERIOR_ID);
// Получаем модель динамического объекта
function GetDynamicObjectModel(objectid) return Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_MODEL_ID);
// Получаем цвет в слоте материала динамического объекта
function GetDynamicObjectColor(objectid, materialindex) {
	new materialid, txdname[2], texturename[2], materialcolor;
	GetDynamicObjectMaterial(objectid, materialindex, materialid, txdname, texturename, materialcolor);
	return materialcolor;
}
// Изменяем цвет в слоте материала динамического объекта
function SetDynamicObjectColor(objectid, materialindex, color) {
	if (IsDynamicObjectMaterialTextUsed(objectid, materialindex)) return 1;
	new materialid, txdname[64], texturename[64], materialcolor;
	GetDynamicObjectMaterial(objectid, materialindex, materialid, txdname, texturename, materialcolor);
	RemoveDynamicObjectMaterial(objectid, materialindex);
	
	if (materialid <= 0) materialid = 0;

	if (!isnull(txdname)) {
		SetDynamicObjectMaterial(objectid, materialindex, materialid, txdname, texturename, color);
	}

	return 1;
}

