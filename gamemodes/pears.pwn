	cAttack, // ID Банды, которая нападает
	cDefend, // ID Банды, которая защищается
	cQuanityA, // Количество нападающих в квадрате сейчас
	cQuanityD, // Количество защищающихся в квадрате сейчас
	cKillA, // Количество убийств нападающих в квадрате
	cKillD, // Количество убийств защищающихся в квадрате
	cPresenceA, // Текущее присутствие нападающих в квадрате
	cPresenceD, // Текущее присутствие защищающихся в квадрате

	// Статистика для Лога
	cLogQuanA, // Максимальное количество нападающих в квадрате
	cLogQuanD, // Максимальное количество защищающихся в квадрате
