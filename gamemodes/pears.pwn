static CheckOutputLimit(Float:data, Float:max, Float:min = 0.0, bool:check = false)
{
	if(floatcmp(floatabs(data), max) > 0 || check && floatcmp(data, min) < 0) return 1;
	return 0;
}

IPacket:SPEC_SYNC(playerid, BitStream:bs)
{
	// NPC пропускаем пакеты
	if(IsARealNPC(playerid)) return true;

	if(OnlineInfo[playerid][oLogged] == 0 || OnlineInfo[playerid][oKickTimer] > 0) return false;

	new spectatingData[PR_SpectatingSync];
    BS_IgnoreBits(bs, 8);
    BS_ReadSpectatingSync(bs, spectatingData);

	if(!IsValidFloat(spectatingData[PR_position][0]) || !IsValidFloat(spectatingData[PR_position][1]) || !IsValidFloat(spectatingData[PR_position][2])) return false;

	if(OnlineInfo[playerid][oSpec] == false) return false;
	return true;
}

IPacket:AIM_SYNC(playerid, BitStream:bs)
{
	// NPC пропускаем пакеты
	if(IsARealNPC(playerid)) return true;

	if(OnlineInfo[playerid][oLogged] == 0 || OnlineInfo[playerid][oKickTimer] > 0) return false;

    new aimData[PR_AimSync];
    BS_IgnoreBits(bs, 8); // packet id (byte)
    BS_ReadAimSync(bs, aimData);

    if(!IsValidFloat(aimData[PR_aimZ])) return false; // is NaN

    if(!IsValidFloat(aimData[PR_camFrontVec][0]) || !IsValidFloat(aimData[PR_camFrontVec][1]) || !IsValidFloat(aimData[PR_camFrontVec][2])) return false;

    if(CheckOutputLimit(aimData[PR_camFrontVec][0], 1.0) || CheckOutputLimit(aimData[PR_camFrontVec][1], 1.0) || CheckOutputLimit(aimData[PR_camFrontVec][2], 1.0))
    {
        return false;
    }

    if(!IsValidFloat(aimData[PR_camPos][0]) || !IsValidFloat(aimData[PR_camPos][1]) || !IsValidFloat(aimData[PR_camPos][2])) return false;

    if(CheckOutputLimit(aimData[PR_camPos][0], 20000.0) || CheckOutputLimit(aimData[PR_camPos][1], 20000.0) || CheckOutputLimit(aimData[PR_camPos][2], 20000.0))
    {
        return false;
    }
    if(!IsValidFloat(aimData[PR_aimZ])) return false;

    if(CheckOutputLimit(aimData[PR_aimZ], 1.51))
    {
        return false;
    }

	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	if(!IsValidFloat(pos[0]) || !IsValidFloat(pos[1]) || !IsValidFloat(pos[2])) return false;

	new Float:dist;
	dist = GetDistancePoint(aimData[PR_camPos][0],aimData[PR_camPos][1],aimData[PR_camPos][2], pos[0], pos[1], pos[2]);
	if(dist >= 20.0) return false;

	// Блочим говнотряску говнокамеры
	if(aimData[PR_camMode] == 45) return false;
    return true;
}

// Custom Damage Слава
IRPC:115(playerid, BitStream:bs) 
{
	new bool: type, id, Float: damage, weaponid, bodypart;
	BS_ReadValue(bs,
		PR_BOOL, type,
		PR_UINT16, id,
		PR_FLOAT, damage,
		PR_UINT32, weaponid,
		PR_UINT32, bodypart
	);
	if (type) // true - получение урона (типо TakeDamage)
	{
		// Если урон получен вследствие взрыва - отправить его на обработку
		if (weaponid == 51) PlayerGiveDamageHandler(playerid, playerid, damage, weaponid, bodypart);

		// Тестовое чтение дамага (хочу увидеть чё каво чё куда)
		if(readdam == true)
		{
			SendClientMessageToAll(-1, "OnPlayerTakeDamage playerid %d (team %d), damage %.2f, weaponid %d", 
				playerid, GetPlayerTeam(playerid), damage, weaponid);
		}
	}
	else
	{
		// Тестовое чтение дамага (хочу увидеть чё каво чё куда)
		if(readdam == true)
		{
			SendClientMessageToAll(-1, "OnPlayerGiveDamage playerid %d (team %d), damage %.2f, weaponid %d", 
				playerid, GetPlayerTeam(playerid), damage, weaponid);
		}
	}
	return 1;
}
//===================================
//===================================

stock IsOnline(p)
{
	if(p >= 0)
	{
		if(IsPlayerConnected(p))
		{
			if(OnlineInfo[p][oLogged] == 1) return 1;
		}
	}
	return 0;
}


stock tazerplayer(p, s)
{
    if(OnlineInfo[s][oShowInterface] == 1) CloseFrisk(s), CancelSelectTextDraw(s);
	if(OnlineInfo[s][oShowInterface] == 2) CloseSmartfon(s), CancelSelectTextDraw(s);

	SendClientMessage(s, COLOR_LIGHTBLUE, "* Вы были парализованы %s на 25 секунд.", PlayerInfo[p][pName]);
	Stun[3][s] = 1;
	StunTime[3][s] = 25;
	PlayerPlaySound(s, 6003, 0.0, 0.0, 0.0);
	SetPlayerAttachedObject(s, 0, 18670, 1, -0.100000, -0.100000, -1.570000, -2.000000, 0.000000, 200.000000);
	NoAnim[s] = 1;
	GameTextForPlayer(s, RusToGame("~r~ВЫ ПАРАЛИЗОВАНЫ"), 2500, 3);
	ShowDialog(s, 1742, 0, "{FF0000}********** ЭЛЕКТРОШОК **********", "{FF0000}!**  Вы были парализованы Электрошоком  **!", "OK", "");
	SetPlayerChatBubble(s,"А-а-а-а-а-а!!!",COLOR_RED,45.0,10000);
	TogglePlayerControllable(s, false);
	ApplyAnimation(s,"CRACK","crckdeth2",4.0, false, true, true, true, true);
	if(IsPoliceMember(p) || PlayerInfo[p][pFbi] >= 1) CuffedId[s] = p;
}
stock kani(p)
{
	if(Dei[p] == 0)
	{
		if(Hand[p] >= 1 || Hold[p] >= 1 || GetPlayerWeapon(p) >= WEAPON:2) return ErrorMessage(p, "{FF6347}У вас заняты руки [Предмет или оружие]");
		SetPlayerAttachedObject(p, 1, 1650, 6, 0.150000, 0.023000, 0.030000, 0.000000, -100.000000, -5.000000), ShowDialog(p,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Подойдите к бензобаку и нажмите кнопку {ff9000}Y или /fillcar или ALT > Заправить машину","*","");
		Dei[p] = 8, DeiStat[p] = 0, PlayerPlaySound(p,5600,0,0,0);
	}
	else if(Dei[p] == 8) Dei[p] = 0, RemovePlayerAttachedObject(p,1), PlayerPlaySound(p,5601,0,0,0);
	else ErrorMessage(p, "{FF6347}У вас заняты руки [Предмет или оружие]");
    return 1;
}
stock gelium(p)
{
	if(Dei[p] == 0)
	{
		if(Hand[p] >= 1 || Hold[p] >= 1 || GetPlayerWeapon(p) >= WEAPON:2) return ErrorMessage(p, "{FF6347}У вас заняты руки [Предмет или оружие]");
		SetPlayerAttachedObject(p, 1, 2976, 6, 0.140999, 0.020999, -0.190999, 0.000000, 0.000000, 0.000000, 0.569000, 0.570000, 0.591999, 0, 0), ShowDialog(p,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Подойдите к бензобаку и нажмите кнопку {ff9000}Y или /fillcar или ALT > Заправить машину\n\n{99ff66}Гелий-3 позволяет в 4 раза медленнее потреблять топливо в транспорте","*","");
		Dei[p] = 12, DeiStat[p] = 0, PlayerPlaySound(p,5600,0,0,0);
	}
	else if(Dei[p] == 12) Dei[p] = 0, RemovePlayerAttachedObject(p,1), PlayerPlaySound(p,5601,0,0,0);
	else ErrorMessage(p, "{FF6347}У вас заняты руки [Предмет или оружие]");
    return 1;
}
stock fine_time(t)
{
	new time[10];
	new tmin = t/60;
	new tsek = t-tmin*60;
	format(time,sizeof(time),"%02d:%02d", tmin, tsek);
	return time;
}
