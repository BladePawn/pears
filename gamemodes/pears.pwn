stock nasa_box(playerid, stat, m)
{
	if(stat == 0 || stat == 1 || stat == 3)
	{
		if(stat == 0) ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 2.0, false, false, false, false, false, SYNC_ALL), GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~Done",3000,3), PlayerPlaySound(playerid,6401,0,0,0);
		SetPVarInt(playerid,"LoadBack",GetPVarInt(playerid,"LoadBack")+1);
		SetPVarInt(playerid,"oryjtemp",0);
		if(GetPVarInt(playerid,"LoadBack") == 1) SetPlayerAttachedObject(playerid, 5, 2977, 1, 0.217, -0.0350, 0.000000, 90.0, 0.000000, 0.000000, 0.265000, 0.369999, 0.241000, 0, 0);
		else if(GetPVarInt(playerid,"LoadBack") == 2) SetPlayerAttachedObject(playerid, 6, 2977, 1, -0.081, -0.0350, 0.000000, 90.0, 0.000000, 0.000000, 0.265000, 0.369999, 0.241000, 0, 0);
		else if(GetPVarInt(playerid,"LoadBack") == 3) SetPlayerAttachedObject(playerid, 7, 2977, 1, 0.217, -0.2880, 0.000000, 90.0, 0.000000, 0.000000, 0.265000, 0.369999, 0.241000, 0, 0);
		else if(GetPVarInt(playerid,"LoadBack") == 4) SetPlayerAttachedObject(playerid, 8, 2977, 1, -0.081, -0.2880, 0.000000, 90.0, 0.000000, 0.000000, 0.265000, 0.369999, 0.241000, 0, 0);
		else if(GetPVarInt(playerid,"LoadBack") == 5) SetPlayerAttachedObject(playerid, 9, 2977, 1, 0.500, -0.1200, 0.000000, 90.0, 0.000000, 0.000000, 0.265000, 0.369999, 0.241000, 0, 0);
		// Перетасовка Кислорода
		if(gSkafandr[playerid] > 0)
		{
			if(GetPVarInt(playerid,"LoadBack") >= 1 && GetPVarInt(playerid,"LoadBack") <= 2)
			{
				RemovePlayerAttachedObject(playerid,4);
				SetPlayerAttachedObject(playerid, 4, 1010, 1, 0.075000, -0.318, 0.002000, 90.0, 0.000000, 179.700088, 0.817000, 1.000000, 0.901000, 0, 0);
			}
			else if(GetPVarInt(playerid,"LoadBack") >= 3 && GetPVarInt(playerid,"LoadBack") <= 4)
			{
				RemovePlayerAttachedObject(playerid,4);
				SetPlayerAttachedObject(playerid, 4, 1010, 1, 0.075000, -0.567, 0.000000, 90.0, 0.000000, 179.700088, 0.817000, 1.000000, 0.901000, 0, 0);
			}
		}
		if(stat == 1) 
		{
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{00cc00}*","{99ff66}Вы разбили метеорит и нашли в нём: {444444}Базальт","*","");

			// Собирать базальт
			CompletingDaily(playerid, 7, 1);
		}
		else if(stat == 3)
		{
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{00cc00}*","{99ff66}Вы разбили валун и нашли в нём: {444444}Медь","*","");
			PlayerPlaySound(playerid,6603,0,0,0);
			DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
		}
	}
	else if(stat == 2 || stat == 4)
	{
		new palladii = 4 + random(4);
		update_ability(playerid, 1, 50);

		new getQuan, getLimit;
	    i_limit(playerid, 60, getQuan, getLimit);
	    if(getQuan+palladii > getLimit)
	    {
			ErrorMessage(playerid, "{FF6347}В инвентаре не хватает места. Вы нашли палладий, но он выброшен на землю"), Throw(playerid, 60, palladii, 1, 0, 0, 0);
			if(stat == 4) PlayerPlaySound(playerid,6603,0,0,0), DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
		}
		else
		{
		    new put_inva = GiveThingPlayer(playerid, 60, palladii, 1, 0, 0, 0, 9999); // Выдаём предмет игроку
			if(put_inva == -1)
			{
				ErrorMessage(playerid, "{FF6347}В инвентаре не хватает места. Вы нашли палладий, но он выброшен на землю"), Throw(playerid, 60, palladii, 1, 0, 0, 0);
				if(stat == 4) PlayerPlaySound(playerid,6603,0,0,0), DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
			}
			else
			{
				new string[140];
				if(stat == 2) format(string, sizeof(string), "{99ff66}Вы разбили метеорит и нашли в нём: {ff9000}Палладий %d грамм\n{ff9000}Он может быть использован для создания разрывных патрон", palladii);
				else if(stat == 4)
				{
					format(string, sizeof(string), "{99ff66}Вы разбили валун и нашли в нём: {ff9000}Палладий %d грамм\n{ff9000}Он может быть использован для создания разрывных патрон", palladii);
                    PlayerPlaySound(playerid,6603,0,0,0);
					DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
				}
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{00cc00}*",string,"*","");
			}
		}

		// Собирать палладий
		CompletingDaily(playerid, 8, palladii);
	}
	else if (stat == 5)
	{
		new aluminium = 3 + random(3);
		
		new getQuan, getLimit;
		i_limit(playerid, 238, getQuan, getLimit);
		if (getQuan+aluminium > getLimit)
		{
			ErrorMessage(playerid, "{FF6347}В инвентаре не хватает места. Вы нашли алюминий, но он выброшен на землю"), Throw(playerid, 238, aluminium, 1, 0, 0, 0);
			PlayerPlaySound(playerid,6603,0,0,0), DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
		} else {
			new put_inva = GiveThingPlayer(playerid, 238, aluminium, 1, 0, 0, 0, 9999);
			if (put_inva == -1) {
				ErrorMessage(playerid, "{FF6347}В инвентаре не хватает места. Вы нашли алюминий, но он выброшен на землю"), Throw(playerid, 238, aluminium, 1, 0, 0, 0);
				PlayerPlaySound(playerid,6603,0,0,0), DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
			} else {
				new string[140];
				format(string, sizeof(string), "{99ff66}Вы разбили валун и нашли в нём: {ff9000}Алюминий %d грамм\n{ff9000}Он может быть использован для создания термитной смеси", aluminium);
				PlayerPlaySound(playerid,6603,0,0,0);
				DestroyDynamicObject(marsr_object[m]), DestroyDynamic3DTextLabel(marsr_label[m]), marsr_stat[m] = 1, marsr_time[m] = 600;
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{00cc00}*",string,"*","");
			}
		}
	}
	if(stat == 1 || stat == 2) DestroyDynamicObject(meteorite_object[m]), DestroyDynamic3DTextLabel(meteorite_label[m]), meteorite_stat[m] = 0, PlayerPlaySound(playerid,6603,0,0,0);
	return 1;
}
stock get_rock(playerid)
{
	new string[124];
	for(new m = 0; m < 100; m++)
	{
		if(marsr_stat[m] == 0)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5, RockPos[m][RockPos_X], RockPos[m][RockPos_Y], RockPos[m][RockPos_Z]))
			{
			    if(PlayerInfo[playerid][pMechSkill] == 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж устал и хочет спать");
				new pow = get_power(playerid)/2;
				if(pow == 0) pow = 1;
			    if(GetPVarInt(playerid,"LoadBack") >= pow)
			 	{
			 		format(string, sizeof(string), "{FF6347}Максимальное количество боксов с материалом: %d [ Зависит от навыка силы /skill ]", pow), ErrorMessage(playerid, string);
				 	if(GetPVarInt(playerid,"GP") != 1) CreateGps(playerid, 1363.2443,2516.7244,1457.2476, 222, 222, 5.0);
   					return 1;
		 		}
				ApplyAnimation(playerid,"SWORD","sword_4",2.0, false, false, false, false, false, SYNC_ALL);
				switch(random(3))
	        	{
					case 0: nasa_box(playerid, 3, m); // Медь
					case 1: nasa_box(playerid, 5, m); // Алюминий
					case 2:
					{
					    new randmat = 6, spacer = get_ability(playerid, 1)/2;
					    if(spacer <= 0) spacer = 1;
					    randmat = randmat-spacer;
					    switch(random(randmat))
	        			{
							case 0: nasa_box(playerid, 4, m); // Палладий
							default: nasa_box(playerid, 3, m); // Медь
						}
					}
				}
				break;
			}
		}
	}
	return 1;
}
stock get_meteorite(playerid)
{
	new Float:mpos[3], string[124];
	for(new m = 0; m < 30; m++)
	{
		if(meteorite_stat[m] == 3)
		{
			GetDynamicObjectPos(meteorite_object[m], mpos[0], mpos[1], mpos[2]);
			if(IsPlayerInRangeOfPoint(playerid,2.0, mpos[0], mpos[1], mpos[2]))
			{
			    if(PlayerInfo[playerid][pMechSkill] == 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж устал и хочет спать");
				new pow = get_power(playerid)/2;
				if(pow == 0) pow = 1;
			    if(GetPVarInt(playerid,"LoadBack") >= pow)
			 	{
			 		format(string, sizeof(string), "{FF6347}Максимальное количество боксов с материалом: %d [ Зависит от навыка силы /skill ]", pow), ErrorMessage(playerid, string);
				 	if(GetPVarInt(playerid,"GP") != 1) CreateGps(playerid, 32.1685,3022.9170,957.2476, 221, 221, 5.0);
   					return 1;
		 		}
				ApplyAnimation(playerid,"SWORD","sword_4",2.0, false, false, false, false, false, SYNC_ALL);
				switch(random(2))
	        	{
					case 0: nasa_box(playerid, 1, m); // Базальт
					case 1:
					{
					    new randmat = 6, spacer = get_ability(playerid, 1)/2;
					    if(spacer <= 0) spacer = 1;
					    randmat = randmat-spacer;
					    switch(random(randmat))
	        			{
							case 0: nasa_box(playerid, 2, m); // Палладий
							default: nasa_box(playerid, 1, m); // Базальт
						}
					}
				}
				break;
			}
		}
	}
	return 1;
}
stock create_meteorite()
{
	new m = random(30); // Запускаем рандомный метеорит
	if(meteorite_stat[m] == 0)
	{
		meteorite_stat[m] = 1;
		switch(random(4))
		{
			case 0: meteorite_object[m] = CreateDynamicObject(3931, 25.182319, 2793.372802, 1003.497375, 0.000000, 0.000000, 30.000000, 221, 221, -1, 300.00, 300.00);
			case 1: meteorite_object[m] = CreateDynamicObject(3931, 15.972322, 3154.779296, 1003.497375, 0.000000, 0.000000, 80.000000, 221, 221, -1, 300.00, 300.00);
			case 2: meteorite_object[m] = CreateDynamicObject(3931, 228.882476, 2989.982910, 1003.497375, 0.000000, 0.000000, 150.000000, 221, 221, -1, 300.00, 300.00);
			case 3: meteorite_object[m] = CreateDynamicObject(3931, -195.097564, 2970.849609, 1003.497375, 0.000000, 0.000000, -70.000000, 221, 221, -1, 300.00, 300.00);
		}
		new m_time = MoveDynamicObject(meteorite_object[m], MeteoritePos[m][MeteoritePos_X], MeteoritePos[m][MeteoritePos_Y], 956.167419, 30.0); // 0
		foreach(Player, i)
		{
			if(OnlineInfo[i][oLogged] == 1 && GetPlayerVirtualWorld(i) == 221 && GetPlayerInterior(i) == 221) Streamer_Update(i, STREAMER_TYPE_OBJECT);
		}
		SetTimerEx("meteorite_timer", m_time, false, "d", m);
	}
}
function meteorite_timer(m)
{
	new Float:mpos[3];
	if(meteorite_stat[m] == 1)
	{
		meteorite_stat[m] = 2;
		GetDynamicObjectPos(meteorite_object[m], mpos[0], mpos[1], mpos[2]);
		meteorite_dust[m] = CreateDynamicObject(18737, mpos[0], mpos[1], mpos[2]-1.5, 0.000000, 0.000000, 0.000000, 221, 221, -1, 300.00, 300.00);
		SetTimerEx("meteorite_timer", 3000, false, "d", m);
	}
	else if(meteorite_stat[m] == 2)
	{
		meteorite_stat[m] = 3;
		GetDynamicObjectPos(meteorite_object[m], mpos[0], mpos[1], mpos[2]);
		meteorite_label[m] = CreateDynamic3DTextLabel("{99ff66}Метеорит\n{cccccc}[ Разбить: ALT + Кувалда в руках ]",0xA9C4E4FF,mpos[0], mpos[1], mpos[2],7.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,221,221);
		DestroyDynamicObject(meteorite_dust[m]);
	}
	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && GetPlayerVirtualWorld(i) == 221 && GetPlayerInterior(i) == 221)
		{
			if(IsPlayerInRangeOfPoint(i,200.0,mpos[0], mpos[1], mpos[2])) Streamer_Update(i); // Обновляем
			if(meteorite_stat[m] == 2)
			{
				if(Sate[i] > 0) // Спутниковая антенна рядом
		    	{
		    		new Float:sate_pos[3];
					GetDynamicObjectPos(SateObj[0][i], sate_pos[0], sate_pos[1], sate_pos[2]);
		    		new Float:distmeteo = GetDistancePoint(sate_pos[0], sate_pos[1], sate_pos[2],mpos[0], mpos[1], mpos[2]);
		    		if(distmeteo <= 6)
		    		{
		    			DestroyDynamic3DTextLabel(SateText[i]), DestroyDynamicObject(SateObj[0][i]), DestroyDynamicObject(SateObj[1][i]), DestroyDynamicObject(SateObj[2][i]), DestroyDynamicObject(SateObj[3][i]);
						Sate[i] = 0, SateTime[i] = 0;
						SendClientMessage(i, COLOR_GREY, "{0088ff}[ NASA ]: Спутниковая Антенна {FF6347}разрушена в результате падения метеорита!");
		    		}
		    	}
				if(IsPlayerInRangeOfPoint(i,100.0,mpos[0], mpos[1], mpos[2])) PlayerPlaySound(i,6601,mpos[0], mpos[1], mpos[2]); // Звук падения
				if(IsPlayerInRangeOfPoint(i,5.0,mpos[0], mpos[1], mpos[2])) // Оглушаем если чел был рядом
				{
					ApplyAnimation(i,"CRACK","crckdeth2",4.0, false, true, true, false, false), Stun[3][i] = 1, StunTime[3][i] = 10, NoAnim[i] = 1, TogglePlayerControllable(i, false);
					ShowDialog(i,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}На вас упал метеорит и оглушил вас на 10 секунд","*","");
				}
			}
		}
	}
	return 1;
}
stock create_ufo()
{
	if(ufo_stat == 0)
	{
		ufo_stat = 1, ufo_city = random(3), ufo_destination = random(2), ufo_health = 100;
		new u_time;
	    if(ufo_city == 0)
	    {
	        if(ufo_destination == 0)
	        {
			    switch(random(5))
		        {
					case 0: ufo_object = CreateDynamicObject(18846, 2880.6626,-1855.2209,120.0, 0.000000, 0.000000, 0.000000, 0, 0, -1, 1000.00, 1000.00);
					case 1: ufo_object = CreateDynamicObject(18846, 3009.9087,-1365.4647,120.0, 0.000000, 0.000000, 0.000000, 0, 0, -1, 1000.00, 1000.00);
					case 2: ufo_object = CreateDynamicObject(18846, 3042.7522,-931.8037,120.0, 0.000000, 0.000000, 0.000000, 0, 0, -1, 1000.00, 1000.00);
					case 3: ufo_object = CreateDynamicObject(18846, 2995.9075,-2339.3540,120.0, 0.000000, 0.000000, 0.000000, 0, 0, -1, 1000.00, 1000.00);
					case 4: ufo_object = CreateDynamicObject(18846, 2708.9153,-2690.8259,120.0, 0.000000, 0.000000, 0.000000, 0, 0, -1, 1000.00, 1000.00);
				}
