CMD:helpcmdleader(playerid)
{
   if(PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не лидер"), pc_cmd_help(playerid);
   new lid = PlayerInfo[playerid][pLeader];
   new str[128],sctring[1024];
   format(str,sizeof(str),"\n{0088ff}/lmenu {ffffff}- меню лидера"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/invite {ffffff}- пригласить игрока"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/uninvite {ffffff}- уволить игрока"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/vig {ffffff}- предупредить игрока"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/unvig {ffffff}- снять предупреждение"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/giverank {ffffff}- изменить ранг игрока"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/rmute или /dmute {ffffff}- молчанку на рацию"), strcat(sctring,str);
   format(str,sizeof(str),"\n{0088ff}/force {ffffff}- принудительно включить рацию"), strcat(sctring,str);
   if(lid <= 4 || lid == 7 || lid == 9 || lid == 11 || lid == 22) format(str,sizeof(str),"\n{0088ff}/respcars {ffffff}- зареспавнить незанятые автомобили"), strcat(sctring,str);
   if(lid == 1 || lid == 2 || lid == 3 || lid == 7 || lid == 11 || lid == 22)
   {
   		format(str,sizeof(str),"\n{0088ff}/clear {ffffff}- очистить розыск"), strcat(sctring,str);
   }
   if(lid == 1 || lid == 2 || lid == 3 || lid == 11 || lid == 22) format(str,sizeof(str),"\n{0088ff}/guard {ffffff}- посты охраны"), strcat(sctring,str);
   if(lid == 3)
   {
		format(str,sizeof(str),"\n{0088ff}/tank {ffffff}- разрешение на использование танка"), strcat(sctring,str);
   }
   format(str,sizeof(str),"\n{0088ff}/payunit {ffffff}- выдать юниты"), strcat(sctring,str);
   if(lid == 5 || lid == 6 || lid == 8 || lid == 10 || (lid >= 12 && lid <= 20))
   {
		format(str,sizeof(str),"\n{0088ff}/rentwh {ffffff}- арендовать склад"), strcat(sctring,str);
		format(str,sizeof(str),"\n{0088ff}/unrentwh {ffffff}- отменить аренду склада"), strcat(sctring,str);
   }
   ShowDialog(playerid,2004,DIALOG_STYLE_MSGBOX,"{ff9000}Команды Лидера",sctring,"*","");
   return 1;
}
