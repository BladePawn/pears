	|| newkeys & KEY_FIRE && newkeys & KEY_JUMP || newkeys & KEY_FIRE && newkeys & KEY_ACTION
	|| newkeys & KEY_FIRE && newkeys & KEY_YES || newkeys & KEY_FIRE && newkeys & KEY_CROUCH
	|| newkeys & KEY_FIRE && newkeys & KEY_SECONDARY_ATTACK || newkeys & KEY_FIRE && newkeys & KEY_ANALOG_LEFT
	|| newkeys & KEY_FIRE && newkeys & KEY_ANALOG_RIGHT	|| newkeys & KEY_FIRE && newkeys & KEY_SUBMISSION)
	{
		// Отображаем анимацию анти ДМ
		AnimationAntiDM(playerid);
	}
	if(newkeys & KEY_JUMP || (newkeys & KEY_SPRINT && newkeys & KEY_JUMP) || newkeys & KEY_FIRE)
	{
          //if(PPP15[playerid] == 3) return ApplyAnimation(playerid,"CARRY","crry_prtial",4.1, true, true, true, true, true);
          //if(GetPVarInt(playerid,"Arobsklad") != 0) return ApplyAnimation(playerid,"CARRY","crry_prtial",4.1, true, true, true, true, true);

		  // Роняем ящик
          if(OnlineInfo[playerid][oInHandThing][0] > 0 && (OnlineInfo[playerid][oInHandThing][5] == 2 || OnlineInfo[playerid][oInHandThing][5] == 4))
          {
				new yes;
		      	if(newkeys & KEY_FIRE) yes = 1;
		      	else yes = 1;
	      	 	if(yes == 1) Throw(playerid, OnlineInfo[playerid][oInHandThing][0], OnlineInfo[playerid][oInHandThing][1], OnlineInfo[playerid][oInHandThing][2], OnlineInfo[playerid][oInHandThing][3], OnlineInfo[playerid][oInHandThing][4], OnlineInfo[playerid][oInHandThing][5]);
   		  }

          // Кладём гантели
		  if(PutDumbbells(playerid)) return true;

      	  // Кладём штангу
		  if(PutWeights(playerid)) return true;

		  // Выходим из тренажёра
		  if(ExitTrainer(playerid)) return true;
		  if(SittingStatus[playerid]) SittingStatus[playerid] = 0;
          return 1;
	}
	if(newkeys & KEY_JUMP || (newkeys & KEY_SPRINT && newkeys & KEY_JUMP) || newkeys & KEY_SPRINT)
	{
	  if(GetPVarInt(playerid,"Roll") <= 1)
	  {
	  	new Float:posic[3];
		GetPlayerPos(playerid, posic[0], posic[1], posic[2]);
		if(IsPlayerInSquare(playerid,-2193.7451,212.5284,-2062.0334,294.8372) && posic[2] >= 800.0)
	    {
         		ClearAnimations(playerid);
	     		switch(random(4))
         		{
		          case 0: ApplyAnimation(playerid,"PED","BIKE_fall_off",2.0, false, true, true, false, false);
		          case 1: ApplyAnimation(playerid,"PED","getup",2.0, false, true, true, false, false);
		          case 2: ApplyAnimation(playerid,"PED","getup_front",2.0, false, true, true, false, false);
		          case 3: ApplyAnimation(playerid,"PED","KD_left",2.0, false, true, true, false, false);
         		}
       	}
       	return 1;
      }
	}
	//==========================================================================
	if (newkeys == KEY:1024)
	{
		pc_cmd_entersklad(playerid);
	}
	if(newkeys == KEY:1024)
	{
	    if(PlayerInfo[playerid][pSoska] >= 1 && LoadSP[playerid] == true && gSpectateID[playerid] != INVALID_PLAYER_ID && noclipdata[playerid][cameramode] == CAMERA_MODE_NONE) return SelectTextDraw(playerid,0x666666AA);
    	if(GetPVarInt(playerid,"kas") == 5 || GetPVarInt(playerid,"kas") == 6) return bet_ruletka(playerid), PlayerPlaySound(playerid,40405,0,0,0);
		new yea;
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
			// ALT Терминалы Бизнесов (Аренда, Банкоматы, Электрозарядная станция)
			if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0)
			{
				for(new br = 0; br < MAX_BIZ_TERM; br++)
				{
				    for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
					{
					    if(IsPlayerInRangeOfPoint(playerid, 2.0, RentPos_X[br][i], RentPos_Y[br][i], RentPos_Z[br][i]) && RentStat[br][i] > 0)
						{
					    	if(RentStat[br][i] == 1)
							{
								if(br >= 26 && br <= 35) ATM(playerid, br, i);
								else if(br >= 46 && br <= 55) ECT(playerid, br, i);
								else ARentCar(playerid, br, i);
							}
					    	else if(RentStat[br][i] == 2) return ErrorMessage(playerid, "{FF6347}Этот терминал закрыт [Ожидает одобрения от правительства]");
          					yea = 1;
					    	break;
				        }
					}
				}
			}
			if(yea == 1) return true;

			// ALT Рядом с Транспортом
		    new Float:POS[3];
			for(new v = 0; v < MAX_CARS; v++)
			{
				if(v == train || v == train + 1 || v == train + 2 || v == train + 3 || IsAVehicleNPC(v)) continue;

				if(GetVehicleInterior(v) == GetPlayerInterior(playerid) && GetVehicleVirtualWorld(v) == GetPlayerVirtualWorld(playerid))
				{
					GetVehiclePos(v, POS[0], POS[1], POS[2]);
					if(IsPlayerInRangeOfPoint(playerid, 3.0, POS[0], POS[1], POS[2]))
					{
						DP[0][playerid] = v;
						// Нет ключей и заперт
						if(notakey(playerid, v) == 0 && IsVehicleOpen(playerid, v) == 0)
						{
							DP[1][playerid] = 1;
							PlayerPlaySound(playerid,17803,0,0,0);
							ShowDialog(playerid,1350,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт","{FF6347}У вас нет ключей от этого транспорта{cccccc}\nХотите взломать замок транспорта?\n\n{FF6347}Как взломать замок?\n{ffcc66}- Нажимайте на Ключ в тот момент, когда полоска будет на зелёной линии","Да","Нет");	
						}
						else if(notakey(playerid, v)) PlayerPlaySound(playerid,40405,0,0,0), automobile(playerid);
						yea = 1;
						break;
					}
				}
			}
			if(yea == 1) return true;
			
			// ALT у пикапов наркофермы
			if (NarcoFarm_OnPlayerPressALT(playerid)) return true;

			// ALT у входа в наркопритон/лабораторию
			if (NarcoSpot_OnPlayerPressALT(playerid)) return true;

			// ALT у радара
			if (Radar_OnPlayerPressALT(playerid)) return true;

			// ALT у пикапа системы полицейской базы данных
			if (PDatabase_OnPlayerPressALT(playerid)) return true;

			// ALT у раскопки могил
			if (Graves_OnPlayerPressALT(playerid)) return true;

			// ALT у различных входов
			if (CustomPickups(playerid)) return true;

			// Автобусные Остановки
			for(new sta = 0; sta < MAX_BUSSTATION; sta++)
			{
			    if(IsPlayerInRangeOfPoint(playerid, 2.0, BusStationInfo[sta][bsCordX], BusStationInfo[sta][bsCordY], BusStationInfo[sta][bsCordZ]) && OnlineInfo[playerid][oShowInterface] == 0) ShowMapBus(playerid, sta), yea = 1;
			}
		}
		if(yea == 1) return 1;
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && newkeys & KEY_WALK) 
		{
			// Выход из дома
			if(ExitDom(playerid)) return true;

			// Вход в трейлер
			if(EnterTrailer(playerid)) return true;
		}

		// Выход из бизнеса
	    if(GetPlayerVirtualWorld(playerid) >= 3001 && GetPlayerVirtualWorld(playerid) < 4000)
		{
			if(ExitBiz(playerid)) return true;
		}

		// Сбор Пожертвований
		if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
		{
			if(ShowFundRaisers(playerid)) return 1;
		}

		// Доминик
		if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0 && Dominic_StartQuest(playerid)) return 1;

		// Деревенский сторож
		if(ShowDialogInfoVillage(playerid)) return true;

		// Подобрать маску маньяка
		if(TakeManiacMaskForPlayer(playerid)) return true;

		// Подобрать подарок
		if(IsADecember())
		{
			if(TakeNewYearGifts(playerid)) return true;
		}

		// Подобрали шарик
		if(IsAHalloween())
		{
			if(TakeHalloweenBallForPlayer(playerid)) return true;
		}

		// Подобрать записку маньяка
		if(TakeManiacNoteForPlayer(playerid)) return true;

		// Катана дуэль
		if(KatanaDuelMenu(playerid)) return true;

		// Грабитель самолёта
		if(IsARobPlane(playerid)) return showDialogRobPlane(playerid);

		// Открыть меню Автосалона, Мотосалона, Авиасалона, Салона Катеров
		new yesOpen = openMenu_VehicleShop(playerid);
		if(yesOpen == 1) return 1;
		if(GetPlayerVirtualWorld(playerid) >= 81 && GetPlayerVirtualWorld(playerid) <= 95)
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0,1376.2605,-20.0398,1000.9112) && PlayerInfo[playerid][pTheft] != -1) return FindCarInWareHouse(playerid);
		}
	    yashvmf(playerid);
 		yashsv(playerid);
 		PKM_to_ALT(playerid);

		// Положить ящик в поезд (Доставка боеприпасов от NGSA)
		if(IsPlayerInRangeOfPoint(playerid,2.0,747.3905,1684.3058,7.1768) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) return PutBoxToTrain(playerid);

		// Взять ящик из поезда на станции (Доставка боеприпасов от NGSA)
		else if((IsPlayerInRangeOfPoint(playerid,2.0,-1952.2584,95.7290,26.3119) || IsPlayerInRangeOfPoint(playerid,2.0,1777.1469,-1951.1694,14.1096)
			|| IsPlayerInRangeOfPoint(playerid,2.0,2859.9944,1289.9473,11.4076))
		 		&& GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) return TakeABoxFromTrain(playerid);

		if(NPCInfo[2][npcStart] == false)
		{
			if(TrainBoxPickup && IsPlayerInRangeOfPoint(playerid,2.0,TrainBoxPos[0],TrainBoxPos[1],TrainBoxPos[2]) 
				&& GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0) return RobABoxFromTrain(playerid);
		}

		if(IsACallVehicle(playerid)) return ServiceVehicle(playerid);
		if(IsAServiceVehicleSop(playerid)) return ServiceVehicleShop(playerid);

		// Кладём гантели
		if(PutDumbbells(playerid)) return true;

  	  	// Кладём штангу
		if(PutWeights(playerid)) return true;
		
	    if(GetPlayerVirtualWorld(playerid) == 195 && GetPlayerInterior(playerid) == 195) candles(playerid);

		// Мыло в тюряге
		if(soapObject && GetPlayerVirtualWorld(playerid) == WORLD_PRISON_LAUNDY && GetPlayerInterior(playerid) == INT_PRISON_LAUNDY)
		{
			if(PickupSoap(playerid)) return 1;
		}

		// Нарисовать граффити
		if(Hold[playerid] == 197 || Dei[playerid] == 8) return gospray(playerid);

		// Выход из поезда
		if(IsPlayerInRangeOfPoint(playerid,1.5,1305.7756,1604.4343,19.7263) && GetPlayerVirtualWorld(playerid) == 180 && GetPlayerInterior(playerid) == 179)
		{
			ShowDialog(playerid,492,DIALOG_STYLE_MSGBOX,"Train","{ffcc66}Вы уверены, что хотите выйти из поезда?\n\n{FF6347}Внимание! Вы не сможете сесть в поезд, если он едет на большой скорости","Да","Нет");
			return 1;
		}

		// Джоне
		if((IsPlayerInDynamicArea(playerid, ZoneQuest1) || IsPlayerInDynamicArea(playerid, ZoneQuest2)) && QuestInfo[playerid][QuestBot])
		{
			if(QuestActorJone(playerid)) return 1; // квестовый бот
			else if(MasterKeyQuest(playerid)) return 1; // берём отмычки
		}

		// Дрейк
		if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
		{
			if(QuestActorDrake(playerid)) return 1;
		}

		// Хэнк (Чёрный рынок)
		if (GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) {
			if (IsPlayerInRangeOfPoint(playerid, 1.5, 1630.7745, -1848.4137, 13.5381)) {
				for (new i = 1; i < MAX_ORG; i++) {
					if (!IsAPoliceFunction(i)) continue;

					for (new j = 0; j < MAX_SKIN_ORGANIZATION; j++)
					{
						new skinid = OrganInfo[i][gSkin][j];
						
						if (PlayerInfo[playerid][pModel] == skinid) {
							return SendDynamicActorMessage(playerid, hankActor, "Не привык вести дела с копами, иди своей дорогой..");
						}
					}
				}
				return Hank_Dialog_Main(playerid);
			}
