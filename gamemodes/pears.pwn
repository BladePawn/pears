stock get_week_day(utc = 0)
{
    new timestamp = gettime() + utc * 3600;
    new days_since_epoch = timestamp / 86400; // Количество дней с 1 января 1970
    new week_day = (days_since_epoch + 4) % 7; // 1 января 1970 был четверг (4-й день недели)
    return (week_day + 6) % 7; // 0 - понедельник, ..., 6 - воскресенье
}

stock get_next_monday(timestamp)
{
    new days_since_epoch = timestamp / 86400;
    new week_day = (days_since_epoch + 4) % 7; // Определяем день недели
    new days_to_monday = (8 - week_day) % 7; // Количество дней до следующего понедельника
    if (days_to_monday == 0) days_to_monday = 7; // Если уже понедельник, берем следующий
    
    new next_monday_timestamp = (days_since_epoch + days_to_monday) * 86400;
    return next_monday_timestamp;
}

