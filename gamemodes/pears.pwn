		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Leader` = '%d',`Vig` = '0',`Rank` = '%d' WHERE `user_id` = '%d'", g, nrank, para1);
		query_empty(pearsq, string);
