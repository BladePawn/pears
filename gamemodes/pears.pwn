stock FindRegistrPromo(playerid, const str_promo[])
{
	new load, unix = gettime(), pid;
	if(a_flood[0][playerid] > 1) return registerhelp(playerid, 4);
	
	new findinput = strlen(str_promo);
	for(new pf = 0; pf < MAX_PROMO; pf++)
	{
		if(strfind(PromoInfo[pf][roName],str_promo,true) != (-1)) pid = pf, load = 1;
	}
	new findname = strlen(PromoInfo[pid][roName]);
	if(findinput > findname || PromoInfo[pid][roActiv] != 1 || PromoInfo[pid][roUnixbegin] > unix || unix > PromoInfo[pid][roUnixend] || PromoInfo[pid][roInsert] >= 1 && PromoInfo[pid][roNumber] >= PromoInfo[pid][roInsert]
 	|| PromoInfo[pid][roLevel] >= 1 || load == 0)
	{
		PlayerPlaySound(playerid,4203,0,0,0);
		new str[100],sctring[600];
	    format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Email: %s", PlayerInfo[playerid][pMail]), strcat(sctring,str);
		if(PlayerInfo[playerid][pReferalID] >= 1) format(str,sizeof(str),"\n{cccccc}Реферал: %s",PlayerInfo[playerid][pReferal]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Реферал: нет"), strcat(sctring,str);
		if(findinput > findname || PromoInfo[pid][roActiv] != 1 || load == 0) format(str,sizeof(str),"\n{ff9000}Промокод: {FF6347}Введите промокод [ %s - не существует ]",str_promo), strcat(sctring,str);
		else if(PromoInfo[pid][roUnixbegin] > unix || unix > PromoInfo[pid][roUnixend]) format(str,sizeof(str),"\n{ff9000}Промокод: {FF6347}Введите промокод [ %s - недоступен ]",str_promo), strcat(sctring,str);
		else if(PromoInfo[pid][roInsert] >= 1 && PromoInfo[pid][roNumber] >= PromoInfo[pid][roInsert]) format(str,sizeof(str),"\n{ff9000}Промокод: {FF6347}Введите промокод [ %s - закончились активации ]",str_promo), strcat(sctring,str);
		else if(PromoInfo[pid][roLevel] >= 1) format(str,sizeof(str),"\n{ff9000}Промокод: {FF6347}Введите промокод [ %s - доступен с %d уровня ]", str_promo, PromoInfo[pid][roLevel]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{ff9000}Промокод: {99ff66}Введите промокод"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Сделайте себе подарок и введите промокод"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Не переживайте, если не знаете ни одного промокода"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}В игре всегда появляются новые, с интересными подарками"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
	 	ShowDialog(playerid,6,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
	 	return 1;
	}
	PlayerInfo[playerid][pPromoreg] = PromoInfo[pid][roNewid];
	registerhelp(playerid, 4);
	return 1;
}
stock FindPromo(playerid, const str_promo[])
{
	new load, string[160], unix = gettime();
	if(a_flood[0][playerid] > unix) return format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Пожалуйста не спешите получать промокоды {ff9000}[ Повторите попытку через %d сек. ]\n\n", a_flood[0][playerid]-unix), ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
	new findinput = strlen(str_promo);
	
	static Regex: regex;
	if (!regex) regex = Regex_New("^#*(.*)$");
	for(new pf = 0; pf < MAX_PROMO; pf++)
	{
		new RegexMatch: match, promo_code[144], promo_length;
		if(!Regex_Match(str_promo, regex, match)) continue;
	
		if (!Match_GetGroup(match, 1, promo_code, promo_length)) continue;
		if (strcmp(promo_code, PromoInfo[pf][roName], true)) continue;

		new findname = strlen(PromoInfo[pf][roName]);
		if(findinput > findname) return ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод","\n{cccccc}Введите промокод\n{FF6347}Увы, такого промокода не существует {ff0000};(\n\n","Далее","Отмена");
		if(PromoInfo[pf][roActiv] == 0) return ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод","\n{cccccc}Введите промокод\n{FF6347}Этот промокод отключён и недоступен {ff9000};(\n\n","Далее","Отмена");
		if(PromoInfo[pf][roActiv] == 2) return ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод","\n{cccccc}Введите промокод\n{FF6347}Этот промокод ожидает одобрения {ff9000};(\n\n","Далее","Отмена");
		if(PromoInfo[pf][roUnixbegin] > unix)
		{
			new tyear, tmonth, tday, thour, tminute, tsecond;
			stamp2datetime(PromoInfo[pf][roUnixbegin], tyear, tmonth, tday, thour, tminute, tsecond, 3);
			format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Этот промокод будет доступен с {ff9000}[ %02d.%02d.%d %02d:%02d ]\n\n", tday, tmonth, tyear, thour, tminute);
			ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
			return 1;
		}
		if(unix > PromoInfo[pf][roUnixend]) return ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод","\n{cccccc}Введите промокод\n{FF6347}Этот промокод отключён и недоступен {ff9000};(\n\n","Далее","Отмена");
		if(PromoInfo[pf][roLevel] <= 0 && PlayerInfo[playerid][pLevel] != 1) return format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Промокод {ff9000}[%s] {FF6347}доступен только для использования при регистрации или на 1 уровне\n\n", PromoInfo[pf][roName]), ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
		else if(PromoInfo[pf][roLevel] <= 0 && PlayerInfo[playerid][pLevel] == 1 && PlayerInfo[playerid][pPromoreg] > 0) return format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Промокод {ff9000}[%s] {FF6347}доступен только для использования при регистрации\n\nВы уже ввели промокод при регистрации\n\n", PromoInfo[pf][roName]), ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
		if(PromoInfo[pf][roInsert] >= 1 && PromoInfo[pf][roNumber] >= PromoInfo[pf][roInsert]) return format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Промокод {ff9000}[%s] {FF6347}больше недоступен, он ограничен по количеству активаций [%d]\n\n", PromoInfo[pf][roName],PromoInfo[pf][roInsert]), ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
		if(PromoInfo[pf][roLevel] > PlayerInfo[playerid][pLevel]) return format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Промокод {ff9000}[%s] {FF6347}доступен только с %d уровня [ /stats ]\n\n", PromoInfo[pf][roName], PromoInfo[pf][roLevel]), ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
		if(PromoInfo[pf][roVoice] == 1 && !IsPlayerSyncModels(playerid)) return format(string,sizeof(string),"\n{cccccc}Введите промокод\n{FF6347}Промокод {ff9000}[%s] {FF6347}доступен только тем, у кого установлен лаунчер\n\n", PromoInfo[pf][roName]), ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод",string,"Далее","Отмена");
		a_flood[0][playerid] = unix+30;

		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `promo_log` WHERE `promoid` = '%d' AND `playerid` = '%d'", 
			PromoInfo[pf][roNewid], PlayerInfo[playerid][pID]);
		mysql_tquery(pearsq, string, "Call_promo", "ddd", playerid, pf, unix);
		load = 1;

		break;
	}
	if(load == 0) return ShowDialog(playerid,550,DIALOG_STYLE_INPUT,"{ff9000}Промокод","\n{cccccc}Введите промокод\n{FF6347}Увы, такого промокода не существует {ff9000};(\n\n","Далее","Отмена");
	return 1;
}

/*
0 - ban (+)
1 - warn (+)
2 - mute (+)
3 - prison (+)
4 - gunwarn (+)
10 - delacc
*/
stock AddWrong(playerid, cod, const giveplaname[], amount)
{
	new f_str[184];
	mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_wrong` SET `admid` = '%d', `planame` = '%e', `cod` = '%d', `amount` = '%d', `time` = '%d', `day` = '%d'", PlayerInfo[playerid][pID], giveplaname, cod, amount, gettime(), getdate());
	query_empty(pearsq, f_str);
 	return 1;
}

forward Call_wrong(playerid, const str_name[]);
public Call_wrong(playerid, const str_name[])
{
	new rows, kolk,str[64],sctring[864];
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad1;
		cache_get_value_name_int(i, "time", datad1);
	    if(gettime() <= datad1+3600)
		{
			new datad2;
			cache_get_value_name_int(i, "cod", datad2);
			new datad3[24];
			cache_get_value_name(i, "planame", datad3, 24);
			if(datad2 == 0) format(str,sizeof(str),"{FF6347}%s {ffffff}[BAN]\n",datad3);
			if(datad2 == 1) format(str,sizeof(str),"{FF6347}%s {ffffff}[WARN]\n",datad3);
			if(datad2 == 2) format(str,sizeof(str),"{FF6347}%s {ffffff}[MUTE]\n",datad3);
			if(datad2 == 3) format(str,sizeof(str),"{FF6347}%s {ffffff}[PRISON]\n",datad3);
			if(datad2 == 4) format(str,sizeof(str),"{FF6347}%s {ffffff}[GUNWARN]\n",datad3);
			if(datad2 == 10) format(str,sizeof(str),"{FF6347}%s {ffffff}[DELACC]\n",datad3);

			strcat(sctring,str);
			cache_get_value_name_int(i, "id", List[i][playerid]);
			kolk ++;
		}
    }
    if(kolk >= 1)
	{
		new lol[50];
 		format(lol,sizeof(lol),"{ff9000}Отмена Действий %s",str_name);
		ShowDialog(playerid,831,DIALOG_STYLE_LIST,lol,sctring,"Выбор","Отмена");
	}
    else ShowDialog(playerid,833,DIALOG_STYLE_LIST,"{ff9000}Отмена Действий","{cccccc}Пусто","Выбор","Отмена");
	return true;
}
