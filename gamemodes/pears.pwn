{
	if(OverHear[playerid] == 1000) SetPlayerCameraPos(playerid, 1533.910522, -1672.007324, 163.357467), SetPlayerCameraLookAt(playerid, 1533.909912, -1671.571533, 158.376495);
	return 1;
}
