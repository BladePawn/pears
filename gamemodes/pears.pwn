	case 1385:
	{
		if(response)
		{
			if(listitem == 0)
			{
				if(PlayerInfo[playerid][pLeader] != 3) return ErrorMessage(playerid, "{FF6347}Только лидер NGSA может установить стомость доставки боеприпасов");
				new line[110],lines[220];
				format(line,sizeof(line),"{cccccc}Введите стоимость доставки боеприпасов на склад организации [ 1.000$ - 500.000$ ]\n\n"), strcat(lines,line);
				format(line,sizeof(line),"{cccccc}Это деньги поступают на счёт NGSA после каждой успешной доставки"), strcat(lines,line);
				ShowDialog(playerid,1398,DIALOG_STYLE_INPUT,"Доставка Боеприпасов",lines,"Принять","Отмена");
			}
			if(listitem >= 1 && listitem <= 22)
			{
			    new g = List[listitem - 1][playerid];
				if(!IsOnline(npcarmyid)) return ErrorMessage(playerid, "{FF6347}Произошла ошибка! Бот, управляющий поездом, отключился от сервера\n\n{cccccc}Сообщите администрации, чтобы мы могли исправить эту проблему");
				if(EscortStatus > 0) return ErrorMessage(playerid, "{FF6347}NGSA уже выполняет доставку заказа\n\n{cccccc}Одновременно можно выполнять только один заказ");
			    if(OrganInfo[g][gOrderStatus] <= 0) return ErrorMessage(playerid, "{FF6347}Этого заказа больше нет, организация отменила его");
				if(OrganInfo[g][gDeliveryPay] <= 0) return ErrorMessage(playerid, "{FF6347}Ошибка! В этом заказе отсутствует оплата [ Организации необходимо пересоздать заказ ]");
				if(OrganInfo[g][glave] < OrganInfo[g][gDeliveryPay] + OrganInfo[3][gTax]) return ErrorMessage(playerid, "{FF6347}На счету организации недостаточно средств");
				if(OrganInfo[3][glave] < OrganInfo[g][gDeliveryPay]) return format(string,sizeof(string),"{FF6347}На счету NGSA недостаточно средств для оплаты гос. стоимости боеприпасов\n\nСтоимость боеприпасов в заказе: %d$", OrganInfo[g][gDeliveryPay]), ErrorMessage(playerid, string);

				new tmphour, tmpminute, tmpsecond;
				gettime(tmphour, tmpminute, tmpsecond);
				if(tmphour >= 1 && tmphour <= 7) return ErrorMessage(playerid, "{FF6347}Нельзя выполнять доставку с 1:00 до 7:00");
				if(!TrainOnStation(playerid, 0)) return 1;

				if(EscortOrganization > 0) OrganInfo[EscortOrganization][gDeliveryOrder] = -1; // Если до этого был взят какой-то заказ, сбрасываем его
		
				EscortStatus = 1;
				EscortOrganization = g;

				OrganInfo[g][gDeliveryOrder] = playerid;
				SendClientMessage(playerid, COLOR_YELLOW, " SMS от Оператора: {99ff33}Для доставки боеприпасов вам понадобится спец.транспорт [Barracks] (отмечено в GPS Навигаторе)");
				CreateGps(playerid, 273.5738,1964.0057,17.6406, 0, 0, 5.0);

				PlayerPlaySound(playerid,6401,0,0,0);

				new line[110],lines[880];
				format(line,sizeof(line),"{99ff66}Заказ Принят!"), strcat(lines,line);
				format(line,sizeof(line),"\n\n{cccccc}Возьмите транспорт Barracks и погрузите в него боеприпасы"), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Ангар с боеприпасами находится справа от этого терминала"), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Спец. транспорт находится позади вас"), strcat(lines,line);

				format(line,sizeof(line),"\n\n{FF6347}Внимание!"), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Стоимость боеприпасов со счёта NGSA будет списана в момент погрузки Barracks"), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Ответственность за сохранность боеприпасов лежит на вас"), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}НЕ выполняйте доставку в одиночку, иначе вы рискуете потерять груз"), strcat(lines,line);
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX, "Доставка Боеприпасов", lines, "OK", "");
			}
		}
