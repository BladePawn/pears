}*/
stock get_namerank(g, r)
{
	new rtext[MAX_NAME_LENGTH];
	if(r >= 1) r = r-1;
	strmid(rtext, RankOrg[g][r], 0, MAX_NAME_LENGTH);
	return rtext;
}
stock Mafia_Ship(seaport)
{
	if(mafstat == 0) // [ 0 - Нет Корабля | 1 - Корабль в SF | 2 - Корабль в LS | 3 - Корабль подплывает к SF | 4 - Корабль подплывает к LS]
 	{
 		if(seaport == 0)
	 	{
		 	switch(random(2))
			{
				case 0: seaport = 3;
				case 1: seaport = 4;
			}
	 	}
 		new psea;
 		mafstat = seaport;
 		if(seaport == 3)
		{
			if(PortInfo[wStat] == 1) return 1;
			psea = 0, maftime = 95;
			SetDynamicObjectPos(mafkor[0], -1306.0317, 273.5044, 10.2643), SetDynamicObjectRot(mafkor[0], 0.0, 0.0, 45.0), MoveDynamicObject(mafkor[0], -1606.0317, 23.5044, 10.2643, 4.0);
            SetDynamicObjectPos(mafkor[1], -1306.4490, 275.2169, 8.7843), SetDynamicObjectRot(mafkor[1], 0.0, 0.0, 45.0), MoveDynamicObject(mafkor[1], -1606.4490, 25.2169, 8.7843, 4.0);
            SetDynamicObjectPos(mafkor[2], -1305.6240, 274.0404, 7.6543), SetDynamicObjectRot(mafkor[2], 0.0, 0.0, 45.0), MoveDynamicObject(mafkor[2], -1605.6240, 24.0404, 7.6543, 4.0);
            SetObjectPos(mafkor[3], -1295.3044, 284.8618, 8.9403), SetObjectRot(mafkor[3], 0.0, 0.0, 45.0), MoveObject(mafkor[3], -1595.3044, 34.8618, 8.9403, 4.0);
            SetDynamicObjectPos(mafkor[4], -1275.6006, 307.1591, 7.9363), SetDynamicObjectRot(mafkor[4], 0.0, 0.0, 45.0), MoveDynamicObject(mafkor[4], -1575.6006, 57.1591, 7.9363, 4.0);
            SetDynamicObjectPos(mafkor[5], -1274.5800, 306.7621, 13.8368), SetDynamicObjectRot(mafkor[5], 0.0, 0.0, 45.0), MoveDynamicObject(mafkor[5], -1574.5800, 56.7621, 13.8368, 4.0);
            mafia_cargo(PortOwner[psea]);
		}
 		else if(seaport == 4)
		{
			if(PortInfo[wStat] == 2) return 1;
			psea = 1, maftime = 77;
			SetDynamicObjectPos(mafkor[0], 2760.49219, -2727.23779, 9.85800), SetDynamicObjectRot(mafkor[0], 0.0, 0.0, 0.0), MoveDynamicObject(mafkor[0], 2460.49219, -2727.23779, 9.85800, 4.0);
            SetDynamicObjectPos(mafkor[1], 2761.40234, -2725.72778, 8.42800), SetDynamicObjectRot(mafkor[1], 0.0, 0.0, 0.0), MoveDynamicObject(mafkor[1], 2461.40234, -2725.72778, 8.42800, 4.0);
            SetDynamicObjectPos(mafkor[2], 2761.15625, -2727.12476, 7.26400), SetDynamicObjectRot(mafkor[2], 0.0, 0.0, 0.0), MoveDynamicObject(mafkor[2], 2461.15625, -2727.12476, 7.26400, 4.0);
            SetObjectPos(mafkor[3], 2776.12329, -2726.78271, 8.58400), SetObjectRot(mafkor[3], 0.0, 0.0, 0.0), MoveObject(mafkor[3], 2476.12329, -2726.78271, 8.58400, 4.0);
            SetDynamicObjectPos(mafkor[4], 2805.77905, -2724.96753, 7.65200), SetDynamicObjectRot(mafkor[4], 0.0, 0.0, 0.0), MoveDynamicObject(mafkor[4], 2505.77905, -2724.96753, 7.65200, 4.0);
            SetDynamicObjectPos(mafkor[5], 2806.28491, -2725.95239, 13.48400), SetDynamicObjectRot(mafkor[5], 0.0, 0.0, 0.0), MoveDynamicObject(mafkor[5], 2506.28491, -2725.95239, 13.48400, 4.0);
            mafia_cargo(PortOwner[psea]);
		}
 		foreach(Player, i)
		{
			if(OnlineInfo[i][oLogged] == 0) continue;
			if(!IsMafiaMember(i)) continue;
			if(PortOwner[psea] == fraction(i) && PlayerInfo[i][pBkyrenie] <= 1)
			{
				if(OnlineInfo[i][oListenRadioPears] == 0 && GetPVarInt(i,"afksystem") <= 3) StopAudioStreamForPlayer(i), PlayAudioStreamForPlayer(i, "https://cdn.pears.fun/sound/korabl.mp3");
				if(seaport == 3) SendClientMessage(i, COLOR_GREY, "** В порт {0088ff}San Fierro {cccccc}прибывает корабль с товаром **");
				else if(seaport == 4) SendClientMessage(i, COLOR_GREY, "** В порт {0088ff}Los Santos {cccccc}прибывает корабль с товаром **");
			}
		}
	}
	return 1;
}
stock mafia_cargo(g)
{
	const MAX_NARCO_BOXES = 10;
	new narco_boxes = 0;

	#define generate_narco_box(%0); \
		{ \
			cargo[0][gr] = %0, cargo[2][gr] = 0, narco_boxes++; \
			if (narco_boxes > MAX_NARCO_BOXES) narco_boxes--, cargo[0][gr] = 27 + random(4); \
		}

	#define generate_box(%0,%1); \
		cargo[0][gr] = %0, cargo[2][gr] = %1;

	for(new gr = 0; gr < 24; gr++)
	{
		switch(random(9))
		{
			case 0: generate_narco_box(272); // Порошок
			case 1: generate_box(27, 0); // Ammo 20,8 (Патроны Для Дробовика)
			case 2: generate_box(28, 0); // Ammo 11,43mm (Патроны Для Пистолета)
			case 3: generate_box(29, 0); // Ammo 5,45mm (Патроны Для Автомата)
			case 4: generate_box(30, 0); // Ammo 45mm (Патроны Для Винтовки)
			case 5: 
			{
				if(g == 6) generate_box(8, 1); // Катана (Only Yakzua owner Port)
				else generate_box(28, 0); // Ammo 11,43mm (Патроны Для Пистолета)
			}
			case 6,7: generate_narco_box(277); // Синий порошок
			case 8: generate_narco_box(271); // Трава
		}
		if(cargo[0][gr] == 272) cargo[1][gr] = 2;
		else if(cargo[0][gr] == 27) cargo[1][gr] = 100+random(50);
		else if(cargo[0][gr] == 28) cargo[1][gr] = 300+random(50);
		else if(cargo[0][gr] == 29) cargo[1][gr] = 700+random(100);
		else if(cargo[0][gr] == 30) cargo[1][gr] = 10+random(10);
		else if(cargo[0][gr] == 8) cargo[1][gr] = 1+random(9);
		else if(cargo[0][gr] == 271 || cargo[0][gr] == 277) cargo[1][gr] = 2+random(2);
	}

	#undef generate_narco_box
	#undef generate_box

	/* for (new i = 0; i < 24; i++)
	{
		SendClientMessageToAll(COLOR_GREY, "Предмет: %s / Количество: %d", GetNameThing(0, cargo[0][i], 0, 0), cargo[1][i]);
	} */

	return 1;
}
stock eject_mafiabattle(p)
{
	MafiaBattle[0][p] = 0, ErrorMessage(p, "{FF6347}Вы покинули территорию захвата\n{cccccc}Помните, что вернуться уже невозможно!");
}
stock kick_mafiabattle(p, psea)
{
	keep(p), SetCameraBehindPlayer(p);
	if(psea == 0) PPSetPlayerPos(p,-1748.4861,-129.5584,3.5547), PPSetPlayerFacingAngle(p,358.9286);
	else if(psea == 1) PPSetPlayerPos(p,2473.4646,-2553.8599,13.6484), PPSetPlayerFacingAngle(p,359.1123);
	ErrorMessage(p, "{FF6347}Вы не участник этой битвы и вам запрещено здесь находиться");
}
forward monitoring_insert(unix);
public monitoring_insert(unix)
{
	new rows, f_str[84];
	cache_get_row_count(rows);
	if(!rows)
	{
		mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `server_status` SET `unix` = '%d'", unix);
		query_empty(pearsq, f_str);
		for(new m = 0; m < 5; m++)
		{
			monitoring_online[m] = 0, monitoring_registr[m] = 0;
		}
		for(new mu = 0; mu < 3; mu++) monitoring_online_unix[mu] = 0, monitoring_registr_unix[mu] = 0;
		LoadMonitoring();
	}
 	return 1;
}
stock monitoring_save()
{
	if(ServerInfo[34] > 0)
	{
		new f_str[224];
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `server_status` SET `online` = '%d',`registr` = '%d' WHERE `newid` = '%d'",
		monitoring_online[0],monitoring_registr[0],ServerInfo[34]);
		query_empty(pearsq, f_str);
	}
}
stock LoadMonitoring()
{
	new f_str[124];
	mysql_format(pearsq, f_str,sizeof(f_str),"SELECT * FROM `server_status` WHERE `newid` = '%d'", ServerInfo[34]-1);
	mysql_tquery(pearsq, f_str, "monitoring_load", "d", 0);
	mysql_tquery(pearsq, "SELECT * FROM `server_status` ORDER BY `newid` DESC, `online` DESC LIMIT 7", "monitoring_load", "d", 1); // Максимальный онлайн за 7 дней
	mysql_tquery(pearsq, "SELECT * FROM `server_status` ORDER BY `newid` DESC, `online` DESC LIMIT 30", "monitoring_load", "d", 2); // Максимальный онлайн за 30 дней
	mysql_tquery(pearsq, "SELECT * FROM `server_status` ORDER BY `online` DESC LIMIT 1", "monitoring_load", "d", 3); // Максимальный онлайн за всё время
	mysql_tquery(pearsq, "SELECT * FROM `server_status` ORDER BY `newid` DESC,`registr` DESC LIMIT 7", "monitoring_load", "d", 4); // Максимальная регистрация за 7 дней
	mysql_tquery(pearsq, "SELECT * FROM `server_status` ORDER BY `newid` DESC,`registr` DESC LIMIT 30", "monitoring_load", "d", 5); // Максимальная регистрация за 30 дней
	mysql_tquery(pearsq, "SELECT * FROM `server_status` ORDER BY `registr` DESC LIMIT 1", "monitoring_load", "d", 6); // Максимальная регистрация за всё время
	return 1;
}
forward monitoring_load(mon);
public monitoring_load(mon)
{
	new rows, count[30],result;
	cache_get_row_count(rows);
	if(rows)
	{
		if(mon == 0)
		{
			cache_get_value_name_int(0, "online", monitoring_online[1]);
			cache_get_value_name_int(0, "registr", monitoring_registr[1]);
		}
		else if(mon == 1)
		{
			for(new i; i < rows; i++)
			{
				cache_get_value_name_int(i, "online", count[i]);
				if(i == 0) 
				{
					result = 0;
					continue;
				}
				if(count[i] > count[result]) result = i;
			}
			cache_get_value_name_int(result, "online", monitoring_online[2]), cache_get_value_name_int(result, "unix", monitoring_online_unix[0]);
		}
		else if(mon == 2) 
		{
			for(new i; i < rows; i++)
			{
				cache_get_value_name_int(i, "online", count[i]);
				if(i == 0) 
				{
					result = 0;
					continue;
				}
				if(count[i] > count[result]) result = i;
			}
			cache_get_value_name_int(result, "online", monitoring_online[3]), cache_get_value_name_int(result, "unix", monitoring_online_unix[1]);
		}
		else if(mon == 3) cache_get_value_name_int(0, "online", monitoring_online[4]), cache_get_value_name_int(0, "unix", monitoring_online_unix[2]);
		else if(mon == 4)
		{
			for(new i; i < rows; i++)
			{
				cache_get_value_name_int(i, "online", count[i]);
				if(i == 0) 
				{
					result = 0;
					continue;
				}
				if(count[i] > count[result]) result = i;
			}
			cache_get_value_name_int(result, "registr", monitoring_registr[2]), cache_get_value_name_int(result, "unix", monitoring_registr_unix[0]);
		}
		else if(mon == 5)
		{
			for(new i; i < rows; i++)
			{
				cache_get_value_name_int(i, "online", count[i]);
				if(i == 0) 
				{
					result = 0;
					continue;
				}
				if(count[i] > count[result]) result = i;
			}
			cache_get_value_name_int(result, "registr", monitoring_registr[3]), cache_get_value_name_int(result, "unix", monitoring_registr_unix[1]);
		}
		else if(mon == 6) cache_get_value_name_int(0, "registr", monitoring_registr[4]), cache_get_value_name_int(0, "unix", monitoring_registr_unix[2]);
		printf("[Monitoring Load]: Загружено");
	}
	else printf("[Monitoring Load]: Отсутствует");
	return 1;
}
stock show_referal(playerid, targetid, stat)
{
	ListID[playerid] = targetid;
	ListCode[playerid] = stat;
	ShowDialog(playerid,1038,DIALOG_STYLE_LIST,"{ff9000}Рефералы","{cccccc}Общая Информация\n{ff9000}Список Игроков","Выбрать","Отмена");
	return 1;
}
stock info_referal(playerid)
{
	new targetid = ListID[playerid], stat = ListCode[playerid];
	PlayerPlaySound(playerid,40405,0,0,0);
	new year, month, day;
	getdate(year, month, day);
	new str[184],sctring[1400];
	format(str,sizeof(str),"\n{ff9000}Рефералы %s {0088ff}[%02d.%02d.%d]\n", PlayerInfo[targetid][pName], day, month, year), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Приглашено: {ff9000}%d игроков",PlayerInfo[targetid][pRefreg]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}5 Level: {ff9000}%d игроков",PlayerInfo[targetid][pRef5]), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{ff9000}Что такое рефералы и зачем они нужны?"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}Приглашайте новых игроков и получайте гарантированные подарки"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}За каждого игрока, который достиг 5 уровень вы получаете: {99ff66}%d$", REFERAL_PAY), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{cccccc}Так же, вы получаете {ffcc00}%d проц. от каждого доната {cccccc}приглашённого игрока!", REFERAL_PROCENT_DONATE), strcat(sctring,str);
	if(stat == 1) ShowDialog(playerid,949,DIALOG_STYLE_MSGBOX,"{ff9000}Рефералы",sctring,"Ок","");
	else if(stat == 2) ShowDialog(playerid,1187,DIALOG_STYLE_MSGBOX,"{ff9000}Рефералы",sctring,"Ок","");
	else ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Рефералы",sctring,"Ок","");
	return 1;
}
function Call_checkreferal(playerid, const str_name[])
{
	new rows,datad1,datad2;
	cache_get_row_count(rows);
	if(rows)
	{
	    cache_get_value_name_int(0, "RefReg", datad1);
	    cache_get_value_name_int(0, "Ref5", datad2);
		PlayerPlaySound(playerid,40405,0,0,0);
		new year, month,day;
		getdate(year, month, day);
		new str[184],sctring[1400];
		format(str,sizeof(str),"\n{ff9000}Рефералы {0088ff}[%02d.%02d.%d]\n", day, month, year), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Приглашено: {ff9000}%d игроков",datad1), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}5 Level: {ff9000}%d игроков",datad2), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ff9000}Что такое рефералы и зачем они нужны?"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}Приглашайте друзей играть и получайте гарантированные подарки"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}За каждого игрока, который достиг 5 уровень вы получаете: {99ff66}%d$", REFERAL_PAY), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Играть вместе не только интересно, но и выгодно ;*\n\n"), strcat(sctring,str);
		ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.",sctring,"Ок","");
