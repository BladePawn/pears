		   format(string, sizeof(string), "[ Мысли ]: В транспорте ещё %d литров топлива",fill);
		   SendClientMessage(playerid,COLOR_GREY, string);
        }
	}
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не на заправочной станции");
   	return 1;
}
CMD:fillnew(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,4.0,1936.3611,-1777.3170,13.3828) || IsPlayerInRangeOfPoint(playerid,4.0,1936.3137,-1789.7120,13.3828) || IsPlayerInRangeOfPoint(playerid,4.0,-1672.5669,420.5927,7.1797) || IsPlayerInRangeOfPoint(playerid,4.0,-1679.3167,413.5134,7.1797)
	|| IsPlayerInRangeOfPoint(playerid,4.0,-2103.2947,1.3732,35.3203) || IsPlayerInRangeOfPoint(playerid,4.0,-2103.2607,-10.7123,35.3203) || IsPlayerInRangeOfPoint(playerid,4.0,-89.2261,-1177.5775,2.6294) || IsPlayerInRangeOfPoint(playerid,4.0,-84.4081,-1166.9980,2.6294)
	|| IsPlayerInRangeOfPoint(playerid,4.0,2116.4453,943.9481,10.8374) || IsPlayerInRangeOfPoint(playerid,4.0,2116.2383,932.2269,10.8374) || IsPlayerInRangeOfPoint(playerid,4.0,2249.1006,2394.2515,10.8203) || IsPlayerInRangeOfPoint(playerid,4.0,2259.2168,2394.0405,10.8203)
 	|| IsPlayerInRangeOfPoint(playerid,4.0,2806.1050,1984.3435,10.8203) || IsPlayerInRangeOfPoint(playerid,4.0,2815.135, 1992.333, 10.80)|| IsPlayerInRangeOfPoint(playerid,4.0,1537.1112,-2183.4209,13.5723) || IsPlayerInRangeOfPoint(playerid,4.0,1525.4749,-2183.7937,13.5723)
	|| IsPlayerInRangeOfPoint(playerid,4.0,896.1348,1904.1310,10.8708) || IsPlayerInRangeOfPoint(playerid,4.0,896.2427,1893.9852,10.8708)
	|| IsPlayerInRangeOfPoint(playerid,4.0,-2627.8733,1360.7460,7.0928) || IsPlayerInRangeOfPoint(playerid,4.0,-2627.4900,1350.5809,7.1173)
	|| IsPlayerInRangeOfPoint(playerid,4.0,-1559.2898,-2749.4673,48.5591) || IsPlayerInRangeOfPoint(playerid,4.0,-1568.7240,-2742.8220,48.5591)
	|| IsPlayerInRangeOfPoint(playerid,4.0,66.1616,-193.1906,1.6310) || IsPlayerInRangeOfPoint(playerid,4.0,54.0705,-193.3635,1.6310))
	{
	    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
 		new vehicle = GetPlayerVehicleID(playerid);
 		if(IsAVello(vehicle)) return ErrorMessage(playerid, "{FF6347}Велосипед нельзя заправить");
		if(IsElectroCarModel(VehInfo[vehicle][vModel])) return ErrorMessage(playerid, "{FF6347}Этот транспорт нужно заряжать на специальных станциях");
 		new fill = VehInfo[vehicle][vGas] + VehInfo[vehicle][vGelium];
		if(fill <= GasMax - 1)
		{
		    if(VehInfo[vehicle][vEngine] == 1) return ErrorMessage(playerid, "{FF6347}Заглушите двигатель транспорта [ Кнопка 2 ]");
		    new namer = 0, zaprid;
            // Заправка LS 1
            if(IsPlayerInRangeOfPoint(playerid,4.0,1936.3611,-1777.3170,13.3828)) namer = BotPears[207], zaprid = 1; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,1936.3137,-1789.7120,13.3828)) namer = BotPears[208], zaprid = 1; // Колонка 2
            // Заправка LS 2
            else if(IsPlayerInRangeOfPoint(playerid,4.0,-89.2261,-1177.5775,2.6294)) namer = BotPears[230], zaprid = 2; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,-84.4081,-1166.9980,2.6294)) namer = BotPears[231], zaprid = 2; // Колонка 2
            // Заправка SF 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,-1672.5669,420.5927,7.1797)) namer = BotPears[219], zaprid = 3; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,-1679.3167,413.5134,7.1797)) namer = BotPears[220], zaprid = 3; // Колонка 2
            // Заправка SF 2
            else if(IsPlayerInRangeOfPoint(playerid,4.0,-2103.2947,1.3732,35.3203)) namer = BotPears[227], zaprid = 4; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,-2103.2607,-10.7123,35.3203)) namer = BotPears[228], zaprid = 4; // Колонка 2
            // Заправка LV 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,2116.4453,943.9481,10.8374)) namer = BotPears[233], zaprid = 5; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,2116.2383,932.2269,10.8374)) namer = BotPears[234], zaprid = 5; // Колонка 2
            // Заправка LV 2
            else if(IsPlayerInRangeOfPoint(playerid,4.0,2249.1006,2394.2515,10.8203)) namer = BotPears[236], zaprid = 6; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,2259.2168,2394.0405,10.8203)) namer = BotPears[237], zaprid = 6; // Колонка 2
            // Заправка LV 3
            else if(IsPlayerInRangeOfPoint(playerid,4.0,2806.1050,1984.3435,10.8203)) namer = BotPears[490], zaprid = 7; // Колонка 1
            else if(IsPlayerInRangeOfPoint(playerid,4.0,2815.135, 1992.333, 10.80)) namer = BotPears[491], zaprid = 7; // Колонка 2
            // Заправка LS 3
            else if(IsPlayerInRangeOfPoint(playerid,4.0,1537.1112,-2183.4209,13.5723)) namer = BotPears[12], zaprid = 8; // Колонка 1
			else if(IsPlayerInRangeOfPoint(playerid,4.0,1525.4749,-2183.7937,13.5723)) namer = BotPears[13], zaprid = 8; // Колонка 1
			// Заправка LV 4
			else if(IsPlayerInRangeOfPoint(playerid,4.0,896.1348,1904.1310,10.8708)) namer = BotPears[15], zaprid = 9; // Колонка 1
			else if(IsPlayerInRangeOfPoint(playerid,4.0,896.2427,1893.9852,10.8708)) namer = BotPears[16], zaprid = 9; // Колонка 1
			// Заправка SF 3
			else if(IsPlayerInRangeOfPoint(playerid,4.0,-2627.8733,1360.7460,7.0928)) namer = BotPears[18], zaprid = 10; // Колонка 1
			else if(IsPlayerInRangeOfPoint(playerid,4.0,-2627.4900,1350.5809,7.1173)) namer = BotPears[19], zaprid = 10; // Колонка 1
			// Заправка SF 4
			else if(IsPlayerInRangeOfPoint(playerid,4.0,-1559.2898,-2749.4673,48.5591)) namer = BotPears[21], zaprid = 11; // Колонка 1
			else if(IsPlayerInRangeOfPoint(playerid,4.0,-1568.7240,-2742.8220,48.5591)) namer = BotPears[56], zaprid = 11; // Колонка 1
			// Зправка LS 4
			else if(IsPlayerInRangeOfPoint(playerid,4.0,66.1616,-193.1906,1.6310)) namer = BotPears[69], zaprid = 12; // Колонка 1
			else if(IsPlayerInRangeOfPoint(playerid,4.0,54.0705,-193.3635,1.6310)) namer = BotPears[70], zaprid = 12; // Колонка 1
			if(zaprid <= 0) return 1;
	        switch(random(5))
   			{
				case 0: SendDynamicActorMessage(playerid, namer,"Сколько литров заправлять будем?"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr0.mp3");
				case 1: SendDynamicActorMessage(playerid, namer,"Сколько заправляем?"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr1.mp3");
				case 2: SendDynamicActorMessage(playerid, namer,"Здрасте. Сколько?"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr2.mp3");
				case 3: SendDynamicActorMessage(playerid, namer,"Здраствуйте. Сколько литров заправлять?"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr3.mp3");
				case 4: SendDynamicActorMessage(playerid, namer,"Здрасте. Сколько вам заправлять?"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr4.mp3");
   			}
   			if(BizzInfo[zaprid][bItem][0] <= 0)
   			{
	   			switch(random(2))
	   			{
					case 0: SendDynamicActorMessage(playerid, namer,"Простите, но мы закрыты"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr5.mp3");
					case 1: SendDynamicActorMessage(playerid, namer,"Нет топлива, извините"), VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zapr6.mp3");
	   			}
	   			ErrorMessage(playerid, "{FF6347}На этой заправке нет топлива");
   			    return 1;
   			}
   			new string[184];
		    format(string, sizeof(string), "{ffffff}Сколько литров топлива вы хотите заправить?\n\n{cccccc}Стоимость 1 литра на этой заправке = {00cc00}%d$\n{cccccc}Для полного бака вам требуется: %d литров {99ff66}[%d$]",BizzInfo[zaprid][bPrice][0],100-fill,(100-fill)*BizzInfo[zaprid][bPrice][0]);
   			ShowDialog(playerid,484,DIALOG_STYLE_INPUT,"{0088ff}Заправка",string,"Принять","Отмена");
		}
		else ErrorMessage(playerid, "{FF6347}Транспорт не нужно заправлять [ Бак полон ]");
	}
   	return 1;
}
CMD:fillkassa(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1925.6489,-1780.0074,13.5606) || IsPlayerInRangeOfPoint(playerid,2.0,-1681.5635,427.1930,7.1989) || IsPlayerInRangeOfPoint(playerid,2.0,-2114.2109,-1.6385,35.3447)
	|| IsPlayerInRangeOfPoint(playerid,2.0,-78.8470,-1180.7233,2.6398) || IsPlayerInRangeOfPoint(playerid,2.0,2105.3684,941.5986,10.8504) || IsPlayerInRangeOfPoint(playerid,2.0,2250.6414,2383.3057,10.8348)
	|| IsPlayerInRangeOfPoint(playerid,2.0,2805.4807,1998.6481,10.842) || IsPlayerInRangeOfPoint(playerid,2.0,1534.8612,-2173.0532,13.5853) || IsPlayerInRangeOfPoint(playerid,2.0,884.5872,1902.3389,10.8864)
 	|| IsPlayerInRangeOfPoint(playerid,2.0,-2639.2065,1358.9352,7.1399) || IsPlayerInRangeOfPoint(playerid,2.0,-1554.8584,-2738.3550,48.5721) || IsPlayerInRangeOfPoint(playerid,2.0,63.3695,-182.5771,1.6440))
	{
		if(zaprkol[playerid] >= 1)
		{
            if(IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 1936.3611,-1777.3170,13.3828) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 1936.3137,-1789.7120,13.3828) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, -1675.1141,421.4946,7.3641) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, -1680.8055,415.6465,7.3641)
	 		|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, -2103.2947,1.3732,35.3203) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, -2103.2607,-10.7123,35.3203) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, -89.2261,-1177.5775,2.6294) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, -84.4081,-1166.9980,2.6294)
		  	|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 2116.4453,943.9481,10.8374) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 2116.2383,932.2269,10.8374) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 2249.1006,2394.2515,10.8203) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 2259.2168,2394.0405,10.8203)
		   	|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 2806.1050,1984.3435,10.8203) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0, 2815.135, 1992.333, 10.80)|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,1537.1112,-2183.4209,13.5723) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,1525.4749,-2183.7937,13.5723)
			|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,896.1348,1904.1310,10.8708) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,896.2427,1893.9852,10.8708)
			|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,-2627.8733,1360.7460,7.0928) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,-2627.4900,1350.5809,7.1173)
			|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,-1559.2898,-2749.4673,48.5591) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,-1568.7240,-2742.8220,48.5591)
			|| IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,66.1616,-193.1906,1.6310) || IsVehicleInRangeOfPoint(zaprcar[playerid],4.0,54.0705,-193.3635,1.6310))
			{
				new zaprid, namer;
				new fill = VehInfo[zaprcar[playerid]][vGas] + VehInfo[zaprcar[playerid]][vGelium];
	        	if(fill+zaprkol[playerid] > 100) return ErrorMessage(playerid, "{FF6347}Объём бака не больше 100 литров"), zaprkol[playerid] = 0, zaprcar[playerid] = 9999;
				
          		if(IsPlayerInRangeOfPoint(playerid,3.0,1925.6489,-1780.0074,13.5606)) zaprid = 1, namer = BotPears[209]; // Заправка LS 1
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,-1681.5635,427.1930,7.1989)) zaprid = 3, namer = BotPears[221]; // Заправка SF 1
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,-2114.2109,-1.6385,35.3447)) zaprid = 4, namer = BotPears[229]; // Заправка SF 2
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,-78.8470,-1180.7233,2.6398)) zaprid = 2, namer = BotPears[232]; // Заправка LS 2
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,2105.3684,941.5986,10.8504)) zaprid = 5, namer = BotPears[235]; // Заправка LV 1
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,2250.6414,2383.3057,10.8348)) zaprid = 6, namer = BotPears[238]; // Заправка LV 2
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,2805.4807,1998.6481,10.842)) zaprid = 7, namer = BotPears[492]; // Заправка LV 3
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,1534.8612,-2173.0532,13.5853)) zaprid = 8, namer = BotPears[14]; // Заправка LS 3
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,884.5872,1902.3389,10.8864)) zaprid = 9, namer = BotPears[17]; // Заправка LV 4
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,-2639.2065,1358.9352,7.1399)) zaprid = 10, namer = BotPears[20]; // Заправка SF 3
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,-1554.8584,-2738.3550,48.5721)) zaprid = 11, namer = BotPears[57]; // Заправка SF 4
          		else if(IsPlayerInRangeOfPoint(playerid,3.0,63.3695,-182.5771,1.6440)) zaprid = 12, namer = BotPears[71]; // Заправка LS 4
          		if(zaprid <= 0) return 1;
				if(BizzInfo[zaprid][bItem][0] < zaprkol[playerid])
	   			{
		   			SendDynamicActorMessage(playerid, namer,"Прошу прощения. К сожалению, у нас закончилось топливо");
					VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zaprgirl0.mp3");
		   			ErrorMessage(playerid, "{FF6347}На этой заправке закончилось топливо"), zaprkol[playerid] = 0, zaprcar[playerid] = 9999, PlayerPlaySound(playerid,4203,0,0,0);
	   			    return 1;
	   			}
	   			new string[144];
	            if(oGetPlayerMoney(playerid) < zaprkol[playerid]*BizzInfo[zaprid][bPrice][0]) return format(string, sizeof(string), "[ Мысли ]: Мне не хватает %d$ {FF6347}[ Стоимость %d л. на этой заправке %d$ ]", BizzInfo[zaprid][bPrice][0]-oGetPlayerMoney(playerid), zaprkol[playerid], zaprkol[playerid]*BizzInfo[zaprid][bPrice][0]), SendClientMessage(playerid, COLOR_GREY, string), zaprkol[playerid] = 0, zaprcar[playerid] = 9999;
          		SendDynamicActorMessage(playerid, namer, "Спасибо за покупку. Приезжайте к нам ещё :)");
				VoiceDynamicActor(playerid, namer, "https://cdn.pears.fun/sound/characters/zapr/zaprgirl1.mp3");
          		
				VehInfo[zaprcar[playerid]][vGas] += zaprkol[playerid];
	        	oGivePlayerMoney(playerid, -zaprkol[playerid]*BizzInfo[zaprid][bPrice][0]);
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой транспорт заправили на %d литров. Стоимость: {99ff66}%d$", zaprkol[playerid],zaprkol[playerid]*BizzInfo[zaprid][bPrice][0]);
				if(BizzInfo[zaprid][bSost] > 0) BizzInfo[zaprid][bItem][0] -= zaprkol[playerid];
				UpdateFillLabel(zaprid);
				paybiz(zaprid, zaprkol[playerid]*BizzInfo[zaprid][bPrice][0]);
				PlayerPlaySound(playerid,6401,0,0,0);

				format(string, sizeof(string),"Заправка № %d", zaprid);
            	MoneyLog("fillcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -zaprkol[playerid]*BizzInfo[zaprid][bPrice][0], string);
				zaprkol[playerid] = 0, zaprcar[playerid] = 9999;
            }
            else ErrorMessage(playerid, "{FF6347}Транспорт, который вы хотели заправить, находится далеко от колонки"), zaprkol[playerid] = 0, zaprcar[playerid] = 9999;
		}
		else ErrorMessage(playerid, "{FF6347}Вам необходимо попросить заправщика заправить транспорт\n\n{cccccc}Используйте гудок транспорта возле колонки");
	}
   	return 1;
}
stock kasik3(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	if(Blockas[2] == 1) return ErrorMessage(playerid, "{FF6347}Рулетка недоступна [ Временно закрыто администрацией ]");
	if(OnlineInfo[playerid][oInHandThing][0] > 0 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки\n\n{cccccc}Предмет, оружие или какое-то действие");
	new kaz;
	if(IsPlayerInRangeOfPoint(playerid, 3.0,2183.68945, 1012.19, 992.50781)) kaz = 0;
	else if(IsPlayerInRangeOfPoint(playerid, 3.0,2183.68945, 1018.19, 992.50781)) kaz = 1;
	else if(IsPlayerInRangeOfPoint(playerid, 3.0,2183.68945, 1024.19, 992.50781)) kaz = 2;

    if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]);
    AeroStat[playerid] = 1;
	if(kaz == 0)
	{
		FlyCameraPos(playerid,2186.700683, 1010.614501, 995.095336, 2183.560302, 1012.360290, 991.618286  ,900,800);
		AeroObj[playerid] = CreatePlayerObject(playerid, 1940, 2183.116699, 1012.23000, 992.318603, 0.0, 0.0, 0.0,300.0);// + 0.0
	}
	else if(kaz == 1)
 	{
	 	FlyCameraPos(playerid,2186.684570, 1016.666381, 994.898986, 2183.442138, 1018.421020, 991.521484  ,900,800);
	 	AeroObj[playerid] = CreatePlayerObject(playerid, 1940, 2183.116699, 1018.23000, 992.318603, 0.0, 0.0, 0.0,300.0);// + 6.0
 	}
	else if(kaz == 2)
 	{
 		FlyCameraPos(playerid,2186.618408, 1022.739501, 995.183410, 2183.490722, 1024.388061, 991.647888  ,900,800);
 		AeroObj[playerid] = CreatePlayerObject(playerid, 1940, 2183.116699, 1024.23000, 992.318603, 0.0, 0.0, 0.0,300.0);// + 12.0
	}
	PlayerPlaySound(playerid,30800,0,0,0);
	SetPVarInt(playerid, "kas", 5);
	SetPVarInt(playerid, "kstol", kaz);
	TogglePlayerControllable(playerid, false);
	SetPVarInt(playerid, "kmesto", 0);
	
	PlayerTextDrawColour(playerid, FishkiDraw[0], PlayerInfo[playerid][pStyle1]);
	updatefishki(playerid);
	PlayerTextDrawShow(playerid, FishkiDraw[1]);
	
	new stro[124],sctringo[960];//,unix = gettime();
    format(stro,sizeof(stro),"{ff9000}Добро пожаловать!"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}Вы присоединились к игре Рулетка"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n\n{99ff66}ALT {cccccc}- Сделать ставку"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{FF6347}Enter {cccccc}- Покинуть стол"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}В рулетку можно играть только обычными фишками!"), strcat(sctringo,stro);
	
	//format(stro,sizeof(stro),"\n\n{FF6347}Ограничение Ставок:"), strcat(sctringo,stro);
	//if(PlayerInfo[playerid][pLevel] < 5) format(stro,sizeof(stro),"\n{cccccc}На вашем аккаунте ограничены ставки. Причина: {FF6347}Уровень ниже 5-ого"), strcat(sctringo,stro);
	/*else if(PlayerInfo[playerid][pKasinoBlock] > unix) // ВРЕМКА
	{
	    new tyear, tmonth, tday, thour, tminute, tsecond;
		stamp2datetime(PlayerInfo[playerid][pKasinoBlock], tyear, tmonth, tday, thour, tminute, tsecond, 3);
		format(stro,sizeof(stro),"\n{cccccc}На вашем аккаунте ограничены ставки. Причина: {FF6347}Суммарные крупные выигрыши"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Ограничение будет снято [ %02d.%02d.%d %02d:%02d ]", tday, tmonth, tyear, thour, tminute), strcat(sctringo,stro);
	}
	else format(stro,sizeof(stro),"\n{99ff66}Нет ограничений"), strcat(sctringo,stro);
	*/
    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Казино",sctringo,"Ок","");
	return 1;
}

stock GetBetRuletka(playerid, &minbet, &maxbet) // Диапазоны ставок на столах
{
	if(GetPVarInt(playerid,"kstol") == 0) minbet = 1000, maxbet = 50000;
	else if(GetPVarInt(playerid,"kstol") == 1) minbet = 10000, maxbet = 500000;
	else if(GetPVarInt(playerid,"kstol") == 2) minbet = 100000, maxbet = 5000000;
	return 1;
}

stock bet_ruletka(playerid)
{
	if(GetPVarInt(playerid,"kas") == 6)
	{
	    new stro[124],sctringo[960];
	    format(stro,sizeof(stro),"{ff9000}Вы уже сделали ставку!"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Дождитесь результатов"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n\n{99ff66}Ваша ставка: {0088ff}%dF", GetPVarInt(playerid,"oryjtemp")), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Позиция: {ff9000}%s", rulName[GetPVarInt(playerid,"kmesto")]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Коэффициент: {ff9000}%d к 1", rulWin[GetPVarInt(playerid,"kmesto")]), strcat(sctringo,stro);
	    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Казино",sctringo,"Ок","");
	    return 1;
	}
    if(rulstol[GetPVarInt(playerid,"kstol")] == 2) return ErrorMessage(playerid, "{FF6347}Ставки сделаны, ставок больше нет [ Ожидайте результатов ]");
    new stro[114],sctringo[452];//,unix = gettime();
    format(stro,sizeof(stro),"\n{cccccc}Позиция: {ff9000}%s", rulName[GetPVarInt(playerid,"kmesto")]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Коэффициент: {ff9000}%d к 1", rulWin[GetPVarInt(playerid,"kmesto")]), strcat(sctringo,stro);
    //if(PlayerInfo[playerid][pLevel] < 5 || PlayerInfo[playerid][pKasinoBlock] > unix) format(stro,sizeof(stro),"\n\n{cccccc}Введите количество фишек, чтобы сделать ставку {FF6347}[ 100F - 20.000F ]"), strcat(sctringo,stro);  // ВРЕМКА
    
	new minbet, maxbet;
	GetBetRuletka(playerid, minbet, maxbet);
    format(stro,sizeof(stro),"\n\n{cccccc}Введите количество фишек, чтобы сделать ставку"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{ffcc66}За этим столом диапазон ставок: от %dF до %dF", minbet, maxbet), strcat(sctringo,stro);
    ShowDialog(playerid,785,DIALOG_STYLE_INPUT,"{ff9000}Казино",sctringo,"Ввод","Отмена");
	return 1;
}
