stock FindCharging(playerid)
{
	new Float:dist, Float:findpos, biz = 46, kakoi, quan;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, RentPos_X[46][0], RentPos_Y[46][0], RentPos_Z[46][0]);
	for(new b = 46; b <= 55; b++)
	{
	    for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
		    if(RentStat[b][i] == 1)
		    {
				if(BizzInfo[b+97][bItem][b-46] >= MIN_PROCENT_REPAIRTERMINAL) continue;
		        quan ++;
	    		findpos = GetDistancePoint(x, y, z, RentPos_X[b][i], RentPos_Y[b][i], RentPos_Z[b][i]);
	    		if(findpos <= dist) dist = findpos, kakoi = i, biz = b;
			}
		}
	}
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Все зарядные станции недоступны {ff9000}[ Обратитесь к администрации /report ]");

	new string[160];
	format(string,sizeof(string),"{ff9000}Ближайшая зарядная станция: %s {99ff66}отмечен на карте\n{cccccc}Бизнес № %d | Терминал № %d", BizzInfo[biz+97][bName], biz+97, kakoi+1);
	SuccessMessage(playerid, string);
	CreateGps(playerid, RentPos_X[biz][kakoi], RentPos_Y[biz][kakoi], RentPos_Z[biz][kakoi], 0, 0, 5.0);
	return 1;
}
