				HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], nd, f, "Привязал Семью");
			}
			else
			{
				new nd = FamilyInfo[f][fDop5];
				if(DomInfo[nd][dFam] == f) format(string, sizeof(string), "[ Мысли ]: Я отключил дом №%d от своей семьи %s", nd, FamilyInfo[f][fName]);
				else format(string, sizeof(string), "[ Мысли ]: Я отключил неизвестный дом от своей семьи");
				SendClientMessage(playerid, COLOR_GREY, string);
				if(DomInfo[nd][dFam] == f) format(string, sizeof(string), "{66ffff}Family {ffcc00}%s отключил {FF6347}Дом №%d {ffcc00}от семьи", PlayerInfo[playerid][pName],nd);
				else format(string, sizeof(string), "{66ffff}Family {ffcc00}%s отключил {FF6347}неизвестный дом {ffcc00}от семьи", PlayerInfo[playerid][pName]);
				SendFamilyMessage(f, COLOR_YELLOW, string);
				foreach (Player, i)
				{
					if(PlayerInfo[i][pFamily] == f && PlayerInfo[i][pSelectspawn] == 6) PlayerInfo[i][pSelectspawn] = 0;
				}
				if(DomInfo[nd][dFam] == f)
				{
					HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], nd, f, "Отвязал Семью");
					DomInfo[nd][dFam] = 0;
					DomInfo[nd][dFamcar] = 0;
					UpdateDom(nd);
					SaveDom(nd);
				}
				FamilyLog(f, "fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", nd, "Отвязал Дом");
				FamilyInfo[f][fDop5] = 0;
				SaveFamily(f);
			}
			PlayerPlaySound(playerid,40405,0,0,0);
			pc_cmd_fam(playerid);
		}
		else pc_cmd_fam(playerid);
	}
