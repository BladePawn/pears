stock infodom(playerid, idom)
{
	new str[100],sctring[1300];
 	format(str,sizeof(str),"{0088ff}* № %d",idom), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Владелец: {ff9000}%s", DomInfo[idom][dVlad]), strcat(sctring,str);
   	if(DomInfo[idom][dClass] == 5) format(str,sizeof(str),"\nКласс: {ff9000}VIP Дом"), strcat(sctring,str);
	else format(str,sizeof(str),"\nКласс: {ffffff}%d", DomInfo[idom][dClass]), strcat(sctring,str);
   	if(DomInfo[idom][dGold] > 0) format(str,sizeof(str),"\n{cccccc}Стоимость Дома: {99ff66}%d$ {cccccc}(%s) {ffcc00}[ %dG ]",DomInfo[idom][dSost2], get_k(DomInfo[idom][dSost2]), DomInfo[idom][dGold]), strcat(sctring,str);
   	else format(str,sizeof(str),"\n{cccccc}Стоимость Дома: {99ff66}%d$ {cccccc}(%s)",DomInfo[idom][dSost2], get_k(DomInfo[idom][dSost2])), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Дистанция для маппинга: {ffffff}%.0f",DomInfo[idom][dMapDistance]), strcat(sctring,str);
   	if(DomInfo[idom][dIngar] >= 1) format(str,sizeof(str),"\n{cccccc}Гараж: {ffffff}установлен"), strcat(sctring,str);
   	if(DomInfo[idom][dInspa] >= 1) format(str,sizeof(str),"\n{cccccc}Особый Спавн: {ffffff}установлен"), strcat(sctring,str);
   	if(DomInfo[idom][dIntoi] >= 1) format(str,sizeof(str),"\n{cccccc}Туалет: {ffffff}установлен"), strcat(sctring,str);
   	if(DomInfo[idom][dInsin] >= 1) format(str,sizeof(str),"\n{cccccc}Раковина: {ffffff}установлена"), strcat(sctring,str);
   	if(DomInfo[idom][dInsou] >= 1) format(str,sizeof(str),"\n{cccccc}Душ: {ffffff}установлен"), strcat(sctring,str);
   	if(DomInfo[idom][dInbedL] >= 1 || DomInfo[idom][dInbedR] >= 1) format(str,sizeof(str),"\n{cccccc}Кровать: {ffffff}установлена"), strcat(sctring,str);

	new kolobj = 0;
	for(new oba = 0; oba < MAX_OBJECT_INT; oba++)
	{
		if(DomInfo[idom][dOmodel][oba] >= 1) kolobj ++;
	}
	format(str,sizeof(str),"\n{cccccc}Объекты и предметы: {ffffff}%d/%d", kolobj, GetMaxDomObjects(idom)), strcat(sctring,str);

	if(DomInfo[idom][dSost] > 0 && (DomInfo[idom][dSost] == PlayerInfo[playerid][pID] || PlayerInfo[playerid][pSoska] >= 20))
	{
	    if(DomInfo[idom][dFreeze] == 0)
	    {
			new osall = DomInfo[idom][dData]-gettime();
			new osday = osall/86400;
			new oshour = (osall-osday*86400)/3600;
			if(osday >= 20) format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {ffffff}%d/10 {99ff66}[ Слив Через: %d дней %d часов ] ", DomInfo[idom][dPastime], osday, oshour), strcat(sctring,str);
			else if(osday <= 19 && osday >= 10) format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {ffffff}%d/10 {ffcc00}[ Слив Через: %d дней %d часов ] ", DomInfo[idom][dPastime], osday, oshour), strcat(sctring,str);
			else format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {ffffff}%d/10 {FF6347}[ Слив Через: %d дней %d часов ] ", DomInfo[idom][dPastime], osday, oshour), strcat(sctring,str);
			format(str,sizeof(str),"\n\n{cccccc}Каждые собранные 10 часов счётчик сбрасывается (Возвращаются 30 дней)"), strcat(sctring,str);
		}
		else format(str,sizeof(str),"\n{cccccc}Часов Отыграно: {99ff66}Слив дома заморожен"), strcat(sctring,str);
	}
	format(str,sizeof(str),"\n\n{cccccc}Команды Управления: {999999}/domin /domac"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/dedit - редактор объектов"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/eo - переместить объект"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/rx /ry /rz - вращать объект"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/dobject - удалить объект"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/to - ретекстур объекта"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/io - информация об объекте"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/cmat /pmat - копировать и применить ретекстур"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}/oclone - клонировать объект"), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}/myint {cccccc}- личный архив интерьеров"), strcat(sctring,str);
	ShowDialog(playerid,893,DIALOG_STYLE_MSGBOX,"{ff9000}Дом",sctring,"*","");
	return 1;
}
stock infofam(playerid, fam)
{
	new str[120],sctring[2310];
 	format(str,sizeof(str),"\n\n{cccccc}[ %s {cccccc}] {ffffff}№%d",FamilyInfo[fam][fName],fam), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Владелец: {ff9000}%s [%d]", FamilyInfo[fam][fOsn], FamilyInfo[fam][fOwner]), strcat(sctring,str);
   	if(FamilyInfo[fam][fStatusUch]==0) format(str,sizeof(str),"\n{cccccc}Участники: {ffffff}[%d/10]",FamilyInfo[fam][fDop1]), strcat(sctring,str);
   	else if(FamilyInfo[fam][fStatusUch]==1) format(str,sizeof(str),"\n{cccccc}Участники: {ffffff}[%d]",FamilyInfo[fam][fDop1]), strcat(sctring,str);
	if(FamilyInfo[fam][fDop5]>=1) format(str,sizeof(str),"\n{cccccc}Синхронизация с Домом: {ffffff}№ %d", FamilyInfo[fam][fDop5]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Тип семьи: {ffffff}%s", famTypeName[FamilyInfo[fam][fType]]), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{cccccc}Команды Управления:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}/f /leavefam /famdip /invitefam /uninvitefam /giverankfam"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}/fammute /famforce /fmembers /fmembersoff /fmoney /famac"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}/frank /famdonate /fambiz\n\n"), strcat(sctring,str);
	if(FamilyInfo[fam][fType] == 4)
	{
		format(str,sizeof(str),"\n{cccccc}Семья типа StreetRacers:"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Данный тип семьи может создавать гоночные маршруты"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Организовывать сходки на которых можно устраивать гонку до 8 человек"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Оформлять партнёрства с бизнесами для продвижения продаж на сходках"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Команды типа StreetRacers:"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}/scp - запись чекпоинтов | /scpa - меню управления чекпоинтами"), strcat(sctring,str);
	}
	if(FamilyInfo[fam][fType] == 3)
	{
		format(str,sizeof(str),"\n{cccccc}Семья типа {FF6347}SEKTA{cccccc}:"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Данный тип конкурирует с другими семьями такого же типа"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Проведение обрядов и получение Таблеток Защиты/Атаки"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Возможность поедать органы у людей в предсмертном состоянии[ ПКМ + ALT ]"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}- Проведение эфиров с продвижением своей идеологии[ /gnews ]"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Система влияния:"), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Влияние - {999999}является показателем того, насколько семья типа {FF6347}SEKTA{999999} является выше других."), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}Оно будет постоянно изменяться, т.к. зависит от ранга участников семьи в оф. организациях."), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}Его можно гарантированно повысить, проводя эфиры в CNN от лица Секты или же проводя обряды."), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Эфиры секты {999999}-проводятся 1 раз в день, для проведения нужно угнать машину CNN."), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}Эфир длится максимум 10 минут. Чем дольше идёт эфир тем больше влияния получит секта."), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Алтарь {999999}-объект у которого проводятся обряды. За разрушение алтаря другой секты"), strcat(sctring,str);
		format(str,sizeof(str),"\n{999999}можно снизить её влияние в штате. Алтари необходимо прятать и хорошо защищать."), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Обряд {999999}-проводится 1 раз в день, у Алтаря Секты, для обряда нужна жертва."), strcat(sctring,str);
	}
	ShowDialog(playerid,2001,DIALOG_STYLE_MSGBOX,"Family",sctring,"*","");
	return 1;
}
