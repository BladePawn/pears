stock checksimvolPromo(const string[])
{
	for(new i; i < strlen(string); i++)
	{
     	switch(string[i])
     	{
      		case '0'..'9': { }
      		case 'A'..'Z': { }
      		case 'a'..'z': { }
      		case 'А'..'Я': { }
      		case 'а'..'я': { }
