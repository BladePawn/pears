alias:ss("showskill", "showskills", "showskil", "showskils")
CMD:ss(playerid, const params[])
{
	new giveplayerid,string[124];
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(box[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я на ринге");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	if (!sscanf(params, "u",giveplayerid))
 	{
		if(IsOnline(giveplayerid))
		{
			if(giveplayerid != INVALID_PLAYER_ID)
			{
			    if (ProxDetectorS(2.0, playerid, giveplayerid))
				{
				    if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем я буду показывать свои навыки себе ? [ /skill ]");
				    if(GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
				    if(OnlineInfo[giveplayerid][oLogged] == 1) ShowSkill(giveplayerid,playerid);
	                PlayerPlaySound(giveplayerid,40405,0,0,0);
	                format(string, sizeof(string), "* %s демонстрирует свои навыки %s", playername(playerid), playername(giveplayerid));
	       		    ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				}
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
			}
		}
	    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать навыки [ /showskill ID ]");
    return 1;
}
CMD:tehboat(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,9.0,-1354.3800,390.9729,1.1538) || IsPlayerInRangeOfPoint(playerid,9.0,-1353.9266,354.7160,1.1538))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
	    	new veh = GetPlayerVehicleID(playerid);
	    	new modelka = VehInfo[veh][vModel];
	    	if(!IsABoat(modelka)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это станция обслуживания катеров");
	    	if(!IsADepart(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Эта станция обслуживания доступна только сотрудникам департамента");
			if(VehInfo[veh][vEngine] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно заглушить двигатель");
			new Float:health;
 			GetVehicleHealth(veh, health);
 			if(health >= MaxVehicleHealth(VehInfo[veh][vModel], veh)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Транспорт в идеальном состоянии и не требует ремонта");
    		ACRepairVehicle(veh);
			new Float:health_veh = MaxVehicleHealth(VehInfo[veh][vModel], veh);
			ACSetVehicleHealth(veh, health_veh);
   			PlayerPlaySound(playerid,32000,0,0,0);
   			SendClientMessage(playerid, COLOR_GREY, "{336633}[ NGSA ]: {cccccc}Ремонт транспорта {99ff66}выполнен");
		}
	}
	return 1;
}
CMD:tehavia(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,9.0,337.2293,1943.6638,20.1840)
	|| IsPlayerInRangeOfPoint(playerid,9.0,308.0487,2072.8772,17.6566) || IsPlayerInRangeOfPoint(playerid,9.0,-1265.4033,433.9524,24.7980) || IsPlayerInRangeOfPoint(playerid,9.0,-1312.0056,493.8275,18.2344))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
	    	new veh = GetPlayerVehicleID(playerid);
	    	new modelka = VehInfo[veh][vModel];
	    	if(!IsAPlane(modelka)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это станция обслуживания самолётов и вертолётов");
	    	if(!IsADepart(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Эта станция обслуживания доступна только сотрудникам департамента");
			if(VehInfo[veh][vEngine] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно заглушить двигатель");
			if(GetVehicleSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Невозможно обслуживать транспорт во время движения");
			new Float:health;
 			GetVehicleHealth(veh, health);
 			if(health >= MaxVehicleHealth(VehInfo[veh][vModel], veh)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Транспорт в идеальном состоянии и не требует ремонта");
    		ACRepairVehicle(veh);
			new Float:health_veh = MaxVehicleHealth(VehInfo[veh][vModel], veh);
			ACSetVehicleHealth(veh, health_veh);
   			PlayerPlaySound(playerid,32000,0,0,0);
   			SendClientMessage(playerid, COLOR_GREY, "{336633}[ NGSA ]: {cccccc}Ремонт транспорта {99ff66}выполнен");
		}
	}
	return 1;
}
CMD:tehveh(playerid)
{
	new g;
	if (IsPlayerInRangeOfPoint(playerid,5.0,278.5299,1998.0135,17.6928) || IsPlayerInRangeOfPoint(playerid,5.0,-1242.2087,439.4430,7.2937)) g = 3;
	else if (IsPlayerInRangeOfPoint(playerid,5.0,1587.4812,-1669.5905,5.8907)) g = 1;
	else if (IsPlayerInRangeOfPoint(playerid,5.0,2113.492187, 2384.904296, 10.560301)) g = 2;
	else return 0;

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new veh = GetPlayerVehicleID(playerid);
		new modelka = VehInfo[veh][vModel];
		if(IsACar(modelka) || IsAMoto(modelka))
		{
			if(!IsADepart(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Эта станция обслуживания доступна только сотрудникам департамента");
			if(VehInfo[veh][vEngine] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно заглушить двигатель");
			if(GetVehicleSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Невозможно обслуживать транспорт во время движения");
			new Float:health;
			GetVehicleHealth(veh, health);
			if(health >= MaxVehicleHealth(VehInfo[veh][vModel], veh)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Транспорт в идеальном состоянии и не требует ремонта");
			ACRepairVehicle(veh);
			new Float:health_veh = MaxVehicleHealth(VehInfo[veh][vModel], veh);
			ACSetVehicleHealth(veh, health_veh);
			PlayerPlaySound(playerid,32000,0,0,0);
			SendClientMessage(playerid, COLOR_GREY, "[ %s {cccccc}]: {cccccc}Ремонт транспорта {99ff66}выполнен", frakName[g]);
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это станция обслуживания наземной техники");
	}
	return 1;
}
CMD:teh(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid,5.0,2276.8972,534.0618,1.0)
	|| IsPlayerInRangeOfPoint(playerid,5.0,-1467.3530,669.2661,1.0)
	|| IsPlayerInRangeOfPoint(playerid,5.0,2741.2739,-2316.9890,1.0))
    {
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
			if(IsPlayerInRangeOfPoint(playerid,5.0,2276.8972,534.0618,1.0)) DP[5][playerid] = 199;
			else if(IsPlayerInRangeOfPoint(playerid,5.0,-1467.3530,669.2661,1.0)) DP[5][playerid] = 198;
			else if(IsPlayerInRangeOfPoint(playerid,5.0,2741.2739,-2316.9890,1.0)) DP[5][playerid] = 197;
    	  	new modelka = VehInfo[GetPlayerVehicleID(playerid)][vModel];
	    	if(!IsABoat(modelka)) return ErrorMessage(playerid, "{FF6347}Это станция обслуживания только для лодок и катеров");
	    	if(VehInfo[GetPlayerVehicleID(playerid)][vEngine] == 1) return ErrorMessage(playerid, "{FF6347}Заглушите двигатель");
	    	if(GetVehicleSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Остановите транспорт\n\n{cccccc}Обслуживание невозможно во время движения");
	    	ShowDialog(playerid,761,DIALOG_STYLE_LIST,"{ff9000}Станция Обслуживания","{cccccc}Полный Ремонт\n{cccccc}Покраска\n{cccccc}Заправка\n{cccccc}Сдать в Утиль {ff9000}[ Личный Катер ]","Выбор","Отмена");
		}
	}
	else if(IsPlayerInRangeOfPoint(playerid,10.0,1314.3856,1318.0668,13.2478) || IsPlayerInRangeOfPoint(playerid,10.0,1325.3025,1367.5544,10.8711)
	|| IsPlayerInRangeOfPoint(playerid,10.0,-1268.7576,-496.7033,16.5299) || IsPlayerInRangeOfPoint(playerid,10.0,-1274.4015,-382.4560,14.2233)
	|| IsPlayerInRangeOfPoint(playerid,10.0,1900.0872,-2364.4246,15.9853) || IsPlayerInRangeOfPoint(playerid,10.0,1886.3257,-2286.6711,13.6086))
    {
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
			if(IsPlayerInRangeOfPoint(playerid,10.0,1314.3856,1318.0668,13.2478) || IsPlayerInRangeOfPoint(playerid,10.0,1325.3025,1367.5544,10.8711)) DP[5][playerid] = 195;
			else if(IsPlayerInRangeOfPoint(playerid,10.0,-1268.7576,-496.7033,16.5299) || IsPlayerInRangeOfPoint(playerid,10.0,-1274.4015,-382.4560,14.2233)) DP[5][playerid] = 194;
			else if(IsPlayerInRangeOfPoint(playerid,10.0,1900.0872,-2364.4246,15.9853) || IsPlayerInRangeOfPoint(playerid,10.0,1886.3257,-2286.6711,13.6086)) DP[5][playerid] = 193;
	    	new modelka = VehInfo[GetPlayerVehicleID(playerid)][vModel];
	    	if(!IsAPlane(modelka)) return ErrorMessage(playerid, "{FF6347}Это станция обслуживания только для самолётов и вертолётов");
	    	if(VehInfo[GetPlayerVehicleID(playerid)][vEngine] == 1) return ErrorMessage(playerid, "{FF6347}Заглушите двигатель");
	    	if(GetVehicleSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Остановите транспорт\n\n{cccccc}Обслуживание невозможно во время движения");
	    	ShowDialog(playerid,761,DIALOG_STYLE_LIST,"{ff9000}Станция Обслуживания","{cccccc}Полный Ремонт\n{cccccc}Покраска\n{cccccc}Заправка\n{cccccc}Сдать в Утиль {ff9000}[ Личный Авиатранспорт ]","Выбор","Отмена");
		}
	}
	return 1;
}

alias:ud("udostoverenie")
CMD:ud(playerid, const params[])
{
	if(CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Вы смотрите CNN Channel");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы на ринге");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	if (sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать удостоверение [ /ud ID ]");

	if(!IsADepart(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник департамента");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Игрока нет на сервере");
	if(!ProxDetectorS(3.0,playerid,params[0])) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко от игрока");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко от игрока");

	PlayerPlaySound(params[0],40405,0,0,0);
	if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false, SYNC_ALL), TurnPlayerFaceToPlayer(playerid, params[0]);

	new string[100];
	format(string, sizeof(string), "* %s показывает своё удостоверение %s", playername(playerid), playername(params[0]));
	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	new g = fraction(playerid);

	new line[130],lines[650];
	format(line,sizeof(line),"{0088ff}______________________________[ {ffffff}Удостоверение {0088ff}]______________________________"), strcat(lines,line);
	format(line,sizeof(line),"\n\n{cccccc}Имя Фамилия: {0088ff}%s",PlayerInfo[playerid][pName]), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Организация: %s",fraklastName[g]), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Должность: {0088ff}%s", getNameRank(playerid)), strcat(lines,line);
	format(line,sizeof(line),"\n\n{0088ff}_____________________________________________________________________________"), strcat(lines,line);
	ShowDialog(params[0],1400,DIALOG_STYLE_MSGBOX,"{0088ff}Удостоверение",lines,"*","");
    return 1;
}

alias:pas("pass", "showpas", "showpass", "pasport", "passport")
CMD:pas(playerid, const params[])
{
	if(get_invent2(playerid, 51, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет паспорта");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(box[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я на ринге");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать паспорт [ /pas ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Его вообще нет..");
	if(!ProxDetectorS(3.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я слишком далеко");
	PlayerPlaySound(params[0],40405,0,0,0);
	new atext[8], btext[20];//, ctext[20];
	if(PlayerInfo[playerid][pSex] == 1) atext = "Мужчина";
	else atext = "Женщина";
	if(PlayerInfo[playerid][pBilet] == 1) btext = "{99ff66}имеется";
 	else btext = "{FF6347}отсутствует";
 	//if(PlayerInfo[playerid][pNation] == 0) ctext = "Светлокожий";
 	//else ctext = "Темнокожий";
	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0 && playerid != params[0]) ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false, SYNC_ALL), TurnPlayerFaceToPlayer(playerid, params[0]);
	new str[114],sctring[784];
    format(str,sizeof(str),"\n{cccccc}Имя Фамилия: {ff9000}%s",PlayerInfo[playerid][pName]), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Возраст: {ffffff}%d",PlayerInfo[playerid][pAge]), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Пол: {ffffff}%s",atext), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Проживание в Штате: {ffffff}%d лет",PlayerInfo[playerid][pLevel]), strcat(sctring,str);
    if(PlayerInfo[playerid][pMarried] >= 1) format(str,sizeof(str),"\n{cccccc}Семейное положение: {99ff66}%s",PlayerInfo[playerid][pMarriedTo]), strcat(sctring,str);
    else
	{
		if(PlayerInfo[playerid][pSex] == 1)format(str,sizeof(str),"\n{cccccc}Семейное положение: {FF6347}не женат"), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Семейное положение: {FF6347}не замужем"), strcat(sctring,str);
	}
	format(str,sizeof(str),"\n{cccccc}Военный билет: %s",btext), strcat(sctring,str);
	
	new mylic[7], alienlic[7];
	// Лицензии на своё имя
	mylic[0] = get_lic(playerid, 156);
	mylic[1] = get_lic(playerid, 157);
	mylic[2] = get_lic(playerid, 158);
	mylic[3] = get_lic(playerid, 159);
	mylic[4] = get_lic(playerid, 161);
	mylic[5] = get_lic(playerid, 162);
	mylic[6] = get_lic(playerid, 160);

	// Лицензии на чужое имя
	get_alienlic(playerid, alienlic[0], alienlic[1], alienlic[2], alienlic[3], alienlic[4], alienlic[5], alienlic[6]);

	if(mylic[0] > 0) format(str,sizeof(str),"\n{cccccc}Водительские права: {99ff66}имеются"), strcat(sctring,str);
	else if (alienlic[0] > 0) format(str,sizeof(str),"\n{cccccc}Водительские права: {99ff66}имеются {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);
	
	if(mylic[1] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия пилота: {99ff66}имеется"), strcat(sctring,str);
	else if (alienlic[1] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия пилота: {99ff66}имеется {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);
	
	if(mylic[2] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия водного транспорта: {99ff66}имеется"), strcat(sctring,str);
	else if (alienlic[2] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия водного транспорта: {99ff66}имеется {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);
	
	if(mylic[3] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия мототранспорта: {99ff66}имеется"), strcat(sctring,str);
	else if (alienlic[3] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия мототранспорта: {99ff66}имеется {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);
	
	if(mylic[4] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [1]: {99ff66}имеется"), strcat(sctring,str);
	else if (alienlic[4] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [1]: {99ff66}имеется {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);
	
	if(mylic[5] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [2]: {99ff66}имеется"), strcat(sctring,str);
	else if (alienlic[5] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [2]: {99ff66}имеется {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);
	
	if(mylic[6] > 0) format(str,sizeof(str),"\n{cccccc}Высшее образование: {99ff66}имеется"), strcat(sctring,str);
	else if (alienlic[6] > 0) format(str,sizeof(str),"\n{cccccc}Высшее образование: {99ff66}имеется {FF6347}[ Документы на другое имя ]"), strcat(sctring,str);

	//format(str,sizeof(str),"\n{cccccc}Дополнительно: {ffffff}%s",ctext), strcat(sctring,str);
	format(str,sizeof(str),"\n"), strcat(sctring,str);
    ShowDialog(params[0],1742,DIALOG_STYLE_MSGBOX,"{0088ff}Паспорт",sctring,"*","");
    if(params[0] != playerid)
    {
		new string[100];
    	format(string, sizeof(string), "* %s показывает свой паспорт %s", playername(playerid), playername(params[0]));
    	ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
   	}
	return 1;
}
CMD:gotaxi(playerid, const params[])
{
	if(get_invent4(playerid, 24, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет шашки таксиста [ Y >> GPS >> Услуги >> Супермаркет ]");
	if(get_invent4(playerid, 26, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return ErrorMessage(playerid, "{FF6347}Ваш смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Вы не за рулём");

	new veh = GetPlayerVehicleID(playerid);
	if(!IsATaxi(veh)) return ErrorMessage(playerid, "{FF6347}Этот транспорт не годится для работы в такси. Вам некуда посадить пассажира..");
	if(VehInfo[veh][v3dstat] == 0)
	{
		if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Начать смену такси [ /gotaxi Тариф ]");
		if(params[0] > 900 || params[0] < 10) return ErrorMessage(playerid, "{FF6347}Тариф за километр не больше 900$ и не меньше 10$");
		if(VehInfo[veh][v3dstat] == 7000) return ErrorMessage(playerid, "{FF6347}Этот транспорт сейчас используется в автобусном депо");

		ReloadVehicleLabel(veh); // Перезагружаем лейбл на тс

		VehInfo[veh][v3dstat] = params[0];
		new Float:X,Float:Y,Float:Z;
		GetVehiclePos(veh, X,Y,Z);

		new string[100];
		format(string,sizeof(string),"{ffcc00}.::[ TAXI ]::.\n\n{cccccc}Тариф: {99ff66}%d$ {cccccc}/ КМ ",params[0]);
		VehLabel[veh] = CreateDynamic3DTextLabel(string,0xA9C4E4FF,X,Y,Z, 20.0, INVALID_PLAYER_ID, veh);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Дежурство Taxi: {99ff66}[ Активировано ]");
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Завершить дежурство [ /gotaxi ]");
		format(string, sizeof(string), "* %s начинает дежурство Taxi", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"начинает дежурство Taxi",COLOR_PURPLE,20.0,3000);
		PlayerPlaySound(playerid,6400,0,0,0);
		VehInfo[veh][vVodila] = playerid;
		VehInfo[veh][vPassajir] = 9999;
	}
	else if(VehInfo[veh][v3dstat] >= 1 && VehInfo[veh][v3dstat] <= 900)
	{
		if(VehInfo[veh][vPassajir] != 9999) return ErrorMessage(playerid, "{FF6347}В такси сидит пассажир, его нужно высадить {ff9000}[ /eject ]");
		DestroyDynamic3DTextLabel(VehLabel[veh]);
		VehInfo[veh][v3dstat] = 0;
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Дежурство Taxi: {ff0000}[ Завершено ]");
		SetPlayerChatBubble(playerid,"завершает дежурство Taxi",COLOR_PURPLE,20.0,3000);
		PlayerPlaySound(playerid,6400,0,0,0);
		VehInfo[veh][vVodila] = 9999;
	}
	return 1;
}
CMD:psih(playerid,const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(50, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник ASGH");
	if(!GetAccessRankOrg(playerid, g, 50, NO_FBI)) return 1;

	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посадить в психиатрическое отделение [ /psih ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете посадить в психушку себя");

	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");

	new mojno = 0;
	for(new c = 0; c < MAX_CARS; c++)
	{
		if(VehInfo[c][vObjstat] == 3)
		{
			new Float: X, Float: Y, Float: Z;
			GetVehiclePos(c, X, Y, Z);
			if(IsPlayerInRangeOfPoint(params[0], 8.0, X, Y, Z)) mojno = 1;
		}
	}
	if(IsPlayerInRangeOfPoint(params[0], 8.0, 1181.4121,-1339.0206,13.7441) || IsPlayerInRangeOfPoint(params[0], 8.0, 2014.6405,-1414.8030,16.9915)) mojno = 2;
	if(mojno == 0) return ErrorMessage(playerid, "{FF6347}Вы можете посадить игрока в психушку только в зоне медицинской помощи");
	
	if(PlayerInfo[params[0]][pJailed] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете отправить заключённого на принудительное лечение");
	if(PlayerInfo[params[0]][pAmmos2] <= 49) return ErrorMessage(playerid, "{FF6347}Вы не можете отправить в психиатрическую лечебницу здорового человека");
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вы в транспорте");
	if(GetPVarInt(params[0],"afksystem") >= 5) return ErrorMessage(playerid, "{FF6347}Этот игрок AFK");

	if(DeathInfo[params[0]][deathStatus]) ACSetPlayerHealth(params[0], GetMaxPlayerHealth(params[0])); // Выводим из стадии

	new string[180];
	format(string, sizeof(string), "* Вы отправили %s на лечение!", playername(params[0]));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	PlayerPlaySound(playerid,6401,0,0,0);

	format(string, sizeof(string), RusToGame("%s отправил вас на принудительное лечение"),PlayerInfo[playerid][pName]);
	GameTextForPlayer(params[0], string, 5000, 5);

	if(PlayerInfo[params[0]][pMember] != 4 && PlayerInfo[params[0]][pLeader] != 4)
	{
		if(mojno == 1) bigint_add(OrganInfo[4][glave], 3000), GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~w~Пациент:~g~ Отправлен!~n~~r~ASGH:~g~ +3000$"), 5000, 3);
		else bigint_add(OrganInfo[4][glave], 5000), GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~w~Пациент:~g~ Отправлен!~n~~r~ASGH:~g~ +5000$"), 5000, 3);
		OrganInfo[4][gUpdate] = 1;
	}
	TempTake(params[0], 0);
	PlayerInfo[params[0]][pJailed] = 6;
	if(mojno == 1) PlayerInfo[params[0]][pJailTime] = PlayerInfo[params[0]][pAmmos2]*10;
	else PlayerInfo[params[0]][pJailTime] = PlayerInfo[params[0]][pAmmos2]*5;
	SendClientMessage(params[0], COLOR_LIGHTRED, "* Вы были отправлены на принудительное лечение!");
	format(string, sizeof(string), "* Вас отправили на принудительное лечение в Психиатрическое Отделение [ Осталось: %d секунд ]", PlayerInfo[params[0]][pJailTime]);
	SendClientMessage(params[0], COLOR_LIGHTRED, string);

	format(string, sizeof(string), "Отправил в психушку на %d секунд ", PlayerInfo[params[0]][pJailTime]);
	OrgLog(g, "psih", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], PlayerInfo[params[0]][pAmmos2], string);

	PlayerInfo[params[0]][pAmmos2] = 0;
	PPSpawnPlayer(params[0]);

	format(string, sizeof(string), "воткнул%s шприц в шею %s", gender(playerid), playername(params[0]));
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,7000);
	format(string, sizeof(string), "* %s воткнул%s шприц в шею %s.", PlayerInfo[playerid][pName], gender(playerid), playername(params[0]));
	ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	TextDrawShowForPlayer(params[0], Chernifon);
	new str[100],sctring[500];
	format(str,sizeof(str),"{ff6666} Вас отправили на принудительное лечение!");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{ffffff}Причина: {cccccc}Высокий уровень неадекватного поведения.");
	strcat(sctring,str);
	format(str,sizeof(str),"\n\n\n{cccccc}Чем больше вы используете нецензурную лексику в разговоре,");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}тем выше ваш уровень опасности для окружающий.");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Лучшие психиатры штата проследят за вашим поведением. {ff6666}[ /time ]");
	strcat(sctring,str);
	ShowDialog(params[0],1742,DIALOG_STYLE_MSGBOX,"{0088ff}Психиатрическая Лечебница",sctring,"Oк","");
	return 1;
}

stock ClearBedMed(playerid)
{
	if(HospBed[playerid] >= 0 && HospBed[playerid] <= 25)
	{
		UpdateDynamic3DTextLabelText(HospLabel[HospBed[playerid]],0xA9C4E4FF,"{ff6666}Койка Госпиталя\n{444444}[ {99ff66}Свободна {444444}]\n\n{cccccc}Кнопка - ALT: занять койку\nВаше здоровье быстрее пополнится");
		hosp_bed[HospBed[playerid]] = 0, HospBed[playerid] = 9999;
	}
	return 1;
}
CMD:gomed(playerid)
{
	if(IsAMedR(playerid) || IsAMedL(playerid))
	{
		if(PlayerInfo[playerid][pJailed] == 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Если я займу койку, мне не поможет это вылечиться быстрее [ /time ]");
		if(PlayerInfo[playerid][pJailed] == 1 || PlayerInfo[playerid][pJailed] == 2 || PlayerInfo[playerid][pJailed] == 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я сбежавший заключённый, мне лучше избегать государственных учереждений!");
		if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7 || HealthAC[playerid] <= GetMaxPlayerHealth(playerid) * 0.9)
		{
			if(PlayerInfo[playerid][pJailed] == 7)
			{
				SetCameraBehindPlayer(playerid);
	        	TogglePlayerControllable(playerid, true);
	        	ClearAnim(playerid);
	        	NoAnim[playerid] = 0;
	        	PlayerInfo[playerid][pJailed] = 4;
				if(HospBed[playerid] != 9999) ClearBedMed(playerid);
	        	PlayerPlaySound(playerid,40405,0,0,0);
				return 1;
			}
			new medbed = 9999, daispat = 0;
			// 1 Палата
			if(IsPlayerInRangeOfPoint(playerid,1.5,1407.2517,0.1218,1000.9218) && GetPlayerVirtualWorld(playerid) == 5) medbed = 0;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1409.8120,0.1220,1000.9230) && GetPlayerVirtualWorld(playerid) == 5) medbed = 1;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1412.3832,0.1220,1000.9243) && GetPlayerVirtualWorld(playerid) == 5) medbed = 2;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1414.9633,0.1201,1000.9255) && GetPlayerVirtualWorld(playerid) == 5) medbed = 3;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1414.5823,-6.5845,1000.9253) && GetPlayerVirtualWorld(playerid) == 5) medbed = 4;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1412.0208,-6.5846,1000.9241) && GetPlayerVirtualWorld(playerid) == 5) medbed = 5;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1409.4484,-6.5418,1000.9228) && GetPlayerVirtualWorld(playerid) == 5) medbed = 6;

			// 2 Палата
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1406.2900,-9.3060,1000.9217) && GetPlayerVirtualWorld(playerid) == 5) medbed = 7;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1408.8522,-9.2590,1000.9225) && GetPlayerVirtualWorld(playerid) == 5) medbed = 8;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1411.4246,-9.2351,1000.9238) && GetPlayerVirtualWorld(playerid) == 5) medbed = 9;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1414.1555,-9.3263,1000.9251) && GetPlayerVirtualWorld(playerid) == 5) medbed = 10;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1414.1619,-16.1146,1000.9251) && GetPlayerVirtualWorld(playerid) == 5) medbed = 11;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1411.6003,-16.1146,1000.9239) && GetPlayerVirtualWorld(playerid) == 5) medbed = 12;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1409.0278,-16.1146,1000.9226) && GetPlayerVirtualWorld(playerid) == 5) medbed = 13;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1409.4581,-18.8964,1000.9228) && GetPlayerVirtualWorld(playerid) == 5) medbed = 14;

			// 3 Палата
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1406.2972,-16.1121,1000.9217) && GetPlayerVirtualWorld(playerid) == 5) medbed = 15;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1412.0305,-18.8348,1000.9241) && GetPlayerVirtualWorld(playerid) == 5) medbed = 16;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1414.7614,-18.8629,1000.9254) && GetPlayerVirtualWorld(playerid) == 5) medbed = 17;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1414.1619,-25.9630,1000.9251) && GetPlayerVirtualWorld(playerid) == 5) medbed = 18;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1411.6003,-26.0016,1000.9239) && GetPlayerVirtualWorld(playerid) == 5) medbed = 19;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1409.0278,-25.9962,1000.9226) && GetPlayerVirtualWorld(playerid) == 5) medbed = 20;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1406.2972,-26.0037,1000.9217) && GetPlayerVirtualWorld(playerid) == 5) medbed = 21;

			// Военный Госпиталь
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1386.0879,-23.0358,1000.9158) && GetPlayerVirtualWorld(playerid) == 203) medbed = 22;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1389.6095,-22.9644,1000.9158) && GetPlayerVirtualWorld(playerid) == 203) medbed = 23;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1391.3684,-30.3894,1000.9158) && GetPlayerVirtualWorld(playerid) == 203) medbed = 24;
			else if(IsPlayerInRangeOfPoint(playerid,1.5,1387.8462,-30.3897,1000.9158) && GetPlayerVirtualWorld(playerid) == 203) medbed = 25;

			if(hosp_bed[medbed] >= 1) return ErrorMessage(playerid, "{FF6347}Эта койка занята");
			if(medbed == 9999) return ErrorMessage(playerid, "{FF6347}Вы далеко от койки");
			if(IsAMedR(playerid)) // Ложимся спать направо
			{
				if(IsAS0(playerid))PPSetPlayerFacingAngle(playerid, 0.0);
				else if(IsAS90(playerid))PPSetPlayerFacingAngle(playerid, 90.0);
				else if(IsAS180(playerid))PPSetPlayerFacingAngle(playerid, 180.0);
				else if(IsAS270(playerid))PPSetPlayerFacingAngle(playerid, 270.0);
				else if(IsAS360(playerid))PPSetPlayerFacingAngle(playerid, 360.0);
				ApplyAnimation(playerid,"INT_HOUSE","BED_In_R",4.0, false, false, false, true, false);
				NoAnim[playerid] = 1;
				daispat = 1;
			}
			else if(IsAMedL(playerid)) // Ложимся спать налево
			{
				if(IsAS0(playerid))PPSetPlayerFacingAngle(playerid, 0.0);
				else if(IsAS90(playerid))PPSetPlayerFacingAngle(playerid, 90.0);
				else if(IsAS180(playerid))PPSetPlayerFacingAngle(playerid, 180.0);
				else if(IsAS270(playerid))PPSetPlayerFacingAngle(playerid, 270.0);
				else if(IsAS360(playerid))PPSetPlayerFacingAngle(playerid, 360.0);
				ApplyAnimation(playerid,"INT_HOUSE","BED_In_L",4.0, false, false, false, true, false);
				NoAnim[playerid] = 1;
				daispat = 2;
			}
			if(daispat >= 1)
			{
				GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
				hosp_bed[medbed] = 1;
				HospBed[playerid] = medbed;
				new string[144];
				format(string, sizeof(string), "{ff6666}Койка Госпиталя\n{444444}[ {ff3333}%s {444444}]", rpplayername(playerid));
				UpdateDynamic3DTextLabelText(HospLabel[medbed],0xA9C4E4FF,string);
				PlayerInfo[playerid][pJailed] = 7;
				if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я занял койку в госпитале {ff6666}[ ALT - встать ]");
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я заняла койку в госпитале {ff6666}[ ALT - встать ]");
				PlayerPlaySound(playerid,6401,0,0,0);
				//if(daispat == 1) SetTimerEx("bedload_r", 2600, false, "d", playerid);
				//else SetTimerEx("bedload_l", 2600, false, "d", playerid);
			}
		}
		else ErrorMessage(playerid, "{FF6347}Вы не пациент этого госпиталя и полностью здоровы");
	}
	return 1;
}
CMD:zmed(playerid, const params[])
{
	if(PlayerInfo[playerid][pMember] == 4 || PlayerInfo[playerid][pLeader] == 4)
	{
		if(PlayerInfo[playerid][pRank] <= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: У меня нет полномочий создать зону медицинской помощи [ 2+ Ранг ]");
		if(GetPVarInt(playerid,"antiflood") > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу так быстро [ Раз в 5 секунд ]");
		if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
		if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
        if(GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я тренируюсь");
        if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	    if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
		new string[144];
		if(IsPlayerInAnyVehicle(playerid))
		{
			if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Мне нужно быть за рулём");
			new veh = GetPlayerVehicleID(playerid);
			new model = VehInfo[veh][vModel];
			if(model == 416 || model == 2096)
			{
				if(VehInfo[veh][vObjstat] == 0)
				{
					ReloadVehicleLabel(veh); // Перезагружаем лейбл на тс

					VehInfo[veh][v3dstat] = 5000; // Зона мед помощи
    				new Float:X,Float:Y,Float:Z;
		  			GetVehiclePos(veh, X,Y,Z);
        			VehLabel[veh] = CreateDynamic3DTextLabel("{ff6666}.::[ СКОРАЯ ПОМОЩЬ ]::.\n\n{cccccc}Лечение: {ff6666}/goheal",0xA9C4E4FF,X,Y,Z, 10.0, INVALID_PLAYER_ID, veh);
					VehInfo[veh][vObject] = CreateDynamicObject(19945, 0.0 ,0.0 ,-50.0 ,0.0 ,0.0 ,0.0); // Создаём Объект
					AttachDynamicObjectToVehicle(VehInfo[veh][vObject], veh, 0.0, 0.0, -5.0, 0.0, 0.0, 0.0);
					VehInfo[veh][vObjstat] = 3;
					SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зона медицинской помощи: {00cc00}[ Установлена ]");
					format(string, sizeof(string), "* %s создаёт зону медицинской помощи", PlayerInfo[playerid][pName]);
	 				ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	 				SetPlayerChatBubble(playerid,"создаёт зону медицинской помощи",COLOR_PURPLE,20.0,3000);
	 				PlayerPlaySound(playerid,6400,0,0,0);
	 				SetPVarInt(playerid,"antiflood",5);
 				}
 				else if(VehInfo[veh][vObjstat] == 3)
				{
					DestroyDynamicObject(VehInfo[veh][vObject]);
					VehInfo[veh][vObjstat] = 0;
					DestroyDynamic3DTextLabel(VehLabel[veh]);
					VehInfo[veh][v3dstat] = 0;
					SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зона медицинской помощи: {ff0000}[ Свёрнута ]");
					format(string, sizeof(string), "* %s сворачивает зону медицинской помощи", PlayerInfo[playerid][pName]);
	 				ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	 				SetPlayerChatBubble(playerid,"сворачивает зону медицинской помощи",COLOR_PURPLE,20.0,3000);
	 				PlayerPlaySound(playerid,6400,0,0,0);
	 				SetPVarInt(playerid,"antiflood",5);
 				}
			}
			else SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Создать зону помощи можно только возле машины скорой помощи {ff9000}Ambulance / Paramedic");
		}
		else
		{
			if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я могу активировать зону только в транспорте или пешком");
			if(PlayerInfo[playerid][pTstat] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу одновременно создавать сделку и зону помощи [ /trade ]");
			if(Heal[playerid] != 7777 && Heal[playerid] != 9999) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу создать свою зону помощи, когда использую другую");
			if(Heal[playerid] == 7777)
			{
				CloseMed(playerid);
			}
			else if(Heal[playerid] == 9999)
			{
				Heal[playerid] = 7777;
				new Float:X,Float:Y,Float:Z;
				GetPlayerPos(playerid, X,Y,Z);
				TradeLabel[playerid] = CreateDynamic3DTextLabel("\n\n\n\n\n\n\n{ff6666}[ ДОКТОР ]\n\n{cccccc}Лечение: {ff6666}/goheal",0xA9C4E4FF,X,Y,Z, 7.0, playerid, INVALID_VEHICLE_ID);
				SetPlayerAttachedObject(playerid, 0, 1240, 1, 1.034999, 0.000000, 0.000000, 0.000000, 89.299942, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зона медицинской помощи: {00cc00}[ Установлена ]");
				format(string, sizeof(string), "* %s создаёт зону медицинской помощи", PlayerInfo[playerid][pName]);
				ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				SetPlayerChatBubble(playerid,"создаёт зону медицинской помощи",COLOR_PURPLE,20.0,3000);
			}
			PlayerPlaySound(playerid,6400,0,0,0);
			SetPVarInt(playerid,"antiflood",5);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не доктор");
	return 1;
}

CMD:goheal(playerid)
{
	if(HealthAC[playerid] < GetMaxPlayerHealth(playerid) || PlayerInfo[playerid][pRanentors] == 1)
	{
		if(Heal[playerid] == 7777) return ErrorMessage(playerid, "{FF6347}Вы не можете лечиться в тот момент когда лечите других");
		new mojno = 0;
		for(new c = 0; c < MAX_CARS; c++)
		{
			if(VehInfo[c][vObjstat] == 3)
			{
				new Float: X, Float: Y, Float: Z;
				GetVehiclePos(c, X, Y, Z);
				if(IsPlayerInRangeOfPoint(playerid, 8.0, X, Y, Z))
				{
					if(IsPlayerInAnyVehicle(playerid))
					{
						new vehicle = GetPlayerVehicleID(playerid);
						if(vehicle != c) return ErrorMessage(playerid, "{FF6347}Вы не можете получить медицинскую помощь сидя в другом транспорте");
					}
					healcar[playerid] = c;
					mojno = 1;
					break;
				}
			}
		}
		foreach(Player,i)
		{
       		if(PlayerInfo[i][pMember] == 4 && Heal[i] == 7777 || PlayerInfo[i][pLeader] == 4 && Heal[i] == 7777)
       		{
				new Float: X, Float: Y, Float: Z;
				GetPlayerPos(i, X, Y, Z);
				if(IsPlayerInRangeOfPoint(playerid, 3.0, X, Y, Z))
				{
					if(IsPlayerInAnyVehicle(playerid))
					{
						new vehicle = GetPlayerVehicleID(playerid);
						new vehmed = GetPlayerVehicleID(i);
						if(vehicle != vehmed) return ErrorMessage(playerid, "{FF6347}Вы не можете получить медицинскую помощь сидя в другом транспорте");
					}
					Heal[playerid] = i;
					mojno = 1;
					break;
				}
       		}
		}
		if(mojno == 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от зоны медицинской помощи");
	}
	else ErrorMessage(playerid, "{FF6347}У вас полная полоса здоровья и вам не нужно лечение");
	return 1;
}

CMD:zarest(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(34, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
	if(!GetAccessRankOrg(playerid, g, 34, PlayerInfo[playerid][pFbi])) return 1;

	if(GetPVarInt(playerid,"antiflood") > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу так быстро [ Раз в 5 секунд ]");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new veh = GetPlayerVehicleID(playerid);
		new model = VehInfo[veh][vModel];
		if(IsAEnforcer(model))
		{
			new string[144];
			if(VehInfo[veh][vObjstat] == 0)
			{
				VehInfo[veh][vObject] = CreateDynamicObject(19947, 0.0 ,0.0 ,-50.0 ,0.0 ,0.0 ,0.0); // Создаём Объект
				AttachDynamicObjectToVehicle(VehInfo[veh][vObject], veh, 0.0, 0.0, -5.0, 0.0, 0.0, 0.0);
				VehInfo[veh][vObjstat] = 2;
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зона Ареста: {00cc00}[ Установлена ]");
				format(string, sizeof(string), "* %s создаёт зону ареста", PlayerInfo[playerid][pName]);
				ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				SetPlayerChatBubble(playerid,"создаёт зону ареста",COLOR_PURPLE,20.0,3000);
				PlayerPlaySound(playerid,6400,0,0,0);
				SetPVarInt(playerid,"antiflood",5);
			}
			else if(VehInfo[veh][vObjstat] == 2)
			{
				DestroyDynamicObject(VehInfo[veh][vObject]);
				VehInfo[veh][vObjstat] = 0;
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зона Ареста: {ff0000}[ Свёрнута ]");
				format(string, sizeof(string), "* %s сворачивает зону ареста", PlayerInfo[playerid][pName]);
				ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				SetPlayerChatBubble(playerid,"сворачивает зону ареста",COLOR_PURPLE,20.0,3000);
				PlayerPlaySound(playerid,6400,0,0,0);
				SetPVarInt(playerid,"antiflood",5);
			}
		}
		else ErrorMessage(playerid, "{FF6347}Вы не за рулём Enforcer");
	}
	else ErrorMessage(playerid, "{FF6347}Вы не за рулём Enforcer");
	return 1;
}

CMD:radar(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(35, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не полицейский");
	new radarid;
	if (!sscanf(params, "d", radarid)) {
		if (radarid < 1 || radarid > MAX_RADARS) return ErrorMessage(playerid, "{FF6347}ID радара от 1 до "#MAX_RADARS);
		radarid--;
		if (!Radar_IsExists(radarid)) return ErrorMessage(playerid, "{FF6347}Указанный радар не существует");
		return Radar_Dialog_Management(playerid, radarid, true);
	}

	Radar_Dialog_List(playerid);

	return 1;
}
CMD:resetticket(playerid, const params[])
{
	if(PlayerInfo[playerid][pMember] == 7 && (PlayerInfo[playerid][pRank] == 10 || PlayerInfo[playerid][pRank] == 11 || PlayerInfo[playerid][pRank] == 12 || PlayerInfo[playerid][pRank] == 13 || PlayerInfo[playerid][pRank] >= 20))
	{
		if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отменить штраф [ /resetticket ID Сумма ]");
		if(params[1] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отменить штраф [ /resetticket ID Сумма ]");
		if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
		if(!ProxDetectorS(2.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Он далеко от меня");
		new string[144];
		if(PlayerInfo[params[0]][pAmmos11] < params[1])
		{
			format(string, sizeof(string), "[ Мысли ]: У %s нет такого количества неоплаченных штрафов",PlayerInfo[params[0]][pName]);
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
		if(PlayerInfo[params[0]][pAmmos11] <= 0)
		{
			format(string, sizeof(string), "[ Мысли ]: У %s нет неоплаченных штрафов",PlayerInfo[params[0]][pName]);
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
		PlayerInfo[params[0]][pAmmos11] -= params[1];
		format(string, sizeof(string), "**** Вы отменили штраф %s в размере %d$.", PlayerInfo[params[0]][pName],params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "**** %s отменил ваш штраф в размере %d$.", PlayerInfo[playerid][pName],params[1]);
		else format(string, sizeof(string), "**** %s отменила ваш штраф в размере %d$.", PlayerInfo[playerid][pName],params[1]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
		// Оповещение Всему Закону
		foreach (Player, i)
		{
			if(IsOnline(i))
			{
   				if(IsADepart(i))
			    {
					format(string, sizeof(string), "[%s]: Отменён Штраф [%s], в размере: [%d$]",PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName],params[1]);
					SendClientMessage(i, COLOR_LIGHTNEUTRALBLUE, string);
				}
			}
		}
		return 1;
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только для руководителей правительства [ Ранг 10+ ]");
	return 1;
}
CMD:love(playerid, const params[])
{
	new year, month,day;
	getdate(year, month, day);
	if(month == 2 && day == 13 || month == 2 && day == 14 || PlayerInfo[playerid][pSoska] >= 22)
	{
		if(GetPVarInt(playerid,"antiflood") > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Моя валентинка ещё не готова [ Раз в 20 сек. ]");
		if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
		if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
		if(box[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я на ринге");
		if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
		new para1,tmp[64],string[144];
		if(sscanf(params, "is[64]",para1,tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подарить валентинку [ /love ID Текст ]");
		if(!IsOnline(para1)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		if(!ProxDetectorS(1.5, playerid, para1)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
		if(GetPlayerState(para1) == PLAYER_STATE_SPECTATING && gSpectateID[para1] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
		PlayerPlaySound(para1,40405,0,0,0);
		new str[100],sctring[300];
		if(PlayerInfo[playerid][pSex] == 1)
		{
  			format(string, sizeof(string), "* %s подарил валентинку %s", playername(playerid), playername(para1));
    		ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	    	format(string, sizeof(string), "подарил валентинку %s", playername(para1));
	    	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,3000);
	    	format(string, sizeof(string), "[ Мысли ]: Я подарил валентинку {ff3366}%s", playername(para1));
    		SendClientMessage(playerid, COLOR_GREY,string);
	    	format(string, sizeof(string), "[ Мысли ]: {ff3366}%s {cccccc}подарил мне валентинку", playername(playerid));
    		SendClientMessage(para1, COLOR_GREY,string);
    		format(str,sizeof(str),"{ff3366} %s {ffffff}подарил вам валентинку {ffccff};*", playername(playerid));
        	strcat(sctring,str);
    	}
    	else if(PlayerInfo[playerid][pSex] == 2)
		{
  			format(string, sizeof(string), "* %s подарила валентинку %s", playername(playerid), playername(para1));
    		ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	    	format(string, sizeof(string), "подарила валентинку %s", playername(para1));
	    	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,3000);
	    	format(string, sizeof(string), "[ Мысли ]: Я подарила валентинку {ff3366}%s", playername(para1));
    		SendClientMessage(playerid, COLOR_GREY,string);
	    	format(string, sizeof(string), "[ Мысли ]: {ff3366}%s {cccccc}подарила мне валентинку", playername(playerid));
    		SendClientMessage(para1, COLOR_GREY,string);
    		format(str,sizeof(str),"{ff3366} %s {ffffff}подарила вам валентинку {ffccff};*", playername(playerid));
        	strcat(sctring,str);
    	}
    	format(string, sizeof(string), "{ff3366}[ %s ]: {ffccff}%s", playername(playerid),tmp);
   		SendClientMessage(para1, COLOR_GREY,string);
        format(str,sizeof(str),"\n{ffccff} %s",tmp);
        strcat(sctring,str);
        ShowDialog(para1,1700,DIALOG_STYLE_MSGBOX,"{ff3366}Love",sctring,"Oк","");

    	TextDrawShowForPlayer(para1, LoveDraw[0]);
    	format(string, sizeof(string), "%s", playername(playerid));
    	PlayerTextDrawSetString(para1, LoveDraw1, string);
    	PlayerTextDrawShow(para1, LoveDraw1);
    	LoveTick[para1] = 30;
		SetPVarInt(playerid,"antiflood",20);
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Подарить валентинку можно только {ff3366}13 и 14 Февраля ;)");
    return 1;
}
alias:breath("dih")
CMD:breath(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(80, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
	if(!GetAccessRankOrg(playerid, g, 80, PlayerInfo[playerid][pFbi])) return 1;
	if(CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Вы смотрите телевизор");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы на ринге");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Предложить алкотестер [ /breath ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Его вообще нет..");
	if(!ProxDetectorS(3.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я слишком далеко");
	if(params[0] != playerid)
	{
		if(Dei[params[0]] > 0 || Hold[params[0]] > 0 || Hand[params[0]] > 0) return ErrorMessage(playerid, "{FF6347}У него заняты руки");
		Dei[params[0]] = 21, DeiStat[params[0]] = playerid;
		new string[124];
		format(string,sizeof(string),"[ Мысли ]: %s предлагает пройти алкотест {ff6666}[ Y - согласиться | N - отказаться ]",playername(playerid));
		SendClientMessage(params[0], COLOR_GREY, string);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я предлагаю %s пройти алкотест.", PlayerInfo[params[0]][pName]);
		PlayerPlaySound(params[0],40405,0,0,0);
	} else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем мне проверять самого себя на алкоголь?");
	return 1;
}
CMD:fud(playerid, const params[])
{
	new giveplayerid, g, r;
	if(CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Сейчас невозможно выполнить действие");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы на ринге");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	if(PlayerInfo[playerid][pFbi] >= 1 || PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pLeader] == 2
	|| PlayerInfo[playerid][pMember] == 18 || PlayerInfo[playerid][pLeader] == 18)
    {
		if(sscanf(params, "iii",giveplayerid, g, r)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать фальшивое удостоверение [ /fud ID Организация Ранг ]");
		if(g != 1 && g != 2 && g != 3 && g != 4 && g != 7 && g != 9 && g != 11 && g != 21 && g != 22) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Организации депарамента [ 1, 2, 3, 4, 7, 9, 11, 22 ]");
		if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Игрок нет в сети");
  		if(!ProxDetectorS(3.0, playerid, giveplayerid)) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	    new string[144];
		if(r <= 0 || r > get_maxrank(g)) return format(string, sizeof(string), "[ Мысли ]: В этой организации ранг не меньше 1 и не больше %d", get_maxrank(g)), SendClientMessage(playerid, COLOR_GREY, string);
		new rr = r-1;
	    new str[100],sctring[700];
        format(str,sizeof(str),"{0088ff}______________________________[ {ffffff}Удостоверение {0088ff}]______________________________");
        strcat(sctring,str);
        format(str,sizeof(str),"\n\n{cccccc}Имя Фамилия: {0088ff}%s",PlayerInfo[playerid][pName]);
        strcat(sctring,str);
        format(str,sizeof(str),"\n{cccccc}Организация: %s",fraklastName[g]);
        strcat(sctring,str);
        format(str,sizeof(str),"\n{cccccc}Должность: {0088ff}%s", RankOrg[g][rr]);
        strcat(sctring,str);
        format(str,sizeof(str),"\n\n{0088ff}_____________________________________________________________________________");
        strcat(sctring,str);
        ShowDialog(giveplayerid,1400,DIALOG_STYLE_MSGBOX,"{0088ff}Удостоверение",sctring,"*","");
     	PlayerPlaySound(giveplayerid,40405,0,0,0);
     	if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false, SYNC_ALL), TurnPlayerFaceToPlayer(playerid, giveplayerid);
    	format(string, sizeof(string), "* %s показывает своё удостоверение %s", playername(playerid), playername(giveplayerid));
	    ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет поддельного удостоверения");
    return 1;
}
CMD:findgun(playerid, const params[])
{
	if(sscanf(params, "u",params[0])) return  SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обыск на наличие оружия [ /findgun ID ]");
	if(IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi]>=1 || PlayerInfo[playerid][pMember] == 7 && (PlayerInfo[playerid][pRank] == 4 || PlayerInfo[playerid][pRank] == 5 || PlayerInfo[playerid][pRank] == 6)
	|| PlayerInfo[playerid][pSoska] >= 2)
	{
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		new string[144],weapons[13][2];
		format(string, sizeof(string), "{0088ff}**************  {FFFFFF}Оружие %s  {0088ff}**************", playername(params[0]));
  		SendClientMessage(playerid, COLOR_GREY, string);
		if(PlayerInfo[playerid][pSoska] >= 2)
		{
			for (new i = 0; i < 13; i++)
   			{
      			GetPlayerWeaponData(params[0], WEAPON_SLOT:i, WEAPON:weapons[i][0], weapons[i][1]);
         		if(weapons[i][0] != 0)
           		{
           			if(weapons[i][0] >= 1)
            		{
            			format(string, sizeof(string), "{0088ff}Оружие {FF0000}%s[%d], {0088ff}Патроны: {FF0000}%d", gunName[weapons[i][0]],weapons[i][0], weapons[i][1]);
             			SendClientMessage(playerid, COLOR_GREY, string);
              		}
                }
			}
		}
		else
		{
			if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем я буду просматривать оружие у самого себя ?");
			if(!ProxDetectorS(5.0, playerid, params[0]) && PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый далеко от меня находится");
			if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID && PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый далеко от меня находится");
			for (new i = 0; i < 13; i++)
   			{
      			GetPlayerWeaponData(params[0], WEAPON_SLOT:i, WEAPON:weapons[i][0], weapons[i][1]);
         		format(string, sizeof(string), "{0088ff}Оружие {FF0000}%s, {0088ff}Патроны: {FF0000}%d", gunName[weapons[i][0]], weapons[i][1]);
           		SendClientMessage(playerid, COLOR_GREY, string);
           	}
           	format(string, sizeof(string), "* %s обыскивает %s на наличие оружия.", playername(playerid), playername(params[0]));
			ProxDetector(30.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не могу это сделать");
	return 1;
}
CMD:tank(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(45, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(!GetAccessRankOrg(playerid, g, 45, NO_FBI)) return 1;
	
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать разрешение на использование Танка [ /tank ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(PlayerInfo[params[0]][pMember] != 3 && PlayerInfo[params[0]][pLeader] != 3) return ErrorMessage(playerid, "{FF6347}Этот игрок не боец NGSA");
	if(PlayerInfo[params[0]][pRank] >= PlayerInfo[playerid][pRank] && playerid != params[0]) return ErrorMessage(playerid, "{FF6347}Его ранг выше или равняется вашему");
	if(Tank[params[0]] == 1) return ErrorMessage(playerid, "{FF6347}У него уже есть разрешение на использование танка");
	Tank[params[0]] = 1;
	new string[144];
	format(string, sizeof(string), "Разрешение на использование танка выдано для %s",PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "[ Мысли ]: %s выдал мне разрешение на использование танка",PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_GREY, string);
	PlayerPlaySound(params[0],6400,0,0,0);
	format(string, sizeof(string), "* %s передаёт разрешение для %s на использования танка", PlayerInfo[playerid][pName], PlayerInfo[params[0]][pName]);
	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
 	return 1;
}
CMD:endorse(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(18, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете выдать разрешение к помещению вашей организации\n\n{cccccc}Интерьер вашей организации не получил необходимое обновление");
	if(!GetAccessRankOrg(playerid, g, 18, NO_FBI)) return 1;

	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать доступ ко всему помещению организации [ /endorse ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
	if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать доступ самому себе");
	if(fraction(playerid) == fraction(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже есть доступ к помещению организации");
	if(GetPVarInt(params[0],"endorse") == fraction(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже есть доступ к помещению организации");
	SetPVarInt(params[0],"endorse",fraction(playerid));

	new string[160];
	format(string, sizeof(string), "Доступ ко всему помещению организации выдано для %s",playername(params[0]));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "[ Мысли ]: %s выдал мне доступ ко всему помещению организации.",playername(playerid));
	SendClientMessage(params[0], COLOR_GREY, string);
	PlayerPlaySound(params[0],6400,0,0,0);
	format(string, sizeof(string), "* %s передаёт доступ %s к помещению организации.",playername(playerid) ,playername(params[0]));
	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
 	return 1;
}
CMD:assent(playerid, const params[])
{
	if(!IsAFunctionOrganization(47, fraction(playerid), playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не агент FBI");
	if(!GetAccessRankOrg(playerid, 2, 47, PlayerInfo[playerid][pFbi])) return 1;

	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать разрешение на спец. задание [ /assent ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(PlayerInfo[params[0]][pFbi] >= 1) return ErrorMessage(playerid, "{FF6347}Он уже является агентом под прикрытием");
	if(GetPVarInt(params[0],"razr") >= 1) return ErrorMessage(playerid, "{FF6347}У агента уже есть разрешение на спец. задание");
	if(PlayerInfo[params[0]][pLeader] >= 1) return ErrorMessage(playerid, "{FF6347}Лидер не может внедряться в другие организации");
	if(playerid == params[0] && server > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете выдать разрешение самому себе");
	if(PlayerInfo[params[0]][pMember] != 2) return ErrorMessage(playerid, "{FF6347}Этот игрок не агент FBI");

	new string[160];
	SetPVarInt(params[0],"razr",1);
	format(string, sizeof(string), "Разрешение для %s выдано",PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "[ Мысли ]: %s выдал мне разрешение для выполнения специального задания.",PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_GREY, string);
	PlayerPlaySound(params[0],6400,0,0,0);
	format(string, sizeof(string), "* %s передаёт разрешение %s для выполнения специального задания.",PlayerInfo[playerid][pName] ,PlayerInfo[params[0]][pName]);
	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	OrgLog(2, "assent", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
 	
	if(server == 0 && playerid == params[0]) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на тесте и потому могу выдать себе разрешение");
	return 1;
}
CMD:zprava(playerid, const params[]) // Команда: Закон
{
	if(IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)
	{
		if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
		if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
		if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
    	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Зачитать подозреваемому его права [ /zprava ID ]");
		if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
		if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый далеко от меня..");
    	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый далеко от меня..");
	    if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Что я делаю? Зачем мне зачитывать права себе?");
		new string[144];
		SendClientMessage(params[0], COLOR_YELLOW, " Вы имеете право хранить молчание.");
		SendClientMessage(params[0], COLOR_YELLOW, " Все, что вы скажете, может и будет использовано против вас в суде");
		SendClientMessage(params[0], COLOR_YELLOW, " Вы имеете право на адвоката и один телефонный звонок.");
		format(string, sizeof(string), "* %s зачитывает права %s.", playername(playerid), playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не сотрудних правоохранительных органов");
	return 1;
}
CMD:prov(playerid, const params[]) // Команда: Законн
{
	if(IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)
	{
		if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
		if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
		if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
		if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Объявить о проверке [ /prov ID ]");
		if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
		if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Гражданин далеко от меня..");
    	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Гражданин далеко от меня..");
	    if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Что я делаю? Зачем мне досматривать себя?");
	    new string[144];
	    format(string, sizeof(string), "* %s отдал%s честь", PlayerInfo[playerid][pName], gender(playerid));
  		ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "%s говорит: Здравствуйте %s. Это простая проверка.",PlayerInfo[playerid][pName], playername(params[0]));
       	ProxDetector(10.0, playerid, string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
       	format(string, sizeof(string), "%s говорит: Покажите пожалуйста ваши Документы.", PlayerInfo[playerid][pName]);
		ProxDetector(10.0, playerid, string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
       	format(string, sizeof(string), "%s говорит: Паспорт ((/pas %d))", PlayerInfo[playerid][pName], playerid);
       	ProxDetector(10.0, playerid, string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
     	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","prtial_gngtlkA",4.0, false, true, true, false, true, SYNC_ALL);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не сотрудних правоохранительных органов");
  	return 1;
}
CMD:fillkani(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,4.0,1936.3611,-1777.3170,13.3828) || IsPlayerInRangeOfPoint(playerid,4.0,1936.3137,-1789.7120,13.3828) || IsPlayerInRangeOfPoint(playerid,4.0,-1672.5669,420.5927,7.1797) || IsPlayerInRangeOfPoint(playerid,4.0,-1679.3167,413.5134,7.1797)
	|| IsPlayerInRangeOfPoint(playerid,4.0,-2103.2947,1.3732,35.3203) || IsPlayerInRangeOfPoint(playerid,4.0,-2103.2607,-10.7123,35.3203) || IsPlayerInRangeOfPoint(playerid,4.0,-89.2261,-1177.5775,2.6294) || IsPlayerInRangeOfPoint(playerid,4.0,-84.4081,-1166.9980,2.6294)
	|| IsPlayerInRangeOfPoint(playerid,4.0,2116.4453,943.9481,10.8374) || IsPlayerInRangeOfPoint(playerid,4.0,2116.2383,932.2269,10.8374) || IsPlayerInRangeOfPoint(playerid,4.0,2249.1006,2394.2515,10.8203) || IsPlayerInRangeOfPoint(playerid,4.0,2259.2168,2394.0405,10.8203)
	|| IsPlayerInRangeOfPoint(playerid,4.0,2806.1050,1984.3435,10.8203) || IsPlayerInRangeOfPoint(playerid,4.0,2815.135, 1992.333, 10.80)|| IsPlayerInRangeOfPoint(playerid,4.0,1537.1112,-2183.4209,13.5723) || IsPlayerInRangeOfPoint(playerid,4.0,1525.4749,-2183.7937,13.5723)
	|| IsPlayerInRangeOfPoint(playerid,4.0,896.1348,1904.1310,10.8708) || IsPlayerInRangeOfPoint(playerid,4.0,896.2427,1893.9852,10.8708)
	|| IsPlayerInRangeOfPoint(playerid,4.0,-2627.8733,1360.7460,7.0928) || IsPlayerInRangeOfPoint(playerid,4.0,-2627.4900,1350.5809,7.1173)
	|| IsPlayerInRangeOfPoint(playerid,4.0,-1559.2898,-2749.4673,48.5591) || IsPlayerInRangeOfPoint(playerid,4.0,-1568.7240,-2742.8220,48.5591)
	|| IsPlayerInRangeOfPoint(playerid,4.0,66.1616,-193.1906,1.6310) || IsPlayerInRangeOfPoint(playerid,4.0,54.0705,-193.3635,1.6310))
	{
		if(get_invent(playerid, 9, 0) <= 0)
		{
		    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно выйти из транспорта");
		    if(Hand[playerid] >= 1 || Hold[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня руки заняты [ Предмет или оружие ]");
		    new yes = 0, string[144],zaprid;
		    if(IsPlayerInRangeOfPoint(playerid,4.0,1936.3611,-1777.3170,13.3828) || IsPlayerInRangeOfPoint(playerid,4.0,1936.3137,-1789.7120,13.3828)) zaprid = 1;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,-89.2261,-1177.5775,2.6294) || IsPlayerInRangeOfPoint(playerid,4.0,-84.4081,-1166.9980,2.6294)) zaprid = 2;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,-1672.5669,420.5927,7.1797) || IsPlayerInRangeOfPoint(playerid,4.0,-1679.3167,413.5134,7.1797)) zaprid = 3;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,-2103.2947,1.3732,35.3203) || IsPlayerInRangeOfPoint(playerid,4.0,-2103.2607,-10.7123,35.3203)) zaprid = 4;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,2116.4453,943.9481,10.8374) || IsPlayerInRangeOfPoint(playerid,4.0,2116.2383,932.2269,10.8374)) zaprid = 5;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,2249.1006,2394.2515,10.8203) || IsPlayerInRangeOfPoint(playerid,4.0,2259.2168,2394.0405,10.8203)) zaprid = 6;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,2806.1050,1984.3435,10.8203) || IsPlayerInRangeOfPoint(playerid,4.0,2815.135, 1992.333, 10.80)) zaprid = 7;
		    else if(IsPlayerInRangeOfPoint(playerid,4.0,1537.1112,-2183.4209,13.5723) || IsPlayerInRangeOfPoint(playerid,4.0,1525.4749,-2183.7937,13.5723)) zaprid = 8;
			else if(IsPlayerInRangeOfPoint(playerid,4.0,896.1348,1904.1310,10.8708) || IsPlayerInRangeOfPoint(playerid,4.0,896.2427,1893.9852,10.8708)) zaprid = 9;
			else if(IsPlayerInRangeOfPoint(playerid,4.0,-2627.8733,1360.7460,7.0928) || IsPlayerInRangeOfPoint(playerid,4.0,-2627.4900,1350.5809,7.1173)) zaprid = 10;
			else if(IsPlayerInRangeOfPoint(playerid,4.0,-1559.2898,-2749.4673,48.5591) || IsPlayerInRangeOfPoint(playerid,4.0,-1568.7240,-2742.8220,48.5591)) zaprid = 11;
			else if(IsPlayerInRangeOfPoint(playerid,4.0,66.1616,-193.1906,1.6310) || IsPlayerInRangeOfPoint(playerid,4.0,54.0705,-193.3635,1.6310)) zaprid = 12;
			if(zaprid <= 0) return 1;
			if(BizzInfo[zaprid][bItem][0] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На этой заправке недостаточно топлива"), PlayerPlaySound(playerid,4203,0,0,0);
			
			new price = 20*BizzInfo[zaprid][bPrice][0];
			if(oGetPlayerMoney(playerid) < price) return format(string, sizeof(string), "[ Мысли ]: Мне не хватает %d$ {FF6347}[ Стоимость %d л. на этой заправке %d$ ]", BizzInfo[zaprid][bPrice][0]-oGetPlayerMoney(playerid), 20, 20*BizzInfo[zaprid][bPrice][0]), SendClientMessage(playerid, COLOR_GREY, string);
		  	if(CheckInvent(playerid) && get_invent2(playerid, 9, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой инвентарь заполнен");
		  	oGivePlayerMoney(playerid, -price), yes = 1;
		  	if(BizzInfo[zaprid][bSost] > 0) BizzInfo[zaprid][bItem][0] -= 20;
		  	UpdateFillLabel(zaprid);
			paybiz(zaprid, price);
		    if(yes == 1)
		    {
		        GiveThingPlayer(playerid, 9, 20, 0, 0, 0, 0, 9999);
		      	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Канистра заправлена на 20 литров {ff9000}[ N ]","*","");
		      	SetPlayerChatBubble(playerid,"заправляет канистру",COLOR_PURPLE,20.0,3000);
		      	PlayerPlaySound(playerid,6401,0,0,0);
		   	}
			format(string,sizeof(string),"Канистра в бизе № %d", zaprid);
			MoneyLog("fillkani", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -price, string);
		}
		else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: В моей канистре ещё есть топливо");
	}
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не на заправочной станции");
	return 1;
}
stock fill_vehicle(playerid, vehicleid, stat, quan = 999)
{
	new toplivo = VehInfo[vehicleid][vGas] + VehInfo[vehicleid][vGelium];
	if(toplivo >= 100) return ErrorMessage(playerid, "{FF6347}Транспорт полностью заправлен");
	new fill = quan;
	if (quan == 999)
	{
		if(Dei[playerid] == 8) fill = get_invent4(playerid, 9, 0);
		else if(Dei[playerid] == 12) fill = get_invent4(playerid, 61, 0);
	}
	if(toplivo+fill > 100) fill -= toplivo+fill-100;

	new string[64];
	if(Dei[playerid] == 8) format(string,sizeof(string),"{99ff66}Вы заправили %s на %d %s", GetVehicleName(VehInfo[vehicleid][vModel]), fill, PluralToText(fill, "литр", "литра", "литров")), SuccessMessage(playerid, string);
	else if(Dei[playerid] == 12)
	{
		format(string,sizeof(string),"{99ff66}Вы заправили %s Гелием-3 на %d %s", GetVehicleName(VehInfo[vehicleid][vModel]), fill, PluralToText(fill, "литр", "литра", "литров")), SuccessMessage(playerid, string);
		if(PlayerInfo[playerid][pAchieve][20] == 0) AchievePlayer(playerid, 20, 1);
	}
	
	if(Dei[playerid] == 8) VehInfo[vehicleid][vGas] += fill, TakeInvent(playerid, 9, fill, 0, 999);
	else if(Dei[playerid] == 12) VehInfo[vehicleid][vGelium] += fill, TakeInvent(playerid, 61, fill, 0, 999);
	if(stat == 1)
	{
		TurnPlayerFaceToVehicle(playerid, vehicleid);
		ApplyAnimation(playerid,"OTB","betslp_loop",1.0,false,true,true,false,false);
		Eat[playerid] = 1; EatTime[playerid] = 3;
	}
	else RemovePlayerAttachedObject(playerid, 1);
	Dei[playerid] = 0;
	// Обновляем топливо водителю
	if(VehInfo[vehicleid][vSeat] > 0)
	{
		new dryaver = VehInfo[vehicleid][vSeat]-1;
 		if(IsOnline(dryaver)) CheckBenz(dryaver);
	}
	return 1;
}
stock FillKaniDialog(playerid, fpick = 0, error = 0)
{
	DP[1][playerid] = fpick;
	new string[128] = "{cccccc}Укажите количество литров для заправки:";
	if (error > 0) PlayerPlaySound(playerid, 4203);

	if (fpick > 0) {
		format(string, sizeof(string), "%s\n%sДоступно: %d литров", string, error > 0 ? "{ff6347}" : "{ff9000}", get_invent4(playerid, fpick, 0));
	}

	return ShowDialog(playerid, FILLKANI_DIALOG_ENTER, DIALOG_STYLE_INPUT, "{ff9000}Заправка транспорта", string, "Ок", "Закрыть");
}
CMD:fillcar(playerid)
{
	if(get_invent4(playerid, 9, 0) >= 1 && Dei[playerid] == 8 || get_invent4(playerid, 61, 0) >= 1 && Dei[playerid] == 12)
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
	    	new vehicleid = GetPlayerVehicleID(playerid);
	 		if(IsACar(VehInfo[vehicleid][vModel])) return ErrorMessage(playerid, "{FF6347}Подойдите к бензобаку и нажмите [ Y ]");
	 		if(IsAVello(vehicleid) || Cars[vehicleid] == 52 || IsElectroCarModel(VehInfo[vehicleid][vModel])) return ErrorMessage(playerid, "{FF6347}Этот транспорт нельзя заправить толпивом");
	 		fill_vehicle(playerid, vehicleid, 0);
	    }
	    else if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
 			new Float:fpos[6], Float:vpos[3];
			new vehicleid = GetClosestVehicle(playerid, 14.0);

			if (vehicleid == INVALID_VEHICLE_ID)
			{
				ErrorMessage(playerid, "{FF6347}Поблизости нет машин");
				return 1;
			}

			new model = VehInfo[vehicleid][vModel];
			if(IsACar(model) || IsAMoto(model)) {
				if(IsElectroCarModel(model)) return ErrorMessage(playerid, "{FF6347}Этот транспорт нужно заряжать на специальных станциях");
				GetVehiclePos(vehicleid, vpos[0], vpos[1], vpos[2]);
				if(IsPlayerInRangeOfPoint(playerid,14.0,vpos[0], vpos[1], vpos[2]))
				{
					GetVehiclePartPos(vehicleid,VEHICLE_PART_PETROLCAP,fpos[0], fpos[1], fpos[2], fpos[3], fpos[4], fpos[5]);
					if(IsPlayerInRangeOfPoint(playerid,2.5,fpos[0], fpos[1], fpos[2]))
					{
						new toplivo = VehInfo[vehicleid][vGas] + VehInfo[vehicleid][vGelium];
						if(toplivo >= 100) return ErrorMessage(playerid, "{FF6347}Транспорт полностью заправлен");
						FillKaniDialog(playerid, Dei[playerid] == 8 ? 9 : 61);
					}
				}
			}
		}
    }
	return 1;
}
CMD:fill(playerid, const params[])
{
	if(IsAtGasStation(playerid) && IsPlayerInAnyVehicle(playerid))
	{
	    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
 		new vehicle = GetPlayerVehicleID(playerid);
 		if(IsAVello(vehicle)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У велосипеда нет двигателя. Зачем его заправлять?");
		if(IsElectroCarModel(VehInfo[vehicle][vModel])) return ErrorMessage(playerid, "{FF6347}Этот транспорт нужно заряжать на специальных станциях");
 		new fill = VehInfo[vehicle][vGas] + VehInfo[vehicle][vGelium];
		if(fill <= GasMax - 2)
		{
            if(IsPlayerInRangeOfPoint(playerid,15.0,342.7881,1952.4415,20.1840)|| IsPlayerInRangeOfPoint(playerid,10.0,278.6174,2002.4999,17.6406)
	        || IsPlayerInRangeOfPoint(playerid,15.0,342.7953,1987.6055,20.1840)|| IsPlayerInRangeOfPoint(playerid,15.0,318.1751,2072.9731,17.6446))
	        {
	          if(OrganInfo[3][gbenz] <= 0) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: В цистернах национальной гвардии нет топлива {ff0000}*");
	          if(!IsADepart(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не сотрудник департамента");
	          Stopeee228[playerid] = 8;
            }
            if(IsPlayerInRangeOfPoint(playerid,10.0,-1246.7941,439.3991,7.1875)|| IsPlayerInRangeOfPoint(playerid,15.0,-1256.6936,428.4373,24.7980)
