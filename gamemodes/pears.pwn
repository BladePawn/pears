			DomInfo[i][dInvType][inva] = 0;
			DomInfo[i][dInvPack][inva] = 0;
			if(oldthing != DomInfo[i][dInvent][inva]) SaveOneTainik(i, inva);
		}
	}
	mysql_tquery(pearsq, "COMMIT;");

	new string[60];
	format(string, sizeof(string), " [ ADM ]: %s очистил шкафы всех домов", PlayerInfo[playerid][pName],params[0]);
 	ABroadCast(COLOR_ADM,string,1);
