stock show_mafiabattle(playerid)
{
    if(setting_pos_draw[playerid] != 1 && setting_size_draw[playerid] != 1)
    {
		update_mafiabattle(playerid);
		new protiv;
		if(PortInfo[wOne] == fraction(playerid)) protiv = PortInfo[wTwo];
		else if(PortInfo[wTwo] == fraction(playerid)) protiv = PortInfo[wOne];

	    PlayerTextDrawShow(playerid, PlayerGangDraw[0][playerid]);
	    PlayerTextDrawShow(playerid, PlayerGangDraw[3][playerid]);
	    PlayerTextDrawShow(playerid, PlayerGangDraw[4][playerid]);

		new string[24];
		if(fraction(playerid) == 5) format(string, sizeof(string), "COSA_NOSTRA");
		else if(fraction(playerid) == 6) format(string, sizeof(string), "YAKUZA");
		else if(fraction(playerid) == 10) format(string, sizeof(string), "TRIADA");
		else if(fraction(playerid) == 12) format(string, sizeof(string), "RM");
		else if(fraction(playerid) == 18) format(string, sizeof(string), "ARABIAN");
		else format(string, sizeof(string), "NONE");
		PlayerTextDrawSetString(playerid,PlayerGangDraw[1][playerid], string);
		PlayerTextDrawShow(playerid, PlayerGangDraw[1][playerid]);

		if(protiv == 5) format(string, sizeof(string), "COSA_NOSTRA");
		else if(protiv == 6) format(string, sizeof(string), "YAKUZA");
		else if(protiv == 10) format(string, sizeof(string), "TRIADA");
		else if(protiv == 12) format(string, sizeof(string), "RM");
		else if(protiv == 18) format(string, sizeof(string), "ARABIAN");
		else format(string, sizeof(string), "NONE");
		PlayerTextDrawSetString(playerid,PlayerGangDraw[2][playerid], string);
		PlayerTextDrawShow(playerid, PlayerGangDraw[2][playerid]);
	}
	return 1;
}
stock update_mafiabattle(playerid)
{
	if(PortInfo[wStat] >= 1)
	{
		if(IsMafiaMember(playerid))
		{
			new string[24], kolvo = 0;
			new osmin = PortInfo[wTime]/60;
			new vrem = osmin*60;
			format(string, sizeof(string), "%02d:%02d", osmin, PortInfo[wTime]-vrem), PlayerTextDrawSetString(playerid, PlayerGangDraw[9][playerid], string), PlayerTextDrawShow(playerid, PlayerGangDraw[9][playerid]);
		 	if(fraction(playerid) == PortInfo[wOne])
		 	{
				format(string, sizeof(string), "%02d", PortInfo[wAmount]), PlayerTextDrawSetString(playerid, PlayerGangDraw[7][playerid], string), PlayerTextDrawShow(playerid, PlayerGangDraw[7][playerid]);
				if(PortInfo[wTwo] >= 1)
				{
					foreach(Player, i)
					{
						if(OnlineInfo[i][oLogged] == 0) continue;
						if(PortInfo[wTwo] != fraction(i)) continue;
						if(MafiaBattle[1][i] == PortInfo[wNumer]) continue;
						kolvo ++;
					}
				}
				format(string, sizeof(string), "%02d", kolvo), PlayerTextDrawSetString(playerid, PlayerGangDraw[8][playerid], string), PlayerTextDrawShow(playerid, PlayerGangDraw[8][playerid]);
				bar_mafiabattle(playerid, PortInfo[wTime], 0);
			}
			else if(fraction(playerid) == PortInfo[wTwo])
		 	{
				foreach(Player, i)
				{
					if(OnlineInfo[i][oLogged] == 0) continue;
					if(PortInfo[wTwo] != fraction(i)) continue;
					if(MafiaBattle[1][i] == PortInfo[wNumer]) continue;
					kolvo ++;
				}
				format(string, sizeof(string), "%02d", kolvo), PlayerTextDrawSetString(playerid, PlayerGangDraw[7][playerid], string), PlayerTextDrawShow(playerid, PlayerGangDraw[7][playerid]);
				format(string, sizeof(string), "%02d", PortInfo[wAmount]), PlayerTextDrawSetString(playerid, PlayerGangDraw[8][playerid], string), PlayerTextDrawShow(playerid, PlayerGangDraw[8][playerid]);
				bar_mafiabattle(playerid, PortInfo[wTime], 1);
			}
		}
	}
	return 1;
}
stock bar_mafiabattle(playerid, stat, draw) //+
{
	if(stat == 0)
	{
		if(draw == 0) PlayerTextDrawHide(playerid, PlayerGangDraw[5][playerid]);
		else PlayerTextDrawHide(playerid, PlayerGangDraw[6][playerid]);
		return 1;
	}
	new Float:max_time, Float:mini = 0.0, Float:maxi = 29.866666+PlayerInfo[playerid][pDrawSize_Y][0]/2, Float:section;
	if(ServerInfo[36] <= 0) max_time = 600;
	else max_time = ServerInfo[36]*60;
	section = (maxi-mini)/100;
	new Float:vrem = stat/max_time;
	new Float:proci = vrem*100;
	if(draw == 0)
	{
		if(stat >= 1) PlayerTextDrawTextSize(playerid, PlayerGangDraw[5][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, maxi-proci*section);
		else PlayerTextDrawTextSize(playerid, PlayerGangDraw[5][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, maxi);
		PlayerTextDrawShow(playerid, PlayerGangDraw[5][playerid]);
	}
	else
	{
		if(stat >= 1) PlayerTextDrawTextSize(playerid, PlayerGangDraw[6][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, maxi-proci*section);
		else PlayerTextDrawTextSize(playerid, PlayerGangDraw[6][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, maxi);
		PlayerTextDrawShow(playerid, PlayerGangDraw[6][playerid]);
	}
	return 1;
}
stock close_mafiabattle()
{
	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 0) continue;
		if(!IsMafiaMember(i)) continue;
		if(fraction(i) == PortInfo[wOne] || fraction(i) == PortInfo[wTwo])
		{
			for(new td = 0; td < 17; td++) PlayerTextDrawHide(i, PlayerGangDraw[td][i]);
			MafiaBattle[0][i] = 0, MafiaBattle[1][i] = 0;
			GiveUnit(i,20);
			ClearDeathBox(i, 5);
		}
	}
}
