		    else if(PlayerInfo[playerid][pArab] >= 10) PlayerInfo[playerid][pArab] = 1, end = 3;
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Arab`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pArab] ,PlayerInfo[playerid][pID]);
			query_empty(pearsq, f_str);
		}
	}

	Ash[playerid] = 0, AshTime[playerid] = 0;
	new str[134], sctring[268];
	if(end == 1)
	{
	    format(str,sizeof(str),"\n{99ff66}Пара окончена! Вы повысили навык: {ff9000}%s {cccccc}[ Y >> Меню >> Навыки ]", atext), strcat(sctring,str);
	    if(lesson != 3)
	    {
	    	format(str,sizeof(str),"\n\n{ff9000}Подойдите к преподавателю, чтобы начать экзамен"), strcat(sctring,str);
			CreateGps(playerid,1509.1115,-1781.1367,21.0902, 196, 0, 5.0);
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь отмечусь у преподавателя, чтобы начать экзамен");
		}
		SuccessMessage(playerid, sctring);
	}
	else if(end == 2)
	{
	    format(str,sizeof(str),"\n{99ff66}Пара окончена! Вы повысили навык на 1 уровень: {ff9000}%s {cccccc}[ Y >> Меню >> Навыки ]", atext), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}Вы можете вернуться и продолжить обучение только {FF6347}через 1 час"), strcat(sctring,str);
		SuccessMessage(playerid, sctring);
		PlayerInfo[playerid][pStopoc] = gettime()+3600;
		mysql_save(playerid, 70);
	}
	else if(end == 3)
	{
	    format(str,sizeof(str),"\n{99ff66}Поздравляем! Вы полностью освоили навык: {ff9000}%s {cccccc}[ Y >> Меню >> Навыки ]", atext), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}Теперь вы можете использовать его в разговоре {99ff66}[ Y >> Меню >> Языки ]"), strcat(sctring,str);
		SuccessMessage(playerid, sctring);
		PlayerInfo[playerid][pBuyoc] = 0, PlayerInfo[playerid][pProgless] = 0;
		PlayerInfo[playerid][pStopoc] = gettime()+3600;
		if(PlayerInfo[playerid][pAchieve][17] == 0) AchievePlayer(playerid, 17, 1);
		mysql_save(playerid, 70);
	}
	return 1;
}
stock isanot_lesson(playerid, stat)
{
    if(stat == 1 && PlayerInfo[playerid][pCarLic] >= 100 || stat == 2 && PlayerInfo[playerid][pFlyLic] >= 100
	|| stat == 3 && PlayerInfo[playerid][pHeliLic] >= 100 || stat == 4 && PlayerInfo[playerid][pBoatLic] >= 100
	|| stat == 5 && PlayerInfo[playerid][pMotoLic] >= 100)
	{
		ErrorMessage(playerid, "{FF6347}У вас есть этот навык [ Вы уже прочитали учебник или получили этот навык ранее ]");
		return 0;
	}
    if(stat == 6 && PlayerInfo[playerid][pRusk] == 1 || stat == 7 && PlayerInfo[playerid][pYapon] == 1
	|| stat == 8 && PlayerInfo[playerid][pItaly] == 1 || stat == 9 && PlayerInfo[playerid][pKitai] == 1
	|| stat == 10 && PlayerInfo[playerid][pIspan] == 1 || stat == 11 && PlayerInfo[playerid][pArab] == 1)
	{
		ErrorMessage(playerid, "{FF6347}Вы полностью изучили этот язык {cccccc}[ Y >> Меню >> Навыки ]");
        return 0;
  	}
    if(stat == 6 && PlayerInfo[playerid][pBuyoc] != 8 || stat == 7 && PlayerInfo[playerid][pBuyoc] != 9
	|| stat == 8 && PlayerInfo[playerid][pBuyoc] != 10 || stat == 9 && PlayerInfo[playerid][pBuyoc] != 11
	|| stat == 10 && PlayerInfo[playerid][pBuyoc] != 12 || stat == 11 && PlayerInfo[playerid][pBuyoc] != 13)
    {
        ErrorMessage(playerid, "{FF6347}Вы не оплатили изучение этого языка {cccccc}[ Это можно сделать на первом этаже образовательного центра ]");
        return 0;
    }
	return 1;
}
stock del_propose()
{
    if(MarriageInfo[mMan] > 0 && IsOnline(MarriageInfo[mMan]-1)) MarriageOffer[MarriageInfo[mMan]-1] = 0;
    if(MarriageInfo[mWoman] > 0 && IsOnline(MarriageInfo[mWoman]-1)) MarriageOffer[MarriageInfo[mWoman]-1] = 0;
    if(MarriageInfo[mWintess1] > 0 && IsOnline(MarriageInfo[mWintess1]-1)) MarriageOffer[MarriageInfo[mWintess1]-1] = 0;
    if(MarriageInfo[mWitness2] > 0 && IsOnline(MarriageInfo[mWitness2]-1)) MarriageOffer[MarriageInfo[mWitness2]-1] = 0;
    MarriageInfo[mStat] = 0;
    MarriageInfo[mMan] = 0;
    MarriageInfo[mWoman] = 0;
    MarriageInfo[mWintess1] = 0;
    MarriageInfo[mWitness2] = 0;
    return 1;
}
stock exit_propose(playerid)
{
    if(MarriageOffer[playerid] == 1) del_propose();
    else if(MarriageOffer[playerid] == 2)
    {
        if(MarriageInfo[mMan] > 0 && IsOnline(MarriageInfo[mMan]-1)) ErrorMessage(MarriageInfo[mMan]-1, "{FF6347}Невеста покинула церемонию [ Отмена бракосочетания ]");
        del_propose();
    }
    else if(MarriageOffer[playerid] == 3)
    {
        MarriageInfo[mWintess1] = 0;
        if(MarriageInfo[mMan] > 0 && IsOnline(MarriageInfo[mMan]-1)) ErrorMessage(MarriageInfo[mMan]-1, "{FF6347}Ваш свидетель покинул церемонию {cccccc}[ Дождитесь свидетеля или выберите нового ]");
        if(MarriageInfo[mStat] >= 2) MarriageInfo[mStat] = 1;
    }
    else if(MarriageOffer[playerid] == 4)
    {
        MarriageInfo[mWitness2] = 0;
        if(MarriageInfo[mMan] > 0 && IsOnline(MarriageInfo[mMan]-1)) ErrorMessage(MarriageInfo[mMan]-1, "{FF6347}Свидетель невесты покинул церемонию {cccccc}[ Дождитесь свидетеля или выберите нового ]");
        if(MarriageInfo[mStat] >= 2) MarriageInfo[mStat] = 1;
    }
    MarriageOffer[playerid] = 0;
	return 1;
}
stock show_hint_player(playerid, vehicleid)
{
	if(IsPlayerSyncModels(playerid))
	{
		if(IsAShassi(VehInfo[vehicleid][vModel])) SetPlayerHudPopup(playerid, "Запустить двигатель [ Y или ALT ]", 10000);
		else SetPlayerHudPopup(playerid, "Запустить двигатель [ 2 или ALT ]", 10000);
	}
	else
	{
		PlayerTextDrawBackgroundColour(playerid, PlayerHintDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
		PlayerTextDrawShow(playerid, PlayerHintDraw[0][playerid]);
		if(IsAShassi(VehInfo[vehicleid][vModel]))
		{
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerHintDraw[1][playerid], "ѓ‹…‚AЏE‡’_Y_/_ALT");
			else PlayerTextDrawSetString(playerid, PlayerHintDraw[1][playerid], "ENGINE_Y_/_ALT");
		}
		else
		{
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerHintDraw[1][playerid], "ѓ‹…‚AЏE‡’_2_/_ALT");
			else PlayerTextDrawSetString(playerid, PlayerHintDraw[1][playerid], "ENGINE_2_/_ALT");
		}
		PlayerTextDrawShow(playerid, PlayerHintDraw[1][playerid]);
	}
	return 1;
}
stock ProxDetectorScream(Float:radi, playerid, const string[], col1, col2, col3, col4, col5, col6, bool: shift_message = false)
{
	new Float:posx, Float:posy, Float:posz;
	new Float:oldposx, Float:oldposy, Float:oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	GetPlayerPos(playerid, oldposx, oldposy, oldposz);

	new domnear, dominside;
	for(new d = 1; d < sizeof(DomInfo); d++)
	{
		if(IsPlayerInRangeOfPoint(playerid,radi/2,DomInfo[d][dKoordinatX], DomInfo[d][dKoordinatY], DomInfo[d][dKoordinatZ]) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) domnear = d;
		if(IsPlayerInRangeOfPoint(playerid,radi/2,DomInfo[d][dEnterX], DomInfo[d][dEnterY], DomInfo[d][dEnterZ]) && GetPlayerVirtualWorld(playerid) == d+1000 && GetPlayerInterior(playerid) == DomInfo[d][dInterior]) dominside = d;
	}

	foreach (Player, id)
	{
	    if(OnlineInfo[id][oLogged] == 0) continue;
 		if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(id))
	  	{
			GetPlayerPos(id, posx, posy, posz);
			tempposx = (oldposx -posx);
			tempposy = (oldposy -posy);
			tempposz = (oldposz -posz);

			for(new coefficient = 16, i = 0; i < 5; i++, coefficient /= 2) {
				if (((tempposx < radi / coefficient) && (tempposx > -radi / coefficient)) && ((tempposy < radi / coefficient) && (tempposy > -radi / coefficient)) && ((tempposz < radi / coefficient) && (tempposz > -radi / coefficient))) {
					new color;
					switch (i) {
						case 0: color = col1;
						case 1: color = col2;
						case 2: color = col3;
						case 3: color = col4;
						case 4: color = col5;
					}

					SendClientLongMessage(id, color, string, shift_message ? 90 : 144);
					break;
				}
			}
 		}

 		if(domnear > 0)
 		{
 		    new text[184];
 		    format(text, sizeof(text), "(За дверью) %s", string);
	 		if(GetPlayerVirtualWorld(id) == domnear+1000 && GetPlayerInterior(id) == DomInfo[domnear][dInterior])
		  	{
                if(IsPlayerInRangeOfPoint(id,radi/2,DomInfo[domnear][dEnterX], DomInfo[domnear][dEnterY], DomInfo[domnear][dEnterZ])) SendClientLongMessage(id, col6, text, shift_message ? 90 : 144);
	 		}
		}
		if(dominside > 0)
 		{
            new text[184];
 		    format(text, sizeof(text), "(Из дома) %s", string);
	 		if(GetPlayerVirtualWorld(id) == 0 && GetPlayerInterior(id) == 0)
		  	{
                if(IsPlayerInRangeOfPoint(id,radi/2,DomInfo[dominside][dKoordinatX], DomInfo[dominside][dKoordinatY], DomInfo[dominside][dKoordinatZ])) SendClientLongMessage(id, col6, text, shift_message ? 90 : 144);
	 		}
		}
	}

	return 1;
}
stock PKM_or_H(playerid)
{
    new string[144];

	// Гантели
	if(ProcessDumbbells(playerid)) return true;

	// Штанга
	if(ProcessWeights(playerid)) return true;

	// Открываем окно в казино
	if(DeskStatus[playerid] == 1) return show_hud_desk(playerid, DeskID[playerid]);

	// Пьем из бокала
	if((Hold[playerid] == 2 || Hold[playerid] == 3) && GetPVarInt(playerid,"Arobsklad") == 0)
	{
	    new current_tick = GetTickCount();
		new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
		if(interval > 2000) godrink(playerid), Aftextdraw[playerid] = current_tick;
		return 1;
	}

    // Вскрываем вены ножом
	if(Hold[playerid] == 14 && GetPVarInt(playerid, "Arobsklad") == 0) return ShowDialog(playerid,1154,DIALOG_STYLE_MSGBOX,"{ff9000}Кухонный Нож","{FF6347}Вы уверены, что хотите порезать вены?","Да","Нет");

	// Открываем ноутбук со стола
	if(Hold[playerid] == 13 && HoldFrisk[playerid] == 42) return opendeskcomp(playerid);

    // Кушаем взаимодействуя с предметом
	if(Hold[playerid] == 13)
	{
	    new current_tick = GetTickCount();
		new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
		if(interval > 2000) goeat_podnos(playerid), Aftextdraw[playerid] = current_tick;
		return 1;
	}

	// Копаем Сокровища
	else if(Riches[playerid] >= 1 && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0)
	{
		new idrich = Riches[playerid]-1;
		if(IsPlayerInRangeOfPoint(playerid,2.0, RichPos[idrich][0],RichPos[idrich][1],RichPos[idrich][2]))
		{
			new current_tick = GetTickCount();
			new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
			if(interval > 500)
			{
			    if(Hold[playerid] != 6) return ErrorMessage(playerid, "{FF6347}Возьмите в руки лопату, чтобы начать копать [ N или /shovel ]");
			    SetPVarInt(playerid,"oryjtemp",GetPVarInt(playerid,"oryjtemp")+1);
			    format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Rich: ~w~%d/10", GetPVarInt(playerid,"oryjtemp")), GameTextForPlayer(playerid,string,2000,3);
			    ApplyAnimation(playerid,"PED","flee_lkaround_01",4.0, false, false, false, false, false, SYNC_ALL), PlayerPlaySound(playerid,20800,0,0,0);
			    if(GetPVarInt(playerid,"oryjtemp") == 1 && object_stat[playerid] == 0)
			    {
			    	player_object[playerid] = CreateDynamicObject(854, RichPos[idrich][0],RichPos[idrich][1],RichPos[idrich][2]-0.380004, 0.0, 0.0, 0.0, 0, 0, -1, 70.0, 70.0);
			    	SetDynamicObjectMaterial(player_object[playerid], 0, 10756, "airportroads_sfse", "stones256128", 0x00000000);
					object_stat[playerid] = 1;
					Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
			    }
			    else if(GetPVarInt(playerid,"oryjtemp") >= 2 && GetPVarInt(playerid,"oryjtemp") <= 9 && object_stat[playerid] == 1) MoveDynamicObject(player_object[playerid], RichPos[idrich][0], RichPos[idrich][1], (RichPos[idrich][2]-0.380004)+0.0380004*GetPVarInt(playerid,"oryjtemp"), 0.3);
			    if(GetPVarInt(playerid,"oryjtemp") == 10)
			    {
			    	if(object_stat[playerid] == 1) MoveDynamicObject(player_object[playerid], RichPos[idrich][0], RichPos[idrich][1], RichPos[idrich][2], 0.3);
			    	new unix = gettime();
			    	PlayerInfo[playerid][pMaze3] = unix+86400;
					mysql_save(playerid, 63);
					CompleteBattlePassTask(playerid, 1, 0);
					if(OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/arheolog02.mp3");
					new items[5], nogold = 9;
				    for(new i = 0; i < 5; i++)
					{
					    switch(random(nogold))
						{
				  			case 0..2: items[i] = 92;
				  			case 3..5: items[i] = 93;
				  			case 6..7: items[i] = 95;
				  			case 8: items[i] = 94, nogold = 8;
						}
						if(items[i] > 0) Throw(playerid, items[i], 1, 0, 0, 0, 0);
					}
					
					SuccessMessage(playerid, "{99ff66}Вы нашли сокровища! {cccccc}Попробуйте завтра раздобыть ещё одну карту!\n{ff9000}Соберите все предметы [ N >> Рядом ]\n\n{cccccc}Можно найти предметы: Ваза, Урна с прахом, Статуэтка, {ffcc00}Слиток Золота");
					Riches[playerid] = 0;
					TakeInvent(playerid, 91, 1, 0, 999);
					SetTimerEx("delplayerobject", 15000, false, "d", playerid);
					if(PlayerInfo[playerid][pAchieve][74] == 0) AchievePlayer(playerid, 74, 1);
					/*if(PlayerInfo[playerid][pQwest] == 19)
					{
					    PlayerInfo[playerid][pQwest] = 20, mysql_save(playerid, 69);
					    if(get_invent4(playerid, 26, 0) > 0) SetPVarInt(playerid,"qweststat",32), SetPVarInt(playerid,"qwesttime",15);
	    			}*/

					// Найти сокровища
					CompletingDaily(playerid, 13, 1);
			    }
				Aftextdraw[playerid] = current_tick;
			}
			return 1;
		}
	}

	// Доить Корову на Ферме
	else if(Dei[playerid] == 13 && SitPlayer[playerid]-1 >= 0 && SitPlayer[playerid]-1 <= 17 && DeiStat[playerid] < 20)
	{
		new current_tick = GetTickCount();
		new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
		if(interval > 500)
		{
	        PlayerPlaySound(playerid,1150,0,0,0);
	        DeiStat[playerid] ++;
	        format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Milk: ~w~%d/20", DeiStat[playerid]), GameTextForPlayer(playerid,string,2000,3);
	        if(DeiStat[playerid] >= 20) 
			{
				exitsit(playerid, 1), SuccessMessage(playerid, "{99ff66}Ведро наполнено молоком\n{ff9000}Отнесите его на стол у входа");

				// Доить коров
				CompletingDaily(playerid, 17, 1);
			}
	        Aftextdraw[playerid] = current_tick;
		}
	}

	// Плот на лаве в Гробнице
	else if(GetPlayerInterior(playerid) == 227 && GetPlayerVirtualWorld(playerid) == 227 && plot_player == playerid && IsPlayerInRangeOfPoint(playerid,10.0,1581.171752, 1400.792480, 1824.6791))
	{
		if(get_invent4(playerid, 13, 0) >= 1)
		{
		    if(plot_route == 0) // Плывём к Черепу
		    {
				if(plot_stat == 0) MoveDynamicObject(plot, 1577.922973, 1403.126220, 1824.109375, 1.0), plot_stat = 1;
		        else if(plot_stat == 1) MoveDynamicObject(plot, 1581.171752, 1400.792480, 1824.109375, 1.0), plot_stat = 2;
		        else if(plot_stat == 2) MoveDynamicObject(plot, 1584.430297, 1398.452148, 1824.109375, 1.0), plot_stat = 3;
		        else if(plot_stat == 3) MoveDynamicObject(plot, 1586.916625, 1396.665527, 1824.109375, 1.0), plot_stat = 4, plot_player = -1, plot_time = 0;
		        else if(plot_stat == 4) return 1;
 			}
 			else if(plot_route == 1) // Плывём Домой
		    {
				if(plot_stat == 4) MoveDynamicObject(plot, 1584.430297, 1398.452148, 1824.109375, 1.0), plot_stat = 3;
		        else if(plot_stat == 3) MoveDynamicObject(plot, 1581.171752, 1400.792480, 1824.109375, 1.0), plot_stat = 2;
		        else if(plot_stat == 2) MoveDynamicObject(plot, 1577.922973, 1403.126220, 1824.109375, 1.0), plot_stat = 1;
		        else if(plot_stat == 1) MoveDynamicObject(plot, 1575.550292, 1404.830688, 1824.109375, 1.0), plot_stat = 0, plot_player = -1, plot_time = 0;
		        else if(plot_stat == 0) return 1;
 			}
 			ApplyAnimation(playerid,"PED","flee_lkaround_01",4.0, false, false, false, false, false, SYNC_ALL);
		}
	}

	// Мыть Плац (Военный)
	else if(Dei[playerid] == 2 && GetPVarInt(playerid,"oryjtemp") <= 99)
	{
		new d = DeiStat[playerid]-1;
		if(IsPlayerInRangeOfPoint(playerid,2.0, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]) && DeiStat[playerid] >= 1)
		{
			new rand = 1 + random(5);
		    SetPVarInt(playerid,"oryjtemp",GetPVarInt(playerid,"oryjtemp")+rand);
		    PlayerPlaySound(playerid,20800,0,0,0);
		    format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Wash Dirt: ~w~%d/100", GetPVarInt(playerid,"oryjtemp")), GameTextForPlayer(playerid,string,2000,3);
		    ApplyAnimation(playerid,"PED","flee_lkaround_01",4.0, false, false, false, false, false, SYNC_ALL);
		    if(GetPVarInt(playerid,"oryjtemp") >= 100)
			{
				if(DirtStat[d] >= 1) DirtStat[d] = 0, DirtWash[d] = -1, DestroyDynamicObject(DirtObject[d]), dirtkol --;
				SetPVarInt(playerid,"oryjtemp",0), PlayerPlaySound(playerid,6401,0,0,0), GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~Done",2000,3);
				Dei[playerid] = 2, DeiStat[playerid] = 0;
			}
		}
	}

	// Моет Туалет
	else if(Dei[playerid] == 1 && GetPVarInt(playerid,"oryjtemp") <= 99)
	{
		new rand = 1 + random(5);
	    SetPVarInt(playerid,"oryjtemp",GetPVarInt(playerid,"oryjtemp")+rand);
	    PlayerPlaySound(playerid,1150,0,0,0);
  		format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Wash Toilet: ~w~%d/100", GetPVarInt(playerid,"oryjtemp")), GameTextForPlayer(playerid,string,2000,3);
  		ApplyAnimation(playerid,"COP_AMBIENT","Copbrowse_loop",4.0, false, true, false, false, false);
		if(GetPVarInt(playerid,"oryjtemp") >= 100)
		{
			SetPVarInt(playerid,"oryjtemp",100), PlayerPlaySound(playerid,6401,0,0,0), GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~Done",2000,3);
			new unixtime = gettime();
			PissWash[DeiStat[playerid]-1] = unixtime+1800;
			Dei[playerid] = 0, ClearAnimations(playerid), ClearAnim(playerid);
		}
	}

	if(GetPVarInt(playerid,"Arobsklad") == 3) return Pump_InfBoat(playerid); // Надувная Лодка
	if(GetPVarInt(playerid,"Arobsklad") == 9 && Trap[playerid] == 0) return Pump_Trap(playerid); // Ловушка для Акулы
	if(GetPVarInt(playerid,"Arobsklad") == 10 && Sate[playerid] == 0) return Pump_Sate(playerid); // Спутниковая Антенна
	if(GetPVarInt(playerid,"Arobsklad") == 11) return Pump_Radar(playerid); // Радар
	if(GetPVarInt(playerid,"Arobsklad") == 12) return PDatabase_Vent_Pump(playerid); // Открытие вентиляции (взлом БД)
	if(GetPVarInt(playerid,"Arobsklad") == 13) return PDatabase_Thermite_Pump(playerid); // Установка термита (взлом БД)
	if(GetPVarInt(playerid,"Arobsklad") == 14) return Graves_Pump(playerid); // Раскопка могил
	if(GetPVarInt(playerid,"Arobsklad") == 15) return Pump_CarveAnimals(playerid); // Разделка Туши зверьков
	if(GetPVarInt(playerid,"Arobsklad") == 16) return Pump_IceHole(playerid); // Долбим прорубь
	if(GetPVarInt(playerid,"Arobsklad") == 17) return Pump_NewYearQuest(playerid); // НГ квест
	if(GetPVarInt(playerid,"Arobsklad") == 18) return Pump_FeedWildPet(playerid); // Кормление диких питомцев
	if(GetPVarInt(playerid,"Arobsklad") == 19) return Pump_FeedPet(playerid); // Кормление питомцев
	if(GetPVarInt(playerid,"Arobsklad") == 20) return NarcoSpot_PackPump(playerid); // Запаковка травы
	if(GetPVarInt(playerid,"Arobsklad") == 21) return NarcoFarm_Pump(playerid); // Действия на ферме
	if(GetPVarInt(playerid,"Arobsklad") == 22) return NarcoFarm_PackPump(playerid); // Упаковка порошка на ферме

	// Рыбалка
	if(Hold[playerid] == 7 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(IsBigFish(playerid) || IsMinFish(playerid))
		{
			new animname[32], animlib[32];
			GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
			if(strcmp(animlib, "SWIM", true) == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете ловить рыбу находясь в воде");
			fish(playerid);
			/*new surf = GetPlayerSurfingVehicleID(playerid);
			if(surf != INVALID_VEHICLE_ID)
			{
				if(VehInfo[surf][vModel] == 430 || VehInfo[surf][vModel] == 446 || VehInfo[surf][vModel] == 447 || VehInfo[surf][vModel] == 452 || VehInfo[surf][vModel] == 453
				|| VehInfo[surf][vModel] == 454 || VehInfo[surf][vModel] == 460 || VehInfo[surf][vModel] == 472 || VehInfo[surf][vModel] == 473 || VehInfo[surf][vModel] == 484
				|| VehInfo[surf][vModel] == 493 || VehInfo[surf][vModel] == 520 || VehInfo[surf][vModel] == 539 || VehInfo[surf][vModel] == 595) fish(playerid);
				else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу ловить рыбу, находясь в воде [ Только с лодки или катера ]");
			}
	 		else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу ловить рыбу, находясь в воде [ Только с лодки или катера ]");*/
		}
		else ErrorMessage(playerid, "{FF6347}Здесь рыба не водится\
		\n{ffcc66}Если вы будете рыбачить на причале, то вам будет попадаться мелкая рыба\
		\n{ffcc66}Вы можете арендовать лодку и отправить в залив");
	}
	return 1;
}
stock PKM_to_ALT(playerid)
{
    // Солнечные Батареи на Луне и Марсе
	if(Dei[playerid] == 2 && (GetPlayerInterior(playerid) == 221 && GetPlayerVirtualWorld(playerid) == 221 || GetPlayerInterior(playerid) == 222 && GetPlayerVirtualWorld(playerid) == 222) && (PlayerInfo[playerid][pBkyrenie] == 2 || PlayerInfo[playerid][pBkyrenie] == 4 || PlayerInfo[playerid][pSoska] >= 22)) return Nasabat(playerid);

	// Каменоломня на Луне
	else if(Dei[playerid] == 4 && GetPlayerInterior(playerid) == 221 && GetPlayerVirtualWorld(playerid) == 221 && (PlayerInfo[playerid][pBkyrenie] == 2 || PlayerInfo[playerid][pSoska] >= 22))
	{
		if(IsPlayerInRangeOfPoint(playerid,4.0, 98.6299,3019.5059,952.1057) || IsPlayerInRangeOfPoint(playerid,4.0, 104.3370,3015.7935,951.0793)
		|| IsPlayerInRangeOfPoint(playerid,4.0, 109.2073,3009.5361,952.9218) || IsPlayerInRangeOfPoint(playerid,4.0, 111.0955,3000.2300,953.0346)
		|| IsPlayerInRangeOfPoint(playerid,4.0, 109.6101,2995.8374,952.9576) || IsPlayerInRangeOfPoint(playerid,4.0, 105.6208,2992.2661,952.9963)
		|| IsPlayerInRangeOfPoint(playerid,4.0, 101.5960,2987.9072,951.7769))
		{
			new current_tick = GetTickCount();
			new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
			if(interval > 500)
			{
				new string[160];
				new pow = get_power(playerid)/2;
				if(pow == 0) pow = 1;
			    if(GetPVarInt(playerid,"LoadBack") >= pow)
			 	{
			 		format(string, sizeof(string), "{FF6347}Максимальное количество боксов с материалом: %d [ Зависит от навыка силы /skill ]", pow), ErrorMessage(playerid, string);
				 	if(GetPVarInt(playerid,"GP") != 1) CreateGps(playerid, 32.1685,3022.9170,957.2476, 221, 221, 5.0);
   					return 1;
		 		}
			    SetPVarInt(playerid,"oryjtemp",GetPVarInt(playerid,"oryjtemp")+1);
			    SetPVarInt(playerid,"temptime",5);
			    format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Rock: ~w~%d/10", GetPVarInt(playerid,"oryjtemp")), GameTextForPlayer(playerid,string,2000,3);
			    ApplyAnimation(playerid,"SWORD","sword_4",2.0, false, false, false, false, false, SYNC_ALL);
			    if(GetPVarInt(playerid,"oryjtemp") >= 10) nasa_box(playerid, 0, 0);
				Aftextdraw[playerid] = current_tick;
			}
			return 1;
		}
		else get_meteorite(playerid);
	}

	
	// Фрукты на Ферме
	else if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && Hold[playerid] == 8)
	{
	    new current_tick = GetTickCount();
		new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
		if(interval > 500)
		{
			for(new gar = 0; gar < MAX_GARDEN; gar++)
			{
			    if(garden_stat[gar] == 0 || garden_quan[gar] < 1) continue;
			    if(IsPlayerInRangeOfPoint(playerid,2.0,GardenPos[gar][0], GardenPos[gar][1], GardenPos[gar][2]+4.0))
				{
				    new fruit;
				    fruit = 100; // Яблоня
				    if(HoldStat[playerid] > 0 && HoldStat[playerid] != fruit) return ErrorMessage(playerid, "{FF6347}В вашей корзинке фрукты с другого дерева");
				    if(HoldStat[playerid] == 0) HoldStat[playerid] = fruit;
					HoldQuan[playerid] ++, PlayerPlaySound(playerid,1150,0,0,0);
					new pow = (get_power(playerid)/2)*10;
 					if(pow < 10) pow = 10;

					new string[100];
					format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Apple: ~w~%d/%d", HoldQuan[playerid], pow);
					GameTextForPlayer(playerid,string,2000,3);
					new myfruit;

					fruitapp --;
					myfruit = fruitapp;

					if(HoldQuan[playerid] >= pow || myfruit <= 0) load_bagfruit(playerid, fruit, HoldQuan[playerid], myfruit);
				    if(garden_quan[gar] > 0) garden_quan[gar] --;
				    if(garden_quan[gar] == 0) garden_stat[gar] = 0, garden_time[gar] = 300;
				    update_garden(gar);
				    break;
				}
			}
			Aftextdraw[playerid] = current_tick;
		}
	}

	// Картошка на марсе
 	else if((IsPlayerInSquare(playerid,1310.209716,2451.890136,1313.240478,2484.865234) || IsPlayerInSquare(playerid,1303.556152,2451.890136,1306.586914,2484.865234)) && GetPlayerInterior(playerid) == 222 && GetPlayerVirtualWorld(playerid) == 223) return plantpotato(playerid);

 	// Колоть камни в пещере Марса
	else if(Dei[playerid] == 4 && GetPlayerInterior(playerid) == 222 && GetPlayerVirtualWorld(playerid) == 222 && (PlayerInfo[playerid][pBkyrenie] == 4 || PlayerInfo[playerid][pSoska] >= 22)) return get_rock(playerid);

	// Саркофаги
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    if((IsPlayerInRangeOfPoint(playerid,2.0,1430.7230,1554.1328,10.8463) || IsPlayerInRangeOfPoint(playerid,2.0,1394.3341,1554.0918,10.8503) || IsPlayerInRangeOfPoint(playerid,2.0,1430.7229,1587.9454,10.8463)
 		|| IsPlayerInRangeOfPoint(playerid,2.0,1394.3439,1587.9523,10.8503) || IsPlayerInRangeOfPoint(playerid,2.0,1362.8505,1585.5258,10.8503)) && GetPlayerInterior(playerid) == 226 && GetPlayerVirtualWorld(playerid) == 226)
 		{
 		    if(Hold[playerid] != 9) return ErrorMessage(playerid, "{FF6347}Нужно взять в руки монтировку [ N - открыть инвентарь или /mount ]");
		 	sarcophagus(playerid);
			return 1;
	 	}
		else if((IsPlayerInRangeOfPoint(playerid,2.0,1394.3571,1610.4054,1816.0216) || IsPlayerInRangeOfPoint(playerid,2.0,1394.3569,1596.1399,1816.0216)
 		|| IsPlayerInRangeOfPoint(playerid,2.0,1466.7737,1610.2744,1816.0216) || IsPlayerInRangeOfPoint(playerid,2.0,1466.7738,1595.9792,1816.0216)) && GetPlayerInterior(playerid) == 227 && GetPlayerVirtualWorld(playerid) == 227)
	 	{
	 	    if(Hold[playerid] != 9) return ErrorMessage(playerid, "{FF6347}Нужно взять в руки монтировку [ N - открыть инвентарь или /mount ]");
		 	sarcophagus2(playerid);
			return 1;
	 	}
	}

	// Наживка
	if(IsPlayerInSquare(playerid,1000.9835,-2082.2644,1022.3307,-2046.6135) && Hold[playerid] == 6 && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(CheckInvent(playerid) && get_invent2(playerid, 18, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре");
		if(GetPVarInt(playerid,"antiflood") > 0) return GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~Наживка не собрана"), 3000, 3), PlayerPlaySound(playerid,4203,0,0,0);
		new randfish = random(10);
		if(randfish > 0)
		{
			new string[160];
		    new getQuan, getLimit;
		    i_limit(playerid, 18, getQuan, getLimit);
		    if(getQuan+randfish > getLimit) return format(string,sizeof(string),"{FF6347}У вас нет места в инвентаре\nЛимит для дождевых червей: %d\n\n{cccccc}Предметы учитываются из раздела торговли и упаковок с подарками и рюкзаков", getLimit), ErrorMessage(playerid, string);
		    
			ApplyAnimation(playerid,"PED","flee_lkaround_01",1.5,false,false,false,false,false,SYNC_ALL), SetPVarInt(playerid,"antiflood",3), PlayerPlaySound(playerid,20800,0,0,0);
			
			GiveThingPlayer(playerid, 18, randfish, gettime()+432000, 0, 0, 0, 9999);
			format(string, sizeof(string), "{cccccc}Вы воткнули лопату в землю и нашли {ff9000}%d дождевых червей",randfish);
			ShowDialog(playerid, 1742, 0, "{ff9000}Наживка", string, "Ок", "");
			format(string, sizeof(string), RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Наживка: ~w~+%d"), randfish), GameTextForPlayer(playerid,string,3000,3);
		}
		else
		{
			ApplyAnimation(playerid,"PED","flee_lkaround_01",1.5,false,false,false,false,false,SYNC_ALL);
			SetPVarInt(playerid,"antiflood",3);
			PlayerPlaySound(playerid,20800,0.0,0.0,0.0);
			ShowDialog(playerid, 1742, 0, "{ff9000}Наживка", "{cccccc}Вы воткнули лопату в землю и ничего не нашли", "Ок", "");
		}
		return 1;
	}
	return 1;
}

stock family_vehcolor(playerid, f)
{
    new str[40],sctring[120];
	format(str,sizeof(str),"{cccccc}Стоимость: {99ff66}45000$"), strcat(sctring,str);
	format(str,sizeof(str),"\n{666666}1. ID %d", FamilyInfo[f][fVehCol][0]), strcat(sctring,str);
	format(str,sizeof(str),"\n{666666}2. ID %d", FamilyInfo[f][fVehCol][1]), strcat(sctring,str);
	ShowDialog(playerid,481,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Цвет Транспорта",sctring,"Выбрать","Отмена");
	return 1;
}
stock PrintSprotect1(playerid, Float:p1, Float:p2, Float:p3, Float:d1, Float:d2, Float:d3)
{
	printf("[SProtect]: %s Veh_Real %f, %f, %f", PlayerInfo[playerid][pName], p1, p2, p3);
	printf("[SProtect]: %s Veh_Protect %f, %f, %f [dist: %f]", PlayerInfo[playerid][pName], Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], d1);
	printf("[SProtect]: %s Veh_Before %f, %f, %f [dist_before: %f]", PlayerInfo[playerid][pName], BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid], d2);
	printf("[SProtect]: %s Veh_After %f, %f, %f [dist_after: %f]", PlayerInfo[playerid][pName], AfterProtect_X[playerid], AfterProtect_Y[playerid], AfterProtect_Z[playerid], d3);
}

stock PrintSprotect2(playerid, Float:p1, Float:p2, Float:p3, Float:d1, Float:d2, Float:d3)
{
	printf("[SProtect]: %s Real %f, %f, %f ", PlayerInfo[playerid][pName], p1, p2, p3);
	printf("[SProtect]: %s Protect %f, %f, %f [dist: %f]", PlayerInfo[playerid][pName], Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], d1);
	printf("[SProtect]: %s Before %f, %f, %f [dist_before: %f]", PlayerInfo[playerid][pName], BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid], d2);
	printf("[SProtect]: %s After %f, %f, %f [dist_after: %f]", PlayerInfo[playerid][pName], AfterProtect_X[playerid], AfterProtect_Y[playerid], AfterProtect_Z[playerid], d3);
	
	if(DeathInfo[playerid][deathStatus] == true)
	{
		printf("[SProtect]: %s (deathStatus true) pLastPos %f, %f, %f ", PlayerInfo[playerid][pName], PlayerInfo[playerid][pLastPos][0], PlayerInfo[playerid][pLastPos][1], PlayerInfo[playerid][pLastPos][2]);
	}
	new team,skin,Float:spawnX,Float:spawnY,Float:spawnZ,Float:angle,WEAPON:weapon1,ammo1,WEAPON:weapon2,ammo2,WEAPON:weapon3,ammo3;
	GetSpawnInfo(playerid, team, skin, spawnX, spawnY, spawnZ, angle, weapon1, ammo1, weapon2, ammo2, weapon3, ammo3);
	printf("[SProtect]: %s GetSpawnInfo %f, %f, %f ", PlayerInfo[playerid][pName], spawnX, spawnY, spawnZ);

	printf("[SProtect]: %s  (GetPlayerVirtualWorld: %d oWorldPlayer: %d GetPlayerInterior: %d oInteriorPlayer: %d)",
		PlayerInfo[playerid][pName], GetPlayerVirtualWorld(playerid), OnlineInfo[playerid][oWorldPlayer], GetPlayerInterior(playerid), OnlineInfo[playerid][oInteriorPlayer]);
}

stock KickThisPlayer(playerid)
{
	new len = strlen(PlayerInfo[playerid][pName]);
	foreach(Player, i)
	{
	    if(playerid == i) continue;
	    if(strcmp(PlayerInfo[i][pName], PlayerInfo[playerid][pName], true, len) == 0) Kickx(i);
	}
	return 1;
}
stock GetThisPlayer(playerid)
{
	new len = strlen(PlayerInfo[playerid][pName]), quan;
	foreach(Player, i)
	{
	    if(strcmp(PlayerInfo[i][pName], PlayerInfo[playerid][pName], true, len) == 0 && OnlineInfo[i][oLogged] == 1)
		{
		    quan ++;
		}
	}
	return quan;
}
stock DialogLoadAccount(playerid, statusDialog)
{
	if(statusDialog == 0) ShowDialog(playerid,1290,DIALOG_STYLE_MSGBOX,"{ff9000}Pears Project","{ff9000}Поиск аккаунта..","*","");
	else if(statusDialog == 1) ShowDialog(playerid,1291,DIALOG_STYLE_MSGBOX,"{ff9000}Pears Project","{ff9000}Загрузка аккаунта..","*","");
	return 1;
}
stock savePositionPlayerForMenu(playerid)
{
	new Float:pos[4];
	GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
	GetPlayerFacingAngle(playerid,pos[3]);

	if(!IsValidFloat(pos[0]) || !IsValidFloat(pos[1]) || !IsValidFloat(pos[2]) || !IsValidFloat(pos[3])) return false;

	SpX[playerid] = pos[0];
	SpY[playerid] = pos[1];
	SpZ[playerid] = pos[2];
	SpA[playerid] = pos[3];

	SpInt[playerid] = GetPlayerInterior(playerid);
	SpWorld[playerid] = GetPlayerVirtualWorld(playerid);
	return 1;
}
stock HexToInt(const string[])
{
	new color;
	sscanf(string, "x", color);
	return color;
}
stock mysql_SavePlayer(playerid, const name[], value) // Сохраняем одну строку в базу
{
	new string_mysql[160];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki` SET `%e` = '%d' WHERE `user_id` = '%d'", name, value, PlayerInfo[playerid][pID]);
	query_empty(pearsq, string_mysql);
	return 1;
}
stock SaveKeyVehicle(playerid) // Сохраняем ключи от транспорта в базу
{
	new string_mysql[180];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki` SET `KeyVeh0` = '%d', `KeyVeh1` = '%d', `KeyVeh2` = '%d', `KeyVeh3` = '%d' WHERE `user_id` = '%d'", 
		PlayerInfo[playerid][pKeyVeh][0], PlayerInfo[playerid][pKeyVeh][1], PlayerInfo[playerid][pKeyVeh][2], PlayerInfo[playerid][pKeyVeh][3],
		PlayerInfo[playerid][pID]);
	query_empty(pearsq, string_mysql);
	return 1;
}
stock checkClearTaxesVeh(playerid)
{
	new quanVehTax;
	for(new i = 0; i < MAX_MYVEHICLE; i++)
	{
		if(PlayerInfo[playerid][pVehTax][i] > 0) quanVehTax ++;
	}
	return quanVehTax;
}
stock SavePlayerTaxesVehicle(playerid)
{
	new string_mysql[300 + 22 + 21 + 11 + 44 * MAX_MYVEHICLE];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_igroki` SET `Taxes0` = '%d', `VehTax0` = '%d'",
	PlayerInfo[playerid][pTaxes][0], PlayerInfo[playerid][pVehTax][0]); // 57 + 22
	for(new i = 1; i < MAX_MYVEHICLE; i++) 
	{
		if(PlayerInfo[playerid][pMyVeh][i] > 0) format(string_mysql,sizeof(string_mysql),"%s, `VehTax%d` = '%d'", string_mysql, i, PlayerInfo[playerid][pVehTax][i]); // 22 + 22
	}
    format(string_mysql,sizeof(string_mysql),"%s WHERE `user_id` = '%d'", string_mysql, PlayerInfo[playerid][pID]); // 21 + 11
	query_empty(pearsq, string_mysql);
}
stock UpdateInterface(playerid)
{
	// Обновляем Инвент и грузим цвета
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), ShowFrisk2(playerid,playerid);
	
	// Обновляем спидометр
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && PlayerInfo[playerid][pDrawVisible][7] == false && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8 && DrawSpeed[playerid] == true)
	{
		PlayerTextDrawBackgroundColour(playerid, PlayerSpeedDraw[playerid][1], PlayerInfo[playerid][pStyle4]), PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][1]);
		PlayerTextDrawBackgroundColour(playerid, PlayerSpeedDraw[playerid][2], PlayerInfo[playerid][pStyle4]), PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][2]);
		PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][6], PlayerInfo[playerid][pStyle1]), PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][6]);
		PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][7], PlayerInfo[playerid][pStyle2]), PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][7]);
		if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][8], 673720575);
		else PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][8], -1);
		PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][8]);
	}

	// Обновляем чекер ганг зон
	if(gMifga[playerid] != 9999 || gVidga[playerid] == true || gNarkoFarm[playerid] != 9999)
	{
		PlayerTextDrawBackgroundColour(playerid, PlayerGangDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
		PlayerTextDrawShow(playerid, PlayerGangDraw[0][playerid]);
	}
	
	// Обновляем interaction с другим игроком
	if(Moiplayer[playerid] != 9999)
	{
		PlayerTextDrawBackgroundColour(playerid, PlaInter[0][playerid], PlayerInfo[playerid][pStyle4]);
		PlayerTextDrawShow(playerid, PlaInter[0][playerid]);
	}

	// Обновляем подсказку транспорта
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(PlayerInfo[playerid][pDrawVisible][9] == false && VehInfo[vehicleid][vEngine] == 0 && setting_pos_draw[playerid] != 10 && setting_size_draw[playerid] != 10) 
		{
			show_hint_player(playerid, vehicleid);
		}
	}

	// Обновляем название сервера
	if(PlayerInfo[playerid][pDrawVisible][2] == false) PlayerTextDrawColour(playerid, PlayerSiteDraw[0][playerid], PlayerInfo[playerid][pStyle1]), PlayerTextDrawShow(playerid, PlayerSiteDraw[0][playerid]);
	
	// Обновляем кислород в скафандре
	if(gSkafandr[playerid] > 0 && gOxygen[playerid] > 0 && PlayerInfo[playerid][pDrawVisible][10] == false && DrawOxygen[playerid] == true)
	{
		PlayerTextDrawColour(playerid, OxygenDraw[1][playerid], PlayerInfo[playerid][pStyle1]), PlayerTextDrawShow(playerid,OxygenDraw[1][playerid]);
		if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, OxygenDraw[2][playerid], 673720575);
		else PlayerTextDrawColour(playerid, OxygenDraw[2][playerid], -1);
		PlayerTextDrawShow(playerid,OxygenDraw[2][playerid]);

		PlayerTextDrawBackgroundColour(playerid, OxygenDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
		PlayerTextDrawShow(playerid,OxygenDraw[0][playerid]);
	}
	
	// Обновляем цвет фишек в казино на рулетке
	if(GetPVarInt(playerid,"kas") == 5 || GetPVarInt(playerid,"kas") == 6) PlayerTextDrawColour(playerid, FishkiDraw[0], PlayerInfo[playerid][pStyle1]), PlayerTextDrawShow(playerid, FishkiDraw[0]);
	return 1;
}

stock AntiFloodMysqlRequest(playerid, quan, bool:quanPlus = false)
{
	if(quanPlus == true) SetPVarInt(playerid,"afmysql",GetPVarInt(playerid,"afmysql")+1);
	if(GetPVarInt(playerid,"afmysql") >= quan)
	{
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}****  {FFFFFF}*[АнтиФлуд]*  {ff0000}****","{ff0000}******** {ffffff}Не флуди! {ff0000}********","*","");
		return 1;
	}
	if(quanPlus == false) SetPVarInt(playerid,"afmysql",GetPVarInt(playerid,"afmysql")+1);
	return 0;
}

stock GiveThingHand(playerid, thingId, thingQuan, thingPara, thingQara, thingType, thingPack)
{
	OnlineInfo[playerid][oInHandThing][0] = thingId; // ID Предмета
    OnlineInfo[playerid][oInHandThing][1] = thingQuan; // Количество
    OnlineInfo[playerid][oInHandThing][2] = thingPara; // Условности особые
    OnlineInfo[playerid][oInHandThing][3] = thingQara; // Статус краденного
    OnlineInfo[playerid][oInHandThing][4] = thingType; // Тип предмета
    OnlineInfo[playerid][oInHandThing][5] = thingPack; // Упаковка

	if(thingId == 196) // Пакет
	{
		RemovePlayerAttachedObject(playerid, 1);
		SetPlayerAttachedObject(playerid, 1, 1575, 6, 0.000000, 0.123000, 0.000000, 90.499984, -10.200003, 1.899998, 0.449000, 0.658999, 0.541000, 0, 0);
	}
	return 1;
}
stock InHandClear(playerid)
{
	OnlineInfo[playerid][oInHandThing][0] = 0; // ID Предмета
    OnlineInfo[playerid][oInHandThing][1] = 0; // Количество
    OnlineInfo[playerid][oInHandThing][2] = 0; // Условности особые
    OnlineInfo[playerid][oInHandThing][3] = 0; // Статус краденного
    OnlineInfo[playerid][oInHandThing][4] = 0; // Тип предмета
    OnlineInfo[playerid][oInHandThing][5] = 0; // Упаковка Ящик

	RemovePlayerAttachedObject(playerid, 1);
	return 1;
}
stock StopAudio(playerid, time, soundid)
{
	StopAudioTime[playerid] = time;
	StopAudioID[playerid] = soundid;
	return 1;
}
stock StopAudioProcess(playerid)
{
	StopAudioTime[playerid] --;
	if(StopAudioTime[playerid] == 0 && StopAudioID[playerid] > 0) PlayerPlaySound(playerid,StopAudioID[playerid],0,0,0);
	return 1;
}

stock GetTexturesOnObject(model)
{
	new quanTextures = GetTexturesOnObjectFrame(model); // Ищем в Каркасах
	if(quanTextures == -1) quanTextures = GetTexturesOnObjectIkea(model); // Ищем в IKEA
	if(quanTextures == -1) quanTextures = 1; // Так и не нашли, указываем одну текстуру
	return quanTextures;
}

stock GetTexturesOnObjectIkea(model)
{
	new quanTextures = -1;
	for(new i = 0; i < MAX_IKEA; i++)
	{
		if(IkeaInfo[i][iModel] == model)
		{
			quanTextures = IkeaInfo[i][iQuantextures];
			break;
		}
	}
	return quanTextures;
}

stock GetTexturesOnObjectFrame(model)
{
	new quanTextures = -1;
	for(new i = 0; i < MAX_FRAME; i++)
	{
		if(FrameInfo[i][frModel] == model)
		{
			quanTextures = FrameInfo[i][frQuantextures];
			break;
		}
	}
	return quanTextures;
}

stock GetClassOnObjectFrame(model)
{
	new classFrame;
	for(new i = 0; i < MAX_FRAME; i++)
	{
		if(FrameInfo[i][frModel] == model)
		{
			classFrame = FrameInfo[i][frClass];
			break;
		}
	}
	return classFrame;
}

stock showDialogInteriorBiz(playerid)
{
    if(MenuInfo[playerid][zStat] > 0) return 1;

    new b = DP[4][playerid];
    if(!IsANearWardrobeBiz(playerid, b)) return ErrorMessage(playerid, "{FF6347}Вы не в интерьере или далеко от бизнеса");
	if(!IsABizInteriorFrame(b)) return ErrorMessage(playerid, "{FF6347}В этом бизнесе нельзя изменять интерьер");
    if(BizzInfo[b][bSell] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя ремонтировать бизнес во время продажи");
	if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Вы уже заняты ремонтом или редактированием объекта");

    if(DP[0][playerid] == 0) DP[1][playerid] = 2; // Переместить объект интерьера дома
  	else if(DP[0][playerid] == 1) DP[1][playerid] = 4; // Изменить текстуры объекта интерьер дома
  	else if(DP[0][playerid] == 2) DP[1][playerid] = 3; // Убрать объект интерьер дома
    else return 1;

    PlayerPlaySound(playerid,40405,0,0,0);
    ShowAllObjectBiz(playerid, b, DP[1][playerid]);
	return 1;
}

stock InfoEditObject(playerid, type)
{
	new atext[10], btext[10];
	if(type == 1) atext = "дома", btext = "/dedit";
	else if(type == 2) atext = "бизнеса", btext = "/bedit";

	new line[120],lines[2048];
	format(line,sizeof(line),"{ffcc66}1. Установка Объекта"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Откройте инвентарь %s, выберите предмет мебели и установите его", atext), strcat(lines,line);
	format(line,sizeof(line),"\n\n{ffcc66}2. Перемещение Объекта"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Включите отображение лейблов {ffcc66}%s >> 3D Лейбл On", btext), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Переместите предмет по его ID {ffcc66}/eo ID "), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Вращайте объект вокруг своей оси {ffcc66}/rx ID Float, /ry ID Float, /rz ID Float"), strcat(lines,line);
	format(line,sizeof(line),"\n\n{ffcc66}3. Удаление Объекта"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Включите отображение лейблов {ffcc66}%s >> 3D Лейбл On", btext), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Уберите предмет по ID {ffcc66}/dobject ID"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Предмет будет убран в инвентарь %s", atext), strcat(lines,line);
	format(line,sizeof(line),"\n\n\n{FF6347}Внимание!"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Не устанавливайте объекты на проезжую часть"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Не нарушайте логику и физику объектами"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Администрация может выдать предупреждение за злоупотребление возможностями"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}- Система записывает номер аккаунта игрока, который редактировал объект"), strcat(lines,line);
	if(type == 1) ShowDialog(playerid,914,DIALOG_STYLE_MSGBOX,"{ff9000}Редактор Объектов",lines,"Ок","");
	else if(type == 2) ShowDialog(playerid,1234,DIALOG_STYLE_MSGBOX,"{ff9000}Редактор Объектов",lines,"Ок","");
	return 1;
}

stock CreatePassword()
{
    new texts[14], text[2];
    for(new i = 0; i < 12; i++)
	{
	    new numLetter = 1 + random(25);
		new numText[2];
	    switch(numLetter)
		{
		    case 1: numText = "a";
		    case 2: numText = "b";
		    case 3: numText = "c";
		    case 4: numText = "d";
		    case 5: numText = "e";
		    case 6: numText = "f";
		    case 7: numText = "g";
		    case 8: numText = "h";
		    case 9: numText = "i";
		    case 10: numText = "j";
		    case 11: numText = "k";
		    case 12: numText = "l";
		    case 13: numText = "m";
		    case 14: numText = "n";
		    case 15: numText = "o";
		    case 16: numText = "p";
		    case 17: numText = "q";
		    case 18: numText = "r";
		    case 19: numText = "s";
		    case 20: numText = "t";
		    case 21: numText = "u";
		    case 22: numText = "v";
		    case 23: numText = "w";
		    case 24: numText = "x";
		    case 25: numText = "y";
		    case 26: numText = "z";
		    default: numText = "z";
		}
		format(text,sizeof(text),"%s", numText), strcat(texts, text);
	}
    return texts;
}

stock showDialogBetMoneyMafia(playerid)
{
	new g = fraction(playerid);
	new line[80],lines[240],glave_str[MAX_BIGINT_LEN];
	bigint_get_str(OrganInfo[g][glave], glave_str);
    format(line,sizeof(line),"{cccccc}Введите количество денег в качестве ставки на стрелу"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}На счету мафии: {99ff66}%s$ {cccccc}[%s]", glave_str, get_k(OrganInfo[g][glave])), strcat(lines,line);
	format(line,sizeof(line),"\n\n{FF6347}Сумма не меньше 100.000$ и не больше 100.000.000$"), strcat(lines,line);
	ShowDialog(playerid,806,DIALOG_STYLE_INPUT,"{ff9000}Mafia",lines,"Принять","Отмена");
	return 1;
}

stock AntiFloodText(playerid, const text[])
{
    if(checkflood(playerid, text))
    {
        if(Acheck[playerid] >= 1)
        {
            SendClientMessage(playerid, COLOR_LIGHTRED, "Большое количество повторяющегося текста приводит к кровотечению из глаз");
            SendClientMessage(playerid, COLOR_LIGHTRED, "Пожалуйста... не флудите. Мы заботимся о вас [Code 0138]"), PlayerPlaySound(playerid,4203,0,0,0);
            Achtim[playerid] = 4;
            return 1;
        }
        else Acheck[playerid] ++;
    }
    else Acheck[playerid] = 0;
    iflood(playerid, text);
    return 0;
}

stock CreateGPCI(playerid) // Проверяем корректность GPCI 
{
	new buffer[64];
	GetPlayerClientID(playerid, buffer);
	if(checksimvol(buffer))
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты защитой сервера [Error GPCI]");
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты защитой сервера [Error GPCI]","*","");
		Kickx(playerid);
		return 1;
	}
	format(PlayerInfo[playerid][pGpci], 64, buffer);
	return 0;
}

function RussianWord(database)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[24];
		cache_get_value_name(0, "text", string, 24);
		if(strfind(string, "чикипуки",true) != (-1)) printf("[MODE]: DB %d Русское Слово: %s", database, string);
		else
		{
			printf("[MODE]: DB %d Русское Слово: %s", database, string);
			printf("[debug] Кодировка нарушена [ Выключаем сервер ]");

			GameModeExitFunc();
		}
	}
	else printf("[MODE]: DB %d Русское Слово не найдено [ Таблица: word, Слово: чикипуки ]", database);
	return 1;
}

stock AntiPidor(playerid, quan)
{
	if (server == 0) return 0;
	
	NoteBan[playerid] ++;
  	if(NoteBanTime[playerid] >= 1 && NoteBan[playerid] >= quan)
  	{
		AdminLog("antipidor", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Защита от слива (1)");
  	    OrgLog(PlayerInfo[playerid][pLeader], "antipidor", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Защита от слива (1)");
		
		if(PlayerInfo[playerid][pMember] > 0 && PlayerInfo[playerid][pHidden] == 0) UninvitePlayerBridge(PlayerInfo[playerid][pID], PlayerInfo[playerid][pMember]);
		if(PlayerInfo[playerid][pLeader] > 0) UnmakeleaderPlayerBridge(PlayerInfo[playerid][pID], PlayerInfo[playerid][pLeader], 0);
		if(PlayerInfo[playerid][pSoska] > 0) MakeadminPlayerBridge(PlayerInfo[playerid][pID], 0);

		PlayerInfo[playerid][pLeader] = 0;
		PlayerInfo[playerid][pMember] = 0;
		PlayerInfo[playerid][pSoska] = 0;

		SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты защитой сервера [AntiPidor]");
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты защитой сервера [AntiPidor]","*","");
		Kickx(playerid);
		return 1;
  	}
	if(NoteBanTime[playerid] <= 0) NoteBanTime[playerid] = 20;
	return 0;
}

