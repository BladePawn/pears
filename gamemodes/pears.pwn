stock IsNumeric(const string[])
{
	for(new i = 0, j = strlen(string); i < j; i++)
	{
		if (string[i] > '9' || string[i] < '0') return 0;
	}
	return 1;
}
stock ReturnUserID(userId)
{
    new playerid = INVALID_PLAYER_ID;
    foreach(Player, i)
    {
        if(PlayerInfo[i][pID] == userId)
        {
            playerid = i;
            break;
        }
    }
    return playerid;
}

stock ReturnUser(const text[], status = 0) // false Sign OFF, true Sign ON
{
	new bool: signinfo = false;
	if(status == 1) signinfo = true;
	new pos = 0;
	while (text[pos] < 0x21) // Strip out leading spaces
	{
		if (text[pos] == 0) return INVALID_PLAYER_ID; // No passed text
		pos++;
	}
	new userid = INVALID_PLAYER_ID;
	if (IsNumeric(text[pos])) // Check whole passed string
	{
		// If they have a numeric name you have a problem (although names are checked on id failure)
		userid = strval(text[pos]);
		if (userid >=0 && userid < MAX_PLAYERS)
		{
			if(!IsOnline(userid))
			{
				/*if (playerid != INVALID_PLAYER_ID)
				{
					SendClientMessage(playerid, 0xFF0000AA, "User not connected");
				}*/
				userid = INVALID_PLAYER_ID;
			}
			else
			{
				return userid; // A player was found
			}
		}
		/*else
		{
			if (playerid != INVALID_PLAYER_ID)
			{
				SendClientMessage(playerid, 0xFF0000AA, "Invalid user ID");
			}
			userid = INVALID_PLAYER_ID;
		}
		return userid;*/
		// Removed for fallthrough code
	}
	// They entered [part of] a name or the id search failed (check names just incase)
	new len = strlen(text[pos]);
	new count = 0;
	new name[MAX_PLAYER_NAME];
	foreach(Player,i)
	{
		GetPlayerName(i, name, sizeof (name));
		if(strcmp(name, text[pos], true, len) == 0 || strcmp(PlayerInfo[i][pName], text[pos], true, len) == 0 && gSign[i] == signinfo
			|| strcmp(PlayerInfo[i][pName], text[pos], true, len) == 0 && status == 228) // Check segment of name
		{
			if (len == strlen(name)) // Exact match
			{
				return i; // Return the exact player on an exact match
				// Otherwise if there are two players:
				// Me and MeYou any time you entered Me it would find both
				// And never be able to return just Me's id
			}
			else // Partial match
			{
				count++;
				userid = i;
			}
		}
	}
	if (count != 1)
	{
		/*if (playerid != INVALID_PLAYER_ID)
		{
			if (count)
			{
				SendClientMessage(playerid, 0xFF0000AA, "Multiple users found, please narrow earch");
			}
			else
			{
				SendClientMessage(playerid, 0xFF0000AA, "No matching user found");
			}
		}*/
		userid = INVALID_PLAYER_ID;
	}
	return userid; // INVALID_USER_ID for bad return
}
stock payanim(playerid, stat)
{
	ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false);
	Eat[playerid] = 1; EatTime[playerid] = 4;
	RemovePlayerAttachedObject(playerid,1);
	if(stat == 0) SetPlayerAttachedObject(playerid, 1, 1212, 6, 0.109999, 0.060999, 0.000000, 0.000000, -85.199966, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
	else if(stat == 1) SetPlayerAttachedObject(playerid, 1, 19941, 6, 0.109999, 0.060999, 0.000000, 0.000000, -85.199966, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
	return 1;
}
stock frontme(playerid, Float:distance, &Float:x, &Float:y, &Float:z, &Float:a, bool:newPosition = false)
{
	if(newPosition == true) // Расчитываем координаты по новой позиции
	{
		x = AfterProtect_X[playerid];
		y = AfterProtect_Y[playerid];
		z = AfterProtect_Z[playerid];
		a = AfterProtect_A[playerid];
	}
	else if (IsOnline(playerid)) // Расчитываем по старой
	{
    	GetPlayerPos(playerid, x,y,z);
		GetPlayerFacingAngle(playerid, a);
	}

	x=x+distance*floatsin(-a,degrees);
	y=y+distance*floatcos(-a,degrees);
	return 1;
}

stock frontpos(Float:distance, Float:realX, Float:realY, Float:realA, &Float:x, &Float:y)
{
	x=realX+distance*floatsin(-realA,degrees);
	y=realY+distance*floatcos(-realA,degrees);
	return 1;
}

stock backme(playerid, Float:distance, &Float:x, &Float:y, &Float:z, &Float:a)
{
	if (IsOnline(playerid))
	{
		GetPlayerPos(playerid, x,y,z);
		GetPlayerFacingAngle(playerid,a);
	}
	x=x-distance*floatsin(-a,degrees);
	y=y-distance*floatcos(-a,degrees);
	return 1;
}

stock recoveryhelp(playerid)
{
	if(OnlineInfo[playerid][oRecoveryPassword] > 0)
	{
		new string[240];

		// Доступ к смене пароля не получен, значит требуем ввести код
		if(OnlineInfo[playerid][oRecoveryAccess] == false)
		{
			format(string,sizeof(string),"{cccccc}Привет, {ff9000}%s\n{ff9000}Код восстановления отправлен на Email. Введите код\n\n{cccccc}Сверните игру и проверьте почту {0088ff}[ ALT + TAB или Win ]",PlayerInfo[playerid][pName]);
			ShowDialog(playerid,15,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",string,"Далее","Отмена");
		}

		// Доступ к смене пароля был получен, показываем окно для ввода нового пароля
		else
		{
			new line[200],lines[1000];
			format(line,sizeof(line),"\n{cccccc}Привет, {ff9000}%s", PlayerInfo[playerid][pName]), strcat(lines,line);
			format(line,sizeof(line),"\n{ff9000}Пароль: {99ff66}Введите ваш Новый Пароль"), strcat(lines,line);
			format(line,sizeof(line),"\n\n{cccccc}Содержание пароля: Буквы, цифры и символы"), strcat(lines,line);
			format(line,sizeof(line),"\n{cccccc}Количество символов: от 10 до 40"), strcat(lines,line);
			format(line,sizeof(line),"\n\n{ff9000}Показать пароль: Отмена >> Ввод пароля\n"), strcat(lines,line);
			if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,16,DIALOG_STYLE_PASSWORD,"{ff9000}Авторизация",lines,"Далее","Отмена");
			else ShowDialog(playerid,16,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",lines,"Далее","Отмена");
		}
	}
	return 1;
}
stock autorizehelp(playerid)
{
	new line[100],lines[700];
	format(line,sizeof(line),"{99ff66}Продолжить Авторизацию"), strcat(lines,line);
	if(PlayerInfo[playerid][pTypoihyi] == 0) format(line,sizeof(line),"\n{cccccc}Отображение Пароля: {FF6347}[Скрыто]"), strcat(lines,line);
	else format(line,sizeof(line),"\n{cccccc}Отображение Пароля: {99ff66}[Открыто]"), strcat(lines,line);

	if(OnlineInfo[playerid][oRecoveryPassword] > 0) format(line,sizeof(line),"\n{FF6347}Забыли Пароль? {99ff66}>> Продолжить Восстановление"), strcat(lines,line);
	else format(line,sizeof(line),"\n{FF6347}Забыли Пароль?"), strcat(lines,line);

	format(line,sizeof(line),"\n{cccccc}Не приходит письмо"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Не привязан Email"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Забыли Email?"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Проблемы с Google"), strcat(lines,line);
	ShowDialog(playerid,1182,DIALOG_STYLE_TABLIST,"{ff9000}Авторизация",lines,"Выбрать","Выход");
	return 1;
}
stock regmenu(playerid)
{
	if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,1182,DIALOG_STYLE_LIST,"{ff9000}Регистрация","{99ff66}Продолжить Регистрацию\n{cccccc}Ввод Пароля: {FF6347}[Скрытый]","Выбрать","Выход");
	else ShowDialog(playerid,1182,DIALOG_STYLE_LIST,"{ff9000}Регистрация","{99ff66}Продолжить Регистрацию\n{cccccc}Ввод Пароля: {99ff66}[Открытый]","Выбрать","Выход");
