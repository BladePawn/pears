CMD:agetavia(playerid)
{
	new string[144];
	if(GetPVarInt(playerid,"antiflood") > 0) return format(string, sizeof(string), "[ Мысли ]: На площадке ещё нет свободного транспорта {ffcc00}[ Подождите %d сек. ]", GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY, string);
	if(GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу арендовать транспорт в здании");
	if(Stun[4][playerid] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в наручниках");
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вам нужно выйти из транспорта");
	if(IsPlayerInRangeOfPoint(playerid,20.0,-1457.1082,501.4790,11.2193))
	{
		if(PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pMember] == 3 && GetAccessRankOrgMay(playerid, PlayerInfo[playerid][pMember], 49, NO_FBI))
		{
			ShowDialog(playerid,756,2,"{336633}Национальная Гвардия", "Hydra","Выбрать","Выход");
		}
		else ErrorMessage(playerid, "{FF6347}Этот транспорт доступен только ВВС");
	}
