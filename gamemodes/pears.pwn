	    	    {
					if(DrawFrame[playerid] == true) return ErrorMessage(playerid, "{FF6347}Вы уже выбираете планировку");
					if(GetPlayerVirtualWorld(playerid) == 0 || GetPlayerInterior(playerid) == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете выбрать планировку на улице");
	    	        TP[0][playerid] = nd;
	    	        DP[0][playerid] = -1;
					DP[0][playerid] = GetWatchFrameNext(playerid, TP[0][playerid], 0, 0);
					TP[1][playerid] = DP[0][playerid];
					if(DP[0][playerid] == -1) return ErrorText(playerid, "[ Мысли ]: Для этого дома нет доступных интерьеров"), format(string, sizeof(string), "%d", nd), pc_cmd_dedit(playerid, string);
                    if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid);
					LoadMenuFrame(playerid, 0);
					ClearAnimations(playerid), ClearAnim(playerid);
