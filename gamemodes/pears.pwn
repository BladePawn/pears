function Call_lnames(playerid, str_name[])
{
	new rows, kol, qwer[84];
	new str[84],sctring[2640];
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24], datad3[24], datad4;
		cache_get_value_name(i, "current", datad2, 24);
		cache_get_value_name(i, "newname", datad3, 24);
		cache_get_value_name_int(i, "unix", datad4);
		new tyear, tmonth, tday, thour, tminute, tsecond;
		stamp2datetime(datad4, tyear, tmonth, tday, thour, tminute, tsecond, 3);
		format(str,sizeof(str),"%s >> %s [ %02d.%02d.%d %02d:%02d ]\n", datad2, datad3, tday, tmonth, tyear, thour, tminute), strcat(sctring,str);
		kol ++;
	}
	if(kol > 0)
	{
		format(qwer,sizeof(qwer),"{ff9000}Ник Неймы %s [%d]",str_name,kol);
		ShowDialog(playerid,1700,DIALOG_STYLE_LIST,qwer,sctring,"Ок","");
		PlayerPlaySound(playerid,40405,0,0,0);
	}
	else
	{
	    new string[144];
		format(string,sizeof(string),"[ Мысли ]: У %s пустая история никнеймов",str_name);
		SendClientMessage(playerid, COLOR_GREY, string);
		HidePlayerDialog(playerid);
	}
	return 1;
}
