			new input;
            if(sscanf(inputtext, "i", input)) return ErrorMessage(playerid, "{FF6347}Вы ничего не ввели");
   			if(input < 1000 || input > 500000) return ErrorMessage(playerid, "{FF6347}Не меньше 1000 и не больше 500000");

			new bool:yes;
