stock Update_Seamap(p)
{
	// Ищем сундук с сокровищами
	if(SeaChestStat == 1)
	{
		new Float:pos[3],Float:radchest;
		GetDynamicObjectPos(SeaChestObj, pos[0], pos[1], pos[2]);
		radchest = GetPlayerDistanceFromPoint(p, pos[0], pos[1], 0.0);
		if(radchest <= 200.0)
		{
			new string[6];
			if(SeaZone[2][p] == 0) SeaZone[2][p] = 1, TextDrawShowForPlayer(p, MapDraw[6]), format(string, sizeof(string), "%.2f",radchest), PlayerTextDrawSetString(p, MapDraw1, string), PlayerTextDrawShow(p, MapDraw1);
			if(SeaZone[2][p] == 1) format(string, sizeof(string), "%.2f",radchest), PlayerTextDrawSetString(p, MapDraw1, string), PlayerTextDrawShow(p, MapDraw1);
		}
		else
		{
			if(SeaZone[2][p] == 1) SeaZone[2][p] = 0, TextDrawHideForPlayer(p, MapDraw[6]), PlayerTextDrawHide(p, MapDraw1);
		}
	}
	else
	{
		if(SeaZone[2][p] == 1) SeaZone[2][p] = 0, TextDrawHideForPlayer(p, MapDraw[6]), PlayerTextDrawHide(p, MapDraw1);
	}

	// Ищем Ракушки
	new Float:pos1[3], sshell = -1, Float:radshell;
	for(new i = 0; i < 5; i++)
	{
		if(SeaShellStat[i] == 1)
		{
			GetDynamicObjectPos(SeaShellObject[i], pos1[0], pos1[1], pos1[2]);
			radshell = GetPlayerDistanceFromPoint(p, pos1[0], pos1[1], 0.0);
			if(radshell <= 50) sshell = i;
		}
	}
	if(sshell >= 0)
	{
		if(SeaZone[0][p] == 0) TextDrawShowForPlayer(p, MapDraw[4]), SeaZone[0][p] = 1;
	}
	else
	{
		if(SeaZone[0][p] == 1) SeaZone[0][p] = 0, TextDrawHideForPlayer(p, MapDraw[4]);
	}

	// Ищем Морские Звёзды
	new Float:pos2[3], sstar = -1, Float:radtstar;
	for(new i = 0; i < 21; i++)
	{
		if(SeaStarStat[i] == 1)
		{
			GetDynamicObjectPos(SeaStarObject[i], pos2[0], pos2[1], pos2[2]);
			radtstar = GetPlayerDistanceFromPoint(p, pos2[0], pos2[1], 0.0);
			if(radtstar <= 50) sstar = i;
		}
	}
	if(sstar >= 0)
	{
		if(SeaZone[1][p] == 0) TextDrawShowForPlayer(p, MapDraw[3]), SeaZone[1][p] = 1;
	}
	else
	{
		if(SeaZone[1][p] == 1) SeaZone[1][p] = 0, TextDrawHideForPlayer(p, MapDraw[3]);
	}
	
	// Ищем Рыбные Зоны
	if(IsMinFish(p) || IsBigFish(p))
	{
		new fz = IsNonFish(p);
	    if(fz >= 0)
	    {
	    	new string[6];
	    	format(string, sizeof(string), "%d",fish_quan[fz]), PlayerTextDrawSetString(p, MapDraw2, string), PlayerTextDrawShow(p, MapDraw2);
	    }
	    else PlayerTextDrawSetString(p, MapDraw2, "1000"), PlayerTextDrawShow(p, MapDraw2);
  	}
	return 1;
}
stock FindShell(playerid)
{
	new Float:mypos, Float:findpos, kakoi, Float:fpos[21][3];
	for(new i = 0; i < 5; i++)
	{
	    if(SeaShellStat[i] == 1)
	    {
	    	GetDynamicObjectPos(SeaShellObject[i], fpos[i][0], fpos[i][1], fpos[i][2]);
	    	mypos = GetPlayerDistanceFromPoint(playerid, fpos[i][0], fpos[i][1], fpos[i][2]);
	    	break;
    	}
	}
	for(new i = 1; i < 5; ++i)
	{
		if(mypos <= (findpos = GetPlayerDistanceFromPoint(playerid, fpos[i][0], fpos[i][1], fpos[i][2]))) continue;
		mypos = findpos;
		kakoi = i;
	}
	return kakoi;
}
stock FindStar(playerid)
{
	new Float:mypos, Float:findpos, kakoi, Float:fpos[21][3];
	for(new i = 0; i < 21; i++)
	{
	    if(SeaStarStat[i] == 1)
	    {
	    	GetDynamicObjectPos(SeaStarObject[i], fpos[i][0], fpos[i][1], fpos[i][2]);
	    	mypos = GetPlayerDistanceFromPoint(playerid, fpos[i][0], fpos[i][1], fpos[i][2]);
	    	break;
    	}
	}
	for(new i = 1; i < 21; ++i)
	{
		if(mypos <= (findpos = GetPlayerDistanceFromPoint(playerid, fpos[i][0], fpos[i][1], fpos[i][2]))) continue;
		mypos = findpos;
		kakoi = i;
	}
	return kakoi;
}
stock Update_Seachest(p)
{
	if(SeaChestStat == 1) TextDrawShowForPlayer(p, MapDraw[7]), TextDrawShowForPlayer(p, MapDraw[8]);
	else TextDrawHideForPlayer(p, MapDraw[7]), TextDrawHideForPlayer(p, MapDraw[8]);
}
stock Close_Seamap(p)
{
	TextDrawHideForPlayer(p, MapDraw[0]);
	TextDrawHideForPlayer(p, MapDraw[1]);
	TextDrawHideForPlayer(p, MapDraw[2]);
	TextDrawHideForPlayer(p, MapDraw[3]);
	TextDrawHideForPlayer(p, MapDraw[4]);
	TextDrawHideForPlayer(p, MapDraw[5]);
	TextDrawHideForPlayer(p, MapDraw[6]);
	TextDrawHideForPlayer(p, MapDraw[7]);
	TextDrawHideForPlayer(p, MapDraw[8]);
	PlayerTextDrawHide(p, MapDraw1);
	PlayerTextDrawHide(p, MapDraw2);
	Dei[p] = 0;
}
stock gunprice(p)
{
	new str[214],sctring[4096];
	format(str,sizeof(str),"Оружие\tЦена"), strcat(sctring,str);
    for(new g = 1; g < 47; g++) format(str,sizeof(str),"\n%s[%d]\t%d$ [%s]",gunName[g],g,gunPrice[g], get_k(gunPrice[g])), strcat(sctring,str);
    ShowDialog(p,1141,DIALOG_STYLE_TABLIST_HEADERS,"Оружие и Аммуниция",sctring,"Выбрать","Выход");
    return 1;
}
stock friskprice(playerid)
{
	new str[214],sctring[4096], quan;
	format(str,sizeof(str),"Предмет\tЦена"), strcat(sctring,str);
    for(new f = 1; f < sizeof(friskName); f++) 
	{
		if(friskDefault[f] != -1) 
		{
			List[quan][playerid] = f;
			quan ++;
			format(str,sizeof(str),"\n%s\t%d$ [%s]",friskName[f],friskPrice[f], get_k(friskPrice[f])), strcat(sctring,str);
			if(quan >= 200) break; // Защита от большого количества строк на странице (List имеет всего 200 слотов)
		}
	}
    ShowDialog(playerid,1143,DIALOG_STYLE_TABLIST_HEADERS,"Предметы",sctring,"Выбрать","Выход");
    return 1;
}

