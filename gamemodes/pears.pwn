					format(string, sizeof(string), "%s кричит: Побереги-и-ись!! Дерево падае-e-eт!", playername(playerid)); PlayerPlaySound(playerid,6401,0,0,0);
					ProxDetector(30.0, playerid, string,COLOR_WHITE,COLOR_WHITE,COLOR_WHITE,COLOR_FADE1,COLOR_FADE2);
					}
				}
				else if(Lesypzdc[setles] >= 1000 && Lesypzdc[setles] != 9999)
				{
