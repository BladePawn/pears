CMD:leaders(playerid, const params[])
{
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Лидеры","{cccccc}Поиск лидеров...","*","");
	mysql_tquery(pearsq, "SELECT Name, Leader, Soska, Online, VacBeg \
		FROM `pp_igroki` WHERE `Leader` >= '1' ORDER BY `Online` DESC, `Leader` ASC", "Call_leaders", "d", playerid);
	return 1;
}
CMD:zams(playerid, const params[])
{
	PlayerPlaySound(playerid,40405,0,0,0);
	new year, month,day;
	getdate(year, month, day);
	new str[100],sctring[2000];
	format(str,sizeof(str),"{ff9000}Дата   {FFFFFF}%d.%d.%d\n\n",day,month,year);
	strcat(sctring,str);
	foreach (Player, i)
 	{
		if(PlayerInfo[i][pMember] >= 1 && OnlineInfo[i][oLogged] == 1 && PlayerInfo[i][pSoska] < 10 && gSign[i] == false)
		{
			new maxrank = get_maxrank(PlayerInfo[i][pMember]);
			if(PlayerInfo[i][pRank] == maxrank - 1)
			{
				if(GetPVarInt(i,"afksystem") >= 2) format(str,sizeof(str),"%s {ffffff} %s [тел. %d]  {cccccc}AFK: %d сек.\n",frakName[PlayerInfo[i][pMember]],PlayerInfo[i][pName],PlayerInfo[i][pDrugPerk],GetPVarInt(i,"afksystem"));
				else format(str,sizeof(str),"%s {ffffff} %s [тел. %d]     \n",frakName[PlayerInfo[i][pMember]],PlayerInfo[i][pName],PlayerInfo[i][pDrugPerk]);
				strcat(sctring,str);
			}
		}
	}
	format(str,sizeof(str),"\n ");
	strcat(sctring,str);
	ShowDialog(playerid,793,DIALOG_STYLE_MSGBOX,"{ff9000}Заместители Лидеров",sctring,"*","");
	return 1;
}
CMD:getfamspawn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Найти спавн семьи [ /getfamspawn Номер Семьи ]");
	if(params[0] <= 0 || params[0] > 500) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Номер семьи от 1 до 500");
	if(FamilyInfo[params[0]][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Этой семьи не существует");
	if(FamilyInfo[params[0]][fStatusSpawn] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У семьи не открыта функция спавна");
 	if(FamilyInfo[params[0]][fSpawnX] == 0.0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У семьи не установлена точка спавна");
 	new string[144];
 	CreateGps(playerid,FamilyInfo[params[0]][fSpawnX], FamilyInfo[params[0]][fSpawnY], FamilyInfo[params[0]][fSpawnZ], 0, 0, 5.0);
  	format(string, sizeof(string), "{0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Спавн Семьи %d {ffffff}отмечен на карте {cccccc}[ Int: %d | World: %d ]",params[0], FamilyInfo[params[0]][fInt],FamilyInfo[params[0]][fWorld]);
  	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	return 1;
}
CMD:herfam(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
 	new string[144],kol, Float:pos[3], Float:dist;
 	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	for(new f = 0; f < sizeof(FamilyInfo); f++)
	{
		if(FamilyInfo[f][fSost] > 0 && FamilyInfo[f][fStatusSpawn] > 0)
		{
			dist = GetPlayerDistanceFromPoint(playerid, FamilyInfo[f][fSpawnX], FamilyInfo[f][fSpawnY], FamilyInfo[f][fSpawnZ]);
			if(dist < 50)
			{
				FamilyInfo[f][fSpawnX] = 2772.5957, FamilyInfo[f][fSpawnY] = -2236.9819, FamilyInfo[f][fSpawnZ] = 5.0171;
				FamilyInfo[f][fInt] = 0, FamilyInfo[f][fWorld] = 0, FamilyInfo[f][fMoney] += 100000;
				SaveFamily(f);
				kol++;
			}
		}
	}
	if(kol > 0)
	{
		format(string, sizeof(string), " [ ADM ]: Админ {ff0000}%s {ffcc33}изменил спавн семьям в радиусе [%d семей]", PlayerInfo[playerid][pName], kol);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("herfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Сбросил спавн семьи");
	}
	else SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Нет спавнов семей в радиусе..");
	return 1;
}
CMD:famloss(playerid)
{
	if(PlayerInfo[playerid][pSoska] <= 5) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
    new unixtime = gettime(), kol = 0;
    new str[100],sctring[4000];
	for(new f = 0; f < sizeof(FamilyInfo); f++)
	{
		if(FamilyInfo[f][fSost] >= 1)
		{
		    if(unixtime >= FamilyInfo[f][fLoss])
		    {
		    	new ostalos = unixtime-FamilyInfo[f][fLoss];
				new osday = ostalos/86400;
				new vrem = ostalos-osday*86400;
   				new oshour = vrem/3600;
				if(osday >= 60) format(str,sizeof(str),"{cccccc}%d %s {cccccc}[%d дней, %d часов]\n",f, FamilyInfo[f][fName],osday,oshour), strcat(sctring,str), kol ++;
			}
		}
	}
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}В семьях участники Offline 30+ дней",sctring,"Ок","");
	if(kol == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Неактивные семьи отсутствуют");
	return 1;
}
CMD:famgar(playerid)
{
	if(PlayerInfo[playerid][pSoska] <= 5) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
    new str[100],sctring[2000];
	for(new f = 0; f < sizeof(FamilyInfo); f++)
	{
		if(FamilyInfo[f][fSost] >= 1)
		{
		    new kolg = 0;
			for(new gf = 0; gf < 10; gf++)
			{
				if(FamilyInfo[f][fVeh][gf] >= 1) kolg ++;
			}
		    if(kolg >= 1)
			{
				format(str,sizeof(str),"{cccccc}%d %s {cccccc}[%d т.с.]\n",f, FamilyInfo[f][fName],kolg);
				strcat(sctring,str);
			}
		}
	}
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Семьи с Гаражами",sctring,"Ок","");
	return 1;
}
forward Call_jobexp(playerid, many);
public Call_jobexp(playerid, many)
{
	new rows, string[144],kol, f_str[184], itog;
	PlayerPlaySound(playerid,40405,0,0,0);
	new year, month,day;
	getdate(year, month, day);
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24],giveplayerid,datad5,datad7,datad8,datadid;
		cache_get_value_name(i, "Name", datad2, 24);
		cache_get_value_name_int(i, "Online", datad5);
		//cache_get_value_name_int(i, "Ammo6", datad6);
		cache_get_value_name_int(i, "Question", datad7);
		cache_get_value_name_int(i, "Account", datad8);
		cache_get_value_name_int(i, "user_id", datadid);
		if(datad5 == 1)
		{
			giveplayerid = ReturnUser(datad2, 1);
			if(IsOnline(giveplayerid))
			{
				if(OnlineInfo[giveplayerid][oLogged] == 1)
				{
					PlayerInfo[giveplayerid][pAccount] += many*PlayerInfo[giveplayerid][pQuestion];
					mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Account` = '%d', `Question` = '0' WHERE `Name` = '%e'",datad8+many*PlayerInfo[giveplayerid][pQuestion], datad2);
          			query_empty(pearsq, f_str);
					format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffcc66}%s {ffffff}выдал вам зарплату эксперта {00cc00}%d$", PlayerInfo[playerid][pName], many*PlayerInfo[giveplayerid][pQuestion]);
					SendClientMessage(giveplayerid, COLOR_GREY, string);
					kol ++;
					itog += many*PlayerInfo[giveplayerid][pQuestion];
					PlayerPlaySound(giveplayerid,6401,0,0,0);
					MoneyLog("salary", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "", "", many*PlayerInfo[giveplayerid][pQuestion], "Зарплата Эксперта");
					PlayerInfo[giveplayerid][pQuestion] = 0;
				}
				else
				{
					new lave = many*datad7;
					PlayerInfo[giveplayerid][pAccount] += datad8+many*datad7;
					mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Account` = '%d', `Question` = '0' WHERE `Name` = '%e'",datad8+lave, datad2);
					query_empty(pearsq, f_str);
					kol ++;
					itog += lave;
					PlayerInfo[giveplayerid][pQuestion] = 0;
					MoneyLog("salary", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "", "", many*datad7, "Зарплата Эксперта");
				}
			}
			else
			{
				new lave = many*datad7;
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Account` = '%d', `Question` = '0' WHERE `Name` = '%e'",datad8+lave, datad2);
				query_empty(pearsq, f_str);
				kol ++;
				itog += lave;
				MoneyLog("salary", datadid, datad2, "", 0, "", "", many*datad7, "Зарплата Эксперта");
			}
		}
		else if(datad5 == 0)
		{
			new lave = many*datad7;
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Account` = '%d', `Question` = '0' WHERE `Name` = '%e'",datad8+lave, datad2);
			query_empty(pearsq, f_str);
			kol ++;
			itog += lave;
			MoneyLog("salary", datadid, datad2, "", 0, "", "", many*datad7, "Зарплата Эксперта");
		}
	}
	format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы выдали зарплату {ffcc66}%d {0088ff}экспертам", kol);
	SendClientMessage(playerid, COLOR_GREY, string);
	format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Общая сумма выданых денег {00cc00}%d$", itog);
	SendClientMessage(playerid, COLOR_GREY, string);
	AdminLog("jobexp", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", itog, "Зарплата экспертов");
	PlayerPlaySound(playerid,6401,0,0,0);
	return true;
}
CMD:jobexp(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_EXPERT)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдача зарплаты экспертам [ /jobexp $ за один ответ ]");
	if(params[0] > 10000 || params[0] < 300) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 300$ и не больше 10000$ за один ответ");
	mysql_tquery(pearsq, "SELECT user_id, Name, Online, Question, Account \
		FROM `pp_igroki` WHERE `Expert` >= '1' AND `Soska` = '0' ORDER BY `Question` DESC LIMIT 60", "Call_jobexp", "dd", playerid, params[0]);
	return 1;
}
CMD:experts(playerid)
{
	if(PlayerInfo[playerid][pLevel] >= 2 || PlayerInfo[playerid][pHidden] >= 1)
    {
		if(AntiFloodMysqlRequest(playerid, 30)) return 1;
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Эксперты","{cccccc}Поиск экспертов...","*","");
		mysql_tquery(pearsq, "SELECT Name, Online, Ammo6 \
			FROM `pp_igroki` WHERE `Expert` >= '1' AND `Soska` = '0' ORDER BY `Online` DESC LIMIT 60", "Call_experts", "d", playerid);
	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я нахожусь в этом штате меньше 2-ух лет [ Level ]");
	return 1;
}

alias:admins("helpers", "админы")
CMD:admins(playerid)
{
	if(PlayerInfo[playerid][pLevel] > 1 || PlayerInfo[playerid][pHidden] >= 1)
    {
		if(AntiFloodMysqlRequest(playerid, 30)) return 1;
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Администрация","{cccccc}Поиск администраторов...","*","");
		mysql_tquery(pearsq, "SELECT Name, Soska, Online, Ammo6, VacBeg \
			FROM `pp_igroki` WHERE `Soska` >= '1' ORDER BY `Online` DESC, `Soska` DESC", "Call_admins", "d", playerid);
	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я нахожусь в этом штате меньше 2-ух лет [ Level ]");
	return 1;
}

CMD:medias(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pMedia] >= 1)
    {
		if(AntiFloodMysqlRequest(playerid, 30)) return 1;
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Медиа","{cccccc}Поиск медиа...","*","");
		mysql_pquery(pearsq, "SELECT Name, Media, Online FROM `pp_igroki` WHERE `Media` >= '1' ORDER BY `Online` DESC", "Call_medias", "d", playerid);
	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	return 1;
}

CMD:noconnect(playerid)
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	new str[100],sctring[2000];
	foreach (Player, i)
 	{
		if(OnlineInfo[i][oLogged] == 0)
		{
			format(str,sizeof(str),"%s[%d]\n",PlayerInfo[i][pName],i);
			strcat(sctring,str);
		}
	}
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Неавторизованные Игроки",sctring,"Ок","");
	return 1;
}

