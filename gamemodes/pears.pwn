		new messages[][] = {
			"Что за? Как же раскалывается голова...",
			"Я... жив? Но как я здесь оказался?",
			"Как будто только что проснулся... Всё это было не по-настоящему?",
			"Такого не бывает в жизни, но всё казалось таким реальным...",
			"Что это было? Это явно не могло случиться наяву.",
			"Это был лишь сон... Или я всё-таки пережил это?",
			"Я ведь не мог на самом деле сражаться с этим существом... верно?"
		};
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: %s", messages[random(sizeof(messages))]);
		PlayerPlaySound(playerid, 30802);

		SetPlayerDrunkLevel(playerid, 2500);
		SetTimerEx("ResetHeal", 3000, false, "d", playerid);

		return 1;
	}

	// Запускаем квесты
	if(NoCompleteQuest(playerid, 0)) ShowQwest(playerid, 0); // После реги пройти паспортный контроль
	else StartFirstCallQuest(playerid);

	SetPlayerToTeamColor(playerid); // Меняем цвет над головой

	if(NoCompleteQuest(playerid, 0)) // В инте аэропорта пока не готовы документы
 	{
