		RemovePlayerAttachedObject(playerid,2), PlayerPlaySound(playerid,5600,0,0,0);
		Hand[playerid] = stat;
  		if(stat == 3) SetPlayerAttachedObject(playerid, 2, 2060, 1, 0.076999, -0.155999, 0.000000, 91.999961, 0.000000, 0.000000, 0.610000, 0.649999, 0.664000, 0, 0), ApplyAnimation(playerid,"CARRY","liftup",4.0, false, true, true, false, 0), SetPVarInt(playerid,"oryjtemp", 10); // Мешок с санежцами
	}
	return 1;
}
stock fatigue(playerid, stat)
{
	if(getillness(playerid, 18) >= 0)
	{
		if(PlayerInfo[playerid][pNeon] <= 20)
		{
			if(PlayerInfo[playerid][pMechSkill]-stat <= 0) PlayerInfo[playerid][pMechSkill] = 0;
			else PlayerInfo[playerid][pMechSkill] -= stat;
		}
	}
	else
	{
    	if(PlayerInfo[playerid][pMechSkill]-stat <= 0) PlayerInfo[playerid][pMechSkill] = 0;
		else PlayerInfo[playerid][pMechSkill] -= stat;
	}
}
stock plothome(stat)
{
    if(stat == 0) MoveDynamicObject(plot, 1575.550292, 1404.830688, 1824.109375, 1.0), plot_stat = 0, plot_route = 0;
    else if(stat == 1) MoveDynamicObject(plot, 1586.916625, 1396.665527, 1824.109375, 1.0), plot_stat = 4, plot_route = 1;
	plot_player = -1, plot_time = 0;
}
stock EatPlayer(playerid, eat)
{
	if(eat >= 0)
	{
	    if(PlayerInfo[playerid][pNeon]+eat >= 1000) UpdateHunger(playerid, 1000);
	    else UpdateHunger(playerid, PlayerInfo[playerid][pNeon] + eat);
	}
	else
	{
		if(PlayerInfo[playerid][pNeon]+eat <= 0) UpdateHunger(playerid, 0);
	    else UpdateHunger(playerid, PlayerInfo[playerid][pNeon] + eat);
	}
	return 1;
}

stock UpdateHunger(playerid, hunger)
{
	if (!IsOnline(playerid)) return 0;

	PlayerInfo[playerid][pNeon] = hunger;
	SetPlayerHudHunger(playerid, hunger / 10);
	return 1;
}

stock update_garden(gar)
{
	if(garden_stat[gar] == 0)
	{
		new days, hour, minute, second, unix = gettime();
		getunix(garden_time[gar]+unix+10800, days, hour, minute, second);
		new string[144];
		format(string,sizeof(string),"{ff9000}Яблоневое Дерево\n{FF6347}[ Плоды созреют в %02d:%02d ]",hour,minute);
		UpdateDynamic3DTextLabelText(garden_label[gar],0xA9C4E4FF,string);
	}
	else if(garden_stat[gar] == 1)
	{
		new string[144];
		format(string,sizeof(string),"{ff9000}Яблоневое Дерево\n{99ff66}[ Плодов: %d ]\n{cccccc}[ ALT + Корзинка в руках ]",garden_quan[gar]);
		UpdateDynamic3DTextLabelText(garden_label[gar],0xA9C4E4FF,string);
	}
	return 1;
}
stock load_bagfruit(playerid, fruitid, fquan, stat)
{
	Hold[playerid] = 0, RemovePlayerAttachedObject(playerid,1);

	SetPlayerAttachedObject(playerid, 1, 19637, 6, 0.080999, 0.043999, -0.149000, -106.700027, 0.000000, -10.999998, 1.000000, 1.000000, 1.000000, 0, 0);
	ApplyAnimation(playerid,"CARRY","liftup",4.0, false, true, true, false, 0);
	PPP15[playerid] = 3;

	Hand[playerid] = 5;
	HoldStat[playerid] = fruitid;
	HoldQuan[playerid] = fquan;

	// Собирать яблоки
	CompletingDaily(playerid, 16, fquan);

	if(PlayerInfo[playerid][pSalary] <= 0)
	{
		CreateGps(playerid, -17.0870,66.5641,3.1615, 0, 0, 5.0);
		if(stat >= 1) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Отнесите ящик с яблоками к агнару","*","");
		else if(stat <= 0) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Отнесите ящик с яблоками к агнару\n\n{FF6347}Если что, яблоки в саду закончились","*","");
	}
}
stock allwindow(playerid, v)
{
    GetVehicleParamsCarWindows(v, driver, passenger, backleft, backright);
	if(driver == false || passenger == false || backleft == false || backright == false)
    {
        SetVehicleParamsCarWindows(v, true, true, true, true);
        GameTextForPlayer(playerid, RusToGame("~w~Все Окна ~r~Закрыты"), 3000, 4);
        PlayerPlaySound(playerid, 14405, 0,0,0);
    }
	else if(driver != false || passenger != false || backleft != false || backright != false)
	{
	    SetVehicleParamsCarWindows(v, false, false, false, false);
		GameTextForPlayer(playerid, RusToGame("~w~Все Окна ~g~Открыты"), 3000, 4);
		PlayerPlaySound(playerid, 14404, 0,0,0);
	}
	return 1;
}
