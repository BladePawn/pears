stock stopshop(playerid)
{
	if(Goods[playerid] == 1) DestroyDynamicObject(GoodsObject[playerid]), DestroyDynamic3DTextLabel(GoodsLabel[playerid]);
	else
	{
	    new m = Goods[playerid]-2;
	    MarketStat[m] = 0;
  		SetDynamicObjectMaterialText(MarketDescrip[m], 0, "{444444} ", 130, "Georgia", 27, 1, 0xFFFFFFFF, 0x00000000, 1);
  		UpdateDynamic3DTextLabelText(MarketLabel[m],0xA9C4E4FF,"{cccccc}Арендовать Лавку: /shop - Начать Торговлю {99ff66}[500$]");
	}
	foreach(Player,i)
	{
	    if(OnlineInfo[i][oLogged] == 0) continue;
	    if(OnlineInfo[i][oShowInterface] != 1) continue;
		if(Tabs_Load[i] != 1) continue;
	    if(OnlineInfo[i][oShowTabs] == 9999) continue;
	    if(OnlineInfo[playerid][oShowTabs] == playerid)
	    {
	    	closetab(i, 1), ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Торговля","\n{cccccc}Продавец закрыл торговую лавку\n","Ок","");
	    }
	}
	Goods[playerid] = 0;
	return 1;
}
stock IsAOtherShop(playerid)
{
	new noy;
    foreach(Player, i)
	{
		if(Goods[i] == 0) continue;
   		if(IsPlayerInRangeOfPoint(playerid,6.0, Protect_X[i], Protect_Y[i], Protect_Z[i]))
		{
		    noy = 1;
		    break;
		}
	}
	if(noy == 1)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком близко к другой торговой лавке");
		return 0;
	}
	return 1;
}
stock goshop(playerid)
{
	new Float:x, Float:y, Float:z, Float:a, string[84];
	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);
	if(PlayerInfo[playerid][pShop] > 0)
	{
		x=x+1.5*floatsin(-a,degrees);
 		y=y+1.5*floatcos(-a,degrees);
		GoodsObject[playerid] = CreateDynamicObject(1570, x, y, z+0.230019, 0.000000, 0.000000, a-180.0, 0, 0, -1, 300.00, 300.00);
	}
	format(string,sizeof(string),"Посмотреть Товары [ N >> Лавка ]\n{cccccc}Торговец: %s[%d]", rpplayername(playerid), playerid);
	GoodsLabel[playerid] = CreateDynamic3DTextLabel(string, 0xA9C4E4FF, x, y, z, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID,0,0,0);
	Streamer_Update(playerid);
	PlayerPlaySound(playerid,6401,0,0,0);
	Goods[playerid] = 1;
	return 1;
}
stock stopsellcar(p, v, stat)
{
	new model = VehInfo[v][vModel];
    VehInfo[v][vSellcar] = 0;
	SellVeh[p] = 0;
    DestroyDynamicObject(SellCarObj[0][v]), DestroyDynamicObject(SellCarObj[1][v]), DestroyDynamicObject(SellCarObj[2][v]);

	new string[160];
	if(stat == 0) format(string, sizeof(string), "{cccccc}Транспорт {FF6347}%s {cccccc}снят с продажи",GetVehicleName(model));
	else if(stat == 1) format(string, sizeof(string), "{cccccc}Транспорт {FF6347}%s {cccccc}снят с продажи\n{FF6347}Вы отошли слишком далеко!",GetVehicleName(model));
	else if(stat == 2) format(string, sizeof(string), "{cccccc}Транспорт {FF6347}%s {cccccc}снят с продажи\n{FF6347}Транспорт сдвинулся с точки продажи",GetVehicleName(model));
	ShowDialog(p,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Продажа Транспорта",string,"Ок","");
}
stock stopsky(p)
{
	SkyStat[p] = 0, KillTimer(SkyTimer[p]);
}
function skydive(p)
{
	SkyStat[p] ++;
	if(GetPVarInt(p, "afksystem") >= 3) stopsky(p);
	if(SkyStat[p] <= 5) SetPlayerVelocity(p, 0.0, 0.0, 0.2);
	else if(SkyStat[p] >= 6 && SkyStat[p] <= 10) SetPlayerVelocity(p, 0.0, 0.0, 0.4);
	else if(SkyStat[p] >= 11 && SkyStat[p] <= 15) SetPlayerVelocity(p, 0.0, 0.0, 0.6);
	else if(SkyStat[p] >= 16 && SkyStat[p] <= 20) SetPlayerVelocity(p, 0.0, 0.0, 0.8);
	else if(SkyStat[p] >= 21 && SkyStat[p] <= 25) SetPlayerVelocity(p, 0.0, 0.0, 1.0);
	else if(SkyStat[p] >= 26 && SkyStat[p] <= 30) SetPlayerVelocity(p, 0.0, 0.0, 1.2);
	else SetPlayerVelocity(p, 0.0, 0.0, 2.0);
	if(Protect_Z[p] >= 150.0)
	{
		PlayerPlaySound(p,6401,0,0,0);
		ClearAnimations(p);
		ApplyAnimation(p,"PED","FALL_skyDive",4.2, false, true, true, true, true);
		SetPlayerArmedWeapon(p, WEAPON:46);
		stopsky(p);
	}
	return 1;
}
function call_getref(playerid)
{
	new rows,qwer[124],kol, str[88], sctring[12800], datad1[24], datad2[24], datad[3], datad5;
	new year, month,day;
	getdate(year, month, day);
	cache_get_row_count(rows);
	format(str,sizeof(str),"{cccccc}Имя\t{cccccc}Уровень\t{cccccc}Часов в Игре\t{cccccc}Последняя Активность\n"), strcat(sctring,str);
	for(new i = 0; i < rows; i++)
	{
		cache_get_value_name_int(i, "user_id", datad5);
		cache_get_value_name(i, "Name", datad1, 24);
		cache_get_value_name_int(i, "Level", datad[0]);
		cache_get_value_name_int(i, "ConnectTime", datad[1]);
		cache_get_value_name(i, "Offtime", datad2, 24);
		cache_get_value_name_int(i, "Online", datad[2]);
		if(datad[2] == 0) format(str,sizeof(str),"{cccccc}%s\t%d\t%d\t{444444}%s\n", datad1, datad[0], datad[1], datad2), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}%s\t%d\t%d\t{99ff66}Online\n", datad1, datad[0], datad[1]), strcat(sctring,str);
		kol ++;
		DP[1][playerid] = datad5;
	}
	if(kol >= 1)
	{
		DP[2][playerid] ++;
		if(kol >= 60)
		{
			format(qwer,sizeof(qwer),"{ff9000}Рефералы %d {cccccc}[%02d.%02d.%d] {cccccc}Страница %d",kol,day,month,year, DP[2][playerid]);
			ShowDialog(playerid,1039,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Далее","");
   		}
   		else
   		{
			format(qwer,sizeof(qwer),"{ff9000}Рефералы %d {cccccc}[%02d.%02d.%d] {cccccc}Страница %d",kol,day,month,year, DP[2][playerid]);
			if(ListCode[playerid] == 1) ShowDialog(playerid,949,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Ок","");
			else if(ListCode[playerid] == 2) ShowDialog(playerid,1187,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Ок","");
			else ShowDialog(playerid,1742,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Ок","");
   		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Рефералы не найдены.."), HidePlayerDialog(playerid);
	return 1;
}
function call_deletemap(playerid, g, mapid)
{
	new rows, kol;
	cache_get_row_count(rows);
	for(new f; f<rows; ++f) kol ++;
	if(kol >= 1)
	{
		new string[144];
		mysql_format(pearsq, string,sizeof(string),"DELETE FROM `pp_mapfrak` WHERE `frakid` = '%d' AND `mapid` = '%d' LIMIT 200", g, mapid);
		query_empty(pearsq, string);
		format(string,sizeof(string),"{cccccc}Карта № %d: {FF6347}Очищена\n{cccccc}Количество объектов: {FF6347}%d", mapid, kol);
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Маппинг Организации",string,"*","");
		format(string,sizeof(string),"{FF0000}** {ffffff}%s {FF6347}очистил {00C6FF}карту № %d {FF0000}**",PlayerInfo[playerid][pName],mapid);
  		SendRadioMessage(g, COLOR_GREY, string);
  		OrgLog(g, "delmap", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", mapid, "");
	}
	else
	{
		HidePlayerDialog(playerid);
		SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: На этой карте нет объектов.."), PlayerPlaySound(playerid,4203,0,0,0);
	}
	MysqlRaceMapFrak[g] = 0;
	return 1;
}
function call_loadmap(playerid, g, mapid)
{
	new unixtime = gettime();
	CDMap[g] = unixtime+10;
	new rows, org = g-13, kol, sla, Float:obj_pos[6];
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
		cache_get_value_name_int(f, "slot", sla);
    	cache_get_value_name_int(f, "user", ObjectInfo[org][gUser][sla]);
    	cache_get_value_name_int(f, "model", ObjectInfo[org][gOmodel][sla]);
		cache_get_value_name_float(f, "ox", obj_pos[0]);
		cache_get_value_name_float(f, "oy", obj_pos[1]);
		cache_get_value_name_float(f, "oz", obj_pos[2]);
		cache_get_value_name_float(f, "orx", obj_pos[3]);
		cache_get_value_name_float(f, "ory", obj_pos[4]);
		cache_get_value_name_float(f, "orz", obj_pos[5]);
  		if(ObjectInfo[org][gOmodel][sla] >= 1)
		{
			ObjectInfo[org][gStat][sla] = 1;
			ObjectInfo[org][gObject][sla] = CreateDynamicObject(ObjectInfo[org][gOmodel][sla], obj_pos[0], obj_pos[1], obj_pos[2], obj_pos[3], obj_pos[4], obj_pos[5], 0, 0, -1, 300.00, 300.00);
			kol ++;
		}
	}
	MysqlRaceMapFrak[g] = 0;
	
	if(playerid >= 0)
	{
	    new string[144];
		format(string,sizeof(string),"{cccccc}Карта № %d: {99ff66}Загружена\n{cccccc}Количество объектов: {ff9000}%d", mapid, kol);
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Маппинг Организации",string,"*","");
		OrganInfo[g][gMap] = mapid, OrganInfo[g][gUpdate] = 1;
		format(string,sizeof(string),"{FF0000}** {ffffff}%s {00C6FF}загрузил карту № %d {FF0000}**",PlayerInfo[playerid][pName],mapid);
  		SendRadioMessage(g, COLOR_GREY, string);
  		OrgLog(g, "loadmap", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", mapid, "");
	}
	return 1;
}
stock SaveGuard(g, gur)
{
	new string[184];
	mysql_format(pearsq, string, sizeof(string), "UPDATE `pp_organization` SET `gustat%d`='%d',`gux%d`='%f',`guy%d`='%f',`guz%d`='%f',`guint%d`='%d',`guworld%d`='%d' WHERE `frakid`='%d'",
		gur, OrganInfo[g][gGuardStat][gur], gur, OrganInfo[g][gGu_X][gur], gur, OrganInfo[g][gGu_Y][gur], gur, OrganInfo[g][gGu_Z][gur], gur, OrganInfo[g][gGuInt][gur], gur, OrganInfo[g][gGuWorld][gur], g);
	query_empty(pearsq, string);
	return 1;
}
stock ReloadGuard(g, gur)
{
	if(OrganInfo[g][gGuardStat][gur] >= 1)
	{
		OrganInfo[g][gGuPickup][gur] = CreateDynamicPickup(1239, 1, OrganInfo[g][gGu_X][gur], OrganInfo[g][gGu_Y][gur], OrganInfo[g][gGu_Z][gur],OrganInfo[g][gGuWorld][gur],OrganInfo[g][gGuInt][gur]);
		new str[64],sctring[128];
		format(str,sizeof(str),"%s {cccccc}Пост {ff9000}№ %d\n\n", fraklastName[g], gur+1), strcat(sctring,str);
		format(str,sizeof(str),"{FF6347}Не находится под охраной\n"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}[ /safeguard - занять или покинуть пост ]"), strcat(sctring,str);
		OrganInfo[g][gGuLabel][gur] = CreateDynamic3DTextLabel(sctring,0xFFFFFFFF,OrganInfo[g][gGu_X][gur], OrganInfo[g][gGu_Y][gur], OrganInfo[g][gGu_Z][gur]+0.8,7.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,OrganInfo[g][gGuWorld][gur],OrganInfo[g][gGuInt][gur]);
	}
	return 1;
}
stock UpdateGuard(g, gur)
{
	if(OrganInfo[g][gGuOccup][gur] >= 1)
	{
		new str[64],sctring[960];
		format(str,sizeof(str),"%s {cccccc}Пост {ff9000}№ %d\n\n", fraklastName[g], gur+1), strcat(sctring,str);
		format(str,sizeof(str),"{99ff66}Под охраной:\n"), strcat(sctring,str);
		foreach(Player,i)
		{
	    	if(OnlineInfo[i][oLogged] == 1 && GuardOrg[i] == g && Guard[i] >= 1 && Guard[i]-1 == gur) format(str,sizeof(str),"{cccccc}%s[%d]\n", PlayerInfo[i][pName], i), strcat(sctring,str);
		}
		format(str,sizeof(str),"\n{444444}[ /safeguard - занять или покинуть пост ]"), strcat(sctring,str);
		UpdateDynamic3DTextLabelText(OrganInfo[g][gGuLabel][gur],0xFFFFFFFF,sctring);
	}
	else
	{
		new str[64],sctring[128];
		format(str,sizeof(str),"{cccccc}Пост {ff9000}№ %d\n\n",gur+1), strcat(sctring,str);
		format(str,sizeof(str),"{FF6347}Не находится под охраной\n"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}[ /safeguard - занять или покинуть пост ]"), strcat(sctring,str);
		UpdateDynamic3DTextLabelText(OrganInfo[g][gGuLabel][gur],0xFFFFFFFF,sctring);
	}
	return 1;
}
stock burn_vampire(playerid, stat)
{
	if(stat == 0 && vampire[playerid] == 1) RemovePlayerAttachedObject(playerid, 0), vampire[playerid] = 0;
	else if(stat == 1 && vampire[playerid] == 0 && PlayerInfo[playerid][pSunScreen] <= 0)
	{
	    if(Pogoda != 4 && Pogoda != 7 && Pogoda != 8 && Pogoda != 9 && ADUTY[playerid] == 0 && MPGO[playerid] == 0 && gSkafandr[playerid] == 0 && gFormavvs[playerid] == 0)
		{
		    new hours, minuite, second;
			gettime(hours,minuite,second);
			if(hours >= 6 && hours <= 21 && getillness(playerid, 18) >= 0)
			{
				vampire[playerid] = 1, SetPlayerAttachedObject(playerid, 0, 18726, 1, -2.033999, 0.000000, -0.203000, 0.000000, 86.199981, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
			}
		}
	}
	return 1;
}

stock OnPlayerVirtualWorldChange(playerid, newworld, oldworld, interiorid = -1)
{
	if(newworld >= 1 && oldworld == 0) burn_vampire(playerid, 0);
	if(oldworld >= 1 && newworld == 0) burn_vampire(playerid, 1);
	if (interiorid == 0) {
		new myint = GetPlayerInterior(playerid);
		foreach(Player, i)
		{
			if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && gSpectateID[i] == playerid && noclipdata[i][cameramode] == CAMERA_MODE_NONE 
			&& OnlineInfo[i][oLogged] == 1
			&& !IsPlayerAfk(i))
			{
				S_SetPlayerVirtualWorld(i, newworld);
				PPSetPlayerInterior(i, myint);
			}
		}
		ChangeWeather(playerid, newworld, myint);
		ChangeTime(playerid, newworld, myint);

		if(zones_coldstat[playerid] > 0) Streamer_SetIntData(STREAMER_TYPE_AREA, zones_cold[playerid], E_STREAMER_WORLD_ID, newworld); // Обновляем id вирт мира зоны заражения
	}

	PDatabase_OnPlayerVirtualWorldChange(playerid, newworld, oldworld);
	
	return 1;
}

stock S_SetPlayerVirtualWorld(playerid, world, interiorid = -1)
{
	// OnPlayerVirtualWorldChange callback
	new oldworld = GetPlayerVirtualWorld(playerid);
	if (world != oldworld) {
		OnPlayerVirtualWorldChange(playerid, world, oldworld, interiorid);
	}

	if(GetPlayerVirtualWorld(playerid) == 0)
	{
		new Float:x,Float:y,Float:z;
		GetPlayerPos(playerid,x,y,z);
		WhiteFindPlayerPos(playerid,x,y,z);
	}

	OnlineInfo[playerid][oWorldPlayer] = world;
    SetPlayerVirtualWorld(playerid, world);
	return 1;
}

stock PPSetPlayerInterior(playerid, interior, bool:updateLastUpdate = true)
{
	OnlineInfo[playerid][oInteriorPlayer] = interior;
	if(updateLastUpdate == true) 
	{
		new maxTime = 6;
		if(gettime() < OnlineInfo[playerid][oLoggedUnix] + 20) maxTime = 20;

		OnlineInfo[playerid][oInteriorChange] = true;
		OnlineInfo[playerid][oInteriorTime] = maxTime;
	}
	SetPlayerInterior(playerid, interior);
	SetTimerEx("EmulatePlayerInteriorChange", 1500, false, "dd", playerid, interior);
	return 1;
}

function EmulatePlayerInteriorChange(playerid, interior)
{
	if (!IsPlayerConnected(playerid)) return false;
	new BitStream:bs = BS_New();
	BS_WriteUint8(bs, interior);
	new res = PR_EmulateIncomingRPC(bs, playerid, 118);
	BS_Delete(bs);
	return res;
}

public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
	// Защита от подмены интерьера
	if(newinteriorid != OnlineInfo[playerid][oInteriorPlayer]) PPSetPlayerInterior(playerid, OnlineInfo[playerid][oInteriorPlayer], false);
	
	if(newinteriorid >= 1 && oldinteriorid == 0) burn_vampire(playerid, 0);
	if(oldinteriorid >= 1 && newinteriorid == 0) burn_vampire(playerid, 1);
	new myworld = GetPlayerVirtualWorld(playerid);
	foreach(Player, i)
	{
		if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && gSpectateID[i] == playerid && noclipdata[i][cameramode] == CAMERA_MODE_NONE 
			&& OnlineInfo[i][oLogged] == 1
			&& !IsPlayerAfk(i))
 		{
 		    S_SetPlayerVirtualWorld(i, myworld);
  			PPSetPlayerInterior(i, newinteriorid);
  		}
	}
	ChangeWeather(playerid, myworld, newinteriorid);
	ChangeTime(playerid, myworld, newinteriorid);
	if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
	{
		// Офаем гравитацию на лунеOnVehicleDamageStatusUpdate
	    if(oldinteriorid == 221 || oldinteriorid == 222)
		{
		    SetPlayerGravity(playerid, 0.01);
	 	}

		// Графитация на луне
		if(newinteriorid == 221 && myworld == 221 || 
			newinteriorid == 221 && myworld >= COMPUTER_CLUB_MIN_WORLD && myworld <= COMPUTER_CLUB_MAX_WORLD)
		{
		    SetPlayerGravity(playerid, 0.0020);
	 	}
 	}
 	if(zones_coldstat[playerid] > 0) Streamer_SetIntData(STREAMER_TYPE_AREA, zones_cold[playerid], E_STREAMER_INTERIOR_ID, newinteriorid); // Обновляем id интерьера зоны заражения
	return 1;
}

public OnPlayerKeyStateChange(playerid, KEY:newkeys, KEY:oldkeys)
{
	if(OnlineInfo[playerid][oLogged] == 0) // Если игрок не залогинился, блокируем все кнопки
	{
		return 0;
	}

	if(DeathInfo[playerid][deathStatus]) // Игрок мертвый лежит на земле - обрабатываем только необходимые кнопки
	{
		return DeathOnKeyStateChange(playerid, newkeys, oldkeys);
	}

	if(knoper > 0)
	{
		new stru[64];
	 	format(stru,64,"newkeys: %d, oldkeys: %d",newkeys, oldkeys);
	  	SendClientMessage(playerid,-1,stru);
  	}

	// Блокировка бага зажимания пробела или шифта при присаживании в авто
	if((newkeys == KEY_SPRINT || newkeys == KEY_JUMP) 
		&& EnteringVehicle[playerid] 
		&& GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
    {
        //ClearAnimations(playerid);
        EnteringVehicle[playerid] = false;
    }

	if(newkeys == KEY_SUBMISSION) // Кнопка 2
    {
    	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vid = GetPlayerVehicleID(playerid);
            if(!IsAShassi(VehInfo[vid][vModel])) pc_cmd_engine(playerid);
   		}
    }

	if(newkeys == KEY_YES) // Кнопка Y
    {
    	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
            new vid = GetPlayerVehicleID(playerid);
            if(IsAShassi(VehInfo[vid][vModel])) return pc_cmd_engine(playerid);
    	}
		if (NarcoFarm_OnPlayerPressY(playerid)) return true;
	}

	if(newkeys == KEY_FIRE) // Кнопка ALT или ЛКМ в Транспорте
	{	
	  	// ALT в Транспорте
   		if(IsPlayerInAnyVehicle(playerid) && setting_pos_draw[playerid] == 0 && setting_size_draw[playerid] == 0)
		{
			// Пьем из бокала
			if(Hold[playerid] == 2 || Hold[playerid] == 3)
			{
			    new current_tick = GetTickCount();
				new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
				if(interval > 2000) godrink(playerid), Aftextdraw[playerid] = current_tick;
				return 1;
			}
			
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
   			{
   			    new v = GetPlayerVehicleID(playerid);
   			    if(VehInfo[v][vModel] != 407 && VehInfo[v][vModel] != 425 && VehInfo[v][vModel] != 430&& VehInfo[v][vModel] != 432 && VehInfo[v][vModel] != 447 && VehInfo[v][vModel] != 476 && VehInfo[v][vModel] != 520
			   	&& VehInfo[v][vModel] != 568 && VehInfo[v][vModel] != 601
			   	&& (IsACar(VehInfo[v][vModel]) || IsAMoto(VehInfo[v][vModel]) || IsAPlane(VehInfo[v][vModel]) || IsABoat(VehInfo[v][vModel])))
   			    {
   			    	DP[0][playerid] = v;
					PlayerPlaySound(playerid,40405,0,0,0), automobile(playerid);
					return 1;
				}
			}
			else if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
			{
				if(!IsWeaponUsableInVehicle(GetPlayerWeapon(playerid))) return SetPlayerArmedWeapon(playerid, WEAPON:0);
				pc_cmd_window(playerid);
				return 1;
			}
		}
	}

	if(VehShopInfo[playerid][vsTest]) // Если игрок в Test Drive
	{
		if(newkeys == KEY_NO) 
		{
			closeTestDrive(playerid);
		}
		return 0;
	}

	// Если игрок в компьютерном клубе
	if(computerClubPlayerInfo[playerid][ccpiInGame] == true)
	{
		if(newkeys == KEY_NO) return ShowComputerClubMenu(playerid);
		return 0;
	}

	if (Obstacle_OnKeyStateChange(playerid, newkeys, oldkeys)) return 1;
	MineWar_OnKeyStateChange(playerid, newkeys, oldkeys);
	Tomb_OnKeyStateChange(playerid, newkeys, oldkeys);

	if(MenuInfo[playerid][zStat] == 1) // Редактор текстур
	{
		new current_tick = GetTickCount();
		new interval = GetTickDiff(current_tick, Afclick[playerid]);
		if(interval < 100) return 0;

		if(newkeys == KEY_YES) Go3DBox(playerid, 0); // KEY_YES UP
		else if(newkeys == KEY_NO) Go3DBox(playerid, 1); // KEY_YES DOWN

		if(interval < 200) return 0;
		else if(newkeys == KEY_ANALOG_LEFT) Back3DBox(playerid); // NUM 4 BACK
		else if(newkeys == KEY_ANALOG_RIGHT) Next3DBox(playerid); // NUM 6 NEXT

		else if(newkeys == KEY:KEY_RIGHT) 
		{
			SelectColorDraw(playerid); // Возвращаем кликабельность текстдравов
			ShowDraw3DMenu(playerid);
		}

		else if(newkeys == KEY_WALK) ApplyTextureObject(playerid); // Применяем выбранную текстуру

		Afclick[playerid] = current_tick;
		return 0;
	}

	// Сидим во FlyCam
	if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY && noclipdata[playerid][vehicleAttach] == 0)
	{
		if(newkeys == KEY_ANALOG_LEFT) SubtractFlycamSpeed(playerid);
		else if(newkeys == KEY_ANALOG_RIGHT) FoldFlycamSpeed(playerid);
		else if(newkeys == KEY:KEY_FIRE) ResetFlycamSpeed(playerid);
		else if(newkeys == KEY_HANDBRAKE) SavePositionFlyCam(playerid);
		return true;
	}

  	if(newkeys == KEY_YES) // Кнопка Y
    {
    	if(Dei[playerid] == 9)
        {
    		new v = IsATrashBoot(playerid);
			if(v > 0)
			{
				if(VehInfo[v][vJob] == 8 && VehInfo[v][vJobStat] > 0) return ErrorMessage(playerid, "{FF6347}Этот мусоровоз занят");
				if(VehInfo[v][vProcess] >= 10) return ErrorMessage(playerid, "{FF6347}В мусоровозе нет места. Его необходимо разгрузить на базе");
				put_boottrash(playerid, v);
			}
			else return ErrorMessage(playerid, "{FF6347}Вы далеко от мусоровоза, чтобы погрузить контейнер");
			return 1;
		}
		if(Dei[playerid] == 10)
        {
    		new v = IsATrashBoot(playerid);
			if(v > 0)
			{
				if(VehInfo[v][vJob] != 8) return ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}*","{FF6347}В этом мусоровозе нет контейнера","*","");
				if(VehInfo[v][vJobStat] != 2) return ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}*","{FF6347}Подождите.. Контейнер ещё не очищен от мусора","*","");
				get_boottrash(playerid, v);
			}
			else return ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}*","{FF6347}Вы далеко от мусоровоза, чтобы забрать контейнер","*","");
			return 1;
		}
        if(OnlineInfo[playerid][oInHandThing][0] > 0 && (OnlineInfo[playerid][oInHandThing][5] == 2 || OnlineInfo[playerid][oInHandThing][5] == 4))
        {
    		new v = IsAPosBoot(playerid);
			if(v > 0) put_bootbox(playerid, v);
			return 1;
		}
		if(Dei[playerid] == 21)
		{
			if(IsOnline(DeiStat[playerid]))
			{
				if(DeiStat[playerid] != INVALID_PLAYER_ID)
				{
					if (ProxDetectorS(1.5, playerid, DeiStat[playerid]))
					{
						if(GetPlayerState(DeiStat[playerid]) == PLAYER_STATE_SPECTATING && gSpectateID[DeiStat[playerid]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
						PlayerPlaySound(DeiStat[playerid],40405,0,0,0);
						SetPlayerChatBubble(playerid,"дунул в алкотестер",COLOR_PURPLE,20.0,3000);

						new str[100],sctring[700];
						format(str,sizeof(str),"%s дунул в алкотестер: ", playername(playerid));
						strcat(sctring,str);
						if(EffectTime[playerid] <= 0)
						{
							format(str,sizeof(str),"Ничем не пахнет и он абсолютно адекватен.");
						}
						if(EffectTime[playerid] >= 1 && EffectTime[playerid] <= 60)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"От него чем-то пахнет, кажется он немного выпил {ff9000}[ 1/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет");
						}
						else if(EffectTime[playerid] >= 61 && EffectTime[playerid] <= 120)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"Пахнет алкоголем, явно выпил [ 2/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет");
						}
						else if(EffectTime[playerid] >= 121 && EffectTime[playerid] <= 200)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"Пахнет алкоголем, явно выпил [ 3/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет. Но ведёт себя подозрительно");
						}
						else if(EffectTime[playerid] >= 201 && EffectTime[playerid] <= 300)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"Сильно пахнет алкоголем, явно выпил [ 4/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет. Но ведёт себя странно");
						}
						else if(EffectTime[playerid] >= 301 && EffectTime[playerid] <= 600)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"Запах алкоголя, он явно пьян [ 5/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет. Но ведёт себя странно");
						}
						else if(EffectTime[playerid] >= 601 && EffectTime[playerid] <= 1200)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"Смердящий запах алкоголя, сильно пьян [ 6/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет. Кажется, принял вещества");
						}
						else if(EffectTime[playerid] >= 1201)
						{
							if(Effect[playerid] == 5)format(str,sizeof(str),"Да тут и без запаха понятно, что он сильно пьян [ 7/7 ]");
							else format(str,sizeof(str),"Ничем не пахнет. Явно он под веществами");
						}
						strcat(sctring,str);
						SendClientMessage(DeiStat[playerid], COLOR_GREY, "[ Мысли ]: %s", sctring);
					}
					else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
				}
			}
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");Dei[playerid] = 0, DeiStat[playerid] = 0;
			return 1;
		}
		if(Dei[playerid] == 8) return pc_cmd_fillcar(playerid);
		if(Dei[playerid] == 12) return pc_cmd_fillcar(playerid);
    	if(Dei[playerid] == 6) return pc_cmd_showmed(playerid);
    	if(InputID[playerid] >= 1) return Input(playerid, 1);
    	ShowSmartfon(playerid);
	}
	//if(newkeys == KEY:131200) // ПКМ + N
	if(newkeys == KEY:1152) // ПКМ + ALT
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
			new targetplayer = GetPlayerTargetPlayer(playerid);
			new targetBot = GetPlayerTargetDynamicActor(playerid);
			if(targetplayer != INVALID_PLAYER_ID)
			{
				if(IsOnline(targetplayer) && !IsARealNPC(targetplayer))
				{
		 			if(ProxDetectorS(2.0, playerid, targetplayer)) show_interaction(playerid, targetplayer);
 				}
			}
			else
			{
				if(IsValidDynamicActor(targetBot) && Streamer_HasIntData(STREAMER_TYPE_ACTOR, targetBot, STREAMER_ACTOR_PLAYER_ID))
				{
					new giveplayerid = Streamer_GetIntData(STREAMER_TYPE_ACTOR, targetBot, STREAMER_ACTOR_PLAYER_ID);
					if(IsOnline(giveplayerid)) Moiactor[playerid] = targetBot, show_interaction(playerid, giveplayerid);
				}
			}
		}
	}
	
  	if(newkeys == KEY_NO) // Кнопка N
	{
		if(Dei[playerid] == 6) return pc_cmd_remove(playerid);
		if(Dei[playerid] == 21)
		{
			if(DeiStat[playerid] != INVALID_PLAYER_ID && IsOnline(DeiStat[playerid]))
			{
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я %s проходить тест на алкоголь", PlayerInfo[playerid][pSex] ? "отказался" : "отказалась");
				SendClientMessage(DeiStat[playerid], COLOR_GREY, "[ Мысли ]: %s %s проходить тест на алкоголь!", PlayerInfo[playerid][pName], PlayerInfo[playerid][pSex] ? "отказался" : "отказалась");
				Dei[playerid] = 0;
				DeiStat[playerid] = 0;
				return 1;
			}
		}
		if(InputID[playerid] >= 1) return Input(playerid, 3);
		if(gSpectateID[playerid] == INVALID_PLAYER_ID)
		{
			if(OnlineInfo[playerid][oShowInterface] == 0 && OverHear[playerid] == 0) ShowFrisk2(playerid, playerid);
		}
	}
	// Запрет на Прыжки
	if(newkeys & KEY_JUMP
	|| newkeys & KEY_JUMP && newkeys & KEY_HANDBRAKE || newkeys & KEY_JUMP && newkeys & KEY_WALK
	|| newkeys & KEY_JUMP && newkeys & KEY_SPRINT || newkeys & KEY_JUMP && newkeys & KEY_ACTION
	|| newkeys & KEY_JUMP && newkeys & KEY_FIRE || newkeys & KEY_JUMP && newkeys & KEY_CROUCH
	|| newkeys & KEY_JUMP && newkeys & KEY_YES  || newkeys & KEY_JUMP && newkeys & KEY_ANALOG_LEFT
	|| newkeys & KEY_JUMP && newkeys & KEY_SECONDARY_ATTACK || newkeys & KEY_JUMP && newkeys & KEY_ANALOG_RIGHT)
	{
		if(GetPlayerVirtualWorld(playerid) == 2001 
			|| Dei[playerid] == 9 
			|| Dei[playerid] == 11 
			|| Hold[playerid] == 8 || Hand[playerid] == 5
			|| Stun[4][playerid] >= 1)
		{
			if(!IsPlayerInAnyVehicle(playerid)) 
			{
				ClearAnimations(playerid);
				//ApplyAnimation(playerid,"FAT","IDLE_tire­d",2.0, false, false, false, false, false);
				return 1;
			}
		}
	}
  	if(newkeys == KEY:16) // Кнопка F/Enter
	{
		// Прекращаем писать
		if(ClosePiss(playerid)) return true;

		// Окно в поезде
		if(IsPlayerInRangeOfPoint(playerid,1.5,1305.7756,1604.4343,19.7263) && GetPlayerVirtualWorld(playerid) == 180 && GetPlayerInterior(playerid) == 179) return OpenWindowTrain(playerid);

		// Выход из Spec Train
		if(OnlineInfo[playerid][oWindowTrain] > 0) return ExitWindowTrain(playerid);

	    // Сохраняем положение текстдравов
	    if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return exit_textdraw(playerid, 1);
	    
	    // Сбрасываем Анимку
		if(GetPVarInt(playerid,"AnimSet") == 1) return pc_cmd_stopanimka(playerid);
		
		// Покидаем стол для игры в карты
		if((SitPlayer[playerid] >= 1 || playerSeat[playerid]) && OverHear[playerid] == 0)
		{
		    new sitid = SitPlayer[playerid]-1;
		    if(sitid >= 18 && sitid <= 77) return ShowDialog(playerid,1199,DIALOG_STYLE_MSGBOX,"{ff9000}Казино","{FF6347}Вы уверены, что хотите покинуть игровой стол?","Да","Нет");
			else exitsit(playerid, 1);
		}
		
		// Ставим предмет на стол
		check_put_on(playerid);
		
		// Выход из-за стола казино рулетка
		if(GetPVarInt(playerid,"kas") == 5) ExitKasino3(playerid);
	}
	
	if(newkeys == KEY:KEY_CTRL_BACK) // Кнопка H
	{
		// Взлом базы данных (1 этап)
		if (policeDatabasePlayerInfo[playerid][pdpiHackStage] == POLICE_DATABASE_HACK_STAGE_GAME) PDatabase_Hack_Pump(playerid);

		// Быстрый выход из лабиринта на кнопку H
		if(IsPlayerInRangeOfPoint(playerid,300.0,1414.7758,1612.1810,10.8503) 
			&& GetPlayerInterior(playerid) == 226 && GetPlayerVirtualWorld(playerid) == 226) return ExitLabirint(playerid);
		
		if(OnlineInfo[playerid][oUnixAcceptWanted] > 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && NoAnim[playerid] == 0) return AcceptWanted(playerid);
		if(InputID[playerid] >= 1) return Input(playerid, 2);
 		pc_cmd_pc(playerid);
 		if(Device[playerid] == 1) PKM_or_H(playerid);
	}
	if(newkeys == KEY:1032) // Пробел + Alt
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerSpeed(playerid) <= 2) return ShowAnimation(playerid,AnimInfo[0][playerid], 1);
	}
	if(newkeys == KEY:136) // Пробел + П.К.М.
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerSpeed(playerid) <= 2) return ShowAnimation(playerid,AnimInfo[1][playerid], 1);
	}
	if(newkeys == KEY:10) // Пробел + C
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerSpeed(playerid) <= 2) return ShowAnimation(playerid,AnimInfo[2][playerid], 1);
	}
	if(newkeys == KEY:131080) // Пробел + N
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerSpeed(playerid) <= 2) return ShowAnimation(playerid,AnimInfo[3][playerid], 1);
	}
	if(newkeys == KEY:9) // Пробел + /
	{
