	case 1304:
	{
		new cam = ListID[playerid];
		if(response)
		{
			if(BusStationInfo[cam][bsActive] == 0) return ErrorText(playerid,"[ Мысли ]: Остановки не существует"), pc_cmd_busstop(playerid);
			if(!strlen(inputtext)) return pc_cmd_busstop(playerid);
			if(strlen(inputtext) < 3 || strlen(inputtext) > 20) return ErrorText(playerid, "[ Мысли ]: Не меньше 3 и не больше 30 символов"), pc_cmd_busstop(playerid);
           	if(checksimvol(inputtext)) return ErrorText(playerid, "[ Мысли ]: Хм... я пытаюсь указать в названии какие-то каракули... [ Запрещённый Символ ]"), pc_cmd_busstop(playerid);

			format(string,sizeof(string),"[ Мысли ]: Остановка %s переименована {ff9000}[ %s ]", BusStationInfo[cam][bsName], inputtext);
			SendClientMessage(playerid, COLOR_GREY, string);
			strmid(BusStationInfo[cam][bsName], inputtext, 0, strlen(inputtext), 24);
			UpdateBusStation(cam);
			showDialogMenuBusStation(playerid, cam);
		}
		else showDialogMenuBusStation(playerid, cam);
	}
	case 1305:
	{
		new cam = ListID[playerid];
		if(response)
		{
			if(BusStationInfo[cam][bsActive] == 0) return ErrorText(playerid,"[ Мысли ]: Остановки не существует"), pc_cmd_busstop(playerid);
			DestroyObjectsBusStation(cam);
			DestroyDynamic3DTextLabel(busstation_label[cam]);
			DestroyDynamicPickup(busstation_pickup[cam]);
			BusStationInfo[cam][bsActive] = 0;
			bsrows --;
			new f_str[120];
			mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_busstation` WHERE `idbusstation` = '%d'",BusStationInfo[cam][idbusstation]);
			mysql_tquery(pearsq, f_str, "Call_DelBusStation", "d", cam);
			PlayerPlaySound(playerid,6801,0,0,0);
			format(string,sizeof(string),"[ Мысли ]: Остановка %s {FF6347}удалена", BusStationInfo[cam][bsName]), SendClientMessage(playerid, COLOR_GREY, string);
			pc_cmd_busstop(playerid);
		}
		else showDialogMenuBusStation(playerid, cam);
	}

	// Кодекс правонарушений (Уголовный, административный)
	case 1306: // Основное меню
	{
		if(response)
		{
			if(DP[4][playerid] == 0) // Открываем меню через команду /yk (для настройки и просмотра)
			{
				if(listitem == 0)
				{
					new i = GetFreeArcticle();
					if(i == -1) return ErrorMessage(playerid, "{FF6347}Нет свободных слотов для добавления новой статьи");
					DP[0][playerid] = i;
					DP[2][playerid] = 0;
					CriminalCodeSetting(playerid, DP[0][playerid], DP[2][playerid]);
					return 1;
				}

				else if(listitem >= 1 && listitem <= OnlineInfo[playerid][oDialogMenu][0]) // Отображаемые List
				{
					DP[0][playerid] = List[listitem - 1][playerid];
					DP[2][playerid] = ListParam[listitem - 1][playerid];
					CriminalCodeSetting(playerid, DP[0][playerid], DP[2][playerid]);
				}
				else if(listitem == OnlineInfo[playerid][oDialogMenu][0] + 1) CriminalCodeMenu(playerid, DP[4][playerid], OnlineInfo[playerid][oDialogMenu][1] + 1);
			}
			else // Открываем меню через /su (для выдачи розыска)
			{
				if(listitem >= 0 && listitem < OnlineInfo[playerid][oDialogMenu][0]) // Отображаемые List
				{
					new i = List[listitem][playerid];
					new p = ListParam[listitem][playerid];
					new targetplayer = DP[3][playerid];
					SetPlayerCriminal(targetplayer, playerid, CriminalCodeInfo[i][p][ccName], CriminalCodeInfo[i][p][ccLevel], i, p);
				}
				else if(listitem == OnlineInfo[playerid][oDialogMenu][0]) CriminalCodeMenu(playerid, DP[4][playerid], OnlineInfo[playerid][oDialogMenu][1] + 1);
			}
		}
	}

	case 1307: // Редактор кодекса
	{
		if(response)
		{
			new i = DP[0][playerid];
			new p = DP[2][playerid];
			if(listitem == 0) 
			{
				if(CriminalCodeInfo[i][p][ccStatus] == false) CriminalCodeInfo[i][p][ccStatus] = true;
				else CriminalCodeInfo[i][p][ccStatus] = false;
				CriminalCodeSetting(playerid, i, p);
				CriminalCodeSave(i, p);
			}
			if(listitem == 1) // Номер
			{
				new line[120],lines[240];
				format(line,sizeof(line),"{cccccc}Введите номер статьи {ff9000}[1 - %d]", MAX_CRIMINAL_CODE_ARTICLE), strcat(lines,line);
				format(line,sizeof(line),"\n{555555}Вы можете использовать неполное число для указания подстатьи [ Пример 1.2 ]"), strcat(lines,line);
				ShowDialog(playerid,1310,DIALOG_STYLE_INPUT,"{ff9000}Кодекс Правонарушений",lines,"Принять","Отмена");
			}
			if(listitem == 2) // Название
			{
				ShowDialog(playerid,1311,DIALOG_STYLE_INPUT,"{ff9000}Кодекс Правонарушений","{cccccc}Введите название статьи [1 - 30 символа]","Принять","Отмена");
			}
			if(listitem == 3) // Розыск
			{
				ShowDialog(playerid,1312,DIALOG_STYLE_INPUT,"{ff9000}Кодекс Правонарушений","{cccccc}Введите уровень розыска статьи [0 - 10]","Принять","Отмена");
			}
			if(listitem == 4) // Штраф
			{
				ShowDialog(playerid,1313,DIALOG_STYLE_INPUT,"{ff9000}Кодекс Правонарушений","{cccccc}Введите размер штрафа статьи [0$ - 1.000.000$]","Принять","Отмена");
			}
			if(listitem == 5) // Текст
			{
				new line[120],lines[240];
				format(line,sizeof(line),"{cccccc}Введите развёрнутое описание статьи {ff9000}[1 - 120 символов]"), strcat(lines,line);
				format(line,sizeof(line),"\n{555555}Используйте символ в тексте для переноса на следующую строку ( \\n )"), strcat(lines,line);
				ShowDialog(playerid,1314,DIALOG_STYLE_INPUT,"{ff9000}Кодекс Правонарушений",lines,"Принять","Отмена");
			}
			if(listitem == 6) ShowDialogCriminalCodeInfo(playerid, i, p); // Описание >>
			if(listitem == 7) // Добавление подстатьи
			{
				if(p == 0) // Добавление подстатьи выполняется только из главной статьи
				{
					new pi = GetFreeSubentry(i);
					if(pi == -1) return ErrorMessage(playerid, "{FF6347}Нет свободных слотов для добавления новой подстатьи");

					DP[2][playerid] = pi;
					CriminalCodeSetting(playerid, i, pi);
				}
			}
		}
		else CriminalCodeMenu(playerid, 0, OnlineInfo[playerid][oDialogMenu][1]);
	}
