						SetPlayerWorldBounds(giveplayerid, 20000.0000,-20000.0000,20000.0000,-20000.0000);
						mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `JailTime` = '3' WHERE `Name` = '%e'", str_name);
          				query_empty(pearsq, f_str);
					}
					DestroyPursuit(giveplayerid);
	 			}
	 			else
	 			{
	 				new datad1, datad2;
	 				cache_get_value_name_int(0, "Crimes", datad1);
	 				cache_get_value_name_int(0, "Jailed", datad2);
	 				if(datad1 == 0 && datad2 == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет розыска..");
	 				if(datad1 >= 1)
          			{
		 				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Crimes` = '0' WHERE `Name` = '%e'", str_name);
	          			query_empty(pearsq, f_str);
    				}
          			if(datad2 >= 1)
          			{
						mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `JailTime` = '3' WHERE `Name` = '%e'", str_name);
          				query_empty(pearsq, f_str);
					}
   				}
          		atext = "Розыск";*/
	 		}
	 		case 8:
	 		{
	 			new amount = Leadset[playerid];
	 			if(IsOnline(giveplayerid))
	 			{
	 				if(PlayerInfo[giveplayerid][pAmmos11] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет штрафов..");
	 				if(PlayerInfo[giveplayerid][pAmmos11] >= 1)
          			{
		 				if(PlayerInfo[giveplayerid][pAmmos11]-amount >= 0)PlayerInfo[giveplayerid][pAmmos11] -= amount;
		 				else PlayerInfo[giveplayerid][pAmmos11] = 0;
		 				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Ammo11` = '%d' WHERE `Name` = '%e'", PlayerInfo[giveplayerid][pAmmos11], str_name);
	          			query_empty(pearsq, f_str);
    				}
	 			}
	 			else
	 			{
	 				new datad1;
	 				cache_get_value_name_int(0, "Ammo11", datad1);
	 				if(datad1 == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет штрафов..");
	 				if(datad1 >= 1)
          			{
		 				if(datad1 -amount >= 0)datad1 -= amount;
		 				else datad1 = 0;
		 				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Ammo11` = '%d' WHERE `Name` = '%e'", datad1, str_name);
	          			query_empty(pearsq, f_str);
    				}
   				}
          		atext = "Штраф";
	 		}
	 		case 9:
	 		{
	 			if(IsOnline(giveplayerid))
	 			{
	 				if(get_invent2(giveplayerid, 156, 0) >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока есть водительские права..");
                    if(CheckInvent(giveplayerid)) return ErrorMessage(playerid, "{FF6347}У игрока нет места в инвентаре");
					else GiveThingPlayer(giveplayerid, 156, 1, PlayerInfo[giveplayerid][pID], 0, 0, 0, 9999);
	 			}
	 			else return ErrorMessage(playerid, "{FF6347}Нельзя отменить лишение водительских прав Offline игроку");
          		atext = "Лишение Водительских Прав";
	 		}
	 		case 10:
	 		{
	 			new datad1;
	 			cache_get_value_name_int(0, "Banned", datad1);
	 			if(datad1 == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет бана..");
	 			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Banned` = '1' WHERE `Name` = '%e'", str_name);
          		query_empty(pearsq, f_str);
          		atext = "DELACC";
          		if(IsOnline(giveplayerid))  PlayerInfo[giveplayerid][pBanned] = 1;
	 		}
	 		default: {return 1;}
		}
		if(cod >= 7)
		{
			format(string,sizeof(string),"Вы отменили действие по отношению к игроку {cccccc}%s {FF6347}[%s]",str_name,atext);
	  		SendClientMessage(playerid,COLOR_LIGHTRED,string);
	  		HidePlayerDialog(playerid);
	  		format(string,sizeof(string),"Отменён %s",atext);
	  		AdminLog("wrong", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", cod, string);
			PlayerPlaySound(playerid,30802,0,0,0);
			if(IsOnline(giveplayerid))
		  	{
		  		if(OnlineInfo[giveplayerid][oLogged] == 1)
		  		{
			  		format(string, sizeof(string), "Администратор %s отменил действие полицеского в вашу сторону [ %s ]", PlayerInfo[playerid][pName], atext);
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, "Возможно это была ошибка или аккаунт полицейского взломали..");
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, "Но мы всё исправили ради вас ;*");
				}
			}
		}
		else if(cod <= 6)
		{
			format(string, sizeof(string), "[PP]: %s отменил наказание игрока %s [%s]",PlayerInfo[playerid][pName],str_name,atext);
	 		AllMessage(COLOR_LIGHTRED, string);
	  		format(string,sizeof(string),"Вы отменили наказание {cccccc}%s {FF6347}[%s]",str_name,atext);
	  		SendClientMessage(playerid,COLOR_LIGHTRED,string);
	  		HidePlayerDialog(playerid);
	  		format(string,sizeof(string),"Отменён %s",atext);
	  		AdminLog("wrong", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", cod, string);
		  	pc_cmd_wrong(playerid, "");
		  	PlayerPlaySound(playerid,30802,0,0,0);
		  	if(IsOnline(giveplayerid))
		  	{
		  		if(OnlineInfo[giveplayerid][oLogged] == 1)
		  		{
			  		format(string, sizeof(string), "Администратор %s отменил своё действие в вашу сторону [ %s ]", PlayerInfo[playerid][pName], atext);
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, "Возможно это была ошибка, но мы всё исправили.");
					SendClientMessage(giveplayerid, COLOR_LIGHTRED, "Руководство сервера приносит свои извинения.");
				}
			}
		}
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
forward insert_work(playerid,today,action);
public insert_work(playerid,today,action)
{
	new her;
	cache_get_row_count(her);
	if(her)
	{
		new atext[24],f_str[184],datad1;
		switch(action)
		{
	 		case 0:{ atext = "online"; } // Чистый Онлайн
	 		case 1:{ atext = "afk"; } // Время в AFK
	 		case 2:{ atext = "sleep"; } // Время в RP Сне
	 		case 3:{ atext = "activity"; } // Количество запросов в репорт, пока админ в чистом онлайне
	 		//case 4:{ atext = "givegungro"; } // Количество использования команды
	 		case 5:{ atext = "sp"; } // Количество слежки
	 		case 6:{ atext = "otv"; } // Количество сообщений в /otv
	 		case 7:{ atext = "re"; } // Количество открытыйх сообщений
	 		case 8:{ atext = "com"; } // Количество закрытых сообщений
	 		case 9:{ atext = "vzlom"; } // Количество защищённых аккаунтов
	 		case 10:{ atext = "jail"; } // Количество посаженных игроков в тюрьму
	 		case 11:{ atext = "prison"; } // Количество посаженных игроков в психушку
	 		//case 12:{ atext = "unprison"; } // Количество освобождённых игроков из заключения
	 		//case 13:{ atext = "givegun"; } // Количество выданного оружия
	 		case 14:{ atext = "mute"; } // Количество Mute
	 		case 15:{ atext = "kick"; } // Количество Kick
	 		case 16:{ atext = "ban"; } // Количество Ban
	 		case 17:{ atext = "warn"; } // Количество Warn
			case 18:{ atext = "gunwarn"; } // Количество GunWarn
	 		//case 20:{ atext = "map"; } // Мероприятия
		}
		cache_get_value_name_int(0, atext, datad1);
		if(PlayerInfo[playerid][pSoska] >= 1)
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_work` SET `%s` = '%d' WHERE `admin` = '%e' AND `today` = '%d'", atext, datad1+1, PlayerInfo[playerid][pName], today);
	 		query_empty(pearsq, f_str);
		}
		else if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)
	 	{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_work` SET `%s` = '%d',`givegun` = '%d' WHERE `admin2` = '%e' AND `today` = '%d'", atext, datad1+1, PlayerInfo[playerid][pLeader], PlayerInfo[playerid][pName], today);
			query_empty(pearsq, f_str);
		}
	}
 	return 1;
}
stock work_admin(playerid, action)
{
	new Days = getdate(),string[184];
	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_work` WHERE `admin` = '%e' AND `today` = '%d'", PlayerInfo[playerid][pName],Days);
 	mysql_tquery(pearsq, string, "CreateWork", "ddd", playerid, Days, action);
}
stock work_leader(playerid, action)
{
	new Days = getdate(),string[184];
	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_work` WHERE `admin2` = '%e' AND `today` = '%d'", PlayerInfo[playerid][pName],Days);
 	mysql_tquery(pearsq, string, "CreateWork", "ddd", playerid, Days, action);
}

stock MynameLog(adminid, const admin[], const adminip[], acc, const current[], const playerip[], const newname[], unix)
{
    new query[512];
    mysql_format(pearsq, query, sizeof(query), "INSERT INTO `myname_log` (`adminid`, `admin`, `adminip`, `acc`, `current`, `playerip`, `newname`, `unix`) \
		VALUES ( '%d', '%e', '%e', '%d', '%e', '%e', '%e', '%d' )",
    adminid, admin, adminip, acc, current, playerip, newname, unix);
    mysql_tquery(pearsq, query);
}

stock PromoLog(playerid, pf)
{
	new string[200];
	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `promo_log` SET `promoid` = '%d', `playerid` = '%d', `player` = '%e', `playerip` = '%e', `unix`= '%d'", 
		PromoInfo[pf][roNewid], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], gettime());
	mysql_tquery(pearsq, string);
	return true;
}

stock DedMoroz(const name[], const nameip[], member, leader, admin, const text[])
{
    new query[512];
    mysql_format(pearsq, query, sizeof(query), "INSERT INTO `ded_moroz` (`name`, `nameip`, `member`, `leader`, `admin`, `text`, `date`) VALUES ('%e','%e','%d','%d','%d','%e',NOW())",
    name, nameip, member, leader, admin, text);
    mysql_tquery(pearsq, query, "", "");
}

stock AdReklama(const name[], const nameip[], id, number, vip, status, const text[])
{
    new query[512];
    mysql_format(pearsq, query, sizeof(query), "INSERT INTO `ad_reklama` (`name`, `nameip`, `id`, `number`, `vip`, `status`, `text`, `date`) VALUES ('%e','%e','%d','%d','%d','%d','%e',NOW())",
    name, nameip, id, number, vip, status, text);
    mysql_tquery(pearsq, query, "", "");
}

stock notify(senderid, const sender[], playerid, const player[], const text[], bool: ingame_message = true)
{
	new query[364], unix = gettime();
	mysql_format(pearsq, query, sizeof(query), "INSERT INTO `pp_message` (`type`,`senderid`,`sender`,`playerid`,`player`,`unix`,`text`) VALUES ( '%d','%d','%e','%d','%e','%d','%e' )",
	1, senderid, sender, playerid, player, unix, text);
	mysql_tquery(pearsq, query, "", "");
	
	// Внутриигровое уведомление
	if (ingame_message) {
		foreach (new id : Player) {
			if (PlayerInfo[id][pID] == playerid) {
				SendClientMessage(id, 0x0088FFFF, "Вам пришло новое уведомление! {ffcc66}[ Y >> SMS ]");
				PlayerPlaySound(id, 5202, 0.0, 0.0, 0.0);
				break;
			}
		}
	}

	return 1;
}

// Трудовая книжка
stock LaborLog(g, const action[], playerid, const player[], row, const rows[])
{
	new query[460], unix = gettime();
    mysql_format(pearsq, query, sizeof(query), "INSERT INTO `labor_log`\
	(`frakid`,`action`,`playerid`,`player`,`unix`,`row`,`rows`) VALUES ('%d','%e','%d','%e','%d','%d','%e')",
    g, action, playerid, player, unix, row, rows);
	mysql_tquery(pearsq, query);
}

stock mysql_save2(playerid, paraa)
{
    new f_str[394];
    switch(paraa)
    {
		case 32: mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Gpci`='%e' WHERE `user_id` = '%d'", PlayerInfo[playerid][pGpci], PlayerInfo[playerid][pID]);
		case 38:
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `SafeIP`='%e',`SafeUnix`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pSafeIP], PlayerInfo[playerid][pSafeUnix], PlayerInfo[playerid][pID]);
		}
		default: { return 1; }
    }
    query_empty(pearsq, f_str);
    return 1;
}
stock mysql_save(playerid, paraa)
{
	if(!IsOnline(playerid)) return 1;
	if(OnlineInfo[playerid][oLogged] == 0) return 1;
    new f_str[424];
    //0 - сохранение денег +
	//1 - фишки +
    //2 - процесс вкачивания +
	//3 - сила
	//4 - донат
	//6 - дом
	//8 - квартира
	//9 - организация
	//10 - админка
	//11 - мы в игре
	//12 - мы вышли из игры
	//13 - семья
	//15 - бизнеса
	//16 - эксперт
	//17 - статус лишённого оружия Beret
	//18 - сохранения клевера
	//19 - сохранения нарушение rp
	//20 - WARNS игрока
	//21 - GUNWARNS игрока
	//23 - Bans
	//24 - Mute
	//25 - Аренда дома
	//26 - слоты транспорта
	//27 - новогодние квесты
	//28 - новогодние подарки
	//29 - точка спавна
	//30 - adm point и score
    switch(paraa)
    {
		case 0: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Money`='%d', `Account`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pMoney], PlayerInfo[playerid][pAccount], PlayerInfo[playerid][pID]);
		case 1: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Ammo1` = '%d', `Ammo8` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pAmmos1], PlayerInfo[playerid][pAmmos8], PlayerInfo[playerid][pID]);
		case 2: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Level` = '%d', `Exp` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pLevel], PlayerInfo[playerid][pExp], PlayerInfo[playerid][pID]);
		case 3: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `BoxSkill`='%d',`Power`='%d' WHERE `user_id`='%d'", PlayerInfo[playerid][pBoxSkill], PlayerInfo[playerid][pPower], PlayerInfo[playerid][pID]);
		case 4: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `DonateMoney` = '%d',`DonateRank` = '%d',`Upgrade` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pDonateMoney], PlayerInfo[playerid][pDonateRank], PlayerInfo[playerid][pUpgrade], PlayerInfo[playerid][pID]);
		case 6: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Gun13` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pDom], PlayerInfo[playerid][pID]);
		case 8:
		{
			mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `pApartmentsRoom0` = '%d',`pApartmentsRoom1` = '%d',`pApartmentsRoom2` = '%d',`pApartmentsRoom3` = '%d',`pApartmentsRoom4` = '%d',\
			`pApartmentsRoom5` = '%d',`pApartmentsRoom6` = '%d',`pApartmentsRoom7` = '%d',`pApartmentsRoom8` = '%d',`pApartmentsRoom9` = '%d' \
			WHERE `user_id` = '%d'", PlayerInfo[playerid][pApartmentsRoom][0], PlayerInfo[playerid][pApartmentsRoom][1], PlayerInfo[playerid][pApartmentsRoom][2], PlayerInfo[playerid][pApartmentsRoom][3], PlayerInfo[playerid][pApartmentsRoom][4],
			PlayerInfo[playerid][pApartmentsRoom][5], PlayerInfo[playerid][pApartmentsRoom][6], PlayerInfo[playerid][pApartmentsRoom][7], PlayerInfo[playerid][pApartmentsRoom][8], PlayerInfo[playerid][pApartmentsRoom][9], PlayerInfo[playerid][pID]);
		}
		case 9: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Member` = '%d',`Leader` = '%d',`Rank` = '%d',`Fbi` = '%d',`Vig` = '%d',`Reproof` = '%d',`LastRank` = '%d',`LastFrak` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pMember], PlayerInfo[playerid][pLeader], PlayerInfo[playerid][pRank], PlayerInfo[playerid][pFbi], PlayerInfo[playerid][pVig], PlayerInfo[playerid][pReproof],PlayerInfo[playerid][pLastRank],PlayerInfo[playerid][pLastFrak], PlayerInfo[playerid][pID]);
		case 10: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Soska` = '%d',`AdmWarns` = '%d',`Reproof` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pSoska], PlayerInfo[playerid][pAdmWarns], PlayerInfo[playerid][pReproof], PlayerInfo[playerid][pID]);
		case 11: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Online` = '1' WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
		case 12: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Online` = '0' WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
		case 13: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Family` = '%d', `Famrank` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pFamily], PlayerInfo[playerid][pFamrank], PlayerInfo[playerid][pID]);
		case 15: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Meshk1` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pBusiness], PlayerInfo[playerid][pID]);
		case 16: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Expert` = '%d', `Question` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pExpert], PlayerInfo[playerid][pQuestion], PlayerInfo[playerid][pID]);
		case 17: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Beret` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pBeret], PlayerInfo[playerid][pID]);
		case 18: { }
		case 20: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Warns` = '%d', `WarnClearTime` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pWarns], PlayerInfo[playerid][pWarnClearTime], PlayerInfo[playerid][pID]);
		case 21: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `GunWarns` = '%d', `GunWarnsZZTime` = '%d', `GunWarnsDonateCD` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pGunWarns], PlayerInfo[playerid][pGunWarnsZZTime], PlayerInfo[playerid][pGunWarnsDonateCD], PlayerInfo[playerid][pID]);
		case 23: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `BanMonzz` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pBanMonzz], PlayerInfo[playerid][pID]);
		case 24: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `MuteTime`='%d', `FmuteTime`='%d', `Amute`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pMuteTime],PlayerInfo[playerid][pFmuteTime],PlayerInfo[playerid][pAMute],PlayerInfo[playerid][pID]);
		case 25: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Houserent` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pHouserent], PlayerInfo[playerid][pID]);
		case 29: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Spawnchange` = '%d',`pSpawnChangeDop` = '%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pSpawnchange],PlayerInfo[playerid][pSpawnChangeDop], PlayerInfo[playerid][pID]);
		case 30: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki`SET`AdmPoint` = '%d',`AdmScore` = '%d',`AdmNorm` = '%d'WHERE`user_id` = '%d'", PlayerInfo[playerid][pAdmPoint], PlayerInfo[playerid][pAdmScore], PlayerInfo[playerid][pAdmNorm], PlayerInfo[playerid][pID]);
		case 31: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki`SET`GameDay` = '%d',`GameTime` = '%d',`GameAfk` = '%d'WHERE`user_id` = '%d'", PlayerInfo[playerid][pGameDay], PlayerInfo[playerid][pGameTime], PlayerInfo[playerid][pGameAfk], PlayerInfo[playerid][pID]);
