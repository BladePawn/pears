   			{
   				if(PlayerInfo[playerid][pRentVeh][sl] > 0)
	   			{
	   				format(string,sizeof(string),"{FF6347}Аренда %s отменена", GetVehicleName(PlayerInfo[playerid][pRentModel][sl]));
