			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2019.03162, -2361.77002, 29.69550)) setles = 12;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2027.11450, -2355.78223, 29.69550)) setles = 13;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2032.06641, -2346.77832, 29.69550)) setles = 14;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2012.76758, -2349.75684, 29.69550)) setles = 15;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2022.05347, -2344.28735, 29.69550)) setles = 16;
