CMD:entercardrive(playerid, const params[])
{
    new testcar;
    if(!sscanf(params, "i", testcar))
	{
		if (PlayerInfo[playerid][pSoska] >= 5 || PlayerInfo[playerid][pHidden] > 0) Protect_PutPlayerInVehicle(playerid, testcar, 0);
		else SendClientMessage(playerid, COLOR_GRAD1, " Вы не можете использовать эту команду!");
	}
	else SendClientMessage(playerid, COLOR_GRAD1, "*Используйте: /entercardrive [id машины]");
	return 1;
}
CMD:entercar(playerid, const params[])
{
	if (PlayerInfo[playerid][pSoska] >= 5 || PlayerInfo[playerid][pHidden] > 0)
	{
		new testcar, seat;
		if (!sscanf(params, "ii", testcar, seat))
		{
			if(seat < 1 || seat > 4) return ErrorMessage(playerid, "{FF6347}Место не меньше 1 и не больше 4");
			Protect_PutPlayerInVehicle(playerid, testcar, seat);
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Тп в транспорт пассажиром [ /entercar VehID Seat ]");
	}
	else ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	return 1;
}
CMD:goto(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] > 0 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] > 0)
    {
    	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепортироваться к игроку [ /goto ID ]");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок оффлайн");
		new Float:plocx,Float:plocy,Float:plocz;
		if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он находится в слежке [ /flycam /sp или /mytv ]");
		SaveReturnCoord(playerid);
		GetPlayerPos(params[0], plocx, plocy, plocz);
		S_SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0]), GetPlayerInterior(params[0]));
		PPSetPlayerInterior(playerid, GetPlayerInterior(params[0]));
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			PPSetVehiclePos(playerid, plocx, plocy+4, plocz);
			new tmpcar = GetPlayerVehicleID(playerid);
			SetVehicleVirtualWorld(tmpcar, GetPlayerVirtualWorld(params[0]));
			S_SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(params[0]),GetPlayerInterior(params[0]));
			PPSetPlayerInterior(playerid,GetPlayerInterior(params[0]));
			LinkVehicleToInterior(tmpcar, GetPlayerInterior(params[0]));
		}
		else PPSetPlayerPos(playerid, plocx, plocy+2, plocz), PPSetPlayerFacingAngle(playerid, 0.0);
		AdminLog("goto", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	return 1;
}
//----------------------------------[GETHERE]-----------------------------------------------
alias:gethere("gh")
CMD:gethere(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепортировать игрока к себе [ /gethere ID ]");
    if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Игрока нет Online ]");
	if(PlayerInfo[params[0]][pSoska] >= PlayerInfo[playerid][pSoska])
	{
		if(PlayerInfo[playerid][pMedia] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это администратор моего уровня или выше");
		else if(PlayerInfo[playerid][pMedia] > 0 && PlayerInfo[params[0]][pSoska] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу телепортировать админа");
	}
	if(GetPVarInt(params[0],"afksystem") >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок AFK");
	if(PlayerInfo[params[0]][pJailed] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок сидит в тюрьме");
	if(IsPlayerEditObject(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он занят редактированием объекта [ /goto ]");
	if(MenuInfo[params[0]][zStat] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он сейчас в редакторе текстур");
	if(IsARealNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Это NPC");
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
	new Float:plocx[3];
	GetPlayerPos(playerid, plocx[0], plocx[1], plocx[2]);
	if(PlayerInfo[playerid][pSoska] <= 1 && PlayerInfo[playerid][pMedia] <= 1)
	{
		if(!IsPlayerInRangeOfPoint(playerid,50.0,plocx[0], plocx[1], plocx[2])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я далеко от него [ не больше 50 метров ]");
	}
	S_SetPlayerVirtualWorld(params[0],GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid));
	PPSetPlayerInterior(params[0],GetPlayerInterior(playerid));
	AdminLog("gethere", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
	if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER)
	{
		new tmpcar = GetPlayerVehicleID(params[0]);

		// Проверяем никто ли не садится и не выходит из транспорта (Чтобы ложно не кикнуло)
		if(CheckEnterVehicleInterior(params[0], tmpcar)) return true;

		PPSetVehiclePos(params[0], plocx[0], plocx[1]+4, plocx[2]);
		LinkVehicleToInterior(tmpcar, GetPlayerInterior(playerid));
		SetVehicleVirtualWorld(tmpcar, GetPlayerVirtualWorld(playerid));
		S_SetPlayerVirtualWorld(params[0], GetPlayerVirtualWorld(playerid));

		// Меняем вирт мир и инт пассажирам транспорта
    	PassengerWorldVehicle(tmpcar, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	}
	else PPSetPlayerPos(params[0],plocx[0], plocx[1]+2, plocx[2]), PPSetPlayerFacingAngle(params[0], 0.0);
	return 1;
}
alias:getcar("gc")
CMD:getcar(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pHidden] == 0
		&& PlayerInfo[playerid][pMedia] < 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Вызвать транспорт [ /getcar ID ]");
    if(params[0] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. нет такого транспорта");
	if(!IsValidVehicle(params[0])) return ErrorMessage(playerid, "{FF6347}Этого транспорта не существует");
	if(params[0] == train || params[0] == train + 1 || params[0] == train + 2 || params[0] == train + 3) return ErrorMessage(playerid, "{FF6347}Нельзя вызвать поезд");

	// Получаем пассажиров в автомобиле
	new passengers[10] = {INVALID_PLAYER_ID, ...}, seats[10];
	new passengers_count = 0;
	foreach (new id : Player) {
		if (GetPlayerVehicleID(id) == params[0]) {
			passengers[passengers_count] = id;
			seats[passengers_count] = GetPlayerVehicleSeat(id);
			passengers_count++;
		}
	}

	new Float:f_pos[4];
	frontme(playerid, 4.0, f_pos[0], f_pos[1], f_pos[2], f_pos[3]);
	ACSetVehiclePos(params[0], f_pos[0], f_pos[1], f_pos[2]);
	LinkVehicleToInterior(params[0], GetPlayerInterior(playerid));
	SetVehicleVirtualWorld(params[0], GetPlayerVirtualWorld(playerid));

	new driver_id = INVALID_PLAYER_ID;

	// Возвращаем пассажиров на место после телепорта транспорта
	for (new i = 0; i < passengers_count; i++) {
		new id = passengers[i];
		PPSetPlayerPos(id, f_pos[0], f_pos[1], f_pos[2]);
		Protect_PutPlayerInVehicle(id, params[0], seats[i]);

		if (seats[i] == 0) {
			driver_id = id;
		}
	}

	{
		new log_str[128] = "Телепортировал машину к себе [ Водитель: Нет ]";
		if (IsOnline(driver_id)) {
			format(
				log_str,
				sizeof(log_str),
				"Телепортировал машину к себе [ Водитель: %s ]",
				PlayerInfo[driver_id][pName]
			);
		}

		AdminLog("getcar",
			PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP],
			0, "", "",
			params[0],
			log_str
		);
	}

	return 1;
}
CMD:gotocar(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепортироваться к транспорту [ /gotocar ID ]");
    if(params[0] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. нет такого транспорта");
	SaveReturnCoord(playerid);
	new Float:vePos[3];
	GetVehiclePos(params[0], vePos[0], vePos[1], vePos[2]);

	S_SetPlayerVirtualWorld(playerid, 0, 0);
	PPSetPlayerInterior(playerid, 0);
	PPSetPlayerPos(playerid,vePos[0], vePos[1], vePos[2]+1.5);
	PPSetPlayerFacingAngle(playerid, 0.0);
	return 1;
}
CMD:unfill(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	for(new c=0;c<MAX_CARS;c++)
	{
		VehInfo[c][vGas] -= GasMax / 10;
		if(VehInfo[c][vGas]  < 0) VehInfo[c][vGas]  = 0;
	}
	SendClientMessage(playerid, COLOR_GREY, "    Слил 10 литров бенза из всех тачек ");
 	return 1;
}
CMD:fuelcars(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	for(new c=0;c<MAX_CARS;c++)
	{
		VehInfo[c][vGas]  = GasMax - VehInfo[c][vGelium] ;
	}
	AdminLog("fuelcars", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	SendClientMessage(playerid, COLOR_GREY, "    Все автомобили заправлены ! ");
	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s заправил весь транспорт на сервере",PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
 	return 1;
}
CMD:unfuelcars(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	for(new c=0;c<MAX_CARS;c++) {
		VehInfo[c][vGas] = 0;
		VehInfo[c][vGelium] = 0;
	}
	SendClientMessage(playerid, COLOR_GREY, "    Во всех автомобилях слит бензин ! ");
	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s слил топливо со всего транспорта на сервере",PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
 	return 1;
}
CMD:checkgun(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 22)
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чек оружия [ /checkgun ID ]");
		new sl = Protect_Slot(GetPlayerWeapon(params[0]));
		new string[144], shoker[2];
		GetPlayerWeaponData(params[0], WEAPON_SLOT:sl, WEAPON:shoker[0], shoker[1]);
		format(string, sizeof(string), "[%d] ProtectWeapon: %d ProtectAmmo: %d ProtectDet: %d | RealWeapon: %d RealAmmo: %d", gettime() - ResetWeaponUnix[params[0]][sl], ProtectInfo[params[0]][prWeapon][sl], ProtectInfo[params[0]][prAmmo][sl], ProtectInfo[params[0]][prDet][sl],shoker[0], shoker[1]);
		SendClientMessage(playerid, COLOR_GREY, string);
	}
	return 1;
}
CMD:givegun(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 9) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "iii", params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать оружие [ /givegun ID weaponid ammo ]");
    if(params[1] >= 2 && params[1] <= 15 || params[1] == 22 || params[1] == 24 || params[1] == 25 || params[1] == 26 || params[1] == 27 || params[1] == 28
	|| params[1] == 29 || params[1] == 30 || params[1] == 31 || params[1] == 32 || params[1] == 33 || params[1] == 34 || params[1] == 36 || params[1] == 38 
	|| params[1] == 46)
    {
    	new sl = Protect_Slot(params[1]);
    	if(params[2] <= 0 || params[2] >= 1001) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Патронов не меньше 1 и не больше 1000");
    	if(IsOnline(params[0]))
		{
			if(OnlineInfo[params[0]][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
			if(PlayerInfo[params[0]][pBeret] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он сейчас не может получить оружие [ Временное Лишение ]");
			new string[144], shoker[2];
			GetPlayerWeaponData(params[0], WEAPON_SLOT:2, WEAPON:shoker[0], shoker[1]);
			// Отнимаем Электрошокер
			if(params[1] == 24 && shoker[0] == 23 && shoker[1] >= 1) return Protect_Remove(params[0], 23), OnDuty[params[0]] = 0;
			if(ProtectInfo[params[0]][prWeapon][sl] >= 1 && ProtectInfo[params[0]][prAmmo][sl]+params[2] >= 1001) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Ему не хватает места для патронов [ Лимит: 1000 ]");
			Protect_GiveWeapons(params[0], params[1], params[2], GUN_HEALTH, 0);
			format(string, sizeof(string), "[ Мысли ]: %s получил от меня {0088ff}%s и %d патронов",PlayerInfo[params[0]][pName], gunName[params[1]], params[2]);
			SendClientMessage(playerid, COLOR_GREY, string);
   			AdminLog("givegun", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], params[2], gunName[params[1]]);
    	}
   	 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
    }
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это оружие запрещено использовать на сервере");
    return 1;
}
CMD:rguns(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 3 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отнять всё оружие у игрока [ /rguns ID ]");
	if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	new giveplayerid, string[144];
	giveplayerid = ReturnUser(params[0], 1);
	if(IsOnline(giveplayerid))
	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		Protect_DestroyGuns(giveplayerid);
		format(string,sizeof(string),"[ Мысли ADM ]: У игрока %s удалено всё оружие", PlayerInfo[giveplayerid][pName]), SendClientMessage(playerid, COLOR_GRAD1, string);
		SendClientMessage(giveplayerid, COLOR_GRAD1, " Администратор отнял всё ваше оружие");
		AdminLog("rguns", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "");
	}
	else
	{
		if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, params[0], params[0],13,0);
		return 1;
	}
	return 1;
}
CMD:rgungro(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new string[144], kol = 0;
	foreach (Player, i)
	{
		if(GetDistanceBetweenPlayers(playerid,i) < 40 && playerid != i && OnlineInfo[i][oLogged] == 1 && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
		{
			Protect_TakeGuns(i, 0);
	  		SendClientMessage(i, COLOR_GRAD1," Администратор отобрал у вас всё оружие");
	  		kol ++;
		}
	}
	if(kol == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Рядом никого нет..");
	else if(kol >= 1)format(string, sizeof(string), "[ Мысли ]: Оружия лишены %d игроков в радиусе 40 метров от меня",kol), SendClientMessage(playerid, COLOR_GREY, string);
	return 1;
}
CMD:givegungro(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(Pognalinamp == 0 && PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только во время мероприятия [ /gomp ]");
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать оружие игрокам возле себя [ /givegungro weaponid ammo ]");
	if(params[0] >= 2 && params[0] <= 15 || params[0] == 22 || params[0] == 24 || params[0] == 25 || params[0] == 26 || params[0] == 27 || params[0] == 28
	|| params[0] == 29 || params[0] == 30 || params[0] == 31 || params[0] == 32 || params[0] == 33 || params[0] == 34 || params[0] == 38 || params[0] == 46)
    {
		if(params[1] <= 0 || params[1] >= 1001) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Патронов не меньше 1 и не больше 1000");
		new kol = 0, sl = Protect_Slot(params[0]);
		foreach (Player, i)
		{
			if(GetDistanceBetweenPlayers(playerid,i) < 40 && MPGO[i] == 1 && OnlineInfo[i][oLogged] == 1 && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
			{
				new shoker[2], mojno = 0;
				GetPlayerWeaponData(i, WEAPON_SLOT:2, WEAPON:shoker[0], shoker[1]);
				if(params[0] == 23 && shoker[0] == 24 && shoker[1] >= 1) mojno = 1;
				if(params[0] == 24 && shoker[0] == 23 && shoker[1] >= 1) mojno = 1;
				if(ProtectInfo[i][prWeapon][sl] >= 1 && ProtectInfo[i][prAmmo][sl]+params[1] >= 1001) mojno = 1;
				if(mojno == 0)
				{
					Protect_GiveWeapons(i, params[0], params[1], GUN_HEALTH, 0);
					SendClientMessage(i, COLOR_GRAD1, " Администратор выдал вам оружие.");
					kol ++;
				}
			}
		}
		if(kol == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Рядом никого нет.. [ Только для участников мероприятия ]");
		else if(kol >= 1)
		{
			AdminLog("givegungro", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], gunName[params[0]]);
			SendClientMessage(playerid, COLOR_GRAD1, " Ты дал оружие рядом находящимся игрокам.");
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это оружие запрещено использовать на сервере");
	return 1;
}
CMD:harakiri(playerid)
{
  	if(PlayerInfo[playerid][pMember] == 6 || PlayerInfo[playerid][pLeader] == 6)
	{
		if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж на ринге");
		if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж на мероприятии");
		if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return ErrorMessage(playerid, "{FF6347}Только пешечком");
		if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
		if(GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Нельзя в движении");
		if(OnlineInfo[playerid][oInHandThing][0] > 0 || Hand[playerid] >= 1 || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки\n\n{cccccc}Предмет или какое-то действие");

		if(GetPlayerWeapon(playerid) != WEAPON:8) return ErrorMessage(playerid, "{FF6347}У вас в руках нет катаны");

		ApplyAnimation(playerid,"PARK","Tai_Chi_Loop",4.0, true, false, false, false, false);
		if(PlayerInfo[playerid][pSex] == 1) around_player_audio(playerid, 5203, 0, 10.0, 1); // Япона фраза
		gTimeDeath[playerid] = 11;
	}
	else ErrorMessage(playerid, "{FF6347}Только посвящённый участник Yakuza может совершить такое");
	return 1;
}

CMD:nohp(playerid)
{
	if(PlayerInfo[playerid][pSoska] > 0 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] > 0 || server == 0) 
	{
		ACSetPlayerHealth(playerid, 0);
	}
	return 1;
}
CMD:hp(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] > 0 || server == 0) 
	{
		if (server > 0)
		{
			if(IsPlayerInActiveVillage(playerid)) return ErrorMessage(playerid, "{FF6347}Нельзя использовать команду во время активной битвы");
			if(MineWar_IsPlayerInside(playerid) || Tomb_IsPlayerInside(playerid)) return ErrorMessage(playerid, "{FF6347}Сейчас вы не можете использовать эту команду");
		}

		if(DeathInfo[playerid][deathStatus] == true
			&& DeathInfo[playerid][deathDelayed] == true) return ErrorMessage(playerid, "{FF6347}Дождитесь завершения спавна и после этого повторите команду");
		ACSetPlayerHealth(playerid, GetMaxPlayerHealth(playerid));
	}
	return 1;
}
CMD:stethp(playerid, const params[])
{
    new podst,playa;
    if(!sscanf(params, "ii", playa,podst))
	{
		if(PlayerInfo[playerid][pSoska] >= 22)
		{
		    if(IsOnline(playa) && IsOnline(podst))
	  		{
		        if(OnlineInfo[playa][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "   Игрок не залогинился!!!");
				if(CheckPlayerNpc(playerid, playa)) return 1;
		        if(PlayerInfo[playa][pSoska] >= 22 && playa != playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изменить уровень HP Создателю");
				ACSetPlayerHealth(playa, 0.0);
				AdminLog("sethp", PlayerInfo[podst][pID], PlayerInfo[podst][pName], PlayerInfo[podst][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], 0, "");
			}
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Уровень ХП [ /sethp ID Health Podst ]");
	return 1;
}
CMD:sethp(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 2 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] >= 2)
	{
		if(sscanf(params, "ii", params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить уровень HP [ /sethp ID количество ]");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Игрок нет Online ]");
		if(CheckPlayerNpc(playerid, params[0])) return 1;

		if (server > 0)
		{
			if(IsPlayerInActiveVillage(params[0])) return ErrorMessage(playerid, "{FF6347}Нельзя использовать команду во время активной битвы");
			if(MineWar_IsPlayerInside(params[0]) || Tomb_IsPlayerInside(params[0])) return ErrorMessage(playerid, "{FF6347}Нельзя использовать эту команду на игрока в данный момент");
		}

	    if(params[1] < 0 || params[1] > 160) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 160");
	    if(PlayerInfo[params[0]][pSoska] >= PlayerInfo[playerid][pSoska] && playerid != params[0]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это администратор моего уровня или выше");
		
		if(params[1] <= 0) gYda[params[0]] = 2; // Игрок умер
		ACSetPlayerHealth(params[0], params[1]);

		AdminLog("sethp", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], params[1], "");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	return 1;
}
CMD:showptaxes(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new targetid;
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Просмотреть налоги игрока [ /showptaxes ID ]");
	if(!IsOnline(targetid)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	DisplayPlayerTaxes(playerid, targetid);
	return 1;
}
CMD:rodet(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сбросить аксессуары игрока [ /rodet ID ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[params[0]][pOdet][0] == 0 && PlayerInfo[params[0]][pOdet][1] == 0 && PlayerInfo[params[0]][pOdet][2] == 0 && PlayerInfo[params[0]][pOdet][3] == 0 && PlayerInfo[params[0]][pOdet][4] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет надетых аксессуаров");
	new string[144];
	format(string, sizeof(string), "Администратор %s снял ваши аксессуары", PlayerInfo[playerid][pName]);
	SendClientMessage(params[0],COLOR_LIGHTRED, string);
	format(string, sizeof(string),"{0088ff}Администратор %s снял ваши аксессуары",PlayerInfo[playerid][pName]);
	ShowDialog(params[0],1700, 0, "******* {FF0000} Аксессуары Сняты {FFFFFF}*******", string, "Ок", "");
	format(string, sizeof(string), "[ Мысли ADM ]: Аксессуары игроку %s сняты",PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_GREY, string);
	for(new i = 0; i < 5; i++)
	{
		if(PlayerInfo[params[0]][pOdet][i] > 0)
	 	{
	 	    new put_inva = GiveThingPlayer(params[0], PlayerInfo[params[0]][pOdet][i], 1, PlayerInfo[params[0]][pOdetPara][i], PlayerInfo[params[0]][pOdetQara][i], 2, 0, 9999);
		 	if(put_inva == -1)
			{
				ErrorMessage(playerid, "{FF6347}У игрока не хвататет места в инвентаре\n{ffcc66}Не все предметы получилось снять и положить в инвентарь");
				break;
			}
			PlayerInfo[params[0]][pOdet][i] = 0;
	 		PlayerInfo[params[0]][pOdet_X][i] = 0.0, PlayerInfo[params[0]][pOdet_Y][i] = 0.0, PlayerInfo[params[0]][pOdet_Z][i] = 0.0;
	 		PlayerInfo[params[0]][pOdet_rX][i] = 0.0, PlayerInfo[params[0]][pOdet_rY][i] = 0.0, PlayerInfo[params[0]][pOdet_rZ][i] = 0.0;
	 		PlayerInfo[params[0]][pOdet_sX][i] = 1.0, PlayerInfo[params[0]][pOdet_sY][i] = 1.0, PlayerInfo[params[0]][pOdet_sZ][i] = 1.0;
	 		PlayerInfo[params[0]][pOdetPara][i] = 0;
	 		PlayerInfo[params[0]][pOdetQara][i] = 0;
		}
	}
	UpdateAllOdet(params[0]);
	RemovePlayerAttachedObject(params[0],5);
	RemovePlayerAttachedObject(params[0],6);
	RemovePlayerAttachedObject(params[0],7);
	RemovePlayerAttachedObject(params[0],8);
	RemovePlayerAttachedObject(params[0],9);
	if(OnlineInfo[params[0]][oShowInterface] == 1) CloseFrisk(params[0]), CancelSelectTextDraw(params[0]);
  	AdminLog("rodet", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
    return 1;
}
alias:setspawn("swp")
CMD:setspawn(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1 
		&& PlayerInfo[playerid][pHidden] == 0 
		&& PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заспавнить игрока [ /setspawn ID ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(IsPlayerNPC(params[0]) && serverType > 0) return ErrorText(playerid, "[ Мысли ]: Это NPC");
 	if(PlayerInfo[params[0]][pSoska] >= PlayerInfo[playerid][pSoska] && playerid != params[0])
	{
		if(PlayerInfo[playerid][pMedia] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу зареспавнить старшего админа");
		else if(PlayerInfo[playerid][pMedia] > 0 && PlayerInfo[playerid][pMedia] <= PlayerInfo[params[0]][pMedia]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу зареспавнить другую медийку");
		else if(PlayerInfo[playerid][pMedia] > 0 && PlayerInfo[params[0]][pSoska] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу зареспавнить админа");
	}
  	gYda[params[0]] = 2;
  	PPSpawnPlayer(params[0]);
  	AdminLog("setspawn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
    return 1;
}
CMD:vehhp(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] >= 2)
	{
	    if(sscanf(params, "ii", params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить HP транспорта [ /vehhp ID Health ]");
	    if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
		if(CheckPlayerNpc(playerid, params[0])) return 1;
	    if(params[1] < 0 || params[1] > 90000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: HP не меньше 0 и не больше 90к");
   		if(PlayerInfo[params[0]][pSoska] >= PlayerInfo[playerid][pSoska] && playerid != params[0]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это администратор моего уровня или выше");
		VehInfo[GetPlayerVehicleID(params[0])][vHealthFix] = GetTickCount();
		VehInfo[GetPlayerVehicleID(params[0])][vHealth] = params[1];
		SetVehicleHealth(GetPlayerVehicleID(params[0]), params[1]);
		AdminLog("vehhp", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], params[1], "");
    }
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	return 1;
}
CMD:setarm(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    if(sscanf(params, "ii", params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать броню [ /setarm ID Armor ]");
	if(IsPlayerInActiveVillage(params[0]) && server > 0) return ErrorMessage(playerid, "{FF6347}Нельзя использовать команду во время активной битвы");
    if(MineWar_IsPlayerInside(params[0]) || Tomb_IsPlayerInside(params[0])) return ErrorMessage(playerid, "{FF6347}Нельзя использовать эту команду на игрока в данный момент");
	if(params[1] < 0 || params[1] > 100) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Броня не меньше 0 и не больше 100");
	ACSetPlayerArmour(params[0], params[1]);
	return 1;
}
CMD:animbot(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. Я не могу это сделать");
    if(sscanf(params, "ii", params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Анимация боту /animbot [ID Анимация 1-11]");
    switch(params[1])
    {
    	case 0: ApplyDynamicActorAnimation(params[0],"PED","facanger",4.0, false, true, true, true, true);
     	case 1: ApplyDynamicActorAnimation(params[0],"DANCING","dnce_M_e",4.1, true, true, true, true, true);
      	case 2: ApplyDynamicActorAnimation(params[0],"DANCING","dnce_M_d",4.1, true, true, true, true, true);
       	case 3: ApplyDynamicActorAnimation(params[0],"DANCING","dnce_M_c",4.1, true, true, true, true, true);
        case 4: ApplyDynamicActorAnimation(params[0],"DANCING","dnce_M_b",4.1, true, true, true, true, true);
        case 5: ApplyDynamicActorAnimation(params[0],"DANCING","dnce_M_a",4.1, true, true, true, true, true);
        case 6: ApplyDynamicActorAnimation(params[0],"DANCING","DAN_Loop_A",4.1, true, true, true, true, true);
        case 7: ApplyDynamicActorAnimation(params[0],"DANCING","DAN_Left_A",4.1, true, true, true, true, true);
        case 8: ApplyDynamicActorAnimation(params[0],"DANCING","DAN_Right_A",4.1, true, true, true, true, true);
        case 9: ApplyDynamicActorAnimation(params[0],"DANCING","DAN_Up_A",4.1, true, true, true, true, true);
        case 10: ApplyDynamicActorAnimation(params[0],"DANCING","DAN_Down_A",4.1, true, true, true, true, true);
        case 11: ApplyDynamicActorAnimation(params[0],"DANCING","dance_loop",4.1, true, true, true, true, true);
        default: SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Такой анимации не существует");
    }
	return 1;
}
CMD:sendmind(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new tmp[121];
    if(sscanf(params, "is[121]", params[0],tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Вывеси мысли игрока [ /sendmind ID Текст ]");
    if(strlen(tmp) > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинный первый текст [ Лимит 30 символов ]");
	new string[144];
	format(string, sizeof(string), "%s",tmp);
	SendMindMessage(params[0],string," ");
	return 1;
}
CMD:bottext(playerid, const params[])
{
    new botid,bottext[64],string[128];
    if (!sscanf(params, "is[64]", botid,bottext))
	{
	    if (PlayerInfo[playerid][pSoska] >= 4)
	    {
	    	format(string, sizeof(string), "%s",bottext);
			SendDynamicActorMessage(playerid, botid,string);
   		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разговаривать ботом /bottext ID текст");
	return 1;
}

CMD:botnear(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");

	SendClientMessage(playerid, -1, "{0088ff}Актеры рядом со мной:");
	for(new i = 0; i < MAX_ACTORS; i++)
	{
		new Float:X,Float:Y,Float:Z;
		GetDynamicActorPos(i, X,Y,Z);

		if(IsPlayerInRangeOfPoint(playerid,5.0,X,Y,Z) && GetDynamicActorVirtualWorld(i) == GetPlayerVirtualWorld(playerid))
		{
			new string[100];
			format(string,sizeof(string),"%d, %f, %f, %f", i, X, Y, Z);
			SendClientMessage(playerid, -1, string);
		}
	}
	return 1;
}

CMD:botid(playerid, const params[])
{
   if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
   if(binfo[playerid] == 0)
   {
      new string[64];
      for(new b = 0; b < MAX_BOTS; b++)
      {
         new Float:X,Float:Y,Float:Z;
         GetDynamicActorPos(BotPears[b], X,Y,Z);
         format(string,sizeof(string),"{cccccc}Actor ID: {0088ff}(%d) BotPears[%d]",BotPears[b],b);
         BotLabel[b] = CreatePlayer3DTextLabel(playerid,string,0xA9C4E4FF,X,Y,Z,50.0);
      }
      binfo[playerid]=1;
      SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Все боты отмечены для меня");
   }
   else if(binfo[playerid] == 1)
   {
      for(new b = 0; b < MAX_BOTS; b++) DeletePlayer3DTextLabel(playerid, BotLabel[b]);
      binfo[playerid]=0;
      SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Все мои отметки ботов удалены");
   }
   return 1;
}
CMD:bot(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pMedia] == 3)
 	{
    	new botid,string[256];
    	if (!sscanf(params, "i", botid))
		{
			if(!IsASkinExisting(botid)) return ErrorMessage(playerid, "{FF6347}Несуществующий ID скина [1 - 311, кастомные 312 и выше]");
		 	if(CreatedBot>=50) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Превышен максимальный лимит ботов");
	        new Float:X,Float:Y,Float:Z,Float:A;
			GetPlayerPos(playerid, X,Y,Z);
			GetPlayerFacingAngle(playerid,A);
			X=X+1.0*floatsin(-A,degrees);
	        Y=Y+1.0*floatcos(-A,degrees);
			new botss = CreateDynamicActor(botid, X,Y,Z,A+180.0 , true, 100.0, GetPlayerVirtualWorld(playerid));
			CreatedBots[CreatedBot] = botss;
			CreatedBot ++;
			format(string, sizeof(string), "{FFFFFF}Бот создан: {0088ff}ID: {FFFFFF}%d {0088ff}Порядковый Номер: {ffffff}%d", botid,botss);
			SendClientMessage(playerid, COLOR_GREY, string);
			if(PlayerInfo[playerid][pSoska]>=22){
	        format(string, sizeof(string), "CreateDynamicActor(%d, %f, %f, %f, %f);",botid, X,Y,Z,A+180.0);
		    SendClientMessage(playerid, COLOR_GREY, string);}
   		}
   		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Команда для создания NPC бота /bot [ID скина]");
	}
	return 1;
}
CMD:delbot(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pMedia] == 3)
	{
		new string[244];
		for(new i = 0; i < CreatedBot; i++) DestroyDynamicActor(CreatedBots[i]);
		CreatedBot = 0;
		format(string, sizeof(string), " [ ADM ]: %s удалил всех созданных ботов.",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Все созданные боты удалены");
	}
	return 1;
}
CMD:pc(playerid)
{
	new yes = -1, worldid = GetPlayerVirtualWorld(playerid), interiorid = GetPlayerInterior(playerid);
	if(worldid >= 1 || interiorid >= 1)
	{
		if(IsPlayerInSquare(playerid, 1564.659545, -1681.572143, 1566.940429, -1670.921264)) return 1; // Защита от срабатывания в холле LSPD

		for(new pc = 0; pc < sizeof(PcPos); ++pc)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.4, PcPos[pc][PcPos_X], PcPos[pc][PcPos_Y], PcPos[pc][PcPos_Z])
			&& (PcPos[pc][PcWorld] >= 0 && worldid == PcPos[pc][PcWorld] || PcPos[pc][PcWorld] <= 0)
			&& (PcPos[pc][PcInt] >= 0 && interiorid == PcPos[pc][PcInt] || PcPos[pc][PcInt] <= 0))
			{
				yes = pc;
				break;
			}
		}
		if(yes >= 0)
		{
			if(PcPos[yes][PcSit] >= 0 && playerSeat[playerid] == false) return ErrorMessage(playerid, "{FF6347}Чтобы использовать этот компьютер, вам необходимо сесть за стол [ ALT ]");
			if(Komputer[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы уже используете компьютер");
			if(Komputer[playerid] == 2) return ErrorMessage(playerid, "{FF6347}Вы уже используете ноутбук");
			if(OnlineInfo[playerid][oShowInterface] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас открыть ноутбук [ Закройте другое меню ]");
			GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
			loadkomp(playerid, 0);
			return 1;
		}
	}
	return 1;
}
CMD:readfbi(playerid)
{
	if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1)
	{
		if(SitPlayer[playerid] >= 1 && OverHear[playerid] == 0)
		{
			new sitid = SitPlayer[playerid]-1;
			if(sitid >= 174 && sitid <= 186)
			{
				new str[124],sctring[300];
   				if(GetPVarInt(playerid, "komp") <= 999) format(str,sizeof(str),"{999999}Общее Прослушивание {FF6347}[ Off ]\n"), strcat(sctring,str);
   				else if(GetPVarInt(playerid, "komp") == 9999) format(str,sizeof(str),"{999999}Общее Прослушивание {99ff66}[ On ]\n"), strcat(sctring,str);
   				if(GetPVarInt(playerid, "komp") >= 0 && GetPVarInt(playerid, "komp") <= 999)
			   	{
			   		if(IsOnline(GetPVarInt(playerid, "komp"))) format(str,sizeof(str),"{cccccc}Определённого Человека {ff9000}[ %s ]\n",PlayerInfo[GetPVarInt(playerid, "komp")][pName]), strcat(sctring,str);
			   		else format(str,sizeof(str),"{cccccc}Определённого Человека\n"), strcat(sctring,str);
		   		}
		   		else if(GetPVarInt(playerid, "komp") <= -1 || GetPVarInt(playerid, "komp") == 9999) format(str,sizeof(str),"{cccccc}Определённого Человека\n"), strcat(sctring,str);
    			ShowDialog(playerid,959,DIALOG_STYLE_LIST,"{cccccc}Прослушивание Звонков и СМС",sctring,"Выбрать","Отмена");
 			}
		}
	}
	return 1;
}
CMD:bank(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid, 2.0,1353.9937,1564.5459,1560.8462))
   	{
   	    DP[1][playerid] = 1;
   	    PlayerPlaySound(playerid,40405,0,0,0);
   	    new str[48],sctring[486];
		format(str,sizeof(str),"{ff9000}Информация и Счета"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Обменять {0088ff}Юниты"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Обменять {ff4500}Монеты Континенталь"), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Налоги"), strcat(sctring,str);
		format(str,sizeof(str),"\n{99ff66}Внести {cccccc}Деньги"), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Снять {cccccc}Деньги"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Перевод"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Перевод на счёт Организации"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Перевод на счёт Семьи"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Вывод средств со счёта Организации"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Вывод средств со счёта Семьи"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Вывод средств со счёта Бизнеса"), strcat(sctring,str);
		ShowDialog(playerid,288,DIALOG_STYLE_LIST,"{99ff66}Банк",sctring,"Выбрать","Отмена");
   	}
   	return 1;
}
CMD:bonline(playerid)
{
	if(Komputer[playerid] >= 1)
	{
		DP[1][playerid] = 0;
		new str[48],sctring[486];
		format(str,sizeof(str),"{ff9000}Информация и Счета"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Обменять {0088ff}Юниты"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Обменять {ff4500}Монеты Континенталь"), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Налоги"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Перевод"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Перевод на счёт Организации"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Перевод на счёт Семьи"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Вывод средств со счёта Организации"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Вывод средств со счёта Семьи"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Вывод средств со счёта Бизнеса"), strcat(sctring,str);
		if(PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 && PlayerInfo[playerid][pRank] >= 19 || admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER))
		{
			format(str,sizeof(str),"\n{99ff66}Министерство Финансов"), strcat(sctring,str);
		}
		ShowDialog(playerid,1011,DIALOG_STYLE_LIST,"{99ff66}Банк",sctring,"Выбрать","Отмена");

		// Квест знакомство с ноутбуком
		if(PlayerInfo[playerid][pQuest][9] == 2)
		{
			PlayerInfo[playerid][pQuest][9] = 3;
			PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_note4.mp3");
        	SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Здесь ты можешь переводить деньги и оплачивать налоги");
			SetPVarInt(playerid,"qweststat",39), SetPVarInt(playerid,"qwesttime",4);
		}
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не за компьютером или ноутбуком");
	return 1;
}
