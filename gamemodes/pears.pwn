 	case 1242:
	{
	    if(response)
	    {
	        if(listitem == 2 && (DP[0][playerid] == 2 || DP[0][playerid] == 3 || DP[0][playerid] == 7 || DP[0][playerid] == 9 || DP[0][playerid] == 10 || DP[0][playerid] == 11)) // Отображение
	        {
	            if(PlayerInfo[playerid][pDrawVisible][DP[0][playerid]] == false) // Отключить отображение
				{
					PlayerInfo[playerid][pDrawVisible][DP[0][playerid]] = true;
					if(DP[0][playerid] == 2) PlayerTextDrawHide(playerid, PlayerSiteDraw[0][playerid]), PlayerTextDrawHide(playerid, PlayerSiteDraw[1][playerid]), PlayerTextDrawHide(playerid, PlayerSiteDraw[2][playerid]), PlayerTextDrawHide(playerid, PlayerSiteDraw[3][playerid]);
					else if(DP[0][playerid] == 3) PlayerTextDrawHide(playerid, PlayerSiteDraw[4][playerid]);
					else if(DP[0][playerid] == 7)
					{
					    if(DrawSpeed[playerid] == true) CloseVehSpeed(playerid);
					}
					else if(DP[0][playerid] == 9) HideOldHint(playerid);
					else if(DP[0][playerid] == 10) // Кислород в скафандре
		 	 		{
		 	 			if(gSkafandr[playerid] > 0 && DrawOxygen[playerid] == true)
						{
						    PlayerTextDrawHide(playerid, OxygenDraw[0][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[1][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[2][playerid]);
							PlayerTextDrawDestroy(playerid, OxygenDraw[0][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[1][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[2][playerid]);
							DrawOxygen[playerid] = false;
						}
		 	 		}
					PlayerPlaySound(playerid,6801,0,0,0);
				}
	            else // Включить отображение
				{
					// Название сервера, Время (Блокируем выключение)
					if(DP[0][playerid] == 2 || DP[0][playerid] == 3) 
					{
						if(IsPlayerSyncModels(playerid)) return ErrorText(playerid, "{FF6347}Эту настройку нельзя включить с лаунчера"), setting_draw(playerid);
					}

					PlayerInfo[playerid][pDrawVisible][DP[0][playerid]] = false;
					if(DP[0][playerid] == 2) showsiteserver(playerid);
		 	 		else if(DP[0][playerid] == 3) showtimeserver(playerid);
		 	 		else if(DP[0][playerid] == 7)
		 	 		{
		 	 		    if(DrawSpeed[playerid] == false && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) ShowVehSpeed(playerid);
		 	 		}
		 	 		else if(DP[0][playerid] == 9) // Подсказка двигателя
		 	 		{
		 	 		    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && VehInfo[GetPlayerVehicleID(playerid)][vEngine] == 0) show_hint_player(playerid, GetPlayerVehicleID(playerid));
		 	 		}
		 	 		else if(DP[0][playerid] == 10) // Кислород в скафандре
		 	 		{
		 	 			if(gSkafandr[playerid] > 0)
						{
						    if(DrawOxygen[playerid] == false) CreateOxygenDraw(playerid);
						    PosOxygenDraw(playerid);
						    PlayerTextDrawShow(playerid, OxygenDraw[0][playerid]);
							oxygen_update(playerid, gOxygen[playerid]);
						}
		 	 		}
		 	 		PlayerPlaySound(playerid,6401,0,0,0);
				}
				PlayerInfo[playerid][pDrawUpdate][DP[0][playerid]] = true;
				setting_draw(playerid);
				return 1;
	        }
	        if(listitem == 3 && DP[0][playerid] == 7) // Тип спидометра
	        {
	            if(PlayerInfo[playerid][pTypeSpeed] == 0) PlayerInfo[playerid][pTypeSpeed] = 1;
	            else PlayerInfo[playerid][pTypeSpeed] = 0;
	            PlayerInfo[playerid][pDrawPos_X][7] = 0.0, PlayerInfo[playerid][pDrawPos_Y][7] = 0.0;
				PlayerInfo[playerid][pDrawSize_X][7] = 0.0, PlayerInfo[playerid][pDrawSize_Y][7] = 0.0;
	            if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	            {
	                if(DrawSpeed[playerid] == true)
					{
						CloseVehSpeed(playerid);
						ShowVehSpeed(playerid);
					}
	            }
	            PlayerInfo[playerid][pDrawUpdate][DP[0][playerid]] = true;
	            PlayerPlaySound(playerid,6401,0,0,0);
	            setting_draw(playerid);
				return 1;
	    	}
	    	if(listitem == 2 && DP[0][playerid] == 13) // Цвет Spec Фон
	    	{
				ShowDialog(playerid,1250,DIALOG_STYLE_LIST,"{ff9000}Изменить цвет фона","{ffffff}Стандартный\n{cccccc}Черный\n{cccccc}Белый\n{cccccc}Желтый\n{cccccc}Красный\n{cccccc}Синий\n{cccccc}Фиолетовый\n{cccccc}Зеленый\n{cccccc}Розовый\n{cccccc}Оранжевый","Выбор","Отмена");
				return 1;
	    	}
	    	if(listitem == 3 && DP[0][playerid] == 13) // Цвет Spec Текста
	    	{
				ShowDialog(playerid,1251,DIALOG_STYLE_LIST,"{ff9000}Изменить цвет текста","{ffffff}Черный\n{cccccc}Белый\n{cccccc}Серый","Выбор","Отмена");
				return 1;
	    	}
	    	if(listitem == 4 && DP[0][playerid] == 13) // Кнопка Moore Spec
	        {
	            if(Device[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Недоступно во время игры на смартфоне");
	            if(PlayerInfo[playerid][pAspecBlock3] == false)
				{
					PlayerInfo[playerid][pAspecBlock3] = true;
					if(LoadSP[playerid] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[29][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[30][playerid]);
				}
	            else
				{
					PlayerInfo[playerid][pAspecBlock3] = false;
					if(LoadSP[playerid] == true) PlayerTextDrawShow(playerid, PlayerSpecDraw[29][playerid]), PlayerTextDrawShow(playerid, PlayerSpecDraw[30][playerid]);
				}
	            PlayerPlaySound(playerid,6401,0,0,0);
	            PlayerInfo[playerid][pDrawUpdate][DP[0][playerid]] = true;
	            setting_draw(playerid);
				return 1;
	    	}
	    	
	    	if(Device[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Недоступно во время игры на смартфоне");
	        if(DeskStatus[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Вы за игровым столом казино");
	        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || gSpectateID[playerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	        if(OnlineInfo[playerid][oShowInterface] == 1) return ErrorMessage(playerid, "{FF6347}Закройте инвентарь");
	        if(OnlineInfo[playerid][oShowInterface] == 13) return ErrorMessage(playerid, "{FF6347}Закройте ноутбук");
	        if(OnlineInfo[playerid][oShowInterface] == 12) return ErrorMessage(playerid, "{FF6347}Закройте меню покупок");

			// Название сервера, Время, Подсказка двигателя (Положение или размер)
			if((DP[0][playerid] == 2 
				|| DP[0][playerid] == 3 
				|| DP[0][playerid] == 9)
				&& (listitem == 0 || listitem == 1) && IsPlayerSyncModels(playerid)) return ErrorMessage(playerid, "{FF6347}Эта настройка недоступна с лаунчера");

	        PlayerPlaySound(playerid,40405,0,0,0);
	        TogglePlayerControllable(playerid, false);
	        if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
	        set_pos_x[playerid] = PlayerInfo[playerid][pDrawPos_X][DP[0][playerid]];
     		set_pos_y[playerid] = PlayerInfo[playerid][pDrawPos_Y][DP[0][playerid]];
     		set_size_x[playerid] = PlayerInfo[playerid][pDrawSize_X][DP[0][playerid]];
     		set_size_y[playerid] = PlayerInfo[playerid][pDrawSize_Y][DP[0][playerid]];
	        if(DP[0][playerid] == 0) // Чекер битв
	        {
	            gVidga[playerid] = false; // Чекер каптов Off
	            // Чекер порта сам не обновляется
	            gMifga[playerid] = 9999; // Чекер стрел Off
	            PosGangDraw(playerid);
				PlayerTextDrawBackgroundColour(playerid, PlayerGangDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
	            for(new i = 0; i < 17; i++) PlayerTextDrawShow(playerid, PlayerGangDraw[i][playerid]);
	        }
	        else if(DP[0][playerid] == 1) // Меню взаимодействия
	        {
	            PosInterDraw(playerid);
				PlayerTextDrawBackgroundColour(playerid, PlaInter[0][playerid], PlayerInfo[playerid][pStyle4]);
	            for(new i = 0; i < 5; i++) PlayerTextDrawShow(playerid, PlaInter[i][playerid]);
         	}
         	else if(DP[0][playerid] == 2) // Название сервера
	        {
	            PosSiteDraw(playerid);
	            PlayerTextDrawShow(playerid, PlayerSiteDraw[0][playerid]), PlayerTextDrawShow(playerid, PlayerSiteDraw[1][playerid]), PlayerTextDrawShow(playerid, PlayerSiteDraw[2][playerid]), PlayerTextDrawShow(playerid, PlayerSiteDraw[3][playerid]);
         	}
         	else if(DP[0][playerid] == 3) // Время
	        {
	            PosTimeDraw(playerid);
	            PlayerTextDrawShow(playerid, PlayerSiteDraw[4][playerid]);
         	}
         	else if(DP[0][playerid] == 4) // Ноутбук
	        {
	            create_textdraw_pc(playerid);
	            for(new i = 0; i < 24; i++) PlayerTextDrawShow(playerid, PlayerPcDraw[i][playerid]);
         	}
         	else if(DP[0][playerid] == 5) // Смартфон
	        {
	            create_smartfon_draw(playerid);
	            ShowDetailSmartfon(playerid);
				SmartfonMenu(playerid);
				//PlayerTextDrawShow(playerid, PlayerSmartDraw[29][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[30][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[31][playerid]);
				//PlayerTextDrawShow(playerid, PlayerSmartDraw[41][playerid]);
         	}
         	else if(DP[0][playerid] == 6) // Инвентарь
	        {
	            if(DrawInvent[playerid] == false) create_textdraw_inventory(playerid);
	            invent_draw_settint(playerid);
	            PosInventDraw(playerid);
	        }
	        else if(DP[0][playerid] == 7) // Спидометр
	        {
                if(DrawSpeed[playerid] == false) LoadSpeedDraw(playerid);
                for(new i = 0; i < 10; i++) PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][i]);
	        }
	        else if(DP[0][playerid] == 8) //Меню покупок
	        {
	            create_textdraw_buymenu(playerid);
	            for(new i = 0; i < 4; i ++) PlayerTextDrawShow(playerid, PlayerBuyDraw[i][playerid]);
			    for(new i = 0; i < 16; i ++) PlayerTextDrawShow(playerid, PlayerBuyDraw_Items[i][playerid]);
			    for(new i = 0; i < 5; i ++)
			    {
			        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectFon[i][playerid]);
			        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectPick[i][playerid]);
			        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectName[i][playerid]);
			        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectPrice[i][playerid]);
			    }
	        }
	        else if(DP[0][playerid] == 9) // Подсказка двигателя
	        {
	            PosHintDraw(playerid);
				PlayerTextDrawBackgroundColour(playerid, PlayerHintDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
	            PlayerTextDrawShow(playerid, PlayerHintDraw[0][playerid]), PlayerTextDrawShow(playerid, PlayerHintDraw[1][playerid]);
	        }
	        else if(DP[0][playerid] == 10) // Кислород в скафандре
	        {
	            if(DrawOxygen[playerid] == false) CreateOxygenDraw(playerid);
	            PosOxygenDraw(playerid);
				PlayerTextDrawBackgroundColour(playerid, OxygenDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
	            PlayerTextDrawShow(playerid, OxygenDraw[0][playerid]), PlayerTextDrawShow(playerid, OxygenDraw[1][playerid]), PlayerTextDrawShow(playerid, OxygenDraw[2][playerid]);
	        }
	        else if(DP[0][playerid] == 11) // Система взлома
	        {
	        
	        }
	        else if(DP[0][playerid] == 12) // Раздел уведомлений
	        {

	        }
	        else if(DP[0][playerid] == 13) // Админская система слежки
	        {
	            if(LoadSP[playerid] == false) LoadSpecDraw(playerid);
	            for(new i = 0; i < 31; i ++) PlayerTextDrawShow(playerid, PlayerSpecDraw[i][playerid]);
	            if(PlayerInfo[playerid][pAspecBlock1] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[10][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[11][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[13][playerid]);
	            if(PlayerInfo[playerid][pAspecBlock2] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[17][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[18][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[19][playerid]);
	            if(PlayerInfo[playerid][pAspecBlock3] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[29][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[30][playerid]);
	        }
	        
	        if(listitem == 0) setting_pos_draw[playerid] = DP[0][playerid]+1; // Положение
	        else if(listitem == 1) setting_size_draw[playerid] = DP[0][playerid]+1; // Размер
	        TextDrawShowForPlayer(playerid, WasdDraw[0]);
	        TextDrawShowForPlayer(playerid, WasdDraw[1]);
	        TextDrawShowForPlayer(playerid, WasdDraw[2]);
	        TextDrawShowForPlayer(playerid, WasdDraw[3]);
	        TextDrawShowForPlayer(playerid, WasdDraw[4]);
     	}
     	else pc_cmd_textdraw(playerid);
	}
	case 1243:
	{
	    if(response)
	    {
 	        if(PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Вы не администратор");
 	        if(gSpectateID[playerid] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы не следите за игроком");
 	        if(!IsOnline(gSpectateID[playerid])) return ErrorMessage(playerid, "{FF6347}Игрок, за которым вы следили, отключился");
 	        if(listitem == 0)
 	        {
 	            if(PlayerInfo[gSpectateID[playerid]][pReportStat] >= 1) format(string, sizeof(string), "%d", gSpectateID[playerid]), pc_cmd_re(playerid, string);
 	            else pc_cmd_admin(playerid), PlayerPlaySound(playerid,4203,0,0,0);
          	}
 	        if(listitem == 1) format(string, sizeof(string), "%d", gSpectateID[playerid]), pc_cmd_check(playerid, string);
 	        if(listitem == 2) ShowDialog(playerid,1244,DIALOG_STYLE_INPUT,"{ff9000}Kick","{cccccc}Введите причину Kick\n{cccccc}1 - 64 символа","Принять","Отмена");
 	        if(listitem == 3) ShowDialog(playerid,1245,DIALOG_STYLE_INPUT,"{ff9000}Mute","{cccccc}Введите время Mute и причину через запятую {ff9000}[Пример: 30, Offtop]\n{cccccc}1 - 64 символа","Принять","Отмена");
 	        if(listitem == 4) ShowDialog(playerid,1246,DIALOG_STYLE_INPUT,"{ff9000}Prison","{cccccc}Введите время Prison и причину через запятую {ff9000}[Пример: 60, Дм]\n{cccccc}1 - 64 символа","Принять","Отмена");
 	        if(listitem == 5) ShowDialog(playerid,1247,DIALOG_STYLE_INPUT,"{ff9000}Warn","{cccccc}Введите причину Warn\n{cccccc}1 - 64 символа","Принять","Отмена");
 	        if(listitem == 6) ShowDialog(playerid,1248,DIALOG_STYLE_INPUT,"{FF6347}Ban","{cccccc}Введите срок Ban и причину через запятую {ff9000}[Пример: 14, Читы]\n{cccccc}1 - 64 символа","Принять","Отмена");
 	        if(listitem == 7) ShowDialog(playerid,1249,DIALOG_STYLE_INPUT,"{ff9000}Amute","{cccccc}Введите время Amute на обращение и причину через запятую {ff9000}[Пример: 60, Offtop]\n{cccccc}1 - 64 символа","Принять","Отмена");
     	}
	}
	case 1244:
	{
	    if(response)
	    {
 	        if(PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Вы не администратор");
 	        if(gSpectateID[playerid] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы не следите за игроком");
 	        if(!IsOnline(gSpectateID[playerid])) return ErrorMessage(playerid, "{FF6347}Игрок, за которым вы следили, отключился");
            if(!strlen(inputtext) || strlen(inputtext) > 64 || strlen(inputtext) <= 0) return ShowDialog(playerid,1244,DIALOG_STYLE_INPUT,"{ff9000}Kick","{cccccc}Введите причину Kick\n{cccccc}1 - 64 символа","Принять","Отмена");
            format(string, sizeof(string), "%d %s", gSpectateID[playerid], inputtext);
			pc_cmd_kick(playerid, string);
     	}
	}
