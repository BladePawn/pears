const ClientjoinRpcId = 25;
IRPC:ClientjoinRpcId(playerid, BitStream:bs) 
{
	// NPC пропускаем пакеты
	if(IsARealNPC(playerid)) return true;

    new value;
    new size;
    BS_GetNumberOfBitsUsed(bs, size);
    BS_SetReadOffset(bs, size - 32);
    BS_ReadUint32(bs, value);
    new valid = value == 0x69BE00AE;
    if (!valid) {
        BS_SetReadOffset(bs, size - 32 - 32 - 8 - 8);
        BS_ReadUint32(bs, value);
        valid = value == 0x69BE00AE;
		// Фикс для sampvoice
    }
    SetPlayerSyncModels(playerid, bool:valid);

	// Игрок зашёл с лаунчера, отключаем отображение названия в худе
	if(IsPlayerSyncModels(playerid)) PlayerInfo[playerid][pDrawVisible][2] = false;
	return true;
}


// Отключаем отображение аксессуаров (некоторых)
const RPC_SetPlayerAttachedObj = 113;
ORPC:RPC_SetPlayerAttachedObj(playerid, BitStream:bs) 
{
    if (playerid == -1) return true;
    new playeridon;
    new slotid;
    new is_create;
    new modelid;
    BS_ReadUint16(bs, playeridon);
    BS_ReadUint32(bs, slotid);
    BS_ReadBool(bs, is_create);
    if (!is_create) return true;
    BS_ReadUint32(bs, modelid);

	if(modelid == 18978 || modelid == 1010) // Детали скафандра
	{
    	if(!ShouldDisplayAttachedPlayerObj(playerid, playeridon)) return false;
	}

	// Игроку без лаунчера не отображаем кастомные аксессуары
	if(IsCustomObject(modelid) && !IsPlayerSyncModels(playerid)) return false;
    return true;
}

