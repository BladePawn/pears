stock weapon_class(weaponid)
{
	new category;
	switch(weaponid)
	{
	    case 22, 23, 24, 25, 26, 33: category = 1; // Простенькие пистолеты, дробовики и винтовка
	    case 16, 17, 27..32, 34: category = 2; // Гранаты, автоматы, полуавтоматы
	    case 18, 35, 36, 37, 38: category = 3; // Запрещённое, жёсткое оружие взрывоопасное и пожароопасное
	    default: category = 0;
 	}
	return category;
}
CMD:inv(playerid)
{
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(fraction(playerid) >= 1 && Kapt[fraction(playerid)] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Меня могут убить свои, если я избавлюсь от банданы во время битвы");
	SetPlayerColor(playerid,INV_COLOR);
	return 1;
}

CMD:offcol(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 10) return  ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(fraction(playerid) >= 1 && Kapt[fraction(playerid)] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Меня могут убить свои, если я избавлюсь от банданы во время битвы");
	SetPlayerColor(playerid, NONE_COLOR);
	return 1;
}

CMD:world(playerid)
{
	new string[24];
 	format(string, sizeof(string), "Виртуальный мир: %d",GetPlayerVirtualWorld(playerid));
 	SendClientMessage(playerid,COLOR_WHITE,string);
 	return 1;
}

function Call_agiverank(playerid, const str_name[], param)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datad[4], fam, string[180];
		cache_get_value_name_int(0, "Member", datad[0]);
		cache_get_value_name_int(0, "Leader", datad[1]);
		cache_get_value_name_int(0, "user_id", datad[2]);
		cache_get_value_name_int(0, "Rank", datad[3]);
		cache_get_value_name_int(0, "Family", fam);
		new frakid;
		if(datad[1] >= 1) frakid = datad[1];
		else if(datad[1] == 0) frakid = datad[0];
  		if(datad[0] == 0 && datad[1] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он нигде не состоит");
  		format(string, sizeof(string), "Вы выдали %s ранг %d.", str_name,param);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Rank`='%d',`LastRank`='%d' WHERE `user_id`='%d'", param,datad[3], datad[2]);
		query_empty(pearsq, string);
		OrgLog(frakid, "agiverank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad[2], str_name, "", param, "");
		format(string, sizeof(string), "Ваш ранг в организации изменён с %d на %d", datad[3], param);
		if(param > datad[3]) FamilyInfo[fam][fInfluence] += param*CallBackRankPoint(frakid) - datad[3]*CallBackRankPoint(frakid);
		else if(param < datad[3]) FamilyInfo[fam][fInfluence] -= datad[3]*CallBackRankPoint(frakid) - param*CallBackRankPoint(frakid);
		FamilyInfo[fam][fUpdate] = 1;
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad[2], str_name, string);
 	}
 	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
 	return 1;
}

alias:agiverank("ag", "agr")
CMD:agiverank(playerid, const params[])
{
	if(PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pSoska] >= 10)
	{
	    new tmp[24], para1,level;
	    if(sscanf(params, "s[24]i",tmp,level)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить ранг [ /agiverank ID Ранг ]");
		if(level > 30 || level < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ранг не меньше 1 и не больше 30");
		new string[200];
	 	para1 = ReturnUser(tmp, 1);
	 	if(IsOnline(para1))
	  	{
	  		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	  		if(PlayerInfo[para1][pMember] == 0 && PlayerInfo[para1][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он нигде не состоит");
	  		if(PlayerInfo[playerid][pHidden] > 0 && playerid != para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Могу изменить только свой ранг");

			PlayerInfo[para1][pRank] = level;
			SetRaitingSektaInFrak(para1,PlayerInfo[para1][pMember],level);
			format(string, sizeof(string), "Вам был выдан %d ранг администратором %s.",level, PlayerInfo[playerid][pName]);
			SendClientMessage(para1, COLOR_LIGHTBLUE, string);
			format(string, sizeof(string), "Вы выдали %s ранг %d.", PlayerInfo[para1][pName],level);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			OrgLog(fraction(para1), "agiverank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], level, "");
		
			if(PlayerInfo[para1][pHidden] == 0) GiverankPlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pMember], PlayerInfo[para1][pRank]);
		}
		else
		{
			if(PlayerInfo[playerid][pHidden] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Могу изменить только свой ранг");
			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			if(checksimvol(tmp)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	  		mysql_format(pearsq, string, sizeof(string),"SELECT user_id, Member, Leader, Rank, Family FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	  		mysql_tquery(pearsq, string, "Call_agiverank", "dsd", playerid, tmp, level);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	return 1;
}

alias:auninvite("au")
CMD:auninvite(playerid, const params[])
{
	if(PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pSoska] >= 10)
	{
		new tmp[24], para1;
	    if(sscanf(params, "s[24]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Уволить игрока из организации [ /auninvite ID ]");
	    new string[144];
	    para1 = ReturnUser(tmp, 1);
	 	if(IsOnline(para1))
	 	{
			if(CheckPlayerNpc(playerid, para1)) return 1;
		    if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		    if(PlayerInfo[para1][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это лидер..");
		    if(PlayerInfo[para1][pMember] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он нигде не состоит");
		    if(PlayerInfo[playerid][pSoska] < 10 && playerid != para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Могу уволить только себя");

			AUninvitePlayer(playerid, para1, 0);
		}
		else
		{
		    if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Могу уволить только себя");
			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	  		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp, 36, 0);
		}
 	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	return 1;
}

stock AUninvitePlayer(playerid, userid, disband)
{
	new string[144];
	format(string, sizeof(string), " Игрок %s уволен из организации.", PlayerInfo[userid][pName]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	AdminLog("auninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[userid][pID], PlayerInfo[userid][pName], PlayerInfo[userid][pPlaIP], PlayerInfo[userid][pMember], "");
	OrgLog(PlayerInfo[userid][pMember], "auninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[userid][pID], PlayerInfo[userid][pName], PlayerInfo[userid][pPlaIP], 0, "");
	if(PlayerInfo[playerid][pHidden] == 0)
	{
		format(string, sizeof(string), "* Администратор %s уволил вас из организации.", PlayerInfo[playerid][pName]);
		SendClientMessage(userid, COLOR_LIGHTBLUE, string);
		format(string, sizeof(string),"{FF0000}[!!!] Вас уволил из организации Администратор %s.\n\n{0088ff}** Вы снова гражданский. Можете вступить в другую организацию.", PlayerInfo[playerid][pName]);
		ShowDialog(userid, 2018, 0, "{FF0000}**** {0088ff}Вы были Уволены! {FF0000}****", string, "Ок", "");
		if(!disband)
		{
			format(string, sizeof(string), " [ ADM ]: Админ %s уволил из организации %s",PlayerInfo[playerid][pName], PlayerInfo[userid][pName]);
			ABroadCast(COLOR_ADM,string,1);
		}
	}
	else
	{
		SendClientMessage(userid, COLOR_LIGHTBLUE, "* Скрытый администратор уволил вас из организации.");
		ShowDialog(userid, 2018, 0, "{FF0000}**** {0088ff}Вы были Уволены! {FF0000}****", "{FF0000}[!!!] Вас уволил из организации скрытый администратор.\n\n{0088ff}** Вы снова гражданский. Можете вступить в другую организацию.", "Ок", "");
	}
	Uninvite(userid,0);
	SetRaitingSektaInFrak(userid,0,0);
}

alias:ainvite("ai")
CMD:ainvite(playerid, const params[])
{
	if(PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pSoska] >= 10)
	{
	    new tmp[24], para1, string[256];
	    if(sscanf(params, "s[24]i",tmp,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поместить игрока в организацию [ /ainvite ID Номер ]");
	    if(params[1] > 22 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер организации не меньше 1 и не больше 22");
	 	para1 = ReturnUser(tmp, 1);
	 	if(IsOnline(para1))
	 	{
			if(CheckPlayerNpc(playerid, para1)) return 1;
		 	if(PlayerInfo[playerid][pSoska] < 10 && playerid != para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Могу пригласить только себя");
	 		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
			if(PlayerInfo[para1][pMember] >= 1 && playerid != para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок уже где-то состоит");
		  	if(PlayerInfo[para1][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GRAY, "[ Мысли ]: Это лидер..");
			if(PlayerInfo[para1][pWarns] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него проблемы с документами [2+ Warns]");

		  	if(params[1] == 2 && server > 0)
		  	{
		    	if(!strcmp(PlayerInfo[para1][pMail],"\0",true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него проблемы с документами [Не привязан Email] [ Y >> Аккаунт >> Email ]");
		    	else if(PlayerInfo[para1][pMailStat] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него проблемы с документами [Не подтверждён Email] [ Y >> Аккаунт >> Email ]");
    		}

			if((params[1] == 5 // Cosa Nostra
				|| params[1] == 8 // ICA
				|| params[1] == 10 // Triada
				|| params[1] == 11 // SFPD
				|| params[1] == 12 // RM
				|| params[1] == 17 // Rifa
				|| params[1] == 19 // none
				|| params[1] == 20 // none
				|| params[1] == 21 // none
				|| params[1] == 22) // none
				&& PlayerInfo[playerid][pSoska] < 19) return ErrorMessage(playerid,"{ff6347}Организация закрыта");

			if (PlayerInfo[para1][pMember] > 0 && para1 == playerid) {
				// Увольняем игрока перед тем, как инвайтнуть
				new para1_str[5]; valstr(para1_str, para1);
				pc_cmd_auninvite(playerid, para1_str);
				HidePlayerDialog(para1);
			}

			format(string, sizeof(string), "* Вы поместили %s в %s.", PlayerInfo[para1][pName], frakName[params[1]]);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			format(string, sizeof(string), "* Админ %s поместил вас в %s.", PlayerInfo[playerid][pName], frakName[params[1]]);
			SendClientMessage(para1, COLOR_LIGHTBLUE, string);
			AdminLog("ainvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], params[1], "");
			OrgLog(params[1], "ainvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "");
			if(PlayerInfo[playerid][pHidden] == 0)
			{
				format(string, sizeof(string), " [ ADM ]: Админ %s поместил %s в %s",PlayerInfo[playerid][pName], PlayerInfo[para1][pName], frakName[params[1]]);
				ABroadCast(COLOR_ADM,string,1);
			}
			PlayerInfo[para1][pMember] = params[1];
			PlayerInfo[para1][pRank] = 1;
			PlayerInfo[para1][pVig] = 0;
			DelUpdate(para1);
			SetPlayerToTeamColor(para1);
			ResetPlayerContinentalCoins(para1);
			PlayerInfo[para1][pUnit] = 0;
			resetPlayerTransmitter(para1); // Сбрасываем чтение раций
			mysql_save(para1, 41);
			Onli[params[1]] ++;

			if(PlayerInfo[para1][pHidden] == 0) InvitePlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pMember]);

			// Загружаем личные сохранения капта
			if(IsAGangCapt(para1)) OnLoadPlayerCapt(para1);

			// Запускаем чекер каптов
			if(Kapt[fraction(para1)] >= 1) GiveUpdate(para1, Kapt[fraction(para1)]);

			// Настройки сеткы
			SetRaitingSektaInFrak(para1,params[1],1);
		}
		else
		{
			if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Могу пригласить только себя");
			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	  		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,35,params[1]);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	return 1;
}
CMD:cc(playerid, const params[])
{
 	if(PlayerInfo[playerid][pSoska] >= 2)
    {
		ClearChatboxAll(50);
		if(!strcmp(params[0],"\0",true)) // Пустая строка после /cc, значит отображаем в чат инфу
		{
			AllMessage(COLOR_GREY, "{FFFFFF}***** {0088ff}АнтиРеклама {FFFFFF}*****");
			new string[128];
			format(string, sizeof(string), " [ ADM ]: Админ %s полностью очистил чат",PlayerInfo[playerid][pName]);
			ABroadCast(COLOR_ADM,string,1);
		}
		AdminLog("cc", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
    }
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
CMD:ccgro(playerid, const params[])
{
 	if(PlayerInfo[playerid][pSoska] >= 2)
    {
 	  foreach (Player, i)
      {
		if(GetDistanceBetweenPlayers(playerid,i) < 100 && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i)){ ClearChatbox(i, 50); SendClientMessage(i, COLOR_GREY, "{FFFFFF}***** {0088ff}АнтиРеклама {FFFFFF}*****");}
      }
 	  new string[256];
 	  format(string, sizeof(string), " [ ADM ]: Админ %s очистил чат у игроков в радиусе 100 метров от себя",PlayerInfo[playerid][pName]);
      ABroadCast(COLOR_ADM,string,1);
      AdminLog("ccgro", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
    }
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}

CMD:colors(playerid, const params[])
{
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/red , /grey , /green , /yellow , /white /darkred");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/blue , /lightblue , /orange , /lime , /magenta");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/navy , /aqua , /crimson , /flblue , /bisque");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/chartreuse , /brown , /coral");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/greenyellow , /indigo , /ivory , /lawngreen , /limegreen");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/midnightblue , /maroon , /olive , /orangered , /pink");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/springgreen , /tomato , /yellowgreen , /mediumaqua");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/mediummagenta , /brightred , /system , /purple /col1 /col2 /col3 ");
   SendClientMessage(playerid,COLOR_MEDIUMAQUA,"/col4 /col6 /col7 /col8 /col9 /col10 /col11 /col12 /col13");
   return 1;
}
CMD:col1(playerid, const params[])
{
   if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
   if(fraction(playerid) >= 1 && Kapt[fraction(playerid)] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Меня могут убить свои, если я избавлюсь от банданы во время битвы");
   SetPlayerColor(playerid, 0xc8ff00AA);
   return 1;
}
