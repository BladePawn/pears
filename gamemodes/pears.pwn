public IsASpawn(playerid)
{
	new Float:posic[3];
	GetPlayerPos(playerid, posic[0], posic[1], posic[2]);

	if((IsPlayerInSquare(playerid,241.358673,1921.386718,404.748291,2096.010742)
		|| IsPlayerInSquare(playerid,241.358673,1779.353759,344.778442,1921.386718)
		|| IsPlayerInSquare(playerid,169.348632,1799.196411,241.358673,2035.997436)
		|| IsPlayerInSquare(playerid,117.278594,1799.196411,169.348632,2002.516479)
		|| IsPlayerInSquare(playerid,97.038513,1810.563476,117.278594,1940.756347)) && posic[2] >= -30.0 && posic[2] <= 100.0) return 3; // NGSA

	else if(IsPlayerInSquare(playerid,1084.77539, -2080.62085, 1283.27539, -1993.12085) && posic[2] >= 20.0 && posic[2] <= 300.0) return 5; // Cosa Nostra
	else if(IsPlayerInSquare(playerid,1250.36121, 663.48871, 1557.95618, 797.21545) && posic[2] >= -5.0 && posic[2] <= 200.0) return 6; // Yakuza Mafia
	else if(IsPlayerInSquare(playerid,-1509.22339, 838.14691, -1427.64209, 1012.41260) && posic[2] >= -5.0 && posic[2] <= 200.0) return 10; // Triada Mafia
	else if(IsPlayerInSquare(playerid,-2064.26001, 1089.20813, -1976.81262, 1143.04004) && posic[2] >= 10.0 && posic[2] <= 300.0) return 12; // Russian Mafia
	else if(IsPlayerInSquare(playerid,2440.98096, -1721.82190, 2540.24585, -1629.10376) && posic[2] >= -5.0 && posic[2] <= 200.0) return 13; // Респа Grove
	else if(IsPlayerInSquare(playerid,2423.67236, -2036.77197, 2539.92603, -1981.77014) && posic[2] >= -5.0 && posic[2] <= 200.0) return 14; // Респа Ballas
	else if(IsPlayerInSquare(playerid,2222.49585, -1473.56445, 2281.08154, -1393.50867) && posic[2] >= -5.0 && posic[2] <= 200.0) return 15; // Респа Vagos
	else if(IsPlayerInSquare(playerid,1659.66101, -2156.76001, 1813.76941, -2077.98901) && posic[2] >= -5.0 && posic[2] <= 200.0) return 16; // Респа Los Aztecas
	else if(IsPlayerInSquare(playerid,-618.36157, 2527.39136, -489.86160, 2660.39136) && posic[2] >= 20.0 && posic[2] <= 300.0) return 18; // Arabian Mafia
	return 0;
}

