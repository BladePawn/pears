CMD:minfin(playerid) // Министерство Финансов
{
	if(Komputer[playerid] == 0 && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Используйте компьютер или ноутбук");

	new g = fraction(playerid);
	if(!IsAFunctionOrganization(62, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 62, NO_FBI)) return 1;
	//if(PlayerInfo[playerid][pTaxesUnix] < gettime() && PlayerInfo[playerid][pSoska] < 14) return ErrorMessage(playerid, "{FF6347}У вас нет доступа на редактирование, обратитесь к следящей администрации");
	new str[94],sctring[324],glave_str[MAX_BIGINT_LEN];
	bigint_get_str(OrganInfo[7][glave], glave_str);
	format(str,sizeof(str),"{cccccc}Государственная Казна \t {99ff66}%s$ [%s]", glave_str, get_k(OrganInfo[7][glave])), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Налоги"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Цены"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Зарплаты"), strcat(sctring,str);
	ShowDialog(playerid,516,DIALOG_STYLE_TABLIST,"{66ff66}Министерство Финансов",sctring,"Выбрать","Отмена");
	return 1;
}

alias:treasury("goskazna")
CMD:treasury(playerid) // Государственная Казна
{
	if(Komputer[playerid] == 0 && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Используйте компьютер или ноутбук");
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(62, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 62, NO_FBI)) return 1;

	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{66ff66}Министерство Финансов","{cccccc}Загрузка информации...","*","");

	mysql_pquery(pearsq_2,
		"SELECT SUM(`row`) AS total, convertCharset(`rows`, \'utf-8\', \'windows-1251\') AS rows_1251" \
		"	FROM `sysinternal_logs`" \
		"	WHERE `action` = 'treasury' AND `timestamp` > (NOW() - 86400)" \
		"	GROUP BY `rows`" \
		"	ORDER BY total DESC", "Call_treasury", "d", playerid);

	return 1;
}

function Call_treasury(playerid)
{
	new str[256],sctring[3072],glave_str[BIGINT_BUF_SIZE];
	bigint_get_str(OrganInfo[7][glave], glave_str);
	format(str,sizeof(str),"{cccccc}Введите сумму, которую хотите перечислить на свой банковский счёт"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Счёт Казны: {99ff66}%s$ [%s]", glave_str, get_k(OrganInfo[7][glave])), strcat(sctring,str);

	format(str,sizeof(str),"\n\n{99ff66}Пополнения Казны за 24 часа:"), strcat(sctring,str);

	new BigInt:total_treasury_profits = bigint_create(0);
	new rows_num = cache_num_rows();
	for (new i = 0; i < rows_num; i++)
	{
		new name[256];
		new amount_str[BIGINT_BUF_SIZE];
		cache_get_value_name(i, "rows_1251", name);
		cache_get_value_name(i, "total", amount_str);
		new BigInt:amount = bigint_create_str(amount_str);
		format(str,sizeof(str),"%s{cccccc}%s — %s$ [%s]", (((i % 2) != 0 && rows_num > 5) ? ", " : "\n"), name, amount_str, get_k(amount)), strcat(sctring,str);
		bigint_add_bi(total_treasury_profits, amount);
		bigint_destroy(amount);
	}
	{
		new total_treasury_profits_str[BIGINT_BUF_SIZE];
		bigint_get_str(total_treasury_profits, total_treasury_profits_str);
		format(str,sizeof(str),"\n{cccccc}Итоговый заработок казны — %s$ [%s]", total_treasury_profits_str, get_k(total_treasury_profits)), strcat(sctring,str);
	}
	bigint_destroy(total_treasury_profits);

	format(str,sizeof(str),"\n\n{444444}- Вы можете использовать средства, чтобы переводить на счета организаций в качестве зарплат"), strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}- Вы можете использовать средства для проведения мероприятий"), strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}- Запрещено использовать деньги казны в личных целях: {FF6347}BAN 14 Дней + Удаление Аккаунта"), strcat(sctring,str);
	ShowDialog(playerid,521,DIALOG_STYLE_INPUT,"{66ff66}Министерство Финансов",sctring,"Принять","Отмена");

	return 1;
}

