        		if(Kapt[org] >= 1 || Strel[org] >= 1 || Zahvat[org] >= 1) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Нельзя начать зачистку организации во время её активного боя"), pc_cmd_zachistka(playerid, "");
