stock IsAMarket(playerid) // Рынок
{
	new Float:market_pos[3], market = -1;
	for(new m = 0; m < MARKET; m++)
	{
		GetDynamicObjectPos(MarketObject[m], market_pos[0], market_pos[1], market_pos[2]);
		if(IsPlayerInRangeOfPoint(playerid,3.0,market_pos[0], market_pos[1], market_pos[2]))
		{
			market = m;
			break;
		}
	}
	return market;
}
stock IsAAntidm(playerid)
{
	if(Iamzz[playerid]) return 1;
	else return 0;
}
public IsAGov(playerid)
{
	// Старая система без компов
	if(IsPlayerInRangeOfPoint(playerid,2.0,-1749.1069,782.6432,930.1409) // CNN
		|| IsPlayerInRangeOfPoint(playerid,2.0,-535.3270,-93.7740,969.1864) // ICA
	)
	{

		return 1;
	}

	new world = GetPlayerVirtualWorld(playerid), interior = GetPlayerInterior(playerid);
	for(new pc = 0; pc < sizeof(PcPos); ++pc)
	{
		if(PcPos[pc][PcGov] == 0) continue;
		if(IsPlayerInRangeOfPoint(playerid,1.4, PcPos[pc][PcPos_X], PcPos[pc][PcPos_Y], PcPos[pc][PcPos_Z])
			&& (PcPos[pc][PcWorld] == -1 || PcPos[pc][PcWorld] == world)
			&& (PcPos[pc][PcInt] == -1 || PcPos[pc][PcInt] == interior))
		{
			return 1;
		}
	}
	return 0;
}
//==============================================================================
//===================[ AgetCar Транспорт Подлежащий Удалению ]==================
stock IsAAgetcar(vehicleid)
{
	if(Cars[vehicleid] == 55 || Cars[vehicleid] == 109 || Cars[vehicleid] == 108 || Cars[vehicleid] == 4 || Cars[vehicleid] == 3
	|| Cars[vehicleid] == 1|| Cars[vehicleid] == 2 || Cars[vehicleid] == 11 || Cars[vehicleid] == 7 || Cars[vehicleid] == 9
 	|| Cars[vehicleid] == 5 || Cars[vehicleid] == 6 || Cars[vehicleid] == 10 || Cars[vehicleid] == 12 || Cars[vehicleid] == 13
 	|| Cars[vehicleid] == 14 || Cars[vehicleid] == 15 || Cars[vehicleid] == 16 || Cars[vehicleid] == 18
	|| Cars[vehicleid] == 22 || Cars[vehicleid] >= 1000 && Cars[vehicleid] <= 2000){return 1;}
	return 0;
}
stock IsAGun(model)
{
    if(model >= 1 && model <= 18 || model >= 22 && model <= 46) { return 1; }
    return 0;
}
stock LoadTunning(vehicleid)
{
	if(VehInfo[vehicleid][vComp2] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp2]);
	if(VehInfo[vehicleid][vComp3] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp3]);
	if(VehInfo[vehicleid][vComp4] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp4]);
	if(VehInfo[vehicleid][vComp1] != 999) ChangeVehiclePaintjob(vehicleid, VehInfo[vehicleid][vComp1]);
 	if(IsATun(VehInfo[vehicleid][vModel])) // Доступный тюнинг
 	{
  		if(VehInfo[vehicleid][vComp5] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp5]); // Передний Бампер
  		if(VehInfo[vehicleid][vComp6] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp6]); // Задний Бампер
  		if(VehInfo[vehicleid][vComp7] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp7]); // Пороги
  		if(VehInfo[vehicleid][vComp8] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp8]); // Пороги 2
  		if(VehInfo[vehicleid][vComp11] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp11]); // Крыша
  		if(VehInfo[vehicleid][vComp9] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp9]); // Спойлер
  		if(VehInfo[vehicleid][vComp10] != 0) AddVehicleComponent(vehicleid, VehInfo[vehicleid][vComp10]); // Глушитель
	}
	return 1;
}

stock SlivApartments(r)
{
	ApartmentsRoom[r][aprTaxes] = 0;
	ApartmentsRoom[r][aprTaxday] = 0;
	ApartmentsRoom[r][aprOwn] = 0;
	ApartmentsRoom[r][aprSellOwn] = 0;
	ApartmentsRoom[r][aprStatus] = 0;
    strmid(ApartmentsRoom[r][aprOwnName], "Нет", 0, strlen("Нет"), 255);
    UpdateLabelApartments(r);
    SaveApartmentsRoom(r);
	return 1;
}

public OnIncomingConnection(playerid, ip_address[], port)
{
    // Если подключается NPC - пропустим его.
    if (IsPlayerNPC(playerid)) return 1;

    // Упакуем строку с адресом в число. Сравнение чисел происходит быстрее, чем сравнение строк, и если
    // на сервере много игроков, время на упаковку в число компенсируется более быстрым поиском адреса.
    new o1, o2, o3, o4, quan_connect;
    sscanf(ip_address, "p<.>iiii", o1, o2, o3, o4);
    new c = (o1 << 24) | (o2 << 16) | (o3 << 8) | o4;

    foreach(Player,i)
	{
        // Если под этим IP есть подключения, считаем их
        if (c == anti_reconnect_ips[i])
        {
        	quan_connect ++;
        	if(quan_connect >= 20)
        	{
            	BlockIpAddress(ip_address, 300000);
            	printf("[SProtect Ban IP]: Адрес \"%s\" заблокирован на 5 минут (OnIncomingConnection)", ip_address);
           	 	break;
     	 	}
        }
    }
    anti_reconnect_ips[playerid] = c;
	return 1;
}

