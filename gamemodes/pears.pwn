				if(DomInfo[nd][dFam] >= 1) return format(string, sizeof(string), "[ Мысли ]: Мой дом уже синхронизирован с семьей %s {cccccc}№%d", FamilyInfo[DomInfo[nd][dFam]][fName],DomInfo[nd][dFam]), SendClientMessage(playerid, COLOR_GREY, string);
