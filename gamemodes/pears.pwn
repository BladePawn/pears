						if(IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleSeat(playerid) >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя доставать оружие в транспорте");
						if(fpara <= 0) return ErrorMessage(playerid, "{FF6347}Дробовик испорчен");
						TakeInvent(playerid, 27, quan, 0, 999, false);
						TakeInvent(playerid, weapon, quan, 1, inva, false);
						Protect_GiveWeapons(playerid, weapon, quan, fpara, fqara);
					}
					else if(weaponType == 2 || weaponType == 3)
					{
						if(get_invent4(playerid, 28, 0) < quan) return ErrorMessage(playerid, "{FF6347}У вас нет такого количества патронов к пистолету {cccccc}[ Ammo 11,43mm ]");
