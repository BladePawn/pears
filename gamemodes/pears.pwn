		        	case 1: agetvelo[playerid] = PP_CreateVehicle(464,-1403.9031, 494.2949, 17.6195,90.0,1,1,600,0, -1, 0.0);
		        	case 2: agetvelo[playerid] = PP_CreateVehicle(464,-1403.9031, 497.2949, 17.6195,90.0,1,1,600,0, -1, 0.0);
		    	}
  			}
  			else if(IsPlayerInRangeOfPoint(playerid,3.0, 115.5103,1827.9005,21.8356))
			{
				bespiload[playerid] = 2;
		    	switch(random(3))
		    	{
		        	case 0: agetvelo[playerid] = PP_CreateVehicle(464,313.0963, 2043.6115, 17.0216, 180.0000,1,1,600,0, -1, 0.0);
		        	case 1: agetvelo[playerid] = PP_CreateVehicle(464,307.5963, 2043.6115, 17.0216, 180.0000,1,1,600,0, -1, 0.0);
		        	case 2: agetvelo[playerid] = PP_CreateVehicle(464,302.0963, 2043.6115, 17.0216, 180.0000,1,1,600,0, -1, 0.0);
		    	}
  			}
	    	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Закончить Полёт [ {ff0000}CAPS LOCK (Гудок) {cccccc}]");
	   		GetVehicleParamsEx(agetvelo[playerid],engine,lights,alarm,doors,bonnet,boot,objective);
	   		SetVehicleParamsEx(agetvelo[playerid],true,true,alarm,doors,bonnet,boot,objective);
		    Protect_PutPlayerInVehicle(playerid, agetvelo[playerid], 0);
		    VehInfo[agetvelo[playerid]][vAgetid] = playerid;
		    Cars[agetvelo[playerid]] = 55;
		    LockCar(agetvelo[playerid],0);
		    bespilot[playerid] = agetvelo[playerid]; // Управляет беспилотником
	    }
	    else ErrorMessage(playerid, "{FF6347}Вы не имеете доступа к беспилотнику ВВС");
   }
   return 1;
}
CMD:update(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new string[98];
	format(string, sizeof(string), " [ ADM ]: Админ {ff0000}%s {ffcc33}запустил сохранение сервера и аккаунтов", PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
	AdminLog("update", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	SaveAccounts();
	return 1;
}
