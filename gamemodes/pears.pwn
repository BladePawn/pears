			new b = DP[0][playerid], color, model, item = DP[1][playerid];
			if(BizzInfo[b][bItem][item]-BizzInfo[b][bUseItem][item] <= 0) return ErrorMessage(playerid, "{FF6347}Этого катера нет в наличии");
			if(oGetPlayerMoney(playerid) < BizzInfo[b][bPrice][item]) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
			if(DP[1][playerid] == 0) model = 452;
			else if(DP[1][playerid] == 1) model = 453;
			if(check_lic(playerid, model) == 0) return 0;
   			if(listitem == 0) color = 135;
   			if(listitem == 1) color = 137;
   			if(listitem == 2) color = 6;
   			if(listitem == 3) color = 3;
   			if(listitem == 4) color = 0;
   			if(listitem == 5) color = 1;
   			new Float:pos[4], newcar;
   			getcreaterent(b, pos[0], pos[1], pos[2], pos[3]);
			newcar = PP_CreateVehicle(model,pos[0],pos[1],pos[2],pos[3],color,1,600,0, -1, 0.0);
			if(katerpos <= 2) katerpos ++;
			else katerpos = 0;
  			VehInfo[newcar][vGas] = GasMax / 2;
   			VehInfo[newcar][vAgetid] = playerid;
   			VehInfo[newcar][vRent] = gettime()+3600;
   			VehInfo[newcar][vBiz] = b;
   			VehInfo[newcar][vBizItem] = item;
   			Cars[newcar] = 53;
   			new tyear, tmonth, tday, thour, tminute, tsecond;
 			stamp2datetime(VehInfo[newcar][vRent], tyear, tmonth, tday, thour, tminute, tsecond, 3);

			ReloadVehicleLabel(newcar); // Перезагружаем лейбл на тс
   			VehInfo[newcar][v3dstat] = 4000;
			format(string,sizeof(string),"{cccccc}Аренда до {0088ff}%02d:%02d\n{444444}%s", thour, tminute, PlayerInfo[playerid][pName]);
    		VehLabel[newcar] = CreateDynamic3DTextLabel(string,0xfaf75c99,pos[0],pos[1],pos[2],15.0,INVALID_PLAYER_ID, newcar,0,0,0);
   			Protect_PutPlayerInVehicle(playerid, newcar, 0);
   			CreateRent_Player(playerid, unix, newcar, color, 50, model, b, item, 0.0, 0.0, 0.0, 0.0);

   			oGivePlayerMoney(playerid, -BizzInfo[b][bPrice][item]);
			format(string,sizeof(string),"Аренда катера в бизе № %d", b);
			MoneyLog("rentcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -BizzInfo[b][bPrice][item], string);

   			BizzInfo[b][bUseItem][item] ++;
   			if(BizzInfo[b][bSost] > 0)
   			{
   				if(friskPrice[178]*50 > BizzInfo[b][bDeposit])
				{
					BizzInfo[b][bIncome] += BizzInfo[b][bPrice][item];
					PutMoneyToTreasury(BizzInfo[b][bPrice][item], "Оплата за аренду катера (нет денег на топливо)");
				}
				else
				{
   					BizzInfo[b][bDeposit] -= friskPrice[178]*50;
   					paybiz(b, BizzInfo[b][bPrice][item]);
				}
			}
			else
			{
				BizzInfo[b][bIncome] += BizzInfo[b][bPrice][item];
				PutMoneyToTreasury(BizzInfo[b][bPrice][item], "Оплата за аренду катера (нет владельца)");
			}
			if(PlayerInfo[playerid][pAchieve][83] == 0) AchievePlayer(playerid, 83, 1);
		}
		else AgetBoat2(playerid);
	}
