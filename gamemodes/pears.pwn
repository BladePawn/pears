		cache_get_value_name_int(f, "Prod0", DomInfo[idx][dProd0]);
		cache_get_value_name_int(f, "Prod3", DomInfo[idx][dProd3]);
		cache_get_value_name_int(f, "Prod4", DomInfo[idx][dProd4]);
		cache_get_value_name_int(f, "Prod5", DomInfo[idx][dProd5]);
