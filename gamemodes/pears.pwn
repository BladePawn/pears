 	    if(params[0] < 1 || params[0] > 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепорт в комнату казино [ /gotokas 1-10 ]");
 	    S_SetPlayerVirtualWorld(playerid,params[0],199), PPSetPlayerInterior(playerid,199);
 	    PPSetPlayerPos(playerid, 1377.9464,1578.2401,10.8416), PPSetPlayerFacingAngle(playerid, 270.0);
	}
	return 1;
}
