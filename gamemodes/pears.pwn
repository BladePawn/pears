	case 1165:
	{
		if(response)
		{
		    if(List[listitem][playerid] == 1) bite(playerid, Moiplayer[playerid]);
		    if(List[listitem][playerid] == 2)
		    {
		    	format(string, sizeof(string), "%d", Moiplayer[playerid]);
            	pc_cmd_take(playerid, string);
	    	}
	    	if(List[listitem][playerid] == 3)
		    {
		    	format(string, sizeof(string), "%d", Moiplayer[playerid]);
            	pc_cmd_frisk(playerid, string);
	    	}
			if(List[listitem][playerid] == 4)
			{
				SektaEat(playerid,Moiplayer[playerid]);
			}
			if(List[listitem][playerid] == 5)
			{
				AcceptRevial(playerid);
			}
			if(List[listitem][playerid] == 6)
		    {
		    	format(string, sizeof(string), "%d", Moiplayer[playerid]);
            	pc_cmd_cuff(playerid, string);
	    	}
			if(List[listitem][playerid] == 7)
		    {
		    	format(string, sizeof(string), "%d", Moiplayer[playerid]);
            	pc_cmd_followme(playerid, string);
	    	}
			if(List[listitem][playerid] == 8)
		    {
				new str[60];
				format(str,sizeof(str),"Вы уверены что хотите добить %s?",rpplayername(Moiplayer[playerid]));
		    	ShowDialog(playerid,1489,DIALOG_STYLE_MSGBOX,"Добить человека",str,"Да","Нет");
	    	}
			if(List[listitem][playerid] == 9)
		    {
				ComputerClubRoomExit(Moiplayer[playerid],COMPUTER_CLUB_D_REASON_SELF),ErrorMessage(Moiplayer[playerid],"{ff6347}Вас вытащили из комп.клуба");
	    	}
			if(List[listitem][playerid] == 10)
		    {
				ListPlayerLoadPet(playerid, 0);
	    	}
			if(List[listitem][playerid] == 11)
		    {
				ListPlayerLoadPet(playerid, 1);
	    	}
		}
	}
	case 1166:
	{
		if (response) {
			new ban_info[200];
			if (GetPVarString(playerid, "SilentBanInfo", ban_info)) {
				DeletePVar(playerid, "SilentBanInfo");

				SetPVarInt(playerid, "IsSilentBan", 1);
				pc_cmd_ban(playerid, ban_info); // В последствии сотрет созданный pvar, ниже очищать ничего не нужно
			} else {
				new para1 = DP[0][playerid];
				if(!IsOnline(para1)) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
				if(PlayerInfo[para1][pSoska] >= PlayerInfo[playerid][pSoska] && OnlineInfo[para1][oLogged] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя кикнуть администратора вашего уровня или выше");
				if(IsARealNPC(para1)) return ErrorMessage(playerid, "{FF6347}Это NPC");

				// Антипидор
				if(AntiPidor(playerid, 10)) return 1;

				PlayerInfo[playerid][pWorked3] ++;
				if(PlayerInfo[playerid][pHidden] == 0) AdminLog("skick", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "");
				Kickx(para1);
				work_admin(playerid, 15);
				format(string,sizeof(string),"[ Мысли ]: %s[%d] тихо кикнут с сервера", PlayerInfo[para1][pName], para1);
				SendClientMessage(playerid, COLOR_GREY, string);
			}
		} else SendClientMessage(playerid, COLOR_GREY, "Elon_Musk: Вот и славно");
	}
