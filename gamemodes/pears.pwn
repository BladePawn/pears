}
CMD:testtrashroad(p)
{
	if(PlayerInfo[p][pSoska] >= 22)
	{
		loadroadtrash();
		SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Мусор на дорогах создан");
	}
	return 1;
}
stock random_trash(tra)
{
	new unix = gettime();
	if(trash_none[tra] < unix)
	{
		new fpick, fquan;
		switch(random(65))
	    {
			case 1: fpick = 1, fquan = 1; // Хлеб
			case 3,0,2: fpick = 3, fquan = 1; // Бутылка
			case 4: fpick = 4, fquan = 1+random(2); // Трава
			case 5: fpick = 69, fquan = 1; // Труп
			case 7: fpick = 7, fquan = 1+random(2); // Порошок
			case 13: fpick = 13, fquan = 1; // Веревка
			case 18,58: fpick = 18, fquan = 5+random(5); // Наживка
			case 19: fpick = 19, fquan = 1+random(2); // Отмычки
			case 23: fpick = 23, fquan = 1; // Мешок
			case 27: fpick = 27, fquan = 1+random(2); // Ammo 20,8mm
			case 28: fpick = 28, fquan = 1+random(2); // Ammo 11,43mm
			case 29: fpick = 29, fquan = 1+random(2); // Ammo 5,45mm
			case 30: fpick = 30, fquan = 1+random(2); // Ammo 45mm
			case 39: fpick = 39, fquan = 1; // Упаковка
			case 41: fpick = 41, fquan = 1+random(2); // Бенгальские Свечи
			case 53: fpick = 53, fquan = 1; // Зажигалка
			case 54,55: fpick = 238, fquan = 1+random(3); // Алюминий
			case 56,57: fpick = 268, fquan = 1; // Резина
			default: fpick = 68, fquan = 1; // Мусор
		}
		give_trash(tra, fpick, fquan, 0, 0, 0, 0);
	}
	return 1;
}
