	// Вход в Катана Дуэль
	if(KatanaDuel_Door(playerid)) yes = true;

	// Вход в Хранилище деревенских
	if(DoorVillageStorage(playerid)) yes = true;

	// Вход в логово маньяка
	if(DoorManiacStorage(playerid)) yes = true;

	if(GetPlayerVirtualWorld(playerid) == 2001 && GetPlayerInterior(playerid) == 55)
    {
	    for(new des = 0; des < MAX_DESK; des++) // Вход в комнату казино
		{
		    if(IsPlayerInRangeOfPoint(playerid,2.0,DeskInPos[des][0],DeskInPos[des][1],DeskInPos[des][2]))
			{
				if(server > 0 && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}К сожалению игровая комната в карты временно недоступна\n{ffcc66}Приносим свои извинения");
				if(DeskInfo[des][Room] == 1) return ErrorMessage(playerid, "{FF6347}Эта комната закрыта");
			    if(DeskEnterPause[playerid]+30 > unix) return ErrorMessage(playerid, "{FF6347}Вы можете зайти в комнату не раньше чем через 30 секунд");
				keep(playerid);
				S_SetPlayerVirtualWorld(playerid,des+1,199), PPSetPlayerInterior(playerid,199);
				PPSetPlayerPos(playerid,1377.2142,1580.6042,10.8416), PPSetPlayerFacingAngle(playerid,180.0);
				SetCameraBehindPlayer(playerid), yes = true;
		    }
    	}
   	}
	if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
	{
		// Вход в бизнесы переносные
		for(new b = 0; b < sizeof(BizzInfo); b++)
		{
			if(BizzInfo[b][bBizOStat][0] == 1)
			{
				if(IsPlayerInRangeOfPoint(playerid,2.0,BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]))
				{
					if(BizzInfo[b][bArest] > 0) return ErrorMessage(playerid, "{FF6347}Закрыто [Бизнес арестован]");
                    if(BizzInfo[b][bStat] == 1) return ErrorMessage(playerid, "{FF6347}Закрыто [Бизнес ожидает одобрения от Правительства]");
                    if(BizzInfo[b][bStat] == 2) return ErrorMessage(playerid, "{FF6347}Закрыто [Открытие бизнеса отказано Правительством]");
					if(IsValidDynamicObject(BizzInfo[b][bBizObject][0])
						&& Streamer_HasIntData(STREAMER_TYPE_OBJECT, BizzInfo[b][bBizObject][0], STREAMER_EDITABLE_DYNAMIC_OBJECT) 
						&& Streamer_GetIntData(STREAMER_TYPE_OBJECT, BizzInfo[b][bBizObject][0], STREAMER_EDITABLE_DYNAMIC_OBJECT) >= 1) return ErrorMessage(playerid, "{FF6347}Закрыто [Бизнес на стадии ремонта]");
                    if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
					
					if(IsABizInteriorFrame(b))
                    {
						if(IsCustomObject(BizzInfo[b][bBizObject][0]) && !IsPlayerSyncModels(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете зайти в этот бизнес\nВ бизнесе установлен кастомный интерьер\n\n{ffcc66}Скачайте лаунчер с нашего официального сайта pears.fun");
                        S_SetPlayerVirtualWorld(playerid, b+3000,BizzInfo[b][bInterior]), PPSetPlayerInterior(playerid,BizzInfo[b][bInterior]);
						PPSetPlayerPos(playerid,BizzInfo[b][bInteriorX],BizzInfo[b][bInteriorY],BizzInfo[b][bInteriorZ]), PPSetPlayerFacingAngle(playerid, BizzInfo[b][bInteriorA]);

						// Отдых в клубе подсказка, подойти к бару
						if(BizType(b) == 12 // Type 12, значит только: Бар / Клуб
							&& PlayerInfo[playerid][pQuest][6] == 1) ShowInfoEnterBizQuest(playerid, b);

						// Знакомство с едой, подсказка подойти на кассу и купить еду
						if(BizType(b) == 13 // Type 13, значит только: Закусочные
							&& PlayerInfo[playerid][pQuest][8] == 1) QuestActorJoneHavka(playerid);
					}
                    else
                    {
						if(b >= 13 && b <= 26) // Вход в супермаркет
						{
							S_SetPlayerVirtualWorld(playerid, b-12,206), PPSetPlayerInterior(playerid,206);
							PPSetPlayerPos(playerid,1110.9181,-1386.4814,1401.7142), PPSetPlayerFacingAngle(playerid, 0.0);
						}
						if(b >= 27 && b <= 41) // Вход в оружейный магазин
	                    {
	                    	S_SetPlayerVirtualWorld(playerid, b,225), PPSetPlayerInterior(playerid,225);
							PPSetPlayerPos(playerid,1289.2366,1525.7239,10.8555), PPSetPlayerFacingAngle(playerid,90.0);
						}
	                    if(b >= 123 && b <= 132) // Вход в аптеку
	                    {
	                    	S_SetPlayerVirtualWorld(playerid, b,224), PPSetPlayerInterior(playerid,224);
							PPSetPlayerPos(playerid,1289.0270,1525.6481,10.8555), PPSetPlayerFacingAngle(playerid,90.0);
							if(PlayerInfo[playerid][pQuest][7] == 3) QuestActorJoneMed(playerid);
						}
						if(b >= 133 && b <= 142) // Вход в магазин с техникой
	                    {
	                    	S_SetPlayerVirtualWorld(playerid, b-132,207), PPSetPlayerInterior(playerid,207);
							PPSetPlayerPos(playerid,1988.8231,1565.2983,1564.1647), PPSetPlayerFacingAngle(playerid,270.0);
						}
					}
					GameTextForPlayer(playerid, " ", 1000, 5);
					SetCameraBehindPlayer(playerid), yes = true;
				    break;
				}
			}
		}
	}

	// Вход в другие бизнесы
	if(!yes)
	{
		yes = EnterBizDoor(playerid);
	}

    if(yes)
    {
    	if(GetPlayerPing(playerid) >= 150) a_flood[5][playerid] = unix+5;
    	else a_flood[5][playerid] = unix+2;
    }
	return 1;
}
