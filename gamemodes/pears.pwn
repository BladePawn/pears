	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
stock abandoned(playerid)
{
	PlayerInfo[playerid][pAbandoned] ++;
	if(PlayerInfo[playerid][pAbandoned] >= 10) PlayerInfo[playerid][pAbandoned] = 0, PlayerInfo[playerid][pAData] = gettime()+2592000;
}
stock candles(playerid)
{
	if(SitPlayer[playerid] == 0 && HealthAC[playerid] >= 1 && Stun[0][playerid] == 0 && Stun[2][playerid] == 0 && Stun[3][playerid] == 0 && !IsPlayerInAnyVehicle(playerid)
	&& GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
	{
		if(GetPVarInt(playerid, "antifsit") > 0) return 0;
		new canid = -1, mw = GetPlayerVirtualWorld(playerid), mi = GetPlayerInterior(playerid);
		for(new c = 0; c < sizeof(CandlesPos); ++c)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5, CandlesPos[c][CandlesPos_X], CandlesPos[c][CandlesPos_Y], CandlesPos[c][CandlesPos_Z])
			&& mw == CandlesPos[c][CandlesWorld] && mi == CandlesPos[c][CandlesInt])
			{
				canid = c;
				break;
			}
		}
		if(canid == -1) return 1;
		if(CandlesStat[canid] == false)
		{
		    if(get_invent4(playerid, 53, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет зажигалки [ Можно купить: Y >> GPS >> Услуги >> Супермаркеты ]");
		    SetPVarInt(playerid, "antifsit", 1);
		    CandlesStat[canid] = true;
		    PlayerPlaySound(playerid,5600,0,0,0);
			ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
			SetPlayerChatBubble(playerid,"зажигает свечу",COLOR_PURPLE,20.0,3000);
			SetDynamicObjectPos(CandlesFireObject[canid], CandlesFirePos[canid][CF_X], CandlesFirePos[canid][CF_Y], CandlesFirePos[canid][CF_Z]);
			CandlesUnix[canid] = gettime()+300;
		}
		else
		{
		    SetPVarInt(playerid, "antifsit", 1);
		    CandlesStat[canid] = false;
		    PlayerPlaySound(playerid,5601,0,0,0);
			ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
			SetPlayerChatBubble(playerid,"тушит свечу",COLOR_PURPLE,20.0,3000);
			SetDynamicObjectPos(CandlesFireObject[canid], CandlesFirePos[canid][CF_X], CandlesFirePos[canid][CF_Y], CandlesFirePos[canid][CF_Z]-50.0);
			CandlesUnix[canid] = 0;
		}
	}
	return 1;
}
stock back_item(playerid)
{
    for(new t = 0; t < MAX_THROW; t++)
	{
		if(ThrowInfo[t][tId] == 42 && ThrowInfo[t][tType] == 0 && ThrowInfo[t][tPack] == 0 && ThrowInfo[t][tPlayerid] == PlayerInfo[playerid][pID])
		{
		    new put_inva = GiveThingPlayer(playerid, ThrowInfo[t][tId], ThrowInfo[t][tQuan], ThrowInfo[t][tPara], ThrowInfo[t][tQara], ThrowInfo[t][tType], ThrowInfo[t][tPack], 9999); // Выдаём предмет игроку
			if(put_inva != -1)
			{
				new string[100];
				format(string,sizeof(string),"[tID %d] Вернул: %s",t, GetNameThing(1, ThrowInfo[t][tId], ThrowInfo[t][tType], ThrowInfo[t][tPack]));
				UserLog("took", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], ThrowInfo[t][tPlayerid], ThrowInfo[t][tName], ThrowInfo[t][tIP], ThrowInfo[t][tQuan], string);
				
				if(ThrowInfo[t][tUseplayer] > 0)
				{
				    new para1 = ThrowInfo[t][tUseplayer]-1;
					if(IsOnline(para1))
					{
					    Hold[para1] = 0, HoldStat[para1] = 0, HoldFrisk[para1] = 0;
						if(Komputer[para1] == 1 || Komputer[para1] == 2) closecomp(para1), CancelSelectTextDraw(para1);
						ShowDialog(para1,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Владелец ноутбука вышел из игры и забрал его с собой","*","");
					}
				}
				DestroyThrow(t);
				updatethrowall(t);
			}
		}
	}
	return 1;
}
function sitload(playerid)
{
	if(SitPlayer[playerid] >= 1 || Piss[playerid] == 8 || playerSeat[playerid]) ApplyAnimation(playerid,"PED","SEAT_idle",4.0, false, false, false, true, false, SYNC_ALL);
	return 1;
}
stock sputnik(playerid)
{
	if(OverHear[playerid] == 0)
	{
		TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
		OverHear[playerid] = 1000;
		TempTake(playerid, 0);
		S_SetPlayerVirtualWorld(playerid, 0,0), PPSetPlayerInterior(playerid, 0);
		PPOpenSpectating(playerid, 2134.025878, 2344.734619, 163.357467);
		TextDrawShowForPlayer(playerid, TvCam[0]), TextDrawShowForPlayer(playerid, TvCam[1]), TextDrawShowForPlayer(playerid, TvCam[2]), TextDrawShowForPlayer(playerid, TvCam[3]);
		SendClientMessage(playerid,COLOR_GREY,"");
		SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: [ {FF6347}/exitcam - выйти из просмотра {cccccc}] [ {ff9000}/lscam /sfcam /lvcam - быстрое перемещение {cccccc}]");
		SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: [ Кнопки {ff9000}W, A, S, D {cccccc} - управление камерой ] [ Кнопки {ff9000}ЛКМ, ПКМ {cccccc} - масштабирование ]");
		InterpolateCameraPos(playerid, 2134.025878, 2344.734619, 163.357467, 2134.025878, 2344.734619, 163.357467, 1000);
		InterpolateCameraLookAt(playerid, 2134.024658, 2345.170410, 158.376495, 2134.024658, 2345.170410, 158.376495, 1000);
		PlayerPlaySound(playerid, 30801, 0.0, 0.0, 0.0);
		exitkomp(playerid, 0);
	}
	return 1;
}
stock watchcam(playerid, cam)
{
	if(CamInfo[cam][cStat] >= 1)
	{
		if(IsValidDynamicObject(CamInfo[cam][cObject]))
		{
			new Float:pos[3];
			GetDynamicObjectPos(CamInfo[cam][cObject], pos[0], pos[1], pos[2]);
			if(OverHear[playerid] == 0)
			{
				TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
				OverHear[playerid] = cam+1;
				TempTake(playerid, 0);
				S_SetPlayerVirtualWorld(playerid, CamInfo[cam][cWorld], CamInfo[cam][cInterior]);
				PPSetPlayerInterior(playerid, CamInfo[cam][cInterior]);
				CamObjectPlayer[playerid] = CreatePlayerObject(playerid, 19300, pos[0], pos[1], pos[2]+0.5, 0.0, 0.0, 0.0);
				PPOpenSpectating(playerid, pos[0], pos[1], pos[2]+0.5);
				AttachCameraToPlayerObject(playerid, CamObjectPlayer[playerid]);
				TextDrawShowForPlayer(playerid, TvCam[0]), TextDrawShowForPlayer(playerid, TvCam[1]), TextDrawShowForPlayer(playerid, TvCam[2]), TextDrawShowForPlayer(playerid, TvCam[3]);
				SendClientMessage(playerid,COLOR_GREY,"");
				SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: [ {ff9000}/allcam - Список Камер {cccccc}][ {FF6347}/exitcam - Выйти из Просмотра {cccccc}]");
				SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: [ Кнопки {ff9000}A,D {cccccc} - для быстрого перемещения между камерами ]");
				PlayerPlaySound(playerid, 30801, 0.0, 0.0, 0.0);
				exitkomp(playerid, 0);
			}
			else if(OverHear[playerid] >= 1)
			{
				S_SetPlayerVirtualWorld(playerid, CamInfo[cam][cWorld], CamInfo[cam][cInterior]);
				PPSetPlayerInterior(playerid, CamInfo[cam][cInterior]);
				DestroyPlayerObject(playerid, CamObjectPlayer[playerid]);
				CamObjectPlayer[playerid] = CreatePlayerObject(playerid, 19300, pos[0], pos[1], pos[2]+0.5, 0.0, 0.0, 0.0);
				AttachCameraToPlayerObject(playerid, CamObjectPlayer[playerid]);
			}
		}
		else SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3046 ]"), PlayerPlaySound(playerid,4203,0,0,0);
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Камеры не существует..");
	return 1;
}
stock rightcam(playerid)
{
	SetPVarInt(playerid,"aflist", 1);
	new yes = 0;
	for(new cam = OverHear[playerid]; cam < sizeof(CamInfo); cam++)
	{
		if(CamInfo[cam][cStat] >= 1)
		{
		    yes = cam+1;
			break;
		}
	}
	if(yes == 0)
	{
		for(new cam = 0; cam < sizeof(CamInfo); cam++)
		{
			if(CamInfo[cam][cStat] >= 1)
			{
			    yes = cam+1;
				break;
			}
		}
	}
	if(yes >= 1)
	{
		OverHear[playerid] = yes;
		S_SetPlayerVirtualWorld(playerid, CamInfo[yes-1][cWorld], CamInfo[yes-1][cInterior]);
		PPSetPlayerInterior(playerid, CamInfo[yes-1][cInterior]);
		DestroyPlayerObject(playerid, CamObjectPlayer[playerid]);
		new Float:pos[3];
		GetDynamicObjectPos(CamInfo[yes-1][cObject], pos[0], pos[1], pos[2]);
		CamObjectPlayer[playerid] = CreatePlayerObject(playerid, 19300, pos[0], pos[1], pos[2]+0.5, 0.0, 0.0, 0.0);
		AttachCameraToPlayerObject(playerid, CamObjectPlayer[playerid]);
		PlayerPlaySound(playerid,17803,0,0,0);
	}
	return 1;
}
stock leftcam(playerid)
{
	SetPVarInt(playerid,"aflist", 1);
	new yes = 0;
	for(new cam = OverHear[playerid]-2; cam > 0; cam--)
	{
		if(CamInfo[cam][cStat] >= 1)
		{
		    yes = cam+1;
			break;
		}
	}
	if(yes == 0)
	{
		for(new cam = 99; cam > 0; cam--)
		{
			if(CamInfo[cam][cStat] >= 1)
			{
			    yes = cam+1;
				break;
			}
		}
	}
	if(yes >= 1)
	{
		OverHear[playerid] = yes;
		S_SetPlayerVirtualWorld(playerid, CamInfo[yes-1][cWorld], CamInfo[yes-1][cInterior]);
		PPSetPlayerInterior(playerid, CamInfo[yes-1][cInterior]);
		DestroyPlayerObject(playerid, CamObjectPlayer[playerid]);
		new Float:pos[3];
		GetDynamicObjectPos(CamInfo[yes-1][cObject], pos[0], pos[1], pos[2]);
		CamObjectPlayer[playerid] = CreatePlayerObject(playerid, 19300, pos[0], pos[1], pos[2]+0.5, 0.0, 0.0, 0.0);
		AttachCameraToPlayerObject(playerid, CamObjectPlayer[playerid]);
		PlayerPlaySound(playerid,17803,0,0,0);
	}
	return 1;
}
stock exitcam(playerid)
{
	TogglePlayerControllable(playerid, false), Stopeee[playerid] = 2;
	if(GetPlayerPing(playerid) >= 150) Stopee[playerid] = 3;
	else Stopee[playerid] = 2;
	S_SetPlayerVirtualWorld(playerid, 244,0);
	PPSetPlayerInterior(playerid, 0);
	if(OverHear[playerid] <= 999) DestroyPlayerObject(playerid, CamObjectPlayer[playerid]);
	OverHear[playerid] = 0;
	TextDrawHideForPlayer(playerid, TvCam[0]), TextDrawHideForPlayer(playerid, TvCam[1]), TextDrawHideForPlayer(playerid, TvCam[2]), TextDrawHideForPlayer(playerid, TvCam[3]);
	TextDrawShowForPlayer(playerid, MindDraw[3]), PlayerTextDrawSetString(playerid, HintButton, "ENTER"), PlayerTextDrawShow(playerid, HintButton);
	SetPVarInt(playerid, "antifsit", 3);
	NoAnim[playerid] = 1;
	PPSetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
	PPSetPlayerFacingAngle(playerid, Job_A[playerid]);
	ApplyAnimation(playerid,"PED","SEAT_idle",4.0, false, false, false, true, false, SYNC_ALL);
	SetPlayerToTeamColor(playerid);
	SetCameraBehindPlayer(playerid);
	TempGive(playerid);
	PlayerPlaySound(playerid, 30803, 0.0, 0.0, 0.0);
	loadkomp(playerid, 0);
	return 1;
}
stock loadkomp(playerid, stat)
{
    if(OnlineInfo[playerid][oShowInterface] == 0)
    {
        if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов, прежде чем достать ноутбук");
        create_textdraw_pc(playerid);
        for(new i = 0; i < 13; i++) PlayerTextDrawShow(playerid, PlayerPcDraw[i][playerid]);
        if(stat == 1)
		{	
			PlayerTextDrawShow(playerid, PlayerPcDraw[24][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[25][playerid]); // TRADE
			if(server == 0) PlayerTextDrawShow(playerid, PlayerPcDraw[26][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[27][playerid]); // Gaming +
		    PlayerTextDrawShow(playerid, PlayerPcDraw[21][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[22][playerid]); // Компьютер
		    if(HoldQuan[playerid] >= 2 && HoldQuan[playerid] <= 15)
		    {
		        new string[24];
		        format(string, sizeof(string), "loadsuk:loadsc%d", HoldQuan[playerid]-1);
		    	PlayerTextDrawSetString(playerid, PlayerPcDraw[0][playerid],string);
		    	PlayerTextDrawColour(playerid, PlayerPcDraw[0][playerid], -1);
		    	PlayerTextDrawShow(playerid, PlayerPcDraw[0][playerid]);
	    	}
		    PlayerTextDrawShow(playerid, PlayerPcDraw[13][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[14][playerid]); // Банк Online
		    new yes, f = PlayerInfo[playerid][pFamily];
			if(f > 0)
			{
				if(FamilyInfo[f][fSost] > 0)
				{
					for(new fb = 0; fb < 10; fb++)
					{
						if(FamilyInfo[f][fBiz][fb] >= 1)
						{
						    yes = 1;
						    break;
						}
					}
				}
			}
			if(PlayerInfo[playerid][pBusiness] > 0 || yes == 1) PlayerTextDrawShow(playerid, PlayerPcDraw[15][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[16][playerid]); // Бизнес
			if(Hold[playerid] != 13) PlayerTextDrawShow(playerid, PlayerPcDraw[23][playerid]); // Положить ноут на стол
		}
		if(IsPoliceMember(playerid) || PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 && PlayerInfo[playerid][pRank] >= 10 || PlayerInfo[playerid][pSoska] > 0 && ADUTY[playerid] == 1) PlayerTextDrawShow(playerid, PlayerPcDraw[17][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[18][playerid]); // База Данных
		for (new i = 0; i < sizeof(policeDatabasePickups); i++)
		{
			if (policeDatabasePickups[i][pdpType] == POLICE_DATABASE_PICKUP_HACK) {
				if (GetPlayerVirtualWorld(playerid) != policeDatabasePickups[i][pdpWorld] || GetPlayerInterior(playerid) != policeDatabasePickups[i][pdpInterior]) continue;

				if (IsPlayerInRangeOfPoint(playerid, 1.5, policeDatabasePickups[i][pdpX], policeDatabasePickups[i][pdpY], policeDatabasePickups[i][pdpZ]))
				{
					new fractionid = policeDatabasePickups[i][pdpFraction];
					PlayerTextDrawShow(playerid, PlayerPcDraw[17][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[18][playerid]); // База Данных
					if (policeDatabaseInfo[fractionid][pdiState] != POLICE_DATABASE_STATE_NORMAL) SetPlayerChatBubble(playerid,"подключает ноутбук к базе данных",COLOR_PURPLE,20.0,3000);
					break;
				}
			}
		}
		if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1) // FBI
		{
		    PlayerTextDrawSetPreviewModel(playerid, PlayerPcDraw[19][playerid], 1253);
		    PlayerTextDrawSetPreviewRot(playerid, PlayerPcDraw[19][playerid], 0.000000, 0.000000, 180.000000, 1.500000);
		    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "Cњc¦eЇa_FBI");
		    else PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "System_FBI");
		    PlayerTextDrawShow(playerid, PlayerPcDraw[19][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[20][playerid]);
  		}
		if(PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pMember] == 3) // NGSA
		{
		    PlayerTextDrawSetPreviewModel(playerid, PlayerPcDraw[19][playerid], 3267);
		    PlayerTextDrawSetPreviewRot(playerid, PlayerPcDraw[19][playerid], 0.000000, 0.000000, -20.000000, 1.500000);
		    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "Cњc¦eЇa_NGSA");
		    else PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "System_NGSA");
		    PlayerTextDrawShow(playerid, PlayerPcDraw[19][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[20][playerid]);
  		}
		if(PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 && PlayerInfo[playerid][pRank] >= 10) // Правительство
		{
		    PlayerTextDrawSetPreviewModel(playerid, PlayerPcDraw[19][playerid], 10377);
		    PlayerTextDrawSetPreviewRot(playerid, PlayerPcDraw[19][playerid], 1.000000, -1.000000, 90.000000, 0.800000);
		    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "Њpaўњ¦eћ©c¦ўo");
		    else PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "Government");
		    PlayerTextDrawShow(playerid, PlayerPcDraw[19][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[20][playerid]);
  		}
		if(PlayerInfo[playerid][pLeader] == 4 || PlayerInfo[playerid][pMember] == 4 && PlayerInfo[playerid][pRank] >= 1) // МЗ
		{
		    PlayerTextDrawSetPreviewModel(playerid, PlayerPcDraw[19][playerid], 19222);
		    PlayerTextDrawSetPreviewRot(playerid, PlayerPcDraw[19][playerid], 90.00, 0.0, 0.0, 0.5);
		    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "Mњ®.3љpaў");
		    else PlayerTextDrawSetString(playerid, PlayerPcDraw[20][playerid], "ASGH");
		    PlayerTextDrawShow(playerid, PlayerPcDraw[19][playerid]), PlayerTextDrawShow(playerid, PlayerPcDraw[20][playerid]);
  		}
  		PlayerPlaySound(playerid, 30801, 0,0,0);
  		SelectTextDraw(playerid,0x666666AA);
  		if(stat == 0) Komputer[playerid] = 1;
		else Komputer[playerid] = 2;
        OnlineInfo[playerid][oShowInterface] = 13;

		// Квест знакомство с ноутбуком
		if(PlayerInfo[playerid][pQuest][9] == 2)
		{
        	PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_note3.mp3");
        	SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Кликни два раза по ярлыку Bank Online");
		}
		else if(PlayerInfo[playerid][pQuest][9] == 3)
		{
			PlayerInfo[playerid][pQuest][9] = 3;
			PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_note6.mp3");
			SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Теперь открой Gold Trade");
		}
    }
	return 1;
}
stock closecomp(playerid)
{
    if(OnlineInfo[playerid][oShowInterface] == 13)
    {
    	for(new i = 0; i < 28; i++) PlayerTextDrawHide(playerid, PlayerPcDraw[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerPcDraw[i][playerid]);
    	OnlineInfo[playerid][oShowInterface] = 0;
   	}
    HidePlayerDialog(playerid);
    if(Hold[playerid] == 11 && Komputer[playerid] == 2)
    {
    	Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0;
		RemovePlayerAttachedObject(playerid,1); PPP15[playerid] = 0;
		if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ClearAnimations(playerid), ClearAnim(playerid);
		return 1;
    }

	// Квест знакомство с ноутбуком
	if(PlayerInfo[playerid][pQuest][9] == 2 || PlayerInfo[playerid][pQuest][9] == 3)
	{
		PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_note5.mp3");
		SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Ээ погоди. Достань ещё раз ноут, мы не закончили");
	}

    Komputer[playerid] = 0;
	return 1;
}
stock exitkomp(playerid, stat)
{
	if(OnlineInfo[playerid][oLogged] == 1 && Komputer[playerid] >= 1)
	{
	    closecomp(playerid);
	    if(stat == 0 || stat == 1) CancelSelectTextDraw(playerid);
	    if(stat == 0) PlayerPlaySound(playerid, 30802, 0.0, 0.0, 0.0);
  	}
	return 1;
}
stock GetTickDiff(newtick, oldtick)
{
	if (oldtick > newtick)
	{
		return (cellmax - oldtick + 1) - (cellmin - newtick);
	}
	return newtick - oldtick;
}
stock send_arestcar(playerid, veh , stat, days)
{
	if(Cars[veh] == 88)
	{
	     new playa = VehInfo[veh][vIdvlad];
	     if(IsOnline(playa))
	     {
			new string[144];
			if(stat == 0)
			{
				paysalary(playerid, VehInfo[veh][vFineLien]/100*20, 0);
				format(string, sizeof(string), "[ Мысли ]: Транспорт доставлен на штраф стоянку (20 проц. от залога) {99ff66}[ %d$ ]", VehInfo[veh][vFineLien]/100*20);
				SendClientMessage(playerid, COLOR_GREY, string);
				MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", VehInfo[veh][vFineLien]/100*20, "Зарплата Арест т.с.");
			}
			else if(stat == 1)
			{
				new zal = VehInfo[veh][vFineLien]/86400;
				format(string, sizeof(string), "[ Мысли ]: Транспорт арестован {ff9000}[ %d Дней | {99ff66}%d$ Залог {ff9000}| Причина: {444444}%s {ff9000}]", days, VehInfo[veh][vFineLien], VehInfo[veh][vFineReason]);
				SendClientMessage(playerid, COLOR_GREY, string);
				paysalary(playerid, zal/100*5, 0);
				format(string, sizeof(string), "[ Мысли ]: Транспорт арестован дистанционно (5 проц. от залога) {99ff66}[ %d$ ]", zal/100*5);
				SendClientMessage(playerid, COLOR_GREY, string);
				MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", zal/100*5, "Зарплата Арест т.с.");
			}
			PlayerPlaySound(playerid,6401,0,0,0);
			if(IsPoliceMember(playerid))
			{
				format(string, sizeof(string), "{0088ff}POLICE %s: {444444}Ваш %s арестован!", VehInfo[veh][vFineName], GetVehicleName(VehInfo[veh][vModel])), SendClientMessage(playa, COLOR_GREY, string);
				format(string, sizeof(string), "{0088ff}POLICE {cccccc} Залог: {99ff66}%d$ {cccccc}Причина: %s", VehInfo[veh][vFineLien], VehInfo[veh][vFineReason]), SendClientMessage(playa, COLOR_GREY, string);
			}
			else
			{
				format(string, sizeof(string), "{E0E0E0}Правительство %s: {444444}Ваш %s арестован!", VehInfo[veh][vFineName], GetVehicleName(VehInfo[veh][vModel])), SendClientMessage(playa, COLOR_GREY, string);
				format(string, sizeof(string), "{E0E0E0}Правительство {cccccc}Залог: {99ff66}%d$ {cccccc}Причина: %s", VehInfo[veh][vFineLien], VehInfo[veh][vFineReason]), SendClientMessage(playa, COLOR_GREY, string);
			}
			if(IsPlayerInAnyVehicle(playa) && GetPlayerVehicleID(playa) == veh)
			{
				new Float:X, Float:Y, Float:Z;
				GetVehiclePos(veh, X,Y,Z);
				PPSetPlayerPos(playa, X, Y, Z);
			}

			SaveCar(veh);
			SaveBoot(veh);
			ACDestroyVehicle(veh);
			PlayerPlaySound(playa,1085,0,0,0);
		}
	}
	return 1;
}
stock ngsa_cargo(a, stat)
{
	new invent, inv, thingType;
	switch(random(22))
	{
		case 0,1: invent = 27, inv = 800+random(200), thingType = 0; // Ammo 20,8 (Патроны Для Дробовика)
		case 2,3,4: invent = 28, inv = 800+random(200), thingType = 0; // Ammo 11,43mm (Патроны Для Пистолета)
		case 5,6,7,8: invent = 29, inv = 800+random(200), thingType = 0; // Ammo 5,45mm (Патроны Для Автомата)
		case 9,10: invent = 30, inv = 400+random(400), thingType = 0; // Ammo 45mm (Патроны Для Винтовки)
		case 11: invent = 24, inv = 6+random(4), thingType = 1; // Deagle
		case 12: invent = 25, inv = 6+random(4), thingType = 1; // Дробовик
		case 13: invent = 27, inv = 6+random(4), thingType = 1; // Скорострельный Дробовик
		case 14: invent = 30, inv = 6+random(4), thingType = 1; // AK-47
		//case 15: invent = 31, inv = 6+random(4), thingType = 1; // M4
		case 15: invent = 33, inv = 6+random(4), thingType = 1; // Винтовка
		//case 16: invent = 34, inv = 6+random(4), thingType = 1; // Снайперская Винтовка
		case 17: invent = 19142, inv = 6+random(4), thingType = 2; // Бронежилет
		case 18: invent = 22, inv = 6+random(4), thingType = 1; // Colt
		case 19: invent = 28, inv = 6+random(4), thingType = 1; // Uzi
		case 20: invent = 32, inv = 6+random(4), thingType = 1; // Tec-9
		case 21: invent = 29, inv = 6+random(4), thingType = 1; // MP5
		default: invent = 28, inv = 800+random(200), thingType = 0; // Ammo 11,43mm (Патроны Для Пистолета)
	}
	if(stat == 0) SvInvent[a] = invent, SvInv[a] = inv, SvType[a] = thingType;
	else if(stat == 1) VmfInvent[a] = invent, VmfInv[a] = inv, VmfType[a] = thingType;
	return 1;
}
stock load_ammovmf()
{
	MoveDynamicObject(Vorota[101], -1466.557617, 405.970336, 7.886859, 0.5);
	MoveDynamicObject(Vorota[102], -1425.687133, 405.970336, 7.886859, 0.5);
	MoveDynamicObject(Vorota[103], -1385.337158, 405.970336, 7.886859, 0.5);
	switch(random(3))
	{
		case 0: VmfDoor = 1;
		case 1: VmfDoor = 2;
		case 2: VmfDoor = 3;
	}
	new string[144];
	for(new a = 0; a < sizeof(VmfPos); ++a)
	{
		if(VmfInvent[a] == 0)
		{
			ngsa_cargo(a, 1);
			if(VmfType[a] == 1) format(string, sizeof(string), "{cccccc}Ящик \n{444444}%s [ Кол-во: %d ]\n\n{ff9000}[ Взять - ALT ]", gunName[VmfInvent[a]], VmfInv[a]);
			else format(string, sizeof(string), "{cccccc}Ящик \n{444444}%s [ Кол-во: %d ]\n\n{ff9000}[ Взять - ALT ]", GetNameThing(0, VmfInvent[a], VmfType[a], 0), VmfInv[a]);
			
			VmfLabel[a] = CreateDynamic3DTextLabel(string,0xA9C4E4FF, VmfPos[a][VmfPos_X], VmfPos[a][VmfPos_Y], VmfPos[a][VmfPos_Z],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,205,205);
			VmfObj[a] = CreateDynamicObject(3014, VmfPos[a][VmfPos_X], VmfPos[a][VmfPos_Y], VmfPos[a][VmfPos_Z], 0.0, 0.0, VmfPos[a][VmfPos_RZ], 205, 205, -1, 50.0, 50.0);
		}
	}
}
stock vmf_weapons(playerid)
{
	new string[144];
	if(IsGangMember(playerid) || IsMafiaMember(playerid) || PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8)
	{
	 	if(VmfDoor == 4 && VmfTime >= 1)
 		{
 		    new ahour = VmfTime/3600;
			new avremh = ahour*3600;
			new avremmin = VmfTime-avremh;
			new amin = avremmin/60;
			new asek = avremmin-amin*60;

            format(string, sizeof(string), "{FF6347}Попытка открыть склад ВМС уже была\n{cccccc}Следующая возможность через: {FF6347}%02d минут %02d секунд", amin, asek);
            ErrorMessage(playerid, string);
		 	return 1;
	 	}
		if(VmfDoor >= 5 && VmfDoor <= 7) return format(string, sizeof(string), "[ Мысли ]: Оружейный склад ВМС открыт {99ff66}[ Дверь № %d ][ Осталось: %d сек. ]", VmfDoor-4, VmfTime), SendClientMessage(playerid,COLOR_GREY,string);
		if(VmfDoor == 0) return ErrorMessage(playerid, "{FF6347}На складе ВМС отсутствуют боеприпасы\n{cccccc}Склад будет пополнен в следующем часу");
		PlayerPlaySound(playerid,40405,0,0,0);
	 	ShowDialog(playerid,968,DIALOG_STYLE_LIST,"{ff9000}Выберите Дверь","{cccccc}1 Дверь\n{cccccc}2 Дверь\n{cccccc}3 Дверь","Выбрать","Отмена");
 	}
 	else ErrorMessage(playerid, "{FF6347}Эти склады доступны для ограбления только участникам банд или мафий");
   	return 1;
}
stock yashvmf(playerid)
{
	new yashid = 0;
	for(new a = 0; a < sizeof(VmfPos); ++a)
	{
		if(VmfInvent[a] >= 1)
		{
			if(IsPlayerInRangeOfPoint(playerid, 1.5, VmfPos[a][VmfPos_X], VmfPos[a][VmfPos_Y], VmfPos[a][VmfPos_Z]))
			{
                yashid = a+1;
			    break;
			}
		}
	}
	if(yashid >= 1)
	{
		if(IsGangMember(playerid) || IsMafiaMember(playerid) || PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8)
		{
			new a = yashid-1;
		    if(VmfInvent[a] == 34 && VmfType[a] == 1)
		    {
		        if(!IsAvailableOrganizationWeapon(fraction(playerid), 34)) return ErrorMessage(playerid, "{FF6347}На складе вашей организации нельзя хранить снайперскую винтовку");
		    }
			if(OnlineInfo[playerid][oInHandThing][0] > 0 && OnlineInfo[playerid][oInHandThing][5] == 2) return ErrorMessage(playerid, "{FF6347}У вас в руках уже есть ящик\n\n{cccccc}Отвезите его на склад вашей организации");
			if(OnlineInfo[playerid][oInHandThing][0] > 0 || Hand[playerid] >= 1 || GetPlayerWeapon(playerid) >= WEAPON:2 || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки\n\n{cccccc}Предмет, оружие или какое-то действие");
			new fpick = VmfInvent[a], fquan = VmfInv[a], fpara, thingType = VmfType[a];
			
			if(IsArmor(fpick) && thingType == 2) fpara = 100; // Броня 100 хп

			GiveThingHand(playerid, fpick, fquan, fpara,  0, thingType, 2);
			ApplyAnimation(playerid,"CARRY","liftup",4.0, false, true, true, false, 0); // Анимация поднять предмет
			PPP15[playerid] = 3, RemovePlayerAttachedObject(playerid,1);
			SetPlayerAttachedObject(playerid,1 , 3014, 6, 0.120000, 0.199448, -0.120000, 254.000000, 0.900000, 70.000000);
		    SetPlayerChatBubble(playerid,"поднимает ящик",COLOR_PURPLE,20.0,5000);
			DestroyDynamic3DTextLabel(VmfLabel[a]), DestroyDynamicObject(VmfObj[a]), VmfInvent[a] = 0;
		}
		else ErrorMessage(playerid, "{FF6347}Эти ящики могут взять только участники банд или мафий");
	}
	return 1;
}
stock load_ammosv()
{
	new string[144];
	for(new a = 0; a < sizeof(SvPos); ++a)
	{
		if(SvInvent[a] == 0)
		{
			ngsa_cargo(a, 0);
			if(SvType[a] == 1) format(string, sizeof(string), "{cccccc}Ящик \n{444444}%s [ Кол-во: %d ]\n\n{ff9000}[ Взять - ALT ]", gunName[SvInvent[a]], SvInv[a]);
			else format(string, sizeof(string), "{cccccc}Ящик \n{444444}%s [ Кол-во: %d ]\n\n{ff9000}[ Взять - ALT ]", GetNameThing(0, SvInvent[a], SvType[a], 0), SvInv[a]);

			SvLabel[a] = CreateDynamic3DTextLabel(string,0xA9C4E4FF, SvPos[a][SvPos_X], SvPos[a][SvPos_Y], SvPos[a][SvPos_Z],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0);
			SvObj[a] = CreateDynamicObject(3014, SvPos[a][SvPos_X], SvPos[a][SvPos_Y], SvPos[a][SvPos_Z], 0.0, 0.0, 0.0, 0, 0, -1, 50.0, 50.0);
		}
	}
}
