public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle)
{
	printf("[debug] |||||||||||||||||||||||||||||||\nID ошибки: %d\nОшибка: %s\nПаблик: %s\nЗапрос : %s\n|||||||||||||||||||||||||||||||",errorid,error,callback,query);
	return 1;
}

public LoadStuff()
{
	new rows, f_str[256],her[5];
	cache_get_row_count(rows);
	if(rows)
	{
		cache_get_value_name(0, "stuff", f_str, 256);
		new arrCoords[23][256];
		split(f_str, arrCoords, ',');
		Idsfam = strval(arrCoords[0]); // Подсчёт семей
		IdsHouse = strval(arrCoords[1]);
		aasyka = strval(arrCoords[2]);
		filik[0] = strval(arrCoords[3]);
		Djvopr = strval(arrCoords[4]);
		Djtrans = strval(arrCoords[5]);
		Pogoda = strval(arrCoords[6]);
		filik[1] = strval(arrCoords[7]);
		GosKaznaLv = strval(arrCoords[8]);
		Oryj = strval(arrCoords[9]);
		SektaDay = strval(arrCoords[10]);
		SektaSerdce = strval(arrCoords[11]);
		SektaPechen = strval(arrCoords[12]);
		Akkaunt = strval(arrCoords[13]);
		SektaPochki = strval(arrCoords[14]);
		SektaGlaza = strval(arrCoords[15]);
		Schetfam = strval(arrCoords[16]);
		her[0] = strval(arrCoords[17]);
		her[1] = strval(arrCoords[18]);
		her[2] = strval(arrCoords[19]);
		her[3] = strval(arrCoords[20]);
		her[4] = strval(arrCoords[21]);
		newskidka1 = strval(arrCoords[22]);

		if(aasyka == 1)
		{
			SendRconCommand("name Pears Project [ ТЕХ.РАБОТЫ ]");
			SendRconCommand("password 6yb65v45trffergFFF");
			for(new i =0; i<MAX_REALPLAYERS; i++)
			{
				if(IsOnline(i))
				{
					Kickx(i); // Всех игроков кикаем
				}
			}
		}
	}
	else
	{
        print("[ ERROR ] Значение stuff в pp_config отсутствует");
		GameModeExit();
	}

	Pogoda = 1; // Погода всегда по дефолту
	return 1;
}
public LoadNalog()
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		cache_get_value_name_float(0, "nned", nalog[0]); // налог на недвижимость
		cache_get_value_name_float(0, "ntra", nalog[1]); // налог на транспорт
		cache_get_value_name_float(0, "ndoh", nalog[2]); // налог на доход
		cache_get_value_name_float(0, "nbiz", nalog[3]); // налог на бизнес
	}
	else
	{
        print("[ ERROR ] Значение pp_config отсутствует");
		GameModeExit();
	}
	return 1;
}
