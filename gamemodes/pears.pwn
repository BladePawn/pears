stock buygunlic(playerid)
{
    new str[94],sctring[200];
	if(IsPlayerInRangeOfPoint(playerid,2.0,1566.3813,-1675.6056,16.2218)) DP[0][playerid] = 1, format(str,sizeof(str),"{0066ff}LSPD \t "), strcat(sctring,str);
	else if(IsPlayerInRangeOfPoint(playerid,2.0,-1605.5714,699.0486,13.8918)) DP[0][playerid] = 11, format(str,sizeof(str),"{122faa}SFPD \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Лицензия на оружие 1-ой категории \t {99ff66}%d$ [%s]",friskPrice[161], get_k(friskPrice[161])), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Лицензия на оружие 2-ой категории \t {99ff66}%d$ [%s]",friskPrice[162], get_k(friskPrice[162])), strcat(sctring,str);
	strcat(sctring, "\n{ff6347}Сдаться властям");
	ShowDialog(playerid, 1223, DIALOG_STYLE_TABLIST_HEADERS, "{ff9000}Департамент Полиции", sctring, "Выбор", "Отмена");
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}
CMD:buymed(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1284.5995,1528.4960,10.8555) && GetPlayerInterior(playerid) == 224 && GetPlayerVirtualWorld(playerid) >= 123 && GetPlayerVirtualWorld(playerid) <= 132)
	{
	    new b = GetPlayerVirtualWorld(playerid), list;
	    DP[4][playerid] = b;
	    new line[214],lines[4096];
	    
		format(line,sizeof(line),"{cccccc}Товар\t{444444}Назначение\t{99ff66}Стоимость\t{444444}Наличие"), strcat(lines,line);
		for(new i = 0; i < MAX_BIZ_ITEM; i++)
		{
		    if(BizzInfo[b][bProduct][i] > 0)
		    {
		        List[list][playerid] = i;
				format(line,sizeof(line),"\n{cccccc}%s \t {444444}%s \t {99ff66}%d$ \t {444444}%d", GetNameThing(0, BizzInfo[b][bProduct][i], BizzInfo[b][bTypeProduct][i], 0), appointmentName[list], BizzInfo[b][bPrice][i], BizzInfo[b][bItem][i]), strcat(lines,line);
                list ++;
			}
		}
		ShowDialog(playerid,1145,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Аптека",lines,"Выбор","Отмена");
		PlayerPlaySound(playerid,40405,0,0,0);
    }
	return 1;
}
