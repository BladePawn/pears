	mysql_tquery(pearsq, "SELECT * FROM `pp_igroki` WHERE `DonateMoney`>='1' OR `Ammo8`>='1' ORDER BY `Online` DESC LIMIT 30", "Call_turnovergold", "d", -1); // Полный курс золота
