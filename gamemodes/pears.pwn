		SetCameraBehindPlayer(playerid);

		//WhiteFindPlayerPos(playerid,0.0,0.0,0.0); // Нужно при выходе из игры сохранять finx_X, z, y в базу
		return 1;
	}

    if(PlayerInfo[playerid][pSelectspawn] == 2) // Family
    {
	    new fam = PlayerInfo[playerid][pFamily];
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,FamilyInfo[fam][fWorld], FamilyInfo[fam][fInt]), PPSetPlayerInterior(playerid, FamilyInfo[fam][fInt]);
		PPSetPlayerPos(playerid,FamilyInfo[fam][fSpawnX],FamilyInfo[fam][fSpawnY],FamilyInfo[fam][fSpawnZ]), PPSetPlayerFacingAngle(playerid,FamilyInfo[fam][fSpawnA]);
		ASK[playerid] = 0;

		WhiteFindPlayerPos(playerid,0.0,0.0,0.0);
		return 1;
    }

	new g = fraction(playerid);
	if(PlayerInfo[playerid][pSelectspawn] == 3) // Division
	{
		new i = PlayerInfo[playerid][pDivision][0] - 1;
		g -= 1;
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,DivisionInfo[g][i][divSpawnWorld], DivisionInfo[g][i][divSpawnInterior]), PPSetPlayerInterior(playerid, DivisionInfo[g][i][divSpawnInterior]);
		PPSetPlayerPos(playerid,DivisionInfo[g][i][divSpawnPos][0],DivisionInfo[g][i][divSpawnPos][1],DivisionInfo[g][i][divSpawnPos][2]), PPSetPlayerFacingAngle(playerid,DivisionInfo[g][i][divSpawnPos][3]);
		
		WhiteFindPlayerPos(playerid,0.0,0.0,0.0);
		return 1;
	}

	if(PlayerInfo[playerid][pSelectspawn] == 4 || PlayerInfo[playerid][pSelectspawn] == 6 || PlayerInfo[playerid][pSelectspawn] == 7) // Home, Family Home, Rent Home
	{
		if(LIMITED_LOADING_SERVER >= 2) // Если загрузка ограничена, значит дом не запущен - ставим игрока в LS
		{
			S_SetPlayerVirtualWorld(playerid, 0, 0), PPSetPlayerInterior(playerid, 0);
			PPSetPlayerPos(playerid,  1529.6,-1691.2,13.3), PPSetPlayerFacingAngle(playerid, 0.0);
			TogglePlayerControllable(playerid,true);
			return 1;
		}
		new domid;
		if(PlayerInfo[playerid][pSelectspawn] == 4) domid = PlayerInfo[playerid][pDom];
		else if(PlayerInfo[playerid][pSelectspawn] == 6) domid = FamilyInfo[PlayerInfo[playerid][pFamily]][fDop5];
		else if(PlayerInfo[playerid][pSelectspawn] == 7) domid = PlayerInfo[playerid][pHouserent];

		if(DomInfo[domid][dArest] >= 1)
		{
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Этот дом арестован!\n\n{cccccc}Если вы владелец, оплатите налоги, чтобы снять арест","*","");

			S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
			PPSetPlayerPos(playerid, DomInfo[domid][dKoordinatX],DomInfo[domid][dKoordinatY],DomInfo[domid][dKoordinatZ]), PPSetPlayerFacingAngle(playerid, DomInfo[domid][dKoordinatA]);
			TogglePlayerControllable(playerid,true);
			ApplyAnimation(playerid,"INT_HOUSE","BED_Out_R",4.1, false, false, false, false, false);
			return 1;
		}
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid, domid+1000,DomInfo[domid][dInterior]);PPSetPlayerInterior(playerid,DomInfo[domid][dInterior]);
		if(DomInfo[domid][dInspa] == 0) PPSetPlayerPos(playerid, DomInfo[domid][dEnterX], DomInfo[domid][dEnterY],DomInfo[domid][dEnterZ]), PPSetPlayerFacingAngle(playerid, DomInfo[domid][dEnterA]);
		else PPSetPlayerPos(playerid, DomInfo[domid][dSpaX], DomInfo[domid][dSpaY],DomInfo[domid][dSpaZ]), PPSetPlayerFacingAngle(playerid, DomInfo[domid][dSpaA]);

		WhiteFindPlayerPos(playerid,DomInfo[domid][dKoordinatX],DomInfo[domid][dKoordinatY],DomInfo[domid][dKoordinatZ]);
		return 1;
	}

	if(PlayerInfo[playerid][pSelectspawn] == 5) // квартиры
	{
		keep(playerid);
		new aprid = PlayerInfo[playerid][pSpawnChangeDop]-1;
		new apworld = ApartmentsRoom[aprid][aprWorld];
		new apid = ApartmentsRoom[aprid][aprApartmentsID];
    	new idfloorroom = (apworld - Apartments[apid][apWorldDefineEntrance] - Apartments[apid][apFloor]) % 4;
		S_SetPlayerVirtualWorld(playerid,ApartmentsRoom[aprid][aprWorld],Apartments[apid][apInt]), PPSetPlayerInterior(playerid,Apartments[apid][apInt]);
		switch(idfloorroom){
			case 1: PPSetPlayerPos(playerid,Apartments[apid][apRoomCoordOneExit][0],Apartments[apid][apRoomCoordOneExit][1],Apartments[apid][apRoomCoordOneExit][2]);
			case 2: PPSetPlayerPos(playerid,Apartments[apid][apRoomCoordTwoExit][0],Apartments[apid][apRoomCoordTwoExit][1],Apartments[apid][apRoomCoordTwoExit][2]);
			case 3: PPSetPlayerPos(playerid,Apartments[apid][apRoomCoordThreeExit][0],Apartments[apid][apRoomCoordThreeExit][1],Apartments[apid][apRoomCoordThreeExit][2]);
			case 0: PPSetPlayerPos(playerid,Apartments[apid][apRoomCoordFourExit][0],Apartments[apid][apRoomCoordFourExit][1],Apartments[apid][apRoomCoordFourExit][2]);
			default: SetSpawnInHotel(playerid, fraction(playerid), PlayerInfo[playerid][pModel]);
		}
		WhiteFindPlayerPos(playerid,Apartments[apid][apCoord][0],Apartments[apid][apCoord][1],Apartments[apid][apCoord][2]);
		return 1;
	}


	if(PlayerInfo[playerid][pSelectspawn] == 9) // Trailer
	{
		new tid = PlayerInfo[playerid][pTrailer] - 1;
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid ,tid + 5000, 187);
		PPSetPlayerInterior(playerid,187);

		if(TrailerInfo[tid][tModel] == 12304) PPSetPlayerPos(playerid, 29.8153,1533.4000,12.7768), PPSetPlayerFacingAngle(playerid, 0.0);
		else PPSetPlayerPos(playerid,-2.8078,1569.0706,12.7753), PPSetPlayerFacingAngle(playerid, 179.9875);
		SetCameraBehindPlayer(playerid);

		WhiteFindPlayerPos(playerid,TrailerInfo[tid][tPos][0],TrailerInfo[tid][tPos][1],TrailerInfo[tid][tPos][2]);
	}

	if(PlayerInfo[playerid][pSelectspawn] == 8) // Organization
    {
