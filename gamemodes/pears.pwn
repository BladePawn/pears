				else if(listitem == 4)
				{
					atext = "раковину", statas = DomInfo[nd][dInsin], DP[0][playerid] = 5;
				}
				else if(listitem == 5)
				{
					atext = "душ", statas = DomInfo[nd][dInsou], DP[0][playerid] = 6;
				}
				else if(listitem == 6)
				{
					return ElectrostationHouseList(playerid,nd);
				}
				else if(listitem == 7)
				{
					atext = "Дверь 1 наружняя", statas = DomInfo[nd][dDoor][0], DP[0][playerid] = 8;
				}
				else if(listitem == 8)
				{
					atext = "Дверь 1 внутреняя", statas = DomInfo[nd][dDoorInt][0], DP[0][playerid] = 9;
				}
				else if(listitem == 9)
				{
					atext = "Дверь 2 наружняя", statas = DomInfo[nd][dDoor][1], DP[0][playerid] = 10;
				}
				else if(listitem == 10)
				{
					atext = "Дверь 2 внутреняя", statas = DomInfo[nd][dDoorInt][1], DP[0][playerid] = 11;
				}
				if(statas == 0)
				{
					new stro[150],sctringo[600],qwer[40];
	 				format(stro,sizeof(stro),"{ffffff}Вы уверены, что хотите установить %s в этой координате?\n",atext), strcat(sctringo,stro);
	   				if(listitem == 3 || listitem == 4) format(stro,sizeof(stro),"\n{ff0000}Устанавливайте %s только перед реальным объектом!",atext), strcat(sctringo,stro);
	   				else if(listitem == 0)
			   		{
					   	format(stro,sizeof(stro),"\n{ff0000}Устанавливайте спавн в комнате или в гостинной"), strcat(sctringo,stro);
					   	format(stro,sizeof(stro),"\n{ff9000}Не забывайте учитывать, куда смотрит ваш персонаж"), strcat(sctringo,stro);
				   	}
				   	else if(listitem == 5)
			   		{
					   	format(stro,sizeof(stro),"\n{ff0000}Устанавливайте душ непосредственно на объекте ванны"), strcat(sctringo,stro);
					   	format(stro,sizeof(stro),"\n{ff9000}Поскольку объекты гигиены несовершенны, персонаж может принять душ только на объекте ванны"), strcat(sctringo,stro);
				   	}
	    			format(stro,sizeof(stro),"\n{cccccc}Не нарушайте правила RP расположения мебели и взаимодействия с ней"), strcat(sctringo,stro);
	    			format(stro,sizeof(stro),"\n{cccccc}Подробнее о правилах {ff9000}[ pears.fun >> Форум >> Правила Сервера ]"), strcat(sctringo,stro);
	    			format(stro,sizeof(stro),"\n\n\n{ff0000}Нарушение правила: {ff9000}[ 1 Раз - Сброс сохранений дома ] [ 2 Раз - Выставление дома на продажу + Warn ]"), strcat(sctringo,stro);
	    			if(PlayerInfo[playerid][pDom] == nd) format(qwer,sizeof(qwer),"{ff9000}Мой Дом № %d [Взаимодействия]",nd);
					else format(qwer,sizeof(qwer),"{0088ff}Дом № %d [Взаимодействия]",nd);
	    			ShowDialog(playerid,577,DIALOG_STYLE_MSGBOX,qwer,sctringo,"Да","Нет");
				}
				else if(statas == 1)
				{
					new stro[100],qwer[40];
	 				format(stro,sizeof(stro),"{ffffff}Вы уверены, что хотите отключить %s от взаимодействия?\n",atext);
	 				if(PlayerInfo[playerid][pDom] == nd) format(qwer,sizeof(qwer),"{ff9000}Мой Дом № %d [Взаимодействия]",nd);
					else format(qwer,sizeof(qwer),"{0088ff}Дом № %d [Взаимодействия]",nd);
	    			ShowDialog(playerid,892,DIALOG_STYLE_MSGBOX,qwer,stro,"Да","Нет");
				}
			}
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно быть в доме"), pc_cmd_dominteraction(playerid);
		}
		else pc_cmd_mydom(playerid);
	}
	case 577:
	{
		if(response)
		{
			new nd, gde;
			if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000) nd = GetPlayerVirtualWorld(playerid)-1000, gde = 0;
			else nd = PlayerInfo[playerid][pDom], gde = 1;
			if(PlayerInfo[playerid][pDom] == 0 && gde == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет дома");
	    	if(PlayerInfo[playerid][pDom] != nd)
			{
				if(DomInfo[nd][dAccint] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие может только владелец"), pc_cmd_mydom(playerid);
				if(DomInfo[nd][dAccint] == 1 && PlayerInfo[playerid][pHouserent] != nd) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие может только владелец и проживающие"), pc_cmd_mydom(playerid);
				if(DomInfo[nd][dAccint] == 2 && (DomInfo[nd][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[nd][dFam])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие могут только владелец и семья, которая здесь живёт"), pc_cmd_mydom(playerid);
				if(DomInfo[nd][dAccint] == 3 && (DomInfo[nd][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[nd][dFam]) && PlayerInfo[playerid][pHouserent] != nd) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие могут только владелец, проживающие и семья, которая здесь живёт"), pc_cmd_mydom(playerid);
			}
			if(DP[0][playerid] >= 0 && DP[0][playerid] <= 6)
  			{
		    	if(IsPlayerInRangeOfPoint(playerid, 80.0, DomInfo[nd][dEnterX], DomInfo[nd][dEnterY], DomInfo[nd][dEnterZ]) && GetPlayerVirtualWorld(playerid) == nd+1000)
		    	{
			    	if(DP[0][playerid] == 1)
			    	{
         				if(DomInfo[nd][dInspa] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В моём доме уже установлена особая точка спавна"), pc_cmd_dominteraction(playerid);
						DomInfo[nd][dInspa] = 1;
			   			GetPlayerPos(playerid,DomInfo[nd][dSpaX], DomInfo[nd][dSpaY], DomInfo[nd][dSpaZ]);
			   			GetPlayerFacingAngle(playerid, DomInfo[nd][dSpaA]);
