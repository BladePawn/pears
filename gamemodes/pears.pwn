stock StopTaxi(playerid)
{
	if(Taxi[playerid] == INVALID_VEHICLE_ID) return 1;
	if(Taxi[playerid] >= 1)
	{
		if(VehInfo[Taxi[playerid]][vPassajir] == playerid && VehInfo[Taxi[playerid]][v3dstat] >= 1 && VehInfo[Taxi[playerid]][v3dstat] <= 900)
		{
			new string[128];
			new Float:babki = VehInfo[Taxi[playerid]][v3dstat]*VehInfo[Taxi[playerid]][vKilom];
			if(babki >= 1)
			{
				if(IsOnline(VehInfo[Taxi[playerid]][vVodila]))
				{
				    new para1 = VehInfo[Taxi[playerid]][vVodila], summa = floatround(babki, floatround_round);
					PlayerInfo[para1][pMoney] += summa;
					format(string, sizeof(string), "{cccccc}Пассажир покинул такси и заплатил вам за поездку {99ff66}%d$",summa);
					ShowDialog(para1,1742,DIALOG_STYLE_MSGBOX,"{ffcc00}TAXI",string,"Oк","");
					format(string,sizeof(string),"[ Мысли ]: Пассажир покинул такси и заплатил мне за поездку {99ff66}%d$",summa);
      				SendClientMessage(para1,COLOR_GREY,string);
      				if(PlayerInfo[para1][pAchieve][78] == 0) AchievePlayer(para1, 78, 1);
      				
      				format(string, sizeof(string), "{cccccc}Вы покинули TAXI и заплатили водителю {99ff66}%d$",summa);
					ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ffcc00}TAXI",string,"Oк","");
					if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"[ Мысли ]: Я покинул TAXI и заплатил водителю {99ff66}%d$",summa);
					else format(string,sizeof(string),"[ Мысли ]: Я покинула TAXI и заплатила водителю {99ff66}%d$",summa);
					SendClientMessage(playerid,COLOR_GREY,string);
					PlayerInfo[playerid][pMoney] -= summa;
					
					MoneyLog("taxi", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], -summa, "Оплата такси");
					MoneyLog("salary", PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], summa, "Зарплата такси");
				}
			}
			VehInfo[Taxi[playerid]][vKilom] = 0.0;
			VehInfo[Taxi[playerid]][vPassajir] = 9999;
			Taxi[playerid] = 0;
		}
	}
	return 1;
}
stock SnowGo(playerid, stat)
{
	if(OnlineInfo[playerid][oLogged] == 1)
	{
		if(stat == 1 && Snow[1][playerid] == 0)
		{
			if(PlayerInfo[playerid][pBkyrenie] <= 1 && GetPlayerInterior(playerid) == 0)
			{
				new Float:posic[3];
				GetPlayerPos(playerid, posic[0], posic[1], posic[2]);
				Snow[0][playerid] = CreatePlayerObject(playerid, 18864, posic[0], posic[1], posic[2]-30.0, 0.0, 0.0, -40.0);
				Snow[1][playerid] = 1;
			}
		}
		else if(stat == 0 && Snow[1][playerid] == 1)
		{
			DestroyPlayerObject(playerid, Snow[0][playerid]);
			Snow[1][playerid] = 0;
		}
	}
	return 1;
}
stock ExitAlt(playerid)
{
	if(PlayerInfo[playerid][pKomnata] != 9999 && PlayerInfo[playerid][pKomnata] >= 1)
	{
		if(GetPlayerVirtualWorld(playerid) == 3 && PlayerInfo[playerid][pKomnataCity] != 1) return ErrorMessage(playerid, "{FF6347}Вы не снимаете номер в отеле LS");
		if(GetPlayerVirtualWorld(playerid) == 7 && PlayerInfo[playerid][pKomnataCity] != 3) return ErrorMessage(playerid, "{FF6347}Вы не снимаете номер в отеле LV");

		if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
		new myhot = 0, world = GetPlayerVirtualWorld(playerid);
		if(IsPlayerInRangeOfPoint(playerid,2.0,1378.8070,-39.5347,1000.9255) && PlayerInfo[playerid][pKomnata] != 1) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1378.7472,-33.3985,1000.9255) && PlayerInfo[playerid][pKomnata] != 2) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1378.7789,-27.1808,1000.9255) && PlayerInfo[playerid][pKomnata] != 3) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1387.2513,-34.9258,1000.9136) && PlayerInfo[playerid][pKomnata] != 4) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1387.0970,-40.6545,1000.9203) && PlayerInfo[playerid][pKomnata] != 5) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1406.5548,-39.6099,1000.9214) && PlayerInfo[playerid][pKomnata] != 6) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1406.5549,-33.4725,1000.9214) && PlayerInfo[playerid][pKomnata] != 7) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1406.5549,-27.2366,1000.9214) && PlayerInfo[playerid][pKomnata] != 8) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1398.4070,-34.8619,1000.9160) && PlayerInfo[playerid][pKomnata] != 9) myhot = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1398.1879,-40.6545,1000.9138) && PlayerInfo[playerid][pKomnata] != 10) myhot = 1;
		if(myhot == 1)
		{
			new string[64];
			format(string,sizeof(string),"{FF6347}Это не ваша комната\n{cccccc}Вы снимаете номер %d",PlayerInfo[playerid][pKomnata]);
      		ErrorMessage(playerid, string);

      		if(PlayerInfo[playerid][pKomnata] == 1)CreateGps(playerid,1378.8070,-39.5347,1000.9255, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 2)CreateGps(playerid,1378.7472,-33.3985,1000.9255, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 3)CreateGps(playerid,1378.7789,-27.1808,1000.9255, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 4)CreateGps(playerid,1387.2513,-34.9258,1000.9136, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 5)CreateGps(playerid,1387.0970,-40.6545,1000.9203, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 6)CreateGps(playerid,1406.5548,-39.6099,1000.9214, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 7)CreateGps(playerid,1406.5549,-33.4725,1000.9214, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 8)CreateGps(playerid,1406.5549,-27.2366,1000.9214, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 9)CreateGps(playerid,1398.4070,-34.8619,1000.9160, world, 4, 2.0);
			else if(PlayerInfo[playerid][pKomnata] == 10)CreateGps(playerid,1398.1879,-40.6545,1000.9138, world, 4, 2.0);
      		return 1;
		}
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,playerid+1,0);
		PPSetPlayerInterior(playerid,0);
		if(world == 4) PPSetPlayerPos(playerid,1659.2850,-2278.2585,30.3279), PPSetPlayerFacingAngle(playerid,0.0);
		else if(world == 7) PPSetPlayerPos(playerid,1757.0099,1379.7758,28.0187), PPSetPlayerFacingAngle(playerid,309.8792);
		SetCameraBehindPlayer(playerid);
		if(NoCompleteQuest(playerid, 2)) RemovePlayerAttachedObject(playerid,1), ShowQwest(playerid, 2);
	}
	return 1;
}
function Call_Offlinefind(playerid, stat, str_name[], dop)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new string[244];
	    if(stat == 0)
	    {
	    	format(ListName[playerid],24,"%s", str_name);
	    	format(string, sizeof(string),"\n{cccccc}Введите {99ff66}количество денег{cccccc}, чтобы выполнить Offline перевод\n\nПеревод на счёт {ff9000}%s\n{cccccc}Мой Счёт: {99ff66}%d$ [%s]\n",ListName[playerid],PlayerInfo[playerid][pAccount],get_k(PlayerInfo[playerid][pAccount]));
			ShowDialog(playerid,398,DIALOG_STYLE_INPUT,"{99ff66}Банк",string,"Принять","Отмена");
		}
		else if(stat == 1)
	    {
	        SetPVarInt(playerid,"aflog2",0);
	        if(dop > PlayerInfo[playerid][pAccount]) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: На банковском счету недостаточно средств"), PlayerPlaySound(playerid,4203,0,0,0), bank(playerid, 2);
	        
			new giveplayerid = ReturnUser(str_name, 1);
			if(IsPlayerConnected(giveplayerid) && OnlineInfo[giveplayerid][oLogged] == 0) return ErrorText(playerid, "{FF6347}Дождитесь пока игрок авторизуется и повторите попытку"), bank(playerid, 2);
			
			new datadid, account;
	        cache_get_value_name_int(0, "user_id", datadid);
	        cache_get_value_name_int(0, "Account", account);
			PlayerPlaySound(playerid,6401,0,0,0);
			PlayerInfo[playerid][pAccount] -= dop;
			mysql_save(playerid, 43);
			format(string, sizeof(string), "%s[%d] перевёл offline %d$ [%s] на счёт %s",rpplayername(playerid),playerid,dop,get_k(dop),str_name);
			SendAdminMessage(COLOR_YELLOW2, string);
			format(string, sizeof(string),"\n{cccccc}Вы выполнили Offline перевод {99ff66}%d$ [%s] {cccccc}на счёт {ff9000}%s\n",dop,get_k(dop),str_name);
			ShowDialog(playerid,1012,DIALOG_STYLE_MSGBOX, "{99ff66}Банк", string, "Ок", "");
			mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Account`='%d' WHERE `user_id`='%d'",account+dop,datadid), query_empty(pearsq, string);
			MoneyLog("bankpay", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", -dop, "Перевёл Деньги");
			MoneyLog("bankpay", datadid, str_name, "", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], dop, "Получил Перевод");
			format(string, sizeof(string), "Вы получили перевод %d$ [%s]",dop,get_k(dop));
	    	notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	    }
	}
	else
	{
	    SetPVarInt(playerid,"aflog2",0);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: %s не найден",str_name), PlayerPlaySound(playerid,4203,0,0,0);
		if(stat == 0) bank(playerid, 2);
	}
	return 1;
}
forward AeroTime(playerid,stat);
public AeroTime(playerid,stat)
{
	if(IsPlayerConnected(playerid)) // В сети ли игрок
	{
	    if(AeroTimer[playerid]) KillTimer(AeroTimer[playerid]), AeroTimer[playerid] = 0;
	    if(stat == 0)
	    {
			if(PlayerInfo[playerid][pKomnataCity] == 3) // LV
			{
				SetPlayerObjectPos(playerid, AeroObj[playerid], 1479.163818, 1833.960327, 30.860614);
				SetPlayerObjectRot(playerid, AeroObj[playerid], 0.0, -3.0, -90.0);
				MovePlayerObject(playerid, AeroObj[playerid], 1479.163818, 1418.040405, 15.699222, 50.0);
				InterpolateCameraPos(playerid, 1456.253540, 1611.061401, 11.685944, 1455.986572, 1488.752563, 12.339449, 18000);
				InterpolateCameraLookAt(playerid, 1456.953369, 1616.010375, 11.551815, 1456.605346, 1493.714111, 12.342022, 18000);
			}
			else
			{
	        	SetPlayerObjectPos(playerid, AeroObj[playerid], 1399.957397, -2491.403320, 48.499221);
				SetPlayerObjectRot(playerid, AeroObj[playerid], 0.0, 0.500074, 0.0);
	        	MovePlayerObject(playerid, AeroObj[playerid], 1815.877319, -2491.403320, 18.359218, 50.0);
				InterpolateCameraPos(playerid, 1736.775024, -2513.676757, 16.343547, 1827.838745, -2513.608886, 15.272412, 18000);
				InterpolateCameraLookAt(playerid, 1731.820800, -2513.054687, 16.605146, 1822.969116, -2512.474609, 15.260693, 18000);
			}
			AeroTimer[playerid] = SetTimerEx("AeroTime", 8000, false, "dd", playerid, 4);
	    }
	    else if(stat == 4)
	    {
	        PPExitSpectating(playerid);
			if(PlayerInfo[playerid][pKomnataCity] == 3)
			{
				S_SetPlayerVirtualWorld(playerid,183,0), PPSetPlayerInterior(playerid,0);
				PPSetPlayerPos(playerid, 1575.5471,1456.3102,10.8726), PPSetPlayerFacingAngle(playerid, 178.9046);
			}
			else
			{
	        	S_SetPlayerVirtualWorld(playerid,198,0), PPSetPlayerInterior(playerid,0);
	        	PPSetPlayerPos(playerid, 1706.9386,-2428.4026,13.5767), PPSetPlayerFacingAngle(playerid, 268.8323);
	        }
	    	if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;
	        TextDrawShowForPlayer(playerid, Chernifon);
			TogglePlayerControllable(playerid, true);
			SetCameraBehindPlayer(playerid);
	        AeroTimer[playerid] = SetTimerEx("AeroTime", 2000, false, "dd", playerid,1);
	        SetPlayerAttachedObject(playerid, 1, 19624, 6, 0.076999, 0.019000, 0.000000, -1.099999, -104.800018, -4.500000, 1.000000, 1.000000, 1.000000, 0, 0);
	        return 1;
	    }
	    else if(stat == 1) // Самолёт прилетел, запускаем процесс регистрации
	    {
			new string_mysql[140];
			mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", PlayerInfo[playerid][pName]);
			mysql_tquery(pearsq, string_mysql, "OnPlayerRegister", "d", playerid);
	        return 1;
	    }
    }
    return 1;
}

// Действия создания аккаунта после прилёта на сервер
stock CreateAccountProcess(playerid)
{
	OnlineInfo[playerid][oLoggedUnix] = gettime(); // Unix время когда игрок залогинился на сервере

	OnlineInfo[playerid][oLogged] = 1;
	SetPlayerName(playerid, PlayerInfo[playerid][pName]);
	if(GetSkinSex(PlayerInfo[playerid][pModel]) == 2) PlayerInfo[playerid][pSex] = 2; // Woman
	else if(GetSkinSex(PlayerInfo[playerid][pModel]) == 1) PlayerInfo[playerid][pSex] = 1; // Man
	PPSpawnPlayer(playerid);

	if(PlayerInfo[playerid][pKomnataCity] == 3) // LV
	{
		S_SetPlayerVirtualWorld(playerid,183,0), PPSetPlayerInterior(playerid,0);
		switch(random(9))
		{
			case 0: PPSetPlayerPos(playerid, 1575.5471,1456.3102,10.8726), PPSetPlayerFacingAngle(playerid,178.9046);
			case 1: PPSetPlayerPos(playerid, 1581.8739,1455.7368,10.8726), PPSetPlayerFacingAngle(playerid,180.1580);
			case 2: PPSetPlayerPos(playerid, 1578.5601,1455.4353,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
			case 3: PPSetPlayerPos(playerid, 1575.5455,1453.1757,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
			case 4: PPSetPlayerPos(playerid, 1578.6984,1452.9020,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
			case 5: PPSetPlayerPos(playerid, 1582.3218,1452.7778,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
			case 6: PPSetPlayerPos(playerid, 1582.2981,1449.8221,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
			case 7: PPSetPlayerPos(playerid, 1578.7667,1449.5120,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
			case 8: PPSetPlayerPos(playerid, 1574.7686,1449.2871,10.8726), PPSetPlayerFacingAngle(playerid,179.5313);
		}
	}
	else // LS
	{
		S_SetPlayerVirtualWorld(playerid,198,0), PPSetPlayerInterior(playerid,0);
		switch(random(9))
		{
			case 0: PPSetPlayerPos(playerid, 1706.9386,-2428.4026,13.5767), PPSetPlayerFacingAngle(playerid,268.8323);
			case 1: PPSetPlayerPos(playerid, 1709.2461,-2428.4236,13.5767), PPSetPlayerFacingAngle(playerid,269.4590);
			case 2: PPSetPlayerPos(playerid, 1712.4216,-2428.4529,13.5767), PPSetPlayerFacingAngle(playerid,269.4590);
			case 3: PPSetPlayerPos(playerid, 1707.5978,-2425.1321,13.5767), PPSetPlayerFacingAngle(playerid,267.2656);
			case 4: PPSetPlayerPos(playerid, 1710.5299,-2425.0483,13.5767), PPSetPlayerFacingAngle(playerid,268.2056);
			case 5: PPSetPlayerPos(playerid, 1713.3082,-2425.1357,13.5767), PPSetPlayerFacingAngle(playerid,268.2056);
			case 6: PPSetPlayerPos(playerid, 1707.0990,-2421.5386,13.5767), PPSetPlayerFacingAngle(playerid,270.7122);
			case 7: PPSetPlayerPos(playerid, 1710.2264,-2421.5808,13.5767), PPSetPlayerFacingAngle(playerid,270.7122);
			case 8: PPSetPlayerPos(playerid, 1713.3613,-2421.6289,13.5767), PPSetPlayerFacingAngle(playerid,270.7122);
		}
	}
	SetCameraBehindPlayer(playerid);
	gZaregal[playerid] = 0;
	TextDrawHideForPlayer(playerid, Chernifon);
	HideMainLogoServer(playerid);
	if(PlayerInfo[playerid][pDrawVisible][2] == false) showsiteserver(playerid);
	showtimeserver(playerid);
	PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/welcome.mp3");
	new string[154];
	format(string,sizeof(string),"{ffcc66}Ваш аккаунт № {0088ff}%d {ffcc66}успешно создан. Приятной игры {ffcc66}:)",PlayerInfo[playerid][pID]);
	SendClientMessage(playerid, COLOR_GREY, string);
	
	GiveThingPlayer(playerid, 51, 1, 0, 0, 0, 0, 9999); // Даём паспорт
	GiveThingPlayer(playerid, 26, 1, 0, 0, 0, 0, 9999); // Даём смартфон
	GiveThingPlayer(playerid, 156, 2, PlayerInfo[playerid][pID], 0, 0, 0, 9999); // Даём водительские права (2 Quan - значит их нельзя будет передать)

	PlayerInfo[playerid][pMoney] = 6000; // Даём бабло на руки
	PlayerInfo[playerid][pAccount] = 3000; // Даём бабло на банковский счет

	// Пополняем навык владения авто
	if(PlayerInfo[playerid][pCarLic] <= 99) PlayerInfo[playerid][pCarLic] = 100;
	
	if(PlayerInfo[playerid][pPromoreg] >= 1)
	{
		new myp = -1;
		for(new f = 0; f < MAX_PROMO; f++)
		{
			if(PromoInfo[f][roNewid] == PlayerInfo[playerid][pPromoreg]) myp = f;
		}
		if(myp >= 0)
		{
			SendClientMessage(playerid, COLOR_GREY,"{ffcc66}Подарки по промокоду:");
			for(new statpf = 0; statpf < 5; statpf++)
			{
				if(PromoInfo[myp][roPar][statpf] == 10) SendClientMessage(playerid, COLOR_GREY,"{ffffff}X2 Exp {ffcc66}[ /stats ]"), PlayerInfo[playerid][pX2exp] += PromoInfo[myp][roStat][statpf];
				if(PromoInfo[myp][roPar][statpf] == 12) SendClientMessage(playerid, COLOR_GREY,"{ffffff}VIP {ffcc66}[ /stats ]"), PlayerInfo[playerid][pDonateRank] = 1, givevip(playerid, PromoInfo[myp][roStat][statpf]), mysql_save(playerid, 4);
			}
		}
	}

	#if defined SAMPVOICE_COMPILE_3 
	Sampvoice3InitializationPlayer(playerid);
	#endif

	PlayerInfo[playerid][pAge] = 18;
	if(GetSkinSex(PlayerInfo[playerid][pModel]) == 2) PlayerInfo[playerid][pSex] = 2; // Woman
	else if(GetSkinSex(PlayerInfo[playerid][pModel]) == 1) PlayerInfo[playerid][pSex] = 1; // Man
	PlayerInfo[playerid][pTut] = 1;
	PlayerInfo[playerid][pLevel] = 1;
	PlayerInfo[playerid][pInfoload] = 800; // Гигиена
	PlayerInfo[playerid][pCap] = 80; // Нужда
	UpdateHunger(playerid, 800); // Сытость
	
	mysql_save(playerid, 11);
	
	monitoring_registr[0] ++;

	SetPlayerAttachedObject(playerid, 1, 19624, 6, 0.076999, 0.019000, 0.000000, -1.099999, -104.800018, -4.500000, 1.000000, 1.000000, 1.000000, 0, 0);
	PreloadAnimLib(playerid,"DEALER");

	// Создаём ежедневные задания
	CreateDaily(playerid, 0);

	resetPlayerTransmitter(playerid); // Перезагружаем настройки чтения рации

	// Ачивки загружены, статус
	PlayerInfo[playerid][pAchieveLoad] = true;
	return true;
}

// Создаём дополнительные таблицы с сохранениями аккаунта игрока
stock CreateAdditionalyDatabase(user_id)
{
	new string[180];
	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_igroki_contacts` SET `user_id` = '%d'", user_id), mysql_tquery(pearsq, string);

	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_achieve` SET `user_id` = '%d'", user_id), mysql_tquery(pearsq, string);

	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_wanted` SET `playerid` = '%d'", user_id), mysql_tquery(pearsq, string);

	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_igroki_inventory` SET `user_id`= '%d'", user_id), mysql_tquery(pearsq, string);

	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_igroki_hint` SET `user_id`= '%d'", user_id), mysql_tquery(pearsq, string);

	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_igroki_maniac` SET `user_id`= '%d'", user_id), mysql_tquery(pearsq, string);

	mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_igroki_top` SET `user_id`= '%d'", user_id), mysql_tquery(pearsq, string);
	return 1;
}

stock Aero(playerid)
{
	ShowMainLogoServer(playerid);
	CancelSelectTextDraw(playerid);
	TogglePlayerControllable(playerid, true);
	PlayerInfo[playerid][pModel] = GetPVarInt(playerid,"SkinLave");
	PlayerInfo[playerid][pModel2] = 0;
	PlayerInfo[playerid][pModel3] = 0;
	PlayerInfo[playerid][pAge] = 18;
	CloseShmot(playerid);
	SetPVarInt(playerid, "SelectCharPlace",0);

    PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/plane.mp3");
	PPSetPlayerPos(playerid, 1623.9279,-2572.7581,13.5469);
	PPTogglePlayerSpectating(playerid, true);
	S_SetPlayerVirtualWorld(playerid,playerid+1,0);
	PPSetPlayerInterior(playerid,0);
	PPSetSpawnInfo(playerid);
	if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;

	if(PlayerInfo[playerid][pKomnataCity] == 3) // LV
	{
		AeroObj[playerid] = CreatePlayerObject(playerid, 1683, 713.230163, 2372.987548, 87.706596, 0.000000, -5.000000, -90.000000, 700.0);
		AeroStat[playerid] = 1;
		SetPlayerObjectMaterial(playerid, AeroObj[playerid], 1, 19962, "samproadsigns", "materialtext1", 0x00000000);
		MovePlayerObject(playerid, AeroObj[playerid], 713.230163, 2102.147033, 87.706596, 20.0);
		InterpolateCameraPos(playerid, 883.026184, 2261.381591, 10.966418, 882.224792, 2194.903808, 10.483819, 15000, CAMERA_MOVE);
		InterpolateCameraLookAt(playerid, 878.125488, 2261.109130, 11.919843, 877.349426, 2194.846435, 11.591734, 15000, CAMERA_MOVE);
	}
	else // LS
	{
		AeroObj[playerid] = CreatePlayerObject(playerid, 1683, 470.406005, -1948.819580, 50.469181, 0.000000, 0.500000, 0.000000, 700.0);
		AeroStat[playerid] = 1;
		SetPlayerObjectMaterial(playerid, AeroObj[playerid], 1, 19962, "samproadsigns", "materialtext1", 0x00000000);
		MovePlayerObject(playerid, AeroObj[playerid], 741.246520, -1948.819580, 50.469181, 20.0);
		InterpolateCameraPos(playerid, 555.537353, -1798.702880, 6.139889, 588.992980, -1799.023071, 6.208514, 15000, CAMERA_MOVE);
		InterpolateCameraLookAt(playerid, 555.644165, -1803.679199, 6.614527, 589.343566, -1803.974975, 6.804748, 15000, CAMERA_MOVE);
	}
	AeroTimer[playerid] = SetTimerEx("AeroTime", 9000, false, "dd", playerid,0);
	return 1;
}
stock CloseTuning(playerid)
{
	if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192)
	{
		new vid = GetPlayerVehicleID(playerid);
		new model = VehInfo[vid][vModel];
		new Float:X, Float:Y, Float:Z, Float:rX, Float:rY, Float:rZ;
        GetPlayerCameraPos(playerid, X, Y, Z);
        GetPlayerCameraFrontVector(playerid, rX, rY, rZ);
		if(IsABig(model))
		{
			InterpolateCameraPos(playerid, X, Y, Z, -1124.197387, 2869.546875, 920.400634, 1500);
        	InterpolateCameraLookAt(playerid, X+5.0*rX, Y+5.0*rY, Z+5.0*rZ, -1125.660156, 2874.268066, 919.644958, 1300);
		}
		else if(IsAMoto(model))
		{
			InterpolateCameraPos(playerid, X, Y, Z, -1131.184082, 2869.335693, 919.213500, 1500);
        	InterpolateCameraLookAt(playerid, X+5.0*rX, Y+5.0*rY, Z+5.0*rZ, -1136.030883, 2868.354980, 918.474060, 1300);
		}
		else
		{
			InterpolateCameraPos(playerid, X, Y, Z, -1130.384399, 2875.142333, 919.587463, 1500);
        	InterpolateCameraLookAt(playerid, X+5.0*rX, Y+5.0*rY, Z+5.0*rZ, -1135.326416, 2874.769531, 918.925659, 1300);
		}
		if(VehInfo[vid][vBonnet] == 1 && IsACar(model))
		{
			GetVehicleParamsEx(vid, engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(vid, engine, lights, alarm, doors, false, boot, objective);
			VehInfo[vid][vBonnet] = 0;
		}
	}
	return 1;
}
stock LaveTuning(playerid,lave,stat)
{
	if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192)
	{
		SetPVarInt(playerid,"Laveska",lave);
		TextDrawShowForPlayer(playerid, TuningDraw[12]);
		TextDrawShowForPlayer(playerid, TuningDraw[13]);
		TextDrawShowForPlayer(playerid, TuningDraw[14]);
		TextDrawShowForPlayer(playerid, TuningDraw[15]);
		TextDrawShowForPlayer(playerid, TuningDraw[16]);
		new stringa[12];
		format(stringa, sizeof(stringa), "%d$", GetPVarInt(playerid,"Laveska"));
		PlayerTextDrawSetString(playerid, PlaTuningDraw, stringa);
		PlayerTextDrawShow(playerid, PlaTuningDraw);
		SetPVarInt(playerid,"tunstat",stat);
	}
	return 1;
}
stock statun(playerid,stat)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 	{
		new b = gAutosalon[playerid];
		if(stat == 0) ShowDialog(playerid,720,DIALOG_STYLE_LIST,"{ff9000}Автосервис","{ff9000}Alien\n{ff9000}X-Flow\n{cccccc}Снять Деталь","Выбор","Отмена");
		else if(stat == 1 || stat == 2)
		{
			if(BizzInfo[b][bItem][5] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет деталей тюнинга в наличии");
			if(stat == 1)ShowDialog(playerid,726,DIALOG_STYLE_LIST,"{ff9000}Автосервис [ Alien ]","Передний Бампер\nЗадний Бампер\nКрыша\nСпойлер\nПороги\nГлушитель","Выбор","Отмена");
			else if(stat== 2)ShowDialog(playerid,727,DIALOG_STYLE_LIST,"{ff9000}Автосервис [ X-Flow ]","Передний Бампер\nЗадний Бампер\nКрыша\nСпойлер\nПороги\nГлушитель","Выбор","Отмена");
		}
		else if(stat == 3)
		{
			if(BizzInfo[b][bItem][2] < 4)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет дисков в наличии");
			new vid = GetPlayerVehicleID(playerid);
			new model = VehInfo[vid][vModel];
			new Float:X, Float:Y, Float:Z, Float:rX, Float:rY, Float:rZ;
			GetPlayerCameraPos(playerid, X, Y, Z);
			GetPlayerCameraFrontVector(playerid, rX, rY, rZ);
			if(IsABig(model))
			{
				InterpolateCameraPos(playerid, X, Y, Z, -1138.372802, 2880.282470, 919.121520, 1500);
				InterpolateCameraLookAt(playerid, X+5.0*rX, Y+5.0*rY, Z+5.0*rZ, -1133.381713, 2880.350585, 918.831054, 1300);
			}
			else
			{
				InterpolateCameraPos(playerid, X, Y, Z, -1134.922485, 2879.080078, 918.136047, 1500);
				InterpolateCameraLookAt(playerid, X+5.0*rX, Y+5.0*rY, Z+5.0*rZ, -1137.662353, 2874.922363, 917.682006, 1300);
			}
			ShowDialog(playerid,724,DIALOG_STYLE_LIST,"{ff9000}Диски","Offroad\nShadow\nMega\nRimshine\nWires\nClassic\nTwist\nCutter\nSwitch\nGrove\nImport\nDollar\nTrance\nAtomic\nAhab\nVirtual\nAccess\nСтандартные","Выбор","Отмена");
		}
		else if(stat == 4) ShowDialog(playerid,728,DIALOG_STYLE_LIST,"{ff9000}Автосервис [ Снять Деталь ]","Передний Бампер\nЗадний Бампер\nКрыша\nСпойлер\nПороги\nГлушитель","Выбор","Отмена");
		return 1;
   	}
	return 1;
}
stock ExitTuning(playerid)
{
	if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192)
	{
		if(OnlineInfo[playerid][oTimerAutoservice] > 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Дождитесь завершения выхода из тест драйва");

		new vid = GetPlayerVehicleID(playerid);
		PlayerPlaySound(playerid, 30803, 0.0, 0.0, 0.0);

		if(gAutosalon[playerid] == 183){PPSetVehiclePos(playerid,932.0283,-1717.0236,13.5469); SetVehicleZAngle(vid, 87.3580);}
		else if(gAutosalon[playerid] == 184){PPSetVehiclePos(playerid,1220.2476,-907.9068,42.9802); SetVehicleZAngle(vid, 190.5880);}
		else if(gAutosalon[playerid] == 185){PPSetVehiclePos(playerid,1798.9651,-1776.2811,13.5968); SetVehicleZAngle(vid, 274.9125);}
		else if(gAutosalon[playerid] == 186){PPSetVehiclePos(playerid,-2271.1182,-154.0399,35.3203); SetVehicleZAngle(vid, 266.3580);}
		else if(gAutosalon[playerid] == 187){PPSetVehiclePos(playerid,-2183.9426,984.4159,80.0000); SetVehicleZAngle(vid, 3.5880);}
		else if(gAutosalon[playerid] == 188){PPSetVehiclePos(playerid,-2568.5549,683.1563,27.8125); SetVehicleZAngle(vid, 87.9125);}
		else if(gAutosalon[playerid] == 189){PPSetVehiclePos(playerid,1551.0115,985.1170,10.8590); SetVehicleZAngle(vid, 0.3580);}
		else if(gAutosalon[playerid] == 190){PPSetVehiclePos(playerid,1630.8203,2188.5461,10.8692); SetVehicleZAngle(vid, 269.5880);}
		else if(gAutosalon[playerid] == 191){PPSetVehiclePos(playerid,2628.2158,1197.9806,10.8530); SetVehicleZAngle(vid, 181.9125);}
		else if(gAutosalon[playerid] == 192){PPSetVehiclePos(playerid,-1270.4957,2696.4504,50.0980); SetVehicleZAngle(vid, 121.9125);}
		gAutosalon[playerid] = 0;

		hideDraw_Autoservice(playerid);
		OnlineInfo[playerid][oShowInterface] = 0; // Офаем интерфейс автосервиса
		SetPVarInt(playerid,"tunstat",0);

		if (vid > 0)
		{
			VehInfo[vid][vHandlingModelTemp] = 0;

			SetVehicleVirtualWorld(vid, 0);
			LinkVehicleToInterior(vid, 0);

			// Пересобираем хендлинг после выхода из автосервиса
			SetHandlingTotal(vid, true);

			if(VehInfo[vid][vTunningBPANTemp] > 0 && VehInfo[vid][vTunningBPAN] != VehInfo[vid][vTunningBPANTemp])
			{
				VehInfo[vid][vTunningBPAN] = VehInfo[vid][vTunningBPANTemp];
				SetVehicleHandlingFloat(vid, HANDLING_SUSPFORCELEVEL, VehInfo[vid][vTunningBPAN]);
				VehInfo[vid][vTunningBPANTemp] = 0.0;
			}
			else if(VehInfo[vid][vTunningBPAN] > 0 && VehInfo[vid][vTunningBPANTemp] > 0 && VehInfo[vid][vTunningBPAN] != VehInfo[vid][vTunningBPANTemp])
			{
				VehInfo[vid][vTunningBPAN] = VehInfo[vid][vTunningBPANTemp];
				SetVehicleHandlingFloat(vid, HANDLING_SUSPFORCELEVEL, VehInfo[vid][vTunningBPAN]);
				VehInfo[vid][vTunningBPANTemp] = 0.0;
			}

			// Заводим двигло
			if(VehInfo[vid][vGas] >= 1 || VehInfo[vid][vGelium] >= 1)
			{
				GetVehicleParamsEx(vid, engine, lights, alarm, doors, bonnet, boot, objective);
				SetVehicleParamsEx(vid, true, lights, alarm, doors, bonnet, boot, objective);
				VehInfo[vid][vEngine] = 1;
			}
			VehInfo[vid][vTestDrive] = 0;
			SaveCar(vid);
		}

		S_SetPlayerVirtualWorld(playerid,0,0);
		PPSetPlayerInterior(playerid,0);

		CancelSelectTextDraw(playerid);
		TogglePlayerControllable(playerid, true);
		SetCameraBehindPlayer(playerid);
		NoAnim[playerid] = 0; HidePlayerDialog(playerid);

		if(PlayerInfo[playerid][pDrawVisible][7] == false && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8) ShowVehSpeed(playerid);

		// Выключаем коллизию
		NoCollisionForAll(playerid, 0);
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Вы выехали из автосервиса\n{ff9000}Для вас отключены столкновения с другими игроками в транспорте на 20 секунд","*","");

		OnlineInfo[playerid][oAutoserviceVeh] = 0;
		OnlineInfo[playerid][oAutoserviceVehNewid] = 0;

		// Выключаем музыку
    	if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid), HidePlayerHudPopup(playerid);
	}
	return 1;
}
stock EjectBoot(playerid, vehicleid)
{
    VehInfo[vehicleid][vPeople] = 0;
	TakeBoot(vehicleid, 35, 1, 0, 999);

	if(IsOnline(playerid)) // В сети ли игрок и авторизован ли он
	{
		if(GetPVarInt(playerid, "Boot") == vehicleid) // Если игрок в багажнике
		{
		    TextDrawHideForPlayer(playerid, MindDraw[0]), TextDrawHideForPlayer(playerid, MindDraw[1]), TextDrawHideForPlayer(playerid, MindDraw[2]);
			PlayerTextDrawHide(playerid, MindDraw1), PlayerTextDrawHide(playerid, MindDraw2);
			new Float:POS[3];
			if(IsABootFront(vehicleid)) GetCoordBonnetVehicle(vehicleid, POS[0], POS[1], POS[2]);
			else GetCoordBootVehicle(vehicleid, POS[0], POS[1], POS[2]);
			if(howstun(playerid)) TogglePlayerControllable(playerid, true);
			
			PPSetPlayerPos(playerid,POS[0],POS[1],POS[2]);
			S_SetPlayerVirtualWorld(playerid, GetVehicleVirtualWorld(vehicleid), GetVehicleInterior(vehicleid));
			PPSetPlayerInterior(playerid, GetVehicleInterior(vehicleid));
			DeletePVar(playerid, "Boot");
			
			switch(random(3)) // Рандомная Анимка
			{
    			case 0: ApplyAnimation(playerid,"CRACK","crckdeth1",4.0,true,true,true,false,true, SYNC_ALL);
    			case 1: ApplyAnimation(playerid,"CRACK","crckdeth3",4.0,true,true,true,false,true, SYNC_ALL);
    			case 2: ApplyAnimation(playerid,"CRACK","crckdeth4",4.0,true,true,true,false,true, SYNC_ALL);
			}
			if(Stun[1][playerid] == 0)
			{
				SetCameraBehindPlayer(playerid);
				TextDrawHideForPlayer(playerid, Chernifon);
			}
			Stun[2][playerid] = 0;
			StunTime[2][playerid] = 0;
		}
	}
	return 1;
}
stock EjectBespilot(playerid)
{
	bespilot[playerid] = 0;
	bespilotejecttick[playerid] = GetTickCount();
	if(IsAAgetcar(agetvelo[playerid])) AgetDestroy(playerid); // Удаляем Созданный AgetCar
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    keep(playerid);
		if(bespiload[playerid] == 1) PPSetPlayerPos(playerid,-1242.8280,477.4344,11.3964), PPSetPlayerFacingAngle(playerid, 271.4339);
		else if(bespiload[playerid] == 2) PPSetPlayerPos(playerid,115.5103,1827.9005,21.8356), PPSetPlayerFacingAngle(playerid, 90.0);
		bespiload[playerid] = 0;
		S_SetPlayerVirtualWorld(playerid,0,0);
		PPSetPlayerInterior(playerid,0);
	}
	return 1;
}
stock get_odet(playerid, fpick)
{
	for(new i = 0; i < 5; i++)
	{
		if(PlayerInfo[playerid][pOdet][i] == fpick)
		{
		    return 1;
		}
	}
	return 0;
}
stock GetAccessoryPosition(accessoryId, accessoryBone, skinId, &Float:X, &Float:Y, &Float:Z, &Float:rX, &Float:rY, &Float:rZ, &Float:sX, &Float:sY, &Float:sZ, &bone)
{
    new findAcc = -1, Float:aksel[9];
    if(accessoryBone == 0) accessoryBone = 2;
    for(new i = 0; i < MAX_ACCESSORY; i++)
	{
	    if(AccessoryInfo[i][acModel] == accessoryId && AccessoryInfo[i][acBone] == accessoryBone)
	    {
            findAcc = i;
            break;
	    }
	}
	if(findAcc == -1) thing(accessoryId, aksel[0], aksel[1], aksel[2], aksel[3], aksel[4], aksel[5], aksel[6], aksel[7], aksel[8], bone); // Получаем расположение аксессуара и его кость
	else
	{
	    aksel[0] = AccessoryInfo[findAcc][acX];
	  	aksel[1] = AccessoryInfo[findAcc][acY];
	  	aksel[2] = AccessoryInfo[findAcc][acZ];
		aksel[3] = AccessoryInfo[findAcc][acrX];
		aksel[4] = AccessoryInfo[findAcc][acrY];
		aksel[5] = AccessoryInfo[findAcc][acrZ];
		aksel[6] = AccessoryInfo[findAcc][acsX];
		aksel[7] = AccessoryInfo[findAcc][acsY];
		aksel[8] = AccessoryInfo[findAcc][acsZ];
		bone = accessoryBone;
	}

	// Корректировки по разным скинам
	new Float:correctPosition[6];
	if(bone == 0 || bone == 2) CorrectAccessoryHeadPosition(skinId, correctPosition[0], correctPosition[1], correctPosition[2], correctPosition[3], correctPosition[4], correctPosition[5]);
	else if(IsArmor(accessoryId)) CorrectAccessoryBodyPosition(skinId, correctPosition[0], correctPosition[1], correctPosition[2], correctPosition[3], correctPosition[4], correctPosition[5]);

    X = aksel[0] - correctPosition[0];
	Y = aksel[1] - correctPosition[1];
	Z = aksel[2] - correctPosition[2];
	rX = aksel[3];
	rY = aksel[4];
	rZ = aksel[5];
	sX = aksel[6] - correctPosition[3];
	sY = aksel[7] - correctPosition[4];
	sZ = aksel[8] - correctPosition[5];
	return 1;
}
stock CreateOdet(playerid, fpick, inva)
{
	new nea;
	if(fpick == 11712)
	{
		new slot_illness = getillness(playerid, 18);
	 	if(slot_illness >= 0)
	 	{
	 		ApplyAnimation(playerid,"CRACK","crckdeth2",4.0, false, true, true, false, false, SYNC_ALL), Stun[3][playerid] = 1, StunTime[3][playerid] = 20, NoAnim[playerid] = 1, TogglePlayerControllable(playerid, false);
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Ваш персонаж потерял сознание на 20 секунд","*","");
			SetPlayerChatBubble(playerid,"А-а-а-а-а-а!!!",COLOR_RED,45.0,10000);
			infectremedy(playerid, 18, 2000);
			burn_vampire(playerid, 0);
			update_illness(playerid, slot_illness); // Сохраняем
			nea = 1;
	 	}
	}

	new Aks = HasABustAks(playerid,1);
	// Проверка на то, есть ли игрока уже рюкзак на спине
	if(Aks != -1 && IsABackPack(fpick)) return ErrorMessage(playerid, "{FF6347}Вы не можете носить более одного рюкзака\n{ffcc66}Снимите рюкзак, нажав на него два раза"), i_resetveshi(playerid);

	if(!IsADuplicateAks(playerid, fpick)) return ErrorMessage(playerid, "{FF6347}Вы не можете носить более одного аксессуара такого типа"), i_resetveshi(playerid);
    new sl, quan, bone;
	for(new i = 0; i < 5; i++)
	{
	    if(PlayerInfo[playerid][pOdet][i] > 0) quan ++;
		if(PlayerInfo[playerid][pOdet][i] == 0)
		{
		    sl = i;
		    break;
		}
	}
	
	new fpara = PlayerInfo[playerid][pInvenPara][inva], fqara = PlayerInfo[playerid][pInvenQara][inva];
	
	if(PlayerInfo[playerid][pInvenPara][inva] == 0) bone = 2; // Аксессуар без указания кости
	else if(fpick == 11712) bone = 1; // Распятие
	else if(IsArmor(fpick)) bone = 1, ACSetPlayerArmour(playerid, fpara), nea = 1; // Бронежилет
	else if(GetBustAksType(fpick) == -1) bone = PlayerInfo[playerid][pInvenPara][inva]; // Все остальные аксессуары имеют ID своей кости
	else if(GetBustAksType(fpick) != -1) bone = AccessoryCraftListBust[FindItemAccessoryCraft(fpick)][2];
	else bone = 1;
	
    ApplyAnimation(playerid,"PED","Turn_R",4.0, false, true, true, false, false);

    GetAccessoryPosition(fpick, bone, GetPlayerModelSkinOriginal(playerid), PlayerInfo[playerid][pOdet_X][sl], PlayerInfo[playerid][pOdet_Y][sl], PlayerInfo[playerid][pOdet_Z][sl], PlayerInfo[playerid][pOdet_rX][sl], PlayerInfo[playerid][pOdet_rY][sl], PlayerInfo[playerid][pOdet_rZ][sl], PlayerInfo[playerid][pOdet_sX][sl], PlayerInfo[playerid][pOdet_sY][sl], PlayerInfo[playerid][pOdet_sZ][sl], bone);
	
	PlayerInfo[playerid][pOdetBone][sl] = bone;
	PlayerInfo[playerid][pOdet][sl] = fpick;
	PlayerInfo[playerid][pOdetPara][sl] = fpara;
	if(IsABackPack(fpick) && fqara != 0) PlayerInfo[playerid][pOdetQara][sl] = fqara;
	else if(!IsABackPack(fpick)) PlayerInfo[playerid][pOdetQara][sl] = fqara;

	// Надеваем рюкзак
	if(IsABackPack(fpick)) 
	{
		new string_mysql[140];
		if(fqara == 0)
		{
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `backpacks` SET `b_slot_0` = NULL");
			mysql_tquery(pearsq, string_mysql, "Call_getidBackPack", "dd", playerid, sl);
		}
		else
		{
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `backpacks` WHERE `backpackid` = '%d'", fqara);
			mysql_tquery(pearsq, string_mysql, "OnPlayerBackPackLoad", "ddd",playerid, g_MysqlRaceCheck[playerid],sl);
		}
		TabBackpackShow(playerid);
	}

	RemovePlayerAttachedObject(playerid,sl+5);
	SetPlayerAttachedObject(playerid, sl+5, PlayerInfo[playerid][pOdet][sl], PlayerInfo[playerid][pOdetBone][sl], PlayerInfo[playerid][pOdet_X][sl], PlayerInfo[playerid][pOdet_Y][sl], PlayerInfo[playerid][pOdet_Z][sl], PlayerInfo[playerid][pOdet_rX][sl], PlayerInfo[playerid][pOdet_rY][sl], PlayerInfo[playerid][pOdet_rZ][sl], PlayerInfo[playerid][pOdet_sX][sl], PlayerInfo[playerid][pOdet_sY][sl], PlayerInfo[playerid][pOdet_sZ][sl]);
	
	if(nea == 0) PlayerPlaySound(playerid,5601,0,0,0), SetPlayerChatBubble(playerid,"надевает аксессуар",COLOR_PURPLE,20.0,3000);
	
	ClearPlayerInven(playerid, inva); // Очищаем переменные pInven
	SaveInvent(playerid, inva); // Сохраняем ячейку инвентаря
	UpdateOdet(playerid, sl);
	i_tile(playerid, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenQuan][inva], inva, PlayerInfo[playerid][pInvenPara][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]);
	
	if(OnlineInfo[playerid][oShowInterface] == 1) i_akses(playerid, sl);
	if(PlayerInfo[playerid][pAchieve][19] == 0) AchievePlayer(playerid, 19, 1);
	if(PlayerInfo[playerid][pAchieve][112] == 0 && quan >= 4) AchievePlayer(playerid, 112, 1);
	i_resetveshi(playerid);
    return 1;
}
stock OpenTv(playerid)
{
    TextDrawShowForPlayer(playerid, TvCam[0]);
	TextDrawShowForPlayer(playerid, TvCam[1]);
 	TextDrawShowForPlayer(playerid, TvCam[2]);
  	TextDrawShowForPlayer(playerid, TvCam[3]);
	if(cnnchan == 1) // Включаем камеру в студии
	{
	   PPOpenSpectating(playerid, 1743.183471, 789.581604, 138.954757);
	   CnnVed[playerid] = 11;
	   AttachCameraToObject(playerid, camcnn1);
       SetPlayerCameraPos(playerid, -1743.183471, 789.581604, 138.954757);
   	   SetPlayerCameraLookAt(playerid, -1738.291992, 789.622863, 137.919342);
   	   S_SetPlayerVirtualWorld(playerid,0,0);
	   PPSetPlayerInterior(playerid,0);
	}
    return 1;
}
stock CloseTv(playerid)
{
    CnnVed[playerid] = 0;
  	SetPosa[playerid] = 1;
    PPExitSpectating(playerid);
    TextDrawHideForPlayer(playerid, TvCam[0]);
	TextDrawHideForPlayer(playerid, TvCam[1]);
 	TextDrawHideForPlayer(playerid, TvCam[2]);
  	TextDrawHideForPlayer(playerid, TvCam[3]);
  	TogglePlayerControllable(playerid, true);
  	//GetPlayerPos(playerid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
    return 1;
}
stock GetCoordSellCarVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // Координаты позиции продажи авто
{
	new Float:angle,Float:distance, model = GetVehModelOriginal(VehInfo[vehicleid][vModel]);
	GetVehicleModelInfo(model, VEHICLE_MODEL_INFO_SIZE, x, distance, z);
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);

	// Корректируем транспорт (некоторые авто ебано определяют размер)
	new Float:add_y, Float:add_z;
	CorrectSizeVehicleFront_Y(model, VehInfo[vehicleid][vModel], add_y, add_z);

	distance = distance/2 + add_y + 0.5;
    x -= (distance * floatsin(-angle+180, degrees));
    y -= (distance * floatcos(-angle+180, degrees));
	z += add_z;
    return 1;
}
stock GetCoordBonnetVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // Координаты капота автомобиля
{
    new Float:angle,Float:distance, model = GetVehModelOriginal(VehInfo[vehicleid][vModel]);
	GetVehicleModelInfo(model, VEHICLE_MODEL_INFO_SIZE, x, distance, z);
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);

	// Корректируем транспорт (некоторые авто ебано определяют размер)
	new Float:add_y, Float:add_z;
	CorrectSizeVehicleFront_Y(model, VehInfo[vehicleid][vModel], add_y, add_z);

	distance = distance/2 + add_y;
    x -= (distance * floatsin(-angle+180, degrees));
    y -= (distance * floatcos(-angle+180, degrees));
	z += add_z;
    return 1;
}

stock CorrectSizeVehicleFront_Y(model, custommodel, &Float:y, &Float:z)
{
	y = 0.1;
	if(model == 443) y = -3.6;
	else if(model == 515) z -= 0.7;
	else if(model == 544) y = -2.0;
	else if(model == 578 || custommodel == 2032) y = -0.6;
}


stock GetCoordLeftSideVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // Координаты левой бочины транспорта
{
   	new Float:angle,Float:distance;
	GetVehicleModelInfo(GetVehModelOriginal(VehInfo[vehicleid][vModel]), VEHICLE_MODEL_INFO_SIZE, distance, y, z);

	new Float:add = 0.1;
	distance = distance/2 + add;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle-90, degrees));
    y += (distance * floatcos(-angle-90, degrees));
    return 1;
}

stock GetCoordBootVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // Координаты багажника автомобиля
{
   	new Float:angle,Float:distance;
	GetVehicleModelInfo(GetVehModelOriginal(VehInfo[vehicleid][vModel]), VEHICLE_MODEL_INFO_SIZE, x, distance, z);

	new Float:add = 0.1;
	distance = distance/2 + add;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle+180, degrees));
    y += (distance * floatcos(-angle+180, degrees));
    return 1;
}
stock GetCoordTrashVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // Координаты мусоровоза автомобиля
{
    new Float:angle,Float:distance;
	GetVehicleModelInfo(GetVehModelOriginal(VehInfo[vehicleid][vModel]), VEHICLE_MODEL_INFO_SIZE, x, distance, z);
    distance = distance/2 - 1.0;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle+180, degrees));
    y += (distance * floatcos(-angle+180, degrees));
    return 1;
}
stock Kickx(playerid, time = 400)
{
	if(IsOnline(playerid))
	{
		if(OnlineInfo[playerid][oKickTimer] == 0)
		{
	    	TogglePlayerControllable(playerid, false);
			OnlineInfo[playerid][oKickTimer] = SetTimerEx("kickxx", time, false, "d", playerid);
		}
	}
    return 1;
}
public kickxx(playerid)
{
	if(IsOnline(playerid))
	{
		OnlineInfo[playerid][oKickTimer] = 0;
		OnlineInfo[playerid][oKickSystem] = true;
    	Kick(playerid);
	}
    return 1;
}
