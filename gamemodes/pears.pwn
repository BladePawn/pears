        {
        	if(PlayerInfo[playerid][pAssess] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне сейчас не помогали и я не могу дать оценку");
        	if(PlayerInfo[playerid][pAssess] == PlayerInfo[playerid][pID]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу оценивать свою помощь");
			if(listitem == 0) return pc_cmd_assess(playerid, "");
			new para1 = Leadset[playerid];
			if(!IsOnline(para1)) return ErrorText(playerid, "[ Мысли ]: Пользователь, который мне помог, сейчас не на месте..");
			if(PlayerInfo[para1][pSoska] == 0 && PlayerInfo[para1][pExpert] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Пользователь, который мне помог, сейчас не на месте..");
			new atext[20];
			switch(listitem)
    		{
	        	case 1:{ PlayerInfo[para1][pAmmos6] += 3; atext = "{00cc00}Отлично"; }
	        	case 2:{ PlayerInfo[para1][pAmmos6] += 2; atext = "{99ff00}Хорошо"; }
	        	case 3:{ PlayerInfo[para1][pAmmos6] += 1; atext = "{ffcc00}Нормально"; }
	        	case 4:{ PlayerInfo[para1][pAmmos6] -= 2; atext = "{ff6600}Плохо"; }
	        	case 5:{ PlayerInfo[para1][pAmmos6] -= 3; atext = "{ff0000}Ужасно"; }
				default: {}
			}
			PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
			format(string, sizeof(string), "{cccccc}Вы дали оценку работе {ff9000}%s {cccccc}[ %s {cccccc}]",PlayerInfo[para1][pName],atext);
			SendClientMessage(playerid, COLOR_GREY, string);
			if(listitem == 1) format(string, sizeof(string), "{cccccc}Спасибо большое, мы стараемся для вас {ff9000};*"), SendClientMessage(playerid, COLOR_GREY, string);
			else if(listitem == 2) format(string, sizeof(string), "{cccccc}Спасибо за хороший отзыв. Мы будем стараться {ff9000};)"), SendClientMessage(playerid, COLOR_GREY, string);
			else if(listitem == 3) format(string, sizeof(string), "{cccccc}Спасибо за ваш вклад. Администрация будет работать ещё лучше!"), SendClientMessage(playerid, COLOR_GREY, string);
			else if(listitem == 4) format(string, sizeof(string), "{cccccc}Вам что-то не понравилось? Мы сможем решить любую проблему, только дайте знать.."), SendClientMessage(playerid, COLOR_GREY, string);
			else if(listitem == 5)
			{
				format(string, sizeof(string), "{cccccc}Руководство проекта приносит вам свои извинения..."), SendClientMessage(playerid, COLOR_GREY, string);
				format(string, sizeof(string), "{cccccc}Вместе мы сможем решить любую проблему и исправить её ради вас"), SendClientMessage(playerid, COLOR_GREY, string);
			}
			format(string, sizeof(string), "{cccccc}%s оценил вашу помощь [ %s {cccccc}]",PlayerInfo[playerid][pName],atext);
			SendClientMessage(para1, COLOR_GREY, string);
			PlayerPlaySound(para1, 1084, 0.0, 0.0, 0.0);
