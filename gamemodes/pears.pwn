stock show_akses(playerid, sel)
{
	OnlineInfo[playerid][oShowInterface] = 18;

	new b = Bid[playerid]-173, string[24];
	SetPVarInt(playerid, "SelectCharPlace", sel);
	RemovePlayerAttachedObject(playerid,5);
 	if(AksesItem[b][sel] > 0)
 	{
 	    new Float:aksel[9], bone;
		GetAccessoryPosition(AksesItem[b][sel], bone, GetPlayerModelSkinOriginal(playerid), aksel[0], aksel[1], aksel[2], aksel[3], aksel[4], aksel[5], aksel[6], aksel[7], aksel[8], bone);
 	
		SetPlayerAttachedObject(playerid, 5, AksesItem[b][sel], bone, aksel[0], aksel[1], aksel[2], aksel[3], aksel[4], aksel[5], aksel[6], aksel[7], aksel[8]);
		PlayerTextDrawColour(playerid, PlaDressDraw[0], 13172735), format(string,sizeof(string), "ID:_%d", AksesItem[b][sel]), PlayerTextDrawSetString(playerid, PlaDressDraw[0], string), PlayerTextDrawShow(playerid, PlaDressDraw[0]);
		format(string,sizeof(string), "%d$", AksesPrice[b][sel]), PlayerTextDrawSetString(playerid, PlaDressDraw[3], string), PlayerTextDrawShow(playerid, PlaDressDraw[3]);
		format(string,sizeof(string), "%s", GetTextDrawNameAccessory(AksesItem[b][sel]));
		PlayerTextDrawSetString(playerid, PlaDressDraw[1], string);
		PlayerTextDrawShow(playerid, PlaDressDraw[1]);
	}
	else
	{
		PlayerTextDrawColour(playerid, PlaDressDraw[0], -1523963137), PlayerTextDrawSetString(playerid, PlaDressDraw[0], "NONE"), PlayerTextDrawShow(playerid, PlaDressDraw[0]);
		PlayerTextDrawHide(playerid, PlaDressDraw[3]);
		PlayerTextDrawHide(playerid, PlaDressDraw[1]);
	}
	format(string,sizeof(string), "[%d/100]", sel+1);
	PlayerTextDrawSetString(playerid, PlaDressDraw[2], string);
	PlayerTextDrawShow(playerid, PlaDressDraw[2]);
	return 1;
}
stock left_akses(playerid)
{
	PlayerPlaySound(playerid,17803,0,0,0);
	new select = GetPVarInt(playerid, "SelectCharPlace");
	if(select >= 1) select --;
	else select = 99;
	SetPVarInt(playerid, "SelectCharPlace", select);
	show_akses(playerid, select);
	return 1;
}
stock right_akses(playerid)
{
	PlayerPlaySound(playerid,17803,0,0,0);
	new select = GetPVarInt(playerid, "SelectCharPlace");
	if(select < 99) select ++;
	else select = 0;
	SetPVarInt(playerid, "SelectCharPlace", select);
	show_akses(playerid, select);
	return 1;
}
stock GoAkses(playerid)
{
	S_SetPlayerVirtualWorld(playerid, playerid+1, 0);
 	PPSetPlayerInterior(playerid, 0);
	PPSetPlayerPos(playerid, 1536.977905, -1452.003784, 45.906265), PPSetPlayerFacingAngle(playerid, 205.815200);
 	TogglePlayerControllable(playerid, false);
	InterpolateCameraPos(playerid, 1540.998779, -1459.510864, 46.879333, 1538.850585, -1455.088989, 46.521511, 1000);
	InterpolateCameraLookAt(playerid, 1538.275634, -1455.370727, 46.213356, 1536.296020, -1450.861206, 45.747303, 1000);
	SelectColorDraw(playerid);
	SetPVarInt(playerid, "SelectCharPlace", 0);

	TextDrawShowForPlayer(playerid, DressDraw[0]), TextDrawShowForPlayer(playerid, DressDraw[1]), TextDrawShowForPlayer(playerid, DressDraw[2]);
	TextDrawShowForPlayer(playerid, DressDraw[3]), TextDrawShowForPlayer(playerid, DressDraw[4]);
	TextDrawShowForPlayer(playerid, DressDraw[5]), TextDrawShowForPlayer(playerid, DressDraw[6]);
	TextDrawShowForPlayer(playerid, DressDraw[7]), TextDrawShowForPlayer(playerid, DressDraw[8]), TextDrawShowForPlayer(playerid, DressDraw[9]);
	TextDrawShowForPlayer(playerid, DressDraw[14]), TextDrawShowForPlayer(playerid, DressDraw[15]);
	show_akses(playerid, 0);

	//if(PlayerInfo[playerid][pQwest] < 21) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Подсказка: Используйте команду /headmove, чтобы отключить поворот головы","*","");
	return 1;
}
stock buy_akses(playerid)
{
	new sel = GetPVarInt(playerid, "SelectCharPlace"), aksessu, price, b = Bid[playerid]-173;
 	aksessu = AksesItem[b][sel], price = AksesPrice[b][sel];
 	if(aksessu == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ой.. что-то не так [В этом слоте нет аксессуара]"), PlayerPlaySound(playerid,4203,0,0,0);
 	if(CheckInvent(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В моём инвентаре нет места"), PlayerPlaySound(playerid,4203,0,0,0);
	if(oGetPlayerMoney(playerid) < price) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает денег"), PlayerPlaySound(playerid,4203,0,0,0);

	new string[120];
 	format(string, sizeof(string), "{cccccc}Вы уверены, что хотите {ff9000}купить {cccccc}этот аксессуар за {99ff66}%d$ {cccccc}?",price);
	ShowDialog(playerid,1082,DIALOG_STYLE_MSGBOX,"{ff9000}Магазин Одежды",string,"Да","Нет");
 	return 1;
}
stock show_skin(playerid, g, sel, action)
{
	HidePlayerDialog(playerid);

	new skin, price, srank, string[20];
	if(g >= 1 && g <= 22) // Организация
	{
		skin = OrganInfo[g][gSkin][sel];
		price = OrganInfo[g][gSkinPrice][sel];
		srank = OrganInfo[g][gSkinRank][sel];
	}
	else if(g == 100) // Магазин Одежды
	{
		skin = StoreItem[Bid[playerid]-173][sel], price = StorePrice[Bid[playerid]-173][sel];
		format(string,sizeof(string), "CIVIL [%d/50]", sel+1);
		PlayerTextDrawSetString(playerid, PlaDressDraw[1], string);
		PlayerTextDrawShow(playerid, PlaDressDraw[1]);
	}
	else if(g == 200) // Регистрация
	{
		if(PlayerInfo[playerid][pSex] <= 1) skin = RegMaleSkin[sel];
		else skin = RegFemaleSkin[sel];
	}
	else if(g == 400) // Gold Магазин
	{
		skin = GetPVarInt(playerid, "SkinLave");
		if(action == 0) skin = FindNextGoldSkin(skin);
		else skin = FindPreviousGoldSkin(skin);
	}

	if(g <= 100 || g == 400) // Магазины одежды + Gold меню
	{
		if(g <= 22)
		{
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string,sizeof(string), "PAH‚:_%d", srank);
			else format(string,sizeof(string), "RANK:_%d", srank);
			PlayerTextDrawSetString(playerid, PlaDressDraw[2], string), PlayerTextDrawShow(playerid, PlaDressDraw[2]);
		}

		if(skin == 0)
		{
			PlayerTextDrawColour(playerid, PlaDressDraw[0], -1523963137), PlayerTextDrawSetString(playerid, PlaDressDraw[0], "NONE"), PlayerTextDrawShow(playerid, PlaDressDraw[0]);
			PlayerTextDrawHide(playerid, PlaDressDraw[3]);
			if(g == 100 || g == 400) PlayerTextDrawHide(playerid, PlaDressDraw[4]);
		}
		else
		{
			PlayerTextDrawColour(playerid, PlaDressDraw[0], 13172735), format(string,sizeof(string), "ID:_%d", skin), PlayerTextDrawSetString(playerid, PlaDressDraw[0], string), PlayerTextDrawShow(playerid, PlaDressDraw[0]);
			
			if(g == 400) // Gold Shop
			{
				PlayerTextDrawColour(playerid, PlaDressDraw[3], -4456193);
				format(string,sizeof(string), "%dG", SkinGold[skin]);
				PlayerTextDrawSetString(playerid, PlaDressDraw[3], string);
				PlayerTextDrawShow(playerid, PlaDressDraw[3]);
			}
			else if(g == 100 || g >= 1 && g <= 22) // Магаз одежды и скины организации
			{
				PlayerTextDrawColour(playerid, PlaDressDraw[3], 1238057215);
				format(string,sizeof(string), "%d$", price);
				PlayerTextDrawSetString(playerid, PlaDressDraw[3], string);
				PlayerTextDrawShow(playerid, PlaDressDraw[3]);
				if(SkinGold[skin] > 0)
				{
					format(string,sizeof(string), "%dG", SkinGold[skin]);
					PlayerTextDrawSetString(playerid, PlaDressDraw[4], string);
					PlayerTextDrawShow(playerid, PlaDressDraw[4]);
				}
				else PlayerTextDrawHide(playerid, PlaDressDraw[4]);
			}
		}
	}
	SetPVarInt(playerid, "SelectCharPlace", sel);
	SetPVarInt(playerid, "SkinLave", skin);

	if(skin == 0) DestroyClothesActor(playerid);
	else CreateClothesActor(playerid, skin);
	return 1;
}
stock buy_skin(playerid)
{
	if(PlayerInfo[playerid][pTut] == 0 && gZaregal[playerid] == 1) // Завершение регистрации
 	{
		gZaregal[playerid] = 2;
 		new quan_player = GetThisPlayer(playerid);
		if(quan_player >= 1)
		{
			TextDrawShowForPlayer(playerid, Chernifon);
			if(Fractia[playerid] > 0) CloseShmot(playerid);
			ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Игрок с таким именем уже авторизовался\
																	\n{cccccc}Чтобы выйти из игры введите в чат команду {FF6347}/q или ESC >> Выход","Ок","");
			Kickx(playerid);
			return 1;
		}
		else
		{
			if(AeroTimer[playerid] > 0)
			{
				TextDrawShowForPlayer(playerid, Chernifon);
				if(Fractia[playerid] > 0) CloseShmot(playerid);
				ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Ошибка! Таймер путешествия уже был запущен\
																		\n{cccccc}Чтобы выйти из игры введите в чат команду {FF6347}/q или ESC >> Выход","Ок","");
				Kickx(playerid);
				return 1;
			}

			// Запускаем путешествие игрока перед регистрацией
			Aero(playerid);
		}
	}
	else if(OnlineInfo[playerid][oLogged] == 1 && PlayerInfo[playerid][pTut] >= 1)
 	{
 		new g = Fractia[playerid], sel = GetPVarInt(playerid, "SelectCharPlace"), skin, price, srank, b = Bid[playerid]-173;
	 	if(g >= 1 && g <= 22) skin = OrganInfo[g][gSkin][sel], price = OrganInfo[g][gSkinPrice][sel], srank = OrganInfo[g][gSkinRank][sel];
	 	else if(g == 100) skin = StoreItem[b][sel], price = StorePrice[b][sel];
		else if(g == 400) skin = GetPVarInt(playerid, "SkinLave");
		new gold = SkinGold[skin];

	 	if(skin == 0) return ErrorMessage(playerid, "{FF6347}Ошибка! В этом слоте нет одежды");
	 	if(GetSkinSex(skin) == 2 && PlayerInfo[playerid][pSex] == 1) return ErrorMessage(playerid, "{FF6347}Вы не можете носить женскую одежду [ Пол можно сменить в вашем паспорте: Правительство ]");
		else if(GetSkinSex(skin) == 1 && PlayerInfo[playerid][pSex] == 2) return ErrorMessage(playerid, "{FF6347}Вы не можете носить мужскую одежду [ Пол можно сменить в вашем паспорте: Правительство ]");
 	    
		new string[130];
		if(g >= 1 && g <= 22)
 	    {
 	        if(PlayerInfo[playerid][pRank] < srank) return format(string, sizeof(string),"{FF6347}Эта одежда доступна с %d ранга", srank), ErrorMessage(playerid, string);
			DP[0][playerid] = 0;
			if(price == 0) format(string, sizeof(string), "{cccccc}Вы уверены, что хотите {ff9000}взять {cccccc}эту одежду?");
 	        else format(string, sizeof(string), "{cccccc}Вы уверены, что хотите {ff9000}купить {cccccc}эту одежду за {99ff66}%d$ {cccccc}?",price);
			ShowDialog(playerid,1078,DIALOG_STYLE_MSGBOX,"{ff9000}Одежда",string,"Да","Нет");
 	    }
 	    else if(g == 100)
 	    {
			new line[140],lines[420];
			format(line,sizeof(line),"{ff9000}Как хотите оплатить покупку?\t"), strcat(lines,line);
			format(line,sizeof(line),"\n{99ff66}Деньги\t{99ff66}%d$ {cccccc}[%s]", price, get_k(price)), strcat(lines,line);
			if(gold > 0) format(line,sizeof(line),"\n{ffcc00}Золото\t{ffcc00}%dG", gold), strcat(lines,line);
			else format(line,sizeof(line),"\n{ffcc00}Золото\t{cccccc}No gold"), strcat(lines,line);
			ShowDialog(playerid,1063,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}*",lines,"Выбрать","Выход");
 	    }
		else if(g == 400)
		{
			if(gold <= 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Скин не продаётся");
			DP[0][playerid] = 1;
 	        format(string, sizeof(string), "{cccccc}Вы уверены, что хотите {ff9000}купить {cccccc}эту одежду за {ffcc00}%dG {cccccc}?",gold);
			ShowDialog(playerid,1078,DIALOG_STYLE_MSGBOX,"{ff9000}Одежда",string,"Да","Нет");
		}
 	}
 	return 1;
}
stock shmot(playerid)
{
    new g = fraction(playerid), frak;
	if(IsPlayerInRangeOfPoint(playerid,1.0,2607.8682,918.0507,1551.0000) && GetPlayerInterior(playerid) == 249)
	{
		if(GetPlayerVirtualWorld(playerid) == 1) frak = 1; // LSPD
		if(GetPlayerVirtualWorld(playerid) == 2) frak = 2; // FBI
		if(GetPlayerVirtualWorld(playerid) == 3) frak = 3; // NGSA
		if(GetPlayerVirtualWorld(playerid) == 11) frak = 11; // SFPD
		if(GetPlayerVirtualWorld(playerid) == 22) frak = 22; // SWAT
		if(GetPlayerVirtualWorld(playerid) == 33) frak = 3; // ВМС
		else frak = g;
	}
	else if(IsPlayerInRangeOfPoint(playerid,1.0,2496.0188,-1695.8295,2073.9805) && GetPlayerVirtualWorld(playerid) == 212 && GetPlayerInterior(playerid) == 212) frak = 13; // Grove
	else if(IsPlayerInRangeOfPoint(playerid,1.0,2488.1748,-2021.3531,2052.2808) && GetPlayerVirtualWorld(playerid) == 213 && GetPlayerInterior(playerid) == 213) frak = 14; // Ballas
	else if(IsPlayerInRangeOfPoint(playerid,1.0,2261.6941,-1459.2672,2089.4438) && GetPlayerVirtualWorld(playerid) == 214 && GetPlayerInterior(playerid) == 214) frak = 15; // Vagos
	else if(IsPlayerInRangeOfPoint(playerid,1.0,1684.0817,-2098.6365,2091.8000) && GetPlayerVirtualWorld(playerid) == 215 && GetPlayerInterior(playerid) == 215) frak = 16; // Aztecas
	else if(IsPlayerInRangeOfPoint(playerid,1.0,1383.1306,-1.3530,1000.9217) && GetPlayerVirtualWorld(playerid) == 9 && GetPlayerInterior(playerid) == 5) frak = 4; // Госпиталь
 	else if(IsPlayerInRangeOfPoint(playerid,1.0,-1507.6846,1957.5139,1357.0326) && GetPlayerVirtualWorld(playerid) == 5 && GetPlayerInterior(playerid) == 1) frak = 5; // Cosa Nostra
	else if(IsPlayerInRangeOfPoint(playerid,1.0,910.1101,1391.0000,1029.3732) 
		&& GetPlayerVirtualWorld(playerid) == WORLD_YAKUZA_1LVL && GetPlayerInterior(playerid) == INT_YAKUZA_1LVL) frak = 6; // Yakuza Mafia
	else if(IsPlayerInRangeOfPoint(playerid,1.0,-2008.8141,152.5642,1666.0313) && GetPlayerInterior(playerid) == 7 && GetPlayerVirtualWorld(playerid) == 7) frak = 7; // Правительство
	else if(IsPlayerInRangeOfPoint(playerid,1.0,-506.7065,-87.0514,964.8114) && GetPlayerVirtualWorld(playerid) == 8 && GetPlayerInterior(playerid) == 8) frak = 8; // Hitman Agency
	else if(IsPlayerInRangeOfPoint(playerid,1.0,1416.2957,-1212.1395,124.0505)
		&& GetPlayerVirtualWorld(playerid) == WORLD_CNN_2LVL && GetPlayerInterior(playerid) == INT_CNN_2LVL) frak = 9; // CNN
	else if(IsPlayerInRangeOfPoint(playerid,1.0,-1997.9194,1110.0148,1018.6735) && GetPlayerVirtualWorld(playerid) == 12 && GetPlayerInterior(playerid) == 1) frak = 12; // Russian Mafia
	else if(IsPlayerInRangeOfPoint(playerid,1.0,-1928.6663,906.0461,1402.0776) && GetPlayerVirtualWorld(playerid) == 10 && GetPlayerInterior(playerid) == 10) frak = 10; // Triada Mafia
	else if(IsPlayerInRangeOfPoint(playerid,1.0,919.1400,1378.4596,1029.4221) 
		&& GetPlayerVirtualWorld(playerid) == WORLD_ARABIAN_M1LVL && GetPlayerInterior(playerid) == INT_ARABIAN_M1LVL) frak = 18; // Arabian Mafia
	else if(IsAClothesNearby(playerid)) // Магаз одежды
	{
		frak = 100;
		Bid[playerid] = GetPlayerVirtualWorld(playerid);
	}
	else if(IsAGoldClothesNearby(playerid)) // Магаз gold одежды
	{
		frak = 400;
		Bid[playerid] = GetPlayerVirtualWorld(playerid);
	}
	if(frak == 0) return 0;

	if(frak >= 1 && frak <= 22 && g != frak) return ErrorMessage(playerid, "{FF6347}Эта раздевалка не вашей организации");
	if(gSkafandr[playerid] > 0 || gFormavvs[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Вы используете форму");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	DP[0][playerid] = frak;
	ShowDialog(playerid,1031,DIALOG_STYLE_MSGBOX,"{ff9000}Одежда","{cccccc}Вы уверены, что хотите {ff9000}выбрать одежду?","Да","Нет");
	return 1;
}

CMD:rskin(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Сбросить скины и их стоимости [ /rskin ID Фракции ][ 0: Все Организации ]");
	if(params[0] < 0 || params[0] > 22) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Номер организации не меньше 1 и не больше 22 [ 0: Все Организации ]");
	new string[128];
	if(params[0] == 0)
	{
		for(new org = 1; org < 34; org++) ReloadSkin(playerid, org);
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил скины всех организаций",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("rskin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Все организации");
	}
	else
	{
		ReloadSkin(playerid, params[0]);
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил скины %s",PlayerInfo[playerid][pName],frakName[params[0]]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("rskin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "");
	}
	return 1;
}
stock Times(playerid)
{
	new mtext[20];
	new year, month,day, unix = gettime();
	getdate(year, month, day);
	if(month == 1) mtext = "Январь";
	else if(month == 2) mtext = "Февраль";
	else if(month == 3) mtext = "Март";
	else if(month == 4) mtext = "Апрель";
	else if(month == 5) mtext = "Май";
	else if(month == 6) mtext = "Июнь";
	else if(month == 7) mtext = "Июль";
	else if(month == 8) mtext = "Август";
	else if(month == 9) mtext = "Сентябрь";
	else if(month == 10) mtext = "Октябрь";
	else if(month == 11) mtext = "Ноябрь";
	else if(month == 12) mtext = "Декабрь";
    new hours, minuite, second;
	gettime(hours,minuite,second);
	FixHour(hours);
	hours = shifthour;
	if(GetPVarInt(playerid,"Timez") == 0)
	{
		if(NoAnim[playerid] == 0 && GetPlayerSpeed(playerid) <= 2) ApplyAnimation(playerid,"GHANDS","gsign5LH",4.1, false, false, false, false, false, SYNC_ALL);
		SetPlayerChatBubble(playerid,"смотрит на часы",COLOR_PURPLE,20.0,3000);
	}
	new str[100],sctring[1100];
	format(str,sizeof(str),"{cccccc}** Дата: {0088ff}%02d %s %d\n", day, mtext, year), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}** Время: {0088ff}%02d:%02d{cccccc}:%02d\n", hours, minuite, second), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}** PayDay через: %d мин.\n", 60-PlayerInfo[playerid][pPayDay]), strcat(sctring,str);
	if(GetPVarInt(playerid,"RollTime") > 0)
	{
		if(GetPVarInt(playerid,"RollTime") >= 60) format(str,sizeof(str),"{cccccc}** Прокат коньков:  {ffffff}%d мин.\n", GetPVarInt(playerid,"RollTime")/60);
		else format(str,sizeof(str),"{cccccc}** Прокат коньков:  {ffffff}%d сек.\n", GetPVarInt(playerid,"RollTime"));
		strcat(sctring,str);
	}
	if (PlayerInfo[playerid][pJailTime] > 0)
	{
		if (PlayerInfo[playerid][pJailTime] >= 60) format(str,sizeof(str),"\n{cccccc}** Время заключения:  {FF6347}%d мин.\n", PlayerInfo[playerid][pJailTime]/60);
		else format(str,sizeof(str),"\n{cccccc}** Время заключения:  {FF6347}%d сек.\n", PlayerInfo[playerid][pJailTime]);
		strcat(sctring,str);
 	}
	if(PlayerInfo[playerid][pMuteTime] >= 1)
	{
		if(PlayerInfo[playerid][pMuteTime] >= 60) format(str,sizeof(str),"{cccccc}** Молчанка:  {FF6347}%d мин.\n", PlayerInfo[playerid][pMuteTime]/60);
		else format(str,sizeof(str),"{cccccc}** Молчанка:  {FF6347}%d сек.\n", PlayerInfo[playerid][pMuteTime]);
		strcat(sctring,str);
	}
	if(PlayerInfo[playerid][pFmuteTime] >= 1)
	{
		if(PlayerInfo[playerid][pFmuteTime] >= 60) format(str,sizeof(str),"{cccccc}** Молчанка Рации:  {FF6347}%d мин.\n", PlayerInfo[playerid][pFmuteTime]/60);
		else format(str,sizeof(str),"{cccccc}** Молчанка Рации:  {FF6347}%d сек.\n", PlayerInfo[playerid][pFmuteTime]);
		strcat(sctring,str);
	}
	format(str,sizeof(str),"\n"), strcat(sctring,str);
	if(PlayerInfo[playerid][pMaze] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pMaze]-unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Лабиринт: через {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}
	if(PlayerInfo[playerid][pMaze2] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pMaze2]-unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Гробница: через {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}
	if(PlayerInfo[playerid][pMaze3] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pMaze3]-unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Сокровища: через {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}
	if(PlayerInfo[playerid][pStopoc] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pStopoc]-unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Образовательный центр: через {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}

	if(PlayerInfo[playerid][pRazok] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pRazok] - unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Спермобанк: через {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}

	if(PlayerInfo[playerid][pDominicUnix] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pDominicUnix] - unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Гонка с Домиником: через {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}

	if(PlayerInfo[playerid][pCDVillage] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pCDVillage] - unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Хранилище деревенских: {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}

	if(PlayerInfo[playerid][pCDKatana] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pCDKatana] - unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Дуэль против Годжо Сатору: {FF6347}%02d часов %02d минут\n", unhour, unminute);
		strcat(sctring,str);
	}

	if(Effect[playerid] == 5 && EffectTime[playerid] >= 1)
	{
	    format(str,sizeof(str),"{cccccc}** Опьянение: осталось %d сек\n", EffectTime[playerid]), strcat(sctring,str);
	}

	{
		new minewar_elapsed = MineWar_GetElapsedTime(playerid);
		if (minewar_elapsed > 0) {
			new undays, unhour, unminute, unsecond;
			getunix(minewar_elapsed, undays, unhour, unminute, unsecond);

			format(str, sizeof(str), "{cccccc}** Заброшенная шахта: через {FF6347}%02d часов %02d минут\n", unhour, unminute), strcat(sctring, str);
		}
	}

	{
		new tomb_elapsed = Tomb_GetElapsedTime(playerid);
		if (tomb_elapsed > 0) {
			new undays, unhour, unminute, unsecond;
			getunix(tomb_elapsed, undays, unhour, unminute, unsecond);

			format(str, sizeof(str), "{cccccc}** Гробница фараона: через {FF6347}%02d часов %02d минут\n", unhour, unminute), strcat(sctring, str);
		}
	}

	{
		new cooldown = Graves_GetPlayerCooldown(playerid);
		if (cooldown > 0)
		{
			new undays, unhour, unminute, unsecond;
			getunix(cooldown, undays, unhour, unminute, unsecond);

			format(str, sizeof(str), "{cccccc}** Раскопка могил: через {FF6347}%02d часа %02d минут %02d секунд\n", unhour, unminute, unsecond), strcat(sctring, str);
		}
	}


	if(PlayerInfo[playerid][pGymUnix] > unix)
	{
		new undays, unhour, unminute, unsecond;
		getunix(PlayerInfo[playerid][pGymUnix] - unix, undays, unhour, unminute, unsecond);
		format(str,sizeof(str),"{cccccc}** Абонемент в спортзал: осталось {0088ff}%02d дней %02d часов %02d минут\n", undays, unhour, unminute);
		strcat(sctring,str);
	}

	ShowDialog(playerid, 87, 0, "{ff9000}ЧАСЫ", sctring, "*", "");
	SetPVarInt(playerid,"Timez",1);
	return 1;
}
CMD:time(playerid)
{
   Times(playerid);
   return 1;
}
