				OOCOff(COLOR_LIGHTRED, string);

				// Ищем статю для зачистки
				new findUk, findP, bool:findCriminal;
				if (FindCriminalArticle("Зачистка", findUk, findP, .ignorecase = false)) findCriminal = true;

        		foreach(Player,i)
            	{
					if(OnlineInfo[i][oLogged] == 0) continue;

					// Всем участникам зачищаемой организации выдаём розыск
					if(findCriminal == true)
					{
						if(fraction(i) == org)
						{
							if(GetPlayerCriminalSlot(i, findUk, findP) == -1)
							{
								SetPlayerCriminal(i, -1, CriminalCodeInfo[findUk][findP][ccName], CriminalCodeInfo[findUk][findP][ccLevel], findUk, findP);
								CreatePlayerPursuit(i, playerid);
							}
						}
					}

					// Включаем всем игрокам оповещение звук зачистки
                    if(OnlineInfo[i][oListenRadioPears] == 0 && GetPVarInt(i,"afksystem") <= 3)
					{
                    	StopAudioStreamForPlayer(i);
                    	PlayAudioStreamForPlayer(i, "https://cdn.pears.fun/sound/sirena.mp3");
					}
				}
				Zach[org] = 1;
        		zachistka = 1;
        		pc_cmd_zachistka(playerid, "");
        	}
        	else if(Zach[org] == 1) // Завершаем Зачистку
        	{
				format(string, sizeof(string), "[DEP]: Руководитель %s %s[%d] завершает зачистку %s", orgName[fraction(playerid)], PlayerInfo[playerid][pName], playerid, orgName[org]);
				SendDepartMessage(COLOR_ALLDEPT, string);
				Zach[org] = 0;
        		zachistka = 0;
        		pc_cmd_zachistka(playerid, "");
			}
        }
		return 1;
	}
