				if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Предмета нельзя удалить, доставку выполняет NGSA"), InsertOrderEscort(playerid, g, ord);

				format(string, sizeof(string), "\n{cccccc}Вы уверены, что хотите удалить заказ предмета {FF6347}%s {cccccc}?\n",GetNameThing(0, OrganInfo[g][gOrder][ord], OrganInfo[g][gOrderType][ord], 0));
				new header[60];
