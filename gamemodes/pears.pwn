stock getIkeaObjectPrice(model) // Получаем гос. цену объекта мебели из IKEA
{
	new price;
	for(new i = 0; i < MAX_IKEA; i++)
	{
		if(IkeaInfo[i][iModel] == model && IkeaInfo[i][iSale] == 1 && IsValidDynamicObject(IkeaInfo[i][iObject]))
		{
			price = IkeaInfo[i][iPrice];
			break;
		}
	}
	return price;
}

stock getIkeaObjectStreet(model) // Получаем инфу, можно ли ставить объект на улице
{
	new result;
	for(new i = 0; i < MAX_IKEA; i++)
	{
		if(IkeaInfo[i][iModel] == model && IkeaInfo[i][iStreetObject] == 1)
		{
			result = 1;
			break;
		}
	}
	return result;
}

stock getIkeaObjectName(model) // Получаем имя объекта
{
	new ikeaName[34], yesFind;
	for(new i = 0; i < MAX_IKEA; i++)
	{
		if(IkeaInfo[i][iModel] == model)
		{
			format(ikeaName,sizeof(ikeaName),"%s", IkeaInfo[i][iName]);
			yesFind = 1;
			break;
		}
	}
	if(yesFind == 0) format(ikeaName,sizeof(ikeaName),"%s", object_name(model));
	return ikeaName;
}

stock getFrameObjectPrice(model) // Получаем гос. цену объекта планировки из списка Планировок
{
	new price = 50000; // Если планировки нет в списке планировок или он не доступен в продаже, это дефолтная гос. цена
	for(new i = 0; i < MAX_FRAME; i++)
	{
		if(FrameInfo[i][frModel] == model && FrameInfo[i][frSale] == 1)
		{
			price = FrameInfo[i][frPrice];
			break;
		}
	}
	return price;
}
