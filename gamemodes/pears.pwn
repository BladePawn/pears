stock update_draw(playerid, drawid)
{
    PlayerInfo[playerid][pDrawUpdate][drawid] = false;
    new f_str[288];
	if(drawid == 2 || drawid == 3 || drawid == 9 || drawid == 10) // Изменение видимости
	{
	    mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `draw_x%d`='%f',`draw_y%d`='%f',`draw_sx%d`='%f',`draw_sy%d`='%f',`draw_vis%d`='%d' WHERE `user_id`='%d'",
		drawid,PlayerInfo[playerid][pDrawPos_X][drawid], drawid,PlayerInfo[playerid][pDrawPos_Y][drawid], drawid,PlayerInfo[playerid][pDrawSize_X][drawid], drawid,PlayerInfo[playerid][pDrawSize_Y][drawid],
		drawid,PlayerInfo[playerid][pDrawVisible][drawid], PlayerInfo[playerid][pID]);
	}
	else if(drawid == 7) // Спидометр
	{
	    mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `draw_x%d`='%f',`draw_y%d`='%f',`draw_sx%d`='%f',`draw_sy%d`='%f',`draw_vis%d`='%d',`typespeed`='%d' WHERE `user_id`='%d'",
		drawid,PlayerInfo[playerid][pDrawPos_X][drawid], drawid,PlayerInfo[playerid][pDrawPos_Y][drawid], drawid,PlayerInfo[playerid][pDrawSize_X][drawid], drawid,PlayerInfo[playerid][pDrawSize_Y][drawid],
		drawid,PlayerInfo[playerid][pDrawVisible][drawid],PlayerInfo[playerid][pTypeSpeed], PlayerInfo[playerid][pID]);
	}
	else if(drawid == 13) // Админский Spec
	{
	    mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `draw_x%d`='%f',`draw_y%d`='%f',`draw_sx%d`='%f',`draw_sy%d`='%f',`aspblock1`='%d',`aspblock2`='%d',`aspblock3`='%d',`asptext`='%d',`aspcol`='%d' WHERE `user_id`='%d'",
		drawid,PlayerInfo[playerid][pDrawPos_X][drawid], drawid,PlayerInfo[playerid][pDrawPos_Y][drawid], drawid,PlayerInfo[playerid][pDrawSize_X][drawid], drawid,PlayerInfo[playerid][pDrawSize_Y][drawid],
		PlayerInfo[playerid][pAspecBlock1],PlayerInfo[playerid][pAspecBlock2],PlayerInfo[playerid][pAspecBlock3],PlayerInfo[playerid][pAspecText],PlayerInfo[playerid][pAspecCol], PlayerInfo[playerid][pID]);
	}
	else
	{
		mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `draw_x%d`='%f',`draw_y%d`='%f',`draw_sx%d`='%f',`draw_sy%d`='%f' WHERE `user_id`='%d'",
		drawid,PlayerInfo[playerid][pDrawPos_X][drawid], drawid,PlayerInfo[playerid][pDrawPos_Y][drawid], drawid,PlayerInfo[playerid][pDrawSize_X][drawid], drawid,PlayerInfo[playerid][pDrawSize_Y][drawid],
		PlayerInfo[playerid][pID]);
	}
  	query_empty(pearsq, f_str);
	return 1;
}

stock RusToGame(const string[])
{
    new result[180];
    for(new i; i < 180 && string[i]; i++)
    {
     switch(string[i])
     {
      case 'а':result[i] = 'a';
      case 'А':result[i] = 'A';
      case 'б':result[i] = '—';
      case 'Б':result[i] = 'Ђ';
      case 'в':result[i] = 'ў';
      case 'В':result[i] = '‹';
      case 'г':result[i] = '™';
      case 'Г':result[i] = '‚';
      case 'д':result[i] = 'љ';
      case 'Д':result[i] = 'ѓ';
      case 'е':result[i] = 'e';
      case 'Е':result[i] = 'E';
      case 'ё':result[i] = 'e';
      case 'Ё':result[i] = 'E';
      case 'ж':result[i] = '›';
      case 'Ж':result[i] = '„';
      case 'з':result[i] = 'џ';
      case 'З':result[i] = '€';
      case 'и':result[i] = 'њ';
      case 'И':result[i] = '…';
      case 'й':result[i] = 'ќ';
      case 'Й':result[i] = '…';
      case 'к':result[i] = 'k';
      case 'К':result[i] = 'K';
      case 'л':result[i] = 'ћ';
      case 'Л':result[i] = '‡';
      case 'м':result[i] = 'Ї';
      case 'М':result[i] = 'M';
      case 'н':result[i] = '®';
      case 'Н':result[i] = 'H';
      case 'о':result[i] = 'o';
      case 'О':result[i] = 'O';
      case 'п':result[i] = 'Ј';
      case 'П':result[i] = 'Њ';
      case 'р':result[i] = 'p';
      case 'Р':result[i] = 'P';
      case 'с':result[i] = 'c';
      case 'С':result[i] = 'C';
      case 'т':result[i] = '¦';
      case 'Т':result[i] = 'Џ';
      case 'у':result[i] = 'y';
      case 'У':result[i] = 'Y';
      case 'ф':result[i] = '?';
      case 'Ф':result[i] = 'Ѓ';
      case 'х':result[i] = 'x';
      case 'Х':result[i] = 'X';
      case 'ц':result[i] = '$';
      case 'Ц':result[i] = '‰';
      case 'ч':result[i] = '¤';
      case 'Ч':result[i] = 'Ќ';
      case 'ш':result[i] = 'Ґ';
      case 'Ш':result[i] = 'Ћ';
      case 'щ':result[i] = 'Ў';
      case 'Щ':result[i] = 'Љ';
      case 'ь':result[i] = '©';
      case 'Ь':result[i] = '’';
      case 'ъ':result[i] = 'ђ';
      case 'Ъ':result[i] = '§';
      case 'ы':result[i] = 'Ё';
      case 'Ы':result[i] = '‘';
      case 'э':result[i] = 'Є';
      case 'Э':result[i] = '“';
      case 'ю':result[i] = '«';
      case 'Ю':result[i] = '”';
      case 'я':result[i] = '¬';
      case 'Я':result[i] = '•';
      default:result[i]=string[i];
     }
    }
    return result;
}

stock BigToSmall(const string[], out[], const out_size = sizeof(out))
{
	if (out_size == 0) return 0;

	new i = 0;
	while(string[i] != '\0' && i < (out_size - 1))
	{
		switch(string[i])
		{
			case 'А': out[i] = 'а';
			case 'Б': out[i] = 'б';
			case 'В': out[i] = 'в';
			case 'Г': out[i] = 'г';
			case 'Д': out[i] = 'д';
			case 'Е': out[i] = 'е';
			case 'Ё': out[i] = 'ё';
			case 'Ж': out[i] = 'ж';
			case 'З': out[i] = 'з';
			case 'И': out[i] = 'и';
			case 'Й': out[i] = 'й';
			case 'К': out[i] = 'к';
			case 'Л': out[i] = 'л';
			case 'М': out[i] = 'м';
			case 'Н': out[i] = 'н';
			case 'О': out[i] = 'о';
			case 'П': out[i] = 'п';
			case 'Р': out[i] = 'р';
			case 'С': out[i] = 'с';
			case 'Т': out[i] = 'т';
			case 'У': out[i] = 'у';
			case 'Ф': out[i] = 'ф';
			case 'Х': out[i] = 'х';
			case 'Ц': out[i] = 'ц';
			case 'Ч': out[i] = 'ч';
			case 'Ш': out[i] = 'ш';
			case 'Щ': out[i] = 'щ';
			case 'Ъ': out[i] = 'ъ';
			case 'Ы': out[i] = 'ы';
			case 'Ь': out[i] = 'ь';
			case 'Э': out[i] = 'э';
			case 'Ю': out[i] = 'ю';
			case 'Я': out[i] = 'я';

			case 'A': out[i] = 'a';
			case 'B': out[i] = 'b';
			case 'C': out[i] = 'c';
			case 'D': out[i] = 'd';
			case 'E': out[i] = 'e';
			case 'F': out[i] = 'f';
			case 'G': out[i] = 'g';
			case 'H': out[i] = 'h';
			case 'I': out[i] = 'i';
			case 'J': out[i] = 'j';
			case 'K': out[i] = 'k';
			case 'L': out[i] = 'l';
			case 'M': out[i] = 'm';
			case 'N': out[i] = 'n';
			case 'O': out[i] = 'o';
			case 'P': out[i] = 'p';
			case 'Q': out[i] = 'q';
			case 'R': out[i] = 'r';
			case 'S': out[i] = 's';
			case 'T': out[i] = 't';
			case 'U': out[i] = 'u';
			case 'V': out[i] = 'v';
			case 'W': out[i] = 'w';
			case 'X': out[i] = 'x';
			case 'Y': out[i] = 'y';
			case 'Z': out[i] = 'z';

			default:  out[i] = string[i];
		}
		i++;
	}
	out[i] = '\0';
	return i;
}

