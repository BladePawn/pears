	else if(DP[0][playerid] == 5) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Смартфон",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 6) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Инвентарь",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 7) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Спидометр",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 8) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Меню покупок",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 9) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Подсказка двигателя",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 10) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Датчик скафандра",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 11) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Уведомления",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 12) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Взлом замков",sctring,"Выбор","Отмена");
	else if(DP[0][playerid] == 13) ShowDialog(playerid,1242,DIALOG_STYLE_TABLIST,"{ff9000}Админский spec",sctring,"Выбор","Отмена");
	return 1;
}
stock show_quest_exam(playerid)
{
    PlayerPlaySound(playerid,40405,0,0,0);
   	new str[84],sctring[256];
   	if(Lesson[playerid] == 7)
	{
		format(str,sizeof(str),"{ff9000}%s", Exam_Diplom[LessonQuest[playerid]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}%s", Exam_Diplom_1[LessonQuest[playerid]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}%s", Exam_Diplom_2[LessonQuest[playerid]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}%s", Exam_Diplom_3[LessonQuest[playerid]]), strcat(sctring,str);
	}
   	else
  	{
		format(str,sizeof(str),"{ff9000}%s", Exam_Prava[LessonQuest[playerid]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}%s", Exam_Prava_1[LessonQuest[playerid]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}%s", Exam_Prava_2[LessonQuest[playerid]]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}%s", Exam_Prava_3[LessonQuest[playerid]]), strcat(sctring,str);
		if(LessonQuest[playerid] >= 3 && LessonQuest[playerid] <= 9)
		{
			if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]);
            AeroStat[playerid] = 1;
			AeroObj[playerid] = CreatePlayerObject(playerid, Exam_Prava_Znak[LessonQuest[playerid]], 1508.214233, -1778.017822, 19.400173, 0.000000, 0.000000, 90.000000, 300.0);
			SetPlayerObjectMaterial(playerid, AeroObj[playerid], 1, 19962, "samproadsigns", "materialtext1", 0x00000000);
		}
	}
	ShowDialog(playerid,1228,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Экзамен",sctring,"Выбрать","Выход");
	return 1;
}
function Call_takefrisk(playerid, const tmp[], inva)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid = DP[0][playerid];
	    new fpick, fquan, fpara, fqara, thingType, thingPack, onl, str[24];
	    cache_get_value_name_int(0, "Online", onl);
	    if(onl != 0) return ErrorMessage(playerid, "{FF6347}Игрок зашёл в игру [ Во избежание ошибок, обыщите его повторно ]");

	    if(DP[1][playerid] == 1 || DP[1][playerid] == 2 || DP[1][playerid] == 3) // Инвентарь, Товары, Оружие
	    {
			new i = DP[3][playerid]; // Слот
			new bool:is_null, string_json[30];
			if(DP[1][playerid] == 1) // Инвентарь
	    	{
				format(string_json, sizeof(string_json), "i_slot_%d", i);
				cache_is_value_name_null(0, string_json, is_null);
			}
			else if(DP[1][playerid] == 2) // Товары
	    	{
				format(string_json, sizeof(string_json), "m_slot_%d", i);
				cache_is_value_name_null(0, string_json, is_null);
			}
			else if(DP[1][playerid] == 3) // Оружие
	    	{
				format(string_json, sizeof(string_json), "gun_%d", i);
				cache_is_value_name_null(0, string_json, is_null);
			}

			if(is_null == true) return ErrorMessage(playerid, "{FF6347}Ошибка! Кто-то уже забрал этот предмет");

			fpick = List[i][playerid];
	        fquan = ListQuan[i][playerid];
	        fpara = ListPara[i][playerid];
	        fqara = ListQara[i][playerid];
	        thingType = ListType[i][playerid];
	        thingPack = ListPack[i][playerid];
	    }

	    else if(DP[1][playerid] == 4) // Надетые Аксессуары
	    {
	        format(str,sizeof(str),"Odet%d", inva), cache_get_value_name_int(0, str, fpick);
	        fquan = 1;
	        format(str,sizeof(str),"OdetPara%d", inva), cache_get_value_name_int(0, str, fpara);
	        format(str,sizeof(str),"OdetQara%d", inva), cache_get_value_name_int(0, str, fqara);
	        thingType = 2;
	        thingPack = 0;
	    }
	    
	    if(List[DP[3][playerid]][playerid] != fpick || fquan == 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Предмет уже был изъят или перемещён [ Обыщите игрока повторно ]");
		if(ListUnlegal[DP[3][playerid]][playerid] == 2)
		{
		    new put_inva = GiveThingPlayer(playerid, fpick, fquan, fpara, fqara, thingType, thingPack, 9999); // Выдаём предмет игроку
    		if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет
		}
		PlayerPlaySound(playerid,5600,0,0,0);

		new string_mysql[300];
		if(DP[1][playerid] == 1) SaveInventByUserID(datadid, inva, JSON_INVALID_NODE);
		else if(DP[1][playerid] == 2) SaveInventByUserID(datadid, inva, JSON_INVALID_NODE, true);
		else if(DP[1][playerid] == 3) SaveOneGunByUserID(datadid, inva, JSON_INVALID_NODE);
		else if(DP[1][playerid] == 4) 
		{
			mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_igroki` SET `Odet%d`='0',`OdetPara%d`='0',`OdetQara%d`='0' WHERE `user_id`='%d'", 
				inva, inva, inva, datadid);
			query_empty(pearsq, string_mysql);
		}
		
		new string[140];
		if(ListUnlegal[DP[3][playerid]][playerid] == 2) format(string, sizeof(string), "**** Вы конфисковали %s у %s [ Предмет находится в вашем инвентаре ]", GetNameThing(1, fpick, thingType, thingPack), tmp);
		else format(string, sizeof(string), "**** Вы конфисковали %s у %s [ Предмет уничтожен ]", GetNameThing(1, fpick, thingType, thingPack), tmp);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		
	  	if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("take", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, tmp, "", fquan, GetNameThing(1, fpick, thingType, thingPack));
	  	else OrgLog(fraction(playerid), "take", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, tmp, "", fquan, GetNameThing(1, fpick, thingType, thingPack));
	  	
	  	format(string, sizeof(string), "У вас изъят предмет [ %s в количестве: %d ]", GetNameThing(1, fpick, thingType, thingPack), fquan);
	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, tmp, string);

		OnPlayerFriskOffline(playerid);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
stock take_frisk(playerid, giveplayerid, inva)
{
    if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
    if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	new fpick, fquan, fpara, fqara, thingType, thingPack;
	if(DP[1][playerid] == 1) // Инвентарь
    {
        fpick = PlayerInfo[giveplayerid][pInven][inva];
        fquan = PlayerInfo[giveplayerid][pInvenQuan][inva];
        fpara = PlayerInfo[giveplayerid][pInvenPara][inva];
        fqara = PlayerInfo[giveplayerid][pInvenQara][inva];
        thingType = PlayerInfo[giveplayerid][pInvenType][inva];
        thingPack = PlayerInfo[giveplayerid][pInvenPack][inva];
    }
    else if(DP[1][playerid] == 2) // Товары
    {
        fpick = PlayerInfo[giveplayerid][pMarkInven][inva];
        fquan = PlayerInfo[giveplayerid][pMarkInvenQuan][inva];
        fpara = PlayerInfo[giveplayerid][pMarkInvenPara][inva];
        fqara = PlayerInfo[giveplayerid][pMarkInvenQara][inva];
        thingType = PlayerInfo[giveplayerid][pMarkInvenType][inva];
        thingPack = PlayerInfo[giveplayerid][pMarkInvenPack][inva];
    }
    else if(DP[1][playerid] == 3) // Оружие в Руках
    {
        if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[giveplayerid][pSoska] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя отнять оружие у администратора");
        if(PlayerInfo[giveplayerid][pBeret] == 0) // В руках
 		{
            fpick = ProtectInfo[giveplayerid][prWeapon][inva];
            fquan = ProtectInfo[giveplayerid][prAmmo][inva];
            fpara = ProtectInfo[giveplayerid][prDet][inva];
            fqara = ProtectInfo[giveplayerid][prQet][inva];
		}
		else
		{
            fpick = TempWeapon[giveplayerid][inva];
            fquan = TempAmmo[giveplayerid][inva];
            fpara = TempDet[giveplayerid][inva];
            fqara = TempQet[giveplayerid][inva];
		}
		thingType = 1;
		thingPack = 0;
    }
    else if(DP[1][playerid] == 4) // Надетые Аксессуары
    {
        fpick = PlayerInfo[giveplayerid][pOdet][inva];
        fquan = 1;
        fpara = PlayerInfo[giveplayerid][pOdetPara][inva];
        fqara = PlayerInfo[giveplayerid][pOdetQara][inva];
        thingType = 2;
        thingPack = 0;
    }
	else if(DP[1][playerid] == 5) // Рюкзак
    {
        fpick = BackPackInfo[giveplayerid][backpackInvent][inva];
        fquan = BackPackInfo[giveplayerid][backpackInv][inva];
        fpara = BackPackInfo[giveplayerid][backpackInvPara][inva];
        fqara = BackPackInfo[giveplayerid][backpackInvQara][inva];
        thingType = BackPackInfo[giveplayerid][backpackInvType][inva];
        thingPack = BackPackInfo[giveplayerid][backpackInvPack][inva];
    }
	if(DP[1][playerid] == 5) 
	{
		if(ListBackPackInva[DP[3][playerid]][playerid] != fpick || fquan == 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Предмет уже был изъят или перемещён [ Обыщите игрока повторно ]");
	}
	else 
	{
		if(List[DP[3][playerid]][playerid] != fpick || fquan == 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Предмет уже был изъят или перемещён [ Обыщите игрока повторно ]");
	}
	if(ListUnlegal[DP[3][playerid]][playerid] == 2)
	{
	    new put_inva = GiveThingPlayer(playerid, fpick, fquan, fpara, fqara, thingType, thingPack, 9999); // Выдаём предмет игроку
   		if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет
	}
	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
	PlayerPlaySound(playerid,5600,0,0,0), PlayerPlaySound(giveplayerid,5600,0,0,0);
	
	if(DP[1][playerid] == 1) i_del(giveplayerid, inva); // Инвентарь
	else if(DP[1][playerid] == 2) // Товары
	{
		ClearMyGoods(giveplayerid, inva);
		PlayerInfo[giveplayerid][pM_Update][inva] = true;
		if(OnlineInfo[giveplayerid][oShowInterface] == 1 && Tabs_Load[giveplayerid] == 6) item_second(giveplayerid, 0, 0, inva, 1, 0, 0, 0, 0);
		updategoods(giveplayerid, inva);
	}
	else if(DP[1][playerid] == 3) // Оружие в руках
	{
		if(PlayerInfo[giveplayerid][pBeret] == 0) Protect_Remove(giveplayerid, fpick);
		else
		{
  			TempWeapon[giveplayerid][inva] = 0;
			TempAmmo[giveplayerid][inva] = 0;
			TempDet[giveplayerid][inva] = 0;
			TempQet[giveplayerid][inva] = 0;
		}
	}
	else if(DP[1][playerid] == 4) // Аксессуары
	{
	    if(IsArmor(PlayerInfo[giveplayerid][pOdet][inva])) ACSetPlayerArmour(giveplayerid, 0);
	    
	    PlayerInfo[giveplayerid][pOdet][inva] = 0, PlayerInfo[giveplayerid][pOdetPara][inva] = 0, PlayerInfo[giveplayerid][pOdetQara][inva] = 0;
	    UpdateOdet(giveplayerid, inva);
	    if(OnlineInfo[giveplayerid][oShowInterface] == 1) i_akses(giveplayerid, inva);
	    
	    if(inva == 0) RemovePlayerAttachedObject(giveplayerid,5);
		else if(inva == 1) RemovePlayerAttachedObject(giveplayerid,6);
		else if(inva == 2) RemovePlayerAttachedObject(giveplayerid,7);
		else if(inva == 3) RemovePlayerAttachedObject(giveplayerid,8);
		else if(inva == 4) RemovePlayerAttachedObject(giveplayerid,9);
	}
	else if(DP[1][playerid] == 5) backpack_del(giveplayerid, inva); // Рюкзак
	
	new skladfbi;
	if((fpick == 4 || fpick == 5 || fpick == 6 || fpick == 7) && thingType == 0)
	{
	    if(PlayerInfo[playerid][pFbi] >= 1 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pLeader] == 2)
		{
	        skladfbi = 1;
	        if(fpick == 4) putsklad(2, 4, fquan, 0, thingType,1);
	        if(fpick == 5) putsklad(2, 5, fquan, 0, thingType,1);
	        if(fpick == 6) putsklad(2, 6, fquan, 0, thingType,1);
	        if(fpick == 7) putsklad(2, 7, fquan, 0, thingType,1);
		}
	}

	new string[160];
	if(skladfbi == 1) format(string, sizeof(string), "**** Вы конфисковали %s у %s [ Отправлено на склад FBI ]", GetNameThing(1, fpick, thingType, thingPack), playername(giveplayerid));
	else if(ListUnlegal[DP[3][playerid]][playerid] == 2) format(string, sizeof(string), "**** Вы конфисковали %s у %s [ Предмет находится в вашем инвентаре ]", GetNameThing(1, fpick, thingType, thingPack), playername(giveplayerid));
	else format(string, sizeof(string), "**** Вы конфисковали %s у %s [ Предмет уничтожен ]", GetNameThing(1, fpick, thingType, thingPack), playername(giveplayerid));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	
	if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "**** %s конфисковал у вас %s", PlayerInfo[playerid][pName], GetNameThing(1, fpick, thingType, thingPack));
	else format(string, sizeof(string), "**** %s конфисковала у вас %s", PlayerInfo[playerid][pName], GetNameThing(1, fpick, thingType, thingPack));
	SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
	
  	if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("take", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], fquan, GetNameThing(1, fpick, thingType, thingPack));
  	else OrgLog(fraction(playerid), "take", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], fquan, GetNameThing(1, fpick, thingType, thingPack));
  	player_frisk(playerid, DP[1][playerid]);
	return 1;
}
stock dice_player(playerid, stat)
{
	new string[194];
    format(string,sizeof(string),"\n{cccccc}Введите {ff9000}ID или никнейм игрока{cccccc}, с которым будете играть на {99ff66}%d$ (%s)\n{FF6347}%s", DicePrice[playerid], get_k(DicePrice[playerid]), reason_text(stat));
    ShowDialog(playerid,1208,DIALOG_STYLE_INPUT,"{ff9000}Игральные Кости",string,"Принять","Отмена");
    if(stat > 0) PlayerPlaySound(playerid,4203,0,0,0);
	return 1;
}
stock reason_text(id)
{
	new atext[36];
	if(id == 1) atext = "Этого игрока нет в сети";
    else if(id == 2) atext = "Вы далеко от игрока";
    else if(id == 3) atext = "Вы используете запрещенные символы";
	else atext = " ";
	return atext;
}
stock UpdateLabelTerm(b, br, i)
{
	new string[214];
 	if(b >= 42 && b <= 52) format(string,sizeof(string),"{ff9000}Аренда Автомобилей {444444}| Терминал № %d\n%s {cccccc}[№ %d]\n\n[ ALT ]",i+1,BizzInfo[b][bName],b);
    else if(b >= 62 && b <= 66) format(string,sizeof(string),"{ff9000}Аренда Мото {444444}| Терминал № %d\n%s {cccccc}[№ %d]\n\n[ ALT ]",i+1,BizzInfo[b][bName],b);
    else if(b >= 67 && b <= 76) format(string,sizeof(string),"{ff9000}Аренда Скутеров {444444}| Терминал № %d\n%s {cccccc}[№ %d]\n\n[ ALT ]",i+1,BizzInfo[b][bName],b);
	else if (b >= 143 && b <= 152) format(string,sizeof(string),"{ff9000}Электрозарядная станция № %d\n%s {cccccc}[№ %d]\n{ff9000}Зарядка {cccccc}1 кВт = {99ff66}%d$\n{cccccc}[ ALT ]",i+1,BizzInfo[b][bName],b, BizzInfo[b][bPrice][0]);
	else if (b >= 153 && b <= 162) format(string,sizeof(string),"{ff9000}Тележка с Хот Догами {444444}| Тележка № %d\n%s {cccccc}[№ %d]\n\n[ ALT ]",i+1,BizzInfo[b][bName],b);
	else if (b >= 163 && b <= 172) format(string,sizeof(string),"{ff9000}Банкомат № %d\n%s {cccccc}[№ %d]\nКомиссионных: {99ff66}%d$\n\n[ ALT ]",i+1,BizzInfo[b][bName],b,BizzInfo[b][bItem][i]);
	UpdateDynamic3DTextLabelText(RentLabel[br][i],0xA9C4E4FF,string);
	return 1;
}
