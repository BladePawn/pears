stock processbar2(playerid, stat) //+
{
	if(stat == 0) return PlayerTextDrawHide(playerid, InputDraw1), PlayerTextDrawSetString(playerid, InputDraw2, "0"), PlayerTextDrawShow(playerid, InputDraw2);
	new Float:defa = 265.125000; // Max = 368.250000
	new Float:plusik = stat*0.103125;
	if(stat <= 999) PlayerTextDrawTextSize(playerid, InputDraw1, defa+plusik, 0.0);
	else PlayerTextDrawTextSize(playerid, InputDraw1, 368.250000, 0.0);
	PlayerTextDrawShow(playerid, InputDraw1);
	new string[124];
	format(string,sizeof(string),"%d", stat), PlayerTextDrawSetString(playerid, InputDraw2, string), PlayerTextDrawShow(playerid, InputDraw2);
	return 1;
}
public SexTime(playerid)
{
	if(InputProcess[playerid] >= 5)
	{
		if(DistanceProcessSex(playerid)) return 1;
		InputProcess[playerid] -= 5;
		processbar2(playerid, InputProcess[playerid]);
	}
	else
	{
		if(GetPVarInt(playerid,"sekas") >= 1) SetPVarInt(playerid,"sekas",GetPVarInt(playerid,"sekas")-1);
		else
		{
			if(Sex[playerid] == 4) StopSex(playerid, Sex[playerid]);
			else StopSex(playerid, 0);
		}
	}
	TextDrawHideForPlayer(playerid, InputDraw[0]), TextDrawHideForPlayer(playerid, InputDraw[5]);
	return 1;
}

stock DistanceProcessSex(playerid)
{
	if(!IsPlayerInRangeOfPoint(playerid,2.0,Job_X[playerid], Job_Y[playerid], Job_Z[playerid])) 
	{
		if(OnlineInfo[playerid][oSexBot] == 0) StopSex(playerid, 0);
		StopSexWhore(playerid);
		ErrorMessage(playerid, "{FF6347}Вы сдвинулись с места и прервали процесс");
		return 1;
	}
	return 0;
}

stock CreateSex(playerid, stat)
{
	// playerid - тот кто ебёт или тот, кто делает (Инициатор)
	// stat - вид секса, стандартный, анальный, Минет
	DP[0][playerid] = 0;
	new giveplayerid = SexPlayerid[playerid]; // (Пассивный)
	InputType[playerid] = 0, InputProcess[playerid] = 0, NoAnim[playerid] = 0, SetPVarInt(playerid,"Infect",0);
	if(stat <= 3)
	{
		new Float:X,Float:Y,Float:Z,Float:a;
		GetPlayerPos(playerid, X,Y,Z);
		GetPlayerFacingAngle(playerid,a);
		//X=X+0.3*floatsin(-a,degrees);
	 	//Y=Y+0.3*floatcos(-a,degrees);
		if(stat == 1) // Стандартный
		{
			PPSetPlayerFacingAngle(giveplayerid,180+a);
			PPSetPlayerPos(giveplayerid,X,Y,Z);
			ApplyAnimation(giveplayerid,"BEACH","Lay_Bac_Loop",4.0, true, false, false, true, false, SYNC_ALL);
			ApplyAnimation(playerid,"SWEET","Sweet_injuredloop",4.0, true, false, false, true, false, SYNC_ALL);
			Sex[playerid] = 1;
			Sex[giveplayerid] = 1;
			SetPVarInt(giveplayerid,"Infect",0);
			if(PlayerInfo[playerid][pSex] == 1) SetPlayerAttachedObject(playerid, 1, 19086, 1, -0.078000, 0.119999, 0.008999, 95.299903, 86.899986, 0.299999, 0.328000, 0.481999, 0.494000, 0, 0);
		}
		if(stat == 2) // Анальный
		{
			PPSetPlayerFacingAngle(giveplayerid,180-a);
			PPSetPlayerPos(giveplayerid,X,Y,Z);
			ApplyAnimation(giveplayerid,"SNM","SPANKINGW",4.0, false, false, false, true, false, SYNC_ALL);
			ApplyAnimation(playerid,"SNM","SPANKEDP",4.0, false, false, false, true, false, SYNC_ALL);
			Sex[playerid] = 2;
			Sex[giveplayerid] = 2;
			SetPVarInt(giveplayerid,"Infect",0);
			if(PlayerInfo[playerid][pSex] == 1) SetPlayerAttachedObject(playerid, 1, 19086, 1, -0.078000, 0.119999, 0.008999, 95.299903, 86.899986, 0.299999, 0.328000, 0.481999, 0.494000, 0, 0);
		}
		if(stat == 3) // Минет
		{
			PPSetPlayerFacingAngle(playerid,180+a);
			PPSetPlayerPos(playerid,X,Y,Z);
			ApplyAnimation(playerid,"BLOWJOBZ","BJ_STAND_LOOP_W",4.0, false, false, false, true, false, SYNC_ALL);
			ApplyAnimation(giveplayerid,"BLOWJOBZ","BJ_STAND_LOOP_P",4.0, false, false, false, true, false, SYNC_ALL);
			Sex[playerid] = 3;
			Sex[giveplayerid] = 3;
			SetPVarInt(giveplayerid,"Infect",0);
			if(PlayerInfo[giveplayerid][pSex] == 1) SetPlayerAttachedObject(playerid, 1, 19086, 1, -0.078000, 0.119999, 0.008999, 95.299903, 86.899986, 0.299999, 0.328000, 0.481999, 0.494000, 0, 0);
		}
		GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
		new string[124];
		format(string,sizeof(string),"[ Мысли ]: Мне нужно расслабиться {ff33ff}%s {cccccc}доставит мне удовольствие", playername(playerid)), SendClientMessage(giveplayerid, COLOR_GREY, string);
	}
	if(stat == 4)
	{
		Sex[playerid] = stat;
		if(get_invent(playerid, 62, 0) >= 1) SetPVarInt(playerid,"PlayBoy", 1);
		SetPlayerAttachedObject(playerid, 1, 19086, 1, -0.078000, 0.119999, 0.008999, 95.299903, 86.899986, 0.299999, 0.328000, 0.481999, 0.494000, 0, 0);
	}
	GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
	PlayerTextDrawShow(playerid, InputDraw1);
	PlayerTextDrawShow(playerid, InputDraw2);
	TextDrawShowForPlayer(playerid, InputDraw[1]);
	processbar2(playerid, 0);
	ShowInput(playerid);
	SendClientMessage(playerid, COLOR_GREY, "{ff33ff}[ Sex ] {cccccc}Вам нужно заполнить шкалу удовольствия | Нажимайте на кнопки, указанные справа от шкалы");
	SetPVarInt(playerid, "sekas", 10);
	SexTimer[playerid] = SetTimerEx("SexTime", 300, true, "d", playerid);
	return 1;
}
stock ShowInput(playerid)
{
	if(InputID[playerid] == 1 || InputID[playerid] == 0)
	{
		switch(random(2))
		{
			case 0: TextDrawShowForPlayer(playerid, InputDraw[3]), InputID[playerid] = 2;
			case 1: TextDrawShowForPlayer(playerid, InputDraw[4]), InputID[playerid] = 3;
		}
	}
	else if(InputID[playerid] == 2)
	{
		switch(random(2))
		{
			case 0: TextDrawShowForPlayer(playerid, InputDraw[2]), InputID[playerid] = 1;
			case 1: TextDrawShowForPlayer(playerid, InputDraw[4]), InputID[playerid] = 3;
		}
	}
	else if(InputID[playerid] == 3)
	{
		switch(random(2))
		{
			case 0: TextDrawShowForPlayer(playerid, InputDraw[2]), InputID[playerid] = 1;
			case 1: TextDrawShowForPlayer(playerid, InputDraw[3]), InputID[playerid] = 2;
		}
	}
	return 1;
}
stock Input(playerid, stat)
{
	// inputtype = 0 (секс), inputtype = 1 (взлом генератора), inputtype = 2 (Электрика), inputtype = 3 (Играем с питомцем)
	if(InputID[playerid] == stat)
	{
		new giveplayerid = SexPlayerid[playerid]; // (Пассивный)
		TextDrawShowForPlayer(playerid, InputDraw[0]);
		TextDrawHideForPlayer(playerid, InputDraw[2]);
		TextDrawHideForPlayer(playerid, InputDraw[3]);
		TextDrawHideForPlayer(playerid, InputDraw[4]);
		if(InputProcess[playerid] <= 20) InputProcess[playerid] += 60;
  		else InputProcess[playerid] += 30;

		if (InputType[playerid] == 0) {
			if(get_ability(playerid, 2) > 1) InputProcess[playerid] += get_ability(playerid, 2)*3;
  			if(GetPVarInt(playerid,"PlayBoy") == 1) InputProcess[playerid] += 20;
		}
  		processbar2(playerid, InputProcess[playerid]);

		switch(InputType[playerid])
		{
			case 0: {
				if(InputProcess[playerid] >= 100) SetPVarInt(playerid,"sekas",0);
  				if(InputProcess[playerid] >= 1000) return StopSex(playerid, 1);

				if(Sex[playerid] != 4) // Звук секса, только не во время дрочки
				{
					if(DP[0][playerid] == 0) PlayerPlaySound(playerid,31400,0,0,0);

					DP[0][playerid]++;
					if(DP[0][playerid] >= 4) DP[0][playerid] = 0;
				}
			}
			case 1: {
				if(InputProcess[playerid] >= 100) policeDatabasePlayerInfo[playerid][pdpiGeneratorTime] = 0;
  				if(InputProcess[playerid] >= 1000) return PDatabase_StopGeneratorBroke(playerid, 1);

				new fractionid = PDatabase_GetFractionIDByPos(Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]),
					generatorid = policeDatabasePlayerInfo[playerid][pdpiGeneratorID];
				if(PDatabase_IsGeneratorBroken(fractionid, generatorid)) {
					return PDatabase_StopGeneratorBroke(playerid, 0);
				}

				// Звук ломания генератора
				if (DP[0][playerid] == 0) {
					ApplyAnimation(playerid, "OTB", "betslp_loop", 4.0, false, true, true, false, false, SYNC_ALL);
					PlayerPlaySound(playerid, 32000);
				}
				
				DP[0][playerid]++;
				if (DP[0][playerid] >= 10) DP[0][playerid] = 0;
			}
			case 2: {
				if(InputProcess[playerid] >= 100) ElectricianProcessTime[playerid] = 0;
  				if(InputProcess[playerid] >= 1000) return ElectricianStopProcess(playerid, 1);

				if (DP[0][playerid] == 0) {
					ApplyAnimation(playerid, "OTB", "betslp_loop", 4.0, false, true, true, false, false, SYNC_ALL);
					PlayerPlaySound(playerid, 32000);
				}
				DP[0][playerid]++;
				if (DP[0][playerid] >= 10) DP[0][playerid] = 0;
			}
			case 3: {
				if(InputProcess[playerid] >= 100) PlayingWithPetProcessTime[playerid] = 0;
  				if(InputProcess[playerid] >= 1000) return PlayingWithPetStopProcess(playerid, 1);

				if (DP[0][playerid] == 0) {
					ApplyAnimation(playerid, "RYDER", "VAN_THROW", 4.0, false, true, true, false, false, SYNC_ALL);
					PlayerPlaySound(playerid, 31800);
					CreateObjectForPlayingWithPets(playerid);
				}
				DP[0][playerid]++;
				if (DP[0][playerid] >= 5) DP[0][playerid] = 0;
			}
		}

  		ShowInput(playerid);

		if (InputType[playerid] == 0) {
			if(Sex[playerid] >= 1 && Sex[playerid] <= 2)
			{
				if(InputProcess[playerid] >= 500 && InputProcess[playerid] <= 800 && GetPVarInt(playerid,"Infect") == 0)
				{
					new stope;
					switch(random(2))
					{
						case 0:
						{
							if(getillness(playerid, 1) >= 0 || PlayerInfo[playerid][pInfoload] <= 50) infect(giveplayerid, 1, 2000), stope = 1, SetPVarInt(playerid,"Infect",1);
							if((getillness(playerid, 2) >= 0 || PlayerInfo[playerid][pInfoload] <= 50) && stope == 0) infect(giveplayerid, 2, 2000), stope = 1, SetPVarInt(playerid,"Infect",1);
							if((getillness(playerid, 3) >= 0 || PlayerInfo[playerid][pInfoload] <= 50) && stope == 0) infect(giveplayerid, 3, 2000), SetPVarInt(playerid,"Infect",1);
						}
						default: {}
					}
					
					new stope2;
					switch(random(2))
					{
						case 0:
						{
							if(getillness(giveplayerid, 1) >= 0 || PlayerInfo[giveplayerid][pInfoload] <= 50) infect(playerid, 1, 2000), stope2 = 1, SetPVarInt(giveplayerid,"Infect",1);
							if((getillness(giveplayerid, 2) >= 0 || PlayerInfo[playerid][pInfoload] <= 50) && stope2 == 0) infect(playerid, 2, 2000), stope2 = 1, SetPVarInt(giveplayerid,"Infect",1);
							if((getillness(giveplayerid, 3) >= 0 || PlayerInfo[playerid][pInfoload] <= 50) && stope2 == 0) infect(playerid, 3, 2000), SetPVarInt(giveplayerid,"Infect",1);
						}
						default: {}
					}
				}
			}
			if(Sex[playerid] == 1) // Стандартный
			{
				if(IsOnline(giveplayerid)) ApplyAnimation(giveplayerid,"BEACH","Lay_Bac_Loop",4.0, true, false, false, true, false, SYNC_ALL), PlayerPlaySound(giveplayerid,31400,0,0,0);
				ApplyAnimation(playerid,"SWEET","Sweet_injuredloop",4.0, true, false, false, true, false, SYNC_ALL);
			}
			if(Sex[playerid] == 2) // Анальный
			{
				if(IsOnline(giveplayerid)) ApplyAnimation(giveplayerid,"SNM","SPANKINGW",4.0, true, false, false, true, false, SYNC_ALL), PlayerPlaySound(giveplayerid,31400,0,0,0);
				ApplyAnimation(playerid,"SNM","SPANKEDP",4.0, true, false, false, true, false, SYNC_ALL);
			}
			if(Sex[playerid] == 3) // Минет
			{
				if(giveplayerid == 5555 && OnlineInfo[playerid][oSexBot] > 0) 
				{
					ApplyDynamicActorAnimation(BizShluha[OnlineInfo[playerid][oSexBot]],"BLOWJOBZ","BJ_STAND_LOOP_W", 4.0, false, false, false, true, false);
				}
				if(IsOnline(giveplayerid)) ApplyAnimation(giveplayerid,"BLOWJOBZ","BJ_STAND_LOOP_W",4.0, true, false, false, true, false, SYNC_ALL), PlayerPlaySound(giveplayerid,31400,0,0,0);
				ApplyAnimation(playerid,"BLOWJOBZ","BJ_STAND_LOOP_P",4.0, true, false, false, true, false, SYNC_ALL);
			}
			if(Sex[playerid] == 4) ApplyAnimation(playerid,"PAULNMAC","wank_loop",4.0, false, true, true, true, true, SYNC_ALL);// Онанизм
		}
	}
	else
	{
		TextDrawShowForPlayer(playerid, InputDraw[5]);
		PlayerPlaySound(playerid,31200,0,0,0);
		if(InputProcess[playerid] >= 20)
		{
			if(InputProcess[playerid] >= 800) InputProcess[playerid] -= 160;
			else if(InputProcess[playerid] >= 400 && InputProcess[playerid] < 800) InputProcess[playerid] -= 80;
			else if(InputProcess[playerid] >= 100 && InputProcess[playerid] < 400) InputProcess[playerid] -= 40;
			else InputProcess[playerid] -= 20;
  			processbar2(playerid, InputProcess[playerid]);
		}
		else
		{
			if (InputType[playerid] == 0) {
				if(Sex[playerid] == 4) StopSex(playerid, Sex[playerid]);
				else StopSex(playerid, 0);
			} else if (InputType[playerid] == 1) {
				PDatabase_StopGeneratorBroke(playerid, 0);
			} else if (InputType[playerid] == 2) {
				ElectricianStopProcess(playerid, 0);
			} else if (InputType[playerid] == 3) {
				PlayingWithPetStopProcess(playerid, 0);
			}
		}
	}
	return 1;
}

stock StopSexWhore(playerid)
{
	if(OnlineInfo[playerid][oSexBot] > 0)
	{
		ClearAnimations(playerid);
		BizShluhaStatus[OnlineInfo[playerid][oSexBot]] = -1;
		ClearDynamicActorAnimations(BizShluha[OnlineInfo[playerid][oSexBot]]);
		OnlineInfo[playerid][oSexBot] = 0;
	}

	if(SexTimer[playerid] > 0) KillTimer(SexTimer[playerid]);
	return 1;
}

stock StopSex(playerid, stat)
{
	new giveplayerid = SexPlayerid[playerid];
	ClearAnimations(playerid);
	ClearAnim(playerid);

	if(OnlineInfo[playerid][oSexBot] > 0 
		&& stat == 1) // stat 1 - значит успешно, какого хуя запускается даже при том что чел наебался
	{
		update_ability(playerid, 2, 30);
		PlayerInfo[playerid][pSexBreak] = gettime()+900, mysql_save(playerid, 56);

		if(get_invent4(playerid,71,0) > 0 && PlayerInfo[playerid][pQuest][6] != 1) 
		{
			TakeInvent(playerid, 71, 1, 0, 999);
			SuccessMessage(playerid,"{44ff99}Вы были в презервативе и ничем не заразились");
		}
		else if(PlayerInfo[playerid][pQuest][6] == 1)
		{ 
			infect(playerid, 1, 2000);
			PlayerInfo[playerid][pQuest][6] = 2;
			QuestActorJoneSeks(playerid);
		}
		ACSetPlayerHealth(playerid, GetMaxPlayerHealth(playerid));
	}
	else if(IsOnline(giveplayerid))
	{
		if(stat == 1)
		{
			PlayerPlaySound(giveplayerid,6401,0,0,0);
			if(PlayerInfo[giveplayerid][pSex] == 1) PlayerInfo[giveplayerid][pSexBreak] = gettime()+900, mysql_save(giveplayerid, 56);
		}
		else if(stat == 0)
		{
			new string[144];
			if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"[ Мысли ]: %s меня не удовлетворил", playername(playerid)), SendClientMessage(giveplayerid, COLOR_GREY, string);
			else format(string,sizeof(string),"[ Мысли ]: %s меня не удовлетворила", playername(playerid)), SendClientMessage(giveplayerid, COLOR_GREY, string);

			if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"[ Мысли ]: Я не смог удовлетворить %s", playername(giveplayerid)), SendClientMessage(playerid, COLOR_GREY, string);
			else format(string,sizeof(string),"[ Мысли ]: Я не смогла удовлетворить %s", playername(giveplayerid)), SendClientMessage(playerid, COLOR_GREY, string);
		}
		ClearAnimations(giveplayerid);
		ClearAnim(giveplayerid);
		Sex[giveplayerid] = 0;
		SexPlayerid[giveplayerid] = 9999;
		InputProcess[giveplayerid] = 0;
		InputID[giveplayerid] = 0;
		if(PlayerInfo[giveplayerid][pSex] == 1) RemovePlayerAttachedObject(giveplayerid,1);
	}
	TextDrawHideForPlayer(playerid, InputDraw[0]);
	TextDrawHideForPlayer(playerid, InputDraw[1]);
	TextDrawHideForPlayer(playerid, InputDraw[2]);
	TextDrawHideForPlayer(playerid, InputDraw[3]);
	TextDrawHideForPlayer(playerid, InputDraw[4]);
	TextDrawHideForPlayer(playerid, InputDraw[5]);
	PlayerTextDrawHide(playerid, InputDraw1);
	PlayerTextDrawHide(playerid, InputDraw2);
	if(PlayerInfo[playerid][pSex] == 1) RemovePlayerAttachedObject(playerid,1);
	if(stat == 1)
	{
		if(Sex[playerid] == 1 || Sex[playerid] == 2 || Sex[playerid] == 3) update_ability(playerid, 2, 30);
		PlayerPlaySound(playerid,6401,0,0,0);
		if(GetPVarInt(playerid,"Stakandroch") == 1 || GetPVarInt(playerid,"Stakandroch") == 2)
		{
			SetPlayerAttachedObject(playerid, 1, 1666, 5, 0.090999, 0.050999, -0.055000, -6.899999, -0.599999, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Отнесите вашу семенную жидкость в приёмную","*","");
			SetPVarInt(playerid,"Stakandroch",3);
			ClearAnimations(playerid);
		}
		if(Sex[playerid] == 4)
		{
			ApplyAnimation(playerid,"PAULNMAC","wank_out",4.0, false, true, true, false, false), update_ability(playerid, 2, 10);
			if(PlayerInfo[playerid][pAchieve][76] == 0) AchievePlayer(playerid, 76, 1);
			if(PlayerInfo[playerid][pAchieve][124] == 2) AchievePlayer(playerid, 124, 1);
		}
		if(PlayerInfo[playerid][pSex] == 1) PlayerInfo[playerid][pSexBreak] = gettime()+900, mysql_save(playerid, 56);
	}
	if(stat == 4 || stat == 0)
	{
		ErrorMessage(playerid, "{FF6347}У вас не получилось"), PlayerPlaySound(playerid,31202,0,0,0);
		if(PlayerInfo[playerid][pSex] == 1 
			&& OnlineInfo[playerid][oSexBot] == 0) PlayerInfo[playerid][pSexBreak] = gettime()+300, mysql_save(playerid, 56);
	}
	Sex[playerid] = 0;
	if(OnlineInfo[playerid][oSexBot] > 0) StopSexWhore(playerid);
	SexPlayerid[playerid] = 9999;
	InputProcess[playerid] = 0;
	InputID[playerid] = 0;
	KillTimer(SexTimer[playerid]);
	DeletePVar(playerid, "sekas");
	return 1;
}
stock ShowDip(playerid, frakid)
{
	new str[224],sctring[1500];
	format(str,sizeof(str),"{0088ff}* {cccccc}Организация: {ffffff}%s",frakName[frakid]);
	strcat(sctring,str);
	format(str,sizeof(str),"\n\n\n{FF0000}     [ Война ]\n\n");
	strcat(sctring,str);
	for(new fr = 0; fr < 5; fr++ )
	{
		if(orgwar[frakid][fr] >= 1)
		{
			format(str,sizeof(str),"{cccccc}%s\n",frakName[orgwar[frakid][fr]]);
			strcat(sctring,str);
		}
	}
	format(str,sizeof(str),"\n\n\n{00cc00}     [ Союз ]\n\n");
	strcat(sctring,str);
	for(new fr = 0; fr < 5; fr++ )
	{
		if(orguni[frakid][fr] >= 1)
		{
			format(str,sizeof(str),"{cccccc}%s\n",frakName[orguni[frakid][fr]]);
			strcat(sctring,str);
		}
	}
	ShowDialog(playerid,2018,DIALOG_STYLE_MSGBOX,"{ff9000}Дипломатия",sctring,"Назад","");
	return 1;
}
stock ReasonTrade(playerid, targetid, stat)
{
	PlayerPlaySound(playerid,4203,0,0,0);
	if(stat == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
		return 1;
	}
	PlayerPlaySound(targetid,4203,0,0,0);
	new string[144];
	if(stat == 1)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает денег..");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}не хватает денег",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 2)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает золота..");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}не хватает золота",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 4)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой транспорт отсутствует");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}не загружен личный транспорт",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 6)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не владелец дома, который используется в качестве товара");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}не владелец дома, который используется в качестве товара",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 7)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не владелец квартиры, которая используется в качестве товара");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}не владелец квартиры, которая используется в качестве товара",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 8)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не владелец бизнеса, который используется в качестве товара");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}не владелец бизнеса, который используется в качестве товара",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 10)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не владелец семьи, которая используется в качестве товара");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}не владелец семьи, выставленной в качестве товара",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 14)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно убрать одно транспортное средство в гараж или на парковку {ffcc00}[ Y >> GPS >> Парковки ]");
		format(string,sizeof(string),"[ Мысли ]: {ff0000}%s {cccccc}необходимо убрать одно транспортное средство в гараж или на парковку",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 16)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня уже есть дом {ffcc00}[ /mydom ]");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}уже есть дом",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 17)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня уже есть квартира {ffcc00}[ /myhouse ]");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}уже есть квартира",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 18)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня уже есть бизнес {ffcc00}[ /mybiz ]");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}уже есть бизнес",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 20)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня уже есть семья {ffcc00}[ /fam ]");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}уже есть семья",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 21)
	{
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть деньги. Зачем нам меняться одинаковой валютой?",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть деньги. Зачем нам меняться одинаковой валютой?",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 22)
	{
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть золото. Зачем нам меняться золотом?",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть золото. Зачем нам меняться золотом?",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 23)
	{
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть BitCoin. Зачем нам меняться одинаковой криптовалютой?",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть BitCoin. Зачем нам меняться одинаковой криптовалютой?",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 25)
	{
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть интерьеры. Мы не можем обменяться..",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: В моей и %s сделке есть интерьеры. Мы не можем обменяться..",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 26)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс интерьера в моём доме, выше номера класса у покупателя");
		SendClientMessage(targetid, COLOR_GREY, "[ Мысли ]: Класс интерьера у продавца, выше номера класса в моём доме");
		return 1;
	}
	else if(stat == 27)
	{
		format(string,sizeof(string),"[ Мысли ]: У %s нет дома..",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: У меня нет дома.."), SendClientMessage(playerid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 29)
	{
		format(string,sizeof(string),"[ Мысли ]: Мы не можем обменяться интерьером и домом одновременно"), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: Мы не можем обменяться интерьером и домом одновременно"), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 30)
	{
		format(string,sizeof(string),"[ Мысли ]: В наших сделка с %s указана одна и таже семья!",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: В наших сделка с %s указана одна и таже семья!",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 41)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет свободных слотов для личного транспорта");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}нет свободных слотов для личного транспорта",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 42)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Проблема с моим транспортом, он куда-то делся [ Во время продажи транспорт должен быть загружен ]");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}возникла проблема с транспортом [ Не загружен ]",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 50)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Суммарная ценность моей сделки недостаточная для обмена");
		format(string,sizeof(string),"[ Мысли ]: У {ff0000}%s {cccccc}слишком маленькая суммарная ценность сделки",PlayerInfo[playerid][pName]), SendClientMessage(targetid, COLOR_GREY, string);
		return 1;
	}
	else if(stat == 51)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество объектов в моём доме, выше лимита объектов в доме покупателя");
		SendClientMessage(targetid, COLOR_GREY, "[ Мысли ]: Количество объектов в доме продавца, выше лимита объектов в моём доме");
		return 1;
	}
	return 1;
}
stock StopTrade(playerid, targetid)
{
	new mPla[3],mTar[3], sPla[3],sTar[3];
	// Сокращаем размеры
	mPla[0] = PlayerInfo[playerid][pTmodel][0], mPla[1] = PlayerInfo[playerid][pTmodel][1], mPla[2] = PlayerInfo[playerid][pTmodel][2];
	mTar[0] = PlayerInfo[targetid][pTmodel][0], mTar[1] = PlayerInfo[targetid][pTmodel][1], mTar[2] = PlayerInfo[targetid][pTmodel][2];

	sPla[0] = PlayerInfo[playerid][pTslot][0], sPla[1] = PlayerInfo[playerid][pTslot][1], sPla[2] = PlayerInfo[playerid][pTslot][2];
	sTar[0] = PlayerInfo[targetid][pTslot][0], sTar[1] = PlayerInfo[targetid][pTslot][1], sTar[2] = PlayerInfo[targetid][pTslot][2];
	for(new s = 0; s < 3; s++ )
	{
		// Проверки наличия имущества участников
		if(PlayerInfo[playerid][pTslot][s] == 1 && oGetPlayerMoney(playerid) < PlayerInfo[playerid][pTamount][s]) return ReasonTrade(playerid, targetid, 1);
		if(PlayerInfo[targetid][pTslot][s] == 1 && oGetPlayerMoney(targetid) < PlayerInfo[targetid][pTamount][s]) return ReasonTrade(targetid, playerid, 1);
		if(PlayerInfo[playerid][pTslot][s] == 2 && PlayerInfo[playerid][pDonateMoney] < PlayerInfo[playerid][pTamount][s]) return ReasonTrade(playerid, targetid, 2);
		if(PlayerInfo[targetid][pTslot][s] == 2 && PlayerInfo[targetid][pDonateMoney] < PlayerInfo[targetid][pTamount][s]) return ReasonTrade(targetid, playerid, 2);

		if(PlayerInfo[playerid][pTslot][s] == 4)
		{
			new slotid = PlayerInfo[playerid][pTamount][s] - 1;
			new v = PlayerInfo[playerid][pTmodel][s];
			if(v >= 2000) return ReasonTrade(playerid, targetid, 4);
			if(PlayerInfo[playerid][pMyVehID][slotid] == 0 
				|| VehInfo[v][vModel] == 0 || VehInfo[v][vSost] != PlayerInfo[playerid][pID]) return ReasonTrade(playerid, targetid, 4);
		}
		if(PlayerInfo[targetid][pTslot][s] == 4)
		{
			new slotid = PlayerInfo[targetid][pTamount][s] - 1;
			new v = PlayerInfo[targetid][pTmodel][s];
			if(v >= 2000) return ReasonTrade(targetid, playerid, 4);
			if(PlayerInfo[targetid][pMyVehID][slotid] == 0 
				|| VehInfo[v][vModel] == 0 || VehInfo[v][vSost] != PlayerInfo[targetid][pID]) return ReasonTrade(targetid, playerid, 4);
		}
		
		if(PlayerInfo[playerid][pTslot][s] == 6 && PlayerInfo[playerid][pDom] != PlayerInfo[playerid][pTmodel][s]) return ReasonTrade(playerid, targetid, 6);
		if(PlayerInfo[targetid][pTslot][s] == 6 && PlayerInfo[targetid][pDom] != PlayerInfo[targetid][pTmodel][s]) return ReasonTrade(targetid, playerid, 6);
		//if(PlayerInfo[playerid][pTslot][s] == 7 && PlayerInfo[playerid][pRoom] != PlayerInfo[playerid][pTmodel][s]) return ReasonTrade(playerid, targetid, 7);
		//if(PlayerInfo[targetid][pTslot][s] == 7 && PlayerInfo[targetid][pRoom] != PlayerInfo[targetid][pTmodel][s]) return ReasonTrade(targetid, playerid, 7);
		if(PlayerInfo[playerid][pTslot][s] == 8 && PlayerInfo[playerid][pBusiness] != PlayerInfo[playerid][pTmodel][s]) return ReasonTrade(playerid, targetid, 8);
		if(PlayerInfo[targetid][pTslot][s] == 8 && PlayerInfo[targetid][pBusiness] != PlayerInfo[targetid][pTmodel][s]) return ReasonTrade(targetid, playerid, 8);
		if(PlayerInfo[playerid][pTslot][s] == 10 && PlayerInfo[playerid][pFamily] != PlayerInfo[playerid][pTmodel][s] && FamilyInfo[PlayerInfo[playerid][pFamily]][fOwner] != PlayerInfo[playerid][pID]) return ReasonTrade(playerid, targetid, 10);
		if(PlayerInfo[targetid][pTslot][s] == 10 && PlayerInfo[targetid][pFamily] != PlayerInfo[targetid][pTmodel][s] && FamilyInfo[PlayerInfo[targetid][pFamily]][fOwner] != PlayerInfo[targetid][pID]) return ReasonTrade(targetid, playerid, 10);

		// Проверка одинакового имущества участников
		if(PlayerInfo[playerid][pTslot][s] == 1 && (PlayerInfo[targetid][pTslot][0] == 1 || PlayerInfo[targetid][pTslot][1] == 1 || PlayerInfo[targetid][pTslot][2] == 1)) return ReasonTrade(playerid, targetid, 21); // Деньги на деньги
		if(PlayerInfo[playerid][pTslot][s] == 2 && (PlayerInfo[targetid][pTslot][0] == 2 || PlayerInfo[targetid][pTslot][1] == 2 || PlayerInfo[targetid][pTslot][2] == 2)) return ReasonTrade(playerid, targetid, 22); // Золото на золото
		if(PlayerInfo[playerid][pTslot][s] == 3 && (PlayerInfo[targetid][pTslot][0] == 3 || PlayerInfo[targetid][pTslot][1] == 3 || PlayerInfo[targetid][pTslot][2] == 3)) return ReasonTrade(playerid, targetid, 23); // BitCoin на BitCoin
		if(PlayerInfo[playerid][pTslot][s] == 9 && (PlayerInfo[targetid][pTslot][0] == 9 || PlayerInfo[targetid][pTslot][1] == 9 || PlayerInfo[targetid][pTslot][2] == 9)) return ReasonTrade(playerid, targetid, 24); // Время на время
		if(PlayerInfo[playerid][pTslot][s] == 10
		&&(sTar[0] == 10 && mTar[0] == mPla[s] || sTar[1] == 10 && mTar[1] == mPla[s] || sTar[2] == 10 && mTar[2] == mPla[s])) return ReasonTrade(playerid, targetid, 30); // Семья на семью
		if(PlayerInfo[targetid][pTslot][s] == 10
		&&(sPla[0] == 10 && mPla[0] == mTar[s] || sPla[1] == 10 && mPla[1] == mTar[s] || sPla[2] == 10 && mPla[2] == mTar[s])) return ReasonTrade(targetid, playerid, 30); // Семья на семью

		// Проверка свободного места участников
		if(PlayerInfo[targetid][pTslot][s] == 6 && PlayerInfo[playerid][pDom] >= 1 && (PlayerInfo[playerid][pTslot][0] != 6 && PlayerInfo[playerid][pTslot][1] != 6 && PlayerInfo[playerid][pTslot][2] != 6)) return ReasonTrade(playerid, targetid, 16);
		if(PlayerInfo[playerid][pTslot][s] == 6 && PlayerInfo[targetid][pDom] >= 1 && (PlayerInfo[targetid][pTslot][0] != 6 && PlayerInfo[targetid][pTslot][1] != 6 && PlayerInfo[targetid][pTslot][2] != 6)) return ReasonTrade(targetid, playerid, 16);
		//if(PlayerInfo[targetid][pTslot][s] == 7 && PlayerInfo[playerid][pRoom] >= 1 && (PlayerInfo[playerid][pTslot][0] != 7 && PlayerInfo[playerid][pTslot][1] != 7 && PlayerInfo[playerid][pTslot][2] != 7)) return ReasonTrade(playerid, targetid, 17);
		//if(PlayerInfo[playerid][pTslot][s] == 7 && PlayerInfo[targetid][pRoom] >= 1 && (PlayerInfo[targetid][pTslot][0] != 7 && PlayerInfo[targetid][pTslot][1] != 7 && PlayerInfo[targetid][pTslot][2] != 7)) return ReasonTrade(targetid, playerid, 17);
		if(PlayerInfo[targetid][pTslot][s] == 8 && PlayerInfo[playerid][pBusiness] >= 1 && (PlayerInfo[playerid][pTslot][0] != 8 && PlayerInfo[playerid][pTslot][1] != 8 && PlayerInfo[playerid][pTslot][2] != 8)) return ReasonTrade(playerid, targetid, 18);
		if(PlayerInfo[playerid][pTslot][s] == 8 && PlayerInfo[targetid][pBusiness] >= 1 && (PlayerInfo[targetid][pTslot][0] != 8 && PlayerInfo[targetid][pTslot][1] != 8 && PlayerInfo[targetid][pTslot][2] != 8)) return ReasonTrade(targetid, playerid, 18);
		if(PlayerInfo[targetid][pTslot][s] == 10 && PlayerInfo[playerid][pFamily] >= 1 && (PlayerInfo[playerid][pTslot][0] != 10 && PlayerInfo[playerid][pTslot][1] != 10 && PlayerInfo[playerid][pTslot][2] != 10)) return ReasonTrade(playerid, targetid, 20);
		if(PlayerInfo[playerid][pTslot][s] == 10 && PlayerInfo[targetid][pFamily] >= 1 && (PlayerInfo[targetid][pTslot][0] != 10 && PlayerInfo[targetid][pTslot][1] != 10 && PlayerInfo[targetid][pTslot][2] != 10)) return ReasonTrade(targetid, playerid, 20);
		if(PlayerInfo[targetid][pTslot][s] == 11 && (PlayerInfo[playerid][pTslot][0] == 11 || PlayerInfo[playerid][pTslot][1] == 11 || PlayerInfo[playerid][pTslot][2] == 11)) return ReasonTrade(playerid, targetid, 25);
		if(PlayerInfo[playerid][pTslot][s] == 11 && (PlayerInfo[targetid][pTslot][0] == 11 || PlayerInfo[targetid][pTslot][1] == 11 || PlayerInfo[targetid][pTslot][2] == 11)) return ReasonTrade(targetid, playerid, 25);
		if(PlayerInfo[targetid][pTslot][s] == 11 && PlayerInfo[targetid][pDom] != PlayerInfo[targetid][pTmodel][s]) return ReasonTrade(targetid, playerid, 6);
		if(PlayerInfo[playerid][pTslot][s] == 11 && PlayerInfo[playerid][pDom] != PlayerInfo[playerid][pTmodel][s]) return ReasonTrade(playerid, targetid, 6);

		if(PlayerInfo[playerid][pTslot][s] == 11 && PlayerInfo[targetid][pDom] == 0) return ReasonTrade(targetid, playerid, 27);
		if(PlayerInfo[targetid][pTslot][s] == 11 && PlayerInfo[playerid][pDom] == 0) return ReasonTrade(playerid, targetid, 27);
		if(PlayerInfo[playerid][pTslot][s] == 11 && PlayerInfo[playerid][pDom] == 0) return ReasonTrade(playerid, targetid, 27);
		if(PlayerInfo[targetid][pTslot][s] == 11 && PlayerInfo[targetid][pDom] == 0) return ReasonTrade(targetid, playerid, 27);
		if(PlayerInfo[playerid][pTslot][s] == 11 && (PlayerInfo[targetid][pTslot][0] == 6 || PlayerInfo[targetid][pTslot][1] == 6 || PlayerInfo[targetid][pTslot][2] == 6)) return ReasonTrade(playerid, targetid, 29);
		if(PlayerInfo[targetid][pTslot][s] == 11 && (PlayerInfo[playerid][pTslot][0] == 6 || PlayerInfo[playerid][pTslot][1] == 6 || PlayerInfo[playerid][pTslot][2] == 6)) return ReasonTrade(targetid, playerid, 29);
		if(PlayerInfo[playerid][pTslot][s] == 6 && (PlayerInfo[targetid][pTslot][0] == 11 || PlayerInfo[targetid][pTslot][1] == 11 || PlayerInfo[targetid][pTslot][2] == 11)) return ReasonTrade(playerid, targetid, 29);
		if(PlayerInfo[targetid][pTslot][s] == 6 && (PlayerInfo[playerid][pTslot][0] == 11 || PlayerInfo[playerid][pTslot][1] == 11 || PlayerInfo[playerid][pTslot][2] == 11)) return ReasonTrade(targetid, playerid, 29);

		// Сверяем Цены
		/*if(PlayerInfo[playerid][pTslot][s] == 2)
		{
			new mylave = PlayerInfo[playerid][pTlave]/2;
			new youlave = PlayerInfo[targetid][pTlave];
			if(youlave < mylave) return ReasonTrade(targetid, playerid, 50);
		}
		if(PlayerInfo[targetid][pTslot][s] == 2)
		{
			new mylave = PlayerInfo[targetid][pTlave]/2;
			new youlave = PlayerInfo[playerid][pTlave];
			if(youlave < mylave) return ReasonTrade(playerid, targetid, 50);
		}*/
	}

	new quanVehLoad[2], quanFreeSlot[2], quanVehTrade[2], problemVehTrade[2];
	for(new i = 0; i < MAX_MYVEHICLE; i++)
	{
		// Считаем загруженные авто игроков
		if(PlayerInfo[playerid][pMyVeh][i] > 0 && PlayerInfo[playerid][pMyVehID][i] > 0) quanVehLoad[0] ++;
		if(PlayerInfo[targetid][pMyVeh][i] > 0 && PlayerInfo[targetid][pMyVehID][i] > 0) quanVehLoad[1] ++;

		// Считаем свободные слоты
		if(PlayerInfo[playerid][pMyVeh][i] == 0) 
		{
			if(i <= 1) quanFreeSlot[0] ++;
			else
			{
				if(PlayerInfo[playerid][pMyVehSlot][i] == true) quanFreeSlot[0] ++;
			}
		}

		if(PlayerInfo[targetid][pMyVeh][i] == 0) 
		{
			if(i <= 1) quanFreeSlot[1] ++;
			else
			{
				if(PlayerInfo[targetid][pMyVehSlot][i] == true) quanFreeSlot[1] ++;
			}
		}
	}

	// Считаем транспорт в сделке (Тогда занятые слоты освободятся)
	new slotId;
	for(new i = 0; i < 3; i++)
	{
		if(PlayerInfo[playerid][pTslot][i] == 4 && PlayerInfo[playerid][pTamount][i] > 0 && PlayerInfo[playerid][pTamount][i] <= MAX_MYVEHICLE) 
		{
			slotId = PlayerInfo[playerid][pTamount][i] - 1;
			if(PlayerInfo[playerid][pMyVehID][slotId] == 0) problemVehTrade[0] = 1;
			quanVehTrade[0] ++;
		}
		if(PlayerInfo[targetid][pTslot][i] == 4 && PlayerInfo[targetid][pTamount][i] > 0 && PlayerInfo[targetid][pTamount][i] <= MAX_MYVEHICLE) 
		{
			slotId = PlayerInfo[targetid][pTamount][i] - 1;
			if(PlayerInfo[targetid][pMyVehID][slotId] == 0) problemVehTrade[1] = 1;
			quanVehTrade[1] ++;
		}
	}

	if(problemVehTrade[0] == 1) return ReasonTrade(playerid, targetid, 42);
	if(problemVehTrade[1] == 1) return ReasonTrade(targetid, playerid, 42);

	// Ищем свободные слоты
	printf("%s quanVehTrade %d (free slot %d) [Требуется: %d]", PlayerInfo[playerid][pName], quanVehTrade[0], quanFreeSlot[0]+quanVehTrade[0], quanVehTrade[1]);
	printf("%s quanVehTrade %d (free slot %d) [Требуется: %d]", PlayerInfo[targetid][pName], quanVehTrade[1], quanFreeSlot[1]+quanVehTrade[1], quanVehTrade[0]);
	if(quanVehTrade[1] > 0 && quanFreeSlot[0]+quanVehTrade[0] < quanVehTrade[1]) return ReasonTrade(playerid, targetid, 41);
	if(quanVehTrade[0] > 0 && quanFreeSlot[1]+quanVehTrade[1] < quanVehTrade[0]) return ReasonTrade(targetid, playerid, 41);

	// Ищем свободные слоты загруженного транспорта
	new freeLoad0 = 2 - quanVehLoad[0];
	new freeLoad1 = 2 - quanVehLoad[1];
	printf("%s quanVehTrade %d (free gar %d) [Требуется: %d]", PlayerInfo[playerid][pName], quanVehTrade[0], freeLoad0+quanVehTrade[0], quanVehTrade[1]);
	printf("%s quanVehTrade %d (free gar %d) [Требуется: %d]", PlayerInfo[targetid][pName], quanVehTrade[1], freeLoad1+quanVehTrade[1], quanVehTrade[0]);
	if(quanVehTrade[1] > 0 && freeLoad0+quanVehTrade[0] < quanVehTrade[1]) return ReasonTrade(playerid, targetid, 14);
	if(quanVehTrade[0] > 0 && freeLoad1+quanVehTrade[1] < quanVehTrade[0]) return ReasonTrade(targetid, playerid, 14);
	return 0;
}
stock Delete_TradeCar(playerid) // Удаляем Транспорт Владельцу
{
	// Условия: Он имеется, Наш собственный, Сами хотим его махнуть
	new trslot, vehslot;
	if(PlayerInfo[playerid][pTslot][0] == 4 && PlayerInfo[playerid][pTstope][0] >= 1 && PlayerInfo[playerid][pTdone][0] == 0) trslot = 0, vehslot = PlayerInfo[playerid][pTamount][0];
	else if(PlayerInfo[playerid][pTslot][1] == 4 && PlayerInfo[playerid][pTstope][1] >= 1 && PlayerInfo[playerid][pTdone][1] == 0) trslot = 1, vehslot = PlayerInfo[playerid][pTamount][1];
	else if(PlayerInfo[playerid][pTslot][2] == 4 && PlayerInfo[playerid][pTstope][2] >= 1 && PlayerInfo[playerid][pTdone][2] == 0) trslot = 2, vehslot = PlayerInfo[playerid][pTamount][2];
	
	if(vehslot == 0) return printf("[debug] Delete_TradeCar %s", PlayerInfo[playerid][pName]);

	PlayerInfo[playerid][pMyVeh][vehslot - 1] = 0;
	PlayerInfo[playerid][pMyVehID][vehslot - 1] = 0;

	new string_mysql[120];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_cars` WHERE `sost`='%d' AND `slot`='%d'", PlayerInfo[playerid][pID], vehslot);
	query_empty(pearsq, string_mysql);

	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_igroki` SET `MyVeh%d` = '0' WHERE `user_id` = '%d'", vehslot - 1, PlayerInfo[playerid][pID]);
    query_empty(pearsq, string_mysql);

	PlayerInfo[playerid][pTstope][trslot] = 0; // Этот больше удалять нельзя [Отметка Trade Слот]
	return 1;
}
forward Call_carnewid(v);
public Call_carnewid(v)
{
	new rows;
	cache_get_row_count(rows);
	if(rows) cache_get_value_name_int(0, "newid", VehInfo[v][vNewid]);
	printf("Call_carnewid %d %d", v, VehInfo[v][vNewid]);
	SaveCar(v);
	SaveBoot(v);
	SaveTunning(v);
	return 1;
}
forward Call_ReversLichCar(playerid, slot, veh);
public Call_ReversLichCar(playerid, slot, veh)
{
	new rows;
	cache_get_row_count(rows);

	PlayerInfo[playerid][pMyVeh][slot] = VehInfo[veh][vModel];
	PlayerInfo[playerid][pMyVehID][slot] = veh;
	VehInfo[veh][vDatabase] = slot + 1;
	VehInfo[veh][vSost] = PlayerInfo[playerid][pID];
	VehInfo[veh][vIdvlad] = playerid;
	VehInfo[veh][vKey] = 0;

	new string_mysql[120];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_igroki` SET `MyVeh%d` = '%d' WHERE `user_id` = '%d'", 
		slot, VehInfo[veh][vModel], PlayerInfo[playerid][pID]);
    query_empty(pearsq, string_mysql);

	//PlayerInfo[playerid][pTnoveh][slot] = 1; // Сюда кидать транспорт больше нельзя [Отметка Car Слот]
	if(!rows)
	{
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `pp_cars` SET `sost`='%d', `slot`='%d'", PlayerInfo[playerid][pID], slot + 1);
		query_empty(pearsq, string_mysql);
		mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `pp_cars` WHERE `sost`='%d' AND `slot`='%d'", PlayerInfo[playerid][pID], slot + 1); // Грузим ID Транспорта
		mysql_tquery(pearsq, string_mysql, "Call_carnewid", "d", veh);
	}
	else printf("[debug] Call_ReversLichCar %s [%d %d]", PlayerInfo[playerid][pName], slot, veh);
	return 1;
}
stock Insert_TradeCar(playerid, veh)
{
	// Только если нет транспорта или скоро удалится
	for(new i = 0; i < MAX_MYVEHICLE; i++)
	{
		if(PlayerInfo[playerid][pMyVeh][i] == 0 && PlayerInfo[playerid][pTnoveh][i] == 0)
		{
			PlayerInfo[playerid][pTnoveh][i] = 1;

			new string_mysql[100];
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `pp_cars` WHERE `sost`='%d' AND `slot`='%d'", PlayerInfo[playerid][pID], i + 1);
	 		mysql_tquery(pearsq, string_mysql, "Call_ReversLichCar", "ddd", playerid, i, veh);
			break;
		}
	}
	return 1;
}
stock GoTrade(playerid, targetid)
{
	// playerid - чувак, который согласился
	// targetid - чувак, который предложил

	if(!IsOnline(targetid)) return ReasonTrade(playerid, targetid, 0); // Первый участник не в игре
	if(PlayerInfo[playerid][pTstat] >= 1 && PlayerInfo[targetid][pTstat] >= 1 && PlayerInfo[playerid][pTid] >= 0 && PlayerInfo[targetid][pTid] >= 0 && PlayerInfo[playerid][pTid] == targetid && PlayerInfo[targetid][pTid] == playerid)
	{
		new string[144];
		if(GetPlayerState(targetid) == PLAYER_STATE_SPECTATING && gSpectateID[targetid] != INVALID_PLAYER_ID) return format(string,sizeof(string),"[ Мысли ]: %s далеко от меня",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
    	if(!ProxDetectorS(3.0, playerid, targetid)) return format(string,sizeof(string),"[ Мысли ]: %s далеко от меня",PlayerInfo[targetid][pName]), SendClientMessage(playerid, COLOR_GREY, string);
    	if(!StopTrade(playerid, targetid))
    	{
    		if(PlayerInfo[playerid][pTslot][0] == 0 && PlayerInfo[playerid][pTslot][1] == 0 && PlayerInfo[playerid][pTslot][2] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В моей сделке нет товара");
 			if(PlayerInfo[targetid][pTslot][0] == 0 && PlayerInfo[targetid][pTslot][1] == 0 && PlayerInfo[targetid][pTslot][2] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В его сделке нет товара");
 			ServerInfo[46] ++;
			SaveServer(46);
			new stro[100],sctroing[800],str[100],sctring[800], unix = gettime();
			format(str,sizeof(str),"\n{0088ff}Список приобретённого имущества:\n\n");
			strcat(sctring,str);
			format(stro,sizeof(stro),"\n{0088ff}Список приобретённого имущества:\n\n");
			strcat(sctroing,stro);
			// Цикл Синхронизации
			for(new ts = 0; ts < 3; ts++ )
			{
				// Удаляем наши тачки сначала
				if(PlayerInfo[playerid][pTslot][ts] == 4)
				{
					CarLog("sellcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], VehInfo[PlayerInfo[playerid][pTmodel][ts]][vModel], ServerInfo[46], "Сделка: Транспорт"); 
					Delete_TradeCar(playerid);
				}
				if(PlayerInfo[targetid][pTslot][ts] == 4)
				{
					CarLog("sellcar", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], VehInfo[PlayerInfo[targetid][pTmodel][ts]][vModel], ServerInfo[46], "Сделка: Транспорт");
					Delete_TradeCar(targetid);
				}
			}

			// Кидаем инфу в TradeLog
			if(PlayerInfo[playerid][pTslot][0] >= 1 || PlayerInfo[playerid][pTslot][1] >= 1 || PlayerInfo[playerid][pTslot][2] >= 1) TradeLog(ServerInfo[46], playerid, targetid); // Trade 1 Игрока
			if(PlayerInfo[targetid][pTslot][0] >= 1 || PlayerInfo[targetid][pTslot][1] >= 1 || PlayerInfo[targetid][pTslot][2] >= 1) TradeLog(ServerInfo[46], targetid, playerid); // Trade 2 Игрока
			for(new s = 0; s < 3; s++ )
			{
				// Синхронизация имущества
				if(PlayerInfo[playerid][pTslot][s] == 1)
				{
					oGivePlayerMoney(playerid, -PlayerInfo[playerid][pTamount][s]);
					oGivePlayerMoney(targetid, PlayerInfo[playerid][pTamount][s]);
					new qwer[24];
					format(qwer,sizeof(qwer),"Сделка № %d", ServerInfo[46]);
					MoneyLog("trade", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], -PlayerInfo[playerid][pTamount][s], qwer);
					MoneyLog("trade", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playerid][pTamount][s], qwer);
					format(stro,sizeof(stro),"{cccccc}Деньги: {00cc00}%d$\n", PlayerInfo[playerid][pTamount][s]), strcat(sctroing,stro);
				}
				if(PlayerInfo[targetid][pTslot][s] == 1)
				{
					oGivePlayerMoney(targetid, -PlayerInfo[targetid][pTamount][s]);
					oGivePlayerMoney(playerid, PlayerInfo[targetid][pTamount][s]);
					new qwer[24];
					format(qwer,sizeof(qwer),"Сделка № %d", ServerInfo[46]);
					MoneyLog("trade", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -PlayerInfo[targetid][pTamount][s], qwer);
					MoneyLog("trade", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[targetid][pTamount][s], qwer);
					format(str,sizeof(str),"{cccccc}Деньги: {00cc00}%d$\n", PlayerInfo[targetid][pTamount][s]), strcat(sctring,str);
				}
				if(PlayerInfo[playerid][pTslot][s] == 2)
				{
					PlayerInfo[playerid][pDonateMoney] -= PlayerInfo[playerid][pTamount][s];
					PlayerInfo[targetid][pDonateMoney] += PlayerInfo[playerid][pTamount][s];

					new qwer[24];
					format(qwer,sizeof(qwer),"Сделка: Золото № %d", ServerInfo[46]);
					DonateLog("trade",PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], -PlayerInfo[playerid][pTamount][s], qwer);
					DonateLog("trade",PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playerid][pTamount][s], qwer);
					
					format(stro,sizeof(stro),"{cccccc}Золото: {ffcc00}%d грамм золота\n", PlayerInfo[playerid][pTamount][s]), strcat(sctroing,stro);
					mysql_save(playerid, 4), mysql_save(targetid, 4);
					if(PlayerInfo[targetid][pAchieve][26] == 0 && PlayerInfo[targetid][pDonateMoney] >= 10000) AchievePlayer(targetid, 26, 1);
				}
				if(PlayerInfo[targetid][pTslot][s] == 2)
				{
					PlayerInfo[targetid][pDonateMoney] -= PlayerInfo[targetid][pTamount][s];
					PlayerInfo[playerid][pDonateMoney] += PlayerInfo[targetid][pTamount][s];

					new qwer[24];
					format(qwer,sizeof(qwer),"Сделка: Золото № %d", ServerInfo[46]);
					DonateLog("trade",PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -PlayerInfo[targetid][pTamount][s], qwer);
					DonateLog("trade",PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[targetid][pTamount][s], qwer);
					
					format(str,sizeof(str),"{cccccc}Золото: {ffcc00}%d грамм золота\n", PlayerInfo[targetid][pTamount][s]), strcat(sctring,str);
					mysql_save(playerid, 4), mysql_save(targetid, 4);
					if(PlayerInfo[playerid][pAchieve][26] == 0 && PlayerInfo[playerid][pDonateMoney] >= 10000) AchievePlayer(playerid, 26, 1);
				}
				// Ставим наши тачки
				if(PlayerInfo[playerid][pTslot][s] == 4)
				{
					Insert_TradeCar(targetid, PlayerInfo[playerid][pTmodel][s]);
					PlayerInfo[playerid][pTdone][s] = 1;
					format(stro,sizeof(stro),"{cccccc}Транспорт: {ff9000}[%s]\n", GetVehicleName(VehInfo[PlayerInfo[playerid][pTmodel][s]][vModel])), strcat(sctroing,stro);
					CarLog("buycar", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], VehInfo[PlayerInfo[playerid][pTmodel][s]][vModel], ServerInfo[46], "Сделка: Транспорт");
					if(PlayerInfo[targetid][pAchieve][12] == 0) AchievePlayer(targetid, 12, 1);
				}
				if(PlayerInfo[targetid][pTslot][s] == 4)
				{
					Insert_TradeCar(playerid, PlayerInfo[targetid][pTmodel][s]);
					PlayerInfo[targetid][pTdone][s] = 1;
					format(str,sizeof(str),"{cccccc}Транспорт: {ff9000}[%s]\n", GetVehicleName(VehInfo[PlayerInfo[targetid][pTmodel][s]][vModel])), strcat(sctring,str);
					CarLog("buycar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], VehInfo[PlayerInfo[targetid][pTmodel][s]][vModel], ServerInfo[46], "Сделка: Транспорт");
					if(PlayerInfo[playerid][pAchieve][12] == 0) AchievePlayer(playerid, 12, 1);
				}
				if(PlayerInfo[playerid][pTslot][s] == 6)
				{
					new dom = PlayerInfo[playerid][pTmodel][s];
					PlayerInfo[targetid][pDom] = PlayerInfo[playerid][pTmodel][s];
					PlayerInfo[targetid][pHouserent] = 0;
					PlayerInfo[targetid][pSelectspawn] = 4;
					if(PlayerInfo[targetid][pTslot][0] != 6 && PlayerInfo[targetid][pTslot][1] != 6 && PlayerInfo[targetid][pTslot][2] != 6)
					{
						PlayerInfo[playerid][pDom] = 0, PlayerInfo[playerid][pSelectspawn] = 0;
					}
					if(PlayerInfo[targetid][pAData] > unix) DomInfo[dom][dPastime] = 0, DomInfo[dom][dData] = gettime()+2592000;
					else DomInfo[dom][dPastime] = PlayerInfo[targetid][pAbandoned], DomInfo[dom][dData] = unix+864000;
					DomInfo[dom][dSost] = PlayerInfo[targetid][pID];
					if(DomInfo[dom][dFam] >= 1) FamilyInfo[DomInfo[dom][dFam]][fDop5] = 0, SaveFamily(DomInfo[dom][dFam]), DomInfo[dom][dFam] = 0;
					DomInfo[dom][dSell] = 0;
					DomInfo[dom][dAcccupO] = 0, DomInfo[dom][dAcccupP] = 0, DomInfo[dom][dAcccupG] = 0, DomInfo[dom][dAcccupD] = 0, DomInfo[dom][dAccgar] = 0, DomInfo[dom][dAccdoo] = 0, DomInfo[dom][dAccfur] = 0;
					DomInfo[dom][dAccint] = 0, DomInfo[dom][dFamcar] = 0;
					if(DomInfo[dom][dDescrip] == 2) DomInfo[dom][dDescrip] = 0;
					if(DomInfo[dom][dIngar] >= 1) DomInfo[dom][dIngar] = 0, DestroyDynamicPickup(DomGarage[dom]), DestroyDynamic3DTextLabel(IngarLabel[dom]);
					strmid(DomInfo[dom][dVlad], PlayerInfo[targetid][pName], 0, strlen(PlayerInfo[targetid][pName]));
					SaveDom(dom);
					UpdateDom(dom);
					HouseLog(0, "selldom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], dom, ServerInfo[46], "Сделка: Продал Дом");
					HouseLog(0, "buydom", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], dom, ServerInfo[46], "Сделка: Купил Дом");
					format(stro,sizeof(stro),"{cccccc}Дом: {ff9000}№ %d\n", dom), strcat(sctroing,stro);
					mysql_save(playerid, 6), mysql_save(targetid, 6);
					if(PlayerInfo[targetid][pAchieve][10] == 0) AchievePlayer(targetid, 10, 1);
				}
				if(PlayerInfo[targetid][pTslot][s] == 6)
				{
					new dom = PlayerInfo[targetid][pTmodel][s];
