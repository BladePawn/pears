		return 1;
	}


	// Далее идут нормальные спавны

	// Спавн после смерти на раскопках могил
	if (gettime() < GravePlayerInfo[playerid][gpiNoDeath]) {
		GravePlayerInfo[playerid][gpiNoDeath] = 0;
		S_SetPlayerVirtualWorld(playerid, 0), PPSetPlayerInterior(playerid, 0);
		PPSetPlayerPos(playerid, 998.7671, -1106.4410, 23.8281);
		PPSetPlayerFacingAngle(playerid, 90.0);
		SetCameraBehindPlayer(playerid);
		TogglePlayerControllable(playerid, true);
