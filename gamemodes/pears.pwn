CMD:helpfam(playerid)
{
	new str[115],sctring[3450];
	format(str,sizeof(str),"{ffffff}Семья - {cccccc}это некая группа людей, которые занимаются определенным делом."), strcat(sctring,str);
	format(str,sizeof(str),"\nНа сервере есть несколько типов семей: Обычная, ОПГ, Партии, Cекта, Street Racers, Bikers."), strcat(sctring,str);
	format(str,sizeof(str),"\nКаждый тип имеет свой функционал, который отсутствует в другом типе, подробнее о типах семей ниже."), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{cccccc}Семья типа Обычная:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Стандартный функционал который имеют все типы семей"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Часто именно люди с одной Фамилией называются семьей и используют обычный тип семьи"), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{cccccc}Семья типа Партия:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Данный тип семьи может принимать участие в выборах в сенат"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Партия попавшая в сенат участвует в жизни штата по многим пунктам:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}Приянтие/отмена законов | Участие в голосованиях внутри правительства"), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{cccccc}Семья типа StreetRacers:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Данный тип семьи может создавать гоночные маршруты"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Организовывать сходки на которых можно устраивать гонку до 8 человек"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Оформлять партнерства с бизнесами для продвижение продаж на сходках"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Команды типа StreetRacers:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}/scp - запись чекпоинтов | /scpa - меню управления чекпоинтами"), strcat(sctring,str);
	format(str,sizeof(str),"\n\n{cccccc}Семья типа {FF6347}SEKTA{cccccc}:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Данный тип конкурирует с другими семьями такого же типа"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Проведение обрядов и получения Таблеток Защиты/Атаки"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Возможность поедать органы у людей в предсмертном состояние[ ПКМ + ALT ]"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}- Проведение эфиров с повесткой своей идеалогии[ /gnews ]"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Система влияния:"), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Влияние - {999999}является показателем насколько семья типа {FF6347}SEKTA{999999} является выше других."), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}Оно будет постоянно изменятся, т.к. оно зависит от ранга участников семьи в офф.организациях."), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}Его можно гарантированно повысить, проводя эфиры в CNN от лица Секты или же проводя обряды."), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Эфиры секты {999999}-проводится 1 раз в день, для проведения нужно угнать машину CNN."), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}Длится эфир максимум 10 минут. Чем дольше идет эфир тем больше влияния получит секта."), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Алтарь {999999}-объект у которого проводятся обряды. За разрушение алтаря другой секты"), strcat(sctring,str);
	format(str,sizeof(str),"\n{999999}можно снизить её влияние в штате. Алтари необходимо прятать и хорошо защищать."), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Обряд {999999}-проводится 1 раз в день, у Алтаря Секты, для обряда нужна жертва."), strcat(sctring,str);
	ShowDialog(playerid,2004,DIALOG_STYLE_MSGBOX,"{ff9000}Что такое семьи?",sctring,"*","");
	return 1;
}
