	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], para1, tmp, string);

		MakeleaderPlayerBridge(para1, g, nrank);
  	}
  	else if(chto == 3)
	{
		format(string, sizeof(string), "[ Server ]: %s назначен лидером %s", PlayerInfo[para1][pName], frakName[PlayerInfo[para1][pMember]]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		format(string, sizeof(string),"{ffffff}Администратор {ff6600}%s {ffffff}назначил вас лидером %s",PlayerInfo[playerid][pName], frakName[PlayerInfo[para1][pMember]]);
		ShowDialog(para1, 191, 0, "{000000}.", string, "Ок", "");
		AdminLog("makeleader", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], PlayerInfo[para1][pMember], "Назначен Лидером");
