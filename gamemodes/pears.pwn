CMD:fonar(playerid)
{
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(get_invent4(playerid, 32, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет фонарика");
	if(get_para(playerid, 32) == 1) return ErrorMessage(playerid, "{FF6347}Ваш фонарик сломан");
	if(Hold[playerid] == 1)
    {
   		RemovePlayerAttachedObject(playerid,1);
   		RemovePlayerAttachedObject(playerid,2);
    	SetPlayerChatBubble(playerid,"убирает фонарик",COLOR_PURPLE,30.0,8000);
    	ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
  		Hold[playerid] = 0;
	}
	else
 	{
 		if(Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки");
  		RemovePlayerAttachedObject(playerid,1);
  		RemovePlayerAttachedObject(playerid,2);
  		SetPlayerChatBubble(playerid,"достаёт фонарик",COLOR_PURPLE,30.0,8000);
  		Hold[playerid] = 1;
  		SetPlayerAttachedObject(playerid, 1, 18641, 6, 0.053999, 0.037999, 0.085999, -179.499877, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
  		SetPlayerAttachedObject(playerid, 2, 18656, 6, 0.030000, 0.090999, 0.043000, 91.900001, -1.800004, 0.400002, 0.083999, 0.072999, 0.090000, 0, 0);
    }
	return 1;
}
CMD:shovel(playerid)
{
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(get_invent4(playerid, 44, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет лопаты");
	if(Hold[playerid] == 6)
    {
   		RemovePlayerAttachedObject(playerid,1);
    	SetPlayerChatBubble(playerid,"убирает лопату",COLOR_PURPLE,30.0,8000);
    	ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
  		Hold[playerid] = 0;
	}
	else
	{
		if(Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки");
  		RemovePlayerAttachedObject(playerid,1);
  		SetPlayerChatBubble(playerid,"достаёт лопату",COLOR_PURPLE,30.0,8000);
  		Hold[playerid] = 6;
  		SetPlayerAttachedObject(playerid, 1, 337, 5, 0.151000, -0.039999, 0.000000, 0.000000, 0.000000, 98.700050, 1.000000, 1.000000, 1.000000, 0, 0);
    }
	return 1;
}
CMD:seamap(playerid)
{
	if(get_invent4(playerid, 45, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет карты моряка");
	if(Dei[playerid] == 3)
	{
    	SetPlayerChatBubble(playerid,"сворачивает и убирает карту моря",COLOR_PURPLE,30.0,8000);
  		Dei[playerid] = 0, PlayerPlaySound(playerid,5600,0,0,0);
  		Close_Seamap(playerid);
	}
	else
	{
		if(Dei[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки");
		if(HealthAC[playerid] <= 0 || howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
		pc_cmd_infoseamap(playerid);
  		SetPlayerChatBubble(playerid,"достаёт и разворачивает карту моря",COLOR_PURPLE,30.0,8000);
  		Dei[playerid] = 3, PlayerPlaySound(playerid,5601,0,0,0);
  		TextDrawShowForPlayer(playerid, MapDraw[0]);
		Update_Seamap(playerid);
		Update_Seachest(playerid);
		if(IsMinFish(playerid)) TextDrawShowForPlayer(playerid, MapDraw[1]);
		else if(IsBigFish(playerid)) TextDrawShowForPlayer(playerid, MapDraw[5]), TextDrawShowForPlayer(playerid, MapDraw[2]);
    }
	return 1;
}
CMD:tazer(playerid)
{
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(get_invent4(playerid, 43, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет электрошокера");
	if(get_invent4(playerid, 43, 0) <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой электрошокер разряжен");
	if(get_para(playerid, 43) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой электрошокер сломан [ Y >> GPS >> Услуги >> Техника ]");
	if(!IsPoliceMember(playerid) && PlayerInfo[playerid][pLeader] != 7 && PlayerInfo[playerid][pMember] != 7
	&& PlayerInfo[playerid][pLeader] != 4 && PlayerInfo[playerid][pMember] != 4) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не сотрудник правоохранительных органов");
	if(Hold[playerid] == 5)
    {
   		RemovePlayerAttachedObject(playerid,1);
    	SetPlayerChatBubble(playerid,"убирает электрошокер",COLOR_PURPLE,30.0,8000);
    	ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
  		Hold[playerid] = 0;
	}
	else
	{
		if(Hold[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня заняты руки..");
  		RemovePlayerAttachedObject(playerid,1);
  		SetPlayerChatBubble(playerid,"достаёт электрошокер",COLOR_PURPLE,30.0,8000);
  		Hold[playerid] = 5;
  		SetPVarInt(playerid, "HideTazer",get_invent4(playerid, 43, 0));
  		SetPlayerAttachedObject(playerid, 1, 18642, 5, 0.091000, 0.026000, -0.056999, 0.000000, 0.000000, 16.500000, 1.000000, 1.000000, 1.000000, 0, 0);
  		new string[144];
    	if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "[ Мысли ]: Я взял в руки электрошокер {ffcc00}[ Зарядов: %d ]", GetPVarInt(playerid, "HideTazer")-1);
    	else format(string, sizeof(string), "[ Мысли ]: Я взяла в руки электрошокер {ffcc00}[ Зарядов: %d ]", GetPVarInt(playerid, "HideTazer")-1);
		SendClientMessage(playerid, COLOR_GREY, string);
    }
	return 1;
}

