				new getQuan, getLimit;
				i_limit(playerid, 8, getQuan, getLimit);
				if(getQuan+1 > getLimit) return ErrorMessage(playerid,"{ff6347}Для этого предмета нет места в инвентаре"); // Если нет места
				new put_inva = GiveThingPlayer(playerid, 8, 0, 0, 0, 0, 0, 9999); // Выдаём предмет
				if(put_inva == -1) return ErrorMessage(playerid,"{ff6347} Нет места в инвентаре. Освободите слот.");
				oGivePlayerMoney(playerid, -friskPrice[8]);
				MoneyLog("buy", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -friskPrice[8], "Купил аптечку");
