	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}
stock obrazovatel_centr(playerid)
{
    if(PlayerInfo[playerid][pStopoc] > gettime()) return ErrorMessage(playerid, "{FF6347}Вы недавно обучались в образовательном цетре [ Доступно 1 раз в час /time ]");
    new line[160],lines[2080];

	format(line,sizeof(line),"{cccccc}Услуга \t Стоимость"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Водительские Права \t {99ff66}%d$ [%s]",friskPrice[156], get_k(friskPrice[156])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Лицензия Пилота \t {99ff66}%d$ [%s]",friskPrice[157], get_k(friskPrice[157])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Лицензия Водного Транспорта \t {99ff66}%d$ [%s]",friskPrice[158], get_k(friskPrice[158])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Лицензия Мототранспорта \t {99ff66}%d$ [%s]",friskPrice[159], get_k(friskPrice[159])), strcat(lines,line);
	format(line,sizeof(line),"\n{ff9000}Высшее Образование \t {99ff66}%d$ [%s]",friskPrice[160], get_k(friskPrice[160])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Изучение Русского Языка \t {99ff66}%d$ [%s]", Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Изучение Японского Языка \t {99ff66}%d$ [%s]", Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Изучение Итальянского Языка \t {99ff66}%d$ [%s]", Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Изучение Китайского Языка \t {99ff66}%d$ [%s]", Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Изучение Испанского Языка \t {99ff66}%d$ [%s]", Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Изучение Арабского Языка \t {99ff66}%d$ [%s]", Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	format(line,sizeof(line),"\n{FF6347}Отменить обучение"), strcat(lines,line);
	ShowDialog(playerid,1214,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Образовательный Центр",lines,"Выбор","Отмена");
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}
CMD:expduty(playerid, const params[])
{
	if(PlayerInfo[playerid][pExpert] >= 1)
	{
		if(PlayerInfo[playerid][pExchat] == 1)
		{
			if (KtoKomy[playerid] != 9999) {
				ErrorMessage(playerid, "{FF6347}Вы не можете завершить дежурство до того, как закроете обращение игрока");
				return 0;
			}
			
			PlayerInfo[playerid][pExchat] = 0;
			SendClientMessage(playerid, COLOR_GREY, "{66ffcc}[ Expert ]: {cccccc}Дежурство завершено!");
		}
		else
		{
			PlayerInfo[playerid][pExchat] = 1;
 			SendClientMessage(playerid, COLOR_GREY, "{66ffcc}[ Expert ]: {cccccc}Дежурство активировано! {0088ff}[ /rt - список вопросов ]");
	 		PlayerPlaySound(playerid,6401,0,0,0);
		}
	}
	return 1;
}

alias:expert("exp")
CMD:expert(playerid, const params[])
{
	if(PlayerInfo[playerid][pExpert] >= 1)
	{
		PlayerPlaySound(playerid,40405,0,0,0);
       	new str[100],sctring[400];
       	format(str,sizeof(str),"{cccccc}Информация\n");
    	strcat(sctring,str);
    	if(PlayerInfo[playerid][pExchat] >= 1)format(str,sizeof(str),"{cccccc}Дежурство {00cc00}[ On ]\n"), strcat(sctring,str);
    	else format(str,sizeof(str),"{cccccc}Дежурство {ff0000}[ Off ]\n"), strcat(sctring,str);
    	ShowDialog(playerid,854,DIALOG_STYLE_LIST,"{0088ff}Меню Эксперта",sctring,"Выбор","Отмена");
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не эксперт");
	return 1;
}

CMD:mind(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Текст в мыслях [ /mind Текст ]");
	if(strlen(params[0]) <= 0 || strlen(params[0]) >= 18) return ErrorMessage(playerid, "{FF6347}Текст не меньше 1 символа и не больше 20");

    create_mind_object(playerid, params[0]);
    return 1;
}

alias:an("ot", "otv", "otvet")
CMD:an(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pExpert] >= 1)
	{
		if(sscanf(params, "is[121]", params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ответить игроку /otv id текст");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу ответить себе");
		if(KtoKomy[playerid] != params[0] && PlayerInfo[playerid][pSoska] <= 9) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Необходимо открыть обращение {ff0000}[ /reports(/rt) или /re ]");
		
		if(checksimvol(params[1])) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		new string[144];
		if(PlayerInfo[playerid][pSoska] == 1)
		{
			format(string, sizeof(string), "{00ffff}Хелпер {ffcc00}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[1]);
			SendClientMessage(params[0], COLOR_GREY, string);
			format(string, sizeof(string), "{ffcc00}Хелпер ЛС к %s[%d]{cccccc}: %s",PlayerInfo[params[0]][pName], params[0], params[1]);
			SendClientMessage(playerid, COLOR_GREY, string);
			foreach (Player, admin)
			{
				if(GetPVarInt(admin, "adminreadan") == 1)
				{
					format(string,sizeof(string),"{ffffff}%s >> %s: {ffcc00}%s",PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName],params[1]);
					SendClientMessage(admin,COLOR_GREY,string);//Отсылаем уведомление админам
				}
			}
		}
		else if(PlayerInfo[playerid][pSoska] >= 2)
		{
			format(string, sizeof(string), "{ff9000}Администратор {ffcc00}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[1]);
			SendClientMessage(params[0], COLOR_GREY, string);
			format(string, sizeof(string), "{ffcc00}Админ ЛС к %s[%d]{cccccc}: %s",PlayerInfo[params[0]][pName], params[0], params[1]);
			SendClientMessage(playerid, COLOR_GREY, string);
			foreach (Player, admin)
			{
				if(GetPVarInt(admin, "adminreadan") == 1)
				{
					format(string,sizeof(string),"{ffffff}%s >> %s: {ffcc00}%s",PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName],params[1]);
					SendClientMessage(admin,COLOR_GREY,string);//Отсылаем уведомление админам
				}
			}
		}
		else if(PlayerInfo[playerid][pExpert] >= 1)
		{
			format(string, sizeof(string), "{66ffcc}Эксперт {ffcc00}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[1]);
			SendClientMessage(params[0], COLOR_GREY, string);
			format(string, sizeof(string), "{ffcc00}Expert ЛС к %s[%d]{cccccc}: %s",PlayerInfo[params[0]][pName], params[0], params[1]);
			SendClientMessage(playerid, COLOR_GREY, string);
			foreach (Player, admin)
			{
				if(GetPVarInt(admin, "exread") == 1)
				{
					format(string,sizeof(string),"{ffffff}%s >> %s: {ffcc00}%s",PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName],params[1]);
					SendClientMessage(admin,COLOR_GREY,string);//Отсылаем уведомление админам
				}
			}
		}
		if(PlayerInfo[playerid][pSoska] >= 1) work_admin(playerid, 6);
		SupportLog(PlayerInfo[params[0]][pSupport], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], params[1]);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	return 1;
}
CMD:re(playerid, const params[])
{
	  new para1,string[256];
      if (!sscanf(params, "u", para1))
	  {
		if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pExpert] >= 1)
		{
			if(IsOnline(para1))
            {
				if(PlayerInfo[para1][pReportStat] >= 1)
				{
					if(KtoKomy[para1] != 9999) return format(string,sizeof(string),"{FF6347}С этим игроком уже связался %s[%d]",PlayerInfo[KtoKomy[para1]][pName], KtoKomy[para1]), ErrorMessage(playerid, string);
					if(PlayerInfo[playerid][pSoska] >= 1)
					{
						if(PlayerInfo[playerid][pSoska]==1) format(string, sizeof(string), " [ ADM ]: Хелпер %s открывает обращение %s[%d] {cccccc}[ /messoff ]", PlayerInfo[playerid][pName],PlayerInfo[para1][pName], para1);
						else format(string, sizeof(string), " [ ADM ]: Админ %s открывает обращение %s[%d] {cccccc}[ /messoff ]", PlayerInfo[playerid][pName],PlayerInfo[para1][pName], para1);
		   				MessCast(COLOR_ADM,string,1);
  					}
  					else if(PlayerInfo[playerid][pExpert] >= 1)
  					{
  						if(PlayerInfo[playerid][pExchat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не активировано дежурство [ /exp ]");
  						if(PlayerInfo[para1][pReportStat] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу отвечать только на вопросы..");
  						if(para1 == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу отвечать на собственное обращение");
  						format(string, sizeof(string), " [ Expert ]: %s открывает обращение %s[%d] {cccccc}[ /exp ]", PlayerInfo[playerid][pName],PlayerInfo[para1][pName], para1);
  						ExpertCast(COLOR_ADM, string);
  					}
		   			// Объяснение для админа
		   			SendClientMessage(playerid, COLOR_GREY, "{FFFFFF}Отвечайте игроку с помощью команд: {ff9000}/an /ot /otv /otvet");
		   			SendClientMessage(playerid, COLOR_GREY, " ");
      				format(string, sizeof(string), "{cccccc}Игрок: {0088ff}%s{ffffff}[%d]",PlayerInfo[para1][pName], para1);
      				SendClientMessage(playerid, COLOR_GREY, string);
      				format(string, sizeof(string), "{cccccc}Обращение: {FF6347}%s",PlayerInfo[para1][pReport]);
      				SendClientMessage(playerid, COLOR_GREY, string);
      				SendClientMessage(playerid, COLOR_GREY, " ");
      				format(string, sizeof(string), "{FFFFFF}По завершению, закройте его обращение: {ffcc00}/com %d",para1);
      				SendClientMessage(playerid, COLOR_GREY, string);
      				PlayerPlaySound(playerid,21000,0,0,0); // 001 завершить

      				KtoKomy[playerid] = para1; // Отвечаем Игроку
      				KtoKomy[para1] = playerid; // Игроку Отвечают
      				if(PlayerInfo[playerid][pSoska] >= 1) work_admin(playerid, 7);
  				}
   				else ErrorMessage(playerid, "{FF6347}Обращение игрока обработано или он не обращался");
   			}
   			else ErrorMessage(playerid, "{FF6347}Этот игрок отключился от сервера");
		}
	  }
	  else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Открыть обращение игрока [ /re ID ]");
	  return 1;
}

alias:com("cpm", "cim")
CMD:com(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pExpert] >= 1)
	{
	 	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Закрыть обращение игрока [ /com ID ]");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		if(PlayerInfo[params[0]][pReportStat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не создавал обращение или его запрос закрыт");
		if(PlayerInfo[playerid][pSoska] <= 7 && KtoKomy[params[0]] != playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чтобы закрыть обращение, мне нужно на него ответить");
		if(PlayerInfo[params[0]][pReportStat] != 2 && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу закрывать только вопросы");
		if(OnlineInfo[params[0]][oLogged] == 1)
	 	{
	 		new string[144];
	 		if(PlayerInfo[playerid][pSoska] >= 1)
	 		{
		 		if(PlayerInfo[params[0]][pReportStat] == 1)
		 		{
					if(PlayerInfo[playerid][pSoska] == 1) format(string, sizeof(string), "{FF0000}[!] {FF6347}Ваша жалоба закрыта хелпером %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
					else format(string, sizeof(string), "{FF0000}[!] {FF6347}Ваша жалоба закрыта администратором %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
				}
				else if(PlayerInfo[params[0]][pReportStat] == 2)
		 		{
					if(PlayerInfo[playerid][pSoska] == 1) format(string, sizeof(string), "{FF0000}[!] {33CCFF}Ваш вопрос закрыт хелпером %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
					else format(string, sizeof(string), "{FF0000}[!] {33CCFF}Ваш вопрос закрыт администратором %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
				}
				else if(PlayerInfo[params[0]][pReportStat] == 3)
		 		{
					if(PlayerInfo[playerid][pSoska] == 1) format(string, sizeof(string), "{FF0000}[!] {ffcc66}Ваша просьба закрыта хелпером %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
					else format(string, sizeof(string), "{FF0000}[!] {ffcc66}Ваша просьба закрыта администратором %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
				}
			}
			else if(PlayerInfo[playerid][pExpert] >= 1)
	 		{
	 			if(PlayerInfo[playerid][pExchat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не активировано дежурство [ /exp ]");
		 		if(PlayerInfo[params[0]][pReportStat] == 1) format(string, sizeof(string), "{FF0000}[!] {FF6347}Ваша жалоба закрыта экспертом %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
				else if(PlayerInfo[params[0]][pReportStat] == 2) format(string, sizeof(string), "{FF0000}[!] {33CCFF}Ваш вопрос закрыт экспертом %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
				else if(PlayerInfo[params[0]][pReportStat] == 3) format(string, sizeof(string), "{FF0000}[!] {ffcc66}Ваша просьба закрыта экспертом %s [ Оценить: /assess ]", PlayerInfo[playerid][pName]);
				PlayerInfo[playerid][pQuestion] ++;
			}
			SendClientMessage(params[0], COLOR_LIGHTRED, string);
		}
		AdminLog("com", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
		PlayerInfo[params[0]][pAssess] = PlayerInfo[playerid][pID];
		PlayerInfo[params[0]][pReportStat] = 0;
		PlayerPlaySound(playerid,21001,0,0,0);
		if(KtoKomy[playerid] == KtoKomy[params[0]]) KtoKomy[playerid] = 9999;
		KtoKomy[params[0]] = 9999;
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обращение от игрока {ff0000}закрыто");
		if(PlayerInfo[playerid][pSoska] >= 1) work_admin(playerid, 8);
		new vremya = Reptick[params[0]];
		Reptick[params[0]] = gettime()-vremya; // Через сколько ему ответили и закрыли его обращение
		update_admpoint(playerid, ServerInfo[25]);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
 	return 1;
}

alias:reroute("rr")
CMD:reroute(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pExpert] >= 1)
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Перенаправить обращение игрока [ /reroute ID ]");
		if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
		if(PlayerInfo[params[0]][pReportStat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обращение игрока обработано или он не обращался");
		new string[144];
		if(KtoKomy[params[0]] != 9999) return format(string,sizeof(string),"[ Мысли ]: С этим игроком уже связался [ {ff9000}%s {cccccc}]",PlayerInfo[KtoKomy[params[0]]][pName]), SendClientMessage(playerid,COLOR_GREY,string);
		if(PlayerInfo[playerid][pSoska] >= 1)
		{
			if(PlayerInfo[params[0]][pReportStat] == 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обращение уже находится у экспертов");
			if(PlayerInfo[playerid][pSoska]==1) format(string, sizeof(string), " [ ADM ]: Хелпер %s перенаправляет обращение %s[%d] {cccccc}[ /messoff ]", PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName], params[0]);
			else format(string, sizeof(string), " [ ADM ]: Админ %s перенаправляет обращение %s[%d] {cccccc}[ /messoff ]", PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName], params[0]);
			MessCast(COLOR_ADM,string,1);
			PlayerInfo[params[0]][pReportStat] = 2;
			format(string, sizeof(string), "{0088ff}[Перенаправлен Вопрос] {33CCFF}%s[%d]: %s", PlayerInfo[params[0]][pName], params[0], PlayerInfo[params[0]][pReport]);
			ExpertCast(COLOR_LIGHTBLUE,string);
		}
		else if(PlayerInfo[playerid][pExpert] >= 1)
		{
			if(PlayerInfo[playerid][pExchat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не активировано дежурство [ /exp ]");
			if(PlayerInfo[params[0]][pReportStat] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обращение уже находится у администрации");
			format(string, sizeof(string), " [ Expert ]: %s перенаправляет обращение %s[%d] {cccccc}[ /exp ]", PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName], params[0]);
			ExpertCast(COLOR_ADM, string);
			PlayerInfo[params[0]][pReportStat] = 1;
			format(string, sizeof(string), "{FF0000}[Перенаправлена Жалоба] {FF6347}%s[%d]: %s", PlayerInfo[params[0]][pName], params[0], PlayerInfo[params[0]][pReport]);
			ABroadCast(COLOR_ADM,string,1);
		}

		if(KtoKomy[playerid] == KtoKomy[params[0]]) KtoKomy[playerid] = 9999;
		KtoKomy[params[0]] = 9999;
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	return 1;
}
CMD:assess(playerid, const params[])
{
	if(PlayerInfo[playerid][pAssess] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне сейчас не помогали и я не могу дать оценку");
	if(PlayerInfo[playerid][pAssess] == PlayerInfo[playerid][pID]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу оценивать свою помощь");
	foreach (Player, i)
	{
		if(IsOnline(i))
		{
			if(PlayerInfo[playerid][pAssess] == PlayerInfo[i][pID] && OnlineInfo[i][oLogged] == 1)
			{
				Leadset[playerid] = i;
				PlayerPlaySound(playerid,40405,0,0,0);
				new lol[70];
     			format(lol,sizeof(lol),"{ff9000}Рейтинг {0088ff}%s [%d]",PlayerInfo[i][pName],PlayerInfo[i][pAmmos6]);
    			ShowDialog(playerid,530,DIALOG_STYLE_LIST,lol,"{ffffff}Оцените помощь\n{00cc00}Отлично\n{99ff00}Хорошо\n{ffcc00}Нормально\n{ff6600}Плохо\n{ff0000}Ужасно","Выбор","Отмена");
			    return 1;
			}
		}
	}
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок, который мне помог, сейчас не на месте..");
	return 1;
}
CMD:sm(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 22)
	{
		new milo[64],result[84];
	    if(sscanf(params, "s[64]s[84]", milo,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отправить Email [ /sm Email текст ]");
		if(strlen(milo) > 5 && strfind(milo, "@", true) != -1 && strfind(milo, ".", true) != -1)
		{
			if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");

			new string[144];
			format(string, sizeof(string), "%s", result);
			SendMail(milo, "Администрация", string, " ");

			SendClientMessage(playerid,COLOR_WHITE, "{ffffff}* Отправлено [ %s ] от {0088ff}%s{ffffff}. Текст: {0088ff}%s", milo, PlayerInfo[playerid][pName], result);
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отправить Email [ /sm Email текст ]");
	}
	return 1;
}
forward Call_newnum(playerid, numar);
public Call_newnum(playerid, numar)
{
	if(get_invent4(playerid, 26, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	SetPVarInt(playerid,"antiflood",5);
	new rows;
	cache_get_row_count(rows);
	if(rows) // Номер Такой Есть
	{
		new string[144];
  		format(string,sizeof(string),"{cccccc}Смена Номера Телефона\n{ff9000}Этот номер телефона уже занят!\n\n{ff0000}%d",numar);
 	  	ShowDialog(playerid,589,DIALOG_STYLE_INPUT,"{cccccc}Меню {ff9000}Donate",string,"Принять","Отмена");
  		return 1;
	}
	else // Номер Свободен
    {
		if(PlayerInfo[playerid][pDonateMoney] >= donatePrice[5])
		{
  			PlayerInfo[playerid][pDrugPerk] = numar;
  			new str[256],sctring[300];
	    	PlayerInfo[playerid][pDonateMoney] -= donatePrice[5];
     		format(str,sizeof(str),"{cccccc}Отлично! Вы сменили номер телефона [ /stats ]\n");
      		strcat(sctring,str);
       		format(str,sizeof(str),"{d6bd5a}Стоимость:  {ffcc00}%d G\n",donatePrice[5]);
        	strcat(sctring,str);
        	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{cccccc}Меню {ff9000}Donate",sctring,"Ок","");
        	PlayerPlaySound(playerid,40405,0,0,0);
        	new string_mysql[150];
        	mysql_format(pearsq, string_mysql, sizeof(string_mysql),"UPDATE `pp_igroki` SET `DonateMoney` = '%d',`DrugPerk` = '%d' WHERE `Name` = '%e'",PlayerInfo[playerid][pDonateMoney],PlayerInfo[playerid][pDrugPerk],PlayerInfo[playerid][pName]);
			query_empty(pearsq, string_mysql);
         	DonateLog("newnum", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -donatePrice[5], "Новый номер телефона");
         	if(PlayerInfo[playerid][pAchieve][117] == 0) AchievePlayer(playerid, 117, 1);
			return 1;
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает золота");
    }
	return true;
}
forward Call_checkmail(playerid, const str_input[]);
public Call_checkmail(playerid, const str_input[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
    	PlayerPlaySound(playerid,4203,0,0,0);
		ShowDialog(playerid,7,DIALOG_STYLE_INPUT,"{ff9000}Email","{cccccc}Введите {ff9000}Email{cccccc}, который хотите привязать к аккаунту\n{FF6347}Этот Email уже занят","Принять","Выход");
     	return 1;
	}
	else
    {
		format(PlayerInfo[playerid][pMail], 84, str_input);
        PlayerInfo[playerid][pMailStat] = 10000+random(80000);
        a_flood[1][playerid] = gettime()+60;
        new string_mysql[220];
        mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_igroki` SET `Mail`='%e',`MailStat`='%d' WHERE `user_id`='%d'",PlayerInfo[playerid][pMail], PlayerInfo[playerid][pMailStat],PlayerInfo[playerid][pID]);
       	query_empty(pearsq, string_mysql);

		new string[200];
		format(string, sizeof(string), "Никнейм: %s | Код подтверждения: %d", PlayerInfo[playerid][pName], PlayerInfo[playerid][pMailStat]);
		SendMail(PlayerInfo[playerid][pMail], "Подтверждение Почты", string, PlayerInfo[playerid][pName]);

	    format(string,sizeof(string),"{99ff66}Код подтверждения отправлен на Email: {ff9000}%s\n\nСвернуть Игру {0088ff}[ ALT + TAB или Win ]\n{444444}Если вы не нашли письмо, проверьте СПАМ",PlayerInfo[playerid][pMail]);
	    ShowDialog(playerid,11,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
    }
	return true;
}
function Call_findreferal(playerid, const str_name[])
{
	new rows, str[100],sctring[600];
	cache_get_row_count(rows);
	if(rows)
	{
	    format(PlayerInfo[playerid][pReferal], 24, str_name);
		cache_get_value_name_int(0, "user_id", PlayerInfo[playerid][pReferalID]);
		registerhelp(playerid, 3);
	}
	else
	{
		PlayerPlaySound(playerid,4203,0,0,0);
	    format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Email: %s", PlayerInfo[playerid][pMail]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Реферал: {FF6347}Введите никнейм [ %s - такого игрока не существует ]", str_name), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Сделайте подарок другу и введите его никнейм"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Ваш друг получит подарочки благодаря вам {0088ff}:)"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
	 	ShowDialog(playerid,5,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
	}
	return 1;
}
function Call_givereferal(playerid, str_id)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datad3[24], datad4, datad5, string[144], playa, f_str[184], onl;
	    cache_get_value_name(0, "Name", datad3, 24);
	    playa = ReturnUser(datad3, 1);
		if(PlayerInfo[playerid][pLevel] == 5)
		{
			cache_get_value_name_int(0, "Ref5", datad4);
			cache_get_value_name_int(0, "Money", datad5);
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Ref5`='%d',`Money`='%d' WHERE `user_id` = '%d'",datad4+1,datad5+REFERAL_PAY,str_id);
			query_empty(pearsq, f_str);
  			format(string, sizeof(string), "** Благодаря вам {ff9000}%s {cccccc}получил {99ff66}%d$. {cccccc}Спасибо за то, что играете с нами {ff66ff};*", datad3, REFERAL_PAY);
			SendClientMessage(playerid, COLOR_GREY, string);
			if(IsOnline(playa))
			{
				PlayerInfo[playa][pMoney] += REFERAL_PAY;
				PlayerInfo[playa][pRef5] += 1;
				if(OnlineInfo[playa][oLogged] == 1)
      			{
      				format(string, sizeof(string), "** %s[%d] [ {0088ff}Получил %d уровень {cccccc}| Вам начислено: {99ff66}%d$ ] {ff9000}Спасибо за нового игрока :*", PlayerInfo[playerid][pName], playerid, PlayerInfo[playerid][pLevel], REFERAL_PAY);
					SendClientMessage(playa, COLOR_GREY, string), onl = 1;
      			}
			}
			if(onl == 0) MoneyLog("referal", str_id, datad3, "", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], REFERAL_PAY, "5 Level");
			else MoneyLog("referal", str_id, datad3, PlayerInfo[playa][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], REFERAL_PAY, "5 Level");
		}
	}
	return 1;
}
forward Call_checkmailtwo(playerid, const str_input[]);
public Call_checkmailtwo(playerid, const str_input[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    PlayerPlaySound(playerid,4203,0,0,0);
		new str[78],sctring[296];
		format(str,sizeof(str),"\n{cccccc}Логин: %s",PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Email: {FF6347}Введите ваш Email [ Этот Email уже используется ]"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{cccccc}Количество символов: от 5 до 80"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
	 	ShowDialog(playerid,4,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Выход");
		return 1;
	}
	else
    {
        format(PlayerInfo[playerid][pMail], 84, str_input);
        PlayerInfo[playerid][pMailStat] = 10000+random(80000);
        registerhelp(playerid, 2);
    }
	return true;
}
stock registerhelp(playerid, stat)
{
    new str[100],sctring[600];
	if(stat == 0) // Пароль
	{
	    PlayerPlaySound(playerid,17803,0,0,0);
		format(str,sizeof(str),"\n{cccccc}Привет, {ff9000}%s", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Пароль: {99ff66}Введите ваш будущий Пароль"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Содержание пароля: Буквы, цифры и символы"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Количество символов: от 10 до 40"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ff9000}Скрыть пароль: Отмена >> Ввод пароля\n"), strcat(sctring,str);
		if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,2,DIALOG_STYLE_PASSWORD,"{ff9000}Регистрация",sctring,"Далее","Отмена");
		else ShowDialog(playerid,2,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
	}
	else if(stat == 1) // Email
	{
	    PlayerPlaySound(playerid,17803,0,0,0);
		format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Email: {99ff66}Введите ваш Email"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{cccccc}Количество символов: от 5 до 80"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
	 	ShowDialog(playerid,4,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
 	}
 	else if(stat == 2) // Реферал
	{
	    PlayerPlaySound(playerid,17803,0,0,0);
		format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Email: %s", PlayerInfo[playerid][pMail]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Реферал: {99ff66}Введите никнейм"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Сделайте подарок другу и введите его никнейм"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Ваш друг получит подарочки благодаря вам {0088ff}:)"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
	 	ShowDialog(playerid,5,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
 	}
 	else if(stat == 3) // Промокод
	{
	    PlayerPlaySound(playerid,17803,0,0,0);
		format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Email: %s", PlayerInfo[playerid][pMail]), strcat(sctring,str);
		if(PlayerInfo[playerid][pReferalID] >= 1) format(str,sizeof(str),"\n{cccccc}Реферал: %s",PlayerInfo[playerid][pReferal]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Реферал: нет"), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Промокод: {99ff66}Введите промокод"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Сделайте себе подарок и введите промокод"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Не переживайте, если не знаете ни одного промокода"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}В игре всегда появляются новые, с интересными подарками"), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
	 	ShowDialog(playerid,6,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
 	}
	else if(stat == 4) // Выбор Города
	{
		PlayerPlaySound(playerid,17803,0,0,0);
		new line[60],lines[180];
		format(line,sizeof(line),"{ff9000}Выберите город, в котором начнётся ваша история"), strcat(lines,line);
		if(CitySelectRegistr == 0) // Периодично меняем пункты в выборе, чтобы игроки не выбирали всегда на автомате LS
		{
			DP[0][playerid] = 0;
			DP[1][playerid] = 2;
			format(line,sizeof(line),"\n{cccccc}Los Santos"), strcat(lines,line);
			format(line,sizeof(line),"\n{cccccc}Las Venturas"), strcat(lines,line);
		}
		else if(CitySelectRegistr == 1)
		{
			DP[0][playerid] = 2;
			DP[1][playerid] = 0;
			format(line,sizeof(line),"\n{cccccc}Las Venturas"), strcat(lines,line);
			format(line,sizeof(line),"\n{cccccc}Los Santos"), strcat(lines,line);
		}
		ShowDialog(playerid,3,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Регистрация",lines,"Далее","Отмена");
	}
	return 1;
}
forward Call_vzlom(playerid, const str_name[]);
public Call_vzlom(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		  new user_id,datad1,datad2[64],datad4;
		  cache_get_value_name_int(0, "user_id", user_id);
	      cache_get_value_name_int(0, "Soska", datad1);
          cache_get_value_name(0, "Mail", datad2, 128);
          cache_get_value_name_int(0, "MailStat", datad4);
          if(!strcmp(datad2,"\0",true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Email");
          if(datad4 > 0 && serverType > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не подтверждён Email");
		  if(datad1 >= PlayerInfo[playerid][pSoska] 
		  	&& serverType > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу заблокировать аккаунт админа своего уровня или выше");

		  new temp_password[120];
		  format(temp_password, sizeof(temp_password), "%s", CreatePassword());
		  bcrypt_hash(playerid, "OnPasswordHashVzlomOffline", temp_password, BCRYPT_COST, "ssds", str_name, temp_password, user_id, datad2);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
forward Call_delmail(playerid, const str_name[]);
public Call_delmail(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new f_str[160], datadid;
 		cache_get_value_name_int(0, "user_id", datadid);
   		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Mail`='',`MailStat`='0' WHERE `user_id`='%d'",datadid);
		query_empty(pearsq, f_str);
	    format(f_str, sizeof(f_str), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку %s отключён Email",str_name);
	    SendClientMessage(playerid, COLOR_WHITE, f_str);
	    AdminLog("delmail", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, "Email отключён");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:delmail(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new giveplayerid,tmp[24],string[144],f_str[144];
	if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отключить Email на аккаунте [ /delmail ID ]");
 	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [Не залогинился]");
	    if(!strcmp(PlayerInfo[giveplayerid][pMail],"\0",true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Email");
	    if(PlayerInfo[giveplayerid][pSoska] >= 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу сбросить Email администратору высокого уровня");
	    format(PlayerInfo[giveplayerid][pMail], 128, "\0");
	    PlayerInfo[giveplayerid][pMailStat] = 0;
	    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Mail`='',`MailStat`='0' WHERE `user_id`='%d'", PlayerInfo[giveplayerid][pID]);
		query_empty(pearsq, f_str);
    	ShowDialog(giveplayerid,1600,DIALOG_STYLE_MSGBOX,"{FF9000}Email","{0088ff}*{FFFFFF}Почта Отключена!\n\nАдминистрация отключила Email с вашего аккаунта. {ff9000}[ Y >> Меню >> Аккаунт | или /mm ]","Ок","");
    	format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку %s отключён Email",PlayerInfo[giveplayerid][pName]);
    	SendClientMessage(playerid, COLOR_WHITE, string);
	    PlayerPlaySound(giveplayerid,6401,0,0,0);
	    AdminLog("delmail", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: /delmail Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_delmail", "ds", playerid, tmp);
		return 1;
	}
	return 1;
}
forward Call_delgoogle(playerid, const str_name[]);
public Call_delgoogle(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datad3, datadid,string[144],f_str[144];
 		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Google", datad1);
		cache_get_value_name_int(0, "Soska", datad2);
		cache_get_value_name_int(0, "Expert", datad3);
		if(datad1 == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
		if(datad2 >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу отключить Google Authenticator администратору");
  		if(datad3 >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу отключить Google Authenticator эксперту");
   		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Gokey` = '0',`Google` = '0' WHERE `Name` = '%e'",str_name);
    	query_empty(pearsq, f_str);
	    format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку %s отключён Google Authenticator",str_name);
	    SendClientMessage(playerid, COLOR_WHITE, string);
	    AdminLog("delgoogle", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, "Google отключён");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:delgoogle(playerid, const params[])
{
	new giveplayerid,tmp[24],string[144],f_str[144];
	if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отключить Google Authenticator на аккаунте [ /delgoogle ID ]");
 	giveplayerid = ReturnUser(tmp, 1);
	if(PlayerInfo[playerid][pSoska] >= 20)
	{
 		if(IsOnline(giveplayerid))
   		{
    		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "   Игрок не залогинился!!!");
		    if(PlayerInfo[giveplayerid][pGoogle] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
		    if(PlayerInfo[giveplayerid][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу отключить Google Authenticator администратору");
		    if(PlayerInfo[giveplayerid][pExpert] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу отключить Google Authenticator эксперту");
		    PlayerInfo[giveplayerid][pGoogle] = 0;
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Gokey` = '0',`Google` = '0' WHERE `Name` = '%e'", PlayerInfo[giveplayerid][pName]);
		    query_empty(pearsq, f_str);
 	    	ShowDialog(giveplayerid,1600,DIALOG_STYLE_MSGBOX,"{cccccc}Google {FF9000}Authenticator","{0088ff}*{FFFFFF}Google Authenticator Отключен!\n\nАдминистрация отключила Google Authenticator с вашего аккаунта. {ff9000}[ /mm >> Аккаунт Аккаунта ]","Ок","");
  	    	format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку %s отключён Google Authenticator",PlayerInfo[giveplayerid][pName]);
   	    	SendClientMessage(playerid, COLOR_WHITE, string);
    	    PlayerPlaySound(giveplayerid,6401,0,0,0);
    	    AdminLog("delgoogle", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "");
		}
		else
		{
  			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: /delgoogle Lol_Lolkin");
  			mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Google, Soska, Expert FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  			mysql_tquery(pearsq, string, "Call_delgoogle", "ds", playerid, tmp);
  			return 1;
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
CMD:vzlom(playerid, const params[])
{
    new giveplayerid,tmp[24];
	if (!sscanf(params, "s[24]", tmp))
	{
        giveplayerid = ReturnUser(tmp, 1);
		if(PlayerInfo[playerid][pSoska] >= 2)
		{
		    if(IsOnline(giveplayerid))
		    {
			    if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "   Игрок не залогинился!!!");
			    if(!strcmp(PlayerInfo[giveplayerid][pMail],"\0",true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Email");
			    if(PlayerInfo[giveplayerid][pMailStat] > 0 
					&& serverType > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не подтвердил Email после регистрации");
			    if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska] 
					&& serverType > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу заблокировать аккаунт админа своего уровня или выше");
			    
				// Антипидор
				if(AntiPidor(playerid, 11)) return 1;

				new temp_password[120];
		  		format(temp_password, sizeof(temp_password), "%s", CreatePassword());
		  		bcrypt_hash(playerid, "OnPasswordHashVzlom", temp_password, BCRYPT_COST, "sd", temp_password, giveplayerid);
			}
			else
			{
			   if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: /vzlom Lol_Lolkin");
			   new string[180];
			   mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Mail, MailStat FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
               mysql_tquery(pearsq, string, "Call_vzlom", "ds", playerid, tmp);
               return 1;
			}
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заблокировать взломаный аккаунт [ /vzlom ID ]");
	return 1;
}
//----------------------------------[Wisper]-----------------------------------------------
stock read_sms(playerid, const resip[], recipid, const text[], stat)
{
	new string[144];
	foreach(Player,i)
	{
		if(OnlineInfo[i][oLogged] == 0) continue;
		if(GetPVarInt(i, "readw1") == 7777 || GetPVarInt(i, "readw1") == playerid || GetPVarInt(i, "readw1") == recipid)
		{
			if(stat == 0) format(string,sizeof(string),"%s[%d] >> %s[%d]: %s",PlayerInfo[playerid][pName], playerid, resip, recipid, text), SendClientMessage(i,COLOR_YELLOW2,string);
			else format(string,sizeof(string),"%s[%d] >> %s: %s",PlayerInfo[playerid][pName], playerid, resip, text), SendClientMessage(i,COLOR_YELLOW2,string);
		}
		if(GetPVarInt(i, "komp") == 9999 || GetPVarInt(i, "komp") == playerid || GetPVarInt(i, "komp") == recipid)
		{
			if(stat == 0) format(string,sizeof(string),"%s[%d] >> %s[%d]: %s",PlayerInfo[playerid][pName], playerid, rpplayername(recipid), recipid, text), SendClientMessage(i,COLOR_YELLOW2,string);
			else format(string,sizeof(string),"%s[%d] >> %s: %s",PlayerInfo[playerid][pName], playerid, resip, text), SendClientMessage(i,COLOR_YELLOW2,string);
		}
	}
	return 1;
}
function Call_yessend(playerid, unix, datad, const resip[], const text[])
{
	new rows, yes = 0, black_list[MAX_FRIENDS], string[364];
	cache_get_row_count(rows);
	if(rows)
	{
		for(new c = 0; c < MAX_FRIENDS; c++)
		{
			// Черный Список
			new bool:is_null;
			new string_load[10];
			format(string_load, sizeof(string_load), "b%d", c);
			cache_is_value_name_null(0, string_load, is_null);
			if(is_null == false)
			{
				new string_json[140];
				cache_get_value_name(0, string_load, string_json, 140);

				new JsonNode:node = JSON_INVALID_NODE;
				if (JSON_Parse(string_json, node) == JSON_CALL_NO_ERR) 
				{
					JSON_GetInt(node, "id", black_list[c]);
				}
				if(black_list[c] == PlayerInfo[playerid][pID])
				{
					yes = 1;
					break;
				}
			}
		}
	}
	if(yes == 1) return format(string,sizeof(string),"[ Мысли ]: Я в чёрном списке у %s",resip), SendClientMessage(playerid,COLOR_GREY,string);
	else
	{
        mysql_format(pearsq, string, sizeof(string), "INSERT INTO `pp_message` \
			(`senderid`,`sender`,`playerid`,`player`,`unix`,`text`) VALUES ( '%d','%e','%d','%e','%d','%e' )",
		PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad, resip, unix, text);
		mysql_tquery(pearsq, string, "", "");
		SetPlayerChatBubble(playerid,"отправляет смс",COLOR_PURPLE,20.0,3000);
		format(string, sizeof(string), " SMS к %s[{cccccc}Offline{FFFF00}]: %s ", resip, text);
		SendClientMessage(playerid, COLOR_YELLOW, string);
		PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
		PlayerInfo[playerid][pTraderPerk] -= 100;
        read_sms(playerid, resip, -2, text, 1);
  	}
	return 1;
}
function Call_sms(playerid, unix, const text[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datad[3], string[124], resip[21];
	    cache_get_value_name_int(0, "user_id", datad[0]);
	    cache_get_value_name(0, "Name", resip, 21);
        cache_get_value_name_int(0, "DrugPerk", datad[1]);
        cache_get_value_name_int(0, "Sim", datad[2]);
        if(datad[1] == 0) return format(string,sizeof(string),"[ Мысли ]: У %s нет номера телефона",resip), SendClientMessage(playerid,COLOR_GREY,string);
        if(datad[2] == 1) return format(string,sizeof(string),"[ Мысли ]: У %s выключен смартфон",resip), SendClientMessage(playerid,COLOR_GREY,string);
        mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki_contacts` WHERE `user_id` = '%d'", datad[0]);
 		mysql_tquery(pearsq, string, "Call_yessend", "dddss", playerid, unix, datad[0], resip, text);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
stock sms(playerid, tmpp, const text[])
{
	new required_money = 2;
	if (PlayerInfo[playerid][pBkyrenie] >= 2 || PlayerInfo[tmpp][pBkyrenie] >= 2) required_money *= 4;
	new string[144];
	if(OnlineInfo[tmpp][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет [ Игрок не залогинился ]");
	if(PlayerInfo[tmpp][pSim] == 1) return format(string,sizeof(string),"[ Мысли ]: %s выключил смартфон [ Игнорирует личные сообщения ]",rpplayername(tmpp)), SendClientMessage(playerid,COLOR_GREY,string);
	if(!get_invent4(tmpp, 26, 0)) return format(string,sizeof(string),"[ Мысли ]: %s не имеет смартфон",rpplayername(tmpp)), SendClientMessage(playerid,COLOR_GREY,string);
	if(get_para(tmpp, 26) == 1) return format(string,sizeof(string),"[ Мысли ]: %s носит сломанный смартфон [ Online сообщение недоступно ]",rpplayername(tmpp)), SendClientMessage(playerid,COLOR_GREY,string);
	if(PlayerInfo[playerid][pTraderPerk] < required_money) return ErrorMessage(playerid, "{FF6347}На мобильном счёте недостаточно средств {ff9000}[ Y >> GPS >> Услуги >> Банкомат ]");
	if(get_black(tmpp, playerid)) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Сообщение не доставлено! [Вы занесли получателя в черный список]");
	if(get_black(playerid, tmpp)) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Сообщение не доставлено! [Вы занесены в черный список]");
	SetPlayerChatBubble(playerid,"отправляет смс",COLOR_PURPLE,20.0,3000);
	if(playerid != tmpp) PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
	format(string, sizeof(string), " SMS к %s[%d]: %s ", rpplayername(tmpp),tmpp,text), SendClientMessage(playerid, COLOR_YELLOW, string);
	if (PlayerInfo[playerid][pBkyrenie] >= 2 || PlayerInfo[tmpp][pBkyrenie] >= 2)
	{
		format(string, sizeof(string), " Вы, либо получатель, находитесь в космосе, поэтому сообщение дойдёт через 30 секунд..."), SendClientMessage(playerid, COLOR_YELLOW, string);
		SetTimerEx("DelayedMessageDeliveryCB", 30000, false, "dddds", playerid, tmpp, PlayerInfo[playerid][pID], PlayerInfo[tmpp][pID], text);
	}
	else
	{
		format(string, sizeof(string), " SMS от %s[%d]: {99ff33}%s ", rpplayername(playerid),playerid,text), SendClientMessage(tmpp, COLOR_YELLOW, string), PlayerPlaySound(tmpp, 5202, 0.0, 0.0, 0.0);
	}
	PlayerInfo[playerid][pTraderPerk] -= required_money;
	read_sms(playerid, PlayerInfo[tmpp][pName], tmpp, text, 0);
	return 1;
}

function DelayedMessageDeliveryCB(const senderid, const receiverid, const senderuid, const receiveruid, const msg[])
{
	if (!IsOnline(senderid) || !IsOnline(receiverid)) return 0;
	if (PlayerInfo[senderid][pID] != senderuid || PlayerInfo[receiverid][pID] != receiveruid) return 0;
	new string[144];
	format(string, sizeof(string), " SMS от %s[%d]: {99ff33}%s ", rpplayername(senderid),senderid,msg), SendClientMessage(receiverid, COLOR_YELLOW, string), PlayerPlaySound(receiverid, 5202, 0.0, 0.0, 0.0);
	return 1;
}

alias:pm("icq", "w", "sms")
CMD:pm(playerid, const params[])
{
	if(get_invent4(playerid, 26, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин?! Я не на земле");
	if(PlayerInfo[playerid][pSim] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сим карта в моём смартфоне выключена");
	
	new tmpp;
	if(isamute(playerid) == 1) return 1;
	new sender[121];
	if(sscanf(params, "s[121]s[144]",sender,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: СМС сообщение [ /w ID текст ]");
	if(strlen(sender) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	new unix = gettime();
	if(Flood[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не так быстро [ Подождите немного ]"), PlayerPlaySound(playerid,4203,0,0,0);
	Flood[playerid] = unix+2;
	if(AntiFloodText(playerid, params[0])) return 1;

	if(PlayerInfo[playerid][pSoska] > 0) tmpp = ReturnUser(sender, 1);
	else tmpp = ReturnUser(sender);

	if(IsOnline(tmpp)) sms(playerid, tmpp, params[1]);
	else pm_offline(playerid, sender, params[1]);
	return 1;
}

stock pm_offline(playerid, const sender[], const text[])
{
	new unix = gettime();
	if(PlayerInfo[playerid][pMessUnix] < unix) PlayerInfo[playerid][pMessage] = 0, PlayerInfo[playerid][pMessUnix] = unix+86400;
	else
	{
		if(PlayerInfo[playerid][pMessage] >= 100) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не буду отправлять [ Лимит 100 Offline сообщений в сутки ]"), PlayerPlaySound(playerid,4203,0,0,0);
		PlayerInfo[playerid][pMessage] ++;
	}
	if(strlen(text) > 100) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинный текст.. [ Лимит 100 символов ]");
	if(PlayerInfo[playerid][pTraderPerk] < 100) return ErrorMessage(playerid, "{FF6347}На мобильном счёте недостаточно средств | Минимум 100$ для Offline сообщения {ff9000}[ Y >> GPS >> Услуги >> Банкомат ]");
	if(checksimvol(text)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");

	new string[140];
	if(CheckRP_Nickname(sender))
	{
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Name, DrugPerk, Sim FROM `pp_igroki` WHERE `Name` = '%e'", sender);
		mysql_tquery(pearsq, string, "Call_sms", "dds", playerid, unix, text);
	}
	else return ErrorMessage(playerid, "{FF6347}Для отправки оффлайн СМС используйте NickName\n{cccccc}Пример: Cardinale_Reveal");
	return 1;
}

CMD:arestdom(playerid)
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(57, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 57, NO_FBI)) return 1;

	new string[144];
	for(new d = 1; d < sizeof(DomInfo); d++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 2.0, DomInfo[d][dKoordinatX], DomInfo[d][dKoordinatY], DomInfo[d][dKoordinatZ]))
		{
			if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо");
			if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно выйти из транспорта");
			if(DomInfo[d][dArest] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Дом уже арестован");
			if(DomInfo[d][dTaxday] <= 15) return format(string, sizeof(string), "[ Мысли ]: Арест дома только при неуплате налогов от 16 дней [Этот дом: %d дней]", DomInfo[d][dTaxday]), SendClientMessage(playerid, COLOR_GREY, string);
			if(DomInfo[d][dSell] >= 1) DomInfo[d][dSell] = 0;
			DomInfo[d][dArest] = 1;
			SaveDom(d);
			PlayerPlaySound(playerid,6401,0,0,0);
			format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s арестовал Дом № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName],d);
			SendRadioMessage(7, COLOR_ALLDEPT, string);
			format(string, sizeof(string), "<< %s %s арестовал Дом № %d >>", getNameRank(playerid), PlayerInfo[playerid][pName], d);
			OOCOff(COLOR_LIGHTRED, string);
			UpdateDom(d);
			OrgLog(7, "arestdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", d, "Арестовал Дом");
			HouseLog(0, "arestdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], d, 0, "Арестовал Дом");
			GiveUnit(playerid, 7);
			ApplyAnimation(playerid,"PED","endchat_01",4.0, false, true, true, false, false);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], DomInfo[d][dSost], DomInfo[d][dVlad], "Дом арестован за неуплату налогов");
			return 1;
		}
	}
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чтобы наложить арест на дом, мне нужно находиться рядом с ним");
	return 1;
}
CMD:arestbiz(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(58, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 58, NO_FBI)) return 1;

	if(IsPlayerInRangeOfPoint(playerid, 2.0, -1752.9893,883.6321,105.0207) && GetPlayerVirtualWorld(playerid) == 236)
	{
		new reason[121];
		if(sscanf(params, "iis[121]",params[0],params[1], reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Арестовать бизнес [ /arestbiz ID Дни Причина ]");
		if(params[0] < 1 || params[0] > 200) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
		if(params[1] < 1 || params[1] > 90) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Дни не меньше 1 и не больше 90");
		if(strlen(reason) > 60) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинная причина.. [ Лимит 60 символов ]");
		if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		if(BizzInfo[params[0]][bArest] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Бизнес уже арестован");
		new string[144], strong[64];
		BizzInfo[params[0]][bArest] = gettime() + params[1] * 86400; // Время Ареста
		format(strong, sizeof(strong), reason);
		strmid(BizzInfo[params[0]][bArReason], strong, 0, strlen(strong), 64);
		if(BizzInfo[params[0]][bLab] == 1) UpdateBizLabel(params[0], BizzInfo[params[0]][bLab]);
		SaveBizz(params[0]);
		format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s арестовал Бизнес № %d на %d дней {ffffff}**", getNameRank(playerid), PlayerInfo[playerid][pName],params[0], params[1]);
		SendRadioMessage(7, COLOR_ALLDEPT, string);

		format(string, sizeof(string), "Арестовал Бизнес на %d дней", params[1]);
		OrgLog(7, "arestbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], string);
		BizLog("arestbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], params[1], reason);
		format(string, sizeof(string), "<< %s %s арестовал Бизнес № %d [ %s ] >>", getNameRank(playerid), PlayerInfo[playerid][pName], params[0], bizname(params[0]));
		OOCOff(COLOR_LIGHTRED, string);
		format(string, sizeof(string), "{0088ff}[ %s ]: {444444}%s арестовал {ff0000}%s [%d] {cccccc}на %d дней | Причина: %s", getNameRank(playerid), PlayerInfo[playerid][pName], bizname(params[0]), params[0], params[1], reason);
		SendBizzMessage(params[0], string);
		PlayerPlaySound(playerid,6401,0,0,0);
		GiveUnit(playerid, 8);

		ApplyAnimation(playerid,"PED","endchat_01",4.0, false, true, true, false, false);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[params[0]][bSost], BizzInfo[params[0]][bVlad], "Бизнес арестован за неуплату налогов");
		return 1;
	}
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чтобы наложить арест на бизнес, мне нужно находиться в бизнес центре");
	return 1;
}

CMD:unarestbiz(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(58, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 58, NO_FBI)) return 1;

	if(IsPlayerInRangeOfPoint(playerid, 2.0, -1752.9893,883.6321,105.0207) && GetPlayerVirtualWorld(playerid) == 236)
	{
		if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Арестовать бизнес [ /unarestbiz ID ]");
		if(params[0] < 1 || params[0] > 200) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
		if(BizzInfo[params[0]][bArest] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот бизнес не арестован");

		BizzInfo[params[0]][bArest] = 0; // Время Ареста
		if(BizzInfo[params[0]][bLab] == 1) UpdateBizLabel(params[0], BizzInfo[params[0]][bLab]);
		SaveBizz(params[0]);

		new string[140];
		format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s снял арест с Бизнеса № %d {ffffff}**", getNameRank(playerid), PlayerInfo[playerid][pName],params[0]);
		SendRadioMessage(7, COLOR_ALLDEPT, string);

		OrgLog(7, "unarestbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Снял арест с бизнеса");
		BizLog("unarestbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "");
		format(string, sizeof(string), "<< %s %s снял арест с Бизнеса № %d [ %s ] >>", getNameRank(playerid), PlayerInfo[playerid][pName], params[0], bizname(params[0]));
		OOCOff(COLOR_LIGHTRED, string);
		format(string, sizeof(string), "{0088ff}[ %s ]: {444444}%s снял арест с бизнеса {ff0000}%s [%d]", getNameRank(playerid), PlayerInfo[playerid][pName], bizname(params[0]), params[0]);
		SendBizzMessage(params[0], string);
		PlayerPlaySound(playerid,6401,0,0,0);

		ApplyAnimation(playerid,"PED","endchat_01",4.0, false, true, true, false, false);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[params[0]][bSost], BizzInfo[params[0]][bVlad], "С бизнеса снят арест");
		return 1;
	}
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чтобы снять арест с бизнеса, мне нужно находиться в бизнес центре");
	return 1;
}

CMD:callup(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,1.0,1594.9479,-2271.3025,13.5295) || IsPlayerInRangeOfPoint(playerid,1.0,1106.98242, -1375.02271, 13.63670) || IsPlayerInRangeOfPoint(playerid,1.0,1518.65417, -1691.00305, 13.22820)
 	|| IsPlayerInRangeOfPoint(playerid,1.0,362.03329, -1725.82300, 6.53890) || IsPlayerInRangeOfPoint(playerid,1.0,-1036.06519, -1351.97961, 130.11220) || IsPlayerInRangeOfPoint(playerid,1.0,-2034.11475, -78.82440, 34.97220)
 	|| IsPlayerInRangeOfPoint(playerid,1.0,-2676.42065, -219.08401, 4.00630) || IsPlayerInRangeOfPoint(playerid,1.0,-2613.91089, 1368.17871, 6.80520) || IsPlayerInRangeOfPoint(playerid,1.0,-2244.41553, 2334.48413, 4.62000)
 	|| IsPlayerInRangeOfPoint(playerid,1.0,2027.85693, 1022.94733, 10.47830)|| IsPlayerInRangeOfPoint(playerid,1.0,1598.2856,-2271.3030,13.5270)
 	|| IsPlayerInRangeOfPoint(playerid,1.0,1601.6249,-2271.3022,13.5246)
	|| IsPlayerInRangeOfPoint(playerid,1.0,1757.794677, 1430.794799, 10.539639) || IsPlayerInRangeOfPoint(playerid,1.0,1757.794677, 1438.794799, 10.539639)
	|| IsPlayerInRangeOfPoint(playerid,1.0,1757.794677, 1434.794799, 10.539639) || IsPlayerInRangeOfPoint(playerid,2.0,894.752929, 2395.023681, 10.505805))
 	{
	    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Позвонить [ /callup Номер Телефона ]");
		if(params[0] == PlayerInfo[playerid][pDrugPerk]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем я буду звонить себе ?");
		if(params[0] < 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер телефона не может быть меньше 1000");
		if(oGetPlayerMoney(playerid) < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает денег");
		new giveplayerid = -1;
		foreach(Player, i)
		{
			if(OnlineInfo[i][oLogged] == 0) continue;
			if(PlayerInfo[i][pDrugPerk] == params[0])
			{
				giveplayerid = i;
				break;
			}
		}
		if(giveplayerid == -1) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Номер не обслуживается! [Нет в сети]");
		if(PlayerInfo[giveplayerid][pSim] == 1 || PlayerInfo[giveplayerid][pBkyrenie] >= 2 || !get_invent4(giveplayerid, 26, 0) || get_para(giveplayerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Аппарат абонента выключен или находится вне зоны действия сети!");
		if(GetPVarInt(giveplayerid, "Mobile") != 9999) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Линяя занята! [Абонент разговаривает или ему кто-то звонит]");
		if(get_black(playerid, giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Абонент сбросил вызов! [Вы занесены в черный список]");

		if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"PED","phone_in",4.0, false, true, true, true, true);
		SetPlayerChatBubble(playerid,"звонит по таксофону",COLOR_PURPLE,20.0,5000);
		SetPVarInt(playerid, "vtr",0);
		SetPVarInt(playerid, "Mobile",giveplayerid);
		SetPVarInt(playerid, "MobileStat",1);
		SetPVarInt(playerid,"taks",1);
		PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);
		oGivePlayerMoney(playerid, -10);
		if(OnlineInfo[playerid][oShowInterface] == 2) CloseMenu(playerid), SmartfonCall(playerid);

		SetPVarInt(giveplayerid, "Mobile",playerid);
		SetPVarInt(giveplayerid, "MobileStat",2);
		SetPVarInt(giveplayerid,"taks",0);
		SetPlayerChatBubble(giveplayerid,"смартфон звонит",COLOR_PURPLE,20.0,5000);
		SendClientMessage(giveplayerid, COLOR_GREY, "{AFAFAF}Входящий Вызов: {ccffff}Неизвестно");
		SendClientMessage(giveplayerid, COLOR_GREY, "{ccffff}[ /ph или Y ]{AFAFAF} - достать смартфон");
		around_player_audio(giveplayerid, 23000, 0, 5.0, 0);
		if(OnlineInfo[giveplayerid][oShowInterface] == 2) CloseMenu(giveplayerid), SmartfonCall(giveplayerid);
	}
	return 1;
}
stock get_black(playerid, giveplayerid)
{
	for(new c = 0; c < MAX_FRIENDS; c++)
	{
		if(ContactInfo[giveplayerid][cBlack][c] == 0) continue;
		if(ContactInfo[giveplayerid][cBlack][c] == PlayerInfo[playerid][pID]) return 1;
	}
	return 0;
}
CMD:call(playerid, const params[])
{
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Позвонить [ /call Номер Телефона ]");
	if(params[0] < 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер телефона не может быть меньше 1000");
	
	new giveplayerid = -1;
	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 0) continue;
		if(PlayerInfo[i][pDrugPerk] == params[0])
		{
			giveplayerid = i;
			break;
		}
	}
	CallPlayer(playerid, giveplayerid);
	return 1;
}
stock CallPlayer(playerid, giveplayerid)
{
    if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");

    if(get_invent4(playerid, 26, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	
	if(giveplayerid == INVALID_PLAYER_ID || giveplayerid == -1) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Номер не обслуживается! [Нет в сети]");
	if(PlayerInfo[giveplayerid][pDrugPerk] == PlayerInfo[playerid][pDrugPerk]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем я буду звонить себе ?");
	if(PlayerInfo[playerid][pTraderPerk] <= 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: На мобильном счете недостаточно средств [ Пополнить счёт можно в любом банкомате ]");

	if(PlayerInfo[giveplayerid][pSim] == 1 || PlayerInfo[giveplayerid][pBkyrenie] >= 2 || !get_invent4(giveplayerid, 26, 0) || get_para(giveplayerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Аппарат абонента выключен или находится вне зоны действия сети!");
	if(GetPVarInt(giveplayerid, "Mobile") != 9999) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Линяя занята! [Абонент разговаривает или ему кто-то звонит]");
	if(get_black(playerid, giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Абонент сбросил вызов! [Вы занесены в черный список]");

	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"PED","phone_in",4.0, false, true, true, true, true);
	SetPlayerChatBubble(playerid,"звонит по телефону",COLOR_PURPLE,20.0,5000);
	SetPlayerAttachedObject(playerid,1 , 18874, 6, 0.120000, 0.032448, 0.020000, 265.000000, 0.000000, 170.000000);
	SetPVarInt(playerid, "vtr",0);
	SetPVarInt(playerid, "Mobile",giveplayerid);
	SetPVarInt(playerid, "MobileStat",1);
	SetPVarInt(playerid,"taks",0);
	PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);
	PlayerInfo[playerid][pTraderPerk] --;
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseMenu(playerid), SmartfonCall(playerid);

	SetPVarInt(giveplayerid, "Mobile",playerid);
	SetPVarInt(giveplayerid, "MobileStat",2);
	SetPVarInt(giveplayerid,"taks",0);
	SetPlayerChatBubble(giveplayerid,"смартфон звонит",COLOR_PURPLE,20.0,5000);
	new string[114];
	format(string, sizeof(string), "{AFAFAF}Входящий Вызов: {ccffff}%s[%d]", PlayerInfo[playerid][pName],PlayerInfo[playerid][pDrugPerk]);
	SendClientMessage(giveplayerid, COLOR_GREY, string);
	SendClientMessage(giveplayerid, COLOR_GREY, "{ccffff}[ /ph или Y ]{AFAFAF} - достать смартфон");
	around_player_audio(giveplayerid, 23000, 0, 5.0, 0);
	if(OnlineInfo[giveplayerid][oShowInterface] == 2) CloseMenu(giveplayerid), SmartfonCall(giveplayerid);
	return 1;
}
CMD:ph(playerid)
{
	if(get_invent4(playerid, 26, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	if(OnlineInfo[playerid][oShowInterface] == 0) ShowSmartfon(playerid);
 	else if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
	return 1;
}
CMD:pickup(playerid)
{
	if(GetPVarInt(playerid, "Mobile") == 9999) return 1;
	if(GetPVarInt(playerid, "MobileStat") == 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже разговариваю");
	if(GetPVarInt(playerid, "MobileStat") != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне никто не звонит");
	if(GetPVarInt(playerid, "Mobile") < 2500)
	{
		new caller = GetPVarInt(playerid, "Mobile");
		if(IsOnline(caller))
		{
			SetPVarInt(caller, "MobileStat",3);
			new string[84];
			format(string, sizeof(string), " {ccffff}Абонент %s ответил на звонок", rpplayername(playerid));
			SendClientMessage(caller, COLOR_GREY, string);
			StopAudioStreamForPlayer(caller);
			if(OnlineInfo[caller][oShowInterface] == 2) PlayerTextDrawHide(caller, PlayerSmartDraw[29][playerid]), PlayerTextDrawHide(caller, PlayerSmartDraw[30][playerid]), PlayerTextDrawShow(caller, PlayerSmartDraw[32][playerid]);
		}
	}
	SetPlayerChatBubble(playerid,"отвечает на звонок",COLOR_PURPLE,20.0,5000);
	SetPVarInt(playerid, "MobileStat",3);
	SendClientMessage(playerid, COLOR_GREY, "{ccffff}Вы приняли звонок");
	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"PED","phone_in",4.0, false, true, true, true, true);
	StopAudioStreamForPlayer(playerid);
	SetPlayerAttachedObject(playerid,1 , 18874, 6, 0.120000, 0.032448, 0.020000, 265.000000, 0.000000, 170.000000);
	if(GetPVarInt(playerid, "Mobile") == 2500) SetPVarInt(playerid,"qweststat",3), SetPVarInt(playerid,"qwesttime",2); // Звонит бот Джоне
	else if(GetPVarInt(playerid, "Mobile") == 2501) SetPVarInt(playerid,"qweststat",12), SetPVarInt(playerid,"qwesttime",2); // Звонит бот Джоне второй раз
	else if(GetPVarInt(playerid, "Mobile") == 2502) SetPVarInt(playerid,"qweststat",45), SetPVarInt(playerid,"qwesttime",2); // Звонит бот с археологии

	if(OnlineInfo[playerid][oShowInterface] == 2) PlayerTextDrawHide(playerid, PlayerSmartDraw[29][playerid]), PlayerTextDrawHide(playerid, PlayerSmartDraw[30][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[32][playerid]);
	return 1;
}
CMD:hangup(playerid)
{
	if(GetPVarInt(playerid, "Mobile") == 9999) return 1;
	if(GetPVarInt(playerid, "Mobile") >= 2500)
	{
	    if(GetPVarInt(playerid, "MobileStat") == 3) return ErrorMessage(playerid, "{FF6347}Вы не можете сбросить вызов [ Свернуть смартфон: ESC ]");
	    else ErrorMessage(playerid, "{FF6347}Вам нужно ответить на вызов\n{ffcc66}Нажмите на зелёную кнопку");
	    return 1;
	}
	SendClientMessage(playerid, COLOR_GREY, " {cc9999}Вы сбросили вызов");
	hangup(playerid, 0);
	return 1;
}
stock hangup(playerid, stat)
{
	if(GetPVarInt(playerid, "Mobile") == 9999) return 1;
	if(GetPVarInt(playerid, "Mobile") < 2500)
	{
		new caller = GetPVarInt(playerid, "Mobile");
		if(IsOnline(caller))
		{
			if(GetPVarInt(caller, "Mobile") == playerid)
			{
				if(stat == 0) SendClientMessage(caller, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Абонент сбросил вызов!");
				else SendClientMessage(caller, COLOR_GREY, "{cc9999}Оператор: {AFAFAF}Извините, связь прервалась!");
				RemovePlayerAttachedObject(caller,1);
				if(NoAnim[caller] == 0) ApplyAnimation(caller,"PED","phone_out",4.0, false, true, true, false, false);
				PlayerPlaySound(caller, 1063, 0.0, 0.0, 0.0);
				SetPVarInt(caller, "Mobile",9999), SetPVarInt(caller, "MobileStat",0), SetPVarInt(playerid, "taks",0);
				if(OnlineInfo[caller][oShowInterface] == 2) CloseCall(caller), SmartfonMenu(caller);
				SetPVarInt(caller,"vtr",0);
			}
		}
	}
	RemovePlayerAttachedObject(playerid,1);
	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
	PlayerPlaySound(playerid, 1063, 0.0, 0.0, 0.0);
	SetPVarInt(playerid, "Mobile",9999), SetPVarInt(playerid, "MobileStat",0), SetPVarInt(playerid, "taks",0);
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseCall(playerid), SmartfonMenu(playerid);
	SetPVarInt(playerid,"vtr",0);
	return 1;
}
stock usesmoke(playerid, i)
{
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_SMOKE_CIGGY);
	TakeInvent(playerid, 16, 1, 0, i);
	if(PlayerInfo[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"достал сигареты и закурил",COLOR_PURPLE,20.0,7000);
	else SetPlayerChatBubble(playerid,"достала сигареты и закурила",COLOR_PURPLE,20.0,7000);
	infect(playerid, 10, 50);
	return 1;
}
CMD:smoke(playerid, const params[])
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы участник экспедиции NASA");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы участвуете в бою на ринге");
	if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7) return ErrorMessage(playerid, "{FF6347}Вы в больнице");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы участник мероприятия");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(!sscanf(params, "i", params[0]))
 	{
 	    if(get_invent4(playerid, 53, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет зажигалки");
 	    usesmoke(playerid, params[0]);
 	}
 	else
 	{
		if(get_invent4(playerid, 16, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет сигарет в свободной ячейке");
		if(get_invent4(playerid, 53, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет зажигалки");
		usesmoke(playerid, 999);
	}
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
	return 1;
}
CMD:usearm(playerid)
{
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы участвуете в бою на ринге");
	if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7) return ErrorMessage(playerid, "{FF6347}Вы пациент госпиталя");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы участник мероприятия");
	if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(PlayerInfo[playerid][pArmor] <= 0.0)
	{
	    new thingId, fpara, fqara, inva, fpack;
		get_armor(playerid, thingId, fpara, fqara, inva, fpack);
		if(thingId == 0 || fpack > 0) return ErrorMessage(playerid, "{FF6347}У вас нет бронежилета\n{cccccc}Не забудьте проверить подарки, предмет может лежать в упаковке");
		if(PlayerInfo[playerid][pOdet][0] >= 1 && PlayerInfo[playerid][pOdet][1] >= 1 && PlayerInfo[playerid][pOdet][2] >= 1 && PlayerInfo[playerid][pOdet][3] >= 1 && PlayerInfo[playerid][pOdet][4] >= 1) return ErrorMessage(playerid, "{FF6347}У вас нет свободных слотов для аксессуара [ Лимит 5 ]");
	    CreateOdet(playerid, thingId, inva);
	}
	else
	{
		PlayerPlaySound(playerid,5601,0,0,0);
		ACSetPlayerArmour(playerid, 0);
		ApplyAnimation(playerid,"PED","Turn_R",4.0, false, true, true, false, false);
	}
	return 1;
}
stock notebook(playerid, inva)
{
	if(Hold[playerid] == 11)
    {
        if(Komputer[playerid] == 1 || Komputer[playerid] == 2) closecomp(playerid), CancelSelectTextDraw(playerid);
    	Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0;
		RemovePlayerAttachedObject(playerid,1); PPP15[playerid] = 0;
		if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ClearAnimations(playerid), ClearAnim(playerid);
		return 1;
    }
	if(PlayerInfo[playerid][pInvenPara][inva] == 1) return ErrorMessage(playerid, "{FF6347}Этот ноутбук сломан {cccccc}[ Техника ломается при падении с высоты ]");
	if(PlayerInfo[playerid][pBkyrenie] >= 2 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы участник экспедиции NASA");
	if(GetPVarInt(playerid,"kas") >= 1) return ErrorMessage(playerid, "{FF6347}Вы играете за столом в казино");
	if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Нельзя достать предмет в движении");
	if(Hand[playerid] > 0 || Hold[playerid] > 0 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || OnlineInfo[playerid][oInHandThing][0] > 0
	|| Piss[playerid] == 6 || Piss[playerid] == 2 || Piss[playerid] == 1 || Sleep[playerid] >= 1
	|| SleepRP[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не может сейчас достать предмет [ Заняты руки или выполняется действие ]");
	if(Komputer[playerid] == 1 || Komputer[playerid] == 2) return ErrorMessage(playerid, "{FF6347}Вы уже используете компьютер или ноутбук");
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid);
	if(OnlineInfo[playerid][oShowInterface] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас открыть ноутбук [ Закройте другое меню ]");
	in_hand_item(playerid, inva, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenPara][inva], PlayerInfo[playerid][pInvenQara][inva], PlayerInfo[playerid][pInvenQuan][inva]);
	opendeskcomp(playerid);
	return 1;
}
stock useknife(playerid, inva)
{
    if(Hold[playerid] == 14)
    {
    	Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0, HoldQuan[playerid] = 0, HoldInva[playerid] = 0, HoldPara[playerid] = 0, HoldQara[playerid] = 0;
		RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		return 1;
    }
    if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Нельзя достать предмет в движении");
	if(Hand[playerid] > 0 || Hold[playerid] > 0 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || OnlineInfo[playerid][oInHandThing][0] > 0
	|| Piss[playerid] == 6 || Piss[playerid] == 2 || Piss[playerid] == 1 || Sleep[playerid] >= 1
	|| SleepRP[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не может сейчас достать предмет [ Заняты руки или выполняется действие ]");
	
	new string[200];
	format(string, sizeof(string), "{ffcc66}Вы взяли в руки Кухонный нож {ff9000}[ Порезать вены: %s ]\n{cccccc}Поставить на стол или пол: Кнопка F\n{cccccc}Разделать тушу животного/Срезать траву: Кнопка ALT", buttonName[Device[playerid]]);
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*",string,"*","");
	in_hand_item(playerid, inva, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenPara][inva], PlayerInfo[playerid][pInvenQara][inva], PlayerInfo[playerid][pInvenQuan][inva]);
	return 1;
}
stock in_hand_item(playerid, inva, fpick, para, qara, quan)
{
    Eat[playerid] = 0, HoldNoinvent[playerid] = 0;
	RemovePlayerAttachedObject(playerid,1);
	if(fpick == 42)
	{
	    Hold[playerid] = 11;
		SetPlayerAttachedObject(playerid, 1, 19893, 5, 0.032000, 0.008000, 0.144000, -78.400016, 2.499998, -74.899948, 1.000000, 1.000000, 1.000000, 0, 0);
		PPP15[playerid] = 7, ApplyAnimation(playerid,"CARRY","crry_prtial",4.1, true, true, true, true, true);
	}
	else if(fpick == 97)
	{
	    Hold[playerid] = 14;
		SetPlayerAttachedObject(playerid, 1, 19583, 6, 0.096000, 0.032999, 0.000000, -103.499969, -173.599990, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
	}
	else if(fpick == 262 || (fpick >= 280 && fpick <= 283)) 
	{
	    Hold[playerid] = fpick;
		SetPlayerAttachedObject(playerid, 1, friskPick[fpick], 6, 0.092000, 0.0, 0.000000, 0.0, 0.0, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
	}
	HoldFrisk[playerid] = fpick, HoldStat[playerid] = fpick, HoldQuan[playerid] = quan, HoldInva[playerid] = inva;
    HoldPara[playerid] = para, HoldQara[playerid] = qara;
	return 1;
}
stock opendeskcomp(playerid)
{
    loadkomp(playerid, 1), PlayerPlaySound(playerid,30801,0,0,0);
	return 1;
}
CMD:bandage(playerid, const params[])
{
	new slot = 999;
	if(!sscanf(params, "i", params[0])) // Указан слот
 	{
		if(PlayerInfo[playerid][pInven][params[0]] != 70) return ErrorMessage(playerid, "{FF6347}У вас нет бинта");
		slot = params[0];
	}
	else
	{
		if(get_invent4(playerid, 70, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет бинта");
	}
	if(gSkafandr[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Вы в скафандре");
	if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Нельзя в движении");
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && WatchSpeed[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя в движении за рулём");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы сейчас участвуете в бою на ринге");
	if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7) return ErrorMessage(playerid, "{FF6347}Вы проходите лечение в больнице");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(GetPVarInt(playerid,"antiflood") > 0) return ErrorMessage(playerid, "{FF6347}Вы используете команду слишком быстро [Антифлуд]");
	if(HealthAC[playerid] >= GetMaxPlayerHealth(playerid)) return ErrorMessage(playerid, "{FF6347}У вашего персонажа полная полоса здоровья");

	if(!HealthPlayer(playerid, 3, 50, slot, 70)) return ErrorMessage(playerid, "{FF6347}Дождитесь окончания процесса лечения");

	SetPVarInt(playerid,"antiflood",1);

	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"OTB","betslp_loop",4.0, false, true, true, false, false, SYNC_ALL);
  	SetPlayerChatBubble(playerid,"использует бинт",COLOR_PURPLE,30.0,5000);
	return 1;
}

CMD:bloodvampire(playerid, const params[]) // Пьёт кровь вампира
{
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || Dei[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки или выполняется действие [Предмет или оружие]");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
	if(Eat[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Не спешите");
	if(get_invent4(playerid, 96, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет бокала с кровью вампира");
	new para = get_para(playerid, 96), unix = gettime();
	if(sscanf(params, "i", params[0])) TakeInvent(playerid, 96, 1, 0, 999);
	else
	{
		if(params[0] < 0 || params[0] > 39) return 1;
		TakeInvent(playerid, 96, 1, 0, params[0]);
	}
	GiveThingPlayer(playerid, 38, 1, 0, 0, 0, 0, 9999);
	Eat[playerid] = 1; EatTime[playerid] = 4;
   	RemovePlayerAttachedObject(playerid,1);
   	SetPlayerAttachedObject(playerid, 1, 1667, 6, 0.108999, 0.033000, 0.031000, 9.500002, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
   	PlayerPlaySound(playerid, 32200, 0.0, 0.0, 0.0);
   	ApplyAnimation(playerid,"BAR","dnk_stndM_loop",2.0, false, false, false, false, false, SYNC_ALL);
	SetPlayerChatBubble(playerid,"пьет из бокала",COLOR_PURPLE,20.0,4000);
	new yes = getinfect(playerid, 18); // Получаем статус инфецированности от вампира (0, значит мы не заражены)
	
	if(yes == 0 && para > unix && get_odet(playerid, 11712) == 0) 
	{
		infect(playerid, 18, 500); // Начинаем заражение
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я как-то странно себя чувствуют..");
	}
	EatPlayer(playerid, -800), SetPVarInt(playerid, "qweststat", 64), SetPVarInt(playerid, "qwesttime", 8);
	if(PlayerInfo[playerid][pAchieve][113] == 0) AchievePlayer(playerid, 113, 1);
	return 1;
}
CMD:bullsblood(playerid, const params[]) // Пьёт бычью кровь
{
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || Dei[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки или выполняется действие [Предмет или оружие]");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
	if(get_invent4(playerid, 107, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет бокала с кровью");
	if(Eat[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Не спешите");
	new para = get_para(playerid, 107), unix = gettime();
	if(sscanf(params, "i", params[0])) TakeInvent(playerid, 107, 1, 0, 999);
	else
	{
		if(params[0] < 0 || params[0] > 39) return 1;
		TakeInvent(playerid, 107, 1, 0, params[0]);
	}
	Eat[playerid] = 1; EatTime[playerid] = 4;
   	RemovePlayerAttachedObject(playerid,1);
   	SetPlayerAttachedObject(playerid, 1, 1667, 6, 0.108999, 0.033000, 0.031000, 9.500002, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
   	PlayerPlaySound(playerid, 32200, 0.0, 0.0, 0.0);
   	ApplyAnimation(playerid,"BAR","dnk_stndM_loop",2.0, false, false, false, false, false, SYNC_ALL);
	SetPlayerChatBubble(playerid,"пьет из бокала",COLOR_PURPLE,20.0,4000);
	if(getillness(playerid, 18) == -1 || unix > para) EatPlayer(playerid, -800), SetPVarInt(playerid, "qweststat", 64), SetPVarInt(playerid, "qwesttime", 8);
	else if(getillness(playerid, 18) >= 0) EatPlayer(playerid, 100); // Если вампир - насыщаемся
	if(unix > para && PlayerInfo[playerid][pAchieve][113] == 0) AchievePlayer(playerid, 113, 1);
	return 1;
}
CMD:useblood(playerid, const params[]) // Пьёт обычную кровь
{
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || Dei[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки или выполняется действие [Предмет или оружие]");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
	if(get_invent4(playerid, 98, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет бокала с кровью");
	if(Eat[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Не спешите");
	new para = get_para(playerid, 98), unix = gettime();
	if(sscanf(params, "i", params[0])) TakeInvent(playerid, 98, 1, 0, 999);
	else
	{
		if(params[0] < 0 || params[0] > 39) return 1;
		TakeInvent(playerid, 98, 1, 0, params[0]);
	}
	GiveThingPlayer(playerid, 38, 1, 0, 0, 0, 0, 9999);
	Eat[playerid] = 1; EatTime[playerid] = 4;
   	RemovePlayerAttachedObject(playerid,1);
   	SetPlayerAttachedObject(playerid, 1, 1667, 6, 0.108999, 0.033000, 0.031000, 9.500002, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
   	PlayerPlaySound(playerid, 32200, 0.0, 0.0, 0.0);
   	ApplyAnimation(playerid,"BAR","dnk_stndM_loop",2.0, false, false, false, false, false, SYNC_ALL);
	SetPlayerChatBubble(playerid,"пьет из бокала",COLOR_PURPLE,20.0,4000);
	if(getillness(playerid, 18) == -1 || unix > para) EatPlayer(playerid, -800), SetPVarInt(playerid, "qweststat", 64), SetPVarInt(playerid, "qwesttime", 8);
	else if(getillness(playerid, 18) >= 0) EatPlayer(playerid, 300); // Если вампир - насыщаемся
	if(unix > para && PlayerInfo[playerid][pAchieve][113] == 0) AchievePlayer(playerid, 113, 1);
	return 1;
}
stock seeds(playerid, fpick)
{
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	new string[84], vremfpick;
	vremfpick = fpick;
	if(fpick > 1000) fpick -= 1000;
	if(get_invent4(playerid, fpick, 0) <= 0) return format(string, sizeof(string), "{FF6347}У вас нет этого предмета [ %s ]", friskName[fpick]), ErrorMessage(playerid, string);
	if(vremfpick == 88 && get_ability(playerid, 5) <= 1) return ErrorMessage(playerid, "{FF6347}Выращивать траву можно только со 2-го уровня навыка фермера {cccccc}[ Y >> Меню >> Навыки или /skill ]");
	if(Dei[playerid] == 0)
	{
	    if(Hand[playerid] >= 1 || Hold[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
		Dei[playerid] = vremfpick, DeiStat[playerid] = 0, PlayerPlaySound(playerid,5600,0,0,0);
		ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		if(vremfpick == 1003) SetPlayerAttachedObject(playerid, 1, 1520, 6, 0.044999, 0.027999, -0.107000, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0); // Бутылка
		else if(vremfpick == 88) SetPlayerAttachedObject(playerid, 1, 19562, 6, 0.213000, 0.048999, -0.206000, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0); // Трава
		else if(vremfpick == 106) SetPlayerAttachedObject(playerid, 1, 1644, 6, 0.062999, 0.049999, 0.056000, 98.899986, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0); // Удобрение
		else if(vremfpick == 108) SetPlayerAttachedObject(playerid, 1, 2752, 6, 0.044999, 0.027999, -0.107000, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0); // Семена Тыквы
		else if(vremfpick == 109) SetPlayerAttachedObject(playerid, 1, 2752, 6, 0.044999, 0.027999, -0.107000, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0); // Семена Томатов
		else if(vremfpick == 110) SetPlayerAttachedObject(playerid, 1, 2060, 6, 0.257000, 0.023000, 0.000000, 89.500015, 0.000000, 0.000000, 0.342000, 0.505000, 0.636000, 0, 0); // Рассада Картошки
	}
	else if(Dei[playerid] == vremfpick) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
	else ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
	return 1;
}

stock bite(playerid, giveplayerid)
{
    if(IsAAntidm(playerid)) return ErrorMessage(playerid, "{FF6347}Нельзя в зелёной зоне");
    if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || Dei[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки или выполняется действие [Предмет или оружие]");
	if(IsMafiaMember(playerid) && gMifga[playerid] != 9999 || Kapt[fraction(playerid)] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя во время капта");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя во время боя на ринге");
    if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Нельзя во время мероприятия");
    if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Он куда-то делся {cccccc}[ Вышел из игры ]");
	if(!ProxDetectorS(2.0, playerid, giveplayerid) || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(vampire[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас пить кровь {cccccc}[ Персонаж сгорает на солнце ]");
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Нельзя в движении");
	if(IsPlayerInAnyVehicle(playerid) || IsPlayerInAnyVehicle(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Нельзя в транспорте");
	if(get_odet(giveplayerid, 11712)) return ErrorMessage(playerid, "{FF6347}Нельзя пить кровь человека, на котором надето распятие \n{cccccc}[ Аксессуар распятие защищает от вампиров ]");
	if(!howstun(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Игрок должен быть без сознания или обезврежен \n{cccccc}[ Нокаутировать, парализовать или связать ]");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",2.0, false, true, true, false, false, SYNC_ALL);
	TurnPlayerFaceToPlayer(playerid, giveplayerid);
	new string[124];
	format(string, sizeof(string), "впивается зубами в шею %s и пьёт кровь", playername(giveplayerid)),
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,5000);
	around_audio(32200, 0, 30.0, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
	EatPlayer(playerid, 1000);
	if(HealthAC[giveplayerid] > 5.0) ACSetPlayerHealth(giveplayerid, 5.0);
	PlayerInfo[giveplayerid][pMechSkill] = 0;
	ShowDialog(giveplayerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}На вас напал вампир и выпил вашей крови","*","");
	return 1;
}
