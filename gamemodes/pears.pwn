CMD:rep(playerid)
{
	if(PlayerInfo[playerid][pLevel] < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня недостаточно опыта [ 3+ Level ]");
	if(PlayerInfo[playerid][pRepTime] >= 1)
 	{
 		new string[144];
  		format(string, sizeof(string), "[ Мысли ]: Я смогу изменить репутацию только через {ff0000}%d минут", PlayerInfo[playerid][pRepTime]/60);
		SendClientMessage(playerid, COLOR_GREY, string);
  		return 1;
	}
	ShowDialog(playerid,268,DIALOG_STYLE_INPUT,"{ff9000}Репутация","{cccccc}Чтобы посмотреть, повысить или понизить репутацию игрока\n{ff9000}Введите его ID","Принять","Отмена");
	return 1;
}
