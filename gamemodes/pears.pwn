			    if(BizzInfo[b][bTaxes] <= 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: У меня нет неоплаченных налогов на бизнес"), PlayerPlaySound(playerid,4203,0,0,0), bank(playerid, 11);
				realtax += BizzInfo[b][bTaxes];
				if(realtax > PlayerInfo[playerid][pAccount]) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: На моём банковском счету недостаточно средств"), PlayerPlaySound(playerid,4203,0,0,0), bank(playerid, 11);
				BizzInfo[b][bTaxes] = 0, BizzInfo[b][bTaxday] = 0, SaveBizz(b);
				if(BizzInfo[b][bLien] == 0) BizzInfo[b][bArest] = 0;
				BizLog("taxes", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, realtax, "Налог на Бизнес");
				format(string, sizeof(string),"\n{cccccc}Вы оплатили Налог на Бизнес в размере {FF6347}%d$\n{cccccc}Дата: %02d.%02d.%d\n",realtax, day, month, year);
   				ShowDialog(playerid,1047,DIALOG_STYLE_MSGBOX, "{99ff66}Банк", string, "Ок", "");
   				MoneyLog("taxes", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -realtax, "Налог на Бизнес");
			}
			PlayerPlaySound(playerid,6401,0,0,0);
