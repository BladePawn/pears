	case 463:
   	{
		if(response)
		{
			new level = strval(inputtext); // Параметр ранга
			if (!sscanf(inputtext, "i", level))
			{
				if(level > 500 || level < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер семьи не меньше 1 и не больше 500"), pc_cmd_donate(playerid);
				if(FamilyInfo[level][fSost] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер этой семьи занят"), pc_cmd_donate(playerid);
				DP[0][playerid] = level;
				format(string,sizeof(string),"{cccccc}Номер Семьи: %d\n{ff9000}Введите название вашей семьи",level);
				ShowDialog(playerid,464,DIALOG_STYLE_INPUT,"{0088ff}[Donate] {12FF00}Семья",string,"Принять","Отмена");
				return 1;
			}
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу регистрировать семью без номера.."), pc_cmd_donate(playerid);
		}
		else pc_cmd_donate(playerid);
