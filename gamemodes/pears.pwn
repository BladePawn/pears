	case 547:
	{
		if(response)
		{
		    i_resettabs(playerid);
			if(strlen(inputtext))
			{
				if(OnlineInfo[playerid][oShowTabs] == 9999 || Tabs_Load[playerid] != 5) return 1;
				new v = OnlineInfo[playerid][oShowTabs];
				if(!IsABoot(v)) return 1;
				if((VehInfo[v][vSost] == PlayerInfo[playerid][pID] || VehInfo[v][vKey] == PlayerInfo[playerid][pID] && VehInfo[v][vKeyUnix] > gettime()) && GetPlayerVip(playerid) > 0) {}
				else
				{
					if(VehInfo[v][vCarLock] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт заперт");
				}
			    new giveplayerid = strval(inputtext);
			    if(giveplayerid == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете поместить себя в багажник");
				if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
				if(!ProxDetectorS(5.0, playerid, giveplayerid)) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко от игрока");
				if(PlayerInfo[giveplayerid][pJailed] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете положить в багажник заключённого");
				new Float:Boot[3], Float:Bonnet[3];
				GetCoordBonnetVehicle(v, Bonnet[0], Bonnet[1], Bonnet[2]);
				GetCoordBootVehicle(v, Boot[0], Boot[1], Boot[2]);
				if(IsPlayerInRangeOfPoint(playerid, 1.0, Boot[0], Boot[1], Boot[2]) && !IsABootFront(v) || IsPlayerInRangeOfPoint(playerid, 1.0, Bonnet[0], Bonnet[1], Bonnet[2]) && IsABootFront(v))
				{
					if(VehInfo[v][vPeople] > 0) return ErrorMessage(playerid, "{FF6347}В багажнике этого транспорта уже лежит человек");
					if(!howstun(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Вам необходимо обездвижить игрока [ Бита, электрошокер, верёвка ]");
					
					new put_inva = PutThingBoot(v, 35, 1, 0, 0, 0, 0, 999);
					if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}В багажнике нет места"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет
					
         			format(string, sizeof(string), "заталкивает в багажник %s", playername(giveplayerid));
	            	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,5000);
	            	format(string, sizeof(string), "* %s заталкивает в багажник %s", playername(playerid), playername(giveplayerid));
 					ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
 					
 					TextDrawShowForPlayer(giveplayerid, MindDraw[0]), TextDrawShowForPlayer(giveplayerid, MindDraw[1]), TextDrawShowForPlayer(giveplayerid, MindDraw[2]);
					if(PlayerInfo[giveplayerid][pDrawLanguage] == false && Device[giveplayerid] != 1) PlayerTextDrawSetString(giveplayerid, MindDraw1, RusToGame("Освобожусь: 300 сек."));
					else PlayerTextDrawSetString(giveplayerid, MindDraw1, "Free: 300 sec");
					PlayerTextDrawShow(giveplayerid, MindDraw1);
					
