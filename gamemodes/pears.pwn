				    	if(IsPlayerInRangeOfPoint(playerid, 1.0, DomInfo[nd][dSinX], DomInfo[nd][dSinY], DomInfo[nd][dSinZ]) && DomInfo[nd][dInsin] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу установить кровать слишком близко к раковине"), pc_cmd_dominteraction(playerid);
