			}
			else
			{
				if(ViborFunk[gop] == 1) format(str,sizeof(str),"\n{0088ff}%d. {ffffff}%s{ffffff} [ {cccccc}Голосов: {ff9000}%d {ffffff}]",gop+1,ViborName[gop],ViborGol[gop]), strcat(sctring,str);
			}
		}
	}
	else
	{
		for(new gop = 0;gop<10;gop++)
		{
			if(ViborInfo[vstat] == 2)
			{
				if(ViborFunk[gop] == 1) format(str,sizeof(str),"\n{0088ff}%d. {ffffff}%s {ffffff}[ {cccccc}Голосов: {cccccc}скрыто {ffffff}]",gop+1,FamilyInfo[strval(ViborName[gop])][fName]), strcat(sctring,str);
			}
			else 
			{
				if(ViborFunk[gop] == 1) format(str,sizeof(str),"\n{0088ff}%d. {ffffff}%s {ffffff}[ {cccccc}Голосов: {cccccc}скрыто {ffffff}]",gop+1,ViborName[gop]), strcat(sctring,str);
			}
		}
	}
	ShowDialog(playerid,533,DIALOG_STYLE_LIST,"{0088ff}Выборы",sctring,"Выбор","Отмена");
	return 1;
}
CMD:dynamiczz(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 4) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new ast[90];
	if(dyn_zone_zz == INVALID_STREAMER_ID)
	{
		new Float:rad;
		if(sscanf(params, "f",rad)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Создать динамическую зелёную зону возле себя [ /dynamiczz Радиус Действия ]");
		if(rad > 500 || rad < 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Радиус зелёной зоны не меньше 2 и не больше 500 метров");
		
		new Float:posici[3];
		GetPlayerPos(playerid, posici[0], posici[1], posici[2]);
		format(ast, sizeof(ast), " [ ADM ]: %s установил динамическую зелёную зону (Радиус: %0.2f м.)",PlayerInfo[playerid][pName],rad);
		ABroadCast(COLOR_ADM,ast,1);
		dyn_zone_zz = CreateDynamicSphere(posici[0], posici[1], posici[2], rad, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	}
	else
	{
		DestroyDynamicArea(dyn_zone_zz);
		dyn_zone_zz = INVALID_STREAMER_ID;
		format(ast, sizeof(ast), " [ ADM ]: %s свернул динамическую зелёную зону",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,ast,1);
	}
	return 1;
}
CMD:gomp(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pMedia] >= 3)
	{
		PlayerPlaySound(playerid,40405,0,0,0);
		new str[100],sctring[512];
		format(str,sizeof(str),"%s\t\n", Pognalinamp ? "{FF6347}Завершить мероприятие" : "{99ff66}Начать мероприятие");
		strcat(sctring,str);
		format(str,sizeof(str),"{ff9000}Cпавн\t\n");
		strcat(sctring,str);
		format(str,sizeof(str),"{ff9000}Зона\t\n");
		strcat(sctring,str);
		format(str,sizeof(str),"{ff9000}Оружие\t\n");
		strcat(sctring,str);
		format(str,sizeof(str),"{ff9000}Скин\t\n");
		strcat(sctring,str);
		if(GameInfo[gamType]==0)format(str,sizeof(str),"{cccccc}Условие:\t{444444}Отсутствует\n");
		else if(GameInfo[gamType]==1)format(str,sizeof(str),"{cccccc}Условие:\t{0088ff}Radio\n");
		else if(GameInfo[gamType]==2)format(str,sizeof(str),"{cccccc}Условие:\t{ff9000}Launcher\n");
		strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Отображать иконки игроков на мини-карте\t%s\n", GameInfo[gamOffClist] ? "{ff6347}[ Off ]" : "{99ff66}[ On ]");
		strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Отображать никнеймы игроков\t%s\n", GameInfo[gamOffNick] ? "{ff6347}[ Off ]" : "{99ff66}[ On ]"); 
		strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Ванильный урон\t%s\n", GameInfo[gamDamage] ? "{99ff66}[ On ]" : "{ff6347}[ Off ]"); 
		strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Урон по союзникам\t%s\n", GameInfo[gamTeamKill] ? "{99ff66}[ On ]" : "{ff6347}[ Off ]"); 
		strcat(sctring,str);
		if(Ogranmp <= 0) format(str,sizeof(str),"{cccccc}Лимит Участников:\t{444444}Не ограничено\n"), strcat(sctring,str);
		else if(Ogranmp >= 1) format(str,sizeof(str),"{cccccc}Лимит Участников:\t{ff9000}%d\n",Ogranmp), strcat(sctring,str);
		if(GameInfo[gamEnterTime] <= 0) format(str,sizeof(str),"{cccccc}Время для входа:\t{444444}Нет\n"), strcat(sctring,str);
		else if(GameInfo[gamEnterTime] >= 1) format(str,sizeof(str),"{cccccc}Время для входа:\t{ff9000}%d сек.\n", GameInfo[gamEnterTime]), strcat(sctring,str);
		ShowDialog(playerid,334,DIALOG_STYLE_TABLIST,"{ff9000}Управление мероприятием",sctring,"Выбор","Отмена");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
