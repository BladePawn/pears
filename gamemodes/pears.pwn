// Защита временная от 10 подключений с одного IP VREMENNO
stock CheckPlayerIPConnected(playerid)
{
	new plaip[24], plaiptwo[24], kolip;
	GetPlayerIp(playerid, plaip, sizeof(plaip));

	foreach (Player, i)
	{
		GetPlayerIp(i, plaiptwo, sizeof(plaiptwo));
		if(strfind(plaiptwo, plaip, true) == 0) kolip ++;
	}

	if(kolip >= 10)
	{
		foreach (Player, i)
		{
			GetPlayerIp(i, plaiptwo, sizeof(plaiptwo));
			if(strfind(plaiptwo, plaip,true) == 0) Kick(i);
		}
		return true;
	}
	return false;
}

public OnPlayerConnect(playerid)
{
    g_MysqlRaceCheck[playerid] ++;
    if(gMysqlSaveCheck[playerid] == 1)
    {
		TextDrawShowForPlayer(playerid, Chernifon);
		ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Аккаунт под этим ID не завершил сохранение\n{cccccc}Пожалуйста, перезайдите {FF6347}/q или ESC >> Выход","Ок","");
		Kickx(playerid);
		return 1;
	}

	#if defined NPC_SAMP
	if(IsPlayerNPC(playerid)) return OnNpcConnect(playerid);
	else
	{
		// Защита временная от 10 подключений с одного IP VREMENNO
		if(CheckPlayerIPConnected(playerid)) return true;

		// Не пускаем игрока, если он подключается раньше всех NPC
		if(BlockConnectBeforeNPC(playerid)) return 1;

		// Проверка на доступность никнейма
		if(Check_NpcName(playerid)) return 1;
	}
	#endif

	//SendClientCheck(playerid, 0x46, 313, 0, 28); // Поверяем наличие кастомных скинов
	
	if(openserv == 1) return Kickx(playerid); // Кикаем игрока, если сервер закрыт

