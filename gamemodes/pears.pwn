stock continue_reg(playerid)
{
	if(gZaregal[playerid] == 0)
	{
		HideMainLogoServer(playerid);
	    PlayerPlaySound(playerid,30801,0,0,0);
		LoadTextDraw(playerid);
		ACSetPlayerHealth(playerid,GetMaxPlayerHealth(playerid));
		gZaregal[playerid] = 1;
		PlayerInfo[playerid][pSex] = 1;
		PlayerInfo[playerid][pAData] = gettime()+864000;
		PlayerInfo[playerid][pModel] = RegMaleSkin[0];
		m_custom_sync_SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);
		PPExitSpectating(playerid);
		ACSetPlayerHealth(playerid,GetMaxPlayerHealth(playerid));
		oSetPlayerMoney(playerid, 8000); // деньги при регистрации
		GoShmot(playerid, 0);
	}
	return 1;
}
stock AchievePlayer(playerid, ach, quan)
{
	if(PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pAchieveLoad] == true)
	{
		if(ach >= 87 && ach <= 94)
		{
		    PlayerInfo[playerid][pAchieveStat][ach-87] += quan;
	        if(PlayerInfo[playerid][pAchieveStat][ach-87] >= achieveStat[ach-87] && PlayerInfo[playerid][pAchieve][ach] == 0) return GiveAchievePlayer(playerid, ach);
	        UpdateAchieve(playerid, ach);
		}
		else
		{
			if(PlayerInfo[playerid][pAchieve][ach] == 0) GiveAchievePlayer(playerid, ach);
		}
	}
    return 1;
}

stock achieve_name_gift(type) // Описание подарок для ачивок
{
	new string[14];
	if(type == 0) string = "1000$";
	else if(type == 1) string = "VIP на 5 Дней";
	else if(type == 2) string = "5000$";
	else if(type == 3) string = "50000$";
	else if(type == 4) string = "500000$";
	else if(type == 5) string = "Аксессуар";
	return string;
}
stock GiveAchievePlayer(playerid, ach)
{
    new unix = gettime();
 	PlayerInfo[playerid][pAchieve][ach] = 1;
 	PlayerInfo[playerid][pAchieveUnix][ach] = unix;
 	PlayerInfo[playerid][pAchievequan] ++;
 	if(unix > sound[playerid] && OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/achieve.mp3"), sound[playerid] = unix+2;
 	new atext[14], fall;

	if(achieveType[ach] == 0) 
	{
		atext = "1000$", oGivePlayerMoney(playerid, 1000); // Обычный
		MoneyLog("achieve", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 1000, "Обычный");
	}
	else if(achieveType[ach] == 1) // Специальный
	{
		if(PlayerInfo[playerid][pDonateRank] <= 2)
  		{
  		    atext = "VIP на 5 Дней";
		    PlayerInfo[playerid][pDonateRank] = 1, givevip(playerid, 5);
		    mysql_save(playerid, 4);
    	}
    	else 
		{
			atext = "5000$", oGivePlayerMoney(playerid, 5000);
			MoneyLog("achieve", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 5000, "Специальный");
		}
	}
	else if(achieveType[ach] == 2) 
	{
		atext = "5000$", oGivePlayerMoney(playerid, 5000); // Сложный
		MoneyLog("achieve", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 5000, "Сложный");
	}
	else if(achieveType[ach] == 3) 
	{
		atext = "50000$", oGivePlayerMoney(playerid, 50000); // Очень Сложный
		MoneyLog("achieve", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 50000, "Очень Сложный");
	}
 	else if(achieveType[ach] == 4) 
	{
		atext = "500000$", oGivePlayerMoney(playerid, 500000); // Нереальный
		MoneyLog("achieve", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 500000, "Нереальный");
	}
 	else if(achieveType[ach] == 5) // Очень Сложный (Особый)
 	{
 	    atext = "Аксессуар";
 	    new put_inva = GiveThingPlayer(playerid, 1274, 1, 1, 0, 2, 0, 9999);
 	    if(put_inva == -1) Throw(playerid, 1274, 1, 1, 0, 2, 0);
 	}

	// Общик Донат 30к
	if(ach == 41)
	{
		new i = GetIdAccessory(12104); // Получаем ID аксессуара внутри системы
		if(i >= 0) // Нашли аксессуар
		{
			atext = "Аксессуар";
 	    	new put_inva = GiveThingPlayer(playerid, AccessoryInfo[i][acModel], 1, AccessoryInfo[i][acBone], 0, 2, 0, 9999);
 	    	if(put_inva == -1) Throw(playerid, AccessoryInfo[i][acModel], 1, AccessoryInfo[i][acBone], 0, 2, 0);
		}
	}
	
	SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Достижение ]: {99ff66}%s {cccccc}| %s {ff9000}Подарок: %s", achieveName[ach], achieveAction[ach], atext);
  	if(fall == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет места в инвентаре, аксессуар упал на землю");
   	UpdateAchieve(playerid, ach);
   	achieve_quan[ach] ++;

	new string[120];
   	mysql_format(pearsq, string, sizeof(string), "UPDATE `achieve_server` SET `a%d`='%d' WHERE `newid`='1'", ach, achieve_quan[ach]);
	query_empty(pearsq, string);
   	mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Achievequan`='%d' WHERE `user_id`='%d'",PlayerInfo[playerid][pAchievequan],PlayerInfo[playerid][pID]);
	query_empty(pearsq, string);
	return 1;
}

