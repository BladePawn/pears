				if(JustOneThingInventory(BizzInfo[b][bProduct][i], BizzInfo[b][bTypeProduct][i]) && get_invent(playerid, BizzInfo[b][bProduct][i], BizzInfo[b][bTypeProduct][i]) > 0) return ErrorMessage(playerid, "{FF6347}У вас уже есть этот предмет");
				
