	PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][7], 0.000000, 0.000000);
	PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][7], 4.38, -31.266716); // -0.500 - минимум | -31.0 - максимум
