CMD:admin(playerid)
{
    if(PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Вы не администратор");
	if(gSpectateID[playerid] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы не следите за игроком");
	if(!IsOnline(gSpectateID[playerid])) return ErrorMessage(playerid, "{FF6347}Игрок, за которым вы следили, отключился");
	
	new str[88],sctring[704], PlayerName[21];
	if(NameTag[gSpectateID[playerid]] == true) format(str,sizeof(str),"{ff9000}%s[%d] {cccccc}[Имя скрыто]", PlayerInfo[gSpectateID[playerid]][pName], gSpectateID[playerid]), strcat(sctring,str);
	else
	{
	    if(gSign[gSpectateID[playerid]] == true)
		{
		    GetPlayerName(gSpectateID[playerid],PlayerName,sizeof(PlayerName));
			format(str,sizeof(str),"{ff9000}%s[%d] {cccccc}[Имя изменено на %s]", PlayerInfo[gSpectateID[playerid]][pName], gSpectateID[playerid], PlayerName), strcat(sctring,str);
		}
	    else format(str,sizeof(str),"{ff9000}%s[%d]", PlayerInfo[gSpectateID[playerid]][pName], gSpectateID[playerid]), strcat(sctring,str);
	}
    
    if(PlayerInfo[gSpectateID[playerid]][pReportStat] >= 1) format(str,sizeof(str),"\n{ff9000}Посмотреть обращение"), strcat(sctring,str);
    else format(str,sizeof(str),"\n{cccccc}Обращения {FF6347}нет"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Статистика"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Kick"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Mute"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Prison"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Warn"), strcat(sctring,str);
    format(str,sizeof(str),"\n{FF6347}Ban"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Amute"), strcat(sctring,str);
	ShowDialog(playerid,1243,DIALOG_STYLE_TABLIST_HEADERS,"{cccccc}Действия с игроком",sctring,"Выбрать","Отмена");
	return 1;
}
CMD:vacation(playerid, const params[])
{
	new string[144];
	if(!sscanf(params, "s[121]",params[0])) // Ввёл ID
	{
		if(PlayerInfo[playerid][pSoska] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать [ Настройки неактива другого игрока доступна только админам ]");
		if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинный никнейм [ Лимит 20 символов ]");
		if(AntiFloodMysqlRequest(playerid, 30)) return 1;
		new giveplayerid;
		giveplayerid = ReturnUser(params[0], 1);
		if(IsOnline(giveplayerid))
		{
			mysql_format(pearsq, string,sizeof(string),"SELECT VacBeg, VacEnd FROM `pp_igroki` WHERE `Name` = '%e'", PlayerInfo[giveplayerid][pName]);
			mysql_tquery(pearsq, string, "Call_vacation", "ds", playerid, PlayerInfo[giveplayerid][pName]);
		}
		else
		{
			if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			mysql_format(pearsq, string,sizeof(string),"SELECT VacBeg, VacEnd FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
			mysql_tquery(pearsq, string, "Call_vacation", "ds", playerid, params[0]);
		}
	    return 1;
	}
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pLeader] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	mysql_format(pearsq, string,sizeof(string),"SELECT VacBeg, VacEnd FROM `pp_igroki` WHERE `Name` = '%e'", PlayerInfo[playerid][pName]);
	mysql_tquery(pearsq, string, "Call_vacation", "ds", playerid, PlayerInfo[playerid][pName]);
	return 1;
}
stock guardmoney(playerid)
{
	new minute = GuardTime[playerid]/60, g = GuardOrg[playerid];
	if(minute >= 1)
	{
		GivePlayerUnit(playerid, minute*OrganInfo[g][gUnit][1]);
		new string[60];
		format(string,sizeof(string),"Дежурство на посту (%d мин)",minute);
		MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", minute*OrganInfo[g][gUnit][1], string);
	}
}
CMD:safeguard(playerid)
{
	if(IsPoliceMember(playerid) || PlayerInfo[playerid][pMember] == 3 || PlayerInfo[playerid][pLeader] == 3)
	{
		new atext[2], string[164];
		if(PlayerInfo[playerid][pSex] == 1) atext = "";
		else atext = "а";
	    if(Guard[playerid] >= 1)
	    {
	    	SetPlayerChatBubble(playerid,"покидает пост",COLOR_PURPLE,20.0,3000);
			format(string,sizeof(string),"[ Мысли ]: Я {FF6347}покинул%s {cccccc}пост для наблюдения [ Моё время: {ff9000}%d мин {cccccc}]",atext,GuardTime[playerid]/60);
			SendClientMessage(playerid, COLOR_GREY, string);
			PlayerPlaySound(playerid,6401,0,0,0);

			ExitGuard(playerid);
	    }
	    else
	    {
	    	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
   			new g = fraction(playerid), yes, g2;
   			g2 = g;
			for(new x = 0; x < 20; x++)
	    	{
	    		if(OrganInfo[g][gGuardStat][x] >= 1 && IsPlayerInRangeOfPoint(playerid, 15.0,OrganInfo[g][gGu_X][x],OrganInfo[g][gGu_Y][x],OrganInfo[g][gGu_Z][x])
				&& OrganInfo[g][gGuInt][x] == GetPlayerInterior(playerid) && OrganInfo[g][gGuWorld][x] == GetPlayerVirtualWorld(playerid)) yes = x+1;
			}
			if(yes >= 1)
			{
				//if(OrganInfo[g][gGuOccup][yes-1] >= OrganInfo[g][gUnitStat][8]) return format(string,sizeof(string),"[ Мысли ]: Максимальное количество человек на посту: %d",OrganInfo[g][gUnitStat][8]), SendClientMessage(playerid, COLOR_GREY, string);
				if(OrganInfo[g2][glave] < 10000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На счету организации недостаточно средств для оплаты моей работы");
				Guard[playerid] = yes;
				GuardTime[playerid] = 0;
				GuardOrg[playerid] = g;
				SetPlayerChatBubble(playerid,"занимает пост",COLOR_PURPLE,20.0,3000);
				format(string,sizeof(string),"[ Мысли ]: Я {99ff66}встал%s {cccccc}на пост для наблюдения [ {ff9000}1 мин {cccccc}= {99ff66}%d$ {cccccc}]",atext,OrganInfo[g][gUnit][1]);
				SendClientMessage(playerid, COLOR_GREY, string);
				PlayerPlaySound(playerid,45400,0,0,0);
				OrganInfo[g][gGuOccup][yes-1] ++;
				UpdateGuard(g, Guard[playerid]-1);
				TextDrawShowForPlayer(playerid, MindDraw[4]);
				PlayerTextDrawSetString(playerid, MindDraw3, "00:00");
				PlayerTextDrawShow(playerid, MindDraw3);
			}
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поблизости нет поста охраны, доступного для меня");
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только для сотрудников силовых структур");
	return 1;
}
CMD:guard(playerid)
{
	if(IsPoliceMember(playerid) || PlayerInfo[playerid][pMember] == 3 || PlayerInfo[playerid][pLeader] == 3)
	{
	    new g = fraction(playerid), str[44],sctring[860];
		for(new x = 0; x < 20; x++)
    	{
    	    if(OrganInfo[g][gGuardStat][x] >= 1)
			{
				if(OrganInfo[g][gGuOccup][x] >= 1) format(str,sizeof(str),"{ff9000}Пост № %d {99ff66}[%d чел]\n",x+1, OrganInfo[g][gGuOccup][x]), strcat(sctring,str);
				else format(str,sizeof(str),"{ff9000}Пост № %d {cccccc}[без охраны]\n",x+1), strcat(sctring,str);
			}
			else format(str,sizeof(str),"{cccccc}Пост № %d: {444444}Не установлен\n",x+1), strcat(sctring,str);
		}
    	ShowDialog(playerid,973,DIALOG_STYLE_LIST,"{ff9000}Посты Наблюдения",sctring,"Выбор","Отмена");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только для сотрудников силовых структур");
	return 1;
}
CMD:map(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pMedia] != 3) return ErrorMessage(playerid, "{FF6347}Это действие вам недоступно [ Админ 4+ ]");
	PlayerPlaySound(playerid,40405,0,0,0);
   	new str[124],sctring[700];
   	format(str,sizeof(str),"{cccccc}Загружено Карт: {ff9000}%d/5 \t", getmaploaded()), strcat(sctring,str);
   	format(str,sizeof(str),"\n{99ff66}Загрузить \t"), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Сохранить \t"), strcat(sctring,str);
   	format(str,sizeof(str),"\n{FF6347}Удалить из Базы \t"), strcat(sctring,str);
   	if(labelobj[playerid] == false) format(str,sizeof(str),"\n{cccccc}3D Метки {FF6347}[ Off ] \t"), strcat(sctring,str);
	else if(labelobj[playerid] == true) format(str,sizeof(str),"\n{cccccc}3D Метки {99ff66}[ On ] \t"), strcat(sctring,str);
	if(bar == 0) format(str,sizeof(str),"\n{cccccc}Бар {FF6347}[ Off ] \t"), strcat(sctring,str);
	else if(bar == 1) format(str,sizeof(str),"\n{cccccc}Бар {99ff66}[ On ] \t"), strcat(sctring,str);
   	
   	for(new i = 0; i < MAX_MAP; i++)
   	{
   	    if(MapInfo[i][mapload] == 1) format(str,sizeof(str),"\n{cccccc}[ID %d] {ff9000}%s \t {cccccc}%d Объектов", i, MapInfo[i][mapname], MapInfo[i][quanobject]), strcat(sctring,str);
   	    else format(str,sizeof(str),"\n{cccccc}[ID %d] {444444}no map \t", i), strcat(sctring,str);
   	}
   	format(str,sizeof(str),"\n{cccccc}Список Карт >> \t"), strcat(sctring,str);
	ShowDialog(playerid,329,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Карты Мероприятий",sctring,"Выбор","Отмена");
	return 1;
}
CMD:desktop(playerid)
{
	if(OnlineInfo[playerid][oShowInterface] == 13 && Komputer[playerid] == 2)
	{
	    PlayerPlaySound(playerid,17803,0,0,0);
       	new str[24],sctring[340];
       	if(HoldQuan[playerid] <= 1) format(str,sizeof(str),"{ff9000}Без Обоев\n"), strcat(sctring,str);
       	else format(str,sizeof(str),"{cccccc}Без Обоев\n"), strcat(sctring,str);
       	for(new i = 2; i < 16; i++)
       	{
       		if(HoldQuan[playerid] == i) format(str,sizeof(str),"{ff9000}%d.\n", i-1), strcat(sctring,str);
       		else format(str,sizeof(str),"{cccccc}%d.\n", i-1), strcat(sctring,str);
		}
    	ShowDialog(playerid,1206,DIALOG_STYLE_LIST,"{ff9000}Фон рабочего стола",sctring,"Выбор","Отмена");
	}
	return 1;
}
CMD:togwh(playerid)
{
	new unix = gettime();
	if(Flood[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не так быстро [ Подождите немного ]"), PlayerPlaySound(playerid,4203,0,0,0);
	Flood[playerid] = unix+2;
    if(get_invent4(playerid, 26, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
    if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника]");
    if(GetPlayerVip(playerid) == 0 && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете выключить сим карту\nТребуется VIP [ Y >> Donate или /donate  ]");
	if(PlayerInfo[playerid][pSim] == 0)
	{
		PlayerInfo[playerid][pSim] = 1;
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мне никто не сможет позвонить или написать сообщение {FF6347}[ Сим Карта Off ]");
	}
	else if(PlayerInfo[playerid][pSim] == 1)
	{
		PlayerInfo[playerid][pSim] = 0;
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мне смогут позвонить или написать сообщение {99ff66}[ Сим Карта On ]");
	}
	mysql_save(playerid, 50);
	pc_cmd_mm(playerid);
	return 1;
}

