CMD:asellbiz(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Продать бизнесс [ /asellbiz ID ]");
    if(params[0] <= 0 || params[0] >= 201) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
    if(BizzInfo[params[0]][bSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот бизнес никому не принадлежит");
    new para1;
	para1 = ReturnUser(BizzInfo[params[0]][bVlad], 1);
	new string[84];
    format(string, sizeof(string), " [ ADM ]: Админ %s продал бизнес № %d",PlayerInfo[playerid][pName],params[0]);
    ABroadCast(COLOR_ADM,string,1);
    format(string, sizeof(string), "[ Мысли ADM ]: Бизнес принадлежал %s [User: %d]", BizzInfo[params[0]][bVlad],BizzInfo[params[0]][bSost]);
    SendClientMessage(playerid, COLOR_GREY, string);
	if(IsOnline(para1))
	{
		if(BizzInfo[params[0]][bSost] == PlayerInfo[para1][pID]) PlayerInfo[para1][pBusiness] = 0;
	}
	AdminLog("asellbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Слил Бизнес");
	BizLog("asellbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Слил Бизнес");
	BizzInfo[params[0]][bPastime] = 0;
	BizzInfo[params[0]][bData] = 0;
	BizzInfo[params[0]][bSost] = 0;
	BizzInfo[params[0]][bSell] = 0;
	if(BizzInfo[params[0]][bFam] >= 1)
 	{
 		if(FamilyInfo[BizzInfo[params[0]][bFam]][fSost] >= 1) famdeat_biz(BizzInfo[params[0]][bFam], params[0]), SaveFamily(BizzInfo[params[0]][bFam]);
		BizzInfo[params[0]][bFam] = 0;
	}
	BizzInfo[params[0]][bArest] = 0;
	BizzInfo[params[0]][bSchet] = 0;
	bizsbrosprava(params[0]);
	strmid(BizzInfo[params[0]][bVlad], "none", 0, strlen("none"), 24);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
 	GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~Бизнес Продан"), 7000, 3);
    if(BizzInfo[params[0]][bLab] == 1) UpdateBizLabel(params[0], BizzInfo[params[0]][bLab]);
    SaveBizz(params[0]);
	return 1;
}

CMD:givemoneybiz(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 23) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Начислить деньги на счёт бизнеса [ /givemoneybiz ID Бизнеса Сумма ]");
	if(params[0] <= 0 || params[0] >= 201) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
	if(params[1] > 100000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сумма не меньше 1$ и не больше 100.000.000$");
	new string[124];
	format(string, sizeof(string), " [ ADM ]: %s начислил %d$ на счёт бизнеса № %d", PlayerInfo[playerid][pName],params[1],params[0]);
	ABroadCast(COLOR_ADM,string,1);
	BizzInfo[params[0]][bSchet] += params[1];
	SaveBizz(params[0]);
	{
		new log_str[64];
		format(log_str, sizeof(log_str), "Начислил на счёт бизнеса №%d", params[0]);
		AdminLog("givemoneybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], log_str);
	}
	return 1;
}

alias:abizlvl("bizlvl")
CMD:abizlvl(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_MANAGER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить уровень бизнеса [ /abizlvl ID Уровень ] {ffcc00}[ Выше 50 - Зарезервирован ]");
	if(params[0] <= 0 || params[0] >= 201) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
	if(params[1] > 100 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Уровень бизнеса не меньше 1 и не больше 100 {ffcc00}[ Выше 50 - Зарезервирован ]");
	new string[124];
	if(params[1] <= 49) format(string, sizeof(string), " [ ADM ]: %s изменил уровень бизнеса № %d {cccccc}[%d]", PlayerInfo[playerid][pName],params[0],params[1]);
	else format(string, sizeof(string), " [ ADM ]: %s зарезервировал бизнес № %d", PlayerInfo[playerid][pName],params[0]);
	ABroadCast(COLOR_ADM,string,1);
	new last_level = BizzInfo[params[0]][bLevel];
	BizzInfo[params[0]][bLevel] = params[1];
	SaveBizz(params[0]);
	if(BizzInfo[params[0]][bLab] == 1) UpdateBizLabel(params[0], BizzInfo[params[0]][bLab]);
	{
		new log_str[128];
		format(log_str, sizeof(log_str), "Изменил уровень бизнеса № %d [ Было: %d ]", params[0], last_level);
		AdminLog("abizlvl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], log_str);
	}
	return 1;
}
CMD:abizdep(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Очистить депозит в бизнесе [ /abizdep ID ]");
	if(params[0] <= 0 || params[0] >= 201) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
	
	new last_dep = BizzInfo[params[0]][bDeposit];
	new string[100];
	format(string, sizeof(string), " [ ADM ]: %s очистил депозит бизнеса № %d {cccccc}[ Было: %d$ ]", PlayerInfo[playerid][pName], params[0], last_dep);
	ABroadCast(COLOR_ADM,string,1);
	BizzInfo[params[0]][bDeposit] = 0, SaveBizz(params[0]);
	{
		new log_str[128];
		format(log_str, sizeof(log_str), "Очистил депозит бизнеса № %d [ Было: %d$ ]", params[0], last_dep);
		AdminLog("abizdep", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], log_str);
	}
	return 1;
}

CMD:fdom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Вы не можете это сделать");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заморозить автослив дома [ /fdom № Дома ] (0 - Все дома)");
    if(params[0] > 1000 || params[0] < 0) return ErrorMessage(playerid, "{FF6347}Номер дома от 1 до 1000 (0 - Все дома)");
	new string[84], quan;
    if(params[0] == 0)
    {
    	for(new d = 1; d < sizeof(DomInfo); d++)
    	{
    		if(DomInfo[d][dFreeze] == 0) DomInfo[d][dFreeze] = 1, quan ++, SaveDom(d);
    	}
    	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Все дома уже заморожены");
    	GameTextForPlayer(playerid, "~w~All house: ~b~Freeze", 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s заморозил все дома", PlayerInfo[playerid][pName]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Заморозил все дома");
    }
    else
    {
        if(DomInfo[params[0]][dFreeze] == 1) return ErrorMessage(playerid, "{FF6347}Этот дом уже заморожен");
    	DomInfo[params[0]][dFreeze] = 1, SaveDom(params[0]);
    	format(string, sizeof(string), "~w~House %d: ~b~Freeze", params[0]), GameTextForPlayer(playerid, string, 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s заморозил дом № %d", PlayerInfo[playerid][pName], params[0]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Заморозил дом");
    
    }
	return 1;
}
CMD:unfdom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Вы не можете это сделать");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разморозить автослив дома [ /unfdom № Дома ] (0 - Все дома)");
    if(params[0] > 1000 || params[0] < 0) return ErrorMessage(playerid, "{FF6347}Номер дома от 1 до 1000 (0 - Все дома)");
	new string[84], unix = gettime(), quan;
    if(params[0] == 0)
    {
    	for(new d = 1; d < sizeof(DomInfo); d++)
    	{
    		if(DomInfo[d][dFreeze] == 1)
			{
			    quan ++;
			    DomInfo[d][dPastime] = 0;
				DomInfo[d][dData] = unix+2592000;
				DomInfo[d][dFreeze] = 0;
				SaveDom(d);
			}
    	}
    	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Нет ни одного замороженного дома");
    	GameTextForPlayer(playerid, "~w~All house: ~y~Unfreeze", 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s разморозил все дома", PlayerInfo[playerid][pName]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("unfdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Разморозил все дома");
    }
    else
    {
    	if(DomInfo[params[0]][dFreeze] == 0) return ErrorMessage(playerid, "{FF6347}Этот дом не заморожен");
	 	DomInfo[params[0]][dPastime] = 0;
		DomInfo[params[0]][dData] = unix+2592000;
		DomInfo[params[0]][dFreeze] = 0;
		SaveDom(params[0]);
    	format(string, sizeof(string), "~w~House %d: ~y~Unfreeze", params[0]), GameTextForPlayer(playerid, string, 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s разморозил дом № %d", PlayerInfo[playerid][pName], params[0]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("unfdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Разморозил дом");

    }
	return 1;
}
CMD:fbiz(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Вы не можете это сделать");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заморозить автослив бизнеса [ /fbiz № Бизнеса ] (0 - Все бизнесы)");
    if(params[0] > 200 || params[0] < 0) return ErrorMessage(playerid, "{FF6347}Номер бизнеса от 1 до 200 (0 - Все бизнесы)");
	new string[84], quan;
    if(params[0] == 0)
    {
    	for(new b = 1; b < sizeof(BizzInfo); b++)
    	{
    		if(BizzInfo[b][bFreeze] == 0) BizzInfo[b][bFreeze] = 1, quan ++, SaveBizz(b);
    	}
