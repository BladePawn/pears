	case 464:
	{
		if(response)
		{
			if(!strlen(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу регистрировать семью без названия"), pc_cmd_donate(playerid);
			if(PlayerInfo[playerid][pFamily] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня уже есть семья [ /fam ]");
			new fam = DP[0][playerid];
      		if(fam > 500 || fam < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер семьи не меньше 1 и не больше 500");
         	if(PlayerInfo[playerid][pDonateMoney] < donatePrice[2]) return format(string,sizeof(string),"[ Мысли ]: У меня нет %d грамм золота [ Y >> Донат или /donate ]",donatePrice[2]), SendClientMessage(playerid,COLOR_GREY,string);
          	if(strlen(inputtext) < 3 || strlen(inputtext) > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Название не меньше 3 и не больше 30 символов"), pc_cmd_donate(playerid);
           	if(checksimvol(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хм... я пытаюсь указать в названии какие-то каракули... [ Запрещённый Символ ]"), pc_cmd_donate(playerid);
            if(FamilyInfo[fam][fSost] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер этой семьи занят"), pc_cmd_donate(playerid);
            new unix = gettime();
            Kolfam ++;
            FamilyInfo[fam][fOwner] = PlayerInfo[playerid][pID]; // Привязка семьи к номеру аккаунта
            FamilyInfo[fam][fLoss] = unix+2592000;
            FamilyInfo[fam][fSost] = 1; // Состояние семьи ( 1 = куплено )
            strmid(FamilyInfo[fam][fName], inputtext, 0, 64); // Устанавливаем название семьи
			format(FamilyInfo[fam][fOsn], 24, "%s", PlayerInfo[playerid][pName]);

			// Сбрасываем названия рангов
			for(new r = 0; r < MAX_RANK_FAMILY; r++) format(FamilyRankName[fam][r], MAX_NAME_FAMILY_LENGTH, "%d Ранг", r + 1);

            FamilyInfo[fam][fSpawnX] = 0.0; // Позиция X
            FamilyInfo[fam][fSpawnY] = 0.0; // Позиция Y
            FamilyInfo[fam][fSpawnZ] = 0.0; // Позиция Z
            FamilyInfo[fam][fInt] = GetPlayerInterior(playerid); // Интерьер в котором находится
            FamilyInfo[fam][fWorld] = GetPlayerVirtualWorld(playerid); // Вирт мир в котором находится
            FamilyInfo[fam][fStatusUch] = 0; // Количество участников максимум 10
            FamilyInfo[fam][fStatusRank] = 0; // Ранги изменять нельзя
            FamilyInfo[fam][fStatusSpawn] = 0; // Спавна нет
            FamilyInfo[fam][fDop1] = 1; // Количество участников в семье (включая меня)
            FamilyInfo[fam][fDop2] = 0;
            FamilyInfo[fam][fDop3] = 0;
            FamilyInfo[fam][fDop4] = 0;
            FamilyInfo[fam][fDop5] = 0;
            FamilyInfo[fam][fMoney] = 0, FamilyInfo[fam][fInvmon] = 0;
			FamilyInfo[fam][fAccoff] = 10, FamilyInfo[fam][fAccdip] = 10, FamilyInfo[fam][fAccmoninv] = 10;
			FamilyInfo[fam][fAccmonget] = 10, FamilyInfo[fam][fAccdom] = 10, FamilyInfo[fam][fAccbiz] = 10;
			FamilyInfo[fam][fAccname] = 10, FamilyInfo[fam][fAccrank] = 10, FamilyInfo[fam][fAccspawn] = 10;
			FamilyInfo[fam][fAccgarage] = 10, FamilyInfo[fam][fAcclog] = 10, FamilyInfo[fam][fAccdon] = 10;
			FamilyInfo[fam][fAccveh] = 10, FamilyInfo[fam][fAccinv] = 10, FamilyInfo[fam][fAccuninv] = 10;
			FamilyInfo[fam][fAccgiver] = 10, FamilyInfo[fam][fAccfammu] = 10, FamilyInfo[fam][fAccfamfo] = 10;
			FamilyInfo[fam][fBiz][0] = 0, FamilyInfo[fam][fBiz][1] = 0, FamilyInfo[fam][fBiz][2] = 0, FamilyInfo[fam][fBiz][3] = 0, FamilyInfo[fam][fBiz][4] = 0;
			FamilyInfo[fam][fBiz][5] = 0, FamilyInfo[fam][fBiz][6] = 0, FamilyInfo[fam][fBiz][7] = 0, FamilyInfo[fam][fBiz][8] = 0, FamilyInfo[fam][fBiz][9] = 0;
			FamilyInfo[fam][fRanks] = 10;
			FamilyInfo[fam][fStreetRacersID] = -1;
            PlayerInfo[playerid][pDonateMoney] -= donatePrice[2];
			tclArifmetikAllGold-= donatePrice[2];
   	        PlayerPlaySound(playerid,40405,0,0,0);
   	        PlayerInfo[playerid][pFamily] = fam;
   	        PlayerInfo[playerid][pFamrank] = 10;
            format(string, sizeof(string), "{ffffff}Вы основали свою семью за {ff0000}%d грамм золота\n{ffffff}На вашем счёту осталось: {ffcc00}%d грамм золота\n{ffffff}Название: {0088ff}%s \n\n{ffffff}Полное управление {0088ff}[ /fam ]",donatePrice[2],PlayerInfo[playerid][pDonateMoney],inputtext);
            ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}*** {ffffff} Family {0088ff}***",string,"Ок","");
            mysql_save(playerid, 4);
            mysql_save(playerid, 13);
            FamilyLog(fam, "registr", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Создал семью");
            new f_str[128];
            mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_family` SET `id` = '%d', `bd` = 'famka'", fam);
	        query_empty(pearsq, f_str);
            SaveStuff();
            SaveFamily(fam);
            if(PlayerInfo[playerid][pAchieve][18] == 0) AchievePlayer(playerid, 18, 1);

			format(string, sizeof(string), "Основал семью № %d", fam);
			DonateLog("registr",  PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -donatePrice[2], string);
            return 1;
		}
	}
