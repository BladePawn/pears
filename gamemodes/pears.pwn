CMD:password(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
    new pass[64];
	if(!sscanf(params, "s[64]",pass))
	{
		if(strfind(pass,"0",true) != (-1)) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сервер {99ff66}снят {cccccc}с пароля");
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Пароль от сервера установлен: {FF6347}%s", pass);
		SetServerPassword(pass);
		AdminLog("password", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, pass);
	}
	return 1;
}

stock SetServerPassword(const password[]) // Установка пароля
{
	new string[84];
	format(serverPass, sizeof(serverPass), password);
	format(string, sizeof(string),"password %s", serverPass);
	SendRconCommand(string);
	return 1;
}

stock resetsupport(playerid)
{
	if(DP[0][playerid] == 0) pc_cmd_report(playerid);
	else pc_cmd_help(playerid);
	return 1;
}
stock givevip(playerid, day)
{
    new unix = gettime();
    if(PlayerInfo[playerid][pUpgrade] > unix) PlayerInfo[playerid][pUpgrade] += 86400*day;
	else PlayerInfo[playerid][pUpgrade] = unix+86400*day;
	return 1;
}

stock GetVehiclePartPos(vehicleid,partid,&Float:tx,&Float:ty,&Float:tz,Float:offset_x=0.0,Float:offset_y=0.0,Float:offset_z=0.0)
{
	new Float:x,Float:y,Float:z,Float:rx,Float:ry,Float:rz;
	GetVehiclePos(vehicleid,x,y,z);
	Tryg3D::GetVehicleRotation(vehicleid,rx,ry,rz);
	GetVehicleZAngle(vehicleid,rz);
	return Tryg3D::GetPartPos(GetVehModelOriginal(VehInfo[vehicleid][vModel]),partid,x,y,z,rx,ry,rz,tx,ty,tz,offset_x,offset_y,offset_z);
}
stock Tryg3D::GetPartPos(modelid,partid,Float:x,Float:y,Float:z,Float:rx,Float:ry,Float:rz,&Float:tx,&Float:ty,&Float:tz,Float:offset_x=0.0,Float:offset_y=0.0,Float:offset_z=0.0)
{
	new Float:ox,Float:oy,Float:oz;
	switch(partid)
	{
		case VEHICLE_PART_RFTIRE:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_WHEELSFRONT,ox,oy,oz);
		}
		case VEHICLE_PART_LFTIRE:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_WHEELSFRONT,ox,oy,oz);
			ox *= (-1);
			offset_x *= (-1);
		}
		case VEHICLE_PART_RRTIRE:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_WHEELSREAR,ox,oy,oz);
		}
		case VEHICLE_PART_LRTIRE:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_WHEELSREAR,ox,oy,oz);
			ox *= (-1);
			offset_x *= (-1);
		}
		case VEHICLE_PART_HOOD:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_SIZE,ox,oy,oz);
			oy /= 2.0;
			ox = oz = 0.0;
		}
		case VEHICLE_PART_TRUNK:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_SIZE,ox,oy,oz);
			oy /= (-2.0);
			offset_y *= (-1);
			ox = oz = 0.0;
		}
		case VEHICLE_PART_ROOF:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_SIZE,ox,oy,oz);
			oz /= 2.0;
			ox = oy = 0.0;
		}
		case VEHICLE_PART_CHASSIS:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_SIZE,ox,oy,oz);
			oz /= (-2.0);
			offset_z *= (-1);
			ox = oy = 0.0;
		}
		case VEHICLE_PART_PETROLCAP:
		{
			GetVehicleModelInfo(modelid,VEHICLE_MODEL_INFO_PETROLCAP,ox,oy,oz);
		}
	}
	ox += offset_x;
	oy += offset_y;
	oz += offset_z;
	ShiftOffsetToPosition(x,y,z,rx,ry,rz,ox,oy,oz,tx,ty,tz);
	return !(ox == 0.0 && oy == 0.0 && oz == 0.0);
}
stock Float:Tryg3D::CompressRotation(Float:rotation)
{
	return (rotation - floatround(rotation/360.0,floatround_floor)*360.0);
}
stock ShiftVectorRotation(Float:x,Float:y,Float:z,Float:rx,Float:ry,Float:rz,&Float:tx,&Float:ty,&Float:tz)
{
	new Float:T3D:dist = VectorSize(x,y,z);
	if(T3D:dist <= 0.0)
	{
		tx = x, ty = y, tz = z;
		return 0;
	}
	x /= T3D:dist, y /= T3D:dist, z /= T3D:dist;
	new Float:T3D:matrix[3][3];
	Tryg3D::GetRotationMatrixEuler(T3D:matrix,rx,ry,rz);
	Tryg3D::MatrixRotate(T3D:matrix,x,y,z,tx,ty,tz);
	return 1;
}
stock ShiftOffsetToPosition(Float:x,Float:y,Float:z,Float:rx,Float:ry,Float:rz,Float:offset_x,Float:offset_y,Float:offset_z,&Float:tx,&Float:ty,&Float:tz)
{
	new Float:px,Float:py,Float:pz;
	if(!ShiftVectorRotation(offset_x,offset_y,offset_z,rx,ry,rz,px,py,pz)) tx = x, ty = y, tz = z;
	else
	{
		GetRotationFor2Point3D(0.0,0.0,0.0,px,py,pz,rx,rz);
		GetPointInFront3D(x,y,z,rx,rz,VectorSize(offset_x,offset_y,offset_z),tx,ty,tz);
	}
}
stock GetRotationFor2Point3D(Float:x,Float:y,Float:z,Float:tx,Float:ty,Float:tz,&Float:rx,&Float:rz)
{
	new Float:radius = GetDistanceBetweenPoints3D(x,y,z,tx,ty,tz);
	if(radius <= 0.0) return 0;
	rx = Tryg3D::CompressRotation(-(acos((tz-z)/radius)-90.0));
	rz = Tryg3D::CompressRotation(atan2(ty-y,tx-x)-90.0);
	return 1;
}
stock GetPointInFront3D(Float:x,Float:y,Float:z,Float:rx,Float:rz,Float:radius,&Float:tx,&Float:ty,&Float:tz)
{
	tx = x - (radius * floatcos(rx,degrees) * floatsin(rz,degrees));
	ty = y + (radius * floatcos(rx,degrees) * floatcos(rz,degrees));
	tz = z + (radius * floatsin(rx,degrees));
}
stock Tryg3D::GetRotationMatrixEuler(Float:matrix[][],Float:rx,Float:ry,Float:rz)
{
	// could be done with matrix multiplication but would be slower
	new Float:cosX = floatcos(rx,degrees),
	Float:cosY = floatcos(ry,degrees),
	Float:cosZ = floatcos(rz,degrees),
	Float:sinX = floatsin(rx,degrees),
	Float:sinY = floatsin(ry,degrees),
	Float:sinZ = floatsin(rz,degrees);
	matrix[0][0] = cosZ * cosY - sinZ * sinX * sinY;
	matrix[0][1] = -sinZ * cosX;
	matrix[0][2] = cosZ * sinY + sinZ * sinX * cosY;
	matrix[1][0] = sinZ * cosY + cosZ * sinX * sinY;
	matrix[1][1] = cosZ * cosX;
	matrix[1][2] = sinZ * sinY - cosZ * sinX * cosY;
	matrix[2][0] = -cosX * sinY;
	matrix[2][1] = sinX;
	matrix[2][2] = cosX * cosY;
}
stock Tryg3D::MatrixRotate(const Float:matrix[][],Float:oX,Float:oY,Float:oZ,&Float:x,&Float:y,&Float:z)
{
	x += oX * matrix[0][0] + oY * matrix[0][1] + oZ * matrix[0][2]; // M * v | v = [oX, oY, oZ]
	y += oX * matrix[1][0] + oY * matrix[1][1] + oZ * matrix[1][2];
	z += oX * matrix[2][0] + oY * matrix[2][1] + oZ * matrix[2][2];
}
stock Tryg3D::GetVehicleRotation(vehicleid,&Float:rx,&Float:ry,&Float:rz)
{
	new Float:qw,Float:qx,Float:qy,Float:qz;
	GetVehicleRotationQuat(vehicleid,qw,qx,qy,qz);
	Tryg3D::QuatToEuler(rx,ry,rz,qw,qx,qy,qz);
}
stock Tryg3D::QuatToEuler(&Float:rx,&Float:ry,&Float:rz,Float:qw,Float:qx,Float:qy,Float:qz)
{
	rx = Tryg3D::CompressRotation(asin(2*qy*qz-2*qx*qw));
	ry = Tryg3D::CompressRotation(-atan2(qx*qz+qy*qw,0.5-qx*qx-qy*qy));
	rz = Tryg3D::CompressRotation(-atan2(qx*qy+qz*qw,0.5-qx*qx-qz*qz));
}
stock bizdefault(biz, Float:x, Float:y, Float:z)
{
	new sizebiz;
	if(biz >= 13 && biz <= 26) sizebiz = sizeof(SupmarketPos);
	else if(biz >= 123 && biz <= 132) sizebiz = sizeof(AptekaPos);
	for(new i = 0; i < sizebiz; ++i)
	{
	    if(i != biz-123)
	    {
			new Float:dist;
			if(biz >= 13 && biz <= 26) dist = GetDistancePoint(x, y, z, SupmarketPos[i][SupmarketPos_X],SupmarketPos[i][SupmarketPos_Y],SupmarketPos[i][SupmarketPos_Z]);
			else if(biz >= 123 && biz <= 132) dist = GetDistancePoint(x, y, z, AptekaPos[i][AptekaPos_X],AptekaPos[i][AptekaPos_Y],AptekaPos[i][AptekaPos_Z]);
			if(dist <= 5) return 1;
		}
	}
	return 0;
}
stock biznearby(biz, Float:x, Float:y, Float:z)
{
	for(new b = 0; b < sizeof(BizzInfo); b++)
	{
		if(BizzInfo[b][bBizOStat][0] == 1 && biz != b)
		{
			new Float:dist = GetDistancePoint(x, y, z, BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]);
			if(dist <= 5) return 1;
		}
	}
	return 0;
}
stock bizsame(biz, Float:x, Float:y, Float:z)
{
	if(biz >= 13 && biz <= 41 || biz >= 123 && biz <= 142)
	{
		new bmin, bmax;
		if(biz >= 13 && biz <= 26) bmin = 13, bmax = 26;
		else if(biz >= 27 && biz <= 41) bmin = 27, bmax = 41;
		else if(biz >= 123 && biz <= 132) bmin = 123, bmax = 132;
		else if(biz >= 133 && biz <= 142) bmin = 133, bmax = 142;
		else if(biz >= 143 && biz <= 152) bmin = 143, bmax = 152;
		for(new b = bmin; b < bmax; b++)
		{
			if(BizzInfo[b][bBizOStat][0] == 1 && biz != b)
			{
				new Float:dist = GetDistancePoint(x, y, z, BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]);
				if(dist <= 200) return 1;
			}
		}
	}
	return 0;
}
stock termnearby(mybr, Float:x, Float:y, Float:z)
{
	for (new br = 0; br < MAX_BIZ_TERM; br++)
	{
		if (br == mybr) continue;
		
		for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
			if(RentStat[br][i] <= 0) continue;
			
			if(GetDistancePoint(x, y, z, RentPos_X[br][i],RentPos_Y[br][i],RentPos_Z[br][i]) <= 5.0)
			{
				return 1;
			}
		}
	}
	return 0;
}
stock termsame(b, Float:x, Float:y, Float:z)
{
	new bmin, bmax;
	if(b >= 0 && b <= 10) bmin = 0, bmax = 10;
	else if(b >= 11 && b <= 15) bmin = 11, bmax = 15;
	else if(b >= 16 && b <= 25) bmin = 16, bmax = 25;
	else if(b >= 26 && b <= 35) bmin = 26, bmax = 35;
	else if(b >= 36 && b <= 45) bmin = 36, bmax = 45;
	else if(b >= 46 && b <= 55) bmin = 46, bmax = 55;

	for(new br = bmin; br < bmax; br++)
	{
	    for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
		    if(RentStat[br][i] > 0 && br != b)
			{
				new Float:dist = GetDistancePoint(x, y, z, RentPos_X[br][i],RentPos_Y[br][i],RentPos_Z[br][i]);
				if(dist <= 200) return 1;
			}
		}
	}
	return 0;
}
stock isabizdelivery(b)
{
	foreach(Player,i)
	{
		if(GetPVarInt(i,"delivery_biz") == b)
		{
		    return 1;
		}
	}
    return 0;
}

stock putpotato(playerid)
{
	RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), Hold[playerid] = 0;
	PlayerInfo[playerid][pHataCena] += 5;
	new string[84];
	format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d~n~~w~NASA JOB: ~b~%d", 5, PlayerInfo[playerid][pHataCena]);
	GameTextForPlayer(playerid,string,5000,3);
	PPP15[playerid] = 0;
	ApplyAnimation(playerid,"CARRY","putdwn",4.0, false, false, false, false, false);
	mysql_save(playerid, 52);
	update_ability(playerid, 1, 1);
	return 1;
}
stock putfruit(playerid)
{
	if(PlayerInfo[playerid][pPlacement] == 0 || PlayerInfo[playerid][pPlacement] == 9)
    {
		PlayerInfo[playerid][pPlacement] = 9;
		new zp = friskPrice[HoldStat[playerid]]*HoldQuan[playerid];
		PlayerInfo[playerid][pSalary] += zp;
		new string[84];
		format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d$~n~~w~JOB: ~g~%d$", zp, PlayerInfo[playerid][pSalary]);
		GameTextForPlayer(playerid,string,7000,3);
		ApplyAnimation(playerid,"CARRY","putdwn",4.0, false, false, false, false, false);
		mysql_save(playerid, 58);

 		RemovePlayerAttachedObject(playerid,1);
		Hand[playerid] = 0;
		Hold[playerid] = 0;
		HoldStat[playerid] = 0, HoldQuan[playerid] = 0, PPP15[playerid] = 0;
 		update_ability(playerid, 5, 30);
	}
	return 1;
}
stock gethold(playerid, stat, where)
{
	if(Hold[playerid] == stat)
	{
		RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), Hold[playerid] = 0, HoldStat[playerid] = 0, HoldQuan[playerid] = 0;
		if(stat == 8 || stat == 10) PPP15[playerid] = 0, ApplyAnimation(playerid,"CARRY","putdwn",4.0, false, false, false, false, false);
		else ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
	}
	else
	{
  		if(Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вас заняты руки");
		if(stat == 8 && where == 1 && Hand[playerid] == 5) return ErrorMessage(playerid, "{FF6347}Положите ящик с яблоками к другим ящикам, слева");

  		RemovePlayerAttachedObject(playerid,1);
  		if(stat == 6) SetPlayerAttachedObject(playerid, 1, 337, 5, 0.151000, -0.039999, 0.000000, 0.000000, 0.000000, 98.700050, 1.000000, 1.000000, 1.000000, 0, 0), ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false); // Лопата
  		else if(stat == 8)
  		{
  			if(where == 0) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Подойдите на грядку и нажмите ALT, чтобы положить корзинку","*","");
  			else if(where == 1)
  			{
  			    if(PlayerInfo[playerid][pPlacement] >= 1 && PlayerInfo[playerid][pPlacement] != 9) return StopJob(playerid);
  			    if(fruitapp <= 0) return ErrorMessage(playerid, "{FF6347}В садах на деревьях не созрели яблоки\n{cccccc}Яблоки созревают около 5 минут");

  				if(PlayerInfo[playerid][pSalary] <= 0)
			  	{
			  		if(OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/pears.mp3");
					FlyCameraPos(playerid,-13.858218, 41.635250, 15.306873, -9.125063, 41.009277, 13.821811, 2500, 2000);
					SetPVarInt(playerid,"qweststat",1), SetPVarInt(playerid,"qwesttime",4);
					ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{ff9000}Отправляйтесь в сад, чтобы собирать яблоки","Oк","");
			  	}
  			}
  			SetPlayerAttachedObject(playerid, 1, 19639, 6, 0.080999, 0.043999, -0.149000, -106.700027, 0.000000, -10.999998, 1.000000, 1.000000, 1.000000, 0, 0);
			ApplyAnimation(playerid,"CARRY","liftup",4.0, false, true, true, false, 0);
			PPP15[playerid] = 3; // Пустая Корзинка
		}
  		else if(stat == 10) SetPlayerAttachedObject(playerid, 1, 2060, 1, 0.106000, 0.416000, -0.057999, 3.500000, -81.099975, 0.000000, 0.791999, 0.843000, 0.888001, 0, 0), ApplyAnimation(playerid,"CARRY","liftup",4.0, false, true, true, false, 0), PPP15[playerid] = 3; // Мешок с картошкой
		Hold[playerid] = stat, HoldStat[playerid] = 0, HoldQuan[playerid] = 0, PlayerPlaySound(playerid,5600,0,0,0);
	}
	return 1;
}
stock gethand(playerid, stat)
{
	if(Hand[playerid] == stat) // 4
	{
		RemovePlayerAttachedObject(playerid,2), PlayerPlaySound(playerid,5601,0,0,0);
		Hand[playerid] = 0;
		if(stat == 5) HoldStat[playerid] = 0, HoldQuan[playerid] = 0, PPP15[playerid] = 0;
