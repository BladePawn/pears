				else if(s == 158) atext = "Лицензия Водного Транспорта";
				else if(s == 159) atext = "Лицензия Мототранспорта";
				else if(s == 161) atext = "Лицензия на Оружие [1]";
				else if(s == 162) atext = "Лицензия на Оружие [2]";
				else if(s == 160) atext = "Высшее Образование";
				friskPrice[s] = input;
				SavePriceFrisk(s);
			}
			
            PlayerPlaySound(playerid,6401, 0,0,0);
            format(string,sizeof(string),"[ Мысли ]: Гос. стоимость [%s] теперь составляет: {99ff66}%d$ [%s]", atext, input, get_k(input));
