		format(str,sizeof(str),"\n{99ff66}Продать {cccccc}Фишки \t {0088ff}100 Фишек = %d$", 100-BizzInfo[200][bChipsFee]), strcat(sctring,str);
		format(str,sizeof(str),"\n{99ff66}Продать {ffcc00}Gold {cccccc}Фишки \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Купить Игральные Кости \t {99ff66}%d$ {444444}[ %d/%d ]", BizzInfo[200][bPrice][7], BizzInfo[200][bItem][7], maxQuanThingProduct(BizzInfo[200][bProduct][7], BizzInfo[200][bTypeProduct][7])), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}Игровые Комнаты >>"), strcat(sctring,str);
	}
	ShowDialog(playerid,781,DIALOG_STYLE_TABLIST,"{ff9000}Казино",sctring,"Выбор","Отмена"); // DIALOG_STYLE_TABLIST_HEADERS
	return 1;
}
stock PosBuymenuDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 9 || setting_size_draw[playerid] == 9) positiond_x = buymenudraw_x+set_pos_x[playerid], positiond_y = buymenudraw_y+set_pos_y[playerid];
    else positiond_x = buymenudraw_x+PlayerInfo[playerid][pDrawPos_X][8], positiond_y = buymenudraw_y+PlayerInfo[playerid][pDrawPos_Y][8];

	if(setting_pos_draw[playerid] == 9 || setting_size_draw[playerid] == 9) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	else sized_x = PlayerInfo[playerid][pDrawSize_X][8], sized_y = PlayerInfo[playerid][pDrawSize_Y][8];
	
	if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[8], positiond_y += DrawPosSmart_Y[8], sized_y += DrawSizeSmart_Y[8];

	new Float:vrem_x, Float:vrem_y, Float:pusto;
	//248,0 169,0
	new Float:otstyp_x = 4.0+sized_x/8, Float:otstyp_y = 4.0+sized_y/8;
	new Float:size_pick_menu_X = 33.0+sized_x/2, Float:size_pick_menu_Y = 33.0+sized_y/2;
	new Float:size_item_menu_X = 50.0+sized_x/2, Float:size_item_menu_Y = 19.0+sized_y/4;
	
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[0][playerid], positiond_x-otstyp_x, positiond_y-otstyp_y); // Основной Фон
	PlayerTextDrawTextSize(playerid, PlayerBuyDraw[0][playerid], 3.0+(size_pick_menu_X*4)+otstyp_x*2, 3.0+(size_pick_menu_Y*4)+(otstyp_y*2));
	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[0][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[1][playerid], vrem_x-size_item_menu_X-(otstyp_x*2)-otstyp_x, positiond_y-otstyp_y); // Фон Левый
	PlayerTextDrawTextSize(playerid, PlayerBuyDraw[1][playerid], size_item_menu_X+(otstyp_x*2), 4.0+(size_item_menu_Y*5)+(otstyp_y*2));
	
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[0][playerid], positiond_x, positiond_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[1][playerid], positiond_x+1.0+size_pick_menu_X, positiond_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[2][playerid], positiond_x+2.0+size_pick_menu_X*2, positiond_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[3][playerid], positiond_x+3.0+size_pick_menu_X*3, positiond_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[4][playerid], positiond_x, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[5][playerid], positiond_x+1.0+size_pick_menu_X, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[6][playerid], positiond_x+2.0+size_pick_menu_X*2, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[7][playerid], positiond_x+3.0+size_pick_menu_X*3, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[8][playerid], positiond_x, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[9][playerid], positiond_x+1.0+size_pick_menu_X, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[10][playerid], positiond_x+2.0+size_pick_menu_X*2, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[11][playerid], positiond_x+3.0+size_pick_menu_X*3, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[12][playerid], positiond_x, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[13][playerid], positiond_x+1.0+size_pick_menu_X, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[14][playerid], positiond_x+2.0+size_pick_menu_X*2, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_Items[15][playerid], positiond_x+3.0+size_pick_menu_X*3, positiond_y+3.0+size_pick_menu_Y*3);
	for(new i = 0; i < 16; i ++) PlayerTextDrawTextSize(playerid, PlayerBuyDraw_Items[i][playerid], size_pick_menu_X, size_pick_menu_Y);

	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[1][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectFon[0][playerid], vrem_x+otstyp_x, vrem_y+otstyp_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectFon[1][playerid], vrem_x+otstyp_x, vrem_y+otstyp_y+size_item_menu_Y+1.0);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectFon[2][playerid], vrem_x+otstyp_x, vrem_y+otstyp_y+(size_item_menu_Y*2)+2.0);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectFon[3][playerid], vrem_x+otstyp_x, vrem_y+otstyp_y+(size_item_menu_Y*3)+3.0);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectFon[4][playerid], vrem_x+otstyp_x, vrem_y+otstyp_y+(size_item_menu_Y*4)+4.0);
	for(new i = 0; i < 5; i ++) PlayerTextDrawTextSize(playerid, PlayerBuyDraw_SelectFon[i][playerid], size_item_menu_X, size_item_menu_Y);
	
	new Float:razm_left_y, Float:two_x, Float:two_y;
	PlayerTextDrawGetTextSize(playerid, PlayerBuyDraw[1][playerid], pusto, razm_left_y);
	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[0][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[3][playerid], vrem_x-size_item_menu_X-(otstyp_x*2)-otstyp_x, positiond_y-otstyp_y+razm_left_y+otstyp_y); // Кнопка Купить
	PlayerTextDrawGetTextSize(playerid, PlayerBuyDraw[0][playerid], vrem_x, vrem_y);
	PlayerTextDrawTextSize(playerid, PlayerBuyDraw[3][playerid], size_item_menu_X+(otstyp_x*2), vrem_y-razm_left_y-otstyp_y);
	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[3][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlayerBuyDraw[3][playerid], two_x, two_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[2][playerid], vrem_x+two_x/2, vrem_y+(two_y/100)*30); // Надпись Купить
	PlayerTextDrawLetterSize(playerid, PlayerBuyDraw[2][playerid], 0.279783+sized_x*(0.279783/50), 1.189333+sized_y*(1.189333/40)); // Надпись Купить
	
	for(new i = 0; i < 5; i ++)
	{
	    PlayerTextDrawGetPos(playerid, PlayerBuyDraw_SelectFon[i][playerid], vrem_x, vrem_y);
	    PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectPick[i][playerid], vrem_x+1.0, vrem_y); // Иконка выбранного товара
	    PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectName[i][playerid], vrem_x+18.0+sized_x/4, vrem_y+(size_item_menu_Y/100)*10); // Название выбранного товара
	    PlayerTextDrawSetPos(playerid, PlayerBuyDraw_SelectPrice[i][playerid], vrem_x+18.0+sized_x/4, vrem_y+(size_item_menu_Y/100)*55); // Цена выбранного товара
	    
	    PlayerTextDrawTextSize(playerid, PlayerBuyDraw_SelectPick[i][playerid], 14.997057+sized_x/4, size_item_menu_Y); // Иконка выбранного товара
	    PlayerTextDrawLetterSize(playerid, PlayerBuyDraw_SelectName[i][playerid], 0.131687+sized_x*(0.131687/50), 0.643333+sized_y*(0.643333/40)); // Название выбранного товара
	    PlayerTextDrawLetterSize(playerid, PlayerBuyDraw_SelectPrice[i][playerid], 0.131687+sized_x*(0.131687/50), 0.643333+sized_y*(0.643333/40)); // Цена выбранного товара
	}
	
	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[3][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[4][playerid], vrem_x+two_x/2, vrem_y+(two_y/100)*10); // Готовка Заказа
	PlayerTextDrawLetterSize(playerid, PlayerBuyDraw[4][playerid], 0.154557+sized_x*(0.154557/50), 0.708666+sized_y*(0.708666/40)); // Готовка Заказа
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[5][playerid], vrem_x+(two_x/100)*73, vrem_y+(two_y/100)*50); // Время Готовки
	PlayerTextDrawLetterSize(playerid, PlayerBuyDraw[5][playerid], 0.203673+sized_x*(0.203673/50), 0.815999+sized_y*(0.815999/38)); // Время Готовки
	PlayerTextDrawSetPos(playerid, PlayerBuyDraw[6][playerid], vrem_x+1.0-sized_x/8, vrem_y+((two_y/100)*15)+(sized_y/12)); // Модель Микрухи
	PlayerTextDrawTextSize(playerid, PlayerBuyDraw[6][playerid], 30.0+sized_x/2, 30.0+sized_y/2); // Модель Микрухи
	return 1;
}
