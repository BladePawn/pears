            {
				if (map_id == 0) {
					for(new m = 0; m < MAX_MAPOBJECT; m++)
					{
						DestroyDynamic3DTextLabel(MapLabel[m][playerid]);
					}
				}
			    foreach(Player,i)
				{
					if(gRedakt[i] == REDAKT_TYPE_MAP) CloseEditObject(i);
  				}
			    for(new m = 0; m < MAX_MAPOBJECT; m++)
    			{
			        if(IsValidDynamicObject(MapInfo[map_id][mapobject][m])) 
					{
						DestroyDynamicObject(MapInfo[map_id][mapobject][m]);
						MapInfo[map_id][mapobject][m] = INVALID_STREAMER_ID;
					}
		        }
				format(string, sizeof(string), " [ ADM ]: %s выгрузил карту %s",PlayerInfo[playerid][pName], MapInfo[map_id][mapname]), ABroadCast(COLOR_ADM,string,1);
				format(string, sizeof(string), "{0088ff}Карта выгружена: {ffcc66}%s", MapInfo[map_id][mapname]), SendClientMessage(playerid, COLOR_GREY, string);
		        MapInfo[map_id][quanobject] = 0;
		        MapInfo[map_id][mapload] = 0;
            }
        }
        else pc_cmd_map(playerid);
  	}
	case 334:
	{
        if(response)
		{
  			switch(listitem)
 		    {
				case 0: // Начать Мероприятие
				{
					if(Pognalinamp >= 1) return pc_cmd_offmp(playerid);
					if(GameInfo[gamSinfo1] == 0)
					{
						new Float:pX,Float:pY,Float:pZ,Float:pA;
						GetPlayerPos(playerid,pX,pY,pZ);
						GetPlayerFacingAngle(playerid,pA);
						GameInfo[gamX] = pX;
						GameInfo[gamY] = pY;
						GameInfo[gamZ] = pZ;
						GameInfo[gamA] = pA;
						GameInfo[gamInt] = GetPlayerInterior(playerid);
						GameInfo[gamWorld] = GetPlayerVirtualWorld(playerid);
					}
					Pognalinamp = 1; Vremyamp = GameInfo[gamEnterTime];
					OOCOff(COLOR_BLUE,"————————————————————————————————————");
					OOCOff(COLOR_BLUE,"  ");
					format(string, sizeof(string), "*** (( %s[%d] {ffcc66}приглашает вас на мероприятие! {0088ff}[ /mp ] )) ***", PlayerInfo[playerid][pName], playerid), OOCOff(COLOR_BLUE,string);
					if(Ogranmp >= 1) format(string, sizeof(string), "*** (( Лимит участников: {ffcc66}%d {0088ff}игроков )) ***", Ogranmp), OOCOff(COLOR_BLUE,string);
					if(Vremyamp > 0) format(string, sizeof(string), "*** (( Время для входа: {ffcc66}%d {0088ff}сек. )) ***", Vremyamp), OOCOff(COLOR_BLUE,string);
					else if(Vremyamp <= 0) format(string, sizeof(string), "*** (( Время для входа: {ffffff}неограниченно {0088ff})) ***", Vremyamp), OOCOff(COLOR_BLUE,string);
					OOCOff(COLOR_BLUE,"  ");
					OOCOff(COLOR_BLUE,"————————————————————————————————————");
					AdminLog("gomp", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Начал мп");
				}
				case 1: spawnmpdialog(playerid); // Спавн
				case 2: zonempdialog(playerid); // Зона
				case 3: gunmpdialog(playerid); // Оружие
				case 4: skinmpdialog(playerid); // Скин
				case 5: // Условие
				{
					if(GameInfo[gamType] >= 2) GameInfo[gamType] = 0;
					else GameInfo[gamType]++;
				  	pc_cmd_gomp(playerid);
	            }
				case 6: // Отображать иконки на мини-карте
				{
					new str[128];
					GameInfo[gamOffClist] = !GameInfo[gamOffClist];
					foreach(new i: Player)
					{
						if(MPGO[i] == 1)
						{
							if(MPSpawn[i] == 1) SetPlayerColor(i, GameInfo[gamOffClist] ? 0xc8ff0000 : 0xc8ff00AA);
							else if(MPSpawn[i] == 2) SetPlayerColor(i, GameInfo[gamOffClist] ? 0x00ff9900 : 0x00ff99AA);
						}
					}
					format(str, sizeof(str), "{0088ff}[ Мероприятие ] {cccccc}%s[%d] %s Иконки игроков на мини-карте", PlayerInfo[playerid][pName], playerid, GameInfo[gamOffClist] ? "выключил" : "включил");
					if(Pognalinamp > 0) SendMpMessage(str);
					pc_cmd_gomp(playerid);
				}
				case 7: // Отображать никнеймы игроков
	            {
					new str[128];
					GameInfo[gamOffNick] = !GameInfo[gamOffNick];
					foreach(new m: Player)
					{
						if(MPGO[m] == 1)
						{ 
							foreach(new i: Player) 
							{ 
								if(ADUTY[i] == 0) ShowPlayerNameTagForPlayer(i, m, GameInfo[gamOffNick] ? false : true);
							}
						}
					}
					format(str, sizeof(str), "{0088ff}[ Мероприятие ] {cccccc}%s[%d] %s Отображение никнеймов", PlayerInfo[playerid][pName], playerid, GameInfo[gamOffNick] ? "выключил" : "включил");
					if(Pognalinamp > 0) SendMpMessage(str);
					pc_cmd_gomp(playerid);
				}
				case 8: // Ванильный урон
				{
					new str[128];
					GameInfo[gamDamage] = !GameInfo[gamDamage];
					format(str, sizeof(str), "{0088ff}[ Мероприятие ] {cccccc}%s[%d] %s Ванильный урон", PlayerInfo[playerid][pName], playerid, GameInfo[gamDamage] ? "включил" : "выключил");
					if(Pognalinamp > 0) SendMpMessage(str);
					pc_cmd_gomp(playerid);
				}
				case 9: // Урон по союзникам
				{
					new str[128];
					GameInfo[gamTeamKill] = !GameInfo[gamTeamKill];
					format(str, sizeof(str), "{0088ff}[ Мероприятие ] {cccccc}%s[%d] %s Урон по союзникам", PlayerInfo[playerid][pName], playerid, GameInfo[gamTeamKill] ? "включил" : "выключил");
					if(Pognalinamp > 0) SendMpMessage(str);
					pc_cmd_gomp(playerid);
				}
				case 10: // Ограничение по количеству участников
				{
	            	if(Pognalinamp >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мероприятие уже активировано {0088ff}[ /offmp ]"),pc_cmd_gomp(playerid);
        			format(string,sizeof(string),"\n{cccccc}Введите максимальное количество участников на мероприятии\n\n{ff9000}0 - не ограничено\n");
					ShowDialog(playerid,945,DIALOG_STYLE_INPUT,"{ff9000}Управление Мероприятием",string,"Принять","Назад");
				}
				case 11: // Настройка времени к подключению
				{
					if(Pognalinamp >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мероприятие уже активировано {0088ff}[ /offmp ]"),pc_cmd_gomp(playerid);
					format(string,sizeof(string),"\n{cccccc}Введите максимальное время на подключение к мероприятию (в секундах)\n\n{444444}0 - убрать время на вход\n");
					ShowDialog(playerid,MP_DIALOG_TIME_INPUT,DIALOG_STYLE_INPUT,"{ff9000}Управление Мероприятием",string,"Принять","Назад");
				}
	            default: { return 1; }
		    }
	    }
	}
	case MP_DIALOG_TIME_INPUT:
	{
		if(response)
		{
			new time = strval(inputtext);
			if (!sscanf(inputtext, "i", time))
			{
				if(time == 0) return GameInfo[gamEnterTime] = -1, pc_cmd_gomp(playerid);
				if(time < 0 || time > 1200) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 1200"), pc_cmd_gomp(playerid);
				GameInfo[gamEnterTime] = time;
				pc_cmd_gomp(playerid);
			}
			else pc_cmd_gomp(playerid);
	    }
		else pc_cmd_gomp(playerid);
	}
	case MP_DIALOG_SKIN_SELECT:
	{
		if(response)
		{
			ShowDialog(playerid, MP_DIALOG_SKIN_INPUT, DIALOG_STYLE_INPUT, "{ff9000}Скин", "{cccccc}Введите ID скина\n\n{444444}0 - убрать", "Принять", "Отмена");
			Qwerty[0][playerid] = listitem;
	    }
		else pc_cmd_gomp(playerid);
	}
	case MP_DIALOG_SKIN_INPUT:
	{
		if(response)
		{
			new level = strval(inputtext);
			if (!sscanf(inputtext, "i", level))
			{
				if(level == 0) return GameInfo[gamSkin][Qwerty[0][playerid]] = level, skinmpdialog(playerid);
				if(IsASkinExisting(level))
				{
					GameInfo[gamSkin][Qwerty[0][playerid]] = level;
					skinmpdialog(playerid);
				}
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверный ID скина"), skinmpdialog(playerid);
			}
			else skinmpdialog(playerid);
	    }
		else skinmpdialog(playerid);
	}
	case MP_DIALOG_ZONE:
	{
		if(response)
		{
			switch(listitem)
 		    {
				case 0:
				{
					if(!GameInfo[gamZoneX][0])
					{
						new Float:coord[3];
						GetPlayerPos(playerid, coord[0], coord[1], coord[2]);
						GameInfo[gamZoneX][0] = coord[0];
						GameInfo[gamZoneY][0] = coord[1];
						GameInfo[gamZoneZ][0] = coord[2];
						if(GameInfo[gamGangzone])
						{
							foreach(new i: Player)
							{
								if(MPGO[i] || i == playerid) GangZoneHideForPlayer(playerid, GameInfo[gamGangzone]);
							}
							GameInfo[gamGangzone] = GangZoneCreate(GameInfo[gamZoneX][0], GameInfo[gamZoneY][0], GameInfo[gamZoneX][1], GameInfo[gamZoneY][1]);
							foreach(new i: Player)
							{
								if(MPGO[i] || i == playerid) GangZoneShowForPlayer(playerid, GameInfo[gamGangzone], 0xff0000AA);
							}
						}
					} 
					else 
					{
						GameInfo[gamZoneX][0] = 0;
						GameInfo[gamZoneY][0] = 0;
						GameInfo[gamZoneZ][0] = 0;
					}
					zonempdialog(playerid);
				}
				case 1:
				{
					if(!GameInfo[gamZoneX][1])
					{	
						new Float:coord[3];
						GetPlayerPos(playerid, coord[0], coord[1], coord[2]);
						GameInfo[gamZoneX][1] = coord[0];
						GameInfo[gamZoneY][1] = coord[1];
						GameInfo[gamZoneZ][1] = coord[2];
						if(GameInfo[gamGangzone])
						{	
							foreach(new i: Player)
							{
								if(MPGO[i] || i == playerid) GangZoneHideForPlayer(i, GameInfo[gamGangzone]);
							}
							GameInfo[gamGangzone] = GangZoneCreate(GameInfo[gamZoneX][0], GameInfo[gamZoneY][0], GameInfo[gamZoneX][1], GameInfo[gamZoneY][1]);
							foreach(new i: Player)
							{
								if(MPGO[i] || i == playerid) GangZoneShowForPlayer(i, GameInfo[gamGangzone], 0xff0000AA);
							}
						}
					} 
					else 
					{
						GameInfo[gamZoneX][1] = 0;
						GameInfo[gamZoneY][1] = 0;
						GameInfo[gamZoneZ][1] = 0;
					}
					zonempdialog(playerid);
				}
				case 2: // Ограничение по высоте
				{
					GameInfo[gamHeight] = !GameInfo[gamHeight];
					zonempdialog(playerid);
				}
				case 3: // Зона на радаре
				{
					if(!GameInfo[gamZoneX][0] && !GameInfo[gamZoneX][1])
					{
						ErrorText(playerid, "{FF6347}Сначала установите позицию лимита.");
						return zonempdialog(playerid);
					}
					if(!GameInfo[gamGangzone])
					{
						GameInfo[gamGangzone] = GangZoneCreate(GameInfo[gamZoneX][0], GameInfo[gamZoneY][0], GameInfo[gamZoneX][1], GameInfo[gamZoneY][1]);
						foreach(new i: Player)
						{
							if(MPGO[i] || i == playerid)
							{
								hideGangZones(i);
								GangZoneShowForPlayer(i, GameInfo[gamGangzone], 0xff0000AA);
							}
						}
					}
					else
					{
						foreach(new i: Player)
						{
							if(MPGO[i] || i == playerid)
							{
								GangZoneHideForPlayer(i, GameInfo[gamGangzone]);
								showGangZones(i);
							}
						}
						GameInfo[gamGangzone] = 0;
					}
					zonempdialog(playerid);
				}
			}
	    }
		else pc_cmd_gomp(playerid);
	}
