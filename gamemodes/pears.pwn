		format(str,sizeof(str),"\n{444444}- В случае неоплаченных налогов более {cccccc}100 часов: {FF6347}Транспорт Изымается"), strcat(sctring,str);
		ShowDialog(playerid,518,DIALOG_STYLE_INPUT,"{66ff66}Министерство Финансов",sctring,"Принять","Отмена");
