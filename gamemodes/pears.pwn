stock FindPlusFrame(b, next, type1, type2)
{
	new frame = -1;
	for(new i = next; i < MAX_FRAME; i++)
    {
        if(b == 0)
	    {
	        if(FrameInfo[i][frModel] > 0)
			{
		    	frame = i;
		    	break;
  			}
	    }
	    else
	    {
	        if(FrameInfo[i][frModel] > 0 && (FrameInfo[i][frType] == 0 || FrameInfo[i][frType] == type1 || FrameInfo[i][frType] == type2))
			{
		    	frame = i;
		    	break;
  			}
	    }
  	}
	return frame;
}
stock GetWatchFrameNext(playerid, b, next, loaded)
{
    new type1, type2;
    if(b >= 1 && b <= 1000) type1 = 1, type2 = 0; // Дома
    else if(b >= 3001 && b < 4000) type1 = 2, type2 = 0; // Бизнес

	if(next == frame_quan-1) next = FindPlusFrame(b, 0, type1, type2); // Текущий frame последний (То начинаем поиск с 0 Frame)
	else
	{
		if(loaded != 0) next ++;
	}

	new frame = FindPlusFrame(b, next, type1, type2);
	if(frame == -1) frame = FindPlusFrame(b, 0, type1, type2);
  	SetPVarInt(playerid,"ModelInt",frame);
	return frame;
}
stock FindMinusFrame(b, prev, type1, type2)
{
	new frame = -1;
	for(new i = prev; i > 0; i--)
    {
        if(b == 0)
	    {
	        if(FrameInfo[i][frModel] > 0)
			{
		    	frame = i;
		    	break;
  			}
	    }
	    else
	    {
	        if(FrameInfo[i][frModel] > 0 && (FrameInfo[i][frType] == 0 || FrameInfo[i][frType] == type1 || FrameInfo[i][frType] == type2))
			{
		    	frame = i;
		    	break;
  			}
	    }
  	}
	return frame;
}
stock GetWatchFramePrev(playerid, b, prev)
{
    new type1, type2, frame = -1;
    if(b >= 1 && b <= 1000) type1 = 1, type2 = 0; // Дома
    else if(b >= 3001 && b < 4000) type1 = 2, type2 = 0; // Бизнес

    if(prev == TP[1][playerid]) frame = FindMinusFrame(b, MAX_FRAME-1, type1, type2);
    else
	{
        prev --;
		frame = FindMinusFrame(b, prev, type1, type2);
	}
  	SetPVarInt(playerid,"ModelInt",frame);
	return frame;
}
