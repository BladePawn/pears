}
public Kakayatohernya()
{
	close_labirint();
    stat_labirint ++;
    if(stat_labirint == 5) stat_labirint = 0;
    if(stat_labirint == 0) MoveDynamicObject(arhwall[0], 1433.058837, 1549.389160, 8.070286, 0.5), around_audio(6002, 0, 30.0, 1433.058837, 1549.389160, 8.070286, 226, 226);
	else if(stat_labirint == 1) MoveDynamicObject(arhwall[1], 1396.625976, 1549.389526, 8.070286, 0.5), around_audio(6002, 0, 30.0, 1396.625976, 1549.389526, 8.070286, 226, 226);
	else if(stat_labirint == 2) MoveDynamicObject(arhwall[2], 1433.058837, 1583.245239, 8.070286, 0.5), around_audio(6002, 0, 30.0, 1433.058837, 1583.245239, 8.070286, 226, 226);
	else if(stat_labirint == 3) MoveDynamicObject(arhwall[3], 1396.625976, 1583.235229, 8.070286, 0.5), around_audio(6002, 0, 30.0, 1396.625976, 1583.235229, 8.070286, 226, 226);
	else if(stat_labirint == 4) MoveDynamicObject(arhwall[4], 1367.538085, 1587.863891, 8.070286, 0.5), around_audio(6002, 0, 30.0, 1367.538085, 1587.863891, 8.070286, 226, 226);
	
	new unix = gettime(), g;
	foreach(Player,i)
	{
		if(OnlineInfo[i][oLogged] == 1 && GetPVarInt(i,"afksystem") <= 2)
		{
		    g = fraction(i);
			if(OverHear[i] == 0 && ADUTY[i] == 0 && Kapt[g] == 0 && Strel[g] == 0 && Zahvat[g] == 0 && MPGO[i] == 0 && !howstun(i) && GetPlayerState(i) != PLAYER_STATE_SPECTATING)
			{
			    new stope;
			    if(getillness(i, 10) >= 0 && get_invent4(i, 16, 0) >= 1 && get_invent4(i, 53, 0) >= 1) // Никотиновая Зависимость
				{
					if(box[i] >= 1 || PlayerInfo[i][pJailed] == 4 || PlayerInfo[i][pJailed] == 7 || PlayerInfo[i][pBkyrenie] >= 2) {}
					else
					{
						usesmoke(i, 999), stope = 1;
						if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i, RusToGame("Хочется покурить"),RusToGame("[Персонаж болен]"));
						else SendMindMessage(i, "I want to smoke","[Character is sick]");
					}
				}
				if(getillness(i, 11) >= 0 && get_invent4(i, 14, 0) >= 1 && stope == 0) // Алкогольная Зависимость
				{
					if(box[i] >= 1 || PlayerInfo[i][pJailed] == 4 || PlayerInfo[i][pJailed] == 7 || PlayerInfo[i][pBkyrenie] >= 2) {}
					else
					{
						// beerplayer(i, 999), stope = 1;
						if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i, RusToGame("Хочется выпить"),RusToGame("[Персонаж болен]"));
						else SendMindMessage(i, "I want to drink","[Character is sick]");
					}
				}
				if(getillness(i, 9) >= 0 && get_invent4(i, 7, 0) >= 1 && stope == 0) // Порошковая Зависимость
				{
					if(box[i] >= 1 || PlayerInfo[i][pJailed] == 4 || PlayerInfo[i][pJailed] == 7 || PortInfo[wStat] == 1 && IsPlayerInSquare(i,-1739.7145, -103.8218,-1694.4082,-27.3040) ||
					PortInfo[wStat] == 2 && IsPlayerInSquare(i,2401.7756,-2641.1243,2447.0828,-2564.6064) 
					|| GetPVarInt(i,"afdrugs") > unix || OnlineInfo[i][oHealthTime] > 0 || HealthAC[i] >= GetMaxPlayerHealth(i)) {}
					else
					{
						UseDrugs(i, DRUGS_TYPE_COCAINE), stope = 1;
						if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i, RusToGame("Хочется закинуться"),RusToGame("[Персонаж болен]"));
						else SendMindMessage(i, "I want to bump","[Character is sick]");
					}
				}
				if(getillness(i, 12) >= 0 || getillness(i, 14) >= 0 && stope == 0 && GetPVarInt(i,"qweststat") == 0 && GetPVarInt(i,"job_stat") != 12 && SitPlayer[i] == 0) // Гастрит, Язва
				{
					if(box[i] >= 1 || PlayerInfo[i][pJailed] == 4 || PlayerInfo[i][pJailed] == 7 || PlayerInfo[i][pBkyrenie] >= 2) {}
					else
					{
						EatPlayer(i, -800), SetPVarInt(i, "qweststat", 64), SetPVarInt(i, "qwesttime", 8);
						if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i, RusToGame("Меня сильно тошнит"),RusToGame("[Персонаж болен]"));
						else SendMindMessage(i, "I feel very sick","[Character is sick]");
					}
				}
			}
		}
	}
	return 1;
}
public OnPlayerText(playerid, text[])
{
	if(CallPublic(playerid, 16)) return false;

	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	new string[350];
	if(server == 0) printf("OnPlayerText %s",text);
	if(PlayerInfo[playerid][pMuteTime] <= 0) abuse(playerid,text);
	if(checkflood(playerid, text))
	{
		if(Acheck[playerid] >= 1)
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "Большое количество повторяющегося текста приводит к кровотечению из глаз");
			SendClientMessage(playerid, COLOR_LIGHTRED, "Пожалуйста... не флудите. Мы заботимся о вас [Code 0138]"), PlayerPlaySound(playerid,4203,0,0,0);
			Achtim[playerid] = 4;
			return 0;
		}
		else Acheck[playerid] ++;
	}
	else Acheck[playerid] = 0;
	//if (!ComputerClubOnPlayerText(playerid, text)) return 0;
	iflood(playerid, text);
	if(reklamshik[playerid] >= 1)
	{
		if(reklamshik[playerid] == 1) SendClientMessage(playerid, COLOR_LIGHTRED, "Античит распознал ваше сообщение как рекламу [Code 0061]"), PlayerPlaySound(playerid,4203,0,0,0);
		reklamshik[playerid] = 0;
		return 0;
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0 &&
	(!MineWar_IsPlayerInside(playerid) && !Tomb_IsPlayerInside(playerid)))
	{
		ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
		return 0;
	}
	if(CnnVed[playerid] >= 11)
	{
		ErrorMessage(playerid, "{FF6347}Ваш персонаж смотрит телевизор");
		return 0;
	}
	if(PlayerInfo[playerid][pMuteTime] >= 1)
	{
		SetPlayerChatBubble(playerid,"пытается что-то сказать",COLOR_PURPLE,30.0,7000);
		isamute(playerid);
		return 0;
	}
	if(DeathInfo[playerid][deathStatus]) // Если игрок Умерчик
	{
		ErrorMessage(playerid, "{FF6347}Ваш персонаж тяжело ранен и находится без сознания\n\n{cccccc}Вы можете использовать команды: [ /report /do /b ]");
		return 0;
	}
	if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1)
	{
		ErrorMessage(playerid, "{FF6347}Ваш персонаж спит");
		return 0;
	}
	// Антиреклама IP спизженная с мг
	new is1=0;
	new r=0;
	while(strlen(text[is1]))
	{
		if('0'<=text[is1]<='9')
		{
			new is2=is1+1;
			new p=0;
			while(p==0)
			{
				if('0'<=text[is2]<='9'&&strlen(text[is2])) is2++;
				else
				{
					strmid(strRz[r],text,is1,is2,255);
					if(strval(strRz[r])<255) r++;
					is1=is2;
					p=1;
				}
			}
		}
		is1++;
	}
	if(r>=4)
	{
		new strMy[144];
		format(strMy, sizeof(strMy), " [ ADM ]: Возможная реклама %s[%d]: %s", PlayerInfo[playerid][pName],playerid,text);
		ABroadCast(COLOR_ADM,strMy,1);
		for(new z=0;z<r;z++)
		{
			new pr2;
			while((pr2=strfind(text,strRz[z],true))!=-1) for(new i=pr2,j=pr2+strlen(strRz[z]);i<j;i++) text[i]='*';
		}
	}
	if (strcmp(":)", text, true) == 0 || strcmp(")", text, true) == 0 || strcmp("))", text, true) == 0 || strcmp(")))", text, true) == 0 || strcmp("))))", text, true) == 0 || strcmp(")))))", text, true) == 0 || strcmp("^_^", text, true) == 0)
	{
		format(string, sizeof(string), "* %s улыбается.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"улыбается",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(":D", text, true) == 0 || strcmp(":d", text, true) == 0)
	{
		format(string, sizeof(string), "* %s смеётся.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"смеётся",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp("xd", text, true) == 0 || strcmp("xD", text, true) == 0 || strcmp("Xd", text, true) == 0 || strcmp("XD", text, true) == 0 || strcmp("XDD", text, true) == 0 || strcmp("хд", text, true) == 0 || strcmp("хД", text, true) == 0 || strcmp("хДД", text, true) == 0)
	{
		format(string, sizeof(string), "* %s ржёт.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"ржёт",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(";p", text, true) == 0 || strcmp(";P", text, true) == 0 || strcmp(":P", text, true) == 0 || strcmp(":p", text, true) == 0 || strcmp(";р", text, true) == 0 || strcmp(";Р", text, true) == 0 || strcmp(":Р", text, true) == 0 || strcmp(":р", text, true) == 0)
	{
		format(string, sizeof(string), "* %s показывает язык.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"показывает язык",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(";)", text, true) == 0)
	{
		format(string, sizeof(string), "* %s подмигивает.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"подмигивает",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp("> <", text, true) == 0 || strcmp("><", text, true) == 0)
	{
		format(string, sizeof(string), "* %s злится.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"злится",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(":*", text, true) == 0 || strcmp(";*", text, true) == 0)
	{
		format(string, sizeof(string), "* %s шлёт воздушный поцелуй.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"шлёт воздушный поцелуй",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(";(", text, true) == 0)
	{
		format(string, sizeof(string), "* %s плачет.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"плачет",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(":(", text, true) == 0 || strcmp("(", text, true) == 0 || strcmp("((", text, true) == 0 || strcmp("(((", text, true) == 0 || strcmp("((((", text, true) == 0 || strcmp("(((((", text, true) == 0 || strcmp("(((((((", text, true) == 0)
	{
		format(string, sizeof(string), "* %s грустит.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"грустит",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(":DD", text, true) == 0 || strcmp(":DDD", text, true) == 0 || strcmp(":DDDD", text, true) == 0 || strcmp(":DDDDD", text, true) == 0 || strcmp(":DDDDDD", text, true) == 0 || strcmp(":DDDDDDD", text, true) == 0 || strcmp(":DDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDD", text, true) == 0)
	{
		format(string, sizeof(string), "* %s хохочет.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"хохочет",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if (strcmp(":DDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDDDDDDDD", text, true) == 0 || strcmp(":DDDDDDDDDDDDDDDDDD", text, true) == 0)
	{
		format(string, sizeof(string), "* %s ухохатывется.", playername(playerid));
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid,"ухохатывается",COLOR_PURPLE,35.0,10000);
		return 0;
	}
	if(TalkingLive[playerid] != 9999)
	{
		if(PlayerInfo[playerid][pMember] == 9 || PlayerInfo[playerid][pLeader] == 9)
		{
			if(!IsOnline(TalkingLive[playerid])) { SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Человек у которого я беру интервью куда-то делся. Эфир прерван"); TalkingLive[playerid] = 9999; return 0; }
			if(ProxDetectorS(5.0, playerid, TalkingLive[playerid]))
			{
				if(PlayerInfo[playerid][pTransmitterOff][9] == true)
				{
					ErrorMessage(playerid, "{FF6347}У вас выключен этот чат /news\n{cccccc}Y >> Меню >> Настройки Чата");
					return 0;
				}
				format(string, sizeof(string), "* [ CNN ] {ffffff}Ведущий %s[%d]: {9ACD32}%s *", playername(playerid), playerid, text);
				OOCNews(COLOR_LIGHTGREEN, string);
				return 0;
			}
			else { SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Человек у которого я беру интервью далеко от меня. Эфир прерван"); TalkingLive[playerid] = 9999; return 0; }
		}
		else
		{
			if(!IsOnline(TalkingLive[playerid])) { SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Репортёр куда-то делся. Эфир прерван"); TalkingLive[playerid] = 9999; return 0; }
			if(ProxDetectorS(5.0, playerid, TalkingLive[playerid]))
			{
				if(PlayerInfo[playerid][pTransmitterOff][9] == true)
				{
					ErrorMessage(playerid, "{FF6347}У вас выключен этот чат /news\n{cccccc}Y >> Меню >> Настройки Чата");
					return 0;
				}
				format(string, sizeof(string), "* [ CNN ] {ffffff}Гость %s[%d]: {9ACD32}%s *", playername(playerid), playerid, text);
				OOCNews(COLOR_LIGHTGREEN, string);
				return 0;
			}
			else { SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Репортёр далеко от меня. Эфир прерван"); TalkingLive[playerid] = 9999; return 0; }
		}
	}
	
	if(Effect[playerid] == 5 && EffectTime[playerid] >= 500)
	{
		new nodalee;
		switch(random(3))
		{
			case 0: nodalee = 1;
			default: {}
		}
		if(nodalee == 1)
		{
			if(NameTag[playerid] == true) format(string, sizeof(string), "%s говорит: что-то несвязно бормочет", playername(playerid));
			else format(string, sizeof(string), "%s[%d] говорит: что-то несвязно бормочет", playername(playerid), playerid);
			ProxDetector(20.0, playerid, string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
			SetPlayerChatBubble(playerid,"что-то несвязно бормочет",COLOR_PURPLE,35.0,10000);
			return 0;
		}
	}
	
	OutgoingMessages_Add(playerid, text);
	
	if(Lanrus[playerid] >= 1)
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid,x,y,z);
		if(NoAnim[playerid] == 0 && PPP15[playerid] == 0 && GetPVarInt(playerid,"gantel")==0 && Piss[playerid] == 0)
		{
			ApplyAnimation(playerid, "GANGS", talk_anims[random(sizeof(talk_anims))], 4.0, true, true, true, true, true);
			new len = strlen(text);
			SetTimerEx("TalkHandsOff", (len < 5) ? 500 : len * 100, false, "d", playerid);
		}
		if(AntiCam[playerid] >= 1) AntiCam[playerid] = 0;
		foreach (Player, i)
		{
			if(IsPlayerInRangeOfPoint(i,20.0,x, y, z)) // Рядом ли игрок
			{
				if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i)) // Видит ли игрок
				{
					if(Lanrus[playerid] == 1) // Русский Язык (РМ)
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на русском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pRusk] == 1 || PlayerInfo[i][pMember] == 12 || PlayerInfo[i][pLeader] == 12 || ADUTY[i] == 1) format(string, sizeof(string), "%s[%d] говорит на русском: {666666}%s", playername(playerid),playerid , text);
						else format(string, sizeof(string), "%s[%d]: {666666}что-то говорит на русском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}
					else if(Lanrus[playerid] == 2) // Японский Язык (Якудза)
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на японском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pYapon] == 1 || PlayerInfo[i][pMember] == 6 || PlayerInfo[i][pLeader] == 6 || ADUTY[i] == 1)format(string, sizeof(string), "%s[%d] говорит на японском: {666666}%s", playername(playerid),playerid , text);
						else format(string, sizeof(string), "%s[%d]: {666666}что-то говорит на японском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}
					else if(Lanrus[playerid] == 3) // Итальянский Язык (Cosa Nostra)
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на итальянском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pItaly] == 1 || PlayerInfo[i][pMember] == 5 || PlayerInfo[i][pLeader] == 5 || ADUTY[i] == 1)format(string, sizeof(string), "%s[%d] говорит на итальянском: {666666}%s", playername(playerid),playerid , text);
						else format(string, sizeof(string), "%s[%d]: {666666}что-то говорит на итальянском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}
					else if(Lanrus[playerid] == 4) // Китайский Язык (Triada)
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на китайском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pKitai] == 1 || PlayerInfo[i][pMember] == 10 || PlayerInfo[i][pLeader] == 10 || ADUTY[i] == 1)format(string, sizeof(string), "%s[%d] говорит на китайском: {666666}%s", playername(playerid),playerid , text);
						else format(string, sizeof(string), "%s[%d]: {666666}что-то говорит на китайском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}
					else if(Lanrus[playerid] == 5) // Испанский Язык (Vagos/Coronos/Rifa)
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на испанском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pIspan] == 1 || PlayerInfo[i][pMember] == 15 || PlayerInfo[i][pLeader] == 15 || PlayerInfo[i][pMember] == 16 || PlayerInfo[i][pLeader] == 16|| PlayerInfo[i][pMember] == 17 || PlayerInfo[i][pLeader] == 17 || ADUTY[i] == 1)
						{
							format(string, sizeof(string), "%s[%d] говорит на испанском: {666666}%s", playername(playerid),playerid , text);
						}
						else format(string, sizeof(string), "%s[%d]: {666666}что-то говорит на испанском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}
					/*else if(Lanrus[playerid] == 6) // Французский Язык
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на французском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pFrance] == 1 || ADUTY[i] == 1)format(string, sizeof(string), "%s говорит на французском[%d]: {666666}%s", playername(playerid),playerid , text);
						else format(string, sizeof(string), "%s [%d]: {666666}что-то говорит на французском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}*/
					else if(Lanrus[playerid] == 7) // Арабский Язык (Arabian)
					{
						SetPlayerChatBubble(playerid,"{666666}говорит на арабском языке",COLOR_WHITE,35.0,10000);
						if(PlayerInfo[i][pArab] == 1 || PlayerInfo[i][pMember] == 18 || PlayerInfo[i][pLeader] == 18 || ADUTY[i] == 1)format(string, sizeof(string), "%s[%d] говорит на арабском: {666666}%s", playername(playerid),playerid , text);
						else format(string, sizeof(string), "%s[%d]: {666666}что-то говорит на арабском языке.", playername(playerid),playerid);
						SendClientMessage(i, COLOR_FADE2, string);
					}
				}
			}
		}
		return 0;
	}
	if(GetPVarInt(playerid, "Mobile") != 9999 && GetPVarInt(playerid, "MobileStat") == 3)
	{
		if(AntiCam[playerid] >= 1) AntiCam[playerid] = 0;
		format(string, sizeof(string), "%s говорит (телефон): %s", playername(playerid), text);
		ProxDetector(20.0, playerid, string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
		SetPlayerChatBubble(playerid,text,COLOR_TALK_PLAYER,35.0,10000);
		if(IsOnline(GetPVarInt(playerid, "Mobile")) && GetPVarInt(playerid, "Mobile") <= 1200)
		{
			if(GetPVarInt(GetPVarInt(playerid, "Mobile"), "Mobile") == playerid)
			{
				if(GetPVarInt(playerid, "taks") == 1)
				{
					format(string, sizeof(string), "Неизвестный Абонент (таксофон): %s", text);
					SendClientMessage(GetPVarInt(playerid, "Mobile"), COLOR_YELLOW,string);
					foreach(Player,x)
					{
						if(GetPVarInt(x, "komp") == 9999 || GetPVarInt(x, "komp") == playerid || GetPVarInt(x, "komp") == GetPVarInt(playerid, "Mobile"))
						{
							if(PlayerInfo[x][pSoska] >= 1) format(string,sizeof(string),"(Таксофон) %s[%d] >> %s[%d]: %s",PlayerInfo[playerid][pName],playerid,PlayerInfo[GetPVarInt(playerid, "Mobile")][pName],GetPVarInt(playerid, "Mobile"),text);
							else format(string,sizeof(string),"(Таксофон) Неизвестный Абонент >> %s[%d]: %s", PlayerInfo[GetPVarInt(playerid, "Mobile")][pName],GetPVarInt(playerid, "Mobile"), text);
							SendClientMessage(x,COLOR_YELLOW2,string);
						}
					}
				}
				else
				{
					format(string, sizeof(string), "%s говорит (телефон): %s", PlayerInfo[playerid][pName], text);
					SendClientMessage(GetPVarInt(playerid, "Mobile"), COLOR_YELLOW,string);
					foreach(Player,x)
					{
						if(GetPVarInt(x, "komp") == 9999 || GetPVarInt(x, "komp") == playerid || GetPVarInt(x, "komp") == GetPVarInt(playerid, "Mobile"))
						{
							if(GetPVarInt(GetPVarInt(playerid, "Mobile"), "taks") == 1) format(string,sizeof(string),"(Телефон) %s[%d] >> Неизвестный Абонент: %s",PlayerInfo[playerid][pName],playerid,text);
							else format(string,sizeof(string),"(Телефон) %s[%d] >> %s[%d]: %s",PlayerInfo[playerid][pName],playerid, PlayerInfo[GetPVarInt(playerid, "Mobile")][pName],GetPVarInt(playerid, "Mobile"), text);
							SendClientMessage(x,COLOR_YELLOW2,string);
						}
					}
				}
			}
		}
		return 0;
	}
	if(realchat)
	{
		if(AntiCam[playerid] >= 1) AntiCam[playerid] = 0;

		// Общий чат в заброшенной шахте
		if (MineWar_GeneralChat(playerid, text)) return 0;

		if (Nasa_GeneralChat(playerid, text)) return 0;

		// Общий чат в гробнице
		if (Tomb_GeneralChat(playerid, text)) return 0;

		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
			if(NoAnim[playerid] == 0 && PPP15[playerid] == 0 && GetPVarInt(playerid,"gantel")==0 && Piss[playerid] == 0)
			{
				ApplyAnimation(playerid, "GANGS", talk_anims[random(sizeof(talk_anims))], 4.0, true, true, true, true, true);
				new len = strlen(text);
				SetTimerEx("TalkHandsOff", (len < 5) ? 500 : len * 100, false, "d", playerid);
			}
		}
		if(NameTag[playerid] == true) format(string, sizeof(string), "%s говорит: %s", playername(playerid), text);
		else format(string, sizeof(string), "%s[%d] говорит: %s", playername(playerid), playerid , text);

		ProxDetector(20.0, playerid, string, COLOR_FADE1, COLOR_FADE2, COLOR_FADE3, COLOR_FADE4, COLOR_FADE5, true);
		SetPlayerChatBubble(playerid, text, COLOR_TALK_PLAYER, 35.0, 10000); // COLOR_WHITE
		return 0;
	}
	return 1;
}

stock Nasa_GeneralChat(playerid, const string[])
{
    if(PlayerInfo[playerid][pBkyrenie] < 2) return 0;

    foreach (new currentid : Player)
    {
        if(PlayerInfo[currentid][pBkyrenie] < 2) continue;
		if(PlayerInfo[playerid][pBkyrenie] != PlayerInfo[currentid][pBkyrenie]) continue;
        if(PlayerInfo[playerid][pBkyrenie] == 2 || PlayerInfo[playerid][pBkyrenie] == 3) SendClientMessage(currentid, 0x1E6698FF, "[ NASA(Луна) ]: {555555}%s: %s", PlayerInfo[playerid][pName], string);
		else SendClientMessage(currentid, 0x1E6698FF, "[ NASA(Марс) ]: {555555}%s: %s", PlayerInfo[playerid][pName], string);
    }

    return 1;
}
forward TalkHandsOff(playerid);
public TalkHandsOff(playerid)
{
	return ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, false, false, false, false, false, SYNC_ALL);
}
public FixHour(hour)
{
	if (hour < 0) { hour = hour+24; }
	else if (hour > 23) { hour = hour-24; }
	shifthour = hour;
	return 1;
}

