CMD:setnames(playerid)
{
    if(PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new str[150],sctring[1000];
    format(str,sizeof(str),"Список заявок на смену никнейма"), strcat(sctring,str);
 	foreach (Player, i)
 	{
		if(PlayerInfo[i][pNewname] >= 1 && OnlineInfo[i][oLogged] == 1)
		{
		    format(str,sizeof(str),"\n{cccccc}%s[%d] >> {ff9000}%s {ffcc00}[%dG]",PlayerInfo[i][pName],i,PlayerInfo[i][pSetName],PlayerInfo[i][pDonateMoney]), strcat(sctring,str);
		}
	}
	ShowDialog(playerid,1995,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}/setname /offname",sctring,"Ок",""), PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}
CMD:offname(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new result[64],giveplayerid;
	if(sscanf(params, "is[64]",giveplayerid, result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отказать в смене Ник Нейма [ /offname ID Причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(!IsOnline(giveplayerid)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[giveplayerid][pNewname] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не заказывал смену Ник-Нейма");
	new string[144];
	format(string, sizeof(string), "* %s отказал вам в смене Ник-Нейма, причина: %s", PlayerInfo[playerid][pName], result);
	SendClientMessage(giveplayerid, COLOR_WHITE, string);
	format(string, sizeof(string), " [ ADM ]: Админ %s отказал игроку %s в смене никнейма, причина: %s",PlayerInfo[playerid][pName],PlayerInfo[giveplayerid][pName], result);
	ABroadCast(COLOR_ADM,string,1);
	format(string, sizeof(string),"{FF0000}Администратор %s отказал вам в смене Ник-Нейма\n{FF0000}Причина: {cccccc}%s", PlayerInfo[playerid][pName], result);
 	ShowDialog(giveplayerid,1700, 0, "{ff9000}Смена Ник Нейма", string, "Ок", "");
	PlayerInfo[giveplayerid][pNewname] = 0;
	PlayerInfo[giveplayerid][pUnixRename] = gettime()+7200;
	AdminLog(
		"offname",
		PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP],
		PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP],
		0,
		"Отказал смену никнейма игроку"
	);
	return 1;
}
CMD:setname(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Одобрить смену Ник-Нейма [ /setname ID ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[params[0]][pNewname] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не заказывал смену Ник-Нейма");
	new cennik;
 	if(PlayerInfo[params[0]][pLevel] <= 2) cennik = 0;
 	else cennik = 50;
  	if(PlayerInfo[params[0]][pDonateMoney] < cennik) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Недостаточно золота");
	if(PlayerInfo[params[0]][pHidden] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это скрытый акк");
  	new f_str[144];
	mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_name` WHERE `name` = '%e'", PlayerInfo[params[0]][pSetName]);
	mysql_tquery(pearsq, f_str, "Call_name", "dsdd", playerid, PlayerInfo[params[0]][pSetName], 2, params[0]);
	return 1;
}
forward Call_callsign(playerid, const str_name[], const text[], g);
public Call_callsign(playerid, const str_name[], const text[], g)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datad4, datad12, string[144];
		cache_get_value_name_int(0, "Member", datad1);
		cache_get_value_name_int(0, "Leader", datad2);
		cache_get_value_name_int(0, "Rank", datad4);
		cache_get_value_name_int(0, "user_id", datad12);
		if(g != datad1 && g != datad2) return ErrorMessage(playerid, "{FF6347}Это не участник вашей организации");
		if(datad4 >= PlayerInfo[playerid][pRank]) return ErrorMessage(playerid, "{FF6347}Вы можете изменять позывной только подчинённым");
		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `CallSign`='%e' WHERE `Name`='%e'", text, str_name);
		query_empty(pearsq, string);
		format(string, sizeof(string), "Вы изменили позывной подчинённого | %s", text);
		SendClientMessage(playerid, COLOR_WHITE, string);
		OrgLog(g, "callsign", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad12, str_name, "", 0, text);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:callsign(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(43, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не участник ICA");
	if(!GetAccessRankOrg(playerid, g, 43, NO_FBI)) return 1;

	new string[200];
	new tmp[24], text[24], para1;
	if(sscanf(params, "s[24]s[24]",tmp,text)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить позывной [ /callsign ID Позывной ]");
	if(checksimvol(text)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённые символы");
	if(strlen(text) > 20 || strlen(text) < 1) return ErrorMessage(playerid, "{FF6347}В позывном не меньше 1 и не больше 20 символов");
	para1 = ReturnUser(tmp);
	if(IsOnline(para1))
	{
		if(OnlineInfo[para1][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок в игре, но не залогинился [ Подождите ]");
		if(g != fraction(para1)) return ErrorMessage(playerid, "{FF6347}Это не участник вашей организации");
		if(PlayerInfo[para1][pRank] >= PlayerInfo[playerid][pRank] && para1 != playerid) return ErrorMessage(playerid, "{FF6347}Вы можете изменять позывной только подчинённым");
		format(PlayerInfo[para1][pCallSign], 24, "%s", text);
		format(string,sizeof(string),"{99ff66}Руководство установило ваш позывной {ff9000}%s", text);
		SuccessMessage(para1, string);
		format(string, sizeof(string), "Вы изменили позывной подчинённого | %s ", text);
		SendClientMessage(playerid, COLOR_WHITE, string);
		OrgLog(g, "callsign", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, text);
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return ErrorMessage(playerid, "{FF6347}Игрок Offline [ Используйте его никнейм ]");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Member, Leader, Rank FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_callsign", "dssd", playerid, tmp, text, g);
		return 1;
	}
	return 1;
}
CMD:sign(playerid, const params[])
{
	if(gSign[playerid] == true)
	{
	    SetPlayerName(playerid, PlayerInfo[playerid][pName]);
	    gSign[playerid] = false;
	    PlayerPlaySound(playerid,6401,0,0,0);
	    new string[84];
	    format(string,sizeof(string),"{99ff66}Вы вернули своё имя: {ff9000}%s", PlayerInfo[playerid][pName]);
		SuccessMessage(playerid, string);
	    return 1;
	}

	new g = fraction(playerid);
	if(!IsAFunctionOrganization(71, g, playerid) && PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
	if(!GetAccessRankOrg(playerid, g, 71, NO_FBI) && PlayerInfo[playerid][pSoska] < 10) return 1;

	if(GetPlayerVirtualWorld(playerid) == 2001 && GetPlayerInterior(playerid) == 55 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Запрещено в казино");
	new nname[24];
	if(sscanf(params, "s[24]",nname)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Временно сменить никнейм [ /sign Новый ник ]");
 	if(strlen(nname) >= 21) return ErrorMessage(playerid, "{FF6347}Слишком длинное имя {cccccc}[ Лимит 20 символов ]");
 	if(!CheckRP_Nickname(nname)) return ErrorMessage(playerid, "{FF6347}Имя нарушает правила сервера {cccccc}[ Пример: Vasya_Pupkin ]");
    new giveplayerid = ReturnUser(nname, 228);
    if(IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Это имя занято");
 	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Имя","{cccccc}Проверка никнейма...","*","");
	new f_str[124];
	mysql_format(pearsq, f_str, sizeof(f_str), "SELECT `acc` FROM `pp_name` WHERE `name` = '%e'", nname);
	mysql_tquery(pearsq, f_str, "Call_sign1", "ds", playerid, nname);
	return 1;
}
function Call_sign1(playerid, str_name[])
{
    new rows, data;
	cache_get_row_count(rows);
	cache_get_value_name_int(0, "acc", data);
	if(rows && (PlayerInfo[playerid][pID]) != data) return ErrorMessage(playerid, "{FF6347}Это имя занято");
	new f_str[124];
	mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name);
	mysql_tquery(pearsq, f_str, "Call_sign2", "ds", playerid, str_name);
	return 1;
}
function Call_sign2(playerid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows) return ErrorMessage(playerid, "{FF6347}Это имя занято");
	gSign[playerid] = true;
	PlayerPlaySound(playerid,6401,0,0,0);
	new string[164];
	format(string,sizeof(string),"{99ff66}Теперь все видят это имя: {ff9000}%s\n{cccccc}Хотя на самом деле вы %s", str_name, PlayerInfo[playerid][pName]);
	SuccessMessage(playerid, string);
	SetPlayerName(playerid, str_name);
	format(string,sizeof(string),"Изменил имя на: %s",str_name);
	UserLog("sign", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, string);
	return 1;
}
CMD:rename(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 12 || PlayerInfo[playerid][pSoska] == 14) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new tmp[24], newnick[24], para1, f_str[256];
    if(sscanf(params, "s[24]s[24]", tmp, newnick)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сменить никнейм игроку [ /rename ID Новый ник ]");
	if(strlen(newnick) >= 21) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинный никнейм [ Лимит 20 символов ]");
	if(!CheckRP_Nickname(newnick)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот никнейм нарушает правила сервера");
    para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
	{
		if(OnlineInfo[para1][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок не залогинился");
		PlayerInfo[para1][pNewname] = 1;
		mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_name` WHERE `name` = '%e'", newnick);
		mysql_tquery(pearsq, f_str, "Call_name", "dsdd", playerid, newnick, 3, para1);
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, f_str, sizeof(f_str), "SELECT pp_igroki.user_id, pp_name.acc FROM `pp_igroki` LEFT JOIN pp_name ON pp_name.name = '%e' WHERE pp_igroki.name = '%e'", newnick, tmp);
		mysql_tquery(pearsq, f_str, "Call_name", "dsdds", playerid, newnick, 5, para1, tmp);
	}
	return 1;
}
CMD:appdom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Одобрить описание дома [ /appdom Дом ]");
	if(params[0] <= 0 || params[0] >= 1001) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(DomInfo[params[0]][dDescrip] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Для этого дома не было заказано описание");
	if(DomInfo[params[0]][dSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот дом никому не принадлежит");
	new poisk = 0, para1;
	foreach(Player, i)
	{
		if(DomInfo[params[0]][dSost] == PlayerInfo[i][pID])
		{
			poisk ++;
			para1 = i;
		}
	}
	if(poisk >= 2) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3009 ]");
	if(poisk == 0)
	{
  		new string[144];
		mysql_format(pearsq, string, sizeof(string), "SELECT DonateMoney FROM `pp_igroki` WHERE `user_id` = '%d'", DomInfo[params[0]][dSost]);
		mysql_tquery(pearsq, string, "AppDomFromPlayerOffline", "dddd", playerid,DomInfo[params[0]][dSost],params[0], g_MysqlRaceCheck[playerid]);
	}
  	else if(poisk == 1)
  	{
		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не залогинился..");
  		if(PlayerInfo[para1][pDonateMoney] < 100) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Владельцу дома не хватает золота [ /disdom ]");
  		new string[144];
  		PlayerInfo[para1][pDonateMoney] -= 100;
		mysql_save(para1, 4);
  		format(string, sizeof(string), "{0088ff}* {ffffff}[ {ff0000}Server {ffffff}]{0088ff} Администратор {00ffff}%s {0088ff}одобрил описание для дома №{00ffff}%d", PlayerInfo[playerid][pName], params[0]);
		SendClientMessage(para1, COLOR_GREY, string);
		SendClientMessage(para1, COLOR_GREY, "{0088ff}* {ffffff}[ {ff0000}Server {ffffff}]{0088ff} С вашего счёта снято 100 грамм золота");
		format(string, sizeof(string), " [ ADM ]: Админ %s одобрил описание дома № %d",PlayerInfo[playerid][pName], params[0]);
    	ABroadCast(COLOR_ADM,string,1);
 		DomInfo[params[0]][dDescrip] = 1;
 		SaveDom(params[0]);
 		UpdateDom(params[0]);

		format(string, sizeof(string), "Описание дома № %d", params[0]);
		DonateLog("appdom",  PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "", "", -100, string);
  	}
	return 1;
}


function AppDomFromPlayerOffline(playerid,targetUser_id,domid,zalupa)
{
	if(g_MysqlRaceCheck[playerid] != zalupa) return Kickx(playerid);
	new rows,donatemoney, sellerName[24];
	cache_get_row_count(rows);
	if(!rows)
	{
		ErrorMessage(playerid, "{FF6347}Ошибка! Владелец дома не найден\n\n{cccccc}Обратитесь к разработчикам");
		return 0;
	}
	cache_get_value_int(0, "DonateMoney", donatemoney);
	cache_get_value_name(0, "Name", sellerName, 24);

	if(donatemoney < 100) return ErrorMessage(playerid,"{ff6347}У игрока недостаточно золота для покупки описания дома");
	new string_mysql[100];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_igroki` SET `DonateMoney`='%d' WHERE `user_id`='%d'",donatemoney-100,targetUser_id);
	query_empty(pearsq, string_mysql);
	new string[144];
	format(string, sizeof(string), " [ ADM ]: Админ %s одобрил описание дома №%d",PlayerInfo[playerid][pName], domid);
	notify(0, "",DomInfo[domid][dSost], DomInfo[domid][dVlad], string);
	ABroadCast(COLOR_ADM,string,1);
	DomInfo[domid][dDescrip] = 1;
	SaveDom(domid);
	UpdateDom(domid);
    SetPVarInt(playerid,"stopload",0);

	format(string, sizeof(string), "Описание дома № %d", domid);
	DonateLog("appdom",  targetUser_id, sellerName, "", 0, "", "", -100, string);
	return 1;
}

CMD:disdom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new nd, result[64];
	if(sscanf(params, "is[64]",nd,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отказать в описании дома [ /disdom Дом Причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(nd <= 0 || nd >= 1001) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(DomInfo[nd][dDescrip] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Для этого дома не было заказано описание");
	if(DomInfo[nd][dSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот дом никому не принадлежит");
	new poisk = 0, para1;
	foreach(Player, i)
	{
		if(DomInfo[nd][dSost] == PlayerInfo[i][pID])
		{
			poisk ++;
			para1 = i;
		}
	}
	if(poisk >= 2) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3010 ]");
	if(poisk == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Владелец дома не найден, значит он Offline..");
	if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не залогинился..");
  	if(poisk == 1)
  	{
  		new string[144];
  		format(string, sizeof(string), "* Администратор %s отказал вам в описании дома, причина: %s", PlayerInfo[playerid][pName], result);
		SendClientMessage(para1, COLOR_WHITE, string);
		format(string, sizeof(string), " [ ADM ]: %s отказал игроку %s в описании дома, причина: %s",PlayerInfo[playerid][pName],PlayerInfo[para1][pName], result);
  		ABroadCast(COLOR_ADM,string,1);
		format(string, sizeof(string),"{FF0000}[!!!] Администратор %s отказал вам в описании дома\n{FF0000}[!!!] Причина: {ffffff}%s", PlayerInfo[playerid][pName], result);
  		ShowDialog(para1, 191, 0, "{FF0000}**** {0088ff}Отказ! {FF0000}****", string, "Ок", "");
  		DomInfo[nd][dDescrip] = 0;
  		SaveDom(nd);
  	}
	return 1;
}
CMD:doms(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new str[150],sctring[1000];
    PlayerPlaySound(playerid,40405,0,0,0);
	for(new d = 0; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dSost] >= 1 && DomInfo[d][dDescrip] == 2)
		{
			format(str,sizeof(str),"{cccccc}Дом№ %d {ff9000}[%s]\n",d, DomInfo[d][dName]);
 			strcat(sctring,str);
		}
	}
	ShowDialog(playerid,1995,DIALOG_STYLE_LIST,"{FFFFFF}Очередь Описании Домов",sctring,"Ок","");
	return 1;
}
stock closeshop(playerid)
{
    for(new i = 0; i < 7; i ++) PlayerTextDrawHide(playerid, PlayerBuyDraw[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerBuyDraw[i][playerid]);
    for(new i = 0; i < 16; i ++) PlayerTextDrawHide(playerid, PlayerBuyDraw_Items[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerBuyDraw_Items[i][playerid]);
    for(new i = 0; i < 5; i ++)
    {
        PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectFon[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerBuyDraw_SelectFon[i][playerid]);
        PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectPick[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerBuyDraw_SelectPick[i][playerid]);
        PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectName[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerBuyDraw_SelectName[i][playerid]);
        PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectPrice[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerBuyDraw_SelectPrice[i][playerid]);
    }
	return 1;
}
stock updatetimeshop(playerid)
{
	new string[12];
    format(string,sizeof(string),"%s", fine_time(SelectMenu[playerid][Time]));
    PlayerTextDrawSetString(playerid, PlayerBuyDraw[5][playerid], string), PlayerTextDrawShow(playerid, PlayerBuyDraw[5][playerid]);
	return 1;
}
stock sprunk(playerid)
{
    if(Hold[playerid] == 3 && HoldFrisk[playerid] == 124)
    {
        if(HoldQuan[playerid] > 1) return ErrorMessage(playerid, "{FF6347}В стакане ещё есть содержимое");
        ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
        SuccessMessage(playerid, "{99ff66}Вы бесплатно наполнили стакан Sprunk");
    	HoldQuan[playerid] = 4;
    	HoldPara[playerid] = gettime()+172800, HoldQara[playerid] = 0;
    	if(PlayerInfo[playerid][pInven][HoldInva[playerid]] == 124) PlayerInfo[playerid][pInvenQuan][HoldInva[playerid]] = 4, PlayerInfo[playerid][pInvenPara][HoldInva[playerid]] = gettime()+172800;
    	around_player_audio(playerid, 25801, 0, 5.0, 0);
    }
    else ErrorMessage(playerid, "{FF6347}У вас в руках нет стакана Sprunk");
	return 1;
}
stock openshop(playerid, b)
{
    if(OnlineInfo[playerid][oShowInterface] == 0)
    {
        if(b == 1 && NoCompleteQuest(playerid, 0)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки\n{cccccc}Пройдите паспортный контроль и заселитесь в отель");
        if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
        new unix = gettime();
        SelectMenu[playerid][Stat] = 1;
        
        // Открываем Другой Магазин
        if(SelectMenu[playerid][Shop] != b || SelectMenu[playerid][Done] == 1 && unix >= SelectMenu[playerid][Unix])
        {
            SelectMenu[playerid][Time] = 0;
            SelectMenu[playerid][Done] = 0;
            SelectMenu[playerid][Payer] = 0;
            for(new i = 0; i < 16; i ++) SelectMenu[playerid][Cells][i] = 0;
            for(new i = 0; i < 5; i ++) SelectMenu[playerid][Item][i] = 0;
        }
        
        new fpick;
    	create_textdraw_buymenu(playerid);
     	SelectMenu[playerid][Shop] = b;
     	
     	// Проверяем Готовку
     	if(SelectMenu[playerid][Time] > 0)
        {
            PlayerTextDrawSetSelectable(playerid, PlayerBuyDraw[3][playerid], false);
            PlayerTextDrawShow(playerid, PlayerBuyDraw[3][playerid]);
			PlayerTextDrawShow(playerid, PlayerBuyDraw[4][playerid]);
			PlayerTextDrawShow(playerid, PlayerBuyDraw[6][playerid]);
			updatetimeshop(playerid);
        }
        else
		{
		    if(SelectMenu[playerid][Done] == 0)
			{
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerBuyDraw[2][playerid], "KYЊ…Џ’");
				else PlayerTextDrawSetString(playerid, PlayerBuyDraw[2][playerid], "BUY");
				PlayerTextDrawShow(playerid, PlayerBuyDraw[2][playerid]);
				PlayerTextDrawSetSelectable(playerid, PlayerBuyDraw[3][playerid], true);
				PlayerTextDrawShow(playerid, PlayerBuyDraw[3][playerid]);
				for(new i = 0; i < 5; i ++) SelectMenu[playerid][Item][i] = 0;
			}
		    else if(SelectMenu[playerid][Done] == 1)
			{
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerBuyDraw[2][playerid], "3AЂPAЏ’");
				else PlayerTextDrawSetString(playerid, PlayerBuyDraw[2][playerid], "TAKE");
				PlayerTextDrawShow(playerid, PlayerBuyDraw[2][playerid]), PlayerTextDrawSetSelectable(playerid, PlayerBuyDraw[3][playerid], true), PlayerTextDrawShow(playerid, PlayerBuyDraw[3][playerid]);
			}
		}
		for(new i = 0; i < 5; i ++)
	    {
			if(SelectMenu[playerid][Item][i] > 0) show_select_item(playerid, i);
		}
		
    	PlayerTextDrawShow(playerid, PlayerBuyDraw[0][playerid]);
    	PlayerTextDrawShow(playerid, PlayerBuyDraw[1][playerid]);
    	if(b == 1 || b >= 103 && b <= 122)
    	{
            SelectMenu[playerid][Cells][0] = 121; // Кофе
            SelectMenu[playerid][Cells][1] = 124; // Sprunk Стакан
            SelectMenu[playerid][Cells][2] = 120; // Sprunk Банка
            SelectMenu[playerid][Cells][3] = 125; // Бургер
            SelectMenu[playerid][Cells][4] = 127; // Ролл
            SelectMenu[playerid][Cells][5] = 128; // Набор 1
            SelectMenu[playerid][Cells][6] = 129; // Набор 2
            SelectMenu[playerid][Cells][7] = 130; // Набор 3
            SelectMenu[playerid][Cells][8] = 131; // Набор 4
            SelectMenu[playerid][Cells][9] = 132; // Набор 5
            SelectMenu[playerid][Cells][10] = 133; // Набор 6
            SelectMenu[playerid][Cells][11] = 134; // Набор 7
            SelectMenu[playerid][Cells][12] = 135; // Набор 8
            SelectMenu[playerid][Cells][13] = 136; // Набор 9
            SelectMenu[playerid][Cells][14] = 137; // Набор 10
            SelectMenu[playerid][Cells][15] = 138; // Набор 11
    	}
		else if(b == 2) // Столовка (Ограниченный набор)
    	{
            SelectMenu[playerid][Cells][0] = 121; // Кофе
            SelectMenu[playerid][Cells][1] = 125; // Бургер
            SelectMenu[playerid][Cells][2] = 127; // Ролл
            SelectMenu[playerid][Cells][3] = 128; // Набор 1
            SelectMenu[playerid][Cells][4] = 129; // Набор 2
            SelectMenu[playerid][Cells][5] = 130; // Набор 3
            SelectMenu[playerid][Cells][6] = 131; // Набор 4
            SelectMenu[playerid][Cells][7] = 132; // Набор 5
    	}

    	if(b <= 2) // Ценники в меню грузим
    	{
    	    for(new i = 0; i < 16; i ++) SelectMenu[playerid][Price][i] = friskPrice[SelectMenu[playerid][Cells][i]];
    	} 
		else
		{
			for(new i = 0; i < 16; i ++) SelectMenu[playerid][Price][i] = BizzInfo[b][bPrice][i];
		}
    	
    	for(new i = 0; i < 16; i ++)
		{
		    fpick = SelectMenu[playerid][Cells][i];
			PlayerTextDrawBoxColour(playerid, PlayerBuyDraw_Items[i][playerid], 0);

			if(fpick == 0) // Нет товара
			{
				PlayerTextDrawFont(playerid, PlayerBuyDraw_Items[i][playerid], TEXT_DRAW_FONT:4);
				PlayerTextDrawBackgroundColour(playerid, PlayerBuyDraw_Items[i][playerid], PlayerInfo[playerid][pStyle1]);
				PlayerTextDrawColour(playerid, PlayerBuyDraw_Items[i][playerid], PlayerInfo[playerid][pStyle1]);
			}
			else // Есть товар
			{
				PlayerTextDrawFont(playerid, PlayerBuyDraw_Items[i][playerid], TEXT_DRAW_FONT:5);
				PlayerTextDrawBackgroundColour(playerid, PlayerBuyDraw_Items[i][playerid], PlayerInfo[playerid][pStyle1]);
				PlayerTextDrawColour(playerid, PlayerBuyDraw_Items[i][playerid], -1);
				PlayerTextDrawSetPreviewModel(playerid, PlayerBuyDraw_Items[i][playerid], friskPick[fpick]); // Модель
				new Float:modelPos[4], findModel;
				GetModelTextDraw(friskPick[fpick], 0,0, modelPos[0], modelPos[1], modelPos[2], modelPos[3], findModel);
				PlayerTextDrawSetPreviewRot(playerid, PlayerBuyDraw_Items[i][playerid], modelPos[0], modelPos[1], modelPos[2], modelPos[3]);
			}
			PlayerTextDrawShow(playerid, PlayerBuyDraw_Items[i][playerid]);
		}
    	OnlineInfo[playerid][oShowInterface] = 12;
    	PlayerPlaySound(playerid,40405,0,0,0);
    	SelectTextDraw(playerid,0x666666AA);
   	}
    return 1;
}
stock openbar(playerid, b)
{
    if(b == 0)
    {
        List[0][playerid] = friskPrice[14]/5; // Пиво бокал
        List[1][playerid] = friskPrice[113]/5; // Вино бокал
        List[2][playerid] = friskPrice[37]/5; // Шампанское бокал
        List[3][playerid] = friskPrice[114]/5; // Виски бокал
        List[4][playerid] = friskPrice[115]/5; // Коньяк бокал
        List[5][playerid] = friskPrice[116]/5; // Брэнди бокал
        List[6][playerid] = friskPrice[113]; // Вино
