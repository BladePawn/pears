 		new veh = GetPlayerVehicleID(playerid);
		new model = VehInfo[veh][vModel], yes;
		if(model != 403 && model != 514 && model != 515) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не на тягаче");
		if(!IsTrailerAttachedToVehicle(veh)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На тягаче не прикреплён трейлер с топливом [ Y >> GPS >> Прочее >> Нефтеперерабатывающий Завод ]");
		new pricep = GetVehicleTrailer(veh);
