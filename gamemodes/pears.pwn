	timerGangZones(); // Таймер системы Gang Zone

    //==========[ Захват Недвижимости ]=======
    new wtext[24];
	if(PortInfo[wStat] >= 1)
	{
	    new w;
		if(PortInfo[wStat] == 1) w = 0, wtext = "Порт San Fierro";
		else if(PortInfo[wStat] == 2) w = 1, wtext = "Порт Los Santos";
		new kol;
		foreach(Player, e)
		{
			if(OnlineInfo[e][oLogged] == 0 || GetPVarInt(e,"afksystem") > 2 || setting_pos_draw[e] == 1 || setting_size_draw[e] == 1) continue;
			if(fraction(e) == PortInfo[wOne] || fraction(e) == PortInfo[wTwo]) update_mafiabattle(e);
			if(MafiaBattle[0][e] == w+1 && HealthAC[e] >= 1.0 && GetPlayerVirtualWorld(e) == 0 && GetPlayerInterior(e) == 0) kol ++;
    	}
		PortInfo[wAmount] = kol;
    	if(kol == 0)
    	{
    		close_mafiabattle();
    		PortInfo[wStat] = 0;
	    	PortInfo[wTime] = 0;
	    	PortInfo[wNumer] = 0;
    		if(ServerInfo[37] >= 1) PortInterval[w] = unixtime+ServerInfo[37]*60;
	    	else PortInterval[w] = unixtime+3600;
	    	OrganInfo[PortInfo[wOne]][gBattle] = 0;
	    	OrganInfo[PortInfo[wTwo]][gBattle] = 0;
    		if(ServerInfo[38] >= 1) OrganInfo[PortInfo[wOne]][gInterval] = unixtime+ServerInfo[38]*60, OrganInfo[PortInfo[wTwo]][gInterval] = unixtime+ServerInfo[38]*60;
	    	else OrganInfo[PortInfo[wOne]][gInterval] = unixtime+10800, OrganInfo[PortInfo[wTwo]][gInterval] = unixtime+10800;
	    	OrganInfo[PortInfo[wOne]][gUpdate] = 1, OrganInfo[PortInfo[wTwo]][gUpdate] = 1;
	    	Zahvat[PortInfo[wOne]] = 0, Zahvat[PortInfo[wTwo]] = 0;
	    	SaveServer(w+1000);
	    	if(w == 0) format(string,sizeof(string),"{189cab}Порт San Fierro\n{ffffff}Под Контролем: %s\n\n{ffffff}[ /begin >> Начать Захват ]", frakName[PortOwner[w]]);
	    	else if(w == 1) format(string,sizeof(string),"{189cab}Порт Los Santos\n{ffffff}Под Контролем: %s\n\n{ffffff}[ /begin >> Начать Захват ]", frakName[PortOwner[w]]);
			UpdateDynamic3DTextLabelText(PortLabel[w],0xA9C4E4FF,string);
			if(PortInfo[wTwo] >= 1) format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}вы отбили захват %s от %s", wtext,frakName[PortInfo[wOne]]), SendRadioMessage(PortInfo[wTwo], COLOR_LIGHTRED, string);
			format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}Захват {cccccc}%s {FF6347}не удался",wtext), SendRadioMessage(PortInfo[wOne], COLOR_LIGHTRED, string);

			// Награда (монеты континенталь)
			if(PortInfo[wTwo] >= 1)
			{
				GiveFractionContinentalCoins(PortInfo[wTwo], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_WIN]);
				OrgLog(PortInfo[wTwo], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_WIN], "Победа в порту");

				foreach (new targetid : Player)
				{
					// На территории порта
					if (MafiaBattle[1][targetid] == w+1 && HealthAC[targetid] >= 1.0 && GetPlayerVirtualWorld(targetid) == 0 && GetPlayerInterior(targetid) == 0) {}
					else continue;

					// Фракция победителя
					if (fraction(targetid) != PortInfo[wTwo]) continue;
					
					new amount = OrganInfo[PortInfo[wTwo]][gcontinentalrewards][_:CONTINENTAL_PLAYER_ACTION_SHIP_WIN];
					GivePlayerContinentalCoins(targetid, amount);
					OrgLog(PortInfo[wTwo], "paycontinental", 0, "", "", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], amount, "Награда за победу в порту");
				}
			}

			GiveFractionContinentalCoins(PortInfo[wOne], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_LOSE]);
			OrgLog(PortInfo[wOne], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_LOSE], "Проигрыш в порту");
    	}
	    if(PortInfo[wTime] >= 1)
		{
			PortInfo[wTime] --;
			new osmin = PortInfo[wTime]/60;
			new vrem = osmin*60;
			new ossek = PortInfo[wTime]-vrem;
			if(w == 0) format(string,sizeof(string),"{189cab}Порт San Fierro\n{ffffff}Под Контролем: %s\n\n{FF6347}[ Захватывает: %s {FF6347}]\n%d:%02d", frakName[PortOwner[w]], frakName[PortInfo[wOne]],osmin,ossek);
			else if(w == 1) format(string,sizeof(string),"{189cab}Порт Los Santos\n{ffffff}Под Контролем: %s\n\n{FF6347}[ Захватывает: %s {FF6347}]\n%d:%02d", frakName[PortOwner[w]], frakName[PortInfo[wOne]],osmin,ossek);
			UpdateDynamic3DTextLabelText(PortLabel[w],0xA9C4E4FF,string);
		}
	    else
	    {
	        if(kol >= 1)
	        {
	        	close_mafiabattle();
		    	PortInfo[wStat] = 0;
		    	PortInfo[wTime] = 0;
		    	if(ServerInfo[37] >= 1) PortInterval[w] = unixtime+ServerInfo[37]*60;
		    	else PortInterval[w] = unixtime+3600;
		    	OrganInfo[PortInfo[wOne]][gBattle] = 0;
		    	OrganInfo[PortInfo[wTwo]][gBattle] = 0;
		    	if(ServerInfo[38] >= 1) OrganInfo[PortInfo[wOne]][gInterval] = unixtime+ServerInfo[38]*60, OrganInfo[PortInfo[wTwo]][gInterval] = unixtime+ServerInfo[38]*60;
		    	else OrganInfo[PortInfo[wOne]][gInterval] = unixtime+10800, OrganInfo[PortInfo[wTwo]][gInterval] = unixtime+10800;
		    	OrganInfo[PortInfo[wOne]][gUpdate] = 1, OrganInfo[PortInfo[wTwo]][gUpdate] = 1;
		    	Zahvat[PortInfo[wOne]] = 0, Zahvat[PortInfo[wTwo]] = 0;
		    	PortOwner[w] = PortInfo[wOne];
		    	SaveServer(w+1000);
		    	if(w == 0) format(string,sizeof(string),"{189cab}Порт San Fierro\n{ffffff}Под Контролем: %s\n\n{ffffff}[ /begin >> Начать Захват ]", frakName[PortOwner[w]]);
		    	else if(w == 1) format(string,sizeof(string),"{189cab}Порт Los Santos\n{ffffff}Под Контролем: %s\n\n{ffffff}[ /begin >> Начать Захват ]", frakName[PortOwner[w]]);
				UpdateDynamic3DTextLabelText(PortLabel[w],0xA9C4E4FF,string);
				if(PortInfo[wTwo] >= 1) format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}%s был захвачен %s", wtext,frakName[PortInfo[wOne]]), SendRadioMessage(PortInfo[wTwo], COLOR_LIGHTRED, string);
				format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}Ваша организация захватила {cccccc}%s",wtext), SendRadioMessage(PortInfo[wOne], COLOR_LIGHTRED, string);
				SendRadioMessage(PortInfo[wOne], COLOR_LIGHTRED, "{444444}[ Mafia ] {cccccc}Теперь только вы распределяете продукцию на этой территории");

				// Награда (монеты континенталь)
				GiveFractionContinentalCoins(PortInfo[wOne], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_WIN]);
				OrgLog(PortInfo[wOne], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_WIN], "Победа в порту");

				foreach (new targetid : Player)
				{
					// На территории порта
					if (MafiaBattle[0][targetid] == w+1 && HealthAC[targetid] >= 1.0 && GetPlayerVirtualWorld(targetid) == 0 && GetPlayerInterior(targetid) == 0) {}
					else continue;

					// Фракция победителя
					if (fraction(targetid) != PortInfo[wOne]) continue;
					
					new amount = OrganInfo[PortInfo[wOne]][gcontinentalrewards][_:CONTINENTAL_PLAYER_ACTION_SHIP_WIN];
					GivePlayerContinentalCoins(targetid, amount);
					OrgLog(PortInfo[wOne], "paycontinental", 0, "", "", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], amount, "Награда за победу в порту");
				}

				if (PortInfo[wTwo] >= 1)
				{
					GiveFractionContinentalCoins(PortInfo[wTwo], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_LOSE]);
					OrgLog(PortInfo[wTwo], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHIP_LOSE], "Проигрыш в порту");
				}
			}
	    }
	}

    for(new t = 0; t < MAX_THROW; t++)
	{
		if(ThrowInfo[t][tId] >= 1)
		{
			if(ThrowInfo[t][tBombPlant] == true) // Бомба лежит и активирована
			{
				if(ThrowInfo[t][tPara] > 0) // Если бомба активирована
				{
					ThrowInfo[t][tPara] --;
					if(ThrowInfo[t][tPara] <= 0) 
					{
						if(ThrowInfo[t][tId] == 11) CreateRuinsAndExplosion(t); // Бомба
						else if(ThrowInfo[t][tId] == 205) StickyBompExplosion(t); // Бомба Липучка
					}
				}
			}

			if(ThrowInfo[t][tTime] >= 1) ThrowInfo[t][tTime] --;
			else if(ThrowInfo[t][tTime] == 0) 
			{
				if(IsABackPack(ThrowInfo[t][tId]) && ThrowInfo[t][tQara] != 0)
				{
					DeleteBackPack(ThrowInfo[t][tQara]);
				}
				if(ThrowInfo[t][tType] == 6 && ThrowInfo[t][tPara] != 0) DeletePet(ThrowInfo[t][tPara]);

				DestroyThrow(t);
			}
		}
	}
