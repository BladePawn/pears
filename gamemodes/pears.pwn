			new input[8];
			if(sscanf(inputtext, "s[8]", input)) return CriminalCodeSetting(playerid, i, p);
			if(!checknumFloat(input)) return ErrorText(playerid, "[ Мысли ]: Я указываю неверный символ статьи [ Пример 1.2 ]"), CriminalCodeSetting(playerid, i, p);

			new iValue = strval(input);
			if(iValue > MAX_CRIMINAL_CODE_ARTICLE || iValue < 1) return ErrorText(playerid, "[ Мысли ]: Я указываю недопустимый номер статьи"), CriminalCodeSetting(playerid, i, p);

			format(CriminalCodeInfo[i][p][ccArticle], 8, "%s", input);
			
