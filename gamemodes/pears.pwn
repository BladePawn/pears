CMD:mdc(playerid)
{
	if(Komputer[playerid] >= 1)
	{
		new g = fraction(playerid);
		if(IsAFunctionOrganization(63, g, playerid) && GetAccessRankOrg(playerid, g, 63, NO_FBI) 
			|| PlayerInfo[playerid][pFbi] > 0 && GetAccessRankOrg(playerid, 2, 63, PlayerInfo[playerid][pFbi])) mdc_menu(playerid);
		else if (!IsAFunctionOrganization(63, g, playerid))
		{
			new fractionid = PDatabase_GetFractionIDByPos(Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
			for (new i = 0; i < sizeof(policeDatabasePickups); i++)
			{
				if (policeDatabasePickups[i][pdpFraction] != fractionid) continue;

				if (policeDatabasePickups[i][pdpType] == POLICE_DATABASE_PICKUP_HACK)
				{
					if(!IsPlayerInRangeOfPoint(playerid, 2.0, policeDatabasePickups[i][pdpX], policeDatabasePickups[i][pdpY], policeDatabasePickups[i][pdpZ])) continue;
					if(policeDatabaseInfo[fractionid][pdiState] == POLICE_DATABASE_STATE_NORMAL && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Сейчас начать взлом базы данных нельзя [ Сигнализация не отключена ]");
					
					DP[0][playerid] = fractionid;
					if(policeDatabaseInfo[fractionid][pdiHacked] && PlayerInfo[playerid][pID] == policeDatabaseInfo[fractionid][pdiLastHackerID]) {
						return PDatabase_Dialog_ClearMenu(playerid);
					}
					if(policeDatabaseInfo[fractionid][pdiHackerID] > 0) {
						if (policeDatabaseInfo[fractionid][pdiHackerID] == PlayerInfo[playerid][pID]) {
							if (policeDatabasePlayerInfo[playerid][pdpiHackStage] == POLICE_DATABASE_HACK_STAGE_PASSWORD) return PDatabase_Dialog_HackPass(playerid);
							return ErrorMessage(playerid, "{FF6347}Вы уже взламываете базу данных");
						}

						new hacker_playerid = -1;
						foreach (new id : Player)
						{
							if (PlayerInfo[id][pID] == policeDatabaseInfo[fractionid][pdiHackerID]) {
								hacker_playerid = id;
								break;
							}
						}

						if (!IsOnline(hacker_playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кто-то уже взламывает базу данных");
						return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: %s уже взламывает базу данных", playername(hacker_playerid));
					}
					
					if (PDatabase_CheckHackAvailableTime(playerid, fractionid)) return 1;

					// Начало взлома базы данных
					ShowDialog(playerid, POLICE_DATABASE_DIALOG_HACK_START, DIALOG_STYLE_MSGBOX, "{444444}База Данных",
						"\n{ff9000}Вы уверены, что хотите начать {FF6347}взлом базы данных?\n\n" \
						\
						"{ff9000}1. {cccccc}Первая часть состоит из мини-игры\n" \
						"{cccccc}- Вам необходимо нажимать указанную клавишу в нужный момент времени\n" \
						/*"{cccccc}- После прохождения каждого пункта вам будет необходимо отвечать на вопросы\n"*/ \
						"{cccccc}- На некотором этапе прохождения мини-игры будет запущена сигнализация\n" \
						"{cccccc}- Предварительная подготовка напрямую влияет на время срабатывания сигнализации\n" \
						"{cccccc}- Игра будет проходить достаточно долго, запаситесь терпением\n" \
						"{cccccc}- У вас нет права на ошибку!\n" \
						"{ff9000}2. {cccccc}Вторая часть состоит из подбора пароля\n" \
						"{cccccc}- Вам будет отображён загаданный пароль, несколько символов из которого известны заранее\n" \
						"{cccccc}- Вам необходимо угадать недостающие символы за неограниченное количество попыток\n" \
						"{cccccc}- Время на задание ограничено и составляет "#POLICE_DATABASE_HACK_PASSWORD_TIME" минуты\n" \
						"{cccccc}- Сотрудники попытаются вас устранить, поэтому желательно иметь помощников\n" \
						"{ff9000}3. {cccccc}В случае неудачи, повторная попытка взлома, для любого игрока, будет возможна через 1 час\n\n" \
						\
						"{cccccc}* В течение всех этапов вам нужно оставаться рядом с ноутбуком и не покидать серверную",

						"Да", "Нет"
					);
				}
			}
		}
	}
	return 1;
}
CMD:setgravity(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
  	new Float:level, giveplayerid;
  	if(sscanf(params, "if", giveplayerid,level)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить гравитацию игроку [ /setgravity ID Значение]");

	if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska] && playerid != giveplayerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изменить гравитацию админу своего уровня или выше");
	if(level > 50.0 || level < -50.0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Значиние гравитации не может быть выше 50 или ниже -50");
	new string[90];
	format(string, sizeof(string), "[ Мысли ]: Игроку %s установлена гравитация %f [Была: %f]",PlayerInfo[giveplayerid][pName],level, GetPlayerGravity(giveplayerid));
	SendClientMessage(playerid, -1, string);
	if(playerid != giveplayerid) SendClientMessage(giveplayerid, -1, "{ffcc66}Администратор изменил вам гравитацию");
	SetPlayerGravity(giveplayerid, level);
  	return 1;
}
CMD:resetgravity(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отключить гравитацию игроку [ /resetgravity ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
	if(OnlineInfo[params[0]][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
	new string[128];
	format(string, sizeof(string), "[ Мысли ]: Игроку %s выключена гравитация",PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_GREY, string);
	SetPlayerGravity(params[0], 0.01);
	SendClientMessage(params[0], COLOR_GREY, "   Администратор отключил вам гравитацию!");
	return 1;
}
stock UpdateKoster(k)
{
	new string[144];
	if(KosterInfo[k][kStat] == 1)
	{
		if(KosterInfo[k][kTime] > 0)
		{
			format(string,sizeof(string),"{0088ff}Костёр {ff9000}[ /camp ]\n{cccccc}Осталось: %d мин.\n{444444}Разжёг %s",KosterInfo[k][kTime], playername(k));
			UpdateDynamic3DTextLabelText(KosterLabel[k],0xA9C4E4FF,string);
		}
		else
		{
			KosterInfo[k][kStat] = 0;
			DestroyDynamicObject(KosterInfo[k][kObject]);
			DestroyDynamic3DTextLabel(KosterLabel[k]);
		}
	}
	return 1;
}
stock IsACampfire(playerid)
{
	new k = -1, Float:Pos[3];
	foreach(Player,i)
	{
	    if(KosterInfo[i][kStat] == 0) continue;
	    GetDynamicObjectPos(KosterInfo[i][kObject], Pos[0], Pos[1], Pos[2]);
		if(IsPlayerInRangeOfPoint(playerid,3.0,Pos[0], Pos[1], Pos[2]))
		{
	  		k = i;
	  		break;
		}
	}
	return k;
}
CMD:campfire(playerid, const params[])
{
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
	if(get_invent4(playerid, 52, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет углей для розжига костра");
	if(get_invent4(playerid, 53, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет зажигалки");
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу разжечь костёр в здании");
	if(Iamzz[playerid]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу разжечь костёр на охраняемой территории [ Green Zone ]");
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу сейчас разжечь костёр");
	if(KosterInfo[playerid][kStat] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня уже разведён костер");
	if(IsACampfire(playerid) >= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу разжечь костёр рядом с другим костром [ Не менее 3-ёх метров ]");
	if(IsACity(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу разжечь костёр на территории населённого пункта");
	if(GetPlayerSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу разжечь костёр в движении");
	new Float:X,Float:Y,Float:Z,Float:A;
	GetPlayerPos(playerid, X,Y,Z);
	if(Z <= 1.0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу здесь разжечь костёр");
	GetPlayerFacingAngle(playerid,A);
	X=X+1.0*floatsin(-A,degrees);
    Y=Y+1.0*floatcos(-A,degrees);

    TakeInvent(playerid, 52, 1, 0, 999);

	KosterInfo[playerid][kStat] = 1;
	if(get_invent4(playerid, 250, 0) > 0)
	{
		KosterInfo[playerid][kTime] = 15;
		KosterInfo[playerid][kObject] = CreateDynamicObject(12374,X, Y, Z-0.98, 0.0, 0.0, A, 0, 0, -1, 100.00, 100.00);
	}
	else if(get_invent4(playerid, 251, 0) > 0)
	{
		KosterInfo[playerid][kTime] = 30;
		KosterInfo[playerid][kObject] = CreateDynamicObject(12375,X, Y, Z-0.25, 0.0, 0.0, A, 0, 0, -1, 100.00, 100.00);
	}
	else
	{
		KosterInfo[playerid][kTime] = 5;
		KosterInfo[playerid][kObject] = CreateDynamicObject(19632,X, Y, Z-1.0, 0.0, 0.0, A, 0, 0, -1, 100.00, 100.00);
	}
	KosterLabel[playerid] = CreateDynamic3DTextLabel(" ", 0xA9C4E4FF, X, Y, Z-1.0, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID,0,0,0);
    UpdateKoster(playerid);
	Streamer_Update(playerid);
	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, false, false, false, false, false);
	SetPlayerChatBubble(playerid,"разжигает костёр",COLOR_PURPLE,20.0,5000);
	if(PlayerInfo[playerid][pAchieve][27] == 0) AchievePlayer(playerid, 27, 1);
	return 1;
}
CMD:camp(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас подойти к костру");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
	new k = IsACampfire(playerid);
	if(k >= 0)
	{
		PlayerPlaySound(playerid,40405,0,0,0);
		DP[0][playerid] = k;
		ShowDialog(playerid,317,DIALOG_STYLE_LIST,"{ff9000}Костёр","Приготовить Мясо\nПриготовить Рыбу\n{FF6347}Потушить","Выбрать","Отмена");
	}
	return 1;
}
CMD:eatbread(playerid, const params[])
{
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
	if(get_invent4(playerid, 1, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет хлеба");
	if(PlayerInfo[playerid][pNeon] >= 1000) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не голоден");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(Eat[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Не спешите");
	EatPlayer(playerid, 20);
	new para = get_para(playerid, 1), unix = gettime();
	if(sscanf(params, "i", params[0])) TakeInvent(playerid, 1, 1, 0, 999);
	else
	{
		if(params[0] < 0 || params[0] > 39) return 1;
		TakeInvent(playerid, 1, 1, 0, params[0]);
	}
	Eat[playerid] = 1; EatTime[playerid] = 4;
   	RemovePlayerAttachedObject(playerid,1);
   	SetPlayerAttachedObject(playerid, 1, 19579, 6, 0.088000, 0.068999, 0.000000, 123.199928, 107.600013, -74.800003, 1.000000, 1.000000, 1.000000, 0, 0);
   	PlayerPlaySound(playerid, 32200, 0.0, 0.0, 0.0);
	ApplyAnimation(playerid,"FOOD","EAT_Pizza",4.1, false, false, false, false, false);
	SetPlayerChatBubble(playerid,"ест хлеб",COLOR_PURPLE,20.0,4000);
	if(getillness(playerid, 18) >= 0 || unix > para) EatPlayer(playerid, -800), SetPVarInt(playerid, "qweststat", 64), SetPVarInt(playerid, "qwesttime", 8);
	if(unix > para && PlayerInfo[playerid][pAchieve][113] == 0) AchievePlayer(playerid, 113, 1);
	return 1;
}
