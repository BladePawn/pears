 	case 729: // Tuning
	{
	    if(response)
	    {
	        new veh = OnlineInfo[playerid][oAutoserviceVeh];
	        new model = VehInfo[veh][vModel];

            if(listitem == 0) // Гидравлика 7200$
			{
				if(IsANotTuning(model)) return ErrorMessage(playerid, "{FF6347}На этот транспорт нельзя установить гидравлику");
				if(IsAMoto(VehInfo[veh][vModel])) return ErrorMessage(playerid, "{FF6347}Мотоциклам нельзя устанавливать гидравлику");
				if(GetVehicleComponentInSlot(veh, CARMODTYPE_HYDRAULICS) == 1087) return ErrorMessage(playerid, "{FF6347}На этом транспорте уже установлена гидравлика");
				if(oGetPlayerMoney(playerid) < 7200) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег [ 7200$ ]");
			 	LaveTuning(playerid,7200,18); SetPVarInt(playerid,"tunone",1087);AddVehicleComponent(veh, 1087);
            }
            if(listitem == 1) // Азот 8500$
			{
				if(IsAMoto(VehInfo[veh][vModel])) return ErrorMessage(playerid, "{FF6347}Мотоциклам нельзя устанавливать азот");
				if(GetVehicleComponentInSlot(veh, CARMODTYPE_NITRO) == 1010) return ErrorMessage(playerid, "{FF6347}На этом транспорте уже установлен азот");
                if(oGetPlayerMoney(playerid) < 8500) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег [ 8500$ ]");
                LaveTuning(playerid,8500,19); SetPVarInt(playerid,"tunone",1010);AddVehicleComponent(veh, 1010);
            }
            if(listitem == 2) // Снять Гидравлику 5300$
			{
				if(IsAMoto(VehInfo[veh][vModel])) return ErrorMessage(playerid, "{FF6347}Мотоциклам нельзя устанавливать азот");
				if(GetVehicleComponentInSlot(veh, CARMODTYPE_HYDRAULICS) != 1087) return ErrorMessage(playerid, "{FF6347}На этом транспорте не установлена гидравлика");
                if(oGetPlayerMoney(playerid) < 5300) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег [ 5300$ ]");
                LaveTuning(playerid,5300,20);
                SetPVarInt(playerid,"tunone",GetVehicleComponentInSlot(veh,CARMODTYPE_HYDRAULICS));RemoveVehicleComponent(veh,GetVehicleComponentInSlot(veh,CARMODTYPE_HYDRAULICS));
            }
            if(listitem == 3) // Снять Азот 5300$
			{
				if(IsAMoto(VehInfo[veh][vModel])) return ErrorMessage(playerid, "{FF6347}Мотоциклам нельзя устанавливать азот");
				if(GetVehicleComponentInSlot(veh, CARMODTYPE_NITRO) != 1010) return ErrorMessage(playerid, "{FF6347}На этом транспорте не установлен азот");
                if(oGetPlayerMoney(playerid) < 6600) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег [ 6600$ ]");
                LaveTuning(playerid,6600,21);
                SetPVarInt(playerid,"tunone",GetVehicleComponentInSlot(veh,CARMODTYPE_NITRO));RemoveVehicleComponent(veh,GetVehicleComponentInSlot(veh,CARMODTYPE_NITRO));
            }
			if(listitem == 4) // Улучшение характеристик
			{
				if(!IsABoot(veh)) return ErrorMessage(playerid, "{FF6347}На данный транспорт нельзя поставить деталь тюнинга");
				if(IsAMoto(VehInfo[veh][vModel])) return ErrorMessage(playerid, "{FF6347}Мотоциклам нельзя задавать улучшения характеристик");
				if(VehInfo[veh][vSost] != PlayerInfo[playerid][pID]) return ErrorMessage(playerid,"{ff6347}Вы сидите не в своем транспорте");
				return ShowAllTypeDetail(playerid);
			}
        }
	}

