stock StopRing(rg)
{
	RingInfo[rg][rTimer]=0;
 	RingInfo[rg][rStat]=0;
 	if(IsOnline(RingInfo[rg][rIdr]))
	{
		GameTextForPlayer(RingInfo[rg][rIdr],"~n~~n~~n~~n~~n~~n~~n~~n~~r~CANCEL",2000,3);
		SetPVarInt(RingInfo[rg][rIdr],"GP",0);
 		DisablePlayerCheckpoint(RingInfo[rg][rIdr]);
 		box[RingInfo[rg][rIdr]]=0;
 		boxid[RingInfo[rg][rIdr]]=9999;
 		PlayerPlaySound(RingInfo[rg][rIdr],45400,0,0,0);
 		oGivePlayerMoney(RingInfo[rg][rIdr], RingInfo[rg][rStatlave]/2);
 		if(rg == 4){PPSetPlayerPos(RingInfo[rg][rIdr], -1395.8237,96.5140,2044.1777);PPSetPlayerFacingAngle(RingInfo[rg][rIdr], 90.8897);}
		TempGive(RingInfo[rg][rIdr]);
	}
	if(IsOnline(RingInfo[rg][rIdb]))
	{
		GameTextForPlayer(RingInfo[rg][rIdb],"~n~~n~~n~~n~~n~~n~~n~~n~~r~CANCEL",2000,3);
		SetPVarInt(RingInfo[rg][rIdb],"GP",0);
		DisablePlayerCheckpoint(RingInfo[rg][rIdb]);
		box[RingInfo[rg][rIdb]]=0;
		boxid[RingInfo[rg][rIdb]]=9999;
		PlayerPlaySound(RingInfo[rg][rIdb],45400,0,0,0);
		oGivePlayerMoney(RingInfo[rg][rIdb], RingInfo[rg][rStatlave]/2);
		if(rg == 4){PPSetPlayerPos(RingInfo[rg][rIdb], -1367.4558,96.3671,2044.1429);PPSetPlayerFacingAngle(RingInfo[rg][rIdb], 271.0581);}
		TempGive(RingInfo[rg][rIdr]);
	}
	RingInfo[rg][rStatlave] = 0;
	RingInfo[rg][rLaver] = 0;
	RingInfo[rg][rLaveb] = 0;
	switch(rg)
	{
 		case 0: UpdateDynamic3DTextLabelText(RingText[rg],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {00cc00}Grove Street {cccccc}[ ALT ]");
    	case 1: UpdateDynamic3DTextLabelText(RingText[rg],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {9900cc}Ballas Gang {cccccc}[ ALT ]");
    	case 2: UpdateDynamic3DTextLabelText(RingText[rg],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {ffcc33}Vagos Gang {cccccc}[ ALT ]");
    	case 3: UpdateDynamic3DTextLabelText(RingText[rg],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {00ffff}Los Aztecas {cccccc}[ ALT ]");
    	case 4: UpdateDynamic3DTextLabelText(RingText[rg],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {ff9000}ММА {cccccc}[ ALT ]");
    	case 5: UpdateDynamic3DTextLabelText(RingText[rg],0xA9C4E4FF,"{ffffff}* {0088ff}Ринг {ff9000}Тюрьма {cccccc}[ ALT ]");
  	}
	return 1;
}

//==========[ Игра в Карты ]==========
stock create_textdraw_huddeskplace(playerid, place, targetplace) // Создание Текстдравов [ игрок, другой игрок, место, другого место ]
{
	new Float:pos_draw[2];
	if(place == 0 || place == 5) 		pos_draw[0] = HudDeskDraw_0_5[targetplace][0], 	pos_draw[1] = HudDeskDraw_0_5[targetplace][1];
	else if(place == 1) 				pos_draw[0] = HudDeskDraw_1[targetplace][0], 	pos_draw[1] = HudDeskDraw_1[targetplace][1];
	else if(place == 2 || place == 3) 	pos_draw[0] = HudDeskDraw_2_3[targetplace][0], 	pos_draw[1] = HudDeskDraw_2_3[targetplace][1];
	else if(place == 4) 				pos_draw[0] = HudDeskDraw_4[targetplace][0], 	pos_draw[1] = HudDeskDraw_4[targetplace][1];
	
	HudPlaceDraw[0][playerid][targetplace] = CreatePlayerTextDraw(playerid, pos_draw[0], pos_draw[1], "LD_SPAC:white"); // фон карточки игрока
	PlayerTextDrawLetterSize(playerid, HudPlaceDraw[0][playerid][targetplace], 0.005248, 0.070000);
	PlayerTextDrawTextSize(playerid, HudPlaceDraw[0][playerid][targetplace], 63.362632, 34.066650);
