	PlayerTextDrawSetShadow(playerid, PlayerSpeedDraw[playerid][5], 0);
	PlayerTextDrawSetOutline(playerid, PlayerSpeedDraw[playerid][5], 0);
	PlayerTextDrawBackgroundColour(playerid, PlayerSpeedDraw[playerid][5], 51);
	PlayerTextDrawFont(playerid, PlayerSpeedDraw[playerid][5], TEXT_DRAW_FONT:2);
	PlayerTextDrawSetProportional(playerid, PlayerSpeedDraw[playerid][5], true);
	
	PlayerSpeedDraw[playerid][6] = CreatePlayerTextDraw(playerid, 163.3, 390.233270, "LD_SPAC:white"); // Полоска хп транспорта
	PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][6], 0.000000, 0.000000);
	PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][6], 41.317187, 11.199962); // 0.749852 - минимум | 41.317187 - максимум
	PlayerTextDrawAlignment(playerid, PlayerSpeedDraw[playerid][6], TEXT_DRAW_ALIGN:1);
