		if(response) ClearPlayerTicketArcticle(playerid, DP[0][playerid]);
		else ShowPlayerSettingTicket(playerid, DP[1][playerid]);
	}
	case 1350: // Взлом транспорта
	{
	    if(response)
		{
			if(OnlineInfo[playerid][oInHandThing][0] > 0) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки\n\n{cccccc}Предмет, оружие или какое-то действие");
		    new hardLevel = 0;
			new v = DP[0][playerid];
			if(VehInfo[v][vAlarmUnix]+1209600 > gettime()) return ErrorMessage(playerid, "{FF6347}Вы не можете взломать этот транспорт\n{ffcc66}Установлено актуальное обновление сигнализации");

			if(VehInfo[v][vAlarmSystem] == 1) hardLevel = 2;
			else if(VehInfo[v][vAlarmSystem] == 2) hardLevel = 3;

			if(DP[1][playerid] == 1) CreateBreaking(playerid, BREAKING_TYPE_VEHICLE, v, hardLevel); // Взлом двери
			else if(DP[1][playerid] == 2) CreateBreaking(playerid, BREAKING_TYPE_ENGINE, v, hardLevel); // Взлом замка зажигания
		}
	}
	case 1351:
	{
		if(response)
		{
			if(listitem > MAX_CRIME+1 || listitem < 0) return ErrorMessage(playerid,"Ну чет не то БРАТ");
			if(listitem == 0)
			{
				if(PlayerInfo[playerid][pTheft] != -1)
				{
					PlayerInfo[playerid][pTheft] = -1;
					SuccessMessage(playerid,"{44ff99}Вы отказались от расследования угона транспорта");
				}
				else
				{
					ErrorMessage(playerid,"{FF6347}Вы не брали дело об угоне транспорта");
					return ListCrime(playerid);
				}
			}
			else
			{
				new listlist = List[listitem-1][playerid];
				if(crimeInfo[listlist][crmSenderID] == 0) return pc_cmd_mdc(playerid);
				if(PlayerInfo[playerid][pTheft] == listlist) return ErrorMessage(playerid,"{FF6347}Вы уже взяли это дело");
				crimeInfo[listlist][crmStatusCrime] = 2;
				if(PlayerInfo[playerid][pTheft] != -1 && PlayerInfo[playerid][pTheft] != listlist) format(string, sizeof(string), "{cccccc}Вы отказались от прошлой заявки и взяли новую на поиски угнанного т/с %s", GetVehicleName(crimeInfo[listlist][crmTargetZalupaParam]));
				else format(string, sizeof(string), "{cccccc}Вы взяли заявку на поиски угнанного т/с %s", GetVehicleName(crimeInfo[listlist][crmTargetZalupaParam]));
				PlayerInfo[playerid][pTheft] = listlist;
				SuccessMessage(playerid,string);
			}
		}
		else pc_cmd_mdc(playerid);
	}
	case 1397: OrderEscort(playerid, DP[4][playerid]);
	case 1380:
	{
		new g = DP[4][playerid];
		if(response)
		{	
			if(listitem == 0)
			{
				DP[1][playerid] = -1;
				for(new i = 0; i < 10; i++)
				{
					if(OrganInfo[g][gOrder][i] == 0)
					{
						DP[1][playerid] = i;
						break;
					}
				}
				if(DP[1][playerid] < 0) return ErrorText(playerid, "{FF6347}Нет свободных слотов для заказа товаров [ Лимит: 10 ]"), OrderEscort(playerid, g);
				if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Товар нельзя добавить, доставку выполняет NGSA"), OrderEscort(playerid, g);
				ShowOrderThingEscort(playerid, g);
			}
			if(listitem == 1)
			{
				if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Нельзя изменить статус, доставку выполняет NGSA"), OrderEscort(playerid, g);
				new yesOrder;
				for(new i = 0; i < MAX_ORDERESCORT; i++)
				{
					if(OrganInfo[g][gOrder][i] > 0)
					{
						yesOrder = 1;
						break;
					}
				}
				if(yesOrder == 0) return ErrorText(playerid, "{FF6347}Нельзя активировать доставку, у вас не добавлены товары"), OrderEscort(playerid, g);

				if(OrganInfo[g][gOrderStatus] == 0) 
				{
					// Считаем стоимость заказа
					OrganInfo[g][gDeliveryPay] = 0;
					for(new i = 0; i < MAX_ORDERESCORT; i++)
					{
						if(OrganInfo[g][gOrder][i] > 0)
						{
							OrganInfo[g][gDeliveryPay] += getThingPriceGos(OrganInfo[g][gOrder][i], OrganInfo[g][gOrderType][i]) * OrganInfo[g][gOrderQuan][i];
						}
					}
					
					if(OrganInfo[g][glave] < OrganInfo[g][gDeliveryPay] + OrganInfo[3][gTax]) 
					{
						format(string,sizeof(string),"{FF6347}На счету организации недостаточно средств\n\nСтоимость заказа: %d$\nСтоимость доставки от NGSA: %d$\nНе хватает: %s$",
							OrganInfo[g][gDeliveryPay],
							OrganInfo[3][gTax],
							OrganInfo[g][gDeliveryPay] + OrganInfo[3][gTax] - bigint_get(OrganInfo[g][glave]));
						ErrorText(playerid, string);
						OrderEscort(playerid, g);
						return 1;
					}

					OrganInfo[g][gOrderStatus] = 1;
					PlayerPlaySound(playerid,6401,0,0,0);
					new line[120],lines[960];
					format(line,sizeof(line),"{99ff66}Заказ Создан!"), strcat(lines,line);

					if(g != 3) format(line,sizeof(line),"\n\n{cccccc}Сотрудники NGSA примут ваш заказ и произведут доставку в ближайшее время"), strcat(lines,line);
					format(line,sizeof(line),"\n{cccccc}Деньги будут списаны со счёта организации по окончанию доставки"), strcat(lines,line);
					if(g != 3) format(line,sizeof(line),"\n{cccccc}NGSA, в любом случае, обеспечивает гарантию доставки боеприпасов на склад"), strcat(lines,line);

					if(g == 3)
					{
						format(line,sizeof(line),"\n\n{cccccc}Стоимость заказа: {99ff66}%d$ {cccccc}[%s]", OrganInfo[g][gDeliveryPay] / 2, get_k(OrganInfo[g][gDeliveryPay] / 2)), strcat(lines,line);
						format(line,sizeof(line),"\n{cccccc}NGSA для своего склада оплачивает половину гос. стоимости Правительству"), strcat(lines,line);
					}
					else
					{
						format(line,sizeof(line),"\n\n{cccccc}Стоимость заказа: {99ff66}%d$ {cccccc}[%s]", OrganInfo[g][gDeliveryPay], get_k(OrganInfo[g][gDeliveryPay])), strcat(lines,line);
						format(line,sizeof(line),"\n{cccccc}Стоимость доставки: {99ff66}%d$ {cccccc}[%s]", OrganInfo[3][gTax], get_k(OrganInfo[3][gTax])), strcat(lines,line);
						format(line,sizeof(line),"\n{cccccc}Итого: {99ff66}%d$ {cccccc}[%s]", OrganInfo[g][gDeliveryPay] + OrganInfo[3][gTax], get_k(OrganInfo[g][gDeliveryPay] + OrganInfo[3][gTax])), strcat(lines,line);
					}
					ShowDialog(playerid,1397,DIALOG_STYLE_MSGBOX, "Заказ Боеприпасов", lines, "OK", "");

					if(g != 3)
					{
						format(string, sizeof(string), "{FFFFFF}** {00C6FF}%s сформировало заказ на доставку боеприпасов {ffffff} **", frakeasyName[g]);
   			    		SendRadioMessage(3, COLOR_ALLDEPT, string);
					}

					SaveEscortOrder(g);

					OrgLog(g, "order", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", OrganInfo[g][gDeliveryPay] + OrganInfo[3][gTax], "Заказал боеприпасы");
				}
				else
				{
					OrganInfo[g][gOrderStatus] = 0;

					// Сохраняем статус
					new string_mysql[100];
					mysql_format(pearsq, string_mysql,sizeof(string_mysql),"UPDATE `pp_organization` SET `OrderStatus` = '0' WHERE `frakid` = '%d'", g);
					query_empty(pearsq, string_mysql);

					OrderEscort(playerid, g);
				}
			}
			if(listitem >= 2 && listitem <= 13)
			{
				new listord = List[listitem-2][playerid];
				if(OrganInfo[g][gOrder][listord] == 0) return ErrorText(playerid, "{FF6347}Ошибка! В слоте нет выбранного товара"), OrderEscort(playerid, g);

				DP[1][playerid] = listord;
				InsertOrderEscort(playerid, g, listord);
			}
		}
		else showDialogOrganizationMenu(playerid);
	}
	case 1381:
	{	
		new g = fraction(playerid), ord = DP[1][playerid];
		if(response)
		{
			if(listitem == 0)
			{	
				if(OrganInfo[g][gOrder][ord] == 0) return ErrorText(playerid, "{FF6347}В этом слоте не выбран предмет"), OrderEscort(playerid, g);
				if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Вы не можете сейчас изменить заказ, доставку выполняет NGSA"), OrderEscort(playerid, g);

