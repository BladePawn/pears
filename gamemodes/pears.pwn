	// Вводим код для восстановления доступа к аккаунту
	// case 15 сука
	case 15: 
	{
		if(OnlineInfo[playerid][oLogged] == 1) return 1;

		if(response)
		{
			// Ошибка кода (на всякий пожарный)
			if(OnlineInfo[playerid][oRecoveryPassword] == 0 || OnlineInfo[playerid][oRecoveryFrog] != g_MysqlRaceCheck[playerid])
			{
				TextDrawShowForPlayer(playerid, Chernifon);
				ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Ошибка восстановления доступа к аккаунту\n{ffcc66}Если вы не понимаете почему произошла ошибка, перезайдите на сервер и повторите попытку","Ок","");
				Kickx(playerid);
				return 1;
			}

			new input;
			// Ничего не ввели
            if(sscanf(inputtext, "i", input))
			{
				OnlineInfo[playerid][oRecoveryAccess] = false;
				recoveryhelp(playerid);
				return 1;
			}

			// Неверный код
			if(input != OnlineInfo[playerid][oRecoveryPassword])
			{
				OnlineInfo[playerid][oRecoveryTry] ++;
				if(OnlineInfo[playerid][oRecoveryTry] >= 3)
				{
					TextDrawShowForPlayer(playerid, Chernifon);
					ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Вы 3 раза ввели неверный код восстановления!","Ок","");
					Kickx(playerid);
					return 1;
				}
				format(string,sizeof(string),"{cccccc}Привет, {ff9000}%s\n{FF6347}Неверный код восстановления {ff0000}[ %d/3 ]\n\n{cccccc}Сверните игру и проверьте почту {0088ff}[ ALT + TAB или Win ]",PlayerInfo[playerid][pName], OnlineInfo[playerid][oRecoveryTry]);
				ShowDialog(playerid,15,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",string,"Далее","Отмена");
				return 1;
			}

			// Верный код
			else if(input == OnlineInfo[playerid][oRecoveryPassword])
			{
				OnlineInfo[playerid][oRecoveryAccess] = true;
				recoveryhelp(playerid);
			}
		}
		else autorizehelp(playerid);
		return 1;
	}

	// Вводим новый пароль для восстановления аккаунта
	// case 16 сука
	case 16:
	{
		if(OnlineInfo[playerid][oLogged] == 1) return 1;

		if(response)
		{
			// Ошибка кода (на всякий пожарный)
			if(OnlineInfo[playerid][oRecoveryPassword] == 0 // Не отправляли код
				|| OnlineInfo[playerid][oRecoveryAccess] == false // Не получили доступ к восстановлению
				|| OnlineInfo[playerid][oRecoveryFrog] != g_MysqlRaceCheck[playerid]) // Другое подключение к серверу
			{
				TextDrawShowForPlayer(playerid, Chernifon);
				ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Ошибка восстановления доступа к аккаунту\n{ffcc66}Если вы не понимаете почему произошла ошибка, перезайдите на сервер и повторите попытку","Ок","");
				Kickx(playerid);
				return 1;
			}

			// Ввели какую-то херню, а не пароль
			if(!strlen(inputtext) || strlen(inputtext) < 10 || strlen(inputtext) > 40 || checksimvolpassword(inputtext))
			{
				PlayerPlaySound(playerid,4203,0,0,0);
				recoveryhelp(playerid);
				return 1;
			}

			// Уведомление о смене пароля
			OnlineInfo[playerid][oProcessPassword] = true;
			CheckResetPassowrd(playerid);

			// Кешируем новый пароль
			bcrypt_hash(playerid, "OnPasswordHashResetPassword", inputtext, BCRYPT_COST, "s", inputtext);
		}
		else autorizehelp(playerid);
		return 1;
	}


