	mysql_tquery(pearsq, "SELECT * FROM `pp_bizzobject`", "LoadBizzObjects", ""); // Загружаем позицию объектов бизнеса (дверь, вывески)
	mysql_tquery(pearsq, "SELECT * FROM `accessory`", "LoadAccessory", ""); // Загрузка параметров аксессуаров
	mysql_tquery(pearsq, "SELECT * FROM `editModel`", "LoadEditModelTextDraw", ""); // Загрузка редактора текстдравов
