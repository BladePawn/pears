CMD:1kkfam(playerid)
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	new str[124], sctring[12400];
	format(str,sizeof(str),"{cccccc}Семья\t{99ff66}На счету | {cccccc}Сумма\t{cccccc}Название\t{cccccc}Основатель\n"), strcat(sctring,str);
	for(new f = 0; f < sizeof(FamilyInfo); f++)
	{
		if(FamilyInfo[f][fSost] >= 1)
		{
			if(FamilyInfo[f][fMoney] >= 1000000)
			{
				format(str,sizeof(str),"{cccccc}№ %d\t{99ff66}%d$ [ %s ]\t%s\t{cccccc}%s\n",f,FamilyInfo[f][fMoney],get_k(FamilyInfo[f][fMoney]),FamilyInfo[f][fName],FamilyInfo[f][fOsn]);
				strcat(sctring,str);
			}
		}
	}
	ShowDialog(playerid,1700,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Больше 1кк у семей",sctring,"Ок","");
	return 1;
}
function Call_1kk(playerid, kk_chat)
{
	new rows, str[234], sctring[14800],p,qwer[144],mon, kol, ofl, onl;
	new year, month,day;
	getdate(year, month, day);
	cache_get_row_count(rows);
	format(str,sizeof(str),"{cccccc}Имя\t{99ff66}На руках | В банке | {cccccc}Сумма\t{0088ff}Фишки\t{ffcc00}Gold\n"), strcat(sctring,str);
	for(new i = 0; i < rows; i++)
	{
		new datnam[24],datad[7];
		cache_get_value_name(i, "Name", datnam, 24);
		cache_get_value_name_int(i, "Level", datad[0]);
		cache_get_value_name_int(i, "Online", datad[1]);
		cache_get_value_name_int(i, "Money", datad[2]);
		cache_get_value_name_int(i, "Account", datad[3]);
		cache_get_value_name_int(i, "Ammo1", datad[4]);
		cache_get_value_name_int(i, "DonateMoney", datad[5]);
		cache_get_value_name_int(i, "user_id", datad[6]);
		mon = datad[2]+datad[3];
		if(datad[1] == 1 && DP[3][playerid] == 1)
		{
			p = ReturnUser(datnam, 1);
			format(str,sizeof(str),"{cccccc}[Lvl %d] {ffffff}%s[%d]\t{99ff66}%d$ | %d$ {cccccc}| %s\t{0088ff}%dF\t{ffcc00}%dG\n",datad[0],datnam,p,datad[2],datad[3],get_k(mon), datad[4], datad[5]);
			strcat(sctring,str);
			onl ++;
			DP[0][playerid] = datad[6];
			if(kk_chat == 1)
			{
			    format(str,sizeof(str),"%s[%d] [ %d$ | %d$ | %s ] %dF %dG",datnam,p,datad[2],datad[3],get_k(mon), datad[4], datad[5]);
				SendClientMessage(playerid, COLOR_GREY, str);
			}
		}
 		else if(datad[1] == 0)
 		{
			format(str,sizeof(str),"{cccccc}[Lvl %d] %s\t{99ff66}%d$ | %d$ {cccccc}| %s\t{0088ff}%dF\t{ffcc00}%dG\n",datad[0],datnam,datad[2],datad[3],get_k(mon), datad[4], datad[5]);
			strcat(sctring,str);
			ofl ++;
			DP[1][playerid] = datad[6];
			if(kk_chat == 1)
			{
			    format(str,sizeof(str),"%s [ %d$ | %d$ | %s ] %dF %dG",datnam,datad[2],datad[3],get_k(mon), datad[4], datad[5]);
				SendClientMessage(playerid, COLOR_GREY, str);
			}
		}
		kol ++;
	}
	if(kol >= 1)
	{
		DP[2][playerid] ++;
		if(kol >= 30)
		{
		    if(onl >= 30) DP[3][playerid] = 1;
		    else DP[3][playerid] = 0;
			format(qwer,sizeof(qwer),"{ff9000}Выше 1кк [%d] {cccccc}[%02d.%02d.%d] Страница %d",kol,day,month,year, DP[2][playerid]);
			ShowDialog(playerid,1042,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Далее","");
		}
		else
		{
			format(qwer,sizeof(qwer),"{ff9000}Выше 1кк [%d] {cccccc}[%02d.%02d.%d] Страница %d",kol,day,month,year, DP[2][playerid]);
			ShowDialog(playerid,1700,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Ок","");
		}
		PlayerPlaySound(playerid,40405,0,0,0);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Никого нет..");
	return 1;
}

alias:kk("1kk")
CMD:kk(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	DP[3][playerid] = 1;
	DP[2][playerid] = 0;
	DP[0][playerid] = 0;
	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Выше 1кк","{cccccc}Поиск игроков...","*","");
	if(!sscanf(params, "i",params[0])) DP[4][playerid] = 1;
	else DP[4][playerid] = 0;
	mysql_tquery(pearsq, "SELECT user_id, Name, Level, Online, Money, Account, Ammo1, DonateMoney FROM `pp_igroki` WHERE \
		`Money`>='1000000' OR `Account`>='1000000' OR `DonateMoney`>='1000' OR `Ammo1`>='1000000' ORDER BY `Online` DESC LIMIT 30", "Call_1kk", "dd", playerid, DP[4][playerid]);
	return 1;
}

CMD:setnewpass(playerid, const params[])
{
	if(!strcmp(PlayerInfo[playerid][pMail],"\0",true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя менять пароль без привязанного Email [ Y >> Меню >> Аккаунт ]");
	if(PlayerInfo[playerid][pMailStat] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Вы не подтвердили Email [ Y >> Меню >> Аккаунт ]");
	if(gPlayerLogged22[playerid] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не выдали доступ к смене пароля [ Y >> Меню >> Аккаунт >> Сменить Пароль ]");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сменить пароль [ /setnewpass ПАРОЛЬ ]");
	if(strlen(params[0]) > 40) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Максимальное количество символов: 40");
	if(strlen(params[0]) < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Минимальное количество символов: 10");
	if(checksimvolpassword(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Содержание Пароля: буквы, цифры и стандартные символы [ Пример: Hi?story1945_! ]");
	bcrypt_hash(playerid, "OnPasswordHashSetnewpass", params[0], BCRYPT_COST, "s", params[0]);
	return true;
}
CMD:bomb(playerid)
{
	if(howstun(playerid) || GetPlayerSpeed(playerid) > 3 || SitPlayer[playerid] >= 1) return 1;
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в транспорте");
	if(NoAnim[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, false, false, false, false, false); // Place Bomb
	return 1;
}
