	case 66: // auto сука
	{
	    if(response)
	    {
			new v = DP[0][playerid];
			if(listitem == 0) // Двери
			{
			    if(VehInfo[v][vCarLock] == 0)
				{
				    LockCar(v, 1);
				    SetPlayerChatBubble(playerid,"запирает транспорт",COLOR_PURPLE,20.0,3000);
				    GameTextForPlayer(playerid, RusToGame("~w~Транспорт ~r~Заперт"), 3000, 4);
				}
				else if(VehInfo[v][vCarLock] == 1)
				{
				    LockCar(v, 0);
				    SetPlayerChatBubble(playerid,"открывает транспорт",COLOR_PURPLE,20.0,3000);
				    GameTextForPlayer(playerid, RusToGame("~w~Транспорт ~g~Открыт"), 3000, 4);
				}
				PlayerPlaySound(playerid, 1145, 0,0,0);
				if(PlayerInfo[playerid][pDrawVisible][7] == false && Cars[v] != 52 && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8) UpdateVehLock(playerid);
				automobile(playerid);
			}
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
				if(listitem == 1) pc_cmd_engine(playerid); // Двигатель
				if(listitem == 2) pc_cmd_light(playerid);// Фары
				if(listitem == 3)
				{
					if(PlayerInfo[playerid][pSLimit] > 0) PlayerInfo[playerid][pSLimit] = 0, PlayerPlaySound(playerid,31200,0,0,0), UpdateVehEngine(playerid);
					else
					{
						ShowDialog(playerid,1193,DIALOG_STYLE_INPUT,"{ff9000}Управление Транспортом","\n{cccccc}Введите {ff9000}максимальную скорость{cccccc}, чтобы активировать ограничитель\n{0088ff}Скорость: 50 - 250 KM/H\n","Принять","Отмена");
						return 1;
					}
				}

				if(listitem == 4)
				{
					GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
					if(IsABootFront(v))
					{
						if(boot == false) SetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, true, objective), VehInfo[v][vBonnet] = 1;
						else SetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, false, objective), VehInfo[v][vBonnet] = 0;
					}
					else 
					{
						if(bonnet == false) SetVehicleParamsEx(v, engine, lights, alarm, doors, true, boot, objective), VehInfo[v][vBonnet] = 1;
						else SetVehicleParamsEx(v, engine, lights, alarm, doors, false, boot, objective), VehInfo[v][vBonnet] = 0;
					}
				}
				if(listitem == 5)
				{
					GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
					if(IsABootFront(v)) 
					{
						if(bonnet == false) SetVehicleParamsEx(v, engine, lights, alarm, doors, true, boot, objective), VehInfo[v][vBoot] = 1;
						else SetVehicleParamsEx(v, engine, lights, alarm, doors, false, boot, objective), VehInfo[v][vBoot] = 0;
					}
					else 
					{
						if(boot == false) SetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, true, objective), VehInfo[v][vBoot] = 1;
						else SetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, false, objective), VehInfo[v][vBoot] = 0;
					}
				}

				if(listitem >= 6 && listitem <= 10) GetVehicleParamsCarWindows(v, driver, passenger, backleft, backright);
				if(listitem == 6) // Окно Переднее Левое
				{
					if(driver == false) SetVehicleParamsCarWindows(v, true, passenger, backleft, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0);
					else if(driver != false) SetVehicleParamsCarWindows(v, false, passenger, backleft, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0);
				}
				if(listitem == 7) // Окно Переднее Правое
				{
					if(passenger == false) SetVehicleParamsCarWindows(v, driver, true, backleft, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0);
					else if(passenger != false) SetVehicleParamsCarWindows(v, driver, false, backleft, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0);
				}
				if(IsAZad(VehInfo[v][vModel]))
				{
					if(listitem == 8) // Окно Заднее Левое
					{
						if(backleft == false) SetVehicleParamsCarWindows(v, driver, passenger, true, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0);
						else if(backleft != false) SetVehicleParamsCarWindows(v, driver, passenger, false, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0);
					}
					if(listitem == 9) // Окно Заднее Правое
					{
						if(backright == false) SetVehicleParamsCarWindows(v, driver, passenger, backleft, true), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0);
						else if(backright != false) SetVehicleParamsCarWindows(v, driver, passenger, backleft, false), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0);
					}
					if(listitem == 10) allwindow(playerid, v); // Все  Окна
				}
				else
				{
					if(listitem == 8) allwindow(playerid, v); // Все Окна
				}
				automobile(playerid);
			}
			else
			{
				if(listitem == 1) 
				{
					if(!(get_invent4(playerid, 9, 0) >= 1 && Dei[playerid] == 8) && !(get_invent4(playerid, 61, 0) >= 1 && Dei[playerid] == 12)) return ErrorMessage(playerid,"{ff6347}Возьмите в руки Канистру или вещество Гелий 3, чтобы заправить транспорт\n\n{cccccc}Приобрести канистру с топливом можно на любой заправке\n{cccccc}Гелий 3 можно найти сбив НЛО");
					fill_vehicle(playerid, v, 0); // заправить
				}
			}
	    }
	}
