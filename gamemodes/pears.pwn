	REDAKT_TYPE_GANG_SPAWN_MOVE, // Перемещение маппинга на спавнах банд
	REDAKT_TYPE_TERMINAL_MOVE, // Перемещение терминала бизнеса
	REDAKT_TYPE_TERMINAL_SET, // Установка терминала бизнеса
	REDAKT_TYPE_IKEA_SET, // Установка объекта IKEA
	REDAKT_TYPE_IKEA_MOVE, // Перенес объекта IKEA
	REDAKT_TYPE_BIZ_FURNITURE_SET, // Установка мебели в бизнесе
	REDAKT_TYPE_BIZ_FURNITURE_MOVE, // Перемещение мебели в бизнесе
	REDAKT_TYPE_BUS_STATION, // Автобусная остановка
	REDAKT_TYPE_OWN_SET, // Установка предмета в личном редакторе
	REDAKT_TYPE_OWN_MOVE, // Перемещение предмета в личном редакторе
	REDAKT_TYPE_STREET_MARKET, // Объект для стритов [Маркет]
	REDAKT_TYPE_STREET_BENZ, // Объект для стритов [Бенз]
	REDAKT_TYPE_STREET_SERVICE, // Объект для стритов [Сервис]
	REDAKT_TYPE_STREET_TERMINAL, // Объект для стритов [Терминал]
	REDAKT_TYPE_SECTA, // Объекты для секты
	REDAKT_TYPE_TRAILER, // Установка трейлера в игровом мире [Игрок]
	REDAKT_TYPE_ADM_TRAILER, // Установка трейлера в игровом мире [Администратор]
