CMD:infoseamap(playerid)
{
	new stro[94],sctringo[1310];
	format(stro,sizeof(stro),"{0088ff}Как пользоваться картой моряка?"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n\n{cccccc}- Купите карту в рыболовном магазине"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Откройте её в инвентаре: N"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Карта показывает что находится вокруг вас"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Если карта пустая, значит рядом с вами ничего нет"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Серая рыба: здесь водится мелкая рыба [Цифра - количество рыбы в радиусе]"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Жёлтая рыба: здесь водится крупная рыба [Цифра - количество рыбы в радиусе]"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Акула: здесь водятся акулы"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Морская Звезда: в радиусе 50 метров есть морская звезда"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Ракушка: в радиусе 50 метров есть ракушка"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}- Сундук с Сокровищами: в радиусе 200 метров лежит сундук"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n\n{cccccc}Надпись под картой: {ffcc00}Сокровища Существуют"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}Обозначает, что где-то в штате на дне рек или заливов лежит сундук"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}Возьмите лодку и отправляйтесь на поиски"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}Карта оповестит вас когда вы окажетесь рядом с сундуком"), strcat(sctringo,stro);
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Карта Моряка",sctringo,"Ок","");
	return 1;
}

CMD:number(playerid, const params[])
{
    if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(sscanf(params, "s[25]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телефонная книга [ /number ID ]");
	if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	new giveplayerid;
 	giveplayerid = ReturnUser(params[0]);
	if(IsOnline(giveplayerid))
	{
		new string[144];
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
 		if(PlayerInfo[giveplayerid][pDrugPerk] == 0) return ErrorMessage(playerid, "{FF6347}У этого игрока нет номера телефона");
		format(string, sizeof(string), "{ffffff}Имя: [ {ff8000}%s {ffffff}] Телефон: {ff8000}%d",rpplayername(giveplayerid),PlayerInfo[giveplayerid][pDrugPerk]);
  		SendClientMessage(playerid, COLOR_WHITE, string);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	return 1;
}

CMD:skydive(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,882.296081, -1949.764526, 4.686224) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(SkyPause > gettime()) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Аэротруба сейчас занята [ Через %d сек ]", SkyPause-gettime());
		ShowDialog(playerid,1064,DIALOG_STYLE_MSGBOX,"{ff9000}SKYDIVE","{cccccc}Вы уверены, что хотите испытать аттракцион?","Да","Нет");
    }
	return 1;
}
CMD:buyteh(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1995.8162,1565.3362,1564.1647) && GetPlayerInterior(playerid) == 207 && GetPlayerVirtualWorld(playerid) >= 1)
	{
	    new b = GetPlayerVirtualWorld(playerid)+132;
		new list;
		new line[214],lines[4096];
		format(line,sizeof(line),"{cccccc}Товар\tСтоимость\tНаличие"), strcat(lines,line);

		for(new i = 0; i < MAX_BIZ_ITEM; i++)
		{
		    if(BizzInfo[b][bProduct][i] > 0)
		    {
		        List[list][playerid] = i;
				format(line,sizeof(line),"\n{ff9000}%s \t {99ff66}%d$ \t {444444}%d", GetNameThing(0, BizzInfo[b][bProduct][i], BizzInfo[b][bTypeProduct][i], 0), BizzInfo[b][bPrice][i], BizzInfo[b][bItem][i]), strcat(lines,line);
                list ++;
			}
		}
		ShowDialog(playerid,645,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Магазин с Техникой",lines,"Выбор","Отмена");
		PlayerPlaySound(playerid,40405,0,0,0);
    }
	return 1;
}
stock Create_InfBoat(playerid)
{
	PlayerPlaySound(playerid, 1139, 0,0,0);
	new Float:X,Float:Y,Float:Z,Float:A;
	GetPlayerPos(playerid, X,Y,Z), GetPlayerFacingAngle(playerid,A);
	X=X+5.0*floatsin(-A,degrees);
	Y=Y+5.0*floatcos(-A,degrees);
	OnlineInfo[playerid][oInflatableBoat] = PP_CreateVehicle(473, X,Y,Z-0.5,A, 0, 0, 3600,0, -1, 0.0);
	LockCar(OnlineInfo[playerid][oInflatableBoat], 0);
	VehInfo[OnlineInfo[playerid][oInflatableBoat]][vGas] = get_para(playerid, 48);
	VehInfo[OnlineInfo[playerid][oInflatableBoat]][vAgetid] = playerid;
	Cars[OnlineInfo[playerid][oInflatableBoat]] = 54;
	return 1;
}
stock Pump_InfBoat(playerid)
{
	new BoatX = GetPVarInt(playerid,"BoatX"), BoatY = GetPVarInt(playerid,"BoatY"),BoatZ = GetPVarInt(playerid,"BoatZ");
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, BoatX,BoatY,BoatZ))
	{
		SetPVarInt(playerid, "BoatX", 0),SetPVarInt(playerid, "BoatY", 0),SetPVarInt(playerid, "BoatZ", 0), SetPVarInt(playerid, "oryjtemp", 0), SetPVarInt(playerid,"Arobsklad",0);
        ClearAnim(playerid);
		return ErrorMessage(playerid, "{ff6347}Вы далеко отошли от точки надувания лодки, процесс прерван!");
	}
	SetPVarInt(playerid, "oryjtemp", GetPVarInt(playerid, "oryjtemp") + 1 + random(3));
	if(GetPVarInt(playerid,"oryjtemp") >= 100)
	{
		SetPVarInt(playerid, "BoatX", 0),SetPVarInt(playerid, "BoatY", 0),SetPVarInt(playerid, "BoatZ", 0);
		SetPVarInt(playerid, "oryjtemp", 0), SetPVarInt(playerid,"Arobsklad",0);
	 	GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Лодка: ~w~100/100"), 1500, 3);
	 	Create_InfBoat(playerid);
	 	ClearAnim(playerid);
		if (!GetPVarInt(playerid, "BlowBoatMessage")) {
			ShowDialog(playerid, 1700, DIALOG_STYLE_MSGBOX, "{ffcc00}*", "{99ff66}Подсказка :)\n{ffcc66}Вы можете снова сдуть лодку, нажав на неё дважды в инвентаре", "*", "");
			SetPVarInt(playerid, "BlowBoatMessage", 1);
		}
	}
	else
	{
		new string[58];
		format(string, sizeof(string), RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Лодка: ~w~%d/100"), GetPVarInt(playerid, "oryjtemp"));
	 	GameTextForPlayer(playerid, string, 1500, 3);
	 	ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, false, true, true, true, true);
 	}
 	return 1;
}
stock Close_InfBoat(playerid)
{
    if(Cars[OnlineInfo[playerid][oInflatableBoat]] == 54 && VehInfo[OnlineInfo[playerid][oInflatableBoat]][vAgetid] == playerid)
    {
    	PlayerPlaySound(playerid, 25801, 0,0,0);
 		set_para(playerid, 48, VehInfo[OnlineInfo[playerid][oInflatableBoat]][vGas]);
 		ACDestroyVehicle(OnlineInfo[playerid][oInflatableBoat]);
	}
	OnlineInfo[playerid][oInflatableBoat] = NON;
	return 1;
}
CMD:findboat(playerid)
{
	if(get_invent4(playerid, 48, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет надувной лодки");
 	if(OnlineInfo[playerid][oInflatableBoat] == NON) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Надувная лодка сейчас с собой [ N ]");
	new Float:X,Float:Y,Float:Z;
	GetVehiclePos(OnlineInfo[playerid][oInflatableBoat], X, Y, Z);
	CreateGps(playerid,X, Y, Z, 0, 0, 10.0);
	SendClientMessage(playerid,COLOR_GREY," {0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Надувная Лодка {ffffff}отмечена на карте");
	return 1;
}
CMD:findchest(p)
{
	if(PlayerInfo[p][pSoska] < 19) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(SeaChestStat == 0) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Сундука с сокровищами нет на карте");
	new Float:pos[3];
	GetDynamicObjectPos(SeaChestObj, pos[0], pos[1], pos[2]);
	CreateGps(p, pos[0], pos[1], 0.0, 0, 0, 10.0);
	SendClientMessage(p,COLOR_GREY," {0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Сундук с Сокровищами {ffffff}отмечен на карте");
	return 1;
}
CMD:loadchest(p)
{
	if(PlayerInfo[p][pSoska] < 19) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(SeaChestStat == 1) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Сундук с сокровищами уже существует [ /findchest ]");
	LoadSeaChest();
	SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Сундук загружен на карту [ /findchest ]");
	PlayerPlaySound(p,6401,0,0,0);
	AdminLog("loadchest", PlayerInfo[p][pID], PlayerInfo[p][pName], PlayerInfo[p][pPlaIP], 0, "", "", 0, "Загрузил сундук");
	return 1;
}
CMD:loadufo(p)
{
	if(PlayerInfo[p][pSoska] < 19) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(ufo_stat > 0) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающая тарелка уже существует в штате [ /findufo ]");
	create_ufo();
	SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающая тарелка загружена на сервер [ /findufo ]");
	PlayerPlaySound(p,6401,0,0,0);
	AdminLog("loadufo", PlayerInfo[p][pID], PlayerInfo[p][pName], PlayerInfo[p][pPlaIP], 0, "", "", 0, "Загрузил НЛО");
	return 1;
}
CMD:fallufo(p, const params[])
{
	if(PlayerInfo[p][pSoska] < 19) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(ufo_stat != 1) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающая тарелка не летит над штатом");
	if(sscanf(params, "i",params[0])) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Уровень летающую тарелку [ /fallufo 0-29 ]");
	if(params[0] < 0 || params[0] > 29) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 29");
	fall_ufo(params[0]);
	SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающая тарелка падает");
	return 1;
}
CMD:findufo(p)
{
	if(PlayerInfo[p][pSoska] < 19) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(ufo_stat == 0) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающей тарелки нет на карте");
	new Float:pos[3];
	GetDynamicObjectPos(ufo_object, pos[0], pos[1], pos[2]);
	CreateGps(p, pos[0], pos[1], pos[2], 0, 0, 10.0);
	SendClientMessage(p,COLOR_GREY," {0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Летающая Тарелка {ffffff}отмечена на карте");
	return 1;
}
CMD:delufo(p)
{
	if(PlayerInfo[p][pSoska] < 19) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(ufo_stat == 0) return SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающей тарелки нет на карте");
	if(ufo_stat == 1 || ufo_stat == 2)
	{
		KillTimer(ufo_tims);
		DestroyDynamicObject(ufo_object), ufo_stat = 0;
	}
	else if(ufo_stat == 3)
	{
		KillTimer(ufo_tims);
		DestroyDynamicObject(ufo_object), DestroyDynamicObject(ufo_smoke), ufo_stat = 0;
	}
	else if(ufo_stat == 5)
	{
		KillTimer(ufo_tims);
		ufo_timer();
	}
	else SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Дождитесь создания лута нло перед тем как удалить");
	SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Летающей тарелка удалена");
	return 1;
}
CMD:boat(playerid)
{
	if(get_invent4(playerid, 48, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет надувной лодки");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу сейчас использовать надувную лодку");
 	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу сейчас использовать надувную лодку");
 	if(Hold[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня заняты руки");
 	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
    if(GetPlayerSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу надуть лодку в движении");
 	if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо..");
 	if(OnlineInfo[playerid][oInflatableBoat] == NON)
 	{
 		new animname[32], animlib[32];
		GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
		if(strcmp(animlib, "SWIM", true) == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу надуть лодку, находясь в воде");
	 	SetPVarInt(playerid,"oryjtemp",0), SetPVarInt(playerid,"Arobsklad",3);
	 	if (!GetPVarInt(playerid, "BlowBoatMessage")) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нужно накачать лодку {ff9000}[%s]", buttonName[Device[playerid]]);
	 	ApplyAnimation(playerid,"BOMBER","BOM_Plant_Loop",4.0, false, true, true, true, true);
	 	GameTextForPlayer(playerid,RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Лодка: ~w~0/100"), 5000, 3);
		new Float:BoatX,Float:BoatY,Float:BoatZ;
		GetPlayerPos(playerid,BoatX,BoatY,BoatZ);
		SetPVarInt(playerid, "BoatX", floatround(BoatX, floatround_round));
		SetPVarInt(playerid, "BoatY", floatround(BoatY, floatround_round));
		SetPVarInt(playerid, "BoatZ", floatround(BoatZ, floatround_round));
 	}
 	else
 	{
 		new Float:X,Float:Y,Float:Z;
		GetVehiclePos(OnlineInfo[playerid][oInflatableBoat], X, Y, Z);
 		if(!IsPlayerInRangeOfPoint(playerid,5.0,X, Y, Z)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я далеко от надувной лодки [ Найти лодку: /findboat ]");
 		Close_InfBoat(playerid);
 	}
	return 1;
}


CMD:gotokas(playerid, const params[])
