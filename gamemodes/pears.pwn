	          Stopeee228[playerid] = 8;
            }
            if(IsPlayerInRangeOfPoint(playerid,9.0,-131.4318,-148.0569,3.1172))
	        {
	        	if(PlayerInfo[playerid][pDom] == 103 || PlayerInfo[playerid][pHouserent] == 103 || DomInfo[103][dFam] == PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1)
	        	{
	          		if(DomInfo[103][dProd0] <= 0) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: В цистернах этого дома нет топлива {ff0000}*");
	          		Stopeee228[playerid] = 8;
        		}
				else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу использовать цистерны этого дома");
            }
            if(IsPlayerInRangeOfPoint(playerid,9.0,357.5112,-1807.9323,4.5737))
	        {
