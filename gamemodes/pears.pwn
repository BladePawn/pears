stock DisplayPlayerTaxes(toplayer, playerid)
{
	if (!IsPlayerConnected(playerid) || !IsPlayerConnected(toplayer)) return 0;

	new stro[214],sctringo[4096];

	// Налоги
	new dtax, btax, d = PlayerInfo[playerid][pDom], b = PlayerInfo[playerid][pBusiness], v[MAX_MYVEHICLE];
	new roomtaxes = 0;

	for(new i = 0; i < MAX_MYVEHICLE; i++) v[i] = PlayerInfo[playerid][pMyVeh][i];

	if(d > 0) dtax += DomInfo[d][dTaxes];
	for(new room;room < 10; room++)
	{
		if(PlayerInfo[playerid][pApartmentsRoom][room] != 0) roomtaxes += ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][room]-1][aprTaxes];
	}
	if(b > 0) btax += BizzInfo[b][bTaxes];
	new totaltaxes = dtax+roomtaxes+btax+PlayerInfo[playerid][pTaxes][0]+PlayerInfo[playerid][pTaxes][1];
	format(stro,sizeof(stro),"{ff9000}Налоги {cccccc}[ %s ] | Общая Сумма: {FF6347}%d$ [%s]", PlayerInfo[playerid][pName], totaltaxes, get_k(totaltaxes)), strcat(sctringo,stro);

	// Налог на транспорт
	format(stro,sizeof(stro),"\n\n{ff9000}Транспортный Налог {444444}[%.3f проц.]",nalog[1]), strcat(sctringo,stro);
	if(v[0] >= 400 || v[1] >= 400 || v[2] >= 400 || v[3] >= 400 || v[4] >= 400 || v[5] >= 400 || v[6] >= 400 || v[7] >= 400 || v[8] >= 400 || v[9] >= 400
	|| v[10] >= 400 || v[11] >= 400 || v[12] >= 400 || v[13] >= 400 || v[14] >= 400 || v[15] >= 400 || v[16] >= 400 || v[17] >= 400 || v[18] >= 400 || v[19] >= 400)
	{
		format(stro,sizeof(stro),"\n{cccccc}Общая Сумма: {FF6347}%d$\n", PlayerInfo[playerid][pTaxes][0]), strcat(sctringo,stro);
		for(new mv = 0; mv < MAX_MYVEHICLE; mv++)
		{
			if(v[mv] >= 400)
			{
				format(stro,sizeof(stro),"\n{cccccc}%s | Часы без Оплаты: %d/50 [%d$ в час]",GetVehicleName(v[mv]),PlayerInfo[playerid][pVehTax][mv],Procent(1, GetVehiclePriceGos(v[mv]))), strcat(sctringo,stro);
				if(PlayerInfo[playerid][pVehTax][mv] >= 20 && PlayerInfo[playerid][pVehTax][mv] <= 50) format(stro,sizeof(stro)," {FF6347}[ Требуется Оплата ]"), strcat(sctringo,stro);
				else if(PlayerInfo[playerid][pVehTax][mv] >= 51) format(stro,sizeof(stro)," {ff0000}[ Просрочено на %d часов ]",PlayerInfo[playerid][pVehTax][mv]-50), strcat(sctringo,stro);
			}
		}
	}
	else format(stro,sizeof(stro),"\n{444444}нет"), strcat(sctringo,stro);

	format(stro,sizeof(stro),"\n\n{ff9000}Налог на Недвижимость {444444}[%.3f проц.]",nalog[0]), strcat(sctringo,stro);
	if(d > 0) // Недвижимость
	{
		// Налог на дом
		if(d > 0)
		{
			format(stro,sizeof(stro),"\n{cccccc}Дом № %d: {FF6347}%d$ {cccccc}| [%d$ в сутки]", d, dtax, Procent(0, DomInfo[d][dSost2])), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}Дни без Оплаты: %d/15",DomInfo[d][dTaxday]), strcat(sctringo,stro);
			if(DomInfo[d][dArest] == 1) format(stro,sizeof(stro),"\n{cccccc}Статус: {ff0000}Арестован"), strcat(sctringo,stro);
			else
			{
				if(DomInfo[d][dTaxday] <= 4) format(stro,sizeof(stro),"\n{cccccc}Статус: Накопление налога"), strcat(sctringo,stro);
				else if(DomInfo[d][dTaxday] >= 5 && DomInfo[d][dTaxday] <= 15) format(stro,sizeof(stro),"\n{cccccc}Статус: {FF6347}Арест через %d дней",16-DomInfo[d][dTaxday]), strcat(sctringo,stro);
				else format(stro,sizeof(stro),"\n{cccccc}Статус: {ff0000}Просрочено на %d дней",DomInfo[d][dTaxday]-15), strcat(sctringo,stro);
			}
		}
	}
	else format(stro,sizeof(stro),"\n{444444}Дом: нет"), strcat(sctringo,stro);
	{
		new rooms_newline_inserted = false;
		for(new room;room < 10; room++)
		{
			if(PlayerInfo[playerid][pApartmentsRoom][room] != 0)
			{
				if (!rooms_newline_inserted)
				{
					format(stro,sizeof(stro),"\n"), strcat(sctringo,stro);
					rooms_newline_inserted = true;
				}
				format(stro,sizeof(stro),"\n{cccccc}Квартира № %d: {FF6347}%d$ {cccccc}| [%d$ в сутки] | Дни без оплаты: %d/15",
					ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][room]-1][aprID],
					ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][room]-1][aprTaxes],
					Procent(0, Apartments[ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][room]-1][aprApartmentsID]][apPrice]),
					ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][room]-1][aprTaxday]
				), strcat(sctringo,stro);
			}
		}
	}

	format(stro,sizeof(stro),"\n\n{ff9000}Налог на Бизнес {444444}[%.3f проц.]",nalog[3]), strcat(sctringo,stro);
	if(b > 0) // Бизнес
	{
		format(stro,sizeof(stro),"\n{cccccc}Бизнес № %d: {FF6347}%d$", b, btax), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Дни без Оплаты: %d/15",BizzInfo[b][bTaxday]), strcat(sctringo,stro);
		if(BizzInfo[b][bArest] == 1) format(stro,sizeof(stro),"\n{cccccc}Статус: {ff0000}Арестован"), strcat(sctringo,stro);
		else
		{
			if(BizzInfo[b][bTaxday] <= 4) format(stro,sizeof(stro),"\n{cccccc}Статус: Накопление налога"), strcat(sctringo,stro);
			else if(BizzInfo[b][bTaxday] >= 5 && BizzInfo[b][bTaxday] <= 15) format(stro,sizeof(stro),"\n{cccccc}Статус: {FF6347}Арест через %d дней",16-BizzInfo[b][bTaxday]), strcat(sctringo,stro);
			else format(stro,sizeof(stro),"\n{cccccc}Статус: {ff0000}Просрочено на %d дней",BizzInfo[b][bTaxday]-15), strcat(sctringo,stro);
		}
	}

	// Подоходный налог
	format(stro,sizeof(stro),"\n\n{ff9000}Подоходный Налог {444444}[%.3f проц.]",nalog[2]), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}Налог от Дохода: {FF6347}%d$",PlayerInfo[playerid][pTaxes][1]), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{cccccc}Часы без Оплаты: %d/50",PlayerInfo[playerid][pPlaTax]), strcat(sctringo,stro);
	if(PlayerInfo[playerid][pPlaTax] <= 19) format(stro,sizeof(stro),"\n{cccccc}Статус: Накопление налога"), strcat(sctringo,stro);
	else if(PlayerInfo[playerid][pPlaTax] >= 20 && PlayerInfo[playerid][pPlaTax] <= 50) format(stro,sizeof(stro),"\n{cccccc}Статус: {FF6347}Требуется Оплата"), strcat(sctringo,stro);
	else if(PlayerInfo[playerid][pPlaTax] >= 51) format(stro,sizeof(stro),"\n{cccccc}Статус: {ff0000}Просрочено на %d часов",PlayerInfo[playerid][pPlaTax]-50), strcat(sctringo,stro);

	// Информация
	format(stro,sizeof(stro),"\n\n{444444}Информация:"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Налог на транспорт начисляется каждый час когда вы Online"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Налог на транспорт необходимо оплачивать 1 раз в 50 часов вашей игры"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Налог на недвижимость начисляется 1 раз в сутки"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Налог на недвижимость необходимо оплачивать 1 раз в 15 дней"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Подоходный налог начисляется в момент получения зарплаты"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Подоходный налог необходимо оплачивать 1 раз в 50 часов вышей игры"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{444444}- Налог на бизнес необходимо оплачивать 1 раз в 15 дней"), strcat(sctringo,stro);

	return ShowDialog(toplayer,1047,DIALOG_STYLE_MSGBOX,"{99ff66}Банк",sctringo,"*","");
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if (OnlineInfo[playerid][oDialogID] != dialogid || OnlineInfo[playerid][oDialogClosed]) return 1;
	OnlineInfo[playerid][oDialogClosed] = true;

	if (CallPublic(playerid, 0)) return false;

    if (strfind(inputtext, "%", true) != -1)
	{
		ErrorText(playerid, "{FF6347}Вы используете запрещённый символ");
		return 0;
	}

    if (OnlineInfo[playerid][oLogged] == 0
		&& dialogid != 1 && dialogid != 2 && dialogid != 3 && dialogid != 4 && dialogid != 5 && dialogid != 6 && dialogid != 15 && dialogid != 16
		&& dialogid != 2017 && dialogid != 798 && dialogid != 948
		&& dialogid != 220 && dialogid != 1182 && dialogid != 1183 && dialogid != 1184 && dialogid != 1290 && dialogid != 1291
		&& dialogid != 502 && dialogid != 503  && APARTMENTS_DIALOG_SPAWNCHOICE != e_DialogId:dialogid && dialogid != 1700)
	{
		SendClientMessage(playerid, COLOR_GREY, "   Вы не залогинились!!!");
		return 0;
	}

    new string[512];
	if (dialogid != 1 && dialogid != 2 && dialogid != 4) 
	{
		if (server == 0) printf("OnDialogResponse %s case %d: %s", PlayerInfo[playerid][pName] ,dialogid,inputtext);
	}
	switch (dialogid) {
	
	case 1700:
	{
		return true;
	}
	case 1742:
	{
		return true;
	}
	case 1996:
	{
		return true;
	}
	case 2017:
	{
		return true;
	}
	case 2018:
	{
		return true;
	}

	case 1: // Авторизация Пароль
	{
		if(response)
		{
		    if(!strlen(inputtext))
			{
 				format(string,sizeof(string),"{cccccc}Привет, {ff9000}%s\nВведите ваш пароль\n\n{cccccc}Если вы забыли пароль, нажмите ESC или Отмена",PlayerInfo[playerid][pName]);
				if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,1,DIALOG_STYLE_PASSWORD,"{ff9000}Авторизация",string,"Далее","Отмена");
				else ShowDialog(playerid,1,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",string,"Далее","Отмена");
				return 1;
			}

			// Шифруем для авторизации
			bcrypt_verify(playerid, "OnPasswordHashLogin", inputtext, PlayerInfo[playerid][pKey]);
			return 1;
		}
		else
		{
			if(gWindowPass[playerid] == 1) autorizehelp(playerid);
			else if(gWindowPass[playerid] == 2) regmenu(playerid);
		}
	}
	case 2: // Пароль
	{
		if(OnlineInfo[playerid][oLogged] == 1) return 1;
		if(response)
		{
		    if(Login[3][playerid] == 0)
		    {
				if(!strlen(inputtext) || strlen(inputtext) < 10 || strlen(inputtext) > 40 || checksimvolpassword(inputtext))
				{
				    PlayerPlaySound(playerid,4203,0,0,0);
					new str[74],sctring[296];
					format(str,sizeof(str),"\n{cccccc}Привет, {ff9000}%s",PlayerInfo[playerid][pName]), strcat(sctring,str);
					format(str,sizeof(str),"\n{ff9000}Пароль: {99ff66}Введите ваш будущий Пароль"), strcat(sctring,str);
					if(checksimvol(inputtext)) format(str,sizeof(str),"\n\n{FF6347}Содержание пароля: Буквы, цифры и символы"), strcat(sctring,str);
					else format(str,sizeof(str),"\n\n{cccccc}Содержание пароля: Буквы, цифры и символы"), strcat(sctring,str);
					if(strlen(inputtext) < 10 || strlen(inputtext) > 40) format(str,sizeof(str),"\n{FF6347}Количество символов: от 10 до 40"), strcat(sctring,str);
					else format(str,sizeof(str),"\n{cccccc}Количество символов: от 10 до 40"), strcat(sctring,str);
					format(str,sizeof(str),"\n\n{ff9000}Скрыть пароль: Отмена >> Ввод пароля\n"), strcat(sctring,str);
					if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,2,DIALOG_STYLE_PASSWORD,"{ff9000}Регистрация",sctring,"Далее","Отмена");
					else ShowDialog(playerid,2,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
					return 1;
				}
				else 
				{
					mysql_format(pearsq, string, sizeof(string), "SELECT acc FROM `pp_name` WHERE `name` = '%e'", PlayerInfo[playerid][pName]);
					mysql_tquery(pearsq, string, "CheckRegister", "ds", playerid, inputtext);
				}
			}
			return 1;
		}
		else
		{
			if(gWindowPass[playerid] == 1) autorizehelp(playerid);
			else if(gWindowPass[playerid] == 2) regmenu(playerid);
		}
	}
	case 3:
	{
		if(response)
		{
			if(listitem < 0 || listitem > 1) return regmenu(playerid);
			PlayerInfo[playerid][pKomnataCity] = DP[listitem][playerid] + 1;

			if(CitySelectRegistr == 0) CitySelectRegistr = 1;
			else if(CitySelectRegistr == 1) CitySelectRegistr = 0;

			ShowDialog(playerid,948,DIALOG_STYLE_MSGBOX,"{ff9000}Регистрация","{99ff66}Вы уверены, что хотите продолжить?\n\n{cccccc}Следующий пункт: {ff9000}Выбор одежды","Да","Нет");
		}
		else regmenu(playerid);
	}
   	case 4: // Email
   	{
		if(response)
		{
			if(!strlen(inputtext)) return registerhelp(playerid, 2); // Пропускаем ввод пароля

		    if(strlen(inputtext) < 5 || strlen(inputtext) > 80 || checksimvolMail(inputtext)
				//|| !checkmail(inputtext) // Старая проверка на валидный email
				|| !(strfind(inputtext, "@", true) != -1 && strfind(inputtext, ".", true) != -1))
			{
				PlayerPlaySound(playerid,4203,0,0,0);
				new str[78],sctring[296];
				format(str,sizeof(str),"\n{cccccc}Логин: %s",PlayerInfo[playerid][pName]), strcat(sctring,str);
				if(checksimvolMail(inputtext) || !checkmail(inputtext)) format(str,sizeof(str),"\n{ff9000}Email: {FF6347}Введите ваш Email [ Некорректный сервис Email ]"), strcat(sctring,str);
				else format(str,sizeof(str),"\n{ff9000}Email: {99ff66}Введите ваш Email"), strcat(sctring,str);
			 	if(strlen(inputtext) < 5 || strlen(inputtext) > 80) format(str,sizeof(str),"\n\n{FF6347}Количество символов: от 5 до 80"), strcat(sctring,str);
			 	else format(str,sizeof(str),"\n\n{cccccc}Количество символов: от 5 до 80"), strcat(sctring,str);
			 	format(str,sizeof(str),"\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
			 	ShowDialog(playerid,4,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
				return 1;
			}

		    mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Mail` = '%e' AND `MailStat` >= '1'",inputtext);
            mysql_tquery(pearsq, string, "Call_checkmailtwo", "ds", playerid, inputtext);
			return 1;
		}
		else regmenu(playerid);
	}
	case 5: // Реферал
	{
   	    if(response)
		{
			if(!strlen(inputtext)) return registerhelp(playerid, 3);
			if(strlen(inputtext) < 3 || strlen(inputtext) > 20 || strfind(PlayerInfo[playerid][pName], inputtext,true) != (-1) || !CheckRP_Nickname(inputtext))
			{
			    PlayerPlaySound(playerid,4203,0,0,0);
				new str[100],sctring[600];
			    format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
				format(str,sizeof(str),"\n{cccccc}Email: %s", PlayerInfo[playerid][pMail]), strcat(sctring,str);
				if(strlen(inputtext) < 3 || strlen(inputtext) > 20) format(str,sizeof(str),"\n{ff9000}Реферал: {FF6347}Введите никнейм [ От 3 до 20 символов ]"), strcat(sctring,str);
				else if(strfind(PlayerInfo[playerid][pName],inputtext,true) != (-1)) format(str,sizeof(str),"\n{ff9000}Реферал: {FF6347}Введите никнейм [ Нельзя указать своё имя ]"), strcat(sctring,str);
				else if(!CheckRP_Nickname(inputtext)) format(str,sizeof(str),"\n{ff9000}Реферал: {FF6347}Введите никнейм [ Пример: Vasya_Pupkin ]"), strcat(sctring,str);
				else format(str,sizeof(str),"\n{ff9000}Реферал: {99ff66}Введите никнейм"), strcat(sctring,str);
				format(str,sizeof(str),"\n\n{cccccc}Сделайте подарок другу и введите его никнейм"), strcat(sctring,str);
			 	format(str,sizeof(str),"\n{cccccc}Ваш друг получит подарочки благодаря вам {0088ff}:)"), strcat(sctring,str);
			 	format(str,sizeof(str),"\n\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
			 	ShowDialog(playerid,5,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
	    		return 1;
			}
			mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'",inputtext);
        	mysql_tquery(pearsq, string, "Call_findreferal", "ds", playerid,inputtext);
		}
		else regmenu(playerid);
	}
	case 6: // Промокод
	{
	    if(response)
		{
		    if(!strlen(inputtext)) return registerhelp(playerid, 4);
		    if(PromoNumber <= 0 || strlen(inputtext) < 3 || strlen(inputtext) > 60 || checksimvolpassword(inputtext))
		    {
		        PlayerPlaySound(playerid,4203,0,0,0);
				new str[100],sctring[600];
			    format(str,sizeof(str),"\n{cccccc}Логин: %s", PlayerInfo[playerid][pName]), strcat(sctring,str);
				format(str,sizeof(str),"\n{cccccc}Email: %s", PlayerInfo[playerid][pMail]), strcat(sctring,str);
				if(PlayerInfo[playerid][pReferalID] >= 1) format(str,sizeof(str),"\n{cccccc}Реферал: %s",PlayerInfo[playerid][pReferal]), strcat(sctring,str);
				else format(str,sizeof(str),"\n{cccccc}Реферал: нет"), strcat(sctring,str);
				format(str,sizeof(str),"\n{ff9000}Промокод: {FF6347}Введите промокод"), strcat(sctring,str);
				format(str,sizeof(str),"\n\n{cccccc}Сделайте себе подарок и введите промокод"), strcat(sctring,str);
			 	format(str,sizeof(str),"\n{cccccc}Не переживайте, если не знаете ни одного промокода"), strcat(sctring,str);
			 	format(str,sizeof(str),"\n{cccccc}В игре всегда появляются новые, с интересными подарками"), strcat(sctring,str);
			 	format(str,sizeof(str),"\n\n{ff9000}Вы можете пропустить этот пункт и нажать Далее\n"), strcat(sctring,str);
			 	ShowDialog(playerid,6,DIALOG_STYLE_INPUT,"{ff9000}Регистрация",sctring,"Далее","Отмена");
			 	return 1;
		 	}
	        a_flood[0][playerid] += 1;
			ReloadPromoName(inputtext);
			FindRegistrPromo(playerid, inputtext);
	    }
	    else regmenu(playerid);
	}
	case 948:
	{
		if(response) continue_reg(playerid);
		else
		{
			if(gWindowPass[playerid] == 2)
  			{
  			    if(Login[3][playerid] == 0) return registerhelp(playerid, 0);
  			    else if(PlayerInfo[playerid][pMailStat] == 0) return registerhelp(playerid, 1);
  			    else if(PlayerInfo[playerid][pReferalID] == 0) return registerhelp(playerid, 2);
  			    else if(PlayerInfo[playerid][pPromoreg] == 0) return registerhelp(playerid, 3);

				// Последний пункт на возврате, всегда очищаем
				PlayerInfo[playerid][pKomnataCity] = 0;
				registerhelp(playerid, 4);
  			}
		}
	}
	case 949: pc_cmd_mm(playerid);
	case 7:
   	{
   	    if(response)
		{
		   	if(!strlen(inputtext))
			{
			    PlayerPlaySound(playerid,4203,0,0,0);
                format(string,sizeof(string),"\n{cccccc}Введите {ff9000}Email{cccccc}, который хотите привязать к аккаунту\n");
				ShowDialog(playerid,7,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
                return 1;
			}
			if(strlen(inputtext) < 5 || strlen(inputtext) > 80)
			{
			    PlayerPlaySound(playerid,4203,0,0,0);
			    format(string,sizeof(string),"\n{cccccc}Введите {ff9000}Email{cccccc}, который хотите привязать к аккаунту\n{FF6347}Не меньше 5 и не больше 80 символов\n");
				ShowDialog(playerid,7,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
                return 1;
			}
			if(!checkmail(inputtext) || checksimvolMail(inputtext)) // Если Мыло Дерьмо
			{
			    PlayerPlaySound(playerid,4203,0,0,0);
			    format(string,sizeof(string),"\n{cccccc}Введите {ff9000}Email{cccccc}, который хотите привязать к аккаунту\n{FF6347}Некорретный сервис email\n");
				ShowDialog(playerid,7,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
                return 1;
			}
      		else if(strfind(inputtext, "@", true) != -1 && strfind(inputtext, ".", true) != -1)
		    {
          	    mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Mail` = '%e' AND `MailStat` = '0'",inputtext);
                mysql_tquery(pearsq, string, "Call_checkmail", "ds", playerid,inputtext);
			    return 1;
			}
			else
			{
			    PlayerPlaySound(playerid,4203,0,0,0);
                format(string,sizeof(string),"\n{cccccc}Введите {ff9000}Email{cccccc}, который хотите привязать к аккаунту\n");
				ShowDialog(playerid,7,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
                return 1;
			}
		}
		else pc_cmd_safe(playerid);
	}
	case 8:
   	{
   	    if(response)
		{
		    new unix = gettime();
		    if(PlayerInfo[playerid][pMailStat] == 0) return ErrorMessage(playerid, "{FF6347}Ваш Email уже подтверждён или вы не вводили его");
            if(listitem == 0)
            {
                // Отправить Email
                if(a_flood[1][playerid] == 0 || unix > a_flood[1][playerid])
                {
			    	a_flood[1][playerid] = unix+60;
					format(string, sizeof(string), "Никнейм: %s | Код подтверждения Email: %d", PlayerInfo[playerid][pName], PlayerInfo[playerid][pMailStat]);
					SendMail(PlayerInfo[playerid][pMail], "Привязка Email", string, PlayerInfo[playerid][pName]);
				}

				new lines[400];
                format(lines,sizeof(lines),"{99ff66}Найдите письмо с кодом подтверждения на Email: {ff9000}%s\
											\n\nСвернуть Игру {0088ff}[ ALT + TAB или Win ]\
											\n{444444}Если вы не нашли письмо, проверьте СПАМ или отправьте его повторно\
											\n\n{FF6347}Внимание! Письмо с кодом может придти в течении 5-ти минут",PlayerInfo[playerid][pMail]);
	    		ShowDialog(playerid,11,DIALOG_STYLE_INPUT,"{ff9000}Email",lines,"Принять","Выход");
            }
            if(listitem == 1)
            {
                format(string,sizeof(string),"\n{cccccc}Введите {ff9000}Email{cccccc}, который хотите привязать к аккаунту\n");
				ShowDialog(playerid,7,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
            }
            if(listitem == 2)
            {
				if(a_flood[1][playerid] > unix) return format(string,sizeof(string),"{FF6347}Вы уже отправили код на Email. Подождите %d сек. для повторной отправки", a_flood[1][playerid]-unix), ErrorMessage(playerid, string);
		    	a_flood[1][playerid] = unix+60;
				format(string, sizeof(string), "Никнейм: %s | Код подтверждения Email: %d", PlayerInfo[playerid][pName], PlayerInfo[playerid][pMailStat]);
				SendMail(PlayerInfo[playerid][pMail], "Привязка Email", string, PlayerInfo[playerid][pName]);

                new lines[400];
                format(lines,sizeof(lines),"{99ff66}Найдите письмо с кодом подтверждения на Email: {ff9000}%s\
											\n\nСвернуть Игру {0088ff}[ ALT + TAB или Win ]\
											\n{444444}Если вы не нашли письмо, проверьте СПАМ или отправьте его повторно\
											\n\n{FF6347}Внимание! Письмо с кодом может придти в течении 5-ти минут",PlayerInfo[playerid][pMail]);
	    		ShowDialog(playerid,11,DIALOG_STYLE_INPUT,"{ff9000}Email",lines,"Принять","Выход");
            }
		}
		else pc_cmd_safe(playerid);
	}
	case 11: // Email Сука - Подтверждение
	{
		if(response)
		{
		    if(PlayerInfo[playerid][pMailStat] == 0) return ErrorMessage(playerid, "{FF6347}Ваш Email уже подтверждён или вы не вводили его");
            if(strval(inputtext) == PlayerInfo[playerid][pMailStat])
		    {
		        PlayerInfo[playerid][pMailStat] = 0;
                mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `MailStat`='0' WHERE `user_id`='%d'",PlayerInfo[playerid][pID]);
				query_empty(pearsq, string);
				if(PlayerInfo[playerid][pAchieve][0] == 0) AchievePlayer(playerid, 0, 1);
				format(string,sizeof(string),"\n{99ff66}Отлично! Привязка Email выполнена\n{cccccc}Ваш Email: {ff9000}%s\n{cccccc}Теперь вам доступна смена пароля и установка Google\n", PlayerInfo[playerid][pMail]);
				SuccessMessage(playerid, string);
			}
			else
			{
			    format(string,sizeof(string),"\n{99ff66}Код подтверждения отправлен на Email: {ff9000}%s\n\nСвернуть Игру {0088ff}[ ALT + TAB или Win ]\n{444444}Если вы не нашли письмо, проверьте СПАМ\n",PlayerInfo[playerid][pMail]);
	    		ShowDialog(playerid,11,DIALOG_STYLE_INPUT,"{ff9000}Email",string,"Принять","Выход");
			    return 1;
            }
		}
		else pc_cmd_safe(playerid);
	}
  	case 9:
	{
	    if(response)
	    {
	        switch(listitem)
			{
	          case 0: // Normal Style
	          {
	            if(GetPlayerFightingStyle(playerid) == FIGHT_STYLE_NORMAL) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже владею этим стилем боя");
	            PlayerInfo[playerid][pStyle] = 0;
	            SetPlayerFightingStyle(playerid,FIGHT_STYLE_NORMAL);
	            SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь у меня обычный стиль боя");
              }
              case 1: // Kneehead Style
	          {
	            if(GetPlayerFightingStyle(playerid) == FIGHT_STYLE_KNEEHEAD) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже владею этим стилем боя");
	            PlayerInfo[playerid][pStyle] = 1;
	            SetPlayerFightingStyle(playerid,FIGHT_STYLE_KNEEHEAD);
	            SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мой стиль боя Kneehead");
              }
              case 2: // Boxing Style
	          {
	            if(GetPlayerFightingStyle(playerid) == FIGHT_STYLE_BOXING) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже владею этим стилем боя");
	            PlayerInfo[playerid][pStyle] = 3;
	            SetPlayerFightingStyle(playerid,FIGHT_STYLE_BOXING);
	            SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мой стиль боя Boxing");
              }
              case 3: // Kungfu Style
	          {
	            if(GetPlayerFightingStyle(playerid) == FIGHT_STYLE_KUNGFU) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже владею этим стилем боя");
	            PlayerInfo[playerid][pStyle] = 2;
	            SetPlayerFightingStyle(playerid,FIGHT_STYLE_KUNGFU);
	            SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мой стиль боя Kungfu");
              }
              case 4: // Grabkick Style
	          {
	            if(GetPlayerFightingStyle(playerid) == FIGHT_STYLE_GRABKICK) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже владею этим стилем боя");
	            PlayerInfo[playerid][pStyle] = 4;
	            SetPlayerFightingStyle(playerid,FIGHT_STYLE_GRABKICK);
