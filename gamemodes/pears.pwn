						ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Лесопилка","{cccccc}Возьмите свободный погрузчик и загрузите бревно {ff9000}[ CAPS LOCK (Гудок) ]","Oк","");
