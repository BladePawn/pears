			{
				cache_get_value_name(i, "secondary_player_name", datad5, 24);
				cache_get_value_name(i, "secondary_player_ip", datad6, 24);
			}

			cache_get_value_name(i, "timestamp_fmt", datun, sizeof(datun));
			cache_get_value_name_int(i, "row", datro);
			cache_get_value_name(i, "rows_1251", datad4, 64);
			format(str,sizeof(str),"{cccccc}[ %s ] %s %s %s %s %s %d %s\n", datun, datad1, datad2, datad3, datad5, datad6, datro, datad4), strcat(sctring,str);
			kol ++;
	    }
	}
	else
	{
		for(new i = 0; i < rows; i++)
		{
			cache_get_value_name(i, "action", datad1, 24);

			new bool:is_null;
			cache_is_value_name_null(i, "primary_player_name", is_null);
			if(is_null == false) cache_get_value_name(i, "primary_player_name", datad2, 24);

			cache_is_value_name_null(i, "secondary_player_name", is_null);
			if(is_null == false) cache_get_value_name(i, "secondary_player_name", datad5, 24);

			cache_get_value_name(i, "timestamp_fmt", datun, sizeof(datun));
			cache_get_value_name_int(i, "row", datro);
			cache_get_value_name(i, "rows_1251", datad4, 64);
			format(str,sizeof(str),"{cccccc}[ %s ] %s %s %s %d %s\n", datun, datad1, datad2, datad5, datro, datad4), strcat(sctring,str);
			kol ++;
	    }
	}
	if(kol >= 1)
	{
		format(qwer,sizeof(qwer),"{0088ff}Лог %s",orgName[parama]);
		ShowDialog(playerid,706,DIALOG_STYLE_MSGBOX,qwer,sctring,"Ок","");
	}
	else if(kol == 0) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}По запросу ничего не найдено","Ок","");
	return 1;
}
function Call_LaborLog(playerid)
{
	new rows, str[214], sctring[4096], datad1[24], datad2[24], datad3, datun, datro, kol, qwer[60], tyear, tmonth, tday, thour, tminute, tsecond;
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		cache_get_value_name_int(i, "frakid", datad3);
		if(datad3 == 8) continue;

		cache_get_value_name(i, "action", datad1, 24);
		cache_get_value_name(i, "player", datad2, 24);
		cache_get_value_name_int(i, "unix", datun);
		cache_get_value_name_int(i, "row", datro);
		stamp2datetime(datun, tyear, tmonth, tday, thour, tminute, tsecond, 3);

		if(strlen(datad1) == 6) datad1 = "принят в";
		else datad1 = "уволен из";

		format(str,sizeof(str),"{cccccc}[ %02d.%02d.%d %02d:%02d ] %s %s %s {cccccc}Ранг: %d\n", tday, tmonth, tyear, thour, tminute, datad2, datad1, fraklastName[datad3], datro);
		strcat(sctring,str);
		kol ++;
	}
	if(kol >= 1)
	{
		format(qwer,sizeof(qwer),"{0088ff}Трудовая Книжка %s",datad2);
		ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,qwer,sctring,"Ок","");
	}
	else if(kol == 0) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}По запросу ничего не найдено","Ок","");
	return 1;
}
stock LaborLogs(playerid,giveplayerid)
{
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	stop_dialog(playerid);
	new string[184];
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}Поиск логов...","*","");
	if(giveplayerid != -1) mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `labor_log` WHERE `playerid` = '%d' ORDER BY `newid` DESC LIMIT 40", PlayerInfo[giveplayerid][pID]);
	else mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `labor_log` WHERE `playerid` = '%d' ORDER BY `newid` DESC LIMIT 40", PlayerInfo[playerid][pID]);
	mysql_tquery(pearsq, string, "Call_LaborLog", "d", playerid);
	return 1;
}
CMD:labor(playerid,const params[])
{
	if(sscanf(params, "i", params[0]))
	{
		LaborLogs(playerid, -1);
	}
	else
	{
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		if(IsARealNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Это NPC");
		if(!ProxDetectorS(5.0, playerid,params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко..");
		if(GetPVarInt(playerid,"antiflood") > 0) return ErrorMessage(playerid, "{FF6347}Вы используете команду слишком быстро [Антифлуд]");
		SetPVarInt(playerid,"antiflood",2);
		LaborLogs(params[0],playerid);
	}
	return 1;
}
stock logorg(playerid, g)
{
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	new string[400];
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}Поиск логов...","*","");
	mysql_format(pearsq_2, string, sizeof(string), "SELECT *, DATE_FORMAT(timestamp, \'%%d.%%c.%%Y %%H:%%i:%%s\', \'Europe/Moscow\') AS timestamp_fmt, \
		convertCharset(`rows`, \'utf-8\', \'windows-1251\') AS rows_1251 \
		FROM `org_logs` WHERE `org_id` = '%d' ORDER BY `timestamp` DESC LIMIT 40", g);
	mysql_tquery(pearsq_2, string, "Call_logs4", "dd", playerid, g);
	return 1;
}

// Удаляем снайперскую винтовку у тех, у кого её быть не должно
stock CheckAndRemoveSniperRifle(playerid) {
	if(!IsAvailableOrganizationWeapon(fraction(playerid), 34) && !DivisionIsAvailableWeapon(fraction(playerid), division(playerid) - 1, 34))
	{
		if(TempWeapon[playerid][6] == 34 && TempAmmo[playerid][6] >= 1) TempWeaponClear(playerid, 6);
		if(ProtectInfo[playerid][prWeapon][6] == 34 && ProtectInfo[playerid][prAmmo][6] >= 1) ProtectWeaponClear(playerid, 6);
	}
	return 1;
}

stock infolead(playerid)
{
	new str[100],sctring[700];
 	format(str,sizeof(str),"\n\n{0088ff}* Leader Информация"), strcat(sctring,str);
 	if(PlayerInfo[playerid][pGameTime] >= 3600)
 	{
 	    new thour = PlayerInfo[playerid][pGameTime]/3600;
		new vremh = thour*3600;
		new vremmin = PlayerInfo[playerid][pGameTime]-vremh;
		new tmin = vremmin/60;
		format(str,sizeof(str),"\n{cccccc}Мой {00cc00}Online {cccccc}сегодня: {ff9000}%d часов %d минут\n",thour,tmin), strcat(sctring,str);
	}
	else format(str,sizeof(str),"\n{cccccc}Мой {00cc00}Online {cccccc}сегодня: {ff9000}%d минут\n",PlayerInfo[playerid][pGameTime]/60), strcat(sctring,str);
	if(PlayerInfo[playerid][pGameAfk] >= 3600)
 	{
 		new thour = PlayerInfo[playerid][pGameAfk]/3600;
		new avremh = thour*3600;
		new avremmin = PlayerInfo[playerid][pGameAfk]-avremh;
		new tmin = avremmin/60;
		format(str,sizeof(str),"{cccccc}Мой {ffcc00}AFK {cccccc}сегодня: {ff9000}%d часов %d минут\n",thour,tmin), strcat(sctring,str);
	}
	else format(str,sizeof(str),"{cccccc}Мой {ffcc00}AFK {cccccc}сегодня: {ff9000}%d минут\n",PlayerInfo[playerid][pGameAfk]/60), strcat(sctring,str);

   	format(str,sizeof(str),"\n{cccccc}Мои Очки: {ff9000}%d Point",PlayerInfo[playerid][pAdmPoint]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{444444}- Очки начисляются за выполненную работу {ff0000}[ Временно Недоступно! ]"), strcat(sctring,str);
   	format(str,sizeof(str),"\n\n{cccccc}Мои Баллы: {ff9000}%d Score",PlayerInfo[playerid][pAdmScore]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{444444}- Баллы требуются для снятия наказания или начисления зарплаты"), strcat(sctring,str);
   	format(str,sizeof(str),"\n{444444}- Приобретаются с помощью выполнения нормы Online\n"), strcat(sctring,str);

   	//format(str,sizeof(str),"\n\n\n{ff9000}Текущий тариф 1-го Балла (Score) = %d Очков (Point)",ServerInfo[23]), strcat(sctring,str);
	if(ServerInfo[31] == 1) format(str,sizeof(str),"\n{ff9000}X2 Score Online {99ff66}[On]"), strcat(sctring,str);
	else if(ServerInfo[31] == 0) format(str,sizeof(str),"\n{ff9000}X2 Score Online {FF6347}[Off]"), strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}- Акция для лидеров, удваивающая баллы за Online %d+ Часа в день", ServerInfo[27]), strcat(sctring,str);
	ShowDialog(playerid,943,DIALOG_STYLE_MSGBOX,"{cccccc}Мой {ff0000}Leader Work",sctring,"*","");
	return 1;
}
