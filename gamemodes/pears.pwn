	// Вход в спортзал
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1738.2791,-1268.4790,13.5425) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
