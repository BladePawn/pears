CMD:findsate(playerid)
{
	if(Sate[playerid] == 0) return ErrorMessage(playerid, "{FF6347}У вас нет установленной спутниковой антенны");
	new Float:pos[3];
	GetDynamicObjectPos(SateObj[0][playerid], pos[0], pos[1], pos[2]);
	CreateGps(playerid, pos[0], pos[1], pos[2], GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), 10.0);
	SendClientMessage(playerid,COLOR_GREY," {0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Спутниковая Антенна {ffffff}отмечена на карте");
	return 1;
}
stock Update_Sate(p)
{
	new strFromFile2[134];
	new tmin = SateTime[p]/60;
	new tvsek = SateTime[p]-tmin*60;
	if(Sate[p] == 1) format(strFromFile2,sizeof(strFromFile2),"{0088ff}Спутниковая Антенна\n\n{cccccc}Соберёт данные через: {FF6347}%02d:%02d\n{cccccc}Принадлежит: {444444}%s", tmin, tvsek, PlayerInfo[p][pName]);
	else if(Sate[p] == 2) format(strFromFile2,sizeof(strFromFile2),"{0088ff}Спутниковая Антенна\n\n{99ff66}[ Скачать Данные - ALT ]\n{cccccc}Принадлежит: {444444}%s", PlayerInfo[p][pName]);
	UpdateDynamic3DTextLabelText(SateText[p],0xA9C4E4FF, strFromFile2);
}
stock IsASate(playerid)
{
	new Float:pos[3], noy;
    foreach(Player, i)
	{
		if(Sate[i] > 0)
		{
			GetDynamicObjectPos(SateObj[0][i], pos[0], pos[1], pos[2]);
			if(IsPlayerInRangeOfPoint(playerid,30.0, pos[0], pos[1], pos[2]))
			{
			    noy = 1;
			    break;
			}
		}
	}
	if(noy == 1)
	{
		ErrorMessage(playerid, "{FF6347}Вы слишком близко к другой спутниковой антенне [От 30 метров]");
		return 0;
	}
	return 1;
}
stock Pump_Sate(playerid)
{
	new current_tick = GetTickCount();
	new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
	if(interval > 300)
	{
		SetPVarInt(playerid,"oryjtemp",GetPVarInt(playerid,"oryjtemp")+1);
		if(!IsPlayerInRangeOfPoint(playerid,5.0,Job_X[playerid], Job_Y[playerid], Job_Z[playerid])) SetPVarInt(playerid,"oryjtemp", 0), SetPVarInt(playerid,"Arobsklad",0), ClearAnimations(playerid), TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton), PlayerPlaySound(playerid,4203,0,0,0);
		new string[58];
		format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~%d/10",GetPVarInt(playerid,"oryjtemp"));
	 	GameTextForPlayer(playerid,string, 1500, 3);
	 	ApplyAnimation(playerid,"BOMBER","BOM_Plant_Loop",4.0, false, true, true, true, true);
	 	if(GetPVarInt(playerid,"oryjtemp") >= 10)
		{
			if(IsASate(playerid))
		    {
				TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
				Dei[playerid] = 0, SetPVarInt(playerid,"oryjtemp", 0), SetPVarInt(playerid,"Arobsklad",0);
			 	PlayerPlaySound(playerid,6401,0,0,0);
				new Float:X,Float:Y,Float:Z,Float:A;
				GetPlayerPos(playerid, X,Y,Z), GetPlayerFacingAngle(playerid,A);
				X=X+2.0*floatsin(-A,degrees);
				Y=Y+2.0*floatcos(-A,degrees);
				Z += 0.6;
				Sate[playerid] = 1;
				SateTime[playerid] = 600+300-60*get_ability(playerid, 1);
				SateObj[0][playerid] = CreateDynamicObject(3031, X, Y, Z, 0.0, 0.0, -63.299980, GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid), -1, 300.00, 300.00);
				SateObj[1][playerid] = CreateDynamicObject(2268, X-0.088, Y+0.858, Z-0.29, 0.0, 0.0, -153.499877, GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid), -1, 300.00, 300.00);
				SetDynamicObjectMaterial(SateObj[1][playerid], 0, 3440, "airportpillar", "metalic_64", 0x00000000);
				SetDynamicObjectMaterial(SateObj[1][playerid], 1, 9818, "ship_brijsfw", "ship_greenscreen1", 0x00000000);
				SateObj[2][playerid] = CreateDynamicObject(2268, X+0.331, Y-0.0546, Z-0.29, 0.0, 0.0, 26.500091, GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid), -1, 300.00, 300.00);
				SetDynamicObjectMaterial(SateObj[2][playerid], 0, 3440, "airportpillar", "metalic_64", 0x00000000);
				SetDynamicObjectMaterial(SateObj[2][playerid], 1, 3440, "airportpillar", "metalic_64", 0x00000000);
				SateObj[3][playerid] = CreateDynamicObject(3789, X+1.820315, Y-0.114258, Z-1.220276, 0.0, 0.0, -101.599937, GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid), -1, 300.00, 300.00);
				SetDynamicObjectMaterial(SateObj[3][playerid], 3, 3132, "jt_doorx", "Shamalbody256", 0x00000000);
				SateText[playerid] = CreateDynamic3DTextLabel(" ",0xA9C4E4FF,X, Y, Z, 5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid));
				Update_Sate(playerid);
			 	ClearAnim(playerid);
			 	ShowDialog(playerid, 1700, 0, "{0088ff}NASA", "{cccccc}Отлично! {99ff66}Спутниковая антенна установлена{cccccc}, я могу вернуться сюда позже и скачать данные", "Ок", "");
				Streamer_Update(playerid);
			}
		}
	 	Aftextdraw[playerid] = current_tick;
 	}
 	return 1;
}
CMD:createsate(playerid)
{
	if(Dei[playerid] == 5 && (GetPlayerInterior(playerid) == 221 && GetPlayerVirtualWorld(playerid) == 221 || GetPlayerInterior(playerid) == 222 && GetPlayerVirtualWorld(playerid) == 222))
	{
		if(Sate[playerid] != 0) return ErrorMessage(playerid, "{FF6347}У вас уже установлена спутниковая антенна [ Отмечена GPS Маркером ]"), pc_cmd_findsate(playerid);
	    if(IsASate(playerid))
	    {
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 7.7106,2977.5029,957.2675)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом со входом в жилой модуль");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, -6.6735,3008.8049,958.8598)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом с солнечными панелями");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 56.3499,2952.5276,957.2399)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом с ракетой");
	    	if(IsPlayerInRangeOfPoint(playerid,40.0, 93.3067,3002.0579,951.0793)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну в кратере или рядом с ним");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 43.9439,3023.0579,957.2476)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом со складом");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 1369.6177,2480.5525,1457.2476)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом со входом в жилой модуль");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 1395.1567,2439.5208,1457.2476)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом с солнечными панелями");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 1443.9200,2508.6714,1459.8472)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом с ракетой");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 1367.7318,2512.3018,1457.2476)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом со складом");
	    	if(IsPlayerInRangeOfPoint(playerid,30.0, 1351.0690,2494.9583,1457.2476)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом с гаражом");
	    	if(IsPlayerInRangeOfPoint(playerid,50.0, 1314.3214,2469.3027,1457.2476)) return ErrorMessage(playerid, "{FF6347}Нельзя устанавливать антенну рядом с теплицей");
	    	if(GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Нельзя установить антенну в движении");
	    	PPP15[playerid] = 0;
	    	Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0);
	    	ApplyAnimation(playerid,"BOMBER","BOM_Plant_Loop",4.0, false, true, true, true, true);
	    	GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
	    	SetPVarInt(playerid,"oryjtemp", 0), SetPVarInt(playerid,"Arobsklad",10);
	    	PlayerPlaySound(playerid, 1139, 0,0,0);
			if(Device[playerid] == 0)
			{
			    ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Соберите антенну используя ПКМ (Правую кнопку мыши)","*","");
				PlayerTextDrawSetString(playerid, HintButton, "RMB");
			}
			else if(Device[playerid] == 1)
			{
			    ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Соберите антенну используя Кнопку H","*","");
				PlayerTextDrawSetString(playerid, HintButton, "H");
			}
			PlayerTextDrawShow(playerid, HintButton);
			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~0/10", 5000, 3);
			RemovePlayerAttachedObject(playerid,4);
			SetPlayerAttachedObject(playerid, 4, 1010, 1, 0.075000, -0.109999, 0.000000, 90.0, 0.000000, 179.700088, 0.817000, 1.000000, 0.901000, 0, 0);
		}
	}
	return 1;
}
CMD:sate(playerid)
{
	if((IsPlayerInRangeOfPoint(playerid,2.0, 11.3113,2972.0737,957.2476) || IsPlayerInRangeOfPoint(playerid,2.0, 1369.8541,2473.1172,1457.2476) || PlayerInfo[playerid][pSoska] >= 22) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(PlayerInfo[playerid][pBkyrenie] <= 1 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не участник миссии NASA");
	 	if(Hold[playerid] > 0 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки");
	 	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может работать");
	 	if(Sate[playerid] != 0) return ErrorMessage(playerid, "{FF6347}У вас уже установлена спутниковая антенна [ Отмечена GPS Маркером ]"), pc_cmd_findsate(playerid);
	 	if(GetPVarInt(playerid,"LoadBack") >= 1)
	 	{
	 		ErrorMessage(playerid, "{FF6347}У вас на спине боксы с ценным материалом [ Их нужно отнеси на склад ]");
	 		if(GetPVarInt(playerid,"GP") != 1)
		 	{
		 		if(PlayerInfo[playerid][pBkyrenie] == 2) // Луна
    			{
				 	switch(random(3))
			        {
						case 0: CreateGps(playerid, 32.1685,3022.9170,957.2476, 221, 221, 5.0);
	                    case 1: CreateGps(playerid, 39.0405,3032.6768,957.2476, 221, 221, 5.0);
	                    case 2: CreateGps(playerid, 47.5085,3032.6807,957.2476, 221, 221, 5.0);
					}
				}
				else if(PlayerInfo[playerid][pBkyrenie] == 4) // Марс
    			{
				 	switch(random(3))
			        {
						case 0: CreateGps(playerid, 1363.2443,2516.7244,1457.2476, 222, 222, 5.0);
	                    case 1: CreateGps(playerid, 1372.7974,2510.1619,1457.2399, 222, 222, 5.0);
	                    case 2: CreateGps(playerid, 1372.9862,2501.7542,1457.2399, 222, 222, 5.0);
					}
				}
			}
			return 1;
		}
	 	if(Dei[playerid] == 0)
		{
	 		new tmphour,tmpminute,tmpsecond;
			gettime(tmphour, tmpminute, tmpsecond);
			if((tmphour == 2 && tmpminute >= 40) && PlayerInfo[playerid][pSoska] <= 22) return ErrorMessage(playerid, "{FF6347}Скоро ночная перезагрузка сервера [В 3:00]");
	 		PlayerPlaySound(playerid,5600,0,0,0);
	 		Dei[playerid] = 5;
			ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
			SetPlayerAttachedObject(playerid, 1, 3791, 1, -0.022999, -0.163000, -0.003999, -94.699958, 177.400070, 2.799999, 0.251000, 0.265999, 0.283999, 0, 0);
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мне нужно отойти и установить антенну в любом месте {ff9000}[ Кнопка: ALT ]");
			TextDrawShowForPlayer(playerid, MindDraw[3]), PlayerTextDrawSetString(playerid, HintButton, "ALT"), PlayerTextDrawShow(playerid, HintButton);
			RemovePlayerAttachedObject(playerid,4), SetPlayerAttachedObject(playerid, 4, 1010, 1, 0.075000, -0.318, 0.002000, 90.0, 0.000000, 179.700088, 0.817000, 1.000000, 0.901000, 0, 0);
		}
		else if(Dei[playerid] == 5) ShowDialog(playerid,1124,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","{FF6347}Вы уверены, что хотите поставить спутниковую антенну на место?\n{cccccc}Если вы хотите её установить, отойдите от базы по дальше и нажмите {ff9000}ALT","Да","Нет");
		else ErrorMessage(playerid, "{FF6347}У вас заняты руки");
	}
	return 1;
}
stock sateget(playerid)
{
    new Float:pos[3];
	GetDynamicObjectPos(SateObj[0][playerid], pos[0], pos[1], pos[2]);
	if(IsPlayerInRangeOfPoint(playerid,3.0, pos[0], pos[1], pos[2]))
	{
    	if(GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Вы не можете скачать данные в движении");
 		if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может работать");
		PlayerPlaySound(playerid, 6401, 0,0,0);
		DestroyDynamic3DTextLabel(SateText[playerid]);
		ApplyAnimation(playerid,"BOMBER","BOM_Plant",3.0, false, true, true, false, false);
		DestroyDynamicObject(SateObj[0][playerid]), DestroyDynamicObject(SateObj[1][playerid]), DestroyDynamicObject(SateObj[2][playerid]), DestroyDynamicObject(SateObj[3][playerid]);
		Sate[playerid] = 0, SateTime[playerid] = 0;
		PlayerInfo[playerid][pHataCena] += 40;
		update_ability(playerid, 1, 20);
		new string[64];
		format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+40~n~~w~NASA JOB: ~r~%d",PlayerInfo[playerid][pHataCena]);
		GameTextForPlayer(playerid,string,5000,3);
		mysql_save(playerid, 52);
		if(PlayerInfo[playerid][pBkyrenie] == 2) // Луна
    	{
			switch(random(10))
	        {
				case 0: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: На луне ваш вес легче в 6 раз. Масса луны намного меньше земли и \nпотому её гравитация слабее. Здесь вы прыгаете выше!\n","Ок","");
				case 1: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: на луне нет атмосферы, поэтому вам необходимо находиться в скафандре.\n","Ок","");
				case 2: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: Лунная пыль пахнет порохом. Об этом рассказали астронавты побывавшие на луне!\n","Ок","");
				case 3: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: День и ночь на луне сменяются мгновенно, в отличие от земли.\n","Ок","");
				case 4: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: На Луне запрещены какие-либо военные действия и операции,\nтак как она признана международной территорией\n","Ок","");
				case 5: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: По некоторым исследованиям, на Луне всё-таки существует вода, только, в форме льда\n","Ок","");
				case 6: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: Многочисленные кратеры на Луне возникают из-за падения метеоритов, т.к. Луна не защищена атмосферой.\n","Ок","");
				case 7: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: Из-за низкой силы притяжения любой землянин сможет поднять собственный вес без затруднений\n","Ок","");
				case 8: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: Поверхность Луны абсолютно чёрная, но из-за сильного солнечного света она кажется серой.\n","Ок","");
				case 9: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{0088ff}NASA","\n{cccccc}Интересный факт: Ночью температура на спутнике Земли может опускаться до -154 градусов, а днём подниматься до 108 градусов.\n","Ок","");
			}
		}
		else if(PlayerInfo[playerid][pBkyrenie] == 4) // Марс
    	{
			switch(random(6))
	        {
				case 0: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}NASA","\n{cccccc}Интересный факт: Марсианский год равен 24 месяцам, то есть двум земным. (687 наших земных суток)\n","Ок","");
				case 1: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}NASA","\n{cccccc}Интересный факт: Температура на экваторе Марса колеблется от +30 в полдень и до - 80 в полночь.\n","Ок","");
				case 2: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}NASA","\n{cccccc}Интересный факт: В связи с отсутствием на Марсе озонового слоя, при восходе солнца поверхность планеты получает смертельные дозы радиации.\n","Ок","");
				case 3: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}NASA","\n{cccccc}Интересный факт: Кора Марса — цельная, в отличие от земной коры, состоящей из отдельных тектонических плит.\n","Ок","");
				case 4: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}NASA","\n{cccccc}Интересный факт: Самый большой в Солнечной системе вулкан диаметром в 600 километров расположен именно на Марсе.\n","Ок","");
				case 5: ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}NASA","\n{cccccc}Интересный факт: Низкое давление не может способствовать образованию воды на Марсе. Даже если предположить, что вода на\nКрасной планете есть, то она не сможет свободно растекаться по его поверхности.\n","Ок","");
			}
		}

		// Собирать данные со спутниковой тарелки
		CompletingDaily(playerid, 10, 1);
	}
	return 1;
}

CMD:getmount(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,1.5,-332.9957,1724.6462,42.7938))
	{
		new str[70],sctring[210];
		format(str,sizeof(str),"{ff9000}Лопата \t{99ff66}[%d$]\n", friskPrice[44]), strcat(sctring,str);
		format(str,sizeof(str),"{ff9000}Монтировка \t{99ff66}[%d$]\n", friskPrice[90]), strcat(sctring,str);
		format(str,sizeof(str),"{ff9000}Верёвка \t{99ff66}[%d$]\n", friskPrice[13]), strcat(sctring,str);
		ShowDialog(playerid,1151,DIALOG_STYLE_TABLIST,"{ff9000}Археология",sctring,"Выбор","Отмена");
	}
	return 1;
}
CMD:plot(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,1.5,1574.2813,1408.1744,1826.1022) || IsPlayerInRangeOfPoint(playerid,1.5,1590.3674,1395.6295,1826.3740))
	{
		if(get_invent4(playerid, 13, 0) == 0) return ErrorMessage(playerid, "{FF6347}У вас нет верёвки [ Её можно приобрести в любом супермаркете Y >> GPS >> Услуги ]");
		if(plot_player >= 0) return ErrorMessage(playerid, "{FF6347}Плот сейчас занят, дождитесь когда он будет свободен [ Не больше 30-ти секунд ]");
		if(IsPlayerInRangeOfPoint(playerid,1.5,1574.2813,1408.1744,1826.1022))
		{
		    if(plot_stat != 4 && plot_stat != 0) return ErrorMessage(playerid, "{FF6347}Подождите, плот ещё не добрался до берега [ Не дольше 30-ти секунд ]");
			plothome(0);
		}
		else if(IsPlayerInRangeOfPoint(playerid,1.5,1590.3674,1395.6295,1826.3740))
		{
		    if(plot_stat != 4 && plot_stat != 0) return ErrorMessage(playerid, "{FF6347}Подождите, плот ещё не добрался до берега [ Не дольше 30-ти секунд ]");
			plothome(1);
		}
		new unix = gettime();
		if(UsePlot[playerid] > unix) return ErrorMessage(playerid, "{FF6347}Вы недавно использовали плот [ Подождите 10 секунд ]");
		UsePlot[playerid] = unix+10;
		plot_player = playerid;
		plot_time = 0;
		ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		PlayerPlaySound(playerid,5600,0,0,0);
		SetPlayerChatBubble(playerid,"привязывает верёвку",COLOR_PURPLE,20.0,3000);

		new string[80];
		format(string,sizeof(string),"{ffcc66}Встаньте на плот и тяните верёвку {ff9000}[ %s ]", buttonName[Device[playerid]]);
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*",string,"*","");
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно встать на плот и тянуть верёвку [ %s ]", buttonName[Device[playerid]]);
	}
	return 1;
}
stock Load_Riches(playerid, inva)
{
	new idrich;
	if(inva == 999) idrich = get_para(playerid, 91);
	else idrich = PlayerInfo[playerid][pInvenPara][inva];
	CreateGps(playerid, RichPos[idrich][0], RichPos[idrich][1], RichPos[idrich][2], 0, 0, 2.0);
	SuccessMessage(playerid, "{ff9000}Местонахождение сокровищ {99ff66}отмечено на карте\n\n{cccccc}Отправляйтесь туда, возьмите в руки лопату и начните копать");
	Riches[playerid] = idrich+1;
	return 1;
}
CMD:riches(playerid, const params[])
{
	if(get_invent4(playerid, 91, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет карты сокровищ");
	if(Riches[playerid] > 0)
	{
    	SetPlayerChatBubble(playerid,"сворачивает и убирает карту сокровищ",COLOR_PURPLE,30.0,8000);
  		PlayerPlaySound(playerid,5600,0,0,0), DestroyGps(playerid), Riches[playerid] = 0;
	}
	else
	{
		if(get_invent4(playerid, 44, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет лопаты\nКупите её в вагончике археологических раскопок");
		new unix = gettime();
		if(PlayerInfo[playerid][pMaze3] > unix) return ErrorMessage(playerid, "{FF6347}Вы уже нашли сокровища [ Найти сокровища можно 1 раз в сутки ]");
		if(Dei[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки или он что-то делает");
		if(HealthAC[playerid] <= 0 || howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
  		SetPlayerChatBubble(playerid,"достаёт и разворачивает карту сокровищ",COLOR_PURPLE,30.0,8000);
  		PlayerPlaySound(playerid,5601,0,0,0);
  		SetPVarInt(playerid,"oryjtemp", 0);
  		if(!sscanf(params, "i", params[0])) Load_Riches(playerid, params[0]);
  		else Load_Riches(playerid, 999);
    }
	return 1;
}
CMD:getrich(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,1.5,1600.2229,1386.2910,1825.7896))
	{
		new unix = gettime();
		if(PlayerInfo[playerid][pMaze3] > unix) return ErrorMessage(playerid, "{FF6347}Вы уже нашли сокровища [ Найти сокровища можно 1 раз в сутки ]");
		if(get_invent(playerid, 91, 0) >= 1) return ErrorMessage(playerid, "{FF6347}У вас уже есть карта сокровищ. Зачем вам ещё?");
		
        new put_inva = GiveThingPlayer(playerid, 91, 1, random(100), 0, 0, 0, 9999);
    	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре");

		if(PlayerInfo[playerid][pQuest][5] == 3) PlayerInfo[playerid][pQuest][5] = 4, sayBruceRich(playerid);
		ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		PlayerPlaySound(playerid,5600,0,0,0);
		SuccessMessage(playerid, "{99ff66}Вы взяли карту сокровищ {ff9000}[ Взять в руки: N или /riches ]");
		SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Теперь у меня есть карта с сокровищами [ Открыть карту: N или /riches ]");
	}
	return 1;
}
stock sarcophagus(playerid)
{
	new unix = gettime();
	if(PlayerInfo[playerid][pMaze] > unix) return ErrorMessage(playerid, "{FF6347}Вы уже находили сокровища фараонов\n{cccccc}Открыть саркофаг можно 1 раз в 8 часов\n\n{ffcc66}Поднять предметы можно через инвентарь: N >> Рядом");
	new sarcoid;
	if(IsPlayerInRangeOfPoint(playerid,2.0,1430.7230,1554.1328,10.8463)) sarcoid = 0;
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1394.3341,1554.0918,10.8503)) sarcoid = 1;
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1430.7229,1587.9454,10.8463)) sarcoid = 2;
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1394.3439,1587.9523,10.8503)) sarcoid = 3;
 	else if(IsPlayerInRangeOfPoint(playerid,2.0,1362.8505,1585.5258,10.8503)) sarcoid = 4;
	if(stat_labirint != sarcoid) return ErrorMessage(playerid, "{FF6347}Этот саркофаг сейчас закрыт [ Как вы вообще сюда проникли? Перестаньте использовать читы! ]");
	around_audio(6601, 0, 20.0, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
	
	Throw(playerid, 92, 1, 0, 0, 0, 0);
	Throw(playerid, 92, 1, 0, 0, 0, 0);
	Throw(playerid, 93, 1, 0, 0, 0, 0);
	Throw(playerid, 19591, 1, 1, 0, 2, 0);
	Throw(playerid, 19590, 1, 1, 0, 2, 0);
	ApplyAnimation(playerid,"SWORD","sword_4",2.0, false, false, false, false, false, SYNC_ALL);
	PlayerInfo[playerid][pMaze] = unix+28800;
	mysql_save(playerid, 61);
	if(OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/arheolog01.mp3");
	SuccessMessage(playerid, "{99ff66}Вы открыли саркофаг с сокровищами!\n{ff9000}Соберите все предметы [ N >> Рядом ]");
	SendClientMessage(playerid, COLOR_GREY,"Вы открыли саркофаг с сокровищами!\n{ff9000}Соберите все предметы [ N >> Рядом ]");
	if(PlayerInfo[playerid][pAchieve][73] == 0) AchievePlayer(playerid, 73, 1);

	// Пройти лабиринт
	CompletingDaily(playerid, 12, 1);
	return 1;
}

// Расчитываем шанс появления вампира
stock ChanceVampire(playerid, unix)
{
	switch(random(4)) // Вероятность стать вампиром
	{
		case 0: // 1 шанс - ДА
		{
			if(ServerInfo[62] > unix) return 0; // Если не прошло 4 часа с момент последнего заболевания - НЕТ

			if(PlayerInfo[playerid][pQuest][5] == 4 
				|| PlayerInfo[playerid][pQuest][5] == 5) return 0; // Во время квеста НЕТ

			if(getillness(playerid, 18) >= 0) return 0; // Если игрок уже вампир - НЕТ

			if(get_odet(playerid, 11712)) return 0; // Если на игроке висит аксессуар с крестом - НЕТ

			return 1; // ДА
		}
	}
	return 0;
}

stock sarcophagus2(playerid)
{
	new unix = gettime();
	if(PlayerInfo[playerid][pMaze2] > unix) return ErrorMessage(playerid, "{FF6347}Вы уже открывали саркофаг\n{cccccc}Открыть саркофаг в гробнице можно 1 раз в 8 часов");
	around_audio(6601, 0, 20.0, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
	
	// Получаем шанс появления вампира
	new chtotam = ChanceVampire(playerid, unix);

	new sarc;
	if(IsPlayerInRangeOfPoint(playerid,5.0,1394.3571,1610.4054,1816.0216)) sarc = 0;
	else if(IsPlayerInRangeOfPoint(playerid,5.0,1394.3569,1596.1399,1816.0216)) sarc = 1;
 	else if(IsPlayerInRangeOfPoint(playerid,5.0,1466.7737,1610.2744,1816.0216)) sarc = 2;
	else if(IsPlayerInRangeOfPoint(playerid,5.0,1466.7738,1595.9792,1816.0216)) sarc = 3;
	if(sarc_time[sarc] > unix)
	{
		new string[90];
		format(string, sizeof(string), "{FF6347}Этот саркофаг недавно открывали\n{cccccc}Доступно через %d сек.",sarc_time[sarc]-unix);
		ErrorMessage(playerid,string);
		return 1;
	}
	if(chtotam == 0)
	{
	    new items[5], thingType[5], thingPara[5];
	    for(new i = 0; i < 5; i++)
		{
		    switch(random(7))
			{
	  			case 0: items[i] = 19591, thingType[i] = 2, thingPara[i] = 1;
	  			case 1..4: items[i] = 92, thingType[i] = 0, thingPara[i] = 0;
	  			case 5: items[i] = 19590, thingType[i] = 2, thingPara[i] = 1;
	  			case 6: items[i] = 11712, thingType[i] = 2, thingPara[i] = 1;
			}
			Throw(playerid, items[i], 1, thingPara[i], 0, thingType[i], 0);
		}
		ApplyAnimation(playerid,"SWORD","sword_4",2.0, false, false, false, false, false, SYNC_ALL);
		PlayerInfo[playerid][pMaze2] = unix+28800;
		mysql_save(playerid, 62);
		if(OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/arheolog01.mp3");
		SuccessMessage(playerid, "{99ff66}Вы открыли саркофаг с сокровищами!\n{ff9000}Соберите все предметы [ N >> Рядом ]");
		SendClientMessage(playerid, COLOR_GREY,"Вы открыли саркофаг с сокровищами!\n{ff9000}Соберите все предметы [ N >> Рядом ]");
	}
	else if(chtotam == 1) // Вампиризм (Проклятье гробницы)
	{
		ServerInfo[62] = unix+14400; // Повторная возможность стать вампиром через 4 часа
		SaveServer(62);
		ApplyAnimation(playerid,"SWORD","sword_4",2.0, false, false, false, false, false, SYNC_ALL);
		PlayerInfo[playerid][pMaze2] = unix+28800;
		mysql_save(playerid, 62);
		around_audio(14401, 0, 20.0, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
		if(object_stat[playerid] == 0)
		{
			if(sarc == 0) player_object[playerid] = CreateDynamicObject(18715, 1394.3571,1610.4054,1816.0216, 0.0, 0.0, 0.0, 227, 227, -1, 200.00, 200.00), MoveDynamicObject(player_object[playerid], 1394.3571,1610.4054,1816.3216, 1.0), object_stat[playerid] = 1;
			else if(sarc == 1) player_object[playerid] = CreateDynamicObject(18715, 1394.3569,1596.1399,1816.0216, 0.0, 0.0, 0.0, 227, 227, -1, 200.00, 200.00), MoveDynamicObject(player_object[playerid], 1394.3569,1596.1399,1816.3216, 1.0), object_stat[playerid] = 1;
	 		else if(sarc == 2) player_object[playerid] = CreateDynamicObject(18715, 1466.7737,1610.2744,1816.0216, 0.0, 0.0, 0.0, 227, 227, -1, 200.00, 200.00), MoveDynamicObject(player_object[playerid], 1466.7737,1610.2744,1816.3216, 1.0), object_stat[playerid] = 1;
			else if(sarc == 3) player_object[playerid] = CreateDynamicObject(18715, 1466.7737,1610.2744,1816.0216, 0.0, 0.0, 0.0, 227, 227, -1, 200.00, 200.00), MoveDynamicObject(player_object[playerid], 1466.7737,1610.2744,1816.3216, 1.0), object_stat[playerid] = 1;
			SetTimerEx("delplayerobject", 6000, false, "d", playerid);
		}

		new line[80],lines[320];
		format(line,sizeof(line),"{ffcc66}Этот саркофаг оказался пуст!"), strcat(lines,line);
		format(line,sizeof(line),"\n{cccccc}Вы открыли саркофаг и из него вышел какой-то дым"), strcat(lines,line);
		format(line,sizeof(line),"\n\n{ff9000}Теперь вы прокляты!"), strcat(lines,line);
		format(line,sizeof(line),"\n{ffcc66}Найдите на стенах гробницы больше информации о проклятии"), strcat(lines,line);
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*",lines,"*","");

		if(!getinfect(playerid, 18)) infect(playerid, 18, 500);
		ApplyAnimation(playerid,"PED","handscower",2.0, false, true, true, false, false, SYNC_ALL);

		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно прочесть иероглифы на стенах, чтобы узнать что со мной будет");
	}
	sarc_time[sarc] = unix+300;

	// Открыть саркофаг в гробнице
	CompletingDaily(playerid, 14, 1);
	return 1;
}
function delplayerobject(playerid)
{
	if(IsOnline(playerid))
	{
		if(object_stat[playerid] == 1) DestroyDynamicObject(player_object[playerid]), object_stat[playerid] = 0;
	}
	return 1;
}
CMD:mount(playerid)
{
	if(get_invent4(playerid, 90, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет монтировки");
    if(Hold[playerid] == 9)
    {
   		RemovePlayerAttachedObject(playerid,1), Hold[playerid] = 0;
    	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
  		SetPlayerChatBubble(playerid,"убирает монтировку",COLOR_PURPLE,30.0,8000);
	}
	else
	{
		if(Hold[playerid] > 0 || Dei[playerid] > 0) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки");
  		RemovePlayerAttachedObject(playerid,1);
  		Hold[playerid] = 9;
  		SetPlayerAttachedObject(playerid, 1, 18634, 6, 0.098999, 0.039999, 0.000000, 85.700012, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
  		SetPlayerChatBubble(playerid,"достаёт монтировку",COLOR_PURPLE,30.0,8000);
    }
	return 1;
}
CMD:ydo(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(get_invent4(playerid, 31, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет удочки..");
    if(Hold[playerid] == 7)
    {
   		RemovePlayerAttachedObject(playerid,1);
    	if(NoAnim[playerid] == 0) ApplyAnimation(playerid,"PED","phone_out",4.0, false, true, true, false, false);
  		SetPlayerChatBubble(playerid,"убирает удочку",COLOR_PURPLE,30.0,8000);
  		Hold[playerid] = 0; Dei[playerid] = 0; Hand[playerid] = 0;
	}
	else
	{
		if(Hold[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня заняты руки");
  		RemovePlayerAttachedObject(playerid,1);
    	SetPlayerAttachedObject(playerid, 1, 18632, 6, 0.090000, 0.011111, 0.030000, 3.000000, 190.000000, 65.000000);
  		SetPlayerChatBubble(playerid,"достаёт удочку",COLOR_PURPLE,30.0,8000);
  		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу ловить рыбу {ff9000}[ %s ]", buttonName[Device[playerid]]);
  		Hold[playerid] = 7;
    }
	return 1;
}
CMD:access(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(45, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(!GetAccessRankOrg(playerid, g, 45, NO_FBI)) return 1;

	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разрешить младшему по званию использовать любую технику на базе [ /access ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(PlayerInfo[playerid][pMember] == PlayerInfo[params[0]][pMember] || PlayerInfo[playerid][pLeader] == PlayerInfo[params[0]][pMember])
	{
		if(PlayerInfo[params[0]][pRank] >= PlayerInfo[playerid][pRank] && playerid != params[0]) return ErrorMessage(playerid, "{FF6347}Его ранг выше или равняется вашему");
		if(Tank[params[0]] == 3) return ErrorMessage(playerid, "{FF6347}Он уже имеет разрешение на использование любого транспорта");
		Tank[params[0]] = 3;
		new string[144];
		format(string, sizeof(string), "Разрешение на использование любого транспорта выдано для %s",PlayerInfo[params[0]][pName]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		format(string, sizeof(string), "[ Мысли ]: %s выдал мне разрешение на использование любого транспорта",PlayerInfo[playerid][pName]);
		SendClientMessage(params[0], COLOR_GREY, string);
		PlayerPlaySound(params[0],6400,0,0,0);
		format(string, sizeof(string), "* %s передаёт разрешение для %s на использование любого транспорта", PlayerInfo[playerid][pName], PlayerInfo[params[0]][pName]);
		ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	else ErrorMessage(playerid, "{FF6347}Этот игрок не ваш подчинённый");
 	return 1;
}
CMD:deprive(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(56, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 56, NO_FBI)) return 1;

	new tmp[144],para1,money,string[144];
	if(sscanf(params, "s[144]i",tmp,money)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изъять налоговую задолженность [ /deprive ID Сумма ]");
	para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
	{
		if(playerid == para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изъять свою задолженность");
		if(money < 1 || money > 100000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1$ и не больше 100.000.000$");
		if(money > PlayerInfo[para1][pTaxes][1]) return format(string,sizeof(string),"[ Мысли ]: Долг подоходного налога %s составляет всего: {FF6347}%d$",PlayerInfo[para1][pName], PlayerInfo[para1][pTaxes][1]),SendClientMessage(playerid, COLOR_GREY, string), PlayerPlaySound(playerid,4203,0,0,0);
		if(PlayerInfo[para1][pMoney]+PlayerInfo[para1][pAccount] < money) return format(string,sizeof(string),"[ Мысли ]: %s недостаточно средств [На счетах: %d$]",PlayerInfo[para1][pName], PlayerInfo[para1][pMoney]+PlayerInfo[para1][pAccount]),SendClientMessage(playerid, COLOR_GREY, string), PlayerPlaySound(playerid,4203,0,0,0);
		if(money > PlayerInfo[para1][pAccount])
		{
			money = money-PlayerInfo[para1][pAccount];
			PlayerInfo[para1][pAccount] = 0;
			PlayerInfo[para1][pMoney] -= money;
		}
		else PlayerInfo[para1][pAccount] -= money;
		PlayerInfo[para1][pTaxes][1] -= money;
		mysql_save(para1, 0), mysql_save(para1, 44);
		PutMoneyToTreasury(money, "Изъята задолженность");
		PlayerPlaySound(playerid,6401,0,0,0);
		format(string, sizeof(string), "Вы изъяли задолженность %s в количестве: {99ff66}%d$",PlayerInfo[para1][pName], money);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		format(string, sizeof(string), "[ Мысли ]: %s изъял мою налоговую задолженность в размере: {FF6347}%d$",PlayerInfo[playerid][pName],money);
		SendClientMessage(para1, COLOR_GREY, string);
		format(string, sizeof(string),"\n{cccccc}[%s] %s {FF6347}изъял вашу налоговую задолженность в размере {ff0000}%d$\n{cccccc}Деньги поступили в государственную казну\n",getNameRank(playerid),PlayerInfo[playerid][pName],money);
		ShowDialog(para1,1012,DIALOG_STYLE_MSGBOX, "{99ff66}Банк", string, "Ок", "");
		PlayerPlaySound(para1,31201,0,0,0);
		MoneyLog("deprive", PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "Government", "", -money, "Изъята налоговая задолженность");
		OrgLog(7, "deprive", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], money, "Изъял Задолженность");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,8,money);
		return 1;
	}
 	return 1;
}

stock get_namazlyk(playerid)
{
	if(PlayerInfo[playerid][pMember] != 18) return ErrorMessage(playerid, "{FF6347}Только для участников Arabian Mafia");
    if(Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
    if(aFloodThing[playerid] > gettime()) return ErrorMessage(playerid, "{FF6347}Вы недавно брали предмет [ Пожалуйста повторите позже ]");

    new inva = GiveThingPlayer(playerid, 193, 1, 0, 0, 0, 0, -1);
    if(inva == -1) return ErrorMessage(playerid, "{FF6347}У вас в инвентаре нет места");

    aFloodThing[playerid] = gettime() + 180;
    PlayerPlaySound(playerid,5600,0,0,0);
    SetPlayerChatBubble(playerid,"берёт намазлык",COLOR_PURPLE,20.0,5000);
    ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);

    SuccessMessage(playerid, "{99ff66}Вы взяли коврик для намаза {ff9000}[ N - Инвентарь или /namaz ]");
    return 1;
}

CMD:namaz(playerid, const params[])
{
	if(PlayerInfo[playerid][pMember] != 18) return ErrorMessage(playerid, "{FF6347}Только для участников Arabian Mafia");
    if(sscanf(params, "i", params[0]))
	{
		if(get_invent4(playerid, 193, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет намазлыка");
		if(OnlineInfo[playerid][oShowInterface] > 0) return ErrorMessage(playerid, "{FF6347}У вас открыто меню [ Требуется закрыть открытое меню ]");
	}
	else 
	{
		if(PlayerInfo[playerid][pInven][params[0]] != 193) return ErrorMessage(playerid, "{FF6347}Ошибка! В этом слоте инвентаря нет намазлыка");
	}
	if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
    if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return ErrorMessage(playerid, "{FF6347}Ваш персонаж должен быть пешечком");
    if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
    if(Namaz[playerid] >= 0) return ErrorMessage(playerid, "{FF6347}Дождитесь завершение намаза");
	if(PlayerInfo[playerid][pNamazCD] > gettime()) return ErrorMessage(playerid, "{FF6347}Вы совершали намаз меньше часа назад\n{cccccc}Ограничение на выполнение молитвы один раз в час");
	if(Iamzz[playerid]) return ErrorMessage(playerid, "{FF6347}Вы не можете выполнять намаз в зелёной зоне\n{cccccc}Пожалуйста, выполняйте молитву в уединённых местах");

	// Записываем позицию игрока
	savePositionPlayerForMenu(playerid);

	new Float:f_pos[4];
    frontme(playerid, 0.7, f_pos[0], f_pos[1], f_pos[2], f_pos[3]); // Смещаем координату перед игроком

	// Смещаем координату влево от направления игрока
	new Float:temp_a = f_pos[3] + 90;
	f_pos[0] = f_pos[0] + 0.5 * floatsin(-temp_a,degrees);
	f_pos[1] = f_pos[1] + 0.5 * floatcos(-temp_a,degrees);


	Namaz[playerid] = CreateDynamicObject(2833,f_pos[0], f_pos[1], f_pos[2]-0.94,0.0,0.0,f_pos[3]-90, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 50.00, 50.00);
	Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
	NamazTimer[playerid] = 10;
	NoAnim[playerid] = 1;
	ApplyAnimation(playerid,"SWEET","Sweet_injuredloop",3.0,false,true,true,true,true, SYNC_ALL);
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Вы начали намаз\n{808000}« Во имя Аллаха, Милостивого, Милосердного »\n\n{cccccc}- Дождитесь завершения (10 секунд)\n- Если вы пошевелитесь или встанете с коврика, то прервёте намаз","*","");

	new string[80];
	if(NameTag[playerid] == true) format(string, sizeof(string), "%s говорит: Аллаху акбар", playername(playerid));
	else format(string, sizeof(string), "%s[%d] говорит: Аллаху акбар", playername(playerid), playerid);
	ProxDetector(20.0, playerid, string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
	SetPlayerChatBubble(playerid,"Аллаху акбар",COLOR_TALK_PLAYER,35.0,10000);

	if(PlayerInfo[playerid][pSex] == 1) around_player_audio(playerid, 4000, 0, 5.0, 1);
	else around_player_audio(playerid, 4001, 0, 5.0, 1);

	PlayerInfo[playerid][pNamazCD] = gettime() + 3600;
	mysql_save(playerid, 74); // Сохраняем кд сразу в базу
	return 1;
}

stock NamazProcess(playerid)
{
	if(!IsPlayerInRangeOfPoint(playerid,0.8,SpX[playerid], SpY[playerid], SpZ[playerid])) return NamazEnd(playerid, 1);
 
	new Float:angle;
    GetPlayerFacingAngle(playerid, angle);
	if(angle != SpA[playerid]) return NamazEnd(playerid, 1);
	return 1;
}

stock NamazEnd(playerid, stat)
{
	CloseNamaz(playerid);
	if(stat == 0) 
	{
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Вы завершили намаз","*","");
		if(PlayerInfo[playerid][pAchieve][123] == 0) AchievePlayer(playerid, 123, 1);
	}
	else if(stat == 1) ErrorMessage(playerid, "{FF6347}Вы прервали намаз\n\n{cccccc}Совсем ку ку? Аллах покарает за это");
	else if(stat == 2) ErrorMessage(playerid, "{FF6347}Намаз прерван");
	ClearAnim(playerid), ClearAnimations(playerid);
	ApplyAnimation(playerid,"PED","facanger",4.0, false, true, true, true, true, SYNC_ALL);
	return 1;
}

stock CloseNamaz(playerid)
{
	if(Namaz[playerid] >= 0) DestroyDynamicObject(Namaz[playerid]);
	Namaz[playerid] = -1;
	NamazTimer[playerid] = 0;
	NoAnim[playerid] = 0;
	return 1;
}

stock SitBottle(playerid)
{
	new current_tick = GetTickCount();
    new interval = GetTickDiff(current_tick, Afclick[playerid]);
    if(interval < 700) return 0; // Блокируем, если игрок клацает часто на кнопку

	new animname[32], animlib[32];
	GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
	if(strcmp(animlib, "PED", true) == 0 && strcmp(animname, "WEAPON_CROUCH", true) == 0)
	{
		Afclick[playerid] = current_tick;

		PlayerInfo[playerid][pBottlePoint] ++;
		SetPlayerChatBubble(playerid,"сел на бутылку",COLOR_PURPLE,20.0,3000);

		new string[80];
		format(string,sizeof(string),"~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Ceћ ®a Ђy¦Ёћky: ~y~%d Point", PlayerInfo[playerid][pBottlePoint]);
		GameTextForPlayer(playerid,string,2000,3);

		CompleteBattlePassTask(playerid, 42, 1);

		if(IsPlayerSyncModels(playerid)) PlayerPlaySound(playerid,5206,0,0,0); // Звук бутылки (чпоньк)
		else PlayerPlaySound(playerid,4604,0,0,0);

		if(PlayerInfo[playerid][pAchieve][125] == 0) AchievePlayer(playerid, 125, 1);

		if(PlayerInfo[playerid][pBottlePoint] >= 1000 && PlayerInfo[playerid][pAchieve][128] == 0)
		{
			AchievePlayer(playerid, 128, 1);
			GiveGiftQuest(playerid);
		}
	}
	return 1;
}

