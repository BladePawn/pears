		cache_get_value_name_float(f, "InbedRX", DomInfo[idx][dInbedRX]);
		cache_get_value_name_float(f, "InbedRY", DomInfo[idx][dInbedRY]);
		cache_get_value_name_float(f, "InbedRZ", DomInfo[idx][dInbedRZ]);
		cache_get_value_name_float(f, "InbedRA", DomInfo[idx][dInbedRA]);
		cache_get_value_name_int(f, "AcccupO", DomInfo[idx][dAcccupO]);
		cache_get_value_name_int(f, "AcccupP", DomInfo[idx][dAcccupP]);
		cache_get_value_name_int(f, "AcccupG", DomInfo[idx][dAcccupG]);
		cache_get_value_name_int(f, "AcccupD", DomInfo[idx][dAcccupD]);
		cache_get_value_name_int(f, "Accgar", DomInfo[idx][dAccgar]);
		cache_get_value_name_int(f, "Accdoo", DomInfo[idx][dAccdoo]);
		cache_get_value_name_int(f, "Accfur", DomInfo[idx][dAccfur]);
		cache_get_value_name_int(f, "Accint", DomInfo[idx][dAccint]);
		cache_get_value_name(f, "Name", DomInfo[idx][dName], 34);
		cache_get_value_name_int(f, "Descrip", DomInfo[idx][dDescrip]);
		cache_get_value_name_int(f, "Famcar", DomInfo[idx][dFamcar]);
		cache_get_value_name_int(f, "Taxes", DomInfo[idx][dTaxes]);
		cache_get_value_name_int(f, "Taxday", DomInfo[idx][dTaxday]);
		cache_get_value_name_int(f, "Class", DomInfo[idx][dClass]);
		cache_get_value_name_bool(f, "MoreIntObjects", DomInfo[idx][dMoreIntObjects]);
		cache_get_value_name_float(f, "dMapDistance", DomInfo[idx][dMapDistance]);
		cache_get_value_name_int(f, "dElectroStatus", DomInfo[idx][dElectroStatus]);
		cache_get_value_name_int(f, "dElectroConnect", DomInfo[idx][dElectroConnect]);
		cache_get_value_name_int(f, "dElectroUnix", DomInfo[idx][dElectroUnix]);
		cache_get_value_name_int(f, "dInteriorPack", DomInfo[idx][dInteriorPack]);

		if(DomInfo[idx][dClass] == 5)
		{
			cache_get_value_name_int(f, "dDoorInt0", DomInfo[idx][dDoorInt][0]);
			cache_get_value_name_int(f, "dDoorInt1", DomInfo[idx][dDoorInt][1]);
			cache_get_value_name_int(f, "dDoor0", DomInfo[idx][dDoor][0]);
			cache_get_value_name_int(f, "dDoor1", DomInfo[idx][dDoor][1]);

			cache_get_value_name_float(f, "dCoordDopDoorOneX", DomInfo[idx][dCoordDopDoorOne][0]);
			cache_get_value_name_float(f, "dCoordDopDoorOneY", DomInfo[idx][dCoordDopDoorOne][1]);
			cache_get_value_name_float(f, "dCoordDopDoorOneZ", DomInfo[idx][dCoordDopDoorOne][2]);
			cache_get_value_name_float(f, "dCoordDopDoorTwoX", DomInfo[idx][dCoordDopDoorTwo][0]);
			cache_get_value_name_float(f, "dCoordDopDoorTwoY", DomInfo[idx][dCoordDopDoorTwo][1]);
			cache_get_value_name_float(f, "dCoordDopDoorTwoZ", DomInfo[idx][dCoordDopDoorTwo][2]);

			cache_get_value_name_float(f, "dCoordDopDoorOneIntX", DomInfo[idx][dCoordDopDoorOneInt][0]);
			cache_get_value_name_float(f, "dCoordDopDoorOneIntY", DomInfo[idx][dCoordDopDoorOneInt][1]);
			cache_get_value_name_float(f, "dCoordDopDoorOneIntZ", DomInfo[idx][dCoordDopDoorOneInt][2]);
			cache_get_value_name_float(f, "dCoordDopDoorTwoIntX", DomInfo[idx][dCoordDopDoorTwoInt][0]);
			cache_get_value_name_float(f, "dCoordDopDoorTwoIntY", DomInfo[idx][dCoordDopDoorTwoInt][1]);
			cache_get_value_name_float(f, "dCoordDopDoorTwoIntZ", DomInfo[idx][dCoordDopDoorTwoInt][2]);
			if(DomInfo[idx][dDoorInt][0] == 1) DopDomPickupInt[idx][0] = CreateDynamicPickup(19132, 1, DomInfo[idx][dCoordDopDoorOneInt][0], DomInfo[idx][dCoordDopDoorOneInt][1], DomInfo[idx][dCoordDopDoorOneInt][2],idx+1000,DomInfo[idx][dInterior]);
			if(DomInfo[idx][dDoorInt][1] == 1) DopDomPickupInt[idx][1] = CreateDynamicPickup(19132, 1, DomInfo[idx][dCoordDopDoorTwoInt][0], DomInfo[idx][dCoordDopDoorTwoInt][1], DomInfo[idx][dCoordDopDoorTwoInt][2],idx+1000,DomInfo[idx][dInterior]);
			if(DomInfo[idx][dDoor][0] == 1) DopDomPickup[idx][0] = CreateDynamicPickup(19132, 1, DomInfo[idx][dCoordDopDoorOne][0], DomInfo[idx][dCoordDopDoorOne][1], DomInfo[idx][dCoordDopDoorOne][2],0,0);	
			if(DomInfo[idx][dDoor][1] == 1) DopDomPickup[idx][1] = CreateDynamicPickup(19132, 1, DomInfo[idx][dCoordDopDoorTwo][0], DomInfo[idx][dCoordDopDoorTwo][1], DomInfo[idx][dCoordDopDoorTwo][2],0,0);
		}
		if(DomInfo[idx][dMapDistance] == 0.0) DomInfo[idx][dMapDistance] = 30.0;

		if(idx >= 1)
	 	{
			CreateDesriptionDom(idx);
			if(DomInfo[idx][dIntoi] == 1) IntoiLabel[idx] = CreateDynamic3DTextLabel("{ff9000}Туалет\n{ffffff}[ ALT ]",-1,DomInfo[idx][dToiX], DomInfo[idx][dToiY], DomInfo[idx][dToiZ],3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,idx+1000,DomInfo[idx][dInterior]);
			if(DomInfo[idx][dInsin] == 1) InsinLabel[idx] = CreateDynamic3DTextLabel("{ff9000}Раковина\n{ffffff}[ ALT ]",-1,DomInfo[idx][dSinX], DomInfo[idx][dSinY], DomInfo[idx][dSinZ],3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,idx+1000,DomInfo[idx][dInterior]);
			if(DomInfo[idx][dInsou] == 1) InsouLabel[idx] = CreateDynamic3DTextLabel("{ff9000}Душ\n{ffffff}[ ALT ]",-1,DomInfo[idx][dSouX], DomInfo[idx][dSouY], DomInfo[idx][dSouZ],3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,idx+1000,DomInfo[idx][dInterior]);
		}
	}
	format(strFromFile2,sizeof(strFromFile2),"{ffffff}* {0088ff}Топливо {ffffff}[ {0088ff}%d л. {ffffff}] *\n{ffffff}[ {0088ff}/fill {ffffff}]\n[ Заправить Цистерну - {0088ff}CAPS LOCK (Гудок) {ffffff}]",DomInfo[103][dProd0]);
	FrakiBenz[18] = CreateDynamic3DTextLabel(strFromFile2,0xA9C4E4FF,-131.4318,-148.0569,3.1172,15.0);
	format(strFromFile2,sizeof(strFromFile2),"{ffffff}* {0088ff}Топливо {ffffff}[ {0088ff}%d л. {ffffff}] *\n{ffffff}[ {0088ff}/fill {ffffff}]\n[ Заправить Цистерну - {0088ff}CAPS LOCK (Гудок) {ffffff}]",DomInfo[105][dProd0]);
	FrakiBenz[19] = CreateDynamic3DTextLabel(strFromFile2,0xA9C4E4FF,357.5112,-1807.9323,4.5737,15.0);
	printf("[MODE]: Дома [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
function LoadCam()
{
	new time = GetTickCount();
	new rows, Float:obj_pos[6];
	cache_get_row_count(rows);
	for(new f; f < rows; ++f)
	{
		cache_get_value_name_int(f, "newid", CamInfo[f][cID]);
		cache_get_value_name_int(f, "Stat", CamInfo[f][cStat]);
		cache_get_value_name_int(f, "Account", CamInfo[f][cAccount]);
		cache_get_value_name(f, "Vlad", CamInfo[f][cVlad], 24);
		cache_get_value_name(f, "Name", CamInfo[f][cName], 24);
		cache_get_value_name_int(f, "Date", CamInfo[f][cDate]);
		cache_get_value_name_float(f, "cX", obj_pos[0]);
		cache_get_value_name_float(f, "cY", obj_pos[1]);
		cache_get_value_name_float(f, "cZ", obj_pos[2]);
		cache_get_value_name_float(f, "cRX", obj_pos[3]);
		cache_get_value_name_float(f, "cRY", obj_pos[4]);
		cache_get_value_name_float(f, "cRZ", obj_pos[5]);
		cache_get_value_name_int(f, "World", CamInfo[f][cWorld]);
		cache_get_value_name_int(f, "Interior", CamInfo[f][cInterior]);
		if(CamInfo[f][cStat] > 0) CamInfo[f][cObject] = CreateDynamicObject(1616, obj_pos[0], obj_pos[1], obj_pos[2], obj_pos[3], obj_pos[4], obj_pos[5], CamInfo[f][cWorld], CamInfo[f][cInterior], -1, 60.00, 60.00);
	}
	camerafbi = rows;
	printf("[MODE]: Камеры Слежения [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
stock UpdateBizLabel(idx, stat)
{
	if(LIMITED_LOADING_SERVER >= 2) return 1;
	new str[200],sctring[600];
	format(str,sizeof(str),"{FF0000}* {cccccc}Бизнес {ff9000}%s {444444}[ № %d ] {FF0000}*\n",bizname(idx), idx), strcat(sctring,str);
	if(BizzInfo[idx][bDescrip] == 1)format(str,sizeof(str),"{ff9000}%s\n",BizzInfo[idx][bName]), strcat(sctring,str);
	if(BizzInfo[idx][bSost] >= 1)
	{
		format(str,sizeof(str),"{cccccc}Владелец: {ff9000}%s\n",BizzInfo[idx][bVlad]), strcat(sctring,str);
		if(BizzInfo[idx][bSell] >= 1)
		{
			format(str,sizeof(str),"\n{33cc66}ПРОДАЁТСЯ\n"), strcat(sctring,str);
			format(str,sizeof(str),"{cccccc}Цена: {99ff66}%d$ (%s)\n", BizzInfo[idx][bSell], get_k(BizzInfo[idx][bSell])), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}[ Приобрести можно в Бизнес Центре ]"), strcat(sctring,str);
		}
		if(BizzInfo[idx][bArest] >= 1) format(str,sizeof(str),"\n{ff0000}АРЕСТОВАН"), strcat(sctring,str);
	}
	else
	{
		if(BizzInfo[idx][bLevel] >= 50)
		{
			format(str,sizeof(str),"\n{FF6347}[ ЗАРЕЗЕРВИРОВАН ]"), strcat(sctring,str);
			format(str,sizeof(str),"\n\n{cccccc}Этот бизнес подготовлен в качестве приза\n во время мероприятия или розыгрыша"), strcat(sctring,str);
		}
		else
		{
		 	format(str,sizeof(str),"{33cc66}ПРОДАЁТСЯ\n"), strcat(sctring,str);
	  		format(str,sizeof(str),"{cccccc}Стоимость: {99ff66}%d$ (%s)\n", biz_cena(idx), get_k(biz_cena(idx))), strcat(sctring,str);
			format(str,sizeof(str),"{cccccc}Gold Стоимость: {ffcc00}%dG\n", BizzInfo[idx][bGold]), strcat(sctring,str);
	  		format(str,sizeof(str),"\n{cccccc}[ Приобрести можно в Бизнес Центре ]"), strcat(sctring,str);
		}
	}
	format(str,sizeof(str),"\n\n{444444}Под Контролем: %s", frakName[BizzInfo[idx][bMafia]]), strcat(sctring,str);
	if(idx >= 13 && idx <= 26 || idx >= 133 && idx <= 142 || idx >= 173 && idx <= 182)
	{
		format(str,sizeof(str),"\n{cccccc}[ CAPS LOCK (Гудок) - Разгрузить Товар ]"), strcat(sctring,str);
	}
	if(stat == 1)
	{
		DestroyDynamic3DTextLabel(BizLabel[idx]);
		DestroyDynamicPickup(BizPickup[idx]);
	}
	BizLabel[idx] = CreateDynamic3DTextLabel(sctring,0xA9C4E4FF,BizzInfo[idx][bX],BizzInfo[idx][bY],BizzInfo[idx][bZ]+1,15.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
	BizPickup[idx] = CreateDynamicPickup(1314, 1, BizzInfo[idx][bX], BizzInfo[idx][bY], BizzInfo[idx][bZ], 0, 0);
	BizMapIcon(idx);
	return 1;
}
stock UpdateFillLabel(b)
{
	new str[184];
	format(str,sizeof(str),"{ff9000}Заправка {cccccc}1 Литр = {99ff66}%d$\n{ffffff}[ {0088ff}CAPS LOCK (Гудок) {ffffff}]\n\n{ffffff}[ {cccccc}/fillkani - заправить канистру {ffffff}]", BizzInfo[b][bPrice][0]);
	UpdateDynamic3DTextLabelText(BizFill[b][0],-1,str);
	format(str,sizeof(str),"{ff9000}Заправка {cccccc}1 Литр = {99ff66}%d$\n{ffffff}[ {0088ff}CAPS LOCK (Гудок) {ffffff}]\n\n{ffffff}[ {cccccc}/fillkani - заправить канистру {ffffff}]", BizzInfo[b][bPrice][0]);
	UpdateDynamic3DTextLabelText(BizFill[b][1],-1,str);
	format(str,sizeof(str),"{ff9000}Доставка Товаров\n{ffffff}[ {0088ff}CAPS LOCK (Гудок) - в грузовике {ffffff}]\n\n{444444}[ %d/50000 Литров ]", BizzInfo[b][bItem][0]);
	UpdateDynamic3DTextLabelText(BizFill[b][2],-1,str);
}
