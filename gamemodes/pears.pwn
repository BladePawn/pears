	case 647:// Изменение Названия
	{
		new b = DP[4][playerid];
		if(response)
		{
			if(!GetAccessBiz(playerid, b, 1)) return 0;

			if(!strlen(inputtext)) return mybiz(playerid, b);
			if(checksimvolfam(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хм... я пытаюсь указать в названии какие-то каракули... [ Запрещённый Символ ]"), mybiz(playerid, b);
			if(strlen(inputtext) < 3 || strlen(inputtext) > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Название должно быть не больше 30-ти и не меньше 3-ёх символов.."), mybiz(playerid, b);

			strmid(BizzInfo[b][bName], inputtext, 0, 64); // Меняем название
			BizzInfo[b][bDescrip] = 1, BizzInfo[b][bUpdate] = 1;
			format(string,sizeof(string),"[ Мысли ]: Новое название бизнеса: %s", inputtext), SendClientMessage(playerid, COLOR_GREY, string);
			BizLog("bname", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, 0, inputtext);
			if(BizzInfo[b][bLab] == 1) UpdateBizLabel(b, BizzInfo[b][bLab]);
			if(IsBizTerminal(b))
			{
				new br = numnrent(b);
    			for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
				{
					if(RentStat[br][i] > 0) UpdateLabelTerm(b, br, i);
				}
			}
			mybiz(playerid, b);
			PlayerPlaySound(playerid,6401,0,0,0);
			return 1;
		}
		else mybiz(playerid, b);
	}
