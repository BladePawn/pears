						if(fpara <= 0) return ErrorMessage(playerid, "{FF6347}Автомат испорчен");
						TakeInvent(playerid, 29, quan, 0, 999, false);
						TakeInvent(playerid, weapon, quan, 1, inva, false);
						Protect_GiveWeapons(playerid, weapon, quan, fpara, fqara);
					}
					else if(weaponType == 5)
					{
						if(get_invent4(playerid, 30, 0) < quan) return ErrorMessage(playerid, "{ff6347}У вас нет такого количества патронов к винтовке {cccccc}[ Ammo 45mm ]");
						if(IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleSeat(playerid) >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя доставать оружие в транспорте");
						if(fpara <= 0) return ErrorMessage(playerid, "{FF6347}Винтовка испорчена");
						TakeInvent(playerid, 30, quan, 0, 999, false);
						TakeInvent(playerid, weapon, quan, 1, inva, false);
						Protect_GiveWeapons(playerid, weapon, quan, fpara, fqara);
