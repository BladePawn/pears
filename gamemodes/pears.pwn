	           format(string, sizeof(string), "Бой Через: %d",RingInfo[rg][rTimer]+1);
	           SetPlayerChatBubble(RingInfo[rg][rIdb],string,COLOR_LIGHTBLUE,20.0,1500);
	           if(rg == 0)
	           {
