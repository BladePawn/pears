function Call_UnreadMessagesNotify(playerid, race_check) {
	new rows;
	cache_get_row_count(rows);
	if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);

	new count = rows, status;
	for (new i = 0; i < rows; i++) {
		cache_get_value_name_int(i, "status", status);
		count -= status;
	}

	if (count > 0) SendClientMessage(playerid, COLOR_GREY, "{0088FF}У вас {ffcc66}%d {0088ff}%s {ffcc66}[ Y >> SMS ]", count, PluralToText(count, "непрочитанное уведомление", "непрочитанных уведомлений", "непрочитанных уведомлений"));
	return 1;
}

function Call_message(playerid, stat)
{
	new rows, f_str[70];
	cache_get_row_count(rows);
	new newid, status, type, sender[21], unix, quan, tyear, tmonth, tday, thour, tminute, tsecond, str[84], sctring[4096], qwer[64];
	format(str,sizeof(str),"{ffff00}[С] {cccccc}- Сообщение | {0088ff}[У] {cccccc}- Уведомление\t \n"), strcat(sctring,str);
	format(str, sizeof(str), "{cccccc}Отметить все прочитанными \t \n"), strcat(sctring,str);

	if (stat == 1) { // Отметить все прочитанным
		mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_message` SET `status` = '1' WHERE `playerid` = '%d'", PlayerInfo[playerid][pID]);
		query_empty(pearsq, f_str);
	}

	for(new i = 0; i < rows; i++)
	{
	    cache_get_value_name_int(i, "newid", newid);
		cache_get_value_name_int(i, "status", status); if (stat == 1) status = 1;
		cache_get_value_name_int(i, "type", type);
		//cache_get_value_name_int(i, "senderid", senderid);
		cache_get_value_name(i, "sender", sender, 21);
		cache_get_value_name_int(i, "unix", unix);
		//cache_get_value_name(i, "text", text, 64);
		stamp2datetime(unix, tyear, tmonth, tday, thour, tminute, tsecond, 3);
		List[i][playerid] = newid;
		if(type == 0)
		{
			if(status == 0) format(str, sizeof(str), "{ffff00}[С] {ff9000}%s\t {cccccc}%02d:%02d %02d.%02d.%d\n", sender, thour, tminute, tday, tmonth, tyear), strcat(sctring,str), quan ++;
			else format(str, sizeof(str), "{ffff00}[С] {cccccc}%s\t %02d:%02d %02d.%02d.%d\n", sender, thour, tminute, tday, tmonth, tyear), strcat(sctring,str);
		}
		else
		{
			if(status == 0) format(str, sizeof(str), "{0088ff}[У] {ff9000}Уведомление\t {cccccc}%02d:%02d %02d.%02d.%d\n", thour, tminute, tday, tmonth, tyear), strcat(sctring,str), quan ++;
			else format(str, sizeof(str), "{0088ff}[У] {cccccc}Уведомление\t %02d:%02d %02d.%02d.%d\n", thour, tminute, tday, tmonth, tyear), strcat(sctring,str);
		}
	}
	PlayerPlaySound(playerid,1150,0,0,0);
	if(quan > 0) format(qwer,sizeof(qwer),"{ff9000}Сообщения {99ff66}[%d Новых]",quan);
	else format(qwer,sizeof(qwer),"{ff9000}Сообщения {cccccc}[Нет новых]");
	if(PlayerInfo[playerid][pDrawVisible][2] == false) PlayerTextDrawHide(playerid, PlayerSiteDraw[2][playerid]);
	ShowDialog(playerid,1118,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Выбрать","Назад");
	return 1;
}
function Call_message2(playerid, race_check)
{
	new rows, quan, status;
	cache_get_row_count(rows);
	if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);
	
	for(new i = 0; i < rows; i++)
	{
		cache_get_value_name_int(i, "status", status);
		if(status == 0) quan ++;
	}
	if(quan > 0 && PlayerInfo[playerid][pDrawVisible][2] == false) PlayerTextDrawShow(playerid, PlayerSiteDraw[2][playerid]);
	return 1;
}
CMD:message(playerid)
{
	new smart = get_invent4(playerid, 26, 0), note = get_invent4(playerid, 42, 0);
	if(smart == 1 && note == 0 && get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	if(note == 1 && smart == 0 && get_para(playerid, 42) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой ноутбук сломан [ Y >> GPS >> Услуги >> Техника ]");
	if(smart == 0 && note == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет ноутбука или смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	DP[0][playerid] = 0;
	DP[3][playerid] = 0;
	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Сообщения","{cccccc}Поиск сообщений...","*","");
	new string[101];
	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_message` WHERE `playerid` = '%d' ORDER BY `newid` DESC LIMIT 100", PlayerInfo[playerid][pID]);
	mysql_tquery(pearsq, string, "Call_message", "dd", playerid, 0);
	return 1;
}
function Call_showmessage(playerid, newid)
{
	new rows;
	cache_get_row_count(rows);
	new status, type, sender[21], player[21], unix, text[146], tyear, tmonth, tday, thour, tminute, tsecond, str[124], sctring[840], pid;
	if(rows)
	{
		cache_get_value_name_int(0, "status", status);
		cache_get_value_name_int(0, "type", type);
		cache_get_value_name(0, "sender", sender, 21);
		cache_get_value_name_int(0, "playerid", pid);
		cache_get_value_name(0, "player", player, 21);
		cache_get_value_name_int(0, "unix", unix);
		cache_get_value_name(0, "text", text, 144);
		stamp2datetime(unix, tyear, tmonth, tday, thour, tminute, tsecond, 3);
		if(type == 0)
		{
			format(str,sizeof(str),"\n{ffff00}SMS от %s {cccccc}[ %02d:%02d %02d.%02d.%d ]", sender, thour, tminute, tday, tmonth, tyear), strcat(sctring,str);
			format(str,sizeof(str),"\n{99ff33}%s\n", text), strcat(sctring,str);
		}
		else if(type == 1)
		{
		    new senderid;
			cache_get_value_name_int(0, "senderid", senderid);
			if(senderid == 0) format(str,sizeof(str),"\n{0088ff}Уведомление {cccccc}[ %02d:%02d %02d.%02d.%d ]", thour, tminute, tday, tmonth, tyear), strcat(sctring,str);
			else format(str,sizeof(str),"\n{0088ff}Уведомление от %s {cccccc}[ %02d:%02d %02d.%02d.%d ]", sender, thour, tminute, tday, tmonth, tyear), strcat(sctring,str);
			format(str,sizeof(str),"\n{ffcc66}%s\n", text), strcat(sctring,str);
		}
		if(pid == PlayerInfo[playerid][pID])
		{
			ShowDialog(playerid,2003,DIALOG_STYLE_MSGBOX,"{ff9000}Сообщение",sctring,"Oк","");
			if(status == 0)
			{
				new f_str[70];
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_message` SET `status` = '1' WHERE `newid` = '%d'",newid);
				query_empty(pearsq, f_str);
			}
		}
		else
		{
			format(str,sizeof(str),"{ff9000}Сообщение %s", player);
			ShowDialog(playerid,2003,DIALOG_STYLE_MSGBOX,str,sctring,"Oк","");
		}
	}
	return 1;
}
CMD:readm(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Прочитать личное сообщение игрока [ /readm ID ]");
	if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Длина никнейма не больше 20-ти символов");
	new giveplayerid;
 	giveplayerid = ReturnUser(params[0], 1);
	if(IsOnline(giveplayerid))
	{
		DP[0][playerid] = 228;
		DP[3][playerid] = -1;
		ListCode[playerid] = giveplayerid;
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Сообщения","{cccccc}Поиск сообщений...","*","");
		new string[101];
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_message` WHERE `playerid` = '%d' ORDER BY `newid` DESC LIMIT 100", PlayerInfo[giveplayerid][pID]);
		mysql_tquery(pearsq, string, "Call_message", "dd", playerid, 0);
	}
	else
	{
		if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверное имя, чтобы прочитать Offline");
		DP[0][playerid] = 229;
		DP[3][playerid] = -1;
		format(ListName[playerid],21,"%s", params[0]);
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Сообщения","{cccccc}Поиск сообщений...","*","");
		new string[101];
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_message` WHERE `player` = '%e' ORDER BY `newid` DESC LIMIT 100", params[0]);
		mysql_tquery(pearsq, string, "Call_message", "dd", playerid, 0);
	}
	return 1;
}
CMD:phone(playerid)
{
	if(get_invent4(playerid, 26, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет смартфона [ Y >> GPS >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мой смартфон сломан [ Y >> GPS >> Услуги >> Техника ]");
	new str[64], sctring[2444], kol;
	format(str,sizeof(str),"\n{99ff66}Набрать Номер"), strcat(sctring,str);

	if(OnlineInfo[playerid][oServiceMake][0] == 4) format(str,sizeof(str),"\n{99ff66}Активный вызов {ffcc00}Такси"), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Вызвать {ffcc00}Такси"), strcat(sctring,str);

	if(OnlineInfo[playerid][oServiceMake][0] == 1) format(str,sizeof(str),"\n{99ff66}Активный вызов {0066ff}Полиции"), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Вызвать {0066ff}Полицию"), strcat(sctring,str);

	if(OnlineInfo[playerid][oServiceMake][0] == 2) format(str,sizeof(str),"\n{99ff66}Активный вызов {0066ff}Скорой Помощи"), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Вызвать {ff6666}Скорую Помощь"), strcat(sctring,str);

    for(new c = 0; c < MAX_FRIENDS; c++)
	{
