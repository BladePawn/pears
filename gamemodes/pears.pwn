				FamilyInfo[fam][fDop5] = nd;
				DomInfo[nd][dFamcar] = 0;
				SaveDom(nd);
				SaveFamily(fam);
				FamilyLog(fam, "fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", nd, "Привязал Дом");
				HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], nd, fam, "Привязал Семью");
			}
			else
			{
				new fam = DomInfo[nd][dFam];
				if(FamilyInfo[fam][fSost] >= 1) format(string, sizeof(string), "[ Мысли ]: Я отключил семью %s {cccccc}[%d] от своего дома", FamilyInfo[fam][fName],fam);
				else format(string, sizeof(string), "[ Мысли ]: Я отключил неизвестную семью от своего дома");
				SendClientMessage(playerid, COLOR_GREY, string);
