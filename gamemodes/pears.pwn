		if(PlayerInfo[playerid][pTstat] >= 1) CloseTrade(playerid);
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,0);
		PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,1057.9298,1724.3844,42.1426);
		PPSetPlayerFacingAngle(playerid,1.1451);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1058.0891,1721.6442,42.1156)) // Спуститься с крыши центр обмена 2
	{
		S_SetPlayerVirtualWorld(playerid,100);
		PPSetPlayerInterior(playerid,100);
		PPSetPlayerPos(playerid,1275.0699,-27.8147,1000.9254);
		PPSetPlayerFacingAngle(playerid,90.9505);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,-49.8843,-269.3626,6.6332)) // Вход в дальнобойщики
	{
		S_SetPlayerVirtualWorld(playerid,11);
		PPSetPlayerInterior(playerid,11);
		PPSetPlayerPos(playerid,1366.4506,-20.7165,1001.0793);
		PPSetPlayerFacingAngle(playerid,270.6478);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1362.5724,-20.7131,1001.4257) && GetPlayerInterior(playerid) == 11 && GetPlayerVirtualWorld(playerid) == 11) // Выход из дальнобойщиков
	{
		S_SetPlayerVirtualWorld(playerid,0);
		PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,-49.9256,-272.1231,6.6332);
		PPSetPlayerFacingAngle(playerid,179.0081);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,-2146.7568,79.7715,35.5236)) // Вход в Пожарку
	{
		if(PlayerInfo[playerid][pLeader] == 4 || PlayerInfo[playerid][pMember] == 4)
		{
			S_SetPlayerVirtualWorld(playerid,4);
			PPSetPlayerInterior(playerid,4);
			PPSetPlayerPos(playerid,-2125.2488,60.3181,1403.3984);
			PPSetPlayerFacingAngle(playerid,359.5178);
			SetCameraBehindPlayer(playerid);
		}
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,-2125.3247,56.9539,1403.3984)) // Выход из Пожарки
	{
		S_SetPlayerVirtualWorld(playerid,0);
		PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,-2146.8904,76.7456,35.1633);
		PPSetPlayerFacingAngle(playerid,184.0027);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,2034.1288,-1401.7795,17.2937)) // Вход в Психушку
	{
		S_SetPlayerVirtualWorld(playerid,4);
		PPSetPlayerInterior(playerid,4);
		PPSetPlayerPos(playerid,1218.5492,-1361.2124,2001.0449);
		PPSetPlayerFacingAngle(playerid,359.8344);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1218.5175,-1363.5293,2001.0449)) // Выход из Психушки
	{
		S_SetPlayerVirtualWorld(playerid,0);
		PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,2034.1766,-1404.6216,17.2540);
		PPSetPlayerFacingAngle(playerid,180.2927);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1675.4684,-747.0352,41.8554)) // Вход на КПП SF-1
	{
		if(IsADepart(playerid))
		{
			PPSetPlayerPos(playerid,-1674.3008,-744.6099,41.8554);
			PPSetPlayerFacingAngle(playerid,331.8913);
			SetCameraBehindPlayer(playerid);
		}
	}
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1675.1284,-746.0660,41.8554)) // Выход из КПП SF-1
	{
		if(IsADepart(playerid))
		{
			PPSetPlayerPos(playerid,-1676.9789,-749.4829,41.8554);
			PPSetPlayerFacingAngle(playerid,154.2529);
			SetCameraBehindPlayer(playerid);
		}
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,2481.0776,1525.1599,11.7813)) // Вход в Сауну
	{
		S_SetPlayerVirtualWorld(playerid,85,1);
		PPSetPlayerInterior(playerid,1);
		PPSetPlayerPos(playerid,1318.3744,1315.2648,1558.2090);
		PPSetPlayerFacingAngle(playerid,90.0);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1320.4353,1315.3605,1558.2090)) // Выход из Сауны
	{
		S_SetPlayerVirtualWorld(playerid,0,0);
		PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,2483.7234,1527.8661,11.0860);
		PPSetPlayerFacingAngle(playerid,320.0843);
		SetCameraBehindPlayer(playerid);
	} else return 0;

	return 1;
}
public Zalupon()
{
	// Запускаем инкассаторскую машину
	if(NPCInfo[3][npcStart] == false) CollectorStart();
	for(new b;b < MAX_BIZ; b++)
	{
		BizClearsHoursMoney(b);
	}

	return 1;
}
stock close_labirint()
{
	if(stat_labirint == 0) MoveDynamicObject(arhwall[0], 1433.058837, 1549.389160, 11.590300, 0.5), around_audio(6002, 0, 30.0, 1433.058837, 1549.389160, 11.590300, 226, 226);
	else if(stat_labirint == 1) MoveDynamicObject(arhwall[1], 1396.625976, 1549.389526, 11.590300, 0.5), around_audio(6002, 0, 30.0, 1396.625976, 1549.389526, 11.590300, 226, 226);
	else if(stat_labirint == 2) MoveDynamicObject(arhwall[2], 1433.058837, 1583.245239, 11.590300, 0.5), around_audio(6002, 0, 30.0, 1433.058837, 1583.245239, 11.590300, 226, 226);
	else if(stat_labirint == 3) MoveDynamicObject(arhwall[3], 1396.625976, 1583.235229, 11.590300, 0.5), around_audio(6002, 0, 30.0, 1396.625976, 1583.235229, 11.590300, 226, 226);
	else if(stat_labirint == 4) MoveDynamicObject(arhwall[4], 1367.538085, 1587.863891, 11.590300, 0.5), around_audio(6002, 0, 30.0, 1367.538085, 1587.863891, 11.590300, 226, 226);
