stock get_k_int(sum)
{
	new text[32], count;

	sum = abs(sum);
	while (sum >= 1000)
	{
		sum /= 1000;
		count++;
	}
	
	if (count == 0) {
		strcat(text, "0k");
		return text;
	}

	new suffix[16];
	for (new i = 0; i < count; i++)
	{
		strcat(suffix, "k");
	}

	format(text, sizeof(text), "%d%s", sum, suffix);
	return text;
}
stock get_k_bi(const BigInt:sum)
{
    new text[32], count = 0;
	
	new BigInt: remainder = bigint_create_bi(sum);
	bigint_abs(remainder);
	
	#pragma warning disable 250 // variable not modified in loop body
    while (remainder >= 1000)
    {
        bigint_div_q(remainder, 1000);
        count++;
    }
	#pragma warning enable 250

    if (count == 0) {
		strcat(text, "0k");
		bigint_destroy(remainder);
		return text;
	}

    new suffix[16];
    for (new i = 0; i < count; i++)
    {
        strcat(suffix, "k");
    }

    format(text, sizeof(text), "%d%s", bigint_get(remainder), suffix);
	bigint_destroy(remainder);
    return text;
}
stock get_k({_, BigInt}:arg, arg_type = tagof(arg))
{
	switch(arg_type)
	{
		case (tagof(_:)):
			return get_k_int(arg);
		case (tagof(BigInt:)):
			return get_k_bi(BigInt:arg);
	}
	return get_k_int(0);
}

stock UpdateTrade(playerid)
{
	if(PlayerInfo[playerid][pTstat] >= 1)
	{
		new str[100],sctring[500];
		format(str,sizeof(str),"\n\n\n\n\n\n\n{99ff66}[ Сделка ]\n\n");
    	strcat(sctring,str);
    	for(new t = 0; t < 3; t++)
    	{
    		if(PlayerInfo[playerid][pTslot][t] == 0) format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[playerid][pTslot][t]]);
    		else if(PlayerInfo[playerid][pTslot][t] == 1) format(str,sizeof(str),"%s {99ff66}[%d $][%s]\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTamount][t],get_k(PlayerInfo[playerid][pTamount][t]));
    		else if(PlayerInfo[playerid][pTslot][t] == 2) format(str,sizeof(str),"%s {ffcc00}[%d G]\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTamount][t]);
    		else if(PlayerInfo[playerid][pTslot][t] == 3) format(str,sizeof(str),"%s {0088ff}[%d B]\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTamount][t]); 
    		else if(PlayerInfo[playerid][pTslot][t] == 4) format(str,sizeof(str),"%s {cccccc}[%s]\n",tradeName[PlayerInfo[playerid][pTslot][t]],GetVehicleName(VehInfo[PlayerInfo[playerid][pTmodel][t]][vModel]));
    		else if(PlayerInfo[playerid][pTslot][t] >= 5 && PlayerInfo[playerid][pTslot][t] <= 7) format(str,sizeof(str),"%s {cccccc}№ %d\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTmodel][t]);
    		else if(PlayerInfo[playerid][pTslot][t] == 8)
			{
				if(PlayerInfo[playerid][pTmodel][t] <= 200) format(str,sizeof(str),"%s {cccccc}№ %d [ %s ]\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTmodel][t],bizname(PlayerInfo[playerid][pTmodel][t]));
				else format(str,sizeof(str),"{cccccc}пусто\n");
			}
    		else if(PlayerInfo[playerid][pTslot][t] == 10) format(str,sizeof(str),"%s {cccccc}№ %d\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTamount][t]);
    		else if(PlayerInfo[playerid][pTslot][t] == 11) format(str,sizeof(str),"%s {cccccc}Дома № %d\n",tradeName[PlayerInfo[playerid][pTslot][t]],PlayerInfo[playerid][pTamount][t]);
    		strcat(sctring,str);
   		}
   		format(str,sizeof(str),"\n{cccccc}Суммарная Ценность Сделки: {666666}%d$ {99ff66}[%s]",PlayerInfo[playerid][pTlave],get_k(PlayerInfo[playerid][pTlave]));
		strcat(sctring,str);
   		if(PlayerInfo[playerid][pTid] >= 0)
   		{
   			new para1 = PlayerInfo[playerid][pTid];
			if(IsOnline(para1))
			{
   				format(str,sizeof(str),"\n{cccccc}Участник Сделки: {0088ff}%s",PlayerInfo[para1][pName]);
    			strcat(sctring,str);
			}
   		}
		UpdateDynamic3DTextLabelText(TradeLabel[playerid],0xA9C4E4FF,sctring);
	}
	return 1;
}

stock CreateDesriptionDom(idx)
{
	new str[100],sctring[500];
	if(DomInfo[idx][dClass] <= 4) 
	{
		format(str,sizeof(str),"{FF0000}* {0088ff}Дом № {33ffff}%d {FF0000}*\n",idx), strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Класс: {ff9000}%d\n", DomInfo[idx][dClass]), strcat(sctring,str);
	}
	else format(str,sizeof(str),"{FF0000}* {ff9000}VIP Дом № {0088ff}%d {FF0000}*\n",idx), strcat(sctring,str);
	if(DomInfo[idx][dDescrip] == 1)format(str,sizeof(str),"{ff9000}%s\n",DomInfo[idx][dName]), strcat(sctring,str);
	// Статус Дома
	if(DomInfo[idx][dSost] >= 1)
	{
		DomIcon[idx] = CreateDynamicMapIcon(DomInfo[idx][dKoordinatX],DomInfo[idx][dKoordinatY],DomInfo[idx][dKoordinatZ],32,0,-1,-1,-1,200.0);
		format(str,sizeof(str),"{cccccc}Владелец: {ff9000}%s\n",DomInfo[idx][dVlad]), strcat(sctring,str);
		if(DomInfo[idx][dSell] >= 1)
		{
			format(str,sizeof(str),"\n{33cc66}ПРОДАЁТСЯ\n"), strcat(sctring,str);
			format(str,sizeof(str),"{33ffff}Цена: {33cc66}%d$ (%s)\n", DomInfo[idx][dSell], get_k(DomInfo[idx][dSell])), strcat(sctring,str);
			format(str,sizeof(str),"\n {ffffff}[ ALT купить дом ]"), strcat(sctring,str);
			DomPickup[idx] = CreateDynamicPickup(19470, 1, DomInfo[idx][dKoordinatX], DomInfo[idx][dKoordinatY], DomInfo[idx][dKoordinatZ],0,0);
		}
		else DomPickup[idx] = CreateDynamicPickup(19522, 1, DomInfo[idx][dKoordinatX], DomInfo[idx][dKoordinatY], DomInfo[idx][dKoordinatZ],0,0);
		if(DomInfo[idx][dArest] == 1) format(str,sizeof(str),"\n{ff0000}АРЕСТОВАН"), strcat(sctring,str);
		Streamer_SetIntData(STREAMER_TYPE_PICKUP, DomPickup[idx], STREAMER_HOUSE_ENTER, idx);
	}
	else
	{
		DomIcon[idx] = CreateDynamicMapIcon(DomInfo[idx][dKoordinatX],DomInfo[idx][dKoordinatY],DomInfo[idx][dKoordinatZ],31,0,-1,-1,-1,200.0);
  		DomPickup[idx] = CreateDynamicPickup(1273, 1, DomInfo[idx][dKoordinatX], DomInfo[idx][dKoordinatY],DomInfo[idx][dKoordinatZ],0,0);
		Streamer_SetIntData(STREAMER_TYPE_PICKUP, DomPickup[idx], STREAMER_HOUSE_ENTER, idx);
		if(DomInfo[idx][dLevel] >= 50)
		{
			format(str,sizeof(str),"\n{FF6347}[ ЗАРЕЗЕРВИРОВАН ]"), strcat(sctring,str);
			format(str,sizeof(str),"\n\n{cccccc}Этот дом подготовлен в качестве приза\nво время мероприятия или розыгрыша"), strcat(sctring,str);
		}
		else
		{
		 	format(str,sizeof(str),"{33cc66}ПРОДАЁТСЯ\n"), strcat(sctring,str);
      		format(str,sizeof(str),"{33ffff}Цена: {99ff66}%d$ (%s)\n", DomInfo[idx][dSost2], get_k(DomInfo[idx][dSost2])), strcat(sctring,str);
      		if(DomInfo[idx][dGold] > 0) format(str,sizeof(str),"{33ffff}Gold Цена: {ffcc00}%dG\n", DomInfo[idx][dGold]), strcat(sctring,str);
      		format(str,sizeof(str),"\n {ffffff}[ ALT купить дом ]"), strcat(sctring,str);
		}
 	}
	DomLabel[idx] = CreateDynamic3DTextLabel(sctring,0xFFFFFFFF,DomInfo[idx][dKoordinatX],DomInfo[idx][dKoordinatY],DomInfo[idx][dKoordinatZ]+0.5,15.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
	if(DomInfo[idx][dIngar] >= 1)
	{
		DomGarage[idx] = CreateDynamicPickup(2485, 1, DomInfo[idx][dGarageX], DomInfo[idx][dGarageY], DomInfo[idx][dGarageZ],0,0);
		new strFromFile2[256];
		if(DomInfo[idx][dFam] >= 1 && DomInfo[idx][dFamcar] >= 1) format(strFromFile2,sizeof(strFromFile2),"{444444}Гараж {ff9000}Дома № %d\n\n{ff9000}CAPS LOCK (Гудок) {cccccc}- поставить на парковку\n{0088ff}[ ALT - Гараж Семьи ]", idx);
		else format(strFromFile2,sizeof(strFromFile2),"{444444}Гараж {ff9000}Дома № %d\n\n{ff9000}CAPS LOCK (Гудок) {cccccc}- поставить на парковку", idx);
 		IngarLabel[idx] = CreateDynamic3DTextLabel(strFromFile2,-1,DomInfo[idx][dGarageX], DomInfo[idx][dGarageY], DomInfo[idx][dGarageZ],8.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
	}
	return 1;
}

stock UpdateDom(idx)
{
	if(LIMITED_LOADING_SERVER >= 2) return 1;
	if(idx <= 0 || idx >= 1001) return 1;

	DestroyDynamicPickup(DomPickup[idx]);
	DestroyDynamic3DTextLabel(DomLabel[idx]);
	DestroyDynamicMapIcon(DomIcon[idx]);
	if(DomInfo[idx][dIngar] >= 1) DestroyDynamicPickup(DomGarage[idx]), DestroyDynamic3DTextLabel(IngarLabel[idx]);
	
	CreateDesriptionDom(idx);
	return 1;
}
stock StopSpectate(playerid)
{
    SetPosa[playerid] = 1;
    PPExitSpectating(playerid);
    gSpectateID[playerid] = INVALID_PLAYER_ID, gSpectateType[playerid] = ADMIN_SPEC_TYPE_NONE;
    if(LoadSP[playerid] == true) DelSpecDraw(playerid);
	if(LoadIcaSP[playerid] == true) DelSpecIcaDraw(playerid);
	if(!Tomb_IsPlayerInGame(playerid)) {
		Tomb_SetCurseTextdraw(playerid, false);
		for (new i = 0; i < sizeof(TombCurseTD[]); i++) PlayerTextDrawDestroy(playerid, TombCurseTD[playerid][i]);
	}
	return 1;
}
stock StartSpectate(playerid, specid, stat)
{
	if (stat == 1)
	{
		if(PlayerInfo[specid][pSoska] > PlayerInfo[playerid][pSoska] && OnlineInfo[specid][oLogged] == 1 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pSoska] < 21) return StopSpectate(playerid), ErrorMessage(playerid, "{FF6347}Вы не можете следить за старшим администратором");
		if(PlayerInfo[playerid][pSoska] == 0 && fraction(playerid) == 8 && fraction(specid) != 8) return StopSpectate(playerid), ErrorMessage(playerid, "{FF6347}Вы не можете следить за этим игроком");
	}
	
	gSpectateID[playerid] = specid;
	S_SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(specid),GetPlayerInterior(specid));
	PPSetPlayerInterior(playerid,GetPlayerInterior(specid));
	if(stat == 1) 
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(specid, x, y, z);
		PPOpenSpectating(playerid, x, y, z);
	}
	if(LoadSP[playerid] == true) HideSpecBlock0(playerid);
	if(IsPlayerInAnyVehicle(specid))
	{
		gSpectateType[playerid] = ADMIN_SPEC_TYPE_VEHICLE;
		if(stat == 1) PlayerSpectateVehicle(playerid, GetPlayerVehicleID(specid));
		if(GetPlayerState(specid) == PLAYER_STATE_DRIVER && LoadSP[playerid] == true) ShowSpecPlayer(1, playerid, specid);
	}
	else
	{
		gSpectateType[playerid] = ADMIN_SPEC_TYPE_PLAYER;
		if(stat == 1) PlayerSpectatePlayer(playerid, specid);
	}
	
	if(LoadSP[playerid] == true)
	{
		ShowSpecPlayer(0, playerid, specid);
	    ShowSpecPlayer(2, playerid, specid);
	    ShowSpecPlayer(3, playerid, specid);
	    if(Device[playerid] == 1) SelectTextDraw(playerid,0x666666AA);
  	}
	if(PlayerInfo[playerid][pSoska] >= 1 && PlayerInfo[playerid][pSoska] <= 14 && stat == 1)
	{
		new string[140];
		format(string, sizeof(string), " [ ADM ]: %s[%d] следит за %s[%d]", PlayerInfo[playerid][pName], playerid, PlayerInfo[specid][pName], specid);
    	if(PlayerInfo[playerid][pSoska] >= 1 && PlayerInfo[playerid][pSoska] <= 9) MessCast(COLOR_ADM,string,10);
    	else if(PlayerInfo[playerid][pSoska] >= 10 && PlayerInfo[playerid][pSoska] <= 14) MessCast(COLOR_ADM,string,15);
	}

	if (Tomb_IsPlayerInGame(specid) && !TombPlayerInfo[specid][tpDead])
	{
		if (!Tomb_IsPlayerInGame(playerid)) Tomb_LoadTextdraws(playerid);
		Tomb_SetCurseTextdraw(playerid, true);
		Tomb_UpdateCurseTextdraw(playerid);
	}
	
	return 1;
}

stock FindNextPlayerSpectate(playerid)
{
	if (gSpectateID[playerid] == INVALID_PLAYER_ID) return INVALID_PLAYER_ID;

	for (new i = gSpectateID[playerid] + 1; i < MAX_REALPLAYERS; i++)
	{
		if (playerid == i) continue;
		if (!IsOnline(i)) continue;
		if (OnlineInfo[i][oLogged] == 0) continue;
		if (PlayerInfo[i][pHidden] > 0) continue;
		if (PlayerInfo[playerid][pSoska] < PlayerInfo[i][pSoska]) continue;

		new PLAYER_STATE:playerState = GetPlayerState(i);
		if (playerState == PLAYER_STATE_ONFOOT
			|| playerState == PLAYER_STATE_DRIVER
			|| playerState == PLAYER_STATE_PASSENGER
		)
		{
			return i;
		}
	}

	return INVALID_PLAYER_ID;
}

stock NextSpectate(playerid)
{
	new found = FindNextPlayerSpectate(playerid);
	if (found != INVALID_PLAYER_ID)
	{
		StartSpectate(playerid, found, 1);
		return 1;
	}
	return 0;
}

stock FindPreviousPlayerSpectate(playerid)
{
	if (gSpectateID[playerid] == INVALID_PLAYER_ID) return INVALID_PLAYER_ID;

	for (new i = gSpectateID[playerid] - 1; i >= 0; i--)
	{
		if (playerid == i) continue;
		if (!IsOnline(i)) continue;
		if (OnlineInfo[i][oLogged] == 0) continue;
		if (PlayerInfo[i][pHidden] > 0) continue;
		if (PlayerInfo[playerid][pSoska] < PlayerInfo[i][pSoska]) continue;

		new PLAYER_STATE:playerState = GetPlayerState(i);
		if (playerState == PLAYER_STATE_ONFOOT
			|| playerState == PLAYER_STATE_DRIVER
			|| playerState == PLAYER_STATE_PASSENGER
		)
		{
			return i;
		}
	}

	return INVALID_PLAYER_ID;
}

stock PreviousSpectate(playerid)
{
	new found = FindPreviousPlayerSpectate(playerid);
	if (found != INVALID_PLAYER_ID)
	{
		StartSpectate(playerid, found, 1);
		return 1;
	}
	return 0;
}

stock IsPlayerCommandBanned(const playerid, const cmd[])
{
	if (!IsPlayerConnected(playerid))
	{
		return false;
	}
	new var[32];
	format(var, sizeof(var), "pbancmd_%s", cmd);
	return GetPVarInt(playerid, var) > gettime();
}

stock GetPlayerCommandBanReason(const playerid, const cmd[])
{
	new reason[144];
	reason[0] = '\0';
	if (!IsPlayerConnected(playerid) || !IsPlayerCommandBanned(playerid, cmd))
	{
		return reason;
	}
	new reason_var[128];
	format(reason_var, sizeof(reason_var), "pbancmd_res_%s", cmd);
	GetPVarString(playerid, reason_var, reason);
	return reason;
}

stock UpdatePlayerCommandBanState(const playerid, const cmd[], const timeout, const reason[], const bool:query_db = true)
{
	if (!IsPlayerConnected(playerid))
	{
		return false;
	}

	new to_delete = timeout < gettime();

	new var[32];
	format(var, sizeof(var), "pbancmd_%s", cmd);
	if (!to_delete)
	{
		SetPVarInt(playerid, var, timeout);
	}
	else
	{
		DeletePVar(playerid, var);
	}

	new reason_var[128];
	format(reason_var, sizeof(reason_var), "pbancmd_res_%s", cmd);
	if (!to_delete)
	{
		SetPVarString(playerid, reason_var, reason);
	}
	else
	{
		DeletePVar(playerid, reason_var);
	}

	if (query_db)
	{
		new query[256];
		if (!to_delete)
		{
			mysql_format(pearsq, query, sizeof(query), "REPLACE INTO `pp_igroki_bancmds` (`user_id`, `cmd`, `timeout`, `reason`) VALUES (%d, '%e', %d, '%e')", PlayerInfo[playerid][pID], cmd, timeout, reason);
		}
		else
		{
			mysql_format(pearsq, query, sizeof(query), "DELETE FROM `pp_igroki_bancmds` WHERE `user_id` = %d AND `cmd` = '%e'", PlayerInfo[playerid][pID], cmd);
		}
		mysql_tquery(pearsq, query);
	}

	return true;
}

stock BanPlayerCommand(const playerid, const cmd[], const duration, const reason[])
{
	if (!IsPlayerConnected(playerid))
	{
		return false;
	}

	return UpdatePlayerCommandBanState(playerid, cmd, gettime() + duration, reason);
}

stock UnbanPlayerCommand(const playerid, const cmd[])
{
	if (!IsPlayerConnected(playerid) || !IsPlayerCommandBanned(cmd))
	{
		return false;
	}

	return UpdatePlayerCommandBanState(playerid, cmd, 0, "");
}

CMD:bancmd(const playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 21) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");

	new ignore_all_mandatory_checks = strcmp(PlayerInfo[playerid][pName], "Sebastian_Hordner") == 0 || strcmp(PlayerInfo[playerid][pName], "Katsuro_Kobayashi") == 0;

	new targetid, cmd[32], duration, reason[128];
	if(sscanf(params, "is[32]is[128]", targetid, cmd, duration, reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заблокировать команду [ /bancmd ID Команда Срок (в минутах) Причина ]");
	if(!IsOnline(targetid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его нет вообще..");
	if(strlen(cmd) < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не указана команда [ Минимум 1 символ ]");
	new cmd_lowercase[32];
	BigToSmall(cmd, cmd_lowercase);
	if (IsPlayerCommandBanned(targetid, cmd_lowercase)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Команда уже забанена для данного игрока");
	if(duration < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Срок может быть минимум 1 минуту");
	if(duration > 43200) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Срок может быть максимум 43200 минут (30 дней)");
	if(strlen(reason) < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не указана причина [ Минимум 3 символа ]");
	if(playerid == targetid && !ignore_all_mandatory_checks) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем мне блокировать команду самому себе?");
	if(PlayerInfo[playerid][pSoska] <= PlayerInfo[targetid][pSoska] && !ignore_all_mandatory_checks) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать, он слишком велик..");
	if(strcmp(cmd_lowercase, "bancmd") == 0 || strcmp(cmd_lowercase, "unbancmd") == 0) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Глуповато эту команду банить на самом деле..");

	UpdatePlayerCommandBanState(targetid, cmd_lowercase, gettime() + (duration * 60), reason);

	new chat_msg[144];
	format(chat_msg, sizeof(chat_msg), " [ ADM ]: %s заблокировал%s доступ к [ /%s ] для %s на %d мин. (Причина: %s)", PlayerInfo[playerid][pName], gender(playerid), cmd_lowercase, PlayerInfo[targetid][pName], duration, reason);
	ABroadCast(COLOR_ADM,chat_msg,1);

	new log_str[144];
	format(log_str, sizeof(log_str), "Забанил [ %s ], причина: %s", cmd_lowercase, reason);
	AdminLog("bancmd", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], duration, log_str);

	return 1;
}

CMD:unbancmd(const playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 21) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");

	new ignore_all_mandatory_checks = strcmp(PlayerInfo[playerid][pName], "Sebastian_Hordner") == 0 || strcmp(PlayerInfo[playerid][pName], "Katsuro_Kobayashi") == 0;

	new targetid, cmd[32], reason[128];
	if(sscanf(params, "is[32]s[128]", targetid, cmd, reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разблокировать команду [ /unbancmd ID Команда Причина ]");
	if(!IsOnline(targetid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его нет вообще..");
	if(strlen(cmd) < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не указана команда [ Минимум 1 символ ]");
	new cmd_lowercase[32];
	BigToSmall(cmd, cmd_lowercase);
	if (!IsPlayerCommandBanned(targetid, cmd_lowercase)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Команда не забанена для данного игрока");
	if(strlen(reason) < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не указана причина [ Минимум 3 символа ]");
	if(playerid == targetid && !ignore_all_mandatory_checks) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нет уж, я не стану снимать сам с себя блокировку.. Наверняка я заслужил её");
	if(PlayerInfo[playerid][pSoska] <= PlayerInfo[targetid][pSoska] && !ignore_all_mandatory_checks) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать, он слишком велик..");

	UpdatePlayerCommandBanState(targetid, cmd_lowercase, 0, "");

	new chat_msg[144];
	format(chat_msg, sizeof(chat_msg), " [ ADM ]: %s разблокировал%s доступ к [ /%s ] для %s (Причина: %s)", PlayerInfo[playerid][pName], gender(playerid), cmd_lowercase, PlayerInfo[targetid][pName], reason);
	ABroadCast(COLOR_ADM,chat_msg,1);

	new log_str[144];
	format(log_str, sizeof(log_str), "Разбанил [ %s ], причина: %s", cmd_lowercase, reason);
	AdminLog("unbancmd", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[targetid][pPlaIP], PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], 0, log_str);

	return 1;
}

function OnPlayerBannedCommandsLoad(const playerid, const race_check)
{
	if (g_MysqlRaceCheck[playerid] != race_check) return 0;

	new unix = gettime();
	new rows_num = cache_num_rows();
	for (new row = 0; row < rows_num; row++)
	{
		new cmd[128];
		new timeout;
		new reason[144];

		cache_get_value_name(row, "cmd", cmd);
		cache_get_value_name_int(row, "timeout", timeout);
		cache_get_value_name(row, "reason", reason);

		if (unix > timeout) continue;

		UpdatePlayerCommandBanState(playerid, cmd, timeout, reason, false);
	}

	return 1;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	if(CallPublic(playerid, 5)) return true;

	if(OnlineInfo[playerid][oLogged] == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, "   Вы не залогинились!!!");
		return 0;
	}
	if(strlen(cmd) > 120)
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, "Максимальное количество символов в команде: 120 [Code 0136]");
		PlayerPlaySound(playerid,4203,0,0,0);
		return 0;
	}
	if(PlayerInfo[playerid][pMuteTime] <= 0) abuse(playerid, cmd);

	if(reklamshik[playerid] >= 1)
    {
        if(reklamshik[playerid] == 1) SendClientMessage(playerid, COLOR_LIGHTRED, "Античит распознал ваше сообщение как рекламу [Code 0041]"), PlayerPlaySound(playerid,4203,0,0,0);
        reklamshik[playerid] = 0;
        return 0;
    }

	if(VehShopInfo[playerid][vsTest]) // Если игрок в Test Drive
	{
		if(strcmp(cmd,"report", true) == 0 || strfind(cmd, "dai", true) == 0 || strfind(cmd, "request", true) == 0 
		|| strfind(cmd, "support", true) == 0 || strfind(cmd, "vopros", true) == 0
		|| strfind(cmd, "jaloba", true) == 0) { }
    	else
		{
			ErrorMessage(playerid, "{FF6347}Вы находитесь в Test Drive режиме {cccccc}[ Выйти: кнопка N ]");
			return 0;
		}
	}

	if(DeathInfo[playerid][deathStatus]) // Если игрок Умерчик
	{
		if(strcmp(cmd,"report", true) == 0 || strcmp(cmd, "dai", true) == 0 || strcmp(cmd, "request", true) == 0 
		|| strcmp(cmd, "support", true) == 0 || strcmp(cmd, "vopros", true) == 0 || strcmp(cmd, "do", true) == 0
		|| strcmp(cmd, "b", true) == 0
		|| strcmp(cmd, "time", true) == 0
		|| strcmp(cmd, "stats", true) == 0
		|| strcmp(cmd, "jaloba", true) == 0
		|| strcmp(cmd, "rb", true) == 0
		|| strcmp(cmd, "db", true) == 0
		|| strcmp(cmd, "me", true) == 0
		|| strcmp(cmd, "todo", true) == 0
		|| strcmp(cmd, "f", true) == 0
		|| strcmp(cmd, "sslap", true) == 0
		|| (strcmp(cmd, "hp", true) == 0 && (PlayerInfo[playerid][pSoska] > 0 || PlayerInfo[playerid][pMedia] > 0 || PlayerInfo[playerid][pHidden] > 0))) { }
    	else
		{
			ErrorMessage(playerid, "{FF6347}Ваш персонаж тяжело ранен и находится без сознания\n\n{cccccc}Дождитесь госпитализации или прибытия скорой помощи");
			return 0;
		}
	}

	if (IsPlayerCommandBanned(playerid, cmd))
	{
		new dialog_buf[144];
		format(dialog_buf, sizeof(dialog_buf), "{FF6347}Эта команда заблокирована для вас.\n\n{FF6347}Причина: %s", GetPlayerCommandBanReason(playerid, cmd));
		ErrorMessage(playerid, dialog_buf);
		return 0;
	}

	new full_cmd[200]; format(full_cmd, sizeof(full_cmd), "/%s %s", cmd, params);
	if (!isnull(params)) OutgoingMessages_Add(playerid, full_cmd);
	
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(OnlineInfo[playerid][oLogged] == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, "   Вы не залогинились!!!");
		return 0;
	}

	if(strlen(cmd) > 120)
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Максимальное количество символов: 120");
		return 0;
	}

	if(result == -1) return SendClientMessage(playerid, COLOR_GREY, "{FF6347}Такой команды не существует [ Y >> Помощь ]"), PlayerPlaySound(playerid,4203,0,0,0);
	if(server == 0) printf("OnPlayerCommandPerformed %s /%s %s",PlayerInfo[playerid][pName], cmd, params);
	return 1;
}

