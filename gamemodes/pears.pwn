	case ADMIN_DIALOG_CHECKEVENTS:
	{
		if (!response) return 0;

		new dialog_text[1024];
		new type = ListParam[listitem][playerid];
		if (type == 1) { // Шахта
			new roomid = List[listitem][playerid];
			if (!MineWar_IsRoomExists(roomid)) return ErrorMessage(playerid, "{FF6347}Комната больше не существует");

			format(dialog_text, sizeof(dialog_text), "{cccccc}Текущая фаза: %d", _:MineWarInfo[roomid][mwWave] + 1);
			strcat(dialog_text, "\n\nСписок участников:\n");

			for (new i = 0; i < MAX_MINEWAR_PLAYERS; i++)
			{
				new currentid = MineWarInfo[roomid][mwPlayers][i] - 1;
				if (!IsOnline(currentid)) continue;

				format(dialog_text, sizeof(string),
					"%s{ff9000}%d. %s[%d]: {cccccc}%d/%d [DMG: %.2f]\n",
					
					dialog_text,
					i + 1,
					PlayerInfo[currentid][pName],
					currentid,
					MineWar_PlayerGetZombieKilled(currentid),
					MineWarPlayerInfo[currentid][mwpDeadCount],
					MineWarPlayerInfo[currentid][mwpDamage]
				);
			}
		} else if (type == 2) { // Гробница
			new roomid = List[listitem][playerid];
			if (!Tomb_IsRoomExists(roomid)) return ErrorMessage(playerid, "{FF6347}Комната больше не существует");

			format(dialog_text, sizeof(dialog_text), "{cccccc}Текущая фаза: %d", _:MineWarInfo[roomid][mwWave] + 1);
			strcat(dialog_text, "\n\nСписок участников:\n");

			for (new quan, i = 0; i < MAX_TOMB_PLAYERS; i++)
			{
				new currentid = TombInfo[roomid][tpPlayers][i] - 1;
				if (!IsOnline(currentid)) continue;

				format(dialog_text, sizeof(dialog_text),
					"%s{ff9000}%d. %s[%d]: {cccccc}%d/%d [DMG: %.2f]\n",
					
					dialog_text,
					++quan,
					PlayerInfo[currentid][pName],
					currentid,
					Tomb_PlayerGetMummyKilled(currentid),
					TombPlayerInfo[currentid][tpDeadCount],
					TombPlayerInfo[currentid][tpDamage]
				);
			}
		} else if (type == 3) { // Деревня
			if (!VillageInfo[villActive]) return ErrorMessage(playerid, "{FF6347}Сражение с деревенскими уже закончилось");
			format(dialog_text, sizeof(dialog_text), "{cccccc}Деревенских в живых: %d", sizeof(VillageNpcWalk) - GetQuanDeadVillageNpc());

			strcat(dialog_text, "\n\nСписок участников:\n");

			new quan;
			foreach (new currentid : VillagePlayer)
			{
				format(dialog_text, sizeof(dialog_text),
					"%s{ffcc00}%d. %s[%d]: {cccccc}%d убийств\n",

					dialog_text,
					++quan,
					PlayerInfo[currentid][pName],
					currentid,
					Village_Kills[currentid]
				);
			}
		}
		strcat(dialog_text, "\n");

		return ShowDialog(playerid, ADMIN_DIALOG_CHECKEVENTS_STATS, DIALOG_STYLE_MSGBOX, "{cccccc}Просмотр события", dialog_text, "Назад", "");
	}
