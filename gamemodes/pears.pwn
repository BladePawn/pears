CMD:allahakbar(playerid)
{
	if(PlayerInfo[playerid][pMember] == 18 || PlayerInfo[playerid][pLeader] == 18)
	{
		if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
		if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
		if(box[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я на ринге");
		if(HealthAC[playerid] <= 0) return 1;
		if(IsAPlayerInZone(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу взорвать тех, кто и так скоро умрёт [ Битва на территории ]");
		if(IsAAntidm(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это зелёная зона");
		if(get_invent4(playerid, 10, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет пояса со взрывчаткой");

		if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
		new string[128], Float:boomx, Float:boomy, Float:boomz, skolkosdohlo;
		skolkosdohlo -= 1;
		GetPlayerPos(playerid,boomx, boomy, boomz);
		CreateExplosion(boomx, boomy , boomz, 7, 40);
		ProxDetector(30.0, playerid, "Кто-то кричит: Allah Akbar!!",COLOR_WHITE,COLOR_WHITE,COLOR_WHITE,COLOR_FADE1,COLOR_FADE2);
		TakeInvent(playerid, 10, 1, 0, 999);
		new myw = GetPlayerVirtualWorld(playerid);
  		new myi = GetPlayerInterior(playerid);
        foreach (Player, i)
        {
            if(IsPlayerInRangeOfPoint(i,40.0, boomx, boomy, boomz) && gSpectateID[i] == INVALID_PLAYER_ID 
				&& GetPlayerVirtualWorld(i) == myw && GetPlayerInterior(i) == myi
				&& !DeathInfo[i][deathStatus])
			{
				skolkosdohlo += 1; ACSetPlayerHealth(i, 0);
			}
            if(GetPVarInt(i,"Readkill") == 1) SendDeathMessageToPlayer(i,INVALID_PLAYER_ID,playerid,47);
        }
        format(string, sizeof(string), RusToGame("~n~~n~~n~~n~~n~~n~~n~~r~Количество Убитых ~w~%d"),skolkosdohlo);
        GameTextForPlayer(playerid, string, 7000, 3);
        if(Tank[playerid] == 2) Tank[playerid] = 0;
    }
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не состою в Arabian Mafia");
	return 1;
}
