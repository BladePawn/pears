CMD:agetcar(playerid)
{
	new string[144];
	if(GetPVarInt(playerid,"antiflood") > 0) return format(string, sizeof(string), "[ Мысли ]: В гараже ещё нет свободного транспорта {ffcc00}[ Подождите %d сек. ]", GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY, string);
	if(GetPlayerVirtualWorld(playerid) != 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в другом виртуальном мире");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(IsPlayerInRangeOfPoint(playerid,20.0,113.4016,1869.1431,17.8416) || IsPlayerInRangeOfPoint(playerid,15.0,-1475.1090,285.7433,7.1875)) // ARMY
		{
			if(PlayerInfo[playerid][pMember] != 3 && PlayerInfo[playerid][pLeader] != 3) return ErrorMessage(playerid, "{FF6347}Эта техника доступна только бойцам национальной гвардии");
			ShowDialog(playerid,803,2,"{336633}Национальная Гвардия", "MRAP\nRhino","Выбрать","Выход");
		}
		else if(IsPlayerInRangeOfPoint(playerid,20.0,163.8405,1807.8495,17.7168) || IsPlayerInRangeOfPoint(playerid,15.0,-1288.6218,442.3888,7.2017)) // ARMY
		{
			if(PlayerInfo[playerid][pMember] != 3 && PlayerInfo[playerid][pLeader] != 3) return ErrorMessage(playerid, "{FF6347}Эта техника доступна только бойцам национальной гвардии");
			ShowDialog(playerid,803,2,"{336633}Национальная Гвардия", "Ford Crown Victoria\nJeep Wrangler\nFord Raptor\nChevrolet Tahoe","Выбрать","Выход");
		}
		else if(IsPlayerInRangeOfPoint(playerid,20.0,-2068.3184,-2349.8933,30.6250))
		{
		  ShowDialog(playerid,794,2,"{FFFFFF}* {ff9000}Аренда Грузового Транспорта {FFFFFF}*", "{cccccc}Грузовик {ff9000}Industrial {00cc00}800$\n{cccccc}Погрузчик {ff9000}Forklift {00cc00}300$","Выбрать","Выход");
		}
		else if(IsPlayerInRangeOfPoint(playerid,20.0,-2773.5625,420.3117,-4.1108))
		{
			if(PlayerInfo[playerid][pMember] != 7 && PlayerInfo[playerid][pLeader] != 7) return ErrorMessage(playerid, "{FF6347}Эта техника доступна только сотрудникам Правительства");
			ShowDialog(playerid,803,2,"{ffffff}Транспорт Правительства", "Wayfarer\nManana\nWashington\nMerit\nRancher\nStretch\nSecuricar\nTowtruck","Выбрать","Выход");
		}
		else if(IsPlayerInRangeOfPoint(playerid,8.0,1378.3542,-1154.9231,23.8330))
		{
		  if(PlayerInfo[playerid][pMember] == 9 || PlayerInfo[playerid][pLeader] == 9) return ShowDialog(playerid,803,2,"{ffcc66}Транспорт CNN", "Chevrolet Tahoe\nAlfa-Romeo 159 Ti\nCadillac Escalade SA News","Выбрать","Выход");
		}
		else if(IsPlayerInRangeOfPoint(playerid,20.0,2509.7715,2512.8291,10.8203))
		{
		  if(PlayerInfo[playerid][pMember] != 1 && PlayerInfo[playerid][pLeader] != 1) return ErrorMessage(playerid, "{FF6347}Эта техника доступна только сотрудникам SAPD");
		  ShowDialog(playerid,803,2,"{191970}Транспорт SAPD", "HPV 1000\nNRG-500\nSultan\nSecuricar\nEnforcer\nAPC\nSWAT\nTowtruck","Выбрать","Выход");
		}
	}
	else ErrorMessage(playerid, "{FF6347}Вы можете арендовать транспорт только пешком");
	return 1;
}

stock ExtractRentCar(playerid, sl)
{
	new b = PlayerInfo[playerid][pRentBiz][sl];
	if(b > 0)
	{
		DP[1][playerid] = sl;
		new nearrent, minb, maxb, model = PlayerInfo[playerid][pRentModel][sl], thisterm, thisb;
		if(model == 462) minb = 16, maxb = 26;
		else if(IsAMoto(model) && model != 462) minb = 11, maxb = 16;
		else if(IsACar(model) && model != 462) minb = 0, maxb = 11;
		else return ErrorMessage(playerid, "{FF6347}Вы не можете вызвать этот транспорт {cccccc}[Только: Найти транспорт]\n\n{FF6347}Внимание! Вызывать можно только автомобили, мотоциклы и скутеры");
		
		if(check_lic(playerid, model) == 0) return 0;

		new v = PlayerInfo[playerid][pRentVeh][sl];
		// Если мы стоим у терминала (Создаём транспорт как саму аренду прямо перед терминалом)
		if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0)
		{
			for(new br = minb; br < maxb; br++)
			{
				for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
				{
					if(RentStat[br][i] <= 0) continue;
					if(IsPlayerInRangeOfPoint(playerid, 6.0, RentPos_X[br][i], RentPos_Y[br][i], RentPos_Z[br][i]))
					{
						nearrent = 1, thisterm = i, thisb = br;
						break;
					}
				}
			}
		}
		new relb = rentnumn(thisb);
		if(nearrent == 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от терминала аренды\n\nЧтобы вызвать транспорт, вы должны находиться рядом с\nтерминалом, в котором можно этот транспорт арендовать");
		if(VehInfo[v][vModel] == 0 || VehInfo[v][vAgetid] != playerid || VehInfo[v][vModel] != PlayerInfo[playerid][pRentModel][sl]) // Транспорта нет - придётся создать
		{
			DP[2][playerid] = thisterm;
			DP[3][playerid] = relb;
			find_reloadrentveh(playerid, thisterm, relb);
		}
		else
		{
			//new Float:vpos[3];
			//GetVehiclePos(v, vpos[0], vpos[1], vpos[2]);
			//if(IsPlayerInRangeOfPoint(playerid,20.0, vpos[0], vpos[1], vpos[2])) return ErrorMessage(playerid, "{FF6347}Арендованный транспорт рядом с вами{cccccc}\n[Выберите пункт: Найти транспорт]");
			if(CarRespawn(playerid, v)) return ErrorMessage(playerid, "{FF6347}В вашем транспорте кто-то сидит\n{cccccc}[ Нельзя вызвать, это будет считаться телепортом игрока ]");
			if(IsTrailerAttachedToVehicle(v)) return ErrorMessage(playerid, "{FF6347}Нельзя вызвать транспорт с прицепом");
			new Float:pos[4];
			getcreateterm(relb, thisterm, pos[0], pos[1], pos[2], pos[3]);
			ACSetVehiclePos(v,pos[0], pos[1], pos[2]), SetVehicleZAngle(v,pos[3]);
			Protect_PutPlayerInVehicle(playerid, v, 0);
		}

	}
	else ErrorMessage(playerid, "{FF6347}Вы не можете вызвать этот транспорт {cccccc}[Только: Найти транспорт]\n\n{FF6347}Внимание!\nВызывать можно только автомобили, мотоциклы и скутеры");
	return 1;
}

stock AlreadyRentCar(playerid, slot, b)
{
	new unix = gettime();
	if(PlayerInfo[playerid][pRent][slot] > unix)
	{
		new model = PlayerInfo[playerid][pRentModel][slot];
		if(IsAScooter(model) && b >= 67 && b <= 76 // Аренда Скутеров
			|| IsACar(model) 
				&& (model == 410 || model == 401 || model == 479 || model == 516 || model == 547)
				&& b >= 42 && b <= 52 // Аренда Автомобилей
			|| IsAMoto(model) && b >= 62 && b <= 66 && !IsAScooter(model)) // Аренда Мотоциклов
		{
			List[slot][playerid] = 1;
			return 1;
		}
	}
	List[slot][playerid] = 0;
	return 0;
}

stock ARentCar(playerid, br, term)
{
	DP[0][playerid] = rentnumn(br), DP[1][playerid] = br, DP[2][playerid] = term;
	new b = DP[0][playerid];
    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
    if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	PlayerPlaySound(playerid,40405,0,0,0);

	new str[100],sctring[900], tyear, tmonth, tday, thour, tminute, tsecond;

	if(b >= 42 && b <= 52 || b >= 62 && b <= 66 || b >= 67 && b <= 76)
	{
		format(str,sizeof(str),"Транспорт\tВ наличии\tСтоимость Аренды\tВремя Аренды"), strcat(sctring,str);
		if(AlreadyRentCar(playerid, 0, b))
		{
			stamp2datetime(PlayerInfo[playerid][pRent][0], tyear, tmonth, tday, thour, tminute, tsecond, 3);
			format(str,sizeof(str),"\n{0088ff}%s\t{cccccc}Аренда до %02d:%02d\t \t ", GetVehicleName(PlayerInfo[playerid][pRentModel][0]), thour, tminute), strcat(sctring,str);
		}
		if(AlreadyRentCar(playerid, 1, b))
		{
			stamp2datetime(PlayerInfo[playerid][pRent][1], tyear, tmonth, tday, thour, tminute, tsecond, 3);
			format(str,sizeof(str),"\n{0088ff}%s\t{cccccc}Аренда до %02d:%02d\t \t ", GetVehicleName(PlayerInfo[playerid][pRentModel][1]), thour, tminute), strcat(sctring,str);
		}
	}
	if(b >= 42 && b <= 52) // Аренда Автомобилей
	{
	   	format(str,sizeof(str),"\n{ff9000}Manana\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][0]-BizzInfo[b][bUseItem][0],BizzInfo[b][bPrice][0]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Bravura\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][1]-BizzInfo[b][bUseItem][1],BizzInfo[b][bPrice][1]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Regina\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][2]-BizzInfo[b][bUseItem][2],BizzInfo[b][bPrice][2]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Nebula\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][3]-BizzInfo[b][bUseItem][3],BizzInfo[b][bPrice][3]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Primo\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][4]-BizzInfo[b][bUseItem][4],BizzInfo[b][bPrice][4]), strcat(sctring,str);
		ShowDialog(playerid,1173,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Аренда Автомобилей",sctring,"Выбрать","Выход"); // 1157
	}
	else if(b >= 62 && b <= 66) // Аренда Мотоциклов
	{
	   	format(str,sizeof(str),"\n{ff9000}PCJ-600\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][0]-BizzInfo[b][bUseItem][0],BizzInfo[b][bPrice][0]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Sanchez\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][1]-BizzInfo[b][bUseItem][1],BizzInfo[b][bPrice][1]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Quad\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][2]-BizzInfo[b][bUseItem][2],BizzInfo[b][bPrice][2]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}BF-400\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][3]-BizzInfo[b][bUseItem][3],BizzInfo[b][bPrice][3]), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Wayfarer\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][4]-BizzInfo[b][bUseItem][4],BizzInfo[b][bPrice][4]), strcat(sctring,str);
		ShowDialog(playerid,1173,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Аренда Мото",sctring,"Выбрать","Выход"); // 1157
	}
	else if(b >= 67 && b <= 76) // Аренда Скутеров
	{
		if(PlayerInfo[playerid][pConnectTime] < 3 && DP[4][playerid] == 462)
		{
			format(str,sizeof(str),"\n{ff9000}Faggio\t{cccccc}%d\t{99ff66}Бесплатно до 3-ёх часов в игре\t{cccccc}1 Час",BizzInfo[b][bItem][0]-BizzInfo[b][bUseItem][0]), strcat(sctring,str);
		}
	   	else format(str,sizeof(str),"\n{ff9000}Faggio\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][0]-BizzInfo[b][bUseItem][0],BizzInfo[b][bPrice][0]), strcat(sctring,str);
		ShowDialog(playerid,1173,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Аренда Скутеров",sctring,"Выбрать","Выход"); // 1157
	}
	else if(b >= 153 && b <= 162)
	{
		ApplyDynamicActorAnimation(BizTermActor[GetBizTermActorId(b)][term], "PED","endchat_03",4.0, false, true, true, false, false); // Машет рукой

		DP[0][playerid] = b;
		format(str,sizeof(str),"Товар\tСтоимость"), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff9000}Хот-Дог\t{99ff66}%d$",BizzInfo[b][bPrice][0]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Sprunk\t{99ff66}%d$",BizzInfo[b][bPrice][1]), strcat(sctring,str);
		ShowDialog(playerid,648,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Ларек с едой",sctring,"Выбрать","Выход"); // 1157
	}
	return 1;
}
stock ATM(playerid, br, term)
{
	DP[0][playerid] = rentnumn(br), DP[1][playerid] = br, DP[2][playerid] = term;
	new b = DP[0][playerid];
    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
    if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	PlayerPlaySound(playerid,40405,0,0,0);
   	new str[86],sctring[774];
	if(b >= 163 && b <= 172) // Прайс Банкоматов
	{
		new minb = GetBizMin(19);
   		format(str,sizeof(str),"{cccccc}Баланс: {99ff66}%d$ {cccccc}[%s] \t ", PlayerInfo[playerid][pAccount], get_k(PlayerInfo[playerid][pAccount])), strcat(sctring,str);
   		format(str,sizeof(str),"\n{99ff66}Положить {cccccc}Деньги \t {cccccc}Комиссия: %.3f", comput[b-minb]), strcat(sctring,str);
   		format(str,sizeof(str),"\n{FF6347}Снять {cccccc}Деньги \t {cccccc}Комиссия: %.3f", comtake[b-minb]), strcat(sctring,str);
   		format(str,sizeof(str),"\n{cccccc}Мобильный Счет \t {ffcc00}%d$", PlayerInfo[playerid][pTraderPerk]), strcat(sctring,str);
   		format(str,sizeof(str),"\n{cccccc}Оплатить Штрафы \t {FF6347}%d$", PlayerInfo[playerid][pAmmos11]), strcat(sctring,str);
		if(GetPVarInt(playerid,"job_collector") == b && GetPVarInt(playerid,"job_collector_term") == term && GetPVarInt(playerid,"job_collector_status") == 1) 
		{
			format(str,sizeof(str),"\n{cccccc}[Инкассатор] Снять деньги \t {99ff66}%d$", BizzInfo[b][bItem][term]), strcat(sctring,str);
		}
   		ShowDialog(playerid,1175,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Банкомат",sctring,"Выбрать","Выход"); // 1157
	}
	return 1;
}
CMD:agetmars(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,3.0,1350.9169,2497.5452,1457.2476) && GetPlayerInterior(playerid) == 222 && GetPlayerVirtualWorld(playerid) == 222 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ShowDialog(playerid,1130,DIALOG_STYLE_MSGBOX,"{ff9000}Mars Rover","\n{ffcc66}Вы уверены, что хотите взять из гаража марсоход?\n","Да","Нет");
	return 1;
}
CMD:agettrash(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,3.0,1620.2490,-1886.5011,13.5469) || IsPlayerInRangeOfPoint(playerid,3.0,-1872.2382,-201.4035,18.3897) || IsPlayerInRangeOfPoint(playerid,3.0,1023.4157,2216.5103,10.8203))
	{
		ShowDialog(playerid,1137,2,"{ff9000}Транспорт Клининговой Службы", "Trashmaster (Мусоровоз)\nSweeper (Мойщик)","Выбрать","Выход");
  	}
	return 1;
}

stock ShowDialogMenuBuyBiz(playerid, b)
{
	if(b <= 0 || b > MAX_BIZ) return 1;

    new line[300],lines[900];
	format(line,sizeof(line),"{cccccc}Статистика Дохода {99ff66}>>"), strcat(lines,line);
	if(BizzInfo[b][bSost] >= 1)
	{
		if(BizzInfo[b][bSell] >= 1)
		{
			format(line,sizeof(line),"\n{cccccc}Купить за {99ff66}%d$ {cccccc}(%s)", BizzInfo[b][bSell], get_k(BizzInfo[b][bSell])), strcat(lines,line);
		}
		else format(line,sizeof(line),"\n{FF6347}Бизнес не продаётся"), strcat(lines,line);
	}
	else
	{
		format(line,sizeof(line),"\n{cccccc}Купить за {99ff66}%d$ {cccccc}(%s) (гос. цена)", biz_cena(b), get_k(biz_cena(b))), strcat(lines,line);
		if(BizzInfo[b][bGold]> 0) format(line,sizeof(line),"\n{cccccc}Купить за {ffcc00}%dG", BizzInfo[b][bGold]), strcat(lines,line);
	}
	format(line,sizeof(line),"{ff9000}Бизнес № %d %s", b, bizname(b));
  	ShowDialog(playerid,983,DIALOG_STYLE_TABLIST, line, lines, "Выбор", "Выход");
	return 1;
}

CMD:buybiz(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 2.0, -1752.9893,883.6321,105.0207) && GetPlayerVirtualWorld(playerid) == 236 && GetPlayerInterior(playerid) == 0)
	{
		// Считаем бизнесы по типам
		new bizQuan[MAX_BIZ_TYPE], bizTypeId;
		for(new b = 1; b < sizeof(BizzInfo); b++)
		{
			if(b == 196) continue; // Пропускаем один сервис авиа и один сервис катеров
			if(BizzInfo[b][bSost] == 0 || BizzInfo[b][bSell] >= 1) // Бизнесы на продаже
			{
				bizTypeId = BizType(b);
				bizQuan[bizTypeId] ++;
  			}
  		}

		// Выводим список
		new quan;
		new line[70],lines[2100];
		format(line,sizeof(line),"Бизнес \t На продаже\n"), strcat(lines,line);
		for(new t = 0; t < MAX_BIZ_TYPE; t++)
		{
			if(t == 14) continue; // Пропускаем рестораны (Их нельзя купить, они передаются первому лидеру мафий)
			List[quan][playerid] = t;
			quan ++;
			format(line,sizeof(line),"{cccccc}%s \t {99ff66}%d\n", biznameType(t), bizQuan[t]), strcat(lines,line);
		}
		ShowDialog(playerid,985,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Бизнес Центр", lines,"Выбрать","Выход");
	}
	return 1;
}

stock ShowMenuTypeBuyBiz(playerid, type)
{
	new minB, maxB;
	bizTypeMin(type, minB, maxB); // Получаем минимальный и максимальный id бизнеса этого типа

	DP[1][playerid] = type;
	
	new quan;
	new line[214],lines[4096];
	for(new i = 0; i < 200; i++) List[i][playerid] = 0; // Очищаем List

	for(new b = minB; b <= maxB; b++)
	{
		if(b == 196) continue; // Пропускаем один сервис авиа и один сервис катеров
		List[quan][playerid] = b;
		quan ++;
		if(BizzInfo[b][bLevel] >= 50) format(line,sizeof(line),"{ff9000}[№ %d] \t {444444}Зарезервирован Администрацией \t \t %s\n",b, cityName[BizzInfo[b][bCity]]), strcat(lines,line);
		else
		{
			if(BizzInfo[b][bSost] == 0) format(line,sizeof(line),"{ff9000}[№ %d] {cccccc}Гос. Цена \t {99ff66}[%d$][%s] \t {ffcc00}%dG \t %s\n",b, biz_cena(b), get_k(biz_cena(b)), BizzInfo[b][bGold], cityName[BizzInfo[b][bCity]]), strcat(lines,line);
			else if(BizzInfo[b][bSost] >= 1)
			{
				if(BizzInfo[b][bSell] >= 1) format(line,sizeof(line),"{ff9000}[№ %d] {cccccc}Владелец: %s \t {99ff66}[%d$][%s] \t \t %s\n",b ,BizzInfo[b][bVlad], BizzInfo[b][bSell], get_k(BizzInfo[b][bSell]), cityName[BizzInfo[b][bCity]]), strcat(lines,line);
				else if(BizzInfo[b][bSell] == 0) format(line,sizeof(line),"{ff9000}[№ %d] {cccccc}Владелец: %s \t {FF6347}[Не продаётся] \t \t %s\n",b ,BizzInfo[b][bVlad], cityName[BizzInfo[b][bCity]]), strcat(lines,line);
			}
		}
	}
	format(line,sizeof(line),"{cccccc}Бизнес {ff9000}%s",bizname(minB));
	ShowDialog(playerid,986,DIALOG_STYLE_TABLIST, line, lines,"Выбрать","Назад");
	return 1;
}
CMD:rboot(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Очистить багажник в транспорте [ /rboot VehID ]");
	if(params[0] <= -1 || params[0] >= 2000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: ID транспорта не меньше 0 и не больше 1999");
	if(params[0] != INVALID_VEHICLE_ID)
 	{
		new string[128];
		new model = VehInfo[params[0]][vModel];
		format(string, sizeof(string), " [ ADM ]: %s[%d] очистил багажник транспорта %s[%d]", PlayerInfo[playerid][pName],playerid,GetVehicleName(model),params[0]);
    	ABroadCast(COLOR_ADM,string,2);
		ClearBootVehicleAll(params[0]);
    	SaveBoot(params[0]);
	}
	else SendClientMessage(playerid, COLOR_GRAD5, "[ Мысли ]: Этого транспорта не существует");
	return 1;
}
CMD:rmarket(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Очистить товары игроку [ /rmarket ID ]");
	if(IsOnline(params[0]))
	{
		new string[128];
		format(string, sizeof(string), " [ ADM ]: %s[%d] очистил товары %s[%d]", PlayerInfo[playerid][pName],playerid,PlayerInfo[params[0]][pName],params[0]);
    	ABroadCast(COLOR_ADM,string,2);
		format(string, sizeof(string), "* Администратор %s очистил ваши товары.", PlayerInfo[playerid][pName]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
    	if(OnlineInfo[params[0]][oShowInterface] == 1) CloseFrisk(params[0]), CancelSelectTextDraw(params[0]);
		for(new i = 0; i < 20; i ++) ClearMyGoods(params[0], i);
    	SaveMarkAll(params[0]);
	}
	else SendClientMessage(playerid, COLOR_GRAD5, "[ Мысли ]: Его вообще нет..");
	return 1;
}
CMD:rinvent(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Очистить инвентарь игроку [ /rinvent ID ]");
	if(IsOnline(params[0]))
	{
		new string[128];
		format(string, sizeof(string), " [ ADM ]: %s[%d] очистил инвентарь %s[%d]", PlayerInfo[playerid][pName],playerid,PlayerInfo[params[0]][pName],params[0]);
    	ABroadCast(COLOR_ADM,string,2);
		format(string, sizeof(string), "* Администратор %s очистил ваш инвентарь.", PlayerInfo[playerid][pName]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
    	if(OnlineInfo[params[0]][oShowInterface] == 1) CloseFrisk(params[0]), CancelSelectTextDraw(params[0]);
		for(new i = 0; i < 40; i ++) ClearPlayerInven(params[0], i);
		SaveInventAll(params[0]);
	}
	else SendClientMessage(playerid, COLOR_GRAD5, "[ Мысли ]: Его вообще нет..");
	return 1;
}
CMD:givebiz(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
    new string[144], playa, tmp[24];
	if(sscanf(params, "s[24]i", tmp,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать бизнес игроку [ /givebiz ID Номер Бизнеса ]");
	if(params[1] > 200 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");
	if(BizzInfo[params[1]][bSost] >= 1) return SendClientMessage(playerid, COLOR_GRAD5, "[ Мысли ]: Этот бизнес занят [ /asellbiz ]");
	playa = ReturnUser(tmp, 1);
	if(IsOnline(playa))
	{
		format(string, sizeof(string), "{0088ff}Вы выдали {FFFFFF}%s {ff9000}Бизнес %s № %d",PlayerInfo[playa][pName], bizname(params[1]),params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		PlayerInfo[playa][pBusiness] = params[1];
		new akka = PlayerInfo[playa][pID];
		BizzInfo[params[1]][bPastime] = 0;
		BizzInfo[params[1]][bData] = gettime()+2592000;
		BizzInfo[params[1]][bSost] = akka;
		BizzInfo[params[1]][bSell] = 0;
		if(BizzInfo[params[1]][bFam] >= 1)
	 	{
	 		if(FamilyInfo[BizzInfo[params[1]][bFam]][fSost] >= 1) famdeat_biz(BizzInfo[params[1]][bFam], params[1]), SaveFamily(BizzInfo[params[1]][bFam]);
			BizzInfo[params[1]][bFam] = 0;
		}
		BizzInfo[params[1]][bInterval] = 0;
		bizsbrosprava(params[1]);
		strmid(BizzInfo[params[1]][bVlad], PlayerInfo[playa][pName], 0, strlen(PlayerInfo[playa][pName]), 24);
		if(BizzInfo[params[1]][bLab] == 1) UpdateBizLabel(params[1], BizzInfo[params[1]][bLab]);
		SaveBizz(params[1]);
		PlayerPlaySound(playa, 1052, 0.0, 0.0, 0.0);
		format(string, sizeof(string),"{0088ff}* [! ! !]: {FFFFFF}Администратор выдал вам Бизнес %s № %d {0088ff}[ N >> Ноутбук >> Бизнес ]",bizname(params[1]),params[1]);
		ShowDialog(playa,1700, 0, "{0088ff}*** {ffffff}  Установка Бизнеса {0088ff}***", string, "Ок", "");
		format(string, sizeof(string), "{0088ff}* [! ! !]: {FFFFFF}Администратор выдал вам Бизнес %s № %d {0088ff}[ N >> Ноутбук >> Бизнес ]",bizname(params[1]),params[1]);
		SendClientMessage(playa, COLOR_LIGHTBLUE, string);
		BizLog("givebiz", PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], params[1], 0, "Получил от Администратора");
		AdminLog("givebiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], params[1], "Выдал бизнес");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Account, Money, Ammo1 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_setmoney", "ddsd", playerid, params[1],tmp,9);
	}
	return 1;
}
CMD:givedom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
    new string[144], playa, tmp[24];
	if(sscanf(params, "s[24]i", tmp,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать дом игроку [ /givedom ID Номер Дома ]");
	if(params[1] > 1000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(DomInfo[params[1]][dSost] >= 1) return SendClientMessage(playerid, COLOR_GRAD5, "[ Мысли ]: Этот дом занят [ /aselldom ]");
	playa = ReturnUser(tmp, 1);
	if(IsOnline(playa))
	{
		format(string, sizeof(string), "{0088ff}Вы установили {FFFFFF}%s {ff9000}Дом № %d",PlayerInfo[playa][pName],params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		PlayerInfo[playa][pDom] = params[1];
		PlayerInfo[playa][pHouserent] = 0;
		new akka = PlayerInfo[playa][pID];
		DomInfo[params[1]][dPastime] = 0;
		DomInfo[params[1]][dData] = gettime()+2592000;
		DomInfo[params[1]][dSost] = akka;
		strmid(DomInfo[params[1]][dVlad], PlayerInfo[playa][pName], 0, strlen(PlayerInfo[playa][pName]));
		SaveDom(params[1]);
		UpdateDom(params[1]);
		PlayerInfo[playa][pSelectspawn] = 4;
		PlayerPlaySound(playa, 1052, 0.0, 0.0, 0.0);
		format(string, sizeof(string),"{0088ff}* [! ! !]: {FFFFFF}Администратор установил вам Дом № %d {0088ff}[ /mydom ]",params[1]);
		ShowDialog(playa,1700, 0, "{0088ff}*** {ffffff}  Установка Дома {0088ff}***", string, "Ок", "");
		format(string, sizeof(string), "{0088ff}* [! ! !]: {FFFFFF}Администратор установил вам Дом № %d {0088ff}[ /mydom ]",params[1]);
		SendClientMessage(playa, COLOR_LIGHTBLUE, string);
		AdminLog("givedom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], params[1], "Выдал Дом");
		new qwer[34];
		format(qwer, sizeof(qwer),"Выдал дом %s", PlayerInfo[playa][pName]);
		HouseLog(0, "givedom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[1], 0, qwer);
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Account, Money, Ammo1 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_setmoney", "ddsd", playerid, params[1],tmp,7);
	}
	return 1;
}
CMD:unrentwh(playerid)
{
	new g = PlayerInfo[playerid][pLeader], yes;
	if(g == 0 && PlayerInfo[playerid][pSoska] < 15) return ErrorMessage(playerid, "{FF6347}Только лидер или администратор может отменить аренду склада");
	if((g == 5 || g == 6 || g == 8 || g == 10 || g >= 12 && g <= 20) || PlayerInfo[playerid][pSoska] >= 15)
	{
		new string[144];
		for(new r = 0; r < sizeof(WhInfo); r++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 2.0, WhPos[r][WhPos_X], WhPos[r][WhPos_Y], WhPos[r][WhPos_Z]))
			{
				if(WhInfo[r][wStat] != g && PlayerInfo[playerid][pSoska] < 15) return ErrorMessage(playerid, "{FF6347}Этот склад не принадлежит вашей организации");
				if(WhInfo[r][wStat] == 0) return ErrorMessage(playerid, "{FF6347}Этот склад не принадлежит ни одной организации");
				if(PlayerInfo[playerid][pSoska] >= 15) g = WhInfo[r][wStat];
				WhInfo[r][wStat] = 0;
				UpdateRent(r);
				Streamer_Update(playerid, STREAMER_TYPE_3D_TEXT_LABEL);
				mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_rentwh` SET `Stat` = '0' WHERE `Ids` = '%d'", r);
				query_empty(pearsq, string);
				format(string,sizeof(string),"** {FF6347}%s отменил аренду склада № %d", PlayerInfo[playerid][pName], r+1), SendRadioMessage(g, COLOR_GREY, string);
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я отменил%s {FF6347}аренду {cccccc}этого склада", gender(playerid));
				OrgLog(g, "unrentwh", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", r+1, "");
				yes = 1;
				PlayerPlaySound(playerid,6801,0,0,0);
			}
		}
		if(yes == 0) ErrorMessage(playerid, "{FF6347}Вы далеко от своего склада");
	}
	else ErrorMessage(playerid, "{FF6347}У вашей организации не может быть арендованного склада");
	return 1;
}
CMD:rentwh(playerid)
{
	new g = PlayerInfo[playerid][pLeader], yes;
	if(g == 0) return ErrorMessage(playerid, "{FF6347}Только лидер может арендовать склад");
	if(g == 5 || g == 6 || g == 8 || g == 10 || g >= 12 && g <= 20)
	{
		new string[144];
		for(new rg = 0; rg < sizeof(WhInfo); rg++)
		{
			if(WhInfo[rg][wStat] == g) return ErrorMessage(playerid, "{FF6347}У вашей организации уже есть арендованный склад [ /unrentwh - отменить аренду ]");
		}
		for(new r = 0; r < sizeof(WhInfo); r++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 2.0, WhPos[r][WhPos_X], WhPos[r][WhPos_Y], WhPos[r][WhPos_Z]))
			{
				if(WhInfo[r][wStat] >= 1) return format(string, sizeof(string), "[ Мысли ]: Этот склад принадлежит %s",frakName[WhInfo[r][wStat]]), SendClientMessage(playerid, COLOR_GREY, string);
				WhInfo[r][wStat] = g;
				UpdateRent(r);
				Streamer_Update(playerid, STREAMER_TYPE_3D_TEXT_LABEL);
				mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_rentwh` SET `Stat` = '%d' WHERE `Ids` = '%d'",g, r);
				query_empty(pearsq, string);
				format(string,sizeof(string),"** {FF6347}%s арендовал склад № %d", PlayerInfo[playerid][pName], r+1), SendRadioMessage(g, COLOR_GREY, string);
				if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {ff9000}арендовал {cccccc}этот склад");
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {ff9000}арендовал {cccccc}этот склад");
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Стоимость аренды [ {99ff66}2.000$ {cccccc}] в час {ff9000}[ Со счёта организации ]");
				OrgLog(g, "rentwh", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", r+1, "");
				yes = 1;
				PlayerPlaySound(playerid,6401,0,0,0);
			}
		}
		if(yes == 0) ErrorMessage(playerid, "{FF6347}Вы далеко от склада");
	}
	else ErrorMessage(playerid, "{FF6347}У вашей организации не может быть арендованного склада");
	return 1;
}

CMD:unrent(playerid, const params[])
{
	if(PlayerInfo[playerid][pHouserent] != 0)
	{
	  new nd = PlayerInfo[playerid][pHouserent];
	  DomInfo[nd][dLodger] -= 1;
   	  SaveDom(nd);
	  PlayerInfo[playerid][pHouserent] = 0;
	  mysql_save(playerid, 25);
	  if(PlayerInfo[playerid][pSex] == 2)SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я выселилась из арендованного жилья");
      if(PlayerInfo[playerid][pSex] == 1)SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я выселился из арендованного жилья");
    }
    else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я ни у кого не проживаю");
	return 1;
}
CMD:checkgarage(playerid, const params[])
{
	if (PlayerInfo[playerid][pSoska] >= 3)
	{
		for(new h = 0; h < sizeof(DomInfo); h++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 2.0, DomInfo[h][dGarageX], DomInfo[h][dGarageY], DomInfo[h][dGarageZ]) && DomInfo[h][dIngar] >= 1)
			{
				new string[128];
				format(string,sizeof(string),"{cccccc}[ ADM ]: Гараж дома № {0088ff}%d {ff9000}[ /setgarage - изменить позицию]",h);
      			SendClientMessage(playerid,COLOR_GREY,string);
      			PlayerPlaySound(playerid,40405,0,0,0);
			}
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
CMD:setgarage(playerid, const params[])
{
    new hous,string[128];
    if (!sscanf(params, "i",hous))
	{
		if (PlayerInfo[playerid][pSoska] >= 3)
		{
		    if(hous >= 1001) return 1;
			if(DomInfo[hous][dIngar] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме не установлен гараж");
			format(string, sizeof(string), "{00FF36}** {0088ff}[ADM]: {ffffff}Дому №: %d Изменёна позиция гаража.", hous);
			SendClientMessage(playerid, COLOR_WHITE, string);
			new Float:obx, Float:oby, Float:obz;
   			GetPlayerPos(playerid,obx, oby, obz);
      		DomInfo[hous][dGarageX] = obx;
        	DomInfo[hous][dGarageY] = oby;
        	DomInfo[hous][dGarageZ] = obz;
        	GameTextForPlayer(playerid, RusToGame("~w~Гараж Перемещён"), 1200, 3);
        	SaveDom(hous);
        	UpdateDom(hous);
        	PlayerPlaySound(playerid,40405,0,0,0);
			return 1;
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить положение гаража [ /setgarage Номер Дома ]");
	return 1;
}

stock SetNumberOfferShow(copid, playerid, price, const number[]) {
	DP[0][playerid] = price;
	DP[1][playerid] = copid;
	DP[2][playerid] = PlayerInfo[copid][pID];
	format(ListName[playerid], 64, "%s", number);

	PlayerPlaySound(playerid, 40405, 0, 0, 0);

	new string[190];
	format(string, sizeof(string), "{cccccc}Вам предлагают сменить номерные знаки на личном транспорте\n\nСтоимость: {99ff66}%d$\n{cccccc}Новые номерные знаки: {ff9000}%s\n\n{cccccc}Вы согласны ?", price, number);
	ShowDialog(playerid, 500, DIALOG_STYLE_MSGBOX, "Номерные Знаки", string, "Да", "Отмена");

	return 1;
}

stock SetNumberOfferDecline(playerid) {
	new copid = DP[1][playerid];
	new g = fraction(copid);
	new bool: is_still_cop = (g > 0 && IsPoliceMember(copid) && DP[2][playerid] == PlayerInfo[copid][pID]);
	if (!is_still_cop) return 0;

	new string[128];
	format(string, sizeof(string), "{FF6347}%s[%d] отказался от установки автомобильных номеров: {ff9000}[ %s ]", rpplayername(playerid), playerid, ListName[playerid]);
	ErrorMessage(copid, string);

	return 1;
}

stock SetNumberChooseCarShow(playerid) {
	new line[130], lines[2730];

	format(line,sizeof(line),"{cccccc}Загруженные транспортные средства\t "), strcat(lines,line);
	new quan;
	for(new i = 0; i < MAX_MYVEHICLE; i++)
	{
		List[i][playerid] = 0; // Очищаем листы
		if(PlayerInfo[playerid][pMyVeh][i] > 0)
		{
			if(PlayerInfo[playerid][pMyVehID][i] > 0)
			{
				List[quan][playerid] = i;
				format(line,sizeof(line),"\n{ff9000}%d. %s \t {cccccc}[ID %d]", i + 1, GetVehicleName(PlayerInfo[playerid][pMyVeh][i]), PlayerInfo[playerid][pMyVehID][i]), strcat(lines,line);
				quan ++;
			}
		}
	}
	ShowDialog(playerid, 501, DIALOG_STYLE_TABLIST_HEADERS, "{ff9000}Номерные знаки", lines, "Выбрать", "Отмена");

	return 1;
}

CMD:numbercar(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(28, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не полицейский");
	if(!GetAccessRankOrg(playerid, g, 28, NO_FBI)) return 1;
	if(sscanf(params, "iis[10]",params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить номерной знак личного транспорта [ /numbercar ID Цена Значение ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
	if(params[0] == playerid && server != 0) return ErrorMessage(playerid, "{FF6347}Вы не можете менять номерной знак своего транспорта");
	if(!ProxDetectorS(5.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Гражданин далеко от вас");
	if(strlen(params[2]) < 2 || strlen(params[2]) > 8) return ErrorMessage(playerid, "{FF6347}Количество символов в номере не больше 8-ми и не меньше 2-ух..");
	if(checksimvol(params[2])) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ [ Используйте, буквы и цифры ]");
	if(params[1] > 50000 || params[1] < 10000) return ErrorMessage(playerid, "{FF6347}Цена услуги не меньше 10000$ и не больше 50000$");
	if(oGetPlayerMoney(params[0]) < params[1]) return ErrorMessage(playerid, "{FF6347}Гражданину не хватает денег");

	SetNumberOfferShow(playerid, params[0], params[1], params[2]);

	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я предлагаю {ff9000}%s {cccccc}установить номерные знаки {ff9000}%s{cccccc} за {99ff66}%d$", PlayerInfo[params[0]][pName], params[2], params[1]);
	return 1;
}
//----------------------------------[TIME]-----------------------------------------------
CMD:fixr(playerid, const params[])
{
	PlayerFixRadio(playerid);
	return 1;
}
CMD:dom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 3 && PlayerInfo[playerid][pMedia] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепорт к дому [ /dom Номер ]");
    if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 1000");
    PPSetPlayerPos(playerid, DomInfo[params[0]][dKoordinatX], DomInfo[params[0]][dKoordinatY], DomInfo[params[0]][dKoordinatZ]);
	PPSetPlayerFacingAngle(playerid, DomInfo[params[0]][dKoordinatA]);
    S_SetPlayerVirtualWorld(playerid,0,0);
	PPSetPlayerInterior(playerid,0);
	return 1;
}

// Покупаем дом
stock BuyDom(playerid, i, typeBuy) // typeBuy 0 - $, 1 - gold
{
	if(typeBuy != 0 && typeBuy != 1) return 1;
	if(PlayerInfo[playerid][pDom] >= 1) return ErrorMessage(playerid, "{FF6347}У вас уже есть дом [ Y >> Жилье ]");
	if(PlayerInfo[playerid][pHouserent] != 0) return ErrorMessage(playerid, "{FF6347}Вы проживаете в другом доме [ Выселиться /unrent ]");
	if(DomInfo[i][dLevel] >= 50) return ErrorMessage(playerid, "{FF6347}Этот дом нельзя приобрести\n{ffcc66}Зарезервирован администрацией");

	new price;
	if(DomInfo[i][dSost] > 0 && DomInfo[i][dSell] > 0) price = DomInfo[i][dSell]; // Владелец продаёт
	else if(DomInfo[i][dSost] == 0) price = DomInfo[i][dSost2]; // Продаётся по гос
	else return ErrorMessage(playerid, "{FF6347}Этот дом не продаётся");

	new string[240];
	// Покупаем за вирты
	if(typeBuy == 0)
	{
		if(oGetPlayerMoney(playerid) < price) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
		oGivePlayerMoney(playerid, -price);
		if(DomInfo[i][dSell] >= 1)
		{
			new para1, text_ip[30];
			para1 = ReturnUser(DomInfo[i][dVlad], 1);
			if(IsPlayerConnected(para1))
			{
				if(DomInfo[i][dSost] == PlayerInfo[para1][pID])
				{
					PlayerInfo[para1][pAccount] += price;
					PlayerInfo[para1][pDom] = 0;
					if(PlayerInfo[para1][pSelectspawn] == 4) PlayerInfo[para1][pSelectspawn] = 0;
					if(OnlineInfo[para1][oLogged] == 1)
					{
						format(string, sizeof(string), "{0088ff}[ Риэлторское Агентство ]: Ваш {ffcc66}Дом № %d {0088ff}только что был куплен %s", i, PlayerInfo[playerid][pName]);
						SendClientMessage(para1, COLOR_GREY, string);
						format(string, sizeof(string), "{0088ff}[ Риэлторское Агентство ]: Деньги в размере {99ff66}%d$ {0088ff}перечислены на ваш бансковский счёт", price);
						SendClientMessage(para1, COLOR_GREY, string);
						format(string, sizeof(string), "{cccccc}Ваш {ff9000}Дом № %d {cccccc}только что был куплен {ff9000}%s\n{cccccc}Деньги в размере {99ff66}%d$ {cccccc}перечислены на ваш банковский счёт", i, PlayerInfo[playerid][pName], price);
						ShowDialog(para1,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Риэлторское Агентство",string,"Oк","");

						mysql_save(para1, 0);
						mysql_save(para1, 6);
						format(text_ip, sizeof(text_ip), "%s",PlayerInfo[para1][pPlaIP]);
					}
					else
					{
						if(OnlineInfo[para1][oLogged] == 0) return ErrorText(playerid, "{FF6347}Дождитесь пока владелец дома авторизуется и повторите попытку");
					}
				}
			}
			else
			{
				mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", DomInfo[i][dVlad]);
				mysql_tquery(pearsq, string, "Call_Offline", "dssdd", DomInfo[i][dSost], DomInfo[i][dVlad], DomInfo[i][dVlad],20,DomInfo[i][dSell]);
			}
			format(string, sizeof(string), "Продал Дом № %d", i);
			MoneyLog("selldom", DomInfo[i][dSost], DomInfo[i][dVlad], text_ip, PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], price, string);
			format(string, sizeof(string), "Купил Дом № %d", i);
			MoneyLog("buydom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], DomInfo[i][dSost], DomInfo[i][dVlad], "", -price, string);
		}
		else
		{
			format(string, sizeof(string), "Купил Дом № %d", i);
			MoneyLog("buydom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], DomInfo[i][dSost], DomInfo[i][dVlad], "", -price, string);
			PutMoneyToTreasury(price, "Покупка дома из гос.");
		}
	}
	else if(typeBuy == 1)
	{
		if(DomInfo[i][dGold] == 0) return ErrorMessage(playerid, "{FF6347}Этот дом нельзя купить за Gold");

		if(PlayerInfo[playerid][pDonateMoney] < DomInfo[i][dGold]) return ErrorMessage(playerid, "{FF6347}Вам не хватает золота для покупки дома\n{ffcc66}Приобрести золото можно на нашем сайте pears.fun [ Y >> Донат ]");
		price = DomInfo[i][dGold];
		PlayerInfo[playerid][pDonateMoney] -= DomInfo[i][dGold];
		tclArifmetikAllGold -= DomInfo[i][dGold];
		mysql_save(playerid, 4);

		format(string, sizeof(string), "Купил Дом № %d", i);
		DonateLog("buydom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -price, string);
	}

	PlayerInfo[playerid][pDom] = i;
	DomInfo[i][dPastime] = 0;
	DomInfo[i][dData] = gettime()+2592000;
	DomInfo[i][dSost] = PlayerInfo[playerid][pID];
	DomInfo[i][dSell] = 0;
	DomInfo[i][dLock] = 1;
	DomInfo[i][dAcccupO] = 0, DomInfo[i][dAcccupP] = 0, DomInfo[i][dAcccupG] = 0, DomInfo[i][dAcccupD] = 0, DomInfo[i][dAccgar] = 0, DomInfo[i][dAccdoo] = 0, DomInfo[i][dAccfur] = 0;
	DomInfo[i][dAccint] = 0;
	DomInfo[i][dArest] = 0, DomInfo[i][dFamcar] = 0;
	if(DomInfo[i][dDescrip] == 2) DomInfo[i][dDescrip] = 0;
	format(DomInfo[i][dVlad], 24,"%s", PlayerInfo[playerid][pName]);
	mysql_save(playerid, 6);
	PlayerPlayMusic(playerid);
	SaveDom(i);
	UpdateDom(i);
	PlayerInfo[playerid][pSelectspawn] = 4;
	PlayerPlaySound(playerid, 1052, 0, 0, 0);
	format(string, sizeof(string),"{cccccc}Поздравляем с покупкой {ff9000}Дома № %d\n{ffcc66}Управление домом: Y >> Жилье или /mydom",i);
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX, "{ff9000}Риэлторское Агентство", string, "Ок", "");

	SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Риэлторское Агентство ]: Поздравляем с покупкой Дома № %d {ffcc66}[ Y >> Жилье или /mydom ]",i);

	format(string, sizeof(string), "Купил Дом № %d", i);
	HouseLog(0, "buydom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], i, price, string);
	if(PlayerInfo[playerid][pAchieve][10] == 0) AchievePlayer(playerid, 10, 1);
	return 1;
}

// ALT у входа в дом
stock DomPlayerEnter(playerid)
{
	new findDom = -1;
	for(new i = 1; i < sizeof(DomInfo); i++)
	{
		if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[i][dKoordinatX], DomInfo[i][dKoordinatY], DomInfo[i][dKoordinatZ])
			&& GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0)
		{
			DP[0][playerid] = i;

			// Меню покупки дом
			if(DomInfo[i][dSost] >= 1 && DomInfo[i][dSell] >= 1
				|| DomInfo[i][dSost] == 0) ShowDialogMenuBuyDom(playerid, i);

			// Просто входим в дом
			else EnteredDom(playerid, i,2);

			findDom = i;
			break;
		}
		else if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[i][dCoordDopDoorOne][0], DomInfo[i][dCoordDopDoorOne][1], DomInfo[i][dCoordDopDoorOne][2]) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && DomInfo[i][dDoor][0] == 1)
		{
			EnteredDom(playerid, i,0);
			findDom = i;
			break;
		}
		else if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[i][dCoordDopDoorTwo][0], DomInfo[i][dCoordDopDoorTwo][1], DomInfo[i][dCoordDopDoorTwo][2]) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && DomInfo[i][dDoor][1] == 1)
		{
			EnteredDom(playerid, i,1);
			findDom = i;
			break;
		}
	}
	return findDom;
}

// Меню у входа в дом
stock ShowDialogMenuBuyDom(playerid, i)
{
	PlayerPlaySound(playerid,1150,0,0,0);
    new line[100],lines[300];

    if(DomInfo[i][dLock] == 0) format(line,sizeof(line),"{cccccc}Войти {ff9000}>>\t {99ff66}Открыто"), strcat(lines,line);
	else format(line,sizeof(line),"{cccccc}Войти {99ff66}>>\t {FF6347}Заперто"), strcat(lines,line);

	if(DomInfo[i][dSost] >= 1 && DomInfo[i][dSell] >= 1) format(line,sizeof(line),"\n{cccccc}Купить за {99ff66}%d$\t", DomInfo[i][dSell]), strcat(lines,line);
	else if(DomInfo[i][dSost] == 0) 
	{
		format(line,sizeof(line),"\n{cccccc}Купить за {99ff66}%d$ {cccccc}(гос. цена)\t", DomInfo[i][dSost2]), strcat(lines,line);
		if(DomInfo[i][dGold] > 0) format(line,sizeof(line),"\n{cccccc}Купить за {ffcc00}%dG\t", DomInfo[i][dGold]), strcat(lines,line);
	}

	format(line,sizeof(line),"{ff9000}Дом № %d", i);
  	ShowDialog(playerid,571,DIALOG_STYLE_TABLIST, line, lines, "Выбор", "Выход");
	return 1;
}

// Входим в дом
stock EnteredDom(playerid, i, door)
{
	if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция\n\nВы не можете спрятаться в доме во время активного преследования!");
	if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
	if(IsCustomObject(DomInfo[i][dOmodel][0]) && !IsPlayerSyncModels(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете зайти в этот дом\nВ доме установлен кастомный интерьер\n\n{ffcc66}Скачайте лаунчер с нашего официального сайта pears.fun");

	if((PlayerInfo[playerid][pDom] == i || DomInfo[i][dLock] == 0 || PlayerInfo[playerid][pHouserent] == i
	|| DomInfo[i][dFam] == PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1) && door == 0)
	{
		if(DomInfo[i][dDoorInt][0] == 0) return ErrorMessage(playerid,"{ff6347}Дверь 1 в интерьере не установлена. [/mydom >> Редактор Взаимодействий]");
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,i+1000,DomInfo[i][dInterior]);
		PPSetPlayerInterior(playerid,DomInfo[i][dInterior]);
		PPSetPlayerPos(playerid,DomInfo[i][dCoordDopDoorOneInt][0],DomInfo[i][dCoordDopDoorOneInt][1],DomInfo[i][dCoordDopDoorOneInt][2]);
		PPSetPlayerFacingAngle(playerid, DomInfo[i][dEnterA]);
		SetCameraBehindPlayer(playerid);
		GameTextForPlayer(playerid," ",5000,3);
	}
	else if((PlayerInfo[playerid][pDom] == i || DomInfo[i][dLock] == 0 || PlayerInfo[playerid][pHouserent] == i
	|| DomInfo[i][dFam] == PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1) && door == 1)
	{
		if(DomInfo[i][dDoorInt][1] == 0) return ErrorMessage(playerid,"{ff6347}Дверь 2 в интерьере не установлена. [/mydom >> Редактор Взаимодействий]");
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,i+1000,DomInfo[i][dInterior]);
		PPSetPlayerInterior(playerid,DomInfo[i][dInterior]);
		PPSetPlayerPos(playerid,DomInfo[i][dCoordDopDoorTwoInt][0],DomInfo[i][dCoordDopDoorTwoInt][1],DomInfo[i][dCoordDopDoorTwoInt][2]);
		PPSetPlayerFacingAngle(playerid, DomInfo[i][dEnterA]);
		SetCameraBehindPlayer(playerid);
		GameTextForPlayer(playerid," ",5000,3);
	}
	else if((PlayerInfo[playerid][pDom] == i || DomInfo[i][dLock] == 0 || PlayerInfo[playerid][pHouserent] == i
	|| DomInfo[i][dFam] == PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1) && door == 2)
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,i+1000,DomInfo[i][dInterior]);
		PPSetPlayerInterior(playerid,DomInfo[i][dInterior]);
		PPSetPlayerPos(playerid,DomInfo[i][dEnterX],DomInfo[i][dEnterY],DomInfo[i][dEnterZ]);
		PPSetPlayerFacingAngle(playerid, DomInfo[i][dEnterA]);
		SetCameraBehindPlayer(playerid);
		GameTextForPlayer(playerid," ",5000,3);
	}
	else
	{
		PlayerPlaySound(playerid,17803,0,0,0);
		new str[84], sctring[504];
		format(str,sizeof(str),"{FF6347}Дверь заперта!"), strcat(sctring,str);
		/*format(str,sizeof(str),"{cccccc}\n\nТребования для ограбления дома:"), strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}\n- Террорка маска [ Y >> GPS >> Услуги >> Магазины Одежды ]"), strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}\n- Фонарик [ Y >> GPS >> Услуги >> Супермаркеты ]"), strcat(sctring,str);
		format(str,sizeof(str),"{FF6347}\n\nВнимание! {cccccc}Доступно только для участников банд и мафий"), strcat(sctring,str);*/
		format(str,sizeof(str),"{cccccc}\n\nХотите взломать дверь?"), strcat(sctring,str);
		ShowDialog(playerid,1275,DIALOG_STYLE_MSGBOX,"{ff9000}Дверь",sctring,"Да","Нет");
	}
	return 1;
}

stock ExitDom(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return false; // Если чел не пешком, не пускаем
	if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000)
	{
		new nd = GetPlayerVirtualWorld(playerid)-1000;
		if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[nd][dEnterX], DomInfo[nd][dEnterY], DomInfo[nd][dEnterZ]))
		{
			if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1)
			{
				SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
				return false;
			}
			if(IsPlayerEditObject(playerid))
			{
				ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
				return false;
			}

			S_SetPlayerVirtualWorld(playerid,0,0);
			PPSetPlayerInterior(playerid,0);
			PPSetPlayerPos(playerid,DomInfo[nd][dKoordinatX],DomInfo[nd][dKoordinatY],DomInfo[nd][dKoordinatZ]);
			PPSetPlayerFacingAngle(playerid, DomInfo[nd][dKoordinatA]);
	 		if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
			return true;
		}
		else if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[nd][dCoordDopDoorOneInt][0], DomInfo[nd][dCoordDopDoorOneInt][1], DomInfo[nd][dCoordDopDoorOneInt][2]))
		{
			if(DomInfo[nd][dDoor][0] == 0) return ErrorMessage(playerid,"{ff6347}Входная дверь 1 не установлена. [/mydom >> Редактор Взаимодействий]");
			if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1)
			{
				SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
				return false;
			}
			if(IsPlayerEditObject(playerid))
			{
				ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
				return false;
			}

			S_SetPlayerVirtualWorld(playerid,0,0);
			PPSetPlayerInterior(playerid,0);
			PPSetPlayerPos(playerid,DomInfo[nd][dCoordDopDoorOne][0],DomInfo[nd][dCoordDopDoorOne][1],DomInfo[nd][dCoordDopDoorOne][2]);
			PPSetPlayerFacingAngle(playerid, DomInfo[nd][dKoordinatA]);
	 		if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
			return true;
		}
		else if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[nd][dCoordDopDoorTwoInt][0], DomInfo[nd][dCoordDopDoorTwoInt][1], DomInfo[nd][dCoordDopDoorTwoInt][2]))
		{
			if(DomInfo[nd][dDoor][1] == 0) return ErrorMessage(playerid,"{ff6347}Входная дверь 2 не установлена. [/mydom >> Редактор Взаимодействий]");
			if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1)
			{
				SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
				return false;
			}
			if(IsPlayerEditObject(playerid))
			{
				ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
				return false;
			}

			S_SetPlayerVirtualWorld(playerid,0,0);
			PPSetPlayerInterior(playerid,0);
			PPSetPlayerPos(playerid,DomInfo[nd][dCoordDopDoorTwo][0],DomInfo[nd][dCoordDopDoorTwo][1],DomInfo[nd][dCoordDopDoorTwo][2]);
			PPSetPlayerFacingAngle(playerid, DomInfo[nd][dKoordinatA]);
	 		if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
			return true;
		}
	}
	return false;
}

CMD:exitsdelka(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,1.0,1259.7332,-13.0481,1000.9254) || IsPlayerInRangeOfPoint(playerid,1.0,1265.5571,-13.2352,1000.9254)
	|| IsPlayerInRangeOfPoint(playerid,1.0,1265.6135,-30.9052,1000.9254) || IsPlayerInRangeOfPoint(playerid,1.0,1259.8344,-30.8850,1000.9254))
	{
		if(GetPlayerInterior(playerid) == 100 && Sdelka[playerid] >= 1)
		{
			S_SetPlayerVirtualWorld(playerid,100,100);
			PPSetPlayerInterior(playerid,100);
			Sdelka[playerid] = 0;
			if(IsPlayerInRangeOfPoint(playerid,1.0,1259.7332,-13.0481,1000.9254)) PPSetPlayerPos(playerid,1259.8336,-14.9159,1000.9254), PPSetPlayerFacingAngle(playerid,181.0461);
			else if(IsPlayerInRangeOfPoint(playerid,1.0,1265.5571,-13.2352,1000.9254)) PPSetPlayerPos(playerid,1265.6593,-14.9426,1000.9254), PPSetPlayerFacingAngle(playerid,181.3828);
			else if(IsPlayerInRangeOfPoint(playerid,1.0,1265.6135,-30.9052,1000.9254)) PPSetPlayerPos(playerid,1265.5576,-29.1393,1000.9254), PPSetPlayerFacingAngle(playerid,357.9127);
			else if(IsPlayerInRangeOfPoint(playerid,1.0,1259.8344,-30.8850,1000.9254)) PPSetPlayerPos(playerid,1259.7559,-29.0322,1000.9254), PPSetPlayerFacingAngle(playerid,0.5878);
			if(PlayerInfo[playerid][pTstat] >= 1 && PlayerInfo[playerid][pTid] >= 0)
			{
				new para1 = PlayerInfo[playerid][pTid];
				if(IsOnline(para1))
				{
					new string[144];
					if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"{ff9000}[ Центр Обмена ] {cccccc}%s отменил сделку с вами",PlayerInfo[playerid][pName]);
					else format(string,sizeof(string),"{ff9000}[ Центр Обмена ] {cccccc}%s отменила сделку с вами",PlayerInfo[playerid][pName]);

					if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"{FF6347}[Отмена Сделки]\n\n{cccccc}%s отменил сделку с вами",PlayerInfo[playerid][pName]);
					else format(string,sizeof(string),"{FF6347}[Отмена Сделки]\n\n{cccccc}%s отменила сделку с вами",PlayerInfo[playerid][pName]);
					ShowDialog(para1,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Центр Обмена",string,"Ок","");
					SendClientMessage(para1, COLOR_GREY, string);
					new vrem = para1;
					PlayerInfo[para1][pTstat] = 1;
					PlayerInfo[para1][pTid] = -1;
					PlayerInfo[playerid][pTid] = -1;
					UpdateTrade(vrem);
					UpdateTrade(playerid);
				}
			}
		}
	}
	return 1;
}
CMD:gotowh(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепорт к складу [ /gotowh Номер Склада ]");
	if(params[0] < 1 || params[0] > 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер склада от 1 до 15");
	S_SetPlayerVirtualWorld(playerid,0, 0), PPSetPlayerInterior(playerid, 0);
	PPSetPlayerPos(playerid, WhPos[params[0]-1][WhPos_X], WhPos[params[0]-1][WhPos_Y], WhPos[params[0]-1][WhPos_Z]);
	PPSetPlayerFacingAngle(playerid, 0.0);
	SetCameraBehindPlayer(playerid);
	return 1;
}
CMD:entersklad(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;
	for(new r = 0; r < sizeof(WhInfo); r++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 2.0, WhPos[r][WhPos_X], WhPos[r][WhPos_Y], WhPos[r][WhPos_Z]))
		{
			if(howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо..");
			S_SetPlayerVirtualWorld(playerid,r+81, 238), PPSetPlayerInterior(playerid, 238);
			PPSetPlayerPos(playerid, 1384.2867,-27.2273,1000.9112), PPSetPlayerFacingAngle(playerid, 0.0);
			SetCameraBehindPlayer(playerid);
		}
	}
	return 1;
}

stock ExitBiz(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 0;

	new result;
	for(new b = 0; b < sizeof(BizzInfo); b++)
	{
        if(IsABizInteriorFrame(b))
	    {
	        if(IsPlayerInRangeOfPoint(playerid,3.0,BizzInfo[b][bInteriorX], BizzInfo[b][bInteriorY], BizzInfo[b][bInteriorZ]) && GetPlayerVirtualWorld(playerid) == b+3000 && GetPlayerInterior(playerid) == BizzInfo[b][bInterior])
			{
				if(IsPlayerEditObject(playerid))
				{
					ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
					return 1;
				}

			    if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
				if(PlayerApartments[playerid][1] == 0)
				{
					S_SetPlayerVirtualWorld(playerid,0,0);
					PPSetPlayerInterior(playerid,0);
					PPSetPlayerPos(playerid,BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]), PPSetPlayerFacingAngle(playerid, BizzInfo[b][bEnterA]);
				}
				else
				{
					new apid = PlayerApartments[playerid][1]-1;
					new pickup;
					for(new i; i< 4;i++)
					{
						if(Apartments[apid][apBiz][i] == PlayerApartments[playerid][0]) 
						{	
							pickup = i;
							break;
						}
					}
					PlayerApartments[playerid][0] = 0; PlayerApartments[playerid][1] = 0;
					S_SetPlayerVirtualWorld(playerid,Apartments[apid][apWorldDefineEntrance],Apartments[apid][apInt]);
					PPSetPlayerInterior(playerid,Apartments[apid][apInt]);
					PPSetPlayerPos(playerid,Apartments[apid][apCoordBizShop][0+pickup*3],Apartments[apid][apCoordBizShop][1+pickup*3],Apartments[apid][apCoordBizShop][2+pickup*3]), PPSetPlayerFacingAngle(playerid, BizzInfo[b][bEnterA]);
				}
				if(b >= 93 && b <= 102)
				{
					if(PlayerInfo[playerid][pQuest][6] == 1) ErrorMessage(playerid,"{ff6347}Мне нужно вернуться, чтобы продолжить задание");
					else if(PlayerInfo[playerid][pQuest][6] == 3) QuestActorJoneSeks(playerid);
				}
				result = 1;
				break;
			}
		}
	}
	return result;
}

CMD:fambiz(playerid)
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3051 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	new str[84],sctring[860];
	for(new fb = 0; fb < 10; fb++)
	{
		if(FamilyInfo[f][fBiz][fb] >= 1) format(str,sizeof(str),"{cccccc}[№ %d] {ff9000}%s\t{cccccc}%s\n",FamilyInfo[f][fBiz][fb],bizname(FamilyInfo[f][fBiz][fb]),BizzInfo[FamilyInfo[f][fBiz][fb]][bVlad]), strcat(sctring,str);
		else format(str,sizeof(str),"{444444}нет\n"), strcat(sctring,str);
	}
	ShowDialog(playerid,675,DIALOG_STYLE_TABLIST,"{ff9000}Бизнесы Семьи",sctring,"Выбрать","Отмена");
	return 1;
}
CMD:fmembers(playerid)
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3012 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	PlayerPlaySound(playerid,40405,0,0,0);
	new str[150],sctring[4096],atext[10],btext[10],onl = 0,lol[50];
	foreach(Player, i)
 	{
 		if(PlayerInfo[i][pFamily] == f && OnlineInfo[i][oLogged] == 1 && gSign[i] == false)
		{
			if(PlayerInfo[i][pTransmitterOff][3] == false) atext = "{99ff66}*"; // /f on
	  		else if(PlayerInfo[i][pTransmitterOff][3] == true) atext = "{FF6347}*"; // /f off

	  		if(PlayerInfo[i][pFamrank] >= FamilyInfo[f][fRanks] || FamilyInfo[f][fOwner] == PlayerInfo[i][pID]) btext = "{FF0000}";
	  		else if(PlayerInfo[i][pFamrank] == FamilyInfo[f][fRanks] - 1) btext = "{FF9000}";
			else btext = "{FFffff}";
			if(GetPVarInt(i,"afksystem") >= 3)
   			{
      			format(str,sizeof(str),"%s %s%s[%d]  {0088ff}| {cccccc}Ранг: {FFFFFF}%d  | AFK: %d сек\n",atext,btext,PlayerInfo[i][pName],i,PlayerInfo[i][pFamrank],GetPVarInt(i,"afksystem")), strcat(sctring,str);
   			}
   			else
   			{
   				format(str,sizeof(str),"%s %s%s[%d]  {0088ff}| {cccccc}Ранг: {FFFFFF}%d\n",atext,btext,PlayerInfo[i][pName],i,PlayerInfo[i][pFamrank]), strcat(sctring,str);
			}
			onl++;
		}
	}
	format(lol,sizeof(lol),"{ff9000}Участники Семьи {00cc00}Online: %d",onl);
	ShowDialog(playerid,476,DIALOG_STYLE_LIST,lol,sctring,"Ок","");
	return 1;
}
forward Call_fams(playerid);
public Call_fams(playerid)
{
	new rows,str[214], sctring[4096], datad1[24], datad3[24], datad4, kol, qwer[144], datad5;
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		cache_get_value_name_int(i, "Famrank", datad4);
		cache_get_value_name(i, "Name", datad1, 24);
		cache_get_value_name(i, "Offtime", datad3, 24);
		cache_get_value_name_int(i, "user_id", datad5);
		format(str,sizeof(str),"{cccccc}%s [%d] %s\n", datad1, datad4, datad3), strcat(sctring,str);
		kol ++;
		DP[1][playerid] = datad5;
    }
    if(kol >= 1)
	{
		DP[2][playerid] ++;
		if(kol >= 70)
		{
			format(qwer,sizeof(qwer),"{ff9000}Участники Семьи {ff0000}Offline {cccccc}Страница %d",DP[2][playerid]);
			ShowDialog(playerid,485,DIALOG_STYLE_LIST,qwer,sctring,"Далее","");
		}
		else
		{
			format(qwer,sizeof(qwer),"{ff9000}Участники Семьи {ff0000}Offline {cccccc}Страница %d",DP[2][playerid]);
			ShowDialog(playerid,2001,DIALOG_STYLE_LIST,qwer,sctring,"Ок","");
		}
	}
    else if(kol == 0) ShowDialog(playerid,2001,DIALOG_STYLE_MSGBOX,"{ff9000}Участники Семьи {ff0000}Offline","{cccccc}Участники Offline в семье не найдены","*","");
	return 1;
}
CMD:fmembersoff(playerid)
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3013 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	new string[144];
	if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccoff]) return format(string,sizeof(string),"[ Мысли ]: Я не могу посмотреть полный список участников [ %d+ Ранг ]",FamilyInfo[f][fAccoff]), SendClientMessage(playerid, COLOR_GREY, string), pc_cmd_fam(playerid);
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Участники Семьи {ff0000}Offline","{cccccc}Поиск участников...","*","");
	DP[2][playerid] = 0;
	mysql_format(pearsq, string, sizeof(string), "SELECT user_id, Name, Famrank, Offtime FROM `pp_igroki` WHERE `Family` = '%d' AND `Online` = '0' LIMIT 70", f);
	mysql_tquery(pearsq, string, "Call_fams", "d", playerid);
	return 1;
}
CMD:famdip(playerid)
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3014 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	PlayerPlaySound(playerid,40405,0,0,0);
	new str[90],sctring[640];
	format(str,sizeof(str),"{cccccc}Посмотреть Дипломатию\n"), strcat(sctring,str);
