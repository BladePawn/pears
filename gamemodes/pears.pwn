  			format(string, sizeof(string), "[Правительство] %s изменяет гос. стоимость: %s {99ff66}%d$ [%s]", PlayerInfo[playerid][pName], atext, input, get_k(input));
  			SendDepartMessage(COLOR_ALLDEPT, string);
     		OrgLog(7, "minfin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", input, atext);
     		pc_cmd_economy(playerid);
		}
		else pc_cmd_economy(playerid);
	}
	case 530:
   	{
