forward Call_infomaps(map_name[], statussave, world, interior, objectquan);
public Call_infomaps(map_name[], statussave, world, interior, objectquan)
{
    new rows, f_str[214];
	cache_get_row_count(rows);
	if(statussave > 0) // SaveMap
	{
	    if(rows)
		{
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `s_maps` SET `objects`='%d',`autoload`='%d',`unix`='%d',`world`='%d',`interior`='%d' WHERE `namemap`='%e'",objectquan,MapInfo[0][autoload],gettime(),world,interior,map_name);
        	query_empty(pearsq, f_str);
		}
		else
		{
		    mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `s_maps` SET `objects`='%d',`autoload`='%d',`unix`='%d',`world`='%d',`interior`='%d',`namemap`='%e'",objectquan,MapInfo[0][autoload],gettime(),world,interior,map_name);
			query_empty(pearsq, f_str);
		}
	}
	else
	{
	    if(rows)
		{
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `s_maps` SET `unix`='%d',`world`='%d',`interior`='%d' WHERE `namemap`='%e'",gettime(),world,interior,map_name);
        	query_empty(pearsq, f_str);
		}
		else
		{
		    mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `s_maps` SET `objects`='%d',`unix`='%d',`world`='%d',`interior`='%d',`namemap`='%e'",objectquan,gettime(),world,interior,map_name);
			query_empty(pearsq, f_str);
		}
	}
	return 1;
}
forward Call_autoloadmap();
public Call_autoloadmap()
{
    new rows,datad1[64],datad2,datad3, string_mysql[120];
	cache_get_row_count(rows);
    for(new i = 0; i < rows; i++)
	{
	    cache_get_value_name(i, "namemap", datad1, 24);
	    cache_get_value_name_int(i, "world", datad2);
	    cache_get_value_name_int(i, "interior", datad3);

	    mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `pp_map` WHERE `namemap` = '%e'", datad1);
     	mysql_tquery(pearsq, string_mysql, "Call_create_map", "sdd", datad1, datad2, datad3);
	    printf("[MODE]: Карта мероприятий %s", datad1);
	}
	return 1;
}
function Call_maps(playerid, page)
{
	new rows,str[84],sctring[4800],datad1[64],datad2,datad3,datad4,datad5,tyear, tmonth, tday, thour, tminute, tsecond, atext[20], qwer[120];
	new item_index, max_page_index = MAX_MAPS / MAX_MAPS_INLIST - 1;
	SetPVarInt(playerid, "ListMapsPage", page);
	cache_get_row_count(rows);
	format(str,sizeof(str),"Название \t Объектов \t Автозагрузка \t Дата Использования"), strcat(sctring,str);
	for(new i = 0 + page * MAX_MAPS_INLIST; i < 1 + (page + 1) * MAX_MAPS_INLIST; i++)
	{
		if (i >= rows) break;

	    cache_get_value_name_int(i, "newid", datad5);
		List[item_index++][playerid] = datad5;
		cache_get_value_name(i, "namemap", datad1, 24);
		cache_get_value_name_int(i, "objects", datad2);
		cache_get_value_name_int(i, "autoload", datad3);
		ListDetail[i][playerid] = datad3;
		cache_get_value_name_int(i, "unix", datad4);
		stamp2datetime(datad4, tyear, tmonth, tday, thour, tminute, tsecond, 3);
		if(datad3 == 0) atext = "{cccccc}Нет";
		else if(datad3 == 1) atext = "{99ff66}Да";
		format(str,sizeof(str),"\n%s \t %d \t %s \t %02d.%02d.%d %02d:%02d",datad1,datad2,atext,tday,tmonth,tyear,thour,tminute), strcat(sctring,str);
	}
	if (page < max_page_index) {
		strcat(sctring, "\n{cccccc}Далее >>");
		List[item_index++][playerid] = MAX_MAPS + 1;
	}
	if (page > 0) {
		strcat(sctring, "\n{cccccc}Назад <<");
		List[item_index][playerid] = MAX_MAPS + 2;
	}
	format(qwer,sizeof(qwer),"{ff9000}Карты Мероприятий {cccccc}[%d] {ff9000}| Страница {cccccc}[%d/%d]",rows,page + 1,max_page_index + 1);
	ShowDialog(playerid,342,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Выбор","Выход");
	return true;
}
forward Call_admins(playerid);
public Call_admins(playerid)
{
	new rows, str[120], sctring[2800],atext[24],ofl,onl,qwer[84];
	PlayerPlaySound(playerid,40405,0,0,0);
	new year, month,day;
	getdate(year, month, day);
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24],giveplayerid,datad4,datad5,datad6,datad7;
		cache_get_value_name(i, "Name", datad2, 24);
		cache_get_value_name_int(i, "Soska", datad4);
		cache_get_value_name_int(i, "Online", datad5);
		cache_get_value_name_int(i, "Ammo6", datad6);
		cache_get_value_name_int(i, "VacBeg", datad7);

		{
			// Доступ к полному списку администраторов имеют: Администраторы / Медиа / Хидден
			new bool: full_admins_access = PlayerInfo[playerid][pSoska] > 0 || PlayerInfo[playerid][pMedia] > 0 || PlayerInfo[playerid][pHidden];
			// Скрываем администраторов следующих категорий: Разработчик+ / Менеджеры
			new bool: is_admin_hidden = datad4 == 9 || datad4 == 14 || datad4 == 19 || datad4 > 21;
			
			if (!full_admins_access && is_admin_hidden) continue;
		}

		if(datad7 == 0)
		{
			switch(datad4)
			{
				case 1: atext = "{80CAFF}"; // Хелперы
				case 2..8: atext = "{007a08}"; // Админы
				case 9: atext = "{FDD9B5}"; // Менеджер
				case 14: atext = "{FDD9B5}"; // Зам. Куратора Media
				case 10..13: atext = "{ff6600}"; // Замы Кураторов
				case 15..18: atext = "{ff0000}"; // Кураторы
				case 19: atext = "{FDD9B5}"; // Куратор Media
				case 20: atext = "{cc0000}"; // Системный Админ
				case 21: atext = "{cc0000}"; // ГА
				case 22: atext = "{888888}"; // Разработчик
				case 23: atext = "{b30000}"; // Админ
				case 24..25: atext = "{444444}"; // Основатель
				default: atext = "{ffffff}";
			}
		}
		else atext = "{cccccc}";
		if(datad5 == 1)
		{
			giveplayerid = ReturnUser(datad2);
			if(IsOnline(giveplayerid))
			{
				if(OnlineInfo[giveplayerid][oLogged] == 1)
 				{
 					if(datad4 >= 10)
					{
						if(GetPVarInt(giveplayerid,"afksystem") >= 2) format(str,sizeof(str),"{99ff66}*   %s%s[%d]  {cccccc}AFK: %d сек.\n",atext,PlayerInfo[giveplayerid][pName],giveplayerid,GetPVarInt(giveplayerid,"afksystem"));
						else format(str,sizeof(str),"{99ff66}*   %s%s[%d]\n",atext,PlayerInfo[giveplayerid][pName],giveplayerid);
					}
					else
					{
						if(GetPVarInt(giveplayerid,"afksystem") >= 2) format(str,sizeof(str),"{99ff66}*   %s%s[%d]  {cccccc}Рейтинг: %d  AFK: %d сек.\n",atext,PlayerInfo[giveplayerid][pName],giveplayerid,PlayerInfo[giveplayerid][pAmmos6],GetPVarInt(giveplayerid,"afksystem"));
						else format(str,sizeof(str),"{99ff66}*   %s%s[%d]  {cccccc}Рейтинг: %d\n",atext,PlayerInfo[giveplayerid][pName],giveplayerid,PlayerInfo[giveplayerid][pAmmos6]);
					}
					strcat(sctring,str);
					onl ++;
				}
			}
		}
		if(datad5 == 0)
		{
			if(datad4 >= 10) format(str,sizeof(str),"{FF6347}*   %s%s\n",atext,datad2);
			else format(str,sizeof(str),"{FF6347}*   %s%s  {cccccc}Рейтинг: %d\n",atext,datad2,datad6);
			strcat(sctring,str);
			ofl ++;
		}
	}
	format(qwer,sizeof(qwer),"{ff9000}Администрация {FFFFFF}[%02d.%02d.%d]  {cccccc}Online: %d  Offline: %d",day,month,year,onl,ofl);
	ShowDialog(playerid,1700,DIALOG_STYLE_TABLIST,qwer,sctring,"Ок","");
	return true;
}
forward Call_leaders(playerid);
public Call_leaders(playerid)
{
	new rows, str[120], sctring[2800],ofl,onl,qwer[84];
	PlayerPlaySound(playerid,40405,0,0,0);
	new year, month,day;
	getdate(year, month, day);
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24],giveplayerid,datad1,datad4,datad5,datad7;
		cache_get_value_name(i, "Name", datad2, 24);
		cache_get_value_name_int(i, "Leader", datad1);
		cache_get_value_name_int(i, "Soska", datad4);
		cache_get_value_name_int(i, "Online", datad5);
		cache_get_value_name_int(i, "VacBeg", datad7);
		if(datad1 != 8 && datad4 < 10)
		{
			if(datad5 == 1)
			{
				giveplayerid = ReturnUser(datad2);
				if(IsOnline(giveplayerid))
				{
					if(OnlineInfo[giveplayerid][oLogged] == 1)
	 				{
	 					if(datad7 == 0)
	 					{
							if(GetPVarInt(giveplayerid,"afksystem") >= 2) format(str,sizeof(str),"{99ff66}[Online] {cccccc}%s[%d] %s {cccccc}AFK: %d сек.\n",PlayerInfo[giveplayerid][pName],giveplayerid,frakName[PlayerInfo[giveplayerid][pLeader]],GetPVarInt(giveplayerid,"afksystem")), strcat(sctring,str);
							else format(str,sizeof(str),"{99ff66}[Online] {cccccc}%s[%d] %s\n",PlayerInfo[giveplayerid][pName],giveplayerid,frakName[PlayerInfo[giveplayerid][pLeader]]), strcat(sctring,str);
						}
						else
						{
							if(GetPVarInt(giveplayerid,"afksystem") >= 2) format(str,sizeof(str),"{999999}[Online] %s[%d] %s {cccccc}AFK: %d сек.\n",PlayerInfo[giveplayerid][pName],giveplayerid,frakName[PlayerInfo[giveplayerid][pLeader]],GetPVarInt(giveplayerid,"afksystem")), strcat(sctring,str);
							else format(str,sizeof(str),"{999999}[Online] %s[%d] %s\n",PlayerInfo[giveplayerid][pName],giveplayerid,frakName[PlayerInfo[giveplayerid][pLeader]]), strcat(sctring,str);
						}
						onl ++;
					}
				}
			}
			if(datad5 == 0)
			{
				if(datad7 == 0) format(str,sizeof(str),"{FF6347}[Offline] {cccccc}%s %s\n",datad2,frakName[datad1]), strcat(sctring,str);
				else format(str,sizeof(str),"{999999}[Offline] %s %s\n",datad2,frakName[datad1]), strcat(sctring,str);
				ofl ++;
			}
		}
	}

	if(rows == 0) return ErrorMessage(playerid, "{FF6347}Лидеры не найдены");
	format(qwer,sizeof(qwer),"{ff9000}Лидеры {FFFFFF}[%d.%d.%d]  {cccccc}Online: %d  Offline: %d",day,month,year,onl,ofl);
	ShowDialog(playerid,792,DIALOG_STYLE_TABLIST,qwer,sctring,"Далее","");
	return true;
}

stock Call_relonl()
{
	mysql_tquery(pearsq, "UPDATE `pp_igroki` SET `Online` = '0' WHERE `Online` = '1'");
	printf("[MODE]: Reload Online");
	return 1;
}
stock GiveMyPromo(playerid)
{
	if(PlayerInfo[playerid][pPromoreg] >= 1)
	{
		new myp = -1, newid = PlayerInfo[playerid][pPromoreg], f_str[124];
		for(new f = 0; f < MAX_PROMO; f++)
		{
			if(PromoInfo[f][roNewid] == newid) myp = f;
		}
		if(myp == -1) return true; // Если мы не нашли промокод, игнорим нафиг

        new quan = 0;
		for(new checkslot; checkslot < 5; checkslot++)
		{
			if(PromoInfo[myp][roPar][checkslot] == 2 || PromoInfo[myp][roPar][checkslot] == 13 || PromoInfo[myp][roPar][checkslot] == 14) quan++;
		}
		if(!free_invent(playerid, quan))
		{
			SendClientMessage(playerid, COLOR_GREY,"{ffcc66}Подарки по промокоду: {FF6347}Внимание! В вашем инвентаре не хватает места");
			SendClientMessage(playerid, COLOR_GREY,"{FF6347}Подготовьте %d свободных слотов в инвентаре", quan);
			SendClientMessage(playerid, COLOR_GREY,"{FF6347}Вы сможете получить подарки во время следующего PayDay");
			return 1;
		}
		SendClientMessage(playerid, COLOR_GREY,"{ffcc66}Подарки по промокоду:");

		mysql_tquery(pearsq, "START TRANSACTION;");

		for(new statpf = 0; statpf < 5; statpf++)
		{
			if(PromoInfo[myp][roPar][statpf] == 3) 
			{
				SendClientMessage(playerid, COLOR_GREY,"{ffffff}Деньги: {99ff66}%d$", PromoInfo[myp][roStat][statpf]);
				oGivePlayerMoney(playerid, PromoInfo[myp][roStat][statpf]);

				MoneyLog("promo", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", PromoInfo[myp][roStat][statpf], PromoInfo[myp][roName]);
			}
			if(PromoInfo[myp][roPar][statpf] == 4) 
			{
				SendClientMessage(playerid, COLOR_GREY,"{ffffff}Золото: {ffcc00}%dG {999999}[ Y >> Донат или /donate ]", PromoInfo[myp][roStat][statpf]);
				PlayerInfo[playerid][pDonateMoney] += PromoInfo[myp][roStat][statpf];

				DonateLog("promo", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", PromoInfo[myp][roStat][statpf], PromoInfo[myp][roName]);
			}
			if(PromoInfo[myp][roPar][statpf] == 5) 
			{
				SendClientMessage(playerid, COLOR_GREY,"{ffffff}Уровень: {ffcc66}+%d", PromoInfo[myp][roStat][statpf]);
				PlayerInfo[playerid][pLevel] += PromoInfo[myp][roStat][statpf];
			}
			if(PromoInfo[myp][roPar][statpf] == 13) // Шкатулка
			{
				SendClientMessage(playerid, COLOR_GREY,"{ffffff}Шкатулка");
				new thingId, thingQuan, thingType, thingPara, thingPack;
				CreateCasePlayer(playerid, thingId, thingQuan, thingType,thingPara, thingPack);
				GiveThingPlayer(playerid, thingId, thingQuan, thingPara, 0, thingType, thingPack, 9999);
				CalculateVehicleLimited(thingId, thingType);
			}
			if(PromoInfo[myp][roPar][statpf] == 14) // Скин
			{
				SendClientMessage(playerid, COLOR_GREY,"{ffffff}Одежда: {cccccc}[ №%d ]{999999}[ Инвентарь(N) ]",PromoInfo[myp][roStat][statpf]);
				GiveThingPlayer(playerid, PromoInfo[myp][roStat][statpf], 1, 0, 0, 3, 0, 9999);
			}
			if(PromoInfo[myp][roPar][statpf] == 2) // Транспорт
			{
				new vehid = PromoInfo[myp][roStat][statpf];
				SendClientMessage(playerid, COLOR_GREY,"{ffffff}%s: {cccccc}%s",promoName[PromoInfo[myp][roPar][statpf]], GetVehicleName(vehid));
				new colorveh = 1 + random(254); // Color Vehicle
				GiveThingPlayer(playerid, vehid, colorveh, 0, 0, 5, 0, 9999);
			}
		}
		PlayerInfo[playerid][pPromoreg] = -1;
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Promoreg` = '-1' WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
		mysql_tquery(pearsq, f_str);

		mysql_tquery(pearsq, "COMMIT;");
	}
	return 1;
}
/*stock MyPromo(playerid, pf)
{
	new myp;
	for(new f = 0; f < MAX_PROMO; f++)
	{
		if(PromoInfo[f][roNewid] == pf) myp = f;
	}
	new str[260],sctring[1200], srazy = 0;
	format(str,sizeof(str),"\n{cccccc}Вы активировали промокод: {ff9000}%s", PromoInfo[myp][roName]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}%s", PromoInfo[myp][roText]), strcat(sctring,str);
