stock SmartfonCall(playerid)
{
	new caller = GetPVarInt(playerid, "Mobile"), string[24];
	if(GetPVarInt(playerid, "MobileStat") == 1 || GetPVarInt(playerid, "MobileStat") == 3) // Я звоню или звонок активен
	{
		PlayerTextDrawShow(playerid, PlayerSmartDraw[31][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[32][playerid]); // Я звоню или звонок активен
		if(GetPVarInt(playerid, "Mobile") < 2500)
		{
			if(GetPVarInt(caller,"taks") == 1)
			{
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), RusToGame("Неизвестный"));
				else format(string, sizeof(string), "Unknown");
			}
			else format(string, sizeof(string), "%s", rpplayername(caller));
		}
		else
		{
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), RusToGame("Неизвестный"));
			else format(string, sizeof(string), "Unknown");
		}
		PlayerTextDrawSetString(playerid, PlayerSmartDraw[41][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSmartDraw[41][playerid]);
	}
	else if(GetPVarInt(playerid, "MobileStat") == 2) // Мне звонят
	{
		PlayerTextDrawShow(playerid, PlayerSmartDraw[29][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[30][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[31][playerid]);
		if(GetPVarInt(playerid, "Mobile") < 2500)
		{
			if(GetPVarInt(caller,"taks") == 1) 
			{
			    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), RusToGame("Неизвестный"));
				else format(string, sizeof(string), "Unknown");
			}
			else format(string, sizeof(string), "%s", rpplayername(caller));
		}
		else
		{
		    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), RusToGame("Неизвестный"));
			else format(string, sizeof(string), "Unknown");
		}
		PlayerTextDrawSetString(playerid, PlayerSmartDraw[41][playerid], string);
		PlayerTextDrawShow(playerid, PlayerSmartDraw[41][playerid]);
	}
	return 1;
}
stock CloseCall(playerid)
{
	PlayerTextDrawHide(playerid, PlayerSmartDraw[29][playerid]), PlayerTextDrawHide(playerid, PlayerSmartDraw[30][playerid]);
	PlayerTextDrawHide(playerid, PlayerSmartDraw[31][playerid]), PlayerTextDrawHide(playerid, PlayerSmartDraw[32][playerid]);
	PlayerTextDrawHide(playerid, PlayerSmartDraw[41][playerid]);
	return 1;
}
