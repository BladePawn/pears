{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Сбросить права доступа у организации [ /raccess ID Фракции ][ 0: Все Организации ]");
	if(params[0] < 0 || params[0] > 34) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Номер организации не меньше 1 и не больше 33 [ 0: Все Организации ]");
	new string[128];
	if(params[0] == 0)
	{
		for(new org = 1; org < 34; org++)
		{
			for(new acci = 0; acci < MAX_ACC; acci++) OrganInfo[org][gAcc][acci] = get_maxrank(org);
			SaveOrganAccessAll(org);
		}
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил права доступа всех организаций",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("raccess", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Все организации");
	}
	else
	{
		for(new acci = 0; acci < MAX_ACC; acci++) OrganInfo[params[0]][gAcc][acci] = get_maxrank(params[0]);
		SaveOrganAccessAll(params[0]);
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил права доступа %s",PlayerInfo[playerid][pName], frakName[params[0]]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("raccess", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], orgName[params[0]]);
	}
	return 1;
}
CMD:freezegang(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Заморозить/разморозить гетто [ /freezegang ID Фракции ]");
	if(params[0] != 13 && params[0] != 14 && params[0] != 15 && params[0] != 16 && params[0] != 17 && params[0] != 19 && params[0] != 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только номер банды [ 13,14,15,16,17,19,20 ]");
	new string[128];
	if(OrganInfo[params[0]][gstat2] == 0)
	{
		OrganInfo[params[0]][gstat2] = 1;
  		format(string, sizeof(string), " [ ADM ]: Админ %s заморозил %s", PlayerInfo[playerid][pName],frakName[params[0]]);
    	ABroadCast(COLOR_ADM,string,1);
    	SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Банда заморожена");
	}
	else if(OrganInfo[params[0]][gstat2] == 1)
	{
		OrganInfo[params[0]][gstat2] = 0;
  		format(string, sizeof(string), " [ ADM ]: Админ %s разморозил %s", PlayerInfo[playerid][pName],frakName[params[0]]);
    	ABroadCast(COLOR_ADM,string,1);
    	SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Банда разморожена");
	}
 	SaveOrgan(params[0]);
	return 1;
}
CMD:referal(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_MANAGER)) show_referal(playerid, playerid, 1);
	else
	{
		if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть рефералы игрока [ /referal ID ]");
		if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Длина никнейма не больше 20-ти символов");
		new giveplayerid;
	 	giveplayerid = ReturnUser(params[0], 1);
		if(IsOnline(giveplayerid)) show_referal(playerid, giveplayerid, 0);
		else
		{
			if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			new string[128];
			mysql_format(pearsq, string,sizeof(string),"SELECT RefReg, Ref5 FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
			mysql_tquery(pearsq, string, "Call_checkreferal", "ds", playerid, params[0]);
		}
	}
	return 1;
}
CMD:server(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new str[100],sctring[1100];
    format(str,sizeof(str),"{999999}Статистика..\n"), strcat(sctring,str);
    format(str,sizeof(str),"{cccccc}Промокоды\n"), strcat(sctring,str);
    format(str,sizeof(str),"{cccccc}Черный список лидеров\n"), strcat(sctring,str);
    if(freezereproof == 0) format(str,sizeof(str),"{cccccc}Авто-предупреждения {99ff66}[ On ]\n"), strcat(sctring,str);
    else format(str,sizeof(str),"{cccccc}Авто-предупреждения {FF6347}[ Off ]\n"), strcat(sctring,str);
    format(str,sizeof(str),"{444444}[ Мафии ] {cccccc}Интервал захвата порта [ %d минут ]\n",ServerInfo[38]), strcat(sctring,str);
    format(str,sizeof(str),"{444444}[ Мафии ] {cccccc}Интервал отдыха порта [ %d минут ]\n",ServerInfo[37]), strcat(sctring,str);
    format(str,sizeof(str),"{444444}[ Мафии ] {cccccc}Время захвата порта [ %d минут ]\n",ServerInfo[36]), strcat(sctring,str);
    format(str,sizeof(str),"{444444}[ Банды ] {cccccc}Интервал отдыха [ %d минут ]\n",ServerInfo[39]), strcat(sctring,str);
    format(str,sizeof(str),"{444444}[ Банды ] {cccccc}Интервал территории [ %d минут ]\n",ServerInfo[40]), strcat(sctring,str);
    format(str,sizeof(str),"{444444}[ Банды ] {cccccc}Стоимость территории [ %d$ в час ]\n",ServerInfo[43]), strcat(sctring,str);
	format(str,sizeof(str),"{444444}[ Инкассатор ] {cccccc}Мин. денег в машине [ %d$ ]\n",ServerInfo[44]), strcat(sctring,str);
	format(str,sizeof(str),"{444444}[ Инкассатор ] {cccccc}Макс. денег в машине [ %d$ ]\n",ServerInfo[48]), strcat(sctring,str);
	format(str,sizeof(str),"{444444}[ Самолёт ] {cccccc}Мин. денег в сумке [ %d$ ]\n",ServerInfo[3]), strcat(sctring,str);
	format(str,sizeof(str),"{444444}[ Самолёт ] {cccccc}Макс. денег в сумке [ %d$ ]\n",ServerInfo[4]), strcat(sctring,str);
	format(str,sizeof(str),"{444444}[ Bonus ] {cccccc}Часов в игре в день для получения шкатулки [ %d ]\n",ServerInfo[10]), strcat(sctring,str);
	ShowDialog(playerid,619,DIALOG_STYLE_LIST,"{cccccc}Настройки {ff9000}Сервера",sctring,"Выбрать","Отмена");
	return 1;
}
CMD:begin(playerid)
{
 	if(!IsMafiaMember(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не мафиозник");
 	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете начать захват сидя в транспорте..");
 	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в интерьере или виртуальном мире");
 	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
 	if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
 	if(MafGz[0][mStat] >= 1) return ErrorMessage(playerid, "{FF6347}В штате уже проходит битва мафий");

	{
		new tmphour;
		gettime(tmphour);
		if (tmphour < 11) return ErrorMessage(playerid, "{FF6347}Нельзя захватить порт ночью\n{ffcc66}Захваты доступны с 11:00 до 23:59");
	}

 	new Float:posic[3], g = fraction(playerid), psea, kol, youg, youkol, string[144], atext[24], unixtime = gettime();
	GetPlayerPos(playerid, posic[0], posic[1], posic[2]);

 	if(IsPlayerInSquare(playerid,-1739.7145, -103.8218,-1694.4082,-27.3040)) // Порт SF
  	{
  	    if(posic[2] <= 2.0 || posic[2] >= 18.0) return ErrorMessage(playerid, "{FF6347}Вы не находитесь в ангаре порта..");
  	    if(PortOwner[0] == g) return ErrorMessage(playerid, "{FF6347}Порт San Fierro принадлежит вашей организации");
  	    if(mafstat == 1 || mafstat == 3) return ErrorMessage(playerid, "{FF6347}Вы не можете атаковать порт, когда в нём находится корабль с продукцией");
  	    psea = 0, youg = PortOwner[0], atext = "Порт San Fierro";
  	}
  	else if(IsPlayerInSquare(playerid,2401.7756,-2641.1243,2447.0828,-2564.6064)) // Порт LS
  	{
  		if(posic[2] <= 12.0 || posic[2] >= 28.0) return ErrorMessage(playerid, "{FF6347}Вы не находитесь в ангаре порта..");
  		if(PortOwner[1] == g) return ErrorMessage(playerid, "{FF6347}Порт Los Santos принадлежит вашей организации");
  		if(mafstat == 2 || mafstat == 4) return ErrorMessage(playerid, "{FF6347}Вы не можете атаковать порт, когда в нём находится корабль с продукцией");
  		psea = 1, youg = PortOwner[1], atext = "Порт Los Santos";
  	}
	else return ErrorMessage(playerid, "{FF6347}Вы не находитесь в ангаре порта..");

	if(OrganInfo[g][gInterval] > unixtime) return format(string,sizeof(string),"{FF6347}Ваша мафия недавно сражалась за порт\n{cccccc}Бойцам необходимо отдохнуть %s", fine_time(OrganInfo[g][gInterval]-unixtime)), ErrorMessage(playerid, string);
  	if(PortInfo[wStat] >= 1) return ErrorMessage(playerid, "{FF6347}В одном из портов или складов уже идёт битва");
  	if(PortInterval[psea] > unixtime) return format(string,sizeof(string),"{FF6347}Битва за этот порт происходила совсем недавно\n{cccccc}Необходимо подождать %s", fine_time(PortInterval[psea]-unixtime)), ErrorMessage(playerid, string);
  	if(OrganInfo[g][gBattle] >= 1 || NarcoFarmIsMafiaBattleActive(g)) return ErrorMessage(playerid, "{FF6347}Ваша мафия сейчас с кем-то сражается\n{cccccc}Проведение нескольких битв одновременно, невозможно");
	if(youg >= 1 && OrganInfo[youg][gBattle] >= 1 || NarcoFarmIsMafiaBattleActive(youg)) return ErrorMessage(playerid, "{FF6347}Владельцы порта уже с кем-то сражаются\n{cccccc}Проведение нескольких битв одновременно, невозможно");
	if(youg >= 1 &&OrganInfo[youg][gInterval] > unixtime) return format(string,sizeof(string),"{FF6347}Эта мафия недавно сражалась за порт\n{cccccc}Бойцам необходимо отдохнуть %s", fine_time(OrganInfo[youg][gInterval]-unixtime)), ErrorMessage(playerid, string);
  	foreach(Player, i)
	{
		if(OnlineInfo[i][oLogged] == 0) continue;
		if(youg >= 1 && youg == fraction(i)) youkol ++;
		if(g != fraction(i)) continue;
		if(psea == 0)
		{
		    if(IsPlayerInSquare(i,-1739.7145, -103.8218,-1694.4082,-27.3040)) kol ++;
		}
		else if(psea == 1)
		{
		    if(IsPlayerInSquare(i,2401.7756,-2641.1243,2447.0828,-2564.6064)) kol ++;
		}
	}
	if(kol <= 2 && PlayerInfo[playerid][pSoska] < 20) return ErrorMessage(playerid, "{FF6347}Вам требуется больше бойцов для начала захвата [ 3+ ]");
	if(youg >= 1 && youkol <= 2 && PlayerInfo[playerid][pSoska] < 20) return ErrorMessage(playerid, "{FF6347}Недостаточно участников мафии, которая владеет этим портом [ Online 3+ ]");
	PlayAudioMember(g, "https://cdn.pears.fun/sound/war1.mp3");
	PortInfo[wOne] = g;
	if(ServerInfo[36] <= 0) PortInfo[wTime] = 600;
	else PortInfo[wTime] = ServerInfo[36]*60;
	OrganInfo[g][gBattle] = 1;
	if(youg >= 1)
	{
		PlayAudioMember(youg, "https://cdn.pears.fun/sound/war2.mp3");
		PortInfo[wTwo] = youg;
		OrganInfo[youg][gBattle] = 1;
		format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}Внимание! {cccccc}Ваше имущество {ff9000}%s {cccccc}был атакован %s", atext, frakName[g]), SendRadioMessage(youg,COLOR_LIGHTRED,string);
		format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}Захват будет завершён через: {ff9000}%d минут", PortInfo[wTime]/60), SendRadioMessage(youg, COLOR_LIGHTRED, string);
	}
	if(youg >= 1) format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}%s начал захват {ff9000}%s %s",playername(playerid), atext, frakName[youg]), SendRadioMessage(g, COLOR_LIGHTRED, string);
	else format(string,sizeof(string),"{444444}[ Mafia ] {FF6347}%s начал захват {ff9000}%s",playername(playerid), atext), SendRadioMessage(g, COLOR_LIGHTRED, string);
	SetPlayerChatBubble(playerid,"начинает захват",COLOR_PURPLE,35.0,10000);
	OrgLog(g, "begin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", youg, atext);
	if(psea == 1) {
		// Открываем ворота (Порт LS)
		MoveDynamicObject(Vorota[139], 2420.523925, -2564.403076, 10.608008 - 5.0, 1.4);
		Statvorota[145] = PortInfo[wTime];
	}
	PortInfo[wNumer] += 1;
	Zahvat[g] = youg;
	Zahvat[youg] = g;
	foreach(Player, x)
	{
		if(OnlineInfo[x][oLogged] == 0) continue;
		if(youg >= 1 && youg == fraction(x)) MafiaBattle[1][x] = 0, SetPlayerToTeamColor(x), show_mafiabattle(x);
		if(g != fraction(x)) continue;
		if(psea == 0)
		{
		    if(IsPlayerInSquare(x,-1739.7145, -103.8218,-1694.4082,-27.3040)) MafiaBattle[0][x] = 1, SetPlayerToTeamColor(x), show_mafiabattle(x);
		}
		else if(psea == 1)
		{
		    if(IsPlayerInSquare(x,2401.7756,-2641.1243,2447.0828,-2564.6064)) MafiaBattle[0][x] = 2, SetPlayerToTeamColor(x), show_mafiabattle(x);
		}
	}
	PortInfo[wStat] = psea+1;
	return 1;
}

stock SelectBizMafiaWar(playerid, giveplayerid, b) // Выбрали бизнес для стрелы
{
	Qwerty[4][playerid] = 1; // [1 BIZ]  [2 MONEY]
	Qwerty[3][playerid] = b;

	new g = fraction(playerid);
	new hg = fraction(giveplayerid);

	if(b <= 0 || b >= 201) return ShowDialog(playerid,746,DIALOG_STYLE_INPUT,"{ff9000}Mafia","{FF6347}Неверный номер бизнеса\n{cccccc}Введите номер бизнеса в качестве ставки на стрелу","Принять","Отмена"), PlayerPlaySound(playerid,4203,0,0,0);
	if(BizzInfo[b][bMafia] != g) return ShowDialog(playerid,746,DIALOG_STYLE_INPUT,"{ff9000}Mafia","{FF6347}Этот бизнес не принадлежит вашей мафии\n{cccccc}Введите номер бизнеса в качестве ставки на стрелу","Принять","Отмена"), PlayerPlaySound(playerid,4203,0,0,0);

	new string[160];

	if(Qwerty[4][giveplayerid] > 0)
	{
		format(string, sizeof(string), "{cccccc}%s главный в %s {cccccc}ставит %s в качестве ставки\n\nЕсли вы согласны на условия, нажмите << Да >>",playername(playerid),frakName[g],bizname(b));
		ShowDialog(giveplayerid,807,DIALOG_STYLE_MSGBOX,"{ff9000}Mafia",string,"Да","Нет");
	}
	else
	{
		new line[200],lines[600];
    	format(line,sizeof(line),"{cccccc}%s ставит {ff9000}%s № %d", playername(playerid), bizname(b), b), strcat(lines,line);
    	format(line,sizeof(line),"\n{ff9000}Бизнес"), strcat(lines,line);
		format(line,sizeof(line),"\n{99ff66}Деньги"), strcat(lines,line);
		ShowDialog(giveplayerid,805,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Выберите вашу ставку",lines,"Выбор","Отмена");
	}

	format(string, sizeof(string), "[ Мысли ]: Я ставлю %s против %s",bizname(b),frakName[hg]);
	SendClientMessage(playerid,COLOR_GREY,string);
	format(string, sizeof(string), "ставит %s против %s",bizname(b),frakName[hg]);
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,8000);
	format(string, sizeof(string), "* %s ставит %s против %s", playername(playerid),bizname(b),frakName[hg]);
	ProxDetector(25.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	PlayerPlaySound(playerid,1053,0,0,0);
	PlayerPlaySound(giveplayerid,1052,0,0,0);
	return 1;
}

stock SelectMoneyMafiaWar(playerid, giveplayerid, money)
{
	new g = fraction(playerid);
	new hg = fraction(giveplayerid);

	if(money > 10000000 || money < 100000) return showDialogBetMoneyMafia(playerid), PlayerPlaySound(playerid,4203,0,0,0);
	if(OrganInfo[g][glave] < money) return showDialogBetMoneyMafia(playerid), PlayerPlaySound(playerid,4203,0,0,0);

	Qwerty[4][playerid] = 2; // [1 BIZ]  [2 MONEY]
	Qwerty[3][playerid] = money;

	new string[160];

	if(Qwerty[4][giveplayerid] > 0)
	{
		format(string, sizeof(string), "{cccccc}%s главный в %s {cccccc}ставии %d$ [%s] в качестве ставки\n\nЕсли вы согласны на условия, нажмите << Да >>",playername(playerid),frakName[g],money,get_k(money));
		ShowDialog(giveplayerid,807,DIALOG_STYLE_MSGBOX,"{ff9000}Mafia",string,"Да","Нет");
	}
	else
	{
		new line[200],lines[600];
    	format(line,sizeof(line),"{cccccc}%s ставит {99ff66}%d$ {cccccc}[%s]", playername(playerid), money, get_k(money)), strcat(lines,line);
    	format(line,sizeof(line),"\n{ff9000}Бизнес"), strcat(lines,line);
		format(line,sizeof(line),"\n{99ff66}Деньги"), strcat(lines,line);
		ShowDialog(giveplayerid,805,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Выберите вашу ставку",lines,"Выбор","Отмена");
	}

	format(string, sizeof(string), "[ Мысли ]: Я ставлю %d$ [%s] против %s", money, get_k(money), frakName[hg]);
	SendClientMessage(playerid,COLOR_GREY,string);
	format(string, sizeof(string), "ставит %d$ [%s] против %s", money, get_k(money), frakName[hg]);
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,8000);
	format(string, sizeof(string), "* %s ставит %d$ [%s] против %s", playername(playerid),money, get_k(money),frakName[hg]);
	ProxDetector(25.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	PlayerPlaySound(playerid,1053,0,0,0);
	PlayerPlaySound(giveplayerid,1052,0,0,0);
	return 1;
}

stock CancelSelectMafWar(playerid)
{
	new giveplayerid = Qwerty[2][playerid];

	if(IsOnline(giveplayerid)
		&& ProxDetectorS(5.0, playerid, giveplayerid))
	{
		if(Qwerty[4][giveplayerid] > 0)
		{
			new string[100];
			format(string, sizeof(string), "{FF6347}%s отказывается принимать ваши условия стрелы", playername(playerid));
			ErrorMessage(giveplayerid, string);
			ErrorMessage(playerid, "{FF6347}Вы отказались принимать условия стрелы");
		}
	}
	return 1;
}

stock CheckMafiaPermission(playerid, giveplayerid)
{
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вы в транспорте");
	new tmphour, tmpminute, tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	if((tmphour < 15 || tmphour > 22) && server > 0) return ErrorMessage(playerid, "{FF6347}Забивать стрелу можно в дневное время суток {cccccc}15:00 - 22:00");
	if(MafGz[0][mStat] >= 1) return ErrorMessage(playerid, "{FF6347}В штате уже происходит одна битва{cccccc}\nДождитесь её завершения");
	if(IsANotMoney(playerid)) return ErrorMessage(playerid, "{FF6347}Нельзя назначать стрелу на территории города");

	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(5.0, playerid, giveplayerid)) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко от игрока");

	new g = fraction(playerid);
	new hg = fraction(giveplayerid);
	if(hg != 5 && hg != 6 && hg != 10 && hg != 12 && hg != 18) return ErrorMessage(playerid, "{FF6347}Этот игрок не мафиозник{cccccc}\nЗдесь нужен Зубенко Михаил Петрович");
	if(g == hg) return ErrorMessage(playerid, "{FF6347}Нельзя забить стрелу собственной мафии");
	if(PlayerInfo[giveplayerid][pRank] < get_maxrank(hg) - 1) return ErrorMessage(playerid, "{FF6347}Забить стрелу можно лидеру или заместителю лидера");
	return 0;
}

CMD:mafia(playerid, const params[]) // 1) Начинаем битву
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(26, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не участник мафии");
	if(!GetAccessRankOrg(playerid, g, 26, NO_FBI)) return 1;
	
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Забить стрелу мафии [ /mafia ID Лидера ]");
	if(CheckMafiaPermission(playerid, params[0])) return 1;
	
	// Сбрасываем выбранные условия
	Qwerty[4][playerid] = 0;
	Qwerty[4][params[0]] = 0;

	Qwerty[3][playerid] = 0;
	Qwerty[3][params[0]] = 0;

	// Записываем id
	Qwerty[2][playerid] = params[0];
	Qwerty[2][params[0]] = playerid;

	ShowDialog(playerid,805,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Mafia","{cccccc}Выберите вашу ставку\n{ff9000}Бизнес\n{99ff66}Деньги","Выбор","Отмена");
	return 1;
}
CMD:limitcapt(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Ограничить использование +C на капте [ /limitcapt ID Фракции Срок ]");
	if(params[1] < 0 || params[1] > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Срок ограничения от 0 до 30 дней");
	if(params[0] != 13 && params[0] != 14 && params[0] != 15 && params[0] != 16 && params[0] != 17 && params[0] != 19 && params[0] != 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только номер банды [ 13,14,15,16,17,19,20 ]");
	new string[128];
	new unixtime = gettime();
	if(params[1] >= 1)
	{
		OrganInfo[params[0]][gSanCbug] = unixtime+params[1]*86400;
		format(string,sizeof(string),"{0088ff}[ GANG ZONE ]: {ffffff}%s администратор ограничил +C на %d дней",PlayerInfo[playerid][pName],params[1]);
		SendRadioMessage(params[0],COLOR_GREY,string);
		format(string, sizeof(string), " [ ADM ]: Админ %s ограничил %s {cccccc}[ +C на %d дней ]", PlayerInfo[playerid][pName],frakName[params[0]],params[1]);
		ABroadCast(COLOR_ADM,string,1);
		SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Ограничение на +C установлено");
		OrgLog(params[0], "limitcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Ограничил +C");
		AdminLog("limitcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Ограничил +C");
	}
	else
	{
		if(OrganInfo[params[0]][gSanCbug] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У банды не стоит ограничение на +C");
		OrganInfo[params[0]][gSanCbug] = 0;
		format(string,sizeof(string),"{0088ff}[ GANG ZONE ]: {ffffff}%s администратор снял ограничение +C",PlayerInfo[playerid][pName]);
		SendRadioMessage(params[0],COLOR_GREY,string);
		format(string, sizeof(string), " [ ADM ]: Админ %s снял ограничение %s {cccccc}[ +C ]", PlayerInfo[playerid][pName],frakName[params[0]]);
		ABroadCast(COLOR_ADM,string,1);
		SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Ограничение на +C снято");
		OrgLog(params[0], "limitcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Снял ограничение +C");
		AdminLog("limitcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Снял ограничение +C");
	}
	OrganInfo[params[0]][gUpdate] = 1;
	return 1;
}
stock ShowGang(p, t)
{
	new str[214],sctring[4096];

	if(PlayerInfo[t][pMyWar] != 0 && PlayerInfo[t][pMyWar] != ServerInfo[41]) format(str,sizeof(str)," \t{FF6347}Война № %d\t{cccccc}Всё время", PlayerInfo[t][pMyWar]), strcat(sctring,str);
	else format(str,sizeof(str)," \t{FF6347}Текущая Война\t{cccccc}Всё время"), strcat(sctring,str);


	if(PlayerInfo[t][pMyWar] == 0) format(str,sizeof(str),"\n{cccccc}Статус: {FF6347}нет участия в войнах \t \t "), strcat(sctring,str);
	else
	{
		if(PlayerInfo[t][pMyWar] == ServerInfo[41]) format(str,sizeof(str),"\n{cccccc}Статус: {99ff66}участие в текущей войне \t \t "), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Статус: {FF6347}нет участия в текущей войне \t \t "), strcat(sctring,str);
	}

	format(str,sizeof(str),"\n{cccccc}Убийства: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][0],PlayerInfo[t][pGangAll][0]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Убийства [+C]: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][1],PlayerInfo[t][pGangAll][1]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Смерти: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][2],PlayerInfo[t][pGangAll][2]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Смерти [+C]: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][3],PlayerInfo[t][pGangAll][3]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Нанесено Урона HP: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][4],PlayerInfo[t][pGangAll][4]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Получено Урона HP: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][5],PlayerInfo[t][pGangAll][5]), strcat(sctring,str); // +

	format(str,sizeof(str),"\n{cccccc}Использовано Бинтов: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][6],PlayerInfo[t][pGangAll][6]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Использовано Травы: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][7],PlayerInfo[t][pGangAll][7]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Использовано Таблеток: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][8],PlayerInfo[t][pGangAll][8]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Использовано Грибов: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][9],PlayerInfo[t][pGangAll][9]), strcat(sctring,str); // +
	format(str,sizeof(str),"\n{cccccc}Использовано Порошка: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][10],PlayerInfo[t][pGangAll][10]), strcat(sctring,str); // +

	format(str,sizeof(str),"\n{666666}Выстрелы: \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}По противнику: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][11],PlayerInfo[t][pGangAll][11]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}По своим: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][12],PlayerInfo[t][pGangAll][12]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}По посторонним: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][13],PlayerInfo[t][pGangAll][13]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}По транспорту: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][14],PlayerInfo[t][pGangAll][14]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Промахов: \t{FF6347}%d\t {cccccc}%d",PlayerInfo[t][pGangCapt][15],PlayerInfo[t][pGangAll][15]), strcat(sctring,str);

	new year, month, day;
	getdate(year, month, day);
	format(str,sizeof(str),"{ff9000}%s %s {666666}| Война Банд № %d [ %02d.%02d.%d ]", PlayerInfo[t][pName], frakName[fraction(t)], ServerInfo[41], day, month, year);
	ShowDialog(p,1742,DIALOG_STYLE_TABLIST_HEADERS, str, sctring,"*","");
	return 1;
}
CMD:nametag(playerid)
{
	if(NameTag[playerid] == false)
	{
		if(PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
		//new g = fraction(playerid);
		//if(!IsAFunctionOrganization(70, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
		//if(!GetAccessRankOrg(playerid, g, 70, NO_FBI)) return 1;

		if(GetPlayerVirtualWorld(playerid) == 2001 && GetPlayerInterior(playerid) == 55) return ErrorMessage(playerid, "{FF6347}Запрещено в казино");
		NameTag[playerid] = true;
		foreach(Player,i)
		{
			if(ADUTY[i] == 0) ShowPlayerNameTagForPlayer(i, playerid, false);
		}
		if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я закрыл своё лицо {FF6347}[ Никнейм отключён ]");
		else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я закрыла своё лицо {FF6347}[ Никнейм отключён ]");
	}
	else if(NameTag[playerid] == true)
	{
		NameTag[playerid] = false;
		foreach(Player,i)
		{
			if(ADUTY[i] == 0) ShowPlayerNameTagForPlayer(i, playerid, true);
		}
		if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я открыл своё лицо {99ff66}[ Никнейм включён ]");
		else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я открыла своё лицо {99ff66}[ Никнейм включён ]");
	}
	return 1;
}
function call_checkgang(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new str[124], sctring[3720], year, month, day, datad[40], g;
  		cache_get_value_name_int(0, "Member", datad[0]);
  		cache_get_value_name_int(0, "Leader", datad[1]);
    	if(datad[0] == 13 || datad[0] == 14 || datad[0] == 15 || datad[0] == 16 || datad[1] == 13 || datad[1] == 14 || datad[1] == 15 || datad[1] == 16)
    	{
    		getdate(year, month, day);
	    	cache_get_value_name_int(0, "Unit", datad[2]);
	    	cache_get_value_name_int(0, "MyWar", datad[3]);
	    	cache_get_value_name_int(0, "GangCapt0", datad[4]);
			cache_get_value_name_int(0, "GangCapt1", datad[5]);
	    	cache_get_value_name_int(0, "GangCapt2", datad[6]);
	    	cache_get_value_name_int(0, "GangCapt3", datad[7]);
			cache_get_value_name_int(0, "GangCapt4", datad[8]);
	    	cache_get_value_name_int(0, "GangCapt5", datad[9]);
	    	cache_get_value_name_int(0, "GangCapt6", datad[10]);
	    	cache_get_value_name_int(0, "GangCapt7", datad[11]);
	    	cache_get_value_name_int(0, "GangCapt8", datad[12]);
	    	cache_get_value_name_int(0, "GangCapt9", datad[13]);
	    	cache_get_value_name_int(0, "GangCapt10", datad[14]);
	    	cache_get_value_name_int(0, "GangCapt11", datad[15]);
	    	cache_get_value_name_int(0, "GangCapt12", datad[16]);
	    	cache_get_value_name_int(0, "GangCapt13", datad[17]);
	    	cache_get_value_name_int(0, "GangCapt14", datad[18]);
	    	cache_get_value_name_int(0, "GangCapt15", datad[19]);
	    	cache_get_value_name_int(0, "GangAll0", datad[20]);
			cache_get_value_name_int(0, "GangAll1", datad[21]);
	    	cache_get_value_name_int(0, "GangAll2", datad[22]);
	    	cache_get_value_name_int(0, "GangAll3", datad[23]);
			cache_get_value_name_int(0, "GangAll4", datad[24]);
	    	cache_get_value_name_int(0, "GangAll5", datad[25]);
	    	cache_get_value_name_int(0, "GangAll6", datad[26]);
	    	cache_get_value_name_int(0, "GangAll7", datad[27]);
	    	cache_get_value_name_int(0, "GangAll8", datad[28]);
	    	cache_get_value_name_int(0, "GangAll9", datad[29]);
	    	cache_get_value_name_int(0, "GangAll10", datad[30]);
	    	cache_get_value_name_int(0, "GangAll11", datad[31]);
	    	cache_get_value_name_int(0, "GangAll12", datad[32]);
	    	cache_get_value_name_int(0, "GangAll13", datad[33]);
	    	cache_get_value_name_int(0, "GangAll14", datad[34]);
	    	cache_get_value_name_int(0, "GangAll15", datad[35]);
			if(datad[1] >= 1) g = datad[1];
			else if(datad[1] == 0) g = datad[0];
			format(str,sizeof(str),"\n{ff9000}Текущая Война № %d",ServerInfo[41]), strcat(sctring,str);
			format(str,sizeof(str),"\n{ff9000}Дата: %02d.%02d.%d", day, month, year), strcat(sctring,str);
			format(str,sizeof(str),"\n{ff9000}%s {cccccc}[ %s {cccccc}]", str_name, frakName[g]), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Юниты: {0088ff}%dU", datad[2]), strcat(sctring,str);
			if(datad[3] == 0)
			{
				format(str,sizeof(str),"\n{cccccc}Статус: {FF6347}нет участия в войнах"), strcat(sctring,str);
				format(str,sizeof(str),"\n\n\n\t\t{FF6347}Текущая Война\t{444444}Всё время"), strcat(sctring,str);
			}
			else
			{
				if(datad[3] == ServerInfo[41])
				{
					format(str,sizeof(str),"\n{cccccc}Статус: {99ff66}участие в текущей войне"), strcat(sctring,str);
					format(str,sizeof(str),"\n\n\n\t\t{444444}Текущая Война\tВсё время"), strcat(sctring,str);
				}
				else if(datad[3] != ServerInfo[41])
				{
					format(str,sizeof(str),"\n{cccccc}Статус: {FF6347}нет участия в текущей войне"), strcat(sctring,str);
					format(str,sizeof(str),"\n\n\n\t\t{FF6347}Война № %d\t{444444}Всё время", datad[3]), strcat(sctring,str);
				}
			}
			format(str,sizeof(str),"\n{cccccc}Убийства:\t\t\t{ffffff}%d\t%d",datad[4],datad[20]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Убийства [+C]:\t\t\t{ffffff}%d\t%d",datad[5],datad[21]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Смерти:\t\t\t{ffffff}%d\t%d",datad[6],datad[22]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Смерти [+C]:\t\t\t{ffffff}%d\t%d",datad[7],datad[23]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Нанесено Урона HP:\t\t{ffffff}%d\t%d",datad[8],datad[24]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Потеряно HP:\t\t\t{ffffff}%d\t%d",datad[9],datad[25]), strcat(sctring,str); // +

			format(str,sizeof(str),"\n\n{cccccc}Использовано Аптечек:\t{ffffff}%d\t%d",datad[10],datad[26]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Использовано Травы:\t{ffffff}%d\t%d",datad[11],datad[27]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Использовано Спиды:\t\t{ffffff}%d\t%d",datad[12],datad[28]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Использовано Грибы:\t\t{ffffff}%d\t%d",datad[13],datad[29]), strcat(sctring,str); // +
			format(str,sizeof(str),"\n{cccccc}Использовано Порошок:\t\t{ffffff}%d\t%d",datad[14],datad[30]), strcat(sctring,str); // +

			format(str,sizeof(str),"\n\n{444444}Выстрелы:"), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}По противнику:\t\t{ffffff}%d\t%d",datad[15],datad[31]), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}По своим:\t\t\t{ffffff}%d\t%d",datad[16],datad[32]), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}По посторонним:\t\t{ffffff}%d\t%d",datad[17],datad[33]), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}По транспорту:\t\t\t{ffffff}%d\t%d",datad[18],datad[34]), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Промахов:\t\t\t{ffffff}%d\t%d",datad[19],datad[35]), strcat(sctring,str);

			format(str,sizeof(str),"\n\n\n{444444}О статистике:"), strcat(sctring,str);
			format(str,sizeof(str),"\n{444444}- Юниты начисляются только по окончанию капта"), strcat(sctring,str);
			format(str,sizeof(str),"\n{444444}- Статистика пополняется только по окончанию капта"), strcat(sctring,str);
			format(str,sizeof(str),"\n{444444}- Каждый пункт засчитывается только при условии нахождения на капте [В квадрате]\n"), strcat(sctring,str);
			ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Статистика Бандита",sctring,"*","");
		}
		else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Он не участник банды");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}

alias:checkpcapt("cpcapt")
CMD:checkpcapt(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	new tmp[24], gp;
	if(sscanf(params, "s[24]",tmp)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Посмотреть статистику бандита [ /checkcapt ID ]");
	gp = ReturnUser(tmp, 1);
    if(IsOnline(gp))
	{
		if(!IsAGangCapt(gp)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Он не участник банды");
		ShowGang(playerid, gp), PlayerPlaySound(playerid,40405,0,0,0);
	}
    else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		new string[68];
  		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "call_checkgang", "ds", playerid, tmp);
	}
	return 1;
}

CMD:gang(playerid)
{
	if(IsAGangCapt(playerid) || PlayerInfo[playerid][pSoska] >= 2)
	{
		ShowDialog(playerid,1010,DIALOG_STYLE_LIST,"{cccccc}Статистика Гетто","{ff9000}Личная Информация\n{cccccc}Статистика Банд\n{cccccc}Топ текущей войны\n{cccccc}Топ за всё время","Выбрать","Отмена");
	}
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не участник банды");
	return 1;
}

CMD:pcapt(playerid)
{
	if(IsAGangCapt(playerid)) ShowGang(playerid, playerid), PlayerPlaySound(playerid,40405,0,0,0);
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не участник банды");
	return 1;
}
CMD:tcapt(playerid)
{
	if(PlayerInfo[playerid][pMember] == 13 || PlayerInfo[playerid][pMember] == 15 || PlayerInfo[playerid][pMember] == 14
	|| PlayerInfo[playerid][pLeader] == 16 || PlayerInfo[playerid][pSoska] >= 1
	|| PlayerInfo[playerid][pLeader] == 13 || PlayerInfo[playerid][pLeader] == 15 || PlayerInfo[playerid][pLeader] == 14 || PlayerInfo[playerid][pMember] == 16)
	{
		PlayerPlaySound(playerid,40405,0,0,0);
		new str[132], sctring[3720], year, month, day;
		getdate(year, month, day);
		format(str,sizeof(str),"\n{ff9000}Текущая Война № %d",ServerInfo[41]), strcat(sctring,str);
		format(str,sizeof(str),"\n{ff9000}Дата: %02d.%02d.%d", day, month, year), strcat(sctring,str);

		format(str,sizeof(str),"\n\n{cccccc}Топ по Убийствам {444444}[ KILLER ]"), strcat(sctring,str);
		for(new t = 0; t < 5; t++)
		{
			if(TopInfo[t][tWar][0] == 0) format(str,sizeof(str),"\n{cccccc}..."), strcat(sctring,str);
			else
			{
				if(t == 0) format(str,sizeof(str),"\n{0088ff}%s: %d", TopInfo[t][tWarNameK], TopInfo[t][tWar][0]), strcat(sctring,str);
				else format(str,sizeof(str),"\n{cccccc}%s: %d", TopInfo[t][tWarNameK], TopInfo[t][tWar][0]), strcat(sctring,str);
			}
		}

		format(str,sizeof(str),"\n\n{cccccc}Топ по HP {444444}[ BUTCHER ]"), strcat(sctring,str);
		for(new t = 0; t < 5; t++)
		{
			if(TopInfo[t][tWar][1] == 0) format(str,sizeof(str),"\n{cccccc}..."), strcat(sctring,str);
			else
			{
				if(t == 0) format(str,sizeof(str),"\n{0088ff}%s: %d", TopInfo[t][tWarNameB], TopInfo[t][tWar][1]), strcat(sctring,str);
				else format(str,sizeof(str),"\n{cccccc}%s: %d", TopInfo[t][tWarNameB], TopInfo[t][tWar][1]), strcat(sctring,str);
			}
		}

		format(str,sizeof(str),"\n\n{cccccc}Топ по +C {444444}[ SHOOTER ]"), strcat(sctring,str);
		for(new t = 0; t < 5; t++)
		{
			if(TopInfo[t][tWar][2] == 0) format(str,sizeof(str),"\n{cccccc}..."), strcat(sctring,str);
			else
			{
				if(t == 0) format(str,sizeof(str),"\n{0088ff}%s: %d", TopInfo[t][tWarNameS], TopInfo[t][tWar][2]), strcat(sctring,str);
				else format(str,sizeof(str),"\n{cccccc}%s: %d", TopInfo[t][tWarNameS], TopInfo[t][tWar][2]), strcat(sctring,str);
			}
		}

		format(str,sizeof(str),"\n\n\n{444444}О топе:"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}- Топ обновляется только по окончанию капта"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}- Каждый пункт засчитывается только при условии нахождения на капте [В квадрате]\n"), strcat(sctring,str);
		ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Топ Банд",sctring,"*","");
	}
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу посмотреть топ банд");
	return 1;
}
