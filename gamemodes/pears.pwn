stock FindTrash(playerid)
{
	new e_CityArea: city = e_CityArea: GetPlayerCityArea(playerid), minTrash = 0, maxTrash = 199;
	if(city == CITY_AREA_SAN_FIERRO) minTrash = 200, maxTrash = 349;
	else if(city == CITY_AREA_LAS_VENTURAS) minTrash = 350, maxTrash = 500;

	new findTrash = -1;
	for(new tr = minTrash; tr < maxTrash; tr++)
	{
	    if(trash_empty[tr] > 0)
		{
			findTrash = tr;
			break;
		}
	}
	if(findTrash == -1) return ErrorMessage(playerid, "{FF6347}Все мусорные контейнеры в городе пустые\n{cccccc}Для пополнения контейнеров подождите около 5-ти минут");

	new Float:dist, Float:findpos, kakoi = findTrash, quan;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, TrashPos[findTrash][TrashPos_X], TrashPos[findTrash][TrashPos_Y], TrashPos[findTrash][TrashPos_Z]);
	for(new i = 0; i < MAX_TRASH; ++i)
	{
	    if(trash_empty[i] > 0)
	    {
	        quan ++;
	    	findpos = GetDistancePoint(x, y, z, TrashPos[i][TrashPos_X], TrashPos[i][TrashPos_Y], TrashPos[i][TrashPos_Z]);
	    	if(findpos <= dist) dist = findpos, kakoi = i;
		}
	}
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Ближайший контейнер с мусором отмечен в вашем GPS","*","");
	CreateGps(playerid, TrashPos[kakoi][TrashPos_X], TrashPos[kakoi][TrashPos_Y], TrashPos[kakoi][TrashPos_Z], 0, 0, 5.0);
	return 1;
}
stock FindTrashRoad(playerid)
{
	new e_CityArea: city = e_CityArea: GetPlayerCityArea(playerid), minTrash = 0, maxTrash = 100;
	if(city == CITY_AREA_SAN_FIERRO) minTrash = 101, maxTrash = 200;
	else if(city == CITY_AREA_LAS_VENTURAS) minTrash = 201, maxTrash = 300;

	new findTrash = -1;
	for(new tr = minTrash; tr < maxTrash; tr++)
	{
	    if(trashroad_stat[tr] > 0)
		{
			findTrash = tr;
			break;
		}
	}
	if(findTrash == -1) return ErrorMessage(playerid, "{FF6347}Все дороги в городе чистые\n{cccccc}Дороги загрязняются со временем");

	new Float:dist, Float:findpos = findTrash, kakoi;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, TrashRoad[findTrash][TrashRoad_X], TrashRoad[findTrash][TrashRoad_Y], TrashRoad[findTrash][TrashRoad_Z]);
	for(new tr = 0; tr < MAX_TRASHROAD; tr++)
	{
	    if(trashroad_stat[tr] > 0)
		{
	    	findpos = GetDistancePoint(x, y, z, TrashRoad[tr][TrashRoad_X], TrashRoad[tr][TrashRoad_Y], TrashRoad[tr][TrashRoad_Z]);
	    	if(findpos <= dist) dist = findpos, kakoi = tr;
		}
	}
	if(PlayerInfo[playerid][pJobHint]) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Ближайший мусор на дороге отмечен в вашем GPS\n\n{99ff66}Мыть дорогу: {ff9000}CAPS LOCK (Гудок) или H","*","");
	CreateGps(playerid, TrashRoad[kakoi][TrashRoad_X], TrashRoad[kakoi][TrashRoad_Y], TrashRoad[kakoi][TrashRoad_Z], 0, 0, 5.0);
	return 1;
}
