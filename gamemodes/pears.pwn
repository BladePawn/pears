stock TakeChest(p)
{
	if(IsChest(p))
	{
		new put_inva = GiveThingPlayer(p, 49, 1, 0, 0, 0, 0, 9999);
		if(put_inva == -1) return ErrorMessage(p, "{FF6347}У вас нет места в инвентаре");
		update_ability(p, 0, 400);
  		PlayerPlaySound(p,6401,0,0,0);
		DestroyDynamicObject(SeaChestObj);
		DestroyDynamic3DTextLabel(SeaChestText);
		SeaChestStat = 0;
		new string[100];
		CompleteBattlePassTask(p, 13, 1);
		foreach (Player, i)
		{
	 		if(Dei[i] == 3)
	 		{
	 			format(string,sizeof(string)," {0088ff}[ SeaMap ]: {ffcc66}%s {0088ff}нашёл сундук с сокровищами!", rpplayername(p));
				SendClientMessage(i, COLOR_GREY, string);
			 	Update_Seachest(i);
		 	}
		}
		if(PlayerInfo[p][pAchieve][75] == 0) AchievePlayer(p, 75, 1);

		UserLog("chest", PlayerInfo[p][pID], PlayerInfo[p][pName], PlayerInfo[p][pPlaIP], 0, "", "", 0, "Нашёл сундук");
	}
	return 1;
}
stock IsChest(p)
{
	if(GetPlayerInterior(p) == 0 && GetPlayerVirtualWorld(p) == 0 && GetPlayerState(p) == PLAYER_STATE_ONFOOT && SeaChestStat == 1)
	{
		new Float:pos[3];
		GetDynamicObjectPos(SeaChestObj, pos[0], pos[1], pos[2]);
		if(IsPlayerInRangeOfPoint(p,3.0,pos[0], pos[1], pos[2])) return 1;
	}
	return 0;
}
