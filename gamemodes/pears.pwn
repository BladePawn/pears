}
CMD:fmoney(playerid)
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily], string[124];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3021 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccmoninv]) return format(string,sizeof(string),"[ Мысли ]: Я не могу открывать или закрывать счёт семьи [ %d+ Ранг ]",FamilyInfo[f][fAccmoninv]), SendClientMessage(playerid, COLOR_GREY, string), pc_cmd_fam(playerid);
	if(FamilyInfo[f][fInvmon] == 0)
	{
		format(string, sizeof(string), "{66ffff}Family {ffcc00}%s закрыл банковский счёт семьи", PlayerInfo[playerid][pName]);
  		SendFamilyMessage(f, COLOR_YELLOW, string);
  		FamilyInfo[f][fInvmon] = 1;
	}
	else
	{
		format(string, sizeof(string), "{66ffff}Family {ffcc00}%s открыл банковский счёт семьи", PlayerInfo[playerid][pName]);
  		SendFamilyMessage(f, COLOR_YELLOW, string);
  		FamilyInfo[f][fInvmon] = 0;
	}
	FamilyInfo[f][fUpdate] = 1;
	pc_cmd_fam(playerid);
	return 1;
}
CMD:domdonate(playerid)
{
	new d = PlayerInfo[playerid][pDom];
	if(!d) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет дома");
	new string[2000];
	format(string, sizeof(string), "%s{cccccc}Увеличенный лимит объектов в интерьере \t{%s}[ %dG ]\n", string, DomInfo[d][dMoreIntObjects] ? "444444" : "ffcc00", donatePrice[16]);

	ShowDialog(playerid, DOM_DIALOG_DONATE, DIALOG_STYLE_TABLIST, "House", string, "Выбрать", "Выход");
	return 1;
}
CMD:famdonate(playerid)
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily], string[144];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3031 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccdon]) return format(string,sizeof(string),"[ Мысли ]: Я не могу устанавливать улучшения в семью [ %d+ Ранг ]",FamilyInfo[f][fAccdon]), SendClientMessage(playerid, COLOR_GREY, string), pc_cmd_fam(playerid);
	new str[144],sctring[2000];
	if(FamilyInfo[f][fStatusUch] == 0) format(str,sizeof(str),"{cccccc}Неограниченное кол-во участников \t{ffcc00}[ 100G ]\n"), strcat(sctring,str);
	else if(FamilyInfo[f][fStatusUch] >= 1) format(str,sizeof(str),"{cccccc}Неограниченное кол-во участников \t{444444}[ 100G ]\n"), strcat(sctring,str);
	if(FamilyInfo[f][fStatusRank] == 0) format(str,sizeof(str),"{cccccc}Названия Рангов \t{ffcc00}[ 300G ]\n"), strcat(sctring,str);
	else if(FamilyInfo[f][fStatusRank] >= 1) format(str,sizeof(str),"{cccccc}Названия Рангов \t{444444}[ 300G ]\n"), strcat(sctring,str);
	if(FamilyInfo[f][fStatusSpawn] == 0) format(str,sizeof(str),"{cccccc}Спавн Семьи \t{ffcc00}[ 500G ]\n"), strcat(sctring,str);
	else if(FamilyInfo[f][fStatusSpawn] >= 1) format(str,sizeof(str),"{cccccc}Спавн Семьи \t{444444}[ 500G ]\n"), strcat(sctring,str);
	if(FamilyInfo[f][fStatusGarage] == 0) format(str,sizeof(str),"{cccccc}Гараж Семьи \t{ffcc00}[ 900G ]\n"), strcat(sctring,str);
	else if(FamilyInfo[f][fStatusGarage] >= 1) format(str,sizeof(str),"{cccccc}Гараж Семьи \t{444444}[ 900G ]\n"), strcat(sctring,str);
	if(FamilyInfo[f][fStatusPlate] == 0) format(str,sizeof(str),"{cccccc}Номерные Знаки \t{ffcc00}[ 300G ]\n"), strcat(sctring,str);
	else if(FamilyInfo[f][fStatusPlate] >= 1) format(str,sizeof(str),"{cccccc}Номерные Знаки \t{444444}[ 300G ]\n"), strcat(sctring,str);

	format(str,sizeof(str),"{cccccc}Тип Семьи \t{ffcc00}[ 0G - 500G ]\n"), strcat(sctring,str);
 	ShowDialog(playerid,475,DIALOG_STYLE_TABLIST,"Family",sctring,"Выбрать","Выход");
	return 1;
}
CMD:famac(playerid)
{
    if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3034 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	if(FamilyInfo[f][fOwner] != PlayerInfo[playerid][pID]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не владелец семьи");
	new str[124],sctring[1320];
	format(str,sizeof(str),"{cccccc}Дипломатия Семьи {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccdip]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Закрывать/Открывать семейный Счёт {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccmoninv]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Снимать деньги с семейного счёта {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccmonget]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Синхронизация с Домом {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccdom]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Синхронизация с Бизнесом {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccbiz]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Управление Спавном {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccspawn]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Управление Гаражом {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccgarage]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Использование Гаража {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccveh]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Изменять Ранги {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccrank]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Изменять название Семьи {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccname]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Просмотр Лога {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAcclog]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Просмотр Участников Offline {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccoff]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Доступ к Fam Donate {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccdon]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}/invitefam {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccinv]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}/uninvitefam {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccuninv]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}/giverankfam {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccgiver]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}/fammute {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccfammu]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}/famforce {ff9000}[ %d+ Ранг ]\n",FamilyInfo[f][fAccfamfo]), strcat(sctring,str);
	ShowDialog(playerid,478,DIALOG_STYLE_LIST,"Family",sctring,"Выбрать","Отмена");
   	return 1;
}

stock IsAtFamCar(playerid)
{
	new d = DP[0][playerid];
	if(d >= 1 && d <= MAX_DOM)
	{
		if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[d][dGarageX], DomInfo[d][dGarageY], DomInfo[d][dGarageZ]) && DomInfo[d][dIngar] >= 1)
		{
			if(DomInfo[d][dFam] >= 1 && DomInfo[d][dFamcar] >= 1)
			{
				new f = DomInfo[d][dFam];
				if(FamilyInfo[f][fDop5] >= 1 && FamilyInfo[f][fDop5] == d)
				{
					if(PlayerInfo[playerid][pFamily] != f) return 0;
				}
			}
		}
	}
	return 1;
}
stock famcar(playerid, domGarage = 0)
{
	if(howstun(playerid) || HealthAC[playerid] <= 0 || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 0;

	// Ищем гараж
	if(domGarage == 0)
	{
		for(new i = 1; i < sizeof(DomInfo); i++)
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0, DomInfo[i][dGarageX], DomInfo[i][dGarageY], DomInfo[i][dGarageZ]) && DomInfo[i][dIngar] >= 1
				&& DomInfo[i][dFam] >= 1 && DomInfo[i][dFamcar] >= 1)
			{
				new f = DomInfo[i][dFam];
				if(FamilyInfo[f][fDop5] >= 1 && FamilyInfo[f][fDop5] == i)
				{
					domGarage = i;
					break;
				}
			}
		}
	}

	if(domGarage == 0) return 0; // Гараж не найден
	DP[0][playerid] = domGarage;

	if(!IsAtFamCar(playerid)) return ErrorMessage(playerid, "{FF6347}Гараж этой семьи вам не доступен");

	new f = PlayerInfo[playerid][pFamily];
	new str[124],sctring[1536];
	for(new i = 0; i < MAX_VEH_FAMILY; i++)
	{
		if(FamilyInfo[f][fVeh][i] >= 1) format(str,sizeof(str),"{cccccc}%s\t\n",GetVehicleName(FamilyInfo[f][fVeh][i])), strcat(sctring,str);
		else if(FamilyInfo[f][fVeh][i] == 0) format(str,sizeof(str),"{444444}...\t\n"), strcat(sctring,str);
	}
	format(str,sizeof(str),"{444444}О гараже..\t\n"), strcat(sctring,str);
	format(str,sizeof(str),"{FF6347}Удалить Транспорт\t\n"), strcat(sctring,str);
	format(str,sizeof(str),"{ff9000}Цвет Транспорта\t%d/%d\n",FamilyInfo[f][fVehCol][0],FamilyInfo[f][fVehCol][1]), strcat(sctring,str);
	format(str,sizeof(str),"{ff9000}Номерной знак\t{cccccc}%s\n",FamilyInfo[f][fVehPlate]), strcat(sctring,str);
	ShowDialog(playerid,473,DIALOG_STYLE_TABLIST,"Family",sctring,"Выбрать","Отмена");
   	return 1;
}

CMD:fammute(playerid, const params[])
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily], string[144];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3037 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccfammu]) return format(string,sizeof(string),"[ Мысли ]: Я не могу заставлять молчать участников семьи [ %d+ Ранг ]",FamilyInfo[f][fAccfammu]), SendClientMessage(playerid, COLOR_GREY, string);
	new tmp[121],minut,reason[121],para1;
	if(sscanf(params, "s[121]is[121]", tmp, minut,reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мут на семейную рацию [ /fammute ID Время Причина ]");
	if(minut > 60 || minut < 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 60 минут");
	if(strlen(reason) > 60) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Какая-то слишком длинная причина.. [ Лимит 60 символов ]");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	para1 = ReturnUser(tmp);
	if(!IsOnline(para1)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[playerid][pFamily] != PlayerInfo[para1][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он не в моей семье");
	if(PlayerInfo[para1][pFamrank] >= PlayerInfo[playerid][pFamrank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу заставить молчать только младшего по рангу");
	format(string, sizeof(string), "{66ffff}Family {ffcc00}%s заставил замолчать %s на %d минут, причина: %s", PlayerInfo[playerid][pName],PlayerInfo[para1][pName],minut,reason);
 	SendFamilyMessage(PlayerInfo[playerid][pFamily], COLOR_YELLOW, string);
	PlayerInfo[para1][pRukzWorld] = minut*60;
 	format(string, sizeof(string), "[ Мысли ]: %s заставил меня замолчать на %d минут по причине: %s", PlayerInfo[playerid][pName], minut,reason);
	SendClientMessage(para1, COLOR_GREY, string);
	FamilyLog(f, "fammute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], minut, reason);
	return 1;
}
CMD:giverankfam(playerid, const params[])
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily], string[144];
	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3038 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
	if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccgiver]) return format(string,sizeof(string),"[ Мысли ]: Я не могу выдавать семейные ранги [ %d+ Ранг ]",FamilyInfo[f][fAccgiver]), SendClientMessage(playerid, COLOR_GREY, string);
	new tmp[121],rank_give,para1;
	if(sscanf(params, "s[121]i", tmp, rank_give)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать семейный ранг [ /giverankfam ID Ранг ]");
	if(rank_give > FamilyInfo[f][fRanks] || rank_give < 1) return format(string,sizeof(string),"[ Мысли ]: Номер ранга не меньше 1 и не больше %d", FamilyInfo[f][fRanks]), SendClientMessage(playerid, COLOR_GREY, string);
	if(rank_give >= PlayerInfo[playerid][pFamrank] && FamilyInfo[f][fOwner] != PlayerInfo[playerid][pID]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдавать ранг своего уровня или больше");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	para1 = ReturnUser(tmp);
	if(IsOnline(para1))
	{
		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет");
		if(PlayerInfo[playerid][pFamily] != PlayerInfo[para1][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он не в моей семье");
		if(playerid == para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изменить свой семейный ранг");
		if(PlayerInfo[para1][pFamrank] >= PlayerInfo[playerid][pFamrank] && FamilyInfo[f][fOwner] != PlayerInfo[playerid][pID]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу выдавать семейный ранг только младшему");
	 	PlayerInfo[para1][pFamrank] = rank_give;
		format(string, sizeof(string), "[ Мысли ]: Глава семьи {ff9000}%s {cccccc}выдал мне ранг № {ff9000}%d", PlayerInfo[playerid][pName],rank_give);
		SendClientMessage(para1, COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: Участник моей семьи {00cc00}%s {cccccc}получил ранг № {00cc00}%d", PlayerInfo[para1][pName],rank_give);
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "Выдал ранг %d", rank_give);
		FamilyLog(f, "giverankfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], rank_give, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,22,rank_give);
	}
	return 1;
}
CMD:invitefam(playerid, const params[])
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily];
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Пригласить в семью [ /invitefam ID ]");
	new string[264];
	if(PlayerInfo[playerid][pFamrank] >= FamilyInfo[f][fAccinv])
	{
 		if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
 		if(!ProxDetectorS(4.0, playerid, params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Он далеко от меня");
 		if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GRAD2, "[ Мысли ]: Я не могу приглашать себя");
   		if(PlayerInfo[params[0]][pFamily] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже есть семья");
     	if(FamilyInfo[f][fStatusUch] == 0 && FamilyInfo[f][fDop1] >= 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я больше не могу приглашать в семью [ Лимит: 10 Участников ][ /fam >> Donate ]");
		DP[0][params[0]] = f;
		DP[1][params[0]] = playerid;
		format(string, sizeof(string), "* Вы пригласили %s вступить в вашу семью", PlayerInfo[params[0]][pName]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);

		format(string, sizeof(string), "{cccccc}%s приглашает вас вступить в семью %s\n\n{ff9000}Хотите вступить?", rpplayername(playerid), FamilyInfo[f][fName]);
		ShowDialog(params[0],480,DIALOG_STYLE_MSGBOX,"{ff9000}Family",string,"Да","Нет");
		FamilyLog(f, "invitefam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "Пригласил в Семью");
	}
	else format(string,sizeof(string),"[ Мысли ]: Я не могу приглашать участников в семью [ %d+ Ранг ]",FamilyInfo[f][fAccinv]), SendClientMessage(playerid, COLOR_GREY, string);
	return 1;
}
CMD:uninvitefam(playerid, const params[])
{
	if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
	new f = PlayerInfo[playerid][pFamily], string[144];
	if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccuninv]) return format(string,sizeof(string),"[ Мысли ]: Я не могу исключать из семьи [ %d+ Ранг ]",FamilyInfo[f][fAccuninv]), SendClientMessage(playerid, COLOR_GREY, string);
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Исключить из семьи [ /uninvitefam ID ]");
	if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	new para1;
	para1 = ReturnUser(params[0], 1);
	if(IsOnline(para1))
	{
		if(PlayerInfo[playerid][pFamily] != PlayerInfo[para1][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей семьи");
		if(playerid == para1) return SendClientMessage(playerid, COLOR_GRAD2, "[ Мысли ]: Я не могу исключить себя из семьи [ /leavefam ]");
		if(PlayerInfo[para1][pFamrank] >= PlayerInfo[playerid][pFamrank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу исключать из семьи только младших по рангу");
		format(string, sizeof(string),"{FF0000}[!!!] Меня исключил из семьи {ffffff}%s {FF0000}[!!!]", PlayerInfo[playerid][pName]);
		ShowDialog(para1, 1700, 0, "Family", string, "Ок", "");
		format(string, sizeof(string), "[ Мысли ]: {ff0000}%s {cccccc}исключил меня из семьи", PlayerInfo[playerid][pName]);
		SendClientMessage(para1, COLOR_GREY, string);
		if(FamilyInfo[f][fDop1] >= 1) FamilyInfo[f][fDop1] --;
		format(string, sizeof(string), "*Вы исключили %s из вашей семьи %s.", PlayerInfo[para1][pName],FamilyInfo[f][fName]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		PlayerInfo[para1][pFamily] = 0;
		PlayerInfo[para1][pFamrank] = 0;
		if(PlayerInfo[para1][pSelectspawn] == 2 || PlayerInfo[para1][pSelectspawn] == 6) PlayerInfo[para1][pSelectspawn] = 0;
		FamilyLog(f, "uninvitefam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "Исключил из семьи");
		FamilyInfo[f][fUpdate] = 1;
	}
	else
	{
		if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, params[0], params[0],7,0);
		return 1;
	}
	return 1;
}
CMD:leavefam(playerid)
{
    if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет семьи");
   	if(FamilyInfo[PlayerInfo[playerid][pFamily]][fOwner] == PlayerInfo[playerid][pID]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я глава семьи и не могу её покинуть [ Передача прав только через /trade ]");
   	new string[144];
   	PlayerPlaySound(playerid,40405,0,0,0);
   	DP[0][playerid] = 0;
   	format(string, sizeof(string), "{ffcc00}Вы уверены, что хотите покинуть свою семью?");
	ShowDialog(playerid,471,DIALOG_STYLE_MSGBOX,"Family",string,"Да","Нет");
	return 1;
}
CMD:delfam(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Удалить семью [ /delfam Номер Семьи ]");
	if(params[0] <= 0 || params[0] > 500) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Номер семьи от 1 до 500");
	if(FamilyInfo[params[0]][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Этой семьи не существует");
	DP[0][playerid] = params[0];
	new string[144];
	format(string, sizeof(string), "{cccccc}Вы уверены, что хотите {ff0000}удалить {ff9000}семью №%d {cccccc}[%s{cccccc}]",params[0],FamilyInfo[params[0]][fName]);
	ShowDialog(playerid,472,DIALOG_STYLE_MSGBOX,"{cccccc}Удаление Семьи",string,"Да","Нет");
	return 1;
}

CMD:id(playerid, const params[])
{
	new targetname[MAX_PLAYER_NAME + 1], targetid = 0;
	static const fmt_str[] = "%i. [ID: %i] {ffcc66}%s %s{cccccc}(ping: %d, loss: %.2f)";
	new device[32];
	if(sscanf(params, "d", targetid)) {
		// Определяем аргумент, как имя игрока, если оно содержит что-то кроме чисел
		if(sscanf(params, "s[25]", targetname)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поиск игрока [ /id NickName / ID ]");
		if(strlen(targetname) > 20 || strlen(targetname) < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 3-ёх и не больше 20-ти символов");

		new PlayerName[24], count = 0;
		foreach (Player, i)
		{
			if (!IsOnline(i)) continue;

			device = IsPlayerSyncModels(i) ? "| {99ff66}Launcher " : "| {ff6347}Client ";
			if(IsPlayerMobile(i)) device = "| {ff6347}Mobile ";
			
			GetPlayerName(i, PlayerName, sizeof(PlayerName));
			if(strfind(PlayerInfo[i][pName], targetname, true) != -1 && gSign[i] == false || strfind(PlayerName, targetname, true) != -1)
			{
				count++;
				if(count == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хм.. кажется я кого-то знаю {ff9000}[ %s ]", targetname);
				SendClientMessage(playerid, COLOR_GREY, fmt_str,
					count,
					i,
					rpplayername(i),
					device,
					GetPlayerPing(i), NetStats_PacketLossPercent(i)
				);
			}
		}
		if(count == 0) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не знаю такого человека {ff6666}[ %s ] ", targetname);
	} else {
		// Определяем аргумент как ID игрока, если это число
		if (IsOnline(targetid) && !IsPlayerNPC(targetid)) {

			device = IsPlayerSyncModels(targetid) ? "| {99ff66}Launcher " : "| {ff6347}Client ";
			if(IsPlayerMobile(targetid)) device = "| {ff6347}Mobile ";

			SendClientMessage(playerid, COLOR_GREY, fmt_str,
				1,
				targetid,
				rpplayername(targetid),
				device,
				GetPlayerPing(targetid), NetStats_PacketLossPercent(targetid)
			);
		} else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. я не знаю такого человека {ff6666}[ ID: %d ] ", targetid);
	}
    return 1;
}

CMD:e(playerid, const params[])
{
	if(PlayerInfo[playerid][pExpert] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не эксперт");
	if(PlayerInfo[playerid][pExchat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не на дежурстве");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чат экспертов на дежурстве /e текст");
	new string[144];
	if(PlayerInfo[playerid][pSoska] >= 1)
	{
		format(string, sizeof(string), "{66ffcc}[ Expert ] {ff6600}%s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
		ExpertCast(COLOR_GREY, string);
	}
	else
	{
		format(string, sizeof(string), "{66ffcc}[ Expert ] %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
		ExpertCast(COLOR_GREY, string);
	}
	return 1;
}
CMD:a(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] > 0)
	{
		if(PlayerInfo[playerid][pTransmitterOff][6] == true) return ErrorMessage(playerid, "{FF6347}У вас выключен чат администрации\n{cccccc}Y >> Меню >> Настройки Чата");
		if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чат администрации /a текст");
		new string[144];
		switch(PlayerInfo[playerid][pSoska])
		{
			case 1: format(string, sizeof(string), "{66ffcc}* Хелпер %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 2..8: format(string, sizeof(string), "{007a08}* %d Админ %s[%d]: {66cc66}%s", PlayerInfo[playerid][pSoska], PlayerInfo[playerid][pName], playerid, params[0]);
			case 9: format(string, sizeof(string), "{FDD9B5}* Админ Media %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 10: format(string, sizeof(string), "{ff6600}* [Л] Зам. Куратора %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 11: format(string, sizeof(string), "{ff6600}* {66ffcc}[Э] {ff6600}Зам. Куратора %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 12: format(string, sizeof(string), "{ff6600}* {66ffcc}[Х] {ff6600}Зам. Куратора %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 13: format(string, sizeof(string), "{ff6600}* {ff0000}[А] {ff6600}Зам. Куратора %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 14: format(string, sizeof(string), "{FDD9B5}* Зам. Media %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 15: format(string, sizeof(string), "{ff0000}* Куратор Лидеров %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 16: format(string, sizeof(string), "{ff0000}* Куратор Экспертов %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 17: format(string, sizeof(string), "{ff0000}* Куратор Хелперов %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 18: format(string, sizeof(string), "{ff0000}* Куратор Админов %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 19: format(string, sizeof(string), "{FDD9B5}* Куратор Media %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 20: format(string, sizeof(string), "{cc0000}* Специальный Админ %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 21: format(string, sizeof(string), "{cc0000}* Главный Админ %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 22: format(string, sizeof(string), "{888888}* Разработчик %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 23: format(string, sizeof(string), "{b30000}* Руководитель %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			case 24..30: format(string, sizeof(string), "{444444}* Основатель %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
			default: format(string, sizeof(string), "{444444}* Ебло %s[%d]: {66cc66}%s", PlayerInfo[playerid][pName], playerid, params[0]);
		}
		SendAdminMessage(COLOR_GREY, string);
	}
	else ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	return 1;
}
CMD:mc(playerid, const params[])
{
  	if(PlayerInfo[playerid][pSoska] >= 4)
  	{
		new string[144];
		if(isamute(playerid) == 1) return 1;
  		if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чат мероприятия [ /mc текст ] (Видят админы и участники мероприятия)");
    	format(string, sizeof(string), "{0088ff}[ Мероприятие ] {cccccc}%s[%d]: {ffffff}(( %s ))", PlayerInfo[playerid][pName], playerid, params[0]);
    	SendMpMessage(string);
    }
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
CMD:djotv(playerid, const params[])
{
	if(PlayerInfo[playerid][pDjpears] < 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие [ DJ 2+ ]");
	if(sscanf(params, "is[144]", params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ответить игроку /djotv id текст");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	format(string, sizeof(string), "Dj {ffcc00}%s: {cccc33}%s", PlayerInfo[playerid][pName], params[1]);
	SendClientMessage(params[0], COLOR_GREY, string);
	format(string, sizeof(string), "DJ ЛС к %s[%d]{cccccc}: %s",PlayerInfo[params[0]][pName], params[0], params[1]);
	SendClientMessage(playerid, 0xcccc33AA, string);
	return 1;
}
CMD:j(playerid, const params[])
{
	if(PlayerInfo[playerid][pDjpears] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не состою в DJ Studio");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чат Dj [ /j текст ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	switch(PlayerInfo[playerid][pDjpears])
	{
		case 1: format(string, sizeof(string), "** [Dj] Стажёр {cccc33}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[0]);
		case 2: format(string, sizeof(string), "** [Dj] Младший Dj {cccc33}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[0]);
		case 3: format(string, sizeof(string), "** [Dj] Старший Dj {cccc33}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[0]);
		case 4: format(string, sizeof(string), "** [Dj] Руководитель {cccc33}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[0]);
		case 5: format(string, sizeof(string), "** [Dj] Директор {666633}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[0]);
		default: format(string, sizeof(string), "** [Dj] Директор {666633}%s[%d]: %s", PlayerInfo[playerid][pName], playerid, params[0]);
	}
	SendDjMessage(COLOR_WHITE, string);
	return 1;
}
CMD:givevoen(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать военный билет /givevoen ID");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	new string[144];
	PlayerInfo[params[0]][pBilet] = 1;
	format(string, sizeof(string), " %s выдал вам военный билет", PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "Я выдал военный билет игроку %s", PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), " [ ADM ]: Админ %s выдал %s военный билет",PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName]);
