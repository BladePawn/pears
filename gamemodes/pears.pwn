		cache_get_value_name_int(f, "serv53", ServerInfo[53]);
		cache_get_value_name_int(f, "serv54", ServerInfo[54]);
		cache_get_value_name_int(f, "serv55", ServerInfo[55]); // Скидка на Меню
		cache_get_value_name_int(f, "serv56", ServerInfo[56]); // Была ли уже Скидка в Этом месяце (номер месяца)
		cache_get_value_name_int(f, "serv57", ServerInfo[57]); // Какой день в этом месяце скидка
		cache_get_value_name_int(f, "serv58", ServerInfo[58]); // Сколько процентов будет скидка в этом месяце
		cache_get_value_name_int(f, "serv59", ServerInfo[59]); // Зарплата Мусоровоз
		cache_get_value_name_int(f, "serv60", ServerInfo[60]); // Зарплата Мойщик Улиц
		cache_get_value_name_int(f, "serv61", ServerInfo[61]); // Вознаграждение за труп в мусорке
		cache_get_value_name_int(f, "serv62", ServerInfo[62]); // Когда последний раз чел заражался вампиризмом
		cache_get_value_name_int(f, "serv63", ServerInfo[63]);
		cache_get_value_name_int(f, "serv64", ServerInfo[64]); // ID Игр в карты
		cache_get_value_name_int(f, "serv65", ServerInfo[65]); // Цена за объявление (Обычное)
		cache_get_value_name_int(f, "serv66", ServerInfo[66]); // Цена за объявление (Премиум)
		cache_get_value_name_int(f, "serv67", ServerInfo[67]); // День текущего сохранения максимального онлайна
		cache_get_value_name_int(f, "serv68", ServerInfo[68]); // Радость моя для Щупы
		cache_get_value_name_int(f, "serv69", ServerInfo[69]); // Тариф (GUNWARN)
		cache_get_value_name_int(f, "serv70", ServerInfo[70]); // Курс монет континенталь к $
		cache_get_value_name_int(f, "po0", PortOwner[0]);
		cache_get_value_name_int(f, "pi0", PortInterval[0]);
		cache_get_value_name_int(f, "po1", PortOwner[1]);
		cache_get_value_name_int(f, "pi1", PortInterval[1]);

		if(ServerInfo[3] == 0) ServerInfo[3] = 50000; // Минимальная сумма в сумке из самолета
		if(ServerInfo[4] == 0) ServerInfo[4] = 100000; // Максимальная сумма в сумке из самолета
		if(ServerInfo[10] <= 0 || ServerInfo[10] > 10) ServerInfo[10] = 3; // Часов в игре для получения шкатулки
		if(ServerInfo[34] == 0) ServerInfo[34] = 1;
		if(ServerInfo[41] == 0) ServerInfo[41] = 1;
		if(ServerInfo[44] == 0) ServerInfo[44] = 40000; // Минимальная сумма в инкассаторской машине
		if(ServerInfo[48] == 0) ServerInfo[48] = 80000; // Максимальная сумма в инкассаторской машине
		if(ServerInfo[57] == 0) ServerInfo[57] = 1+random(27);
	}
	for(new z = 0; z < MAX_PATROOL; z++) 
    {
    	PatroolInfo[z][plGlav] = -1;
		PatroolInfo[z][plCoop][0] = -1;
		PatroolInfo[z][plCoop][1] = -1;
		PatroolInfo[z][plCoop][2] = -1;
    }
	format(strFromFile2,sizeof(strFromFile2),"{189cab}Порт San Fierro\n{ffffff}Под Контролем: %s\n\n{ffffff}[ /begin >> Начать Захват ]",frakName[PortOwner[0]]);
	PortLabel[0] = CreateDynamic3DTextLabel(strFromFile2,0xA9C4E4FF,-1713.4235,-103.7048,3.5547,15.0);
	format(strFromFile2,sizeof(strFromFile2),"{189cab}Порт Los Santos\n{ffffff}Под Контролем: %s\n\n{ffffff}[ /begin >> Начать Захват ]",frakName[PortOwner[1]]);
	PortLabel[1] = CreateDynamic3DTextLabel(strFromFile2,0xA9C4E4FF,2420.7075,-2564.3569,13.6539,15.0);

	// Активация Праздников
	where_holiday();

	printf("[MODE]: Сервер [%d ms]",GetTickCount() - time);
	return 1;
}

function UpdateBilbordLSPD()
{
	new rows;
	cache_get_row_count(rows);

	if (rows > 0) {
		new name[MAX_PLAYER_NAME + 1];
		new text[32 + sizeof(name)];
		cache_get_value_name(0, "Name", name);
		for(new i = 0; i < strlen(name); i++) if(name[i] == '_') name[i] = ' ';

		format(text, sizeof(text), "Chief %s", name);

		SetDynamicObjectMaterialText(LSPDBilbordInfo[0], 0, text, 120, "Arial", 32, 1, 0xFFFCD626, 0x00000000, 1);
	}
}

stock UpdateRent(idx)
{
	DestroyDynamicPickup(WhPickup[idx]);
	DestroyDynamic3DTextLabel(WhLabel[idx]);
	new str[100],sctring[400];
	format(str,sizeof(str),"{444444}** Склад № {ff9000}%d {444444}**\n",idx+1), strcat(sctring,str);
	if(WhInfo[idx][wStat] >= 1) format(str,sizeof(str),"{cccccc}Принадлежит: %s\n\n",frakName[WhInfo[idx][wStat]]), strcat(sctring,str);
	else if(WhInfo[idx][wStat] == 0) format(str,sizeof(str),"{cccccc}Арендовать: {99ff66}/rentwh\n\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}[ Вход ALT ]"), strcat(sctring,str);

	WhLabel[idx] = CreateDynamic3DTextLabel(sctring,0xFFFFFFFF,WhPos[idx][WhPos_X],WhPos[idx][WhPos_Y],WhPos[idx][WhPos_Z]+0.5,10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
	WhPickup[idx] = CreateDynamicPickup(19132, 1, WhPos[idx][WhPos_X], WhPos[idx][WhPos_Y], WhPos[idx][WhPos_Z], 0, 0);
	return 1;
}
function LoadRent()
{
	new rows, idx, time = GetTickCount();
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
		cache_get_value_name_int(f, "Ids", idx);
		cache_get_value_name_int(f, "Stat", WhInfo[idx][wStat]);
		
		// Загружаем арендованный склад
		OnLoadRentInvent(idx, f);

		new str[100],sctring[400];
		format(str,sizeof(str),"{444444}** Склад № {ff9000}%d {444444}**\n",idx+1), strcat(sctring,str);
		if(WhInfo[idx][wStat] >= 1) format(str,sizeof(str),"{cccccc}Принадлежит: %s\n\n",frakName[WhInfo[idx][wStat]]), strcat(sctring,str);
		else if(WhInfo[idx][wStat] == 0) format(str,sizeof(str),"{cccccc}Арендовать: {99ff66}/rentwh\n\n"), strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}[ Вход ALT ]"), strcat(sctring,str);

		WhLabel[idx] = CreateDynamic3DTextLabel(sctring,0xFFFFFFFF,WhPos[idx][WhPos_X],WhPos[idx][WhPos_Y],WhPos[idx][WhPos_Z]+0.5,10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
		WhPickup[idx] = CreateDynamicPickup(19132, 1, WhPos[idx][WhPos_X], WhPos[idx][WhPos_Y], WhPos[idx][WhPos_Z], 0, 0);
		WhLabelCar[idx] = CreateDynamic3DTextLabel("Поместить краденный транспорт на склад\n{ff9000}[CAPS LOCK]",0xFFFFFFFF,WhPosCar[idx][WhPosCar_X],WhPosCar[idx][WhPosCar_Y],WhPosCar[idx][WhPosCar_Z]+0.5,10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0,0);
		WhPickupCar[idx] = CreateDynamicPickup(19627, 1, WhPosCar[idx][WhPosCar_X], WhPosCar[idx][WhPosCar_Y], WhPosCar[idx][WhPosCar_Z], 0, 0);
	}
	printf("[MODE]: Склады [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
public LoadDom()
{
	new time = GetTickCount();
	new rows,idx,strFromFile2[256];
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
		cache_get_value_name_int(f, "Ids", idx);
	    cache_get_value_name(f, "Vlad", DomInfo[idx][dVlad], 24);
	    cache_get_value_name(f, "Komp", DomInfo[idx][dKomp], 24);
