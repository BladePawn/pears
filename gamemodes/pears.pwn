        List[5][playerid] = BizzInfo[b][bPrice][5]/5; // Брэнди бокал
        List[6][playerid] = BizzInfo[b][bPrice][1]; // Вино
        List[7][playerid] = BizzInfo[b][bPrice][2]; // Шампанское
        List[8][playerid] = BizzInfo[b][bPrice][3]; // Виски
        List[9][playerid] = BizzInfo[b][bPrice][4]; // Коньяк
        List[10][playerid] = BizzInfo[b][bPrice][5]; // Брэнди
        List[11][playerid] = BizzInfo[b][bPrice][6]; // Водка
    }
	DP[4][playerid] = b;
	new str[124],sctring[1606];
	format(str,sizeof(str),"{cccccc}Алкоголь \t Объём \t Стоимость"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Пиво \t {444444}0.2л. (бокал) \t {99ff66}[ %d$ ]",List[0][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Вино \t {444444}0.2л. (бокал) \t {99ff66}[ %d$ ]",List[1][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Шампанское \t {444444}0.2л. (бокал) \t {99ff66}[ %d$ ]",List[2][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Виски \t {444444}0.2л. (бокал) \t {99ff66}[ %d$ ]",List[3][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Коньяк \t {444444}0.2л. (бокал) \t {99ff66}[ %d$ ]",List[4][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Брэнди \t {444444}0.2л. (бокал) \t {99ff66}[ %d$ ]",List[5][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Вино \t {444444}1.0л. \t {99ff66}[ %d$ ]",List[6][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Шампанское \t {444444}1.0л.\t {99ff66}[ %d$ ]",List[7][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Виски \t {444444}1.0л.\t {99ff66}[ %d$ ]",List[8][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Коньяк \t {444444}1.0л. \t {99ff66}[ %d$ ]",List[9][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Брэнди \t {444444}1.0л. \t {99ff66}[ %d$ ]",List[10][playerid]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Водка \t {444444}1.0л. \t {99ff66}[ %d$ ]",List[11][playerid]), strcat(sctring,str);
	ShowDialog(playerid,14,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Бар",sctring,"Выбор","Отмена");
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}

alias:djpult("dj")
CMD:djpult(playerid, const params[])
{
	if(PlayerInfo[playerid][pDjpears] >= 1)
	{
  		PlayerPlaySound(playerid,40405,0,0,0);
       	new str[100],sctring[700];
       	format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Список Dj Online\n");
    	strcat(sctring,str);
    	if(Djvopr == 1)
    	{
       		format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Сообщения Слушателей {00cc00}[ On ]\n");
    		strcat(sctring,str);
   		}
   		else if(Djvopr == 0)
    	{
       		format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Сообщения Слушателей {ff0000}[ Off ]\n");
    		strcat(sctring,str);
   		}
      	format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Список Слушателей Online\n");
    	strcat(sctring,str);
    	format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Реклама Эфира Радио\n");
    	strcat(sctring,str);
    	if(PlayerInfo[playerid][pDjpears] >= 4)
    	{
   			if(Djtrans == 1)format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Вещание на сервере {00cc00}[ On ]\n");
  			else if(Djtrans == 0)format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Вещание на сервере {ff0000}[ Off ]\n");
  			strcat(sctring,str);
   		}
   		if(PlayerInfo[playerid][pDjpears] >= 4)
    	{
    		format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Пригласить\n");
    		strcat(sctring,str);
    		format(str,sizeof(str),"{0088ff}[**] {FFFFFF}Уволить\n");
    		strcat(sctring,str);
    	}
    	ShowDialog(playerid,926,DIALOG_STYLE_LIST,"{00FF06}******* {FFFFFF}Меню Директора {00FF06}*******",sctring,"Выбрать","Отмена");
   	}
   	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не состою в DJ Studio");
	return 1;
}
CMD:musicoff(playerid, const params[])
{
	if(OnlineInfo[playerid][oListenRadioPears] == 0)
	{
	   StopAudioStreamForPlayer(playerid);
 	   SendClientMessage(playerid, COLOR_GREEN, "{0088ff}Музыка Выключена для вас");
    }
 	else return SendClientMessage(playerid, COLOR_GREEN, "{0088ff}Радио возможно отключить только через {0066ff}[ /radio ]");
 	return 1;
}

alias:bag("meshok")
CMD:bag(playerid, const params[])
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	new string[144];
	if(Stun[1][playerid] == 1)
	{
		if(Stun[0][playerid] >= 1 || Stun[2][playerid] >= 1 || Stun[3][playerid] >= 1 || Stun[4][playerid] >= 1 || Stun[5][playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я смогу снять мешок только когда освобожусь или очухаюсь");
 		SetCameraBehindPlayer(playerid);
  		Stun[1][playerid] = 0;
  		StunTime[1][playerid] = 30;
  		RemovePlayerAttachedObject(playerid,3);
   		TextDrawHideForPlayer(playerid, Chernifon);
	    SetPlayerChatBubble(playerid,"снимает мешок со своей головы",COLOR_PURPLE,20.0,5000);
    	format(string, sizeof(string), "* %s снимает мешок со своей головы", playername(playerid));
    	ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
    	return 1;
	}
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Надеть мешок на голову [ /bag ID ]");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Эм.. что?");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком далеко от меня");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком далеко от меня");
	if(GetPVarInt(params[0],"afksystem") >= 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он спит..");
	if(Stun[1][params[0]] == 0)
	{
		if(howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо, я не могу никому надеть на голову мешок");
		//if(PlayerInfo[params[0]][pSex] == 1 && Stun[1][params[0]] == 0 && StunTime[1][params[0]] >= 1) return format(string, sizeof(string), "[ Мысли ]: Он только что снял мешок [ %d секунд ]", StunTime[1][params[0]]), SendClientMessage(playerid, COLOR_GREY, string);
		//if(PlayerInfo[params[0]][pSex] == 2 && Stun[1][params[0]] == 0 && StunTime[1][params[0]] >= 1) return format(string, sizeof(string), "[ Мысли ]: Она только что сняла мешок [ %d секунд ]", StunTime[1][params[0]]), SendClientMessage(playerid, COLOR_GREY, string);
		if(Stun[0][params[0]] >= 1 || Stun[2][params[0]] >= 1 || Stun[3][params[0]] >= 1 || Stun[4][params[0]] >= 1 || Stun[5][params[0]] >= 1)
		{
			if(get_invent4(playerid, 23, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет мешка [ Y >> GPS >> Услуги >> Супермаркет ]");
			if(IsAAntidm(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это зелёная зона");
			SendClientMessage(params[0], COLOR_GREY, "[ Мысли ]: Мне кто-то надел на голову мешок");
			SendClientMessage(params[0], COLOR_GREY, "[ Мысли ]: Я могу снять его самостоятельно [ /bag ]");
			if(PlayerInfo[playerid][pSex] == 1)
			{
				format(string, sizeof(string), "[ Мысли ]: Я надел мешок на голову {33CCFF}%s [ Снять - /bag ]", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
				format(string, sizeof(string), "* %s надел мешок на голову %s", playername(playerid) ,playername(params[0]));
				ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				format(string, sizeof(string), "надел мешок на голову %s", playername(params[0]));
				SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
			}
			else
			{
				format(string, sizeof(string), "[ Мысли ]: Я надела мешок на голову {33CCFF}%s [ Снять - /bag ]", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
				format(string, sizeof(string), "* %s надела мешок на голову %s", playername(playerid) ,playername(params[0]));
				ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				format(string, sizeof(string), "надела мешок на голову %s", playername(params[0]));
				SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
			}
			SetPlayerCameraPos(params[0], 2000,-2000,2000);
			SetPlayerCameraLookAt(params[0], 2000,-2000,2000);
			Stun[1][params[0]] = 1;
  			StunTime[1][params[0]] = 300;
  			TextDrawShowForPlayer(params[0], Chernifon);
    		SetPlayerAttachedObject(params[0], 3, 2060, 2, 0.036000, 0.000000, 0.000000, -97.199989, 3.399999, 0.000000, 0.404000, 0.805999, 1.294000, 0, 0);
     		TakeInvent(playerid, 23, 1, 0, 999);
		}
		else
		{
			if(PlayerInfo[params[0]][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он должен быть нейтрализован [ Связан, Нокаутирован, Оглушён ]");
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Она должна быть нейтрализована [ Связана, Нокаутирована, Оглушена ]");
		}
	}
	else if(Stun[1][params[0]] == 1)
	{
		SendClientMessage(params[0], COLOR_GREY, "[ Мысли ]: С моей головы кто-то снял мешок");
		if(PlayerInfo[playerid][pSex] == 1)
		{
			format(string, sizeof(string), "[ Мысли ]: Я снял мешок с головы %s", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
			format(string, sizeof(string), "* %s снял мешок с головы %s", playername(playerid) ,playername(params[0]));
			ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
			format(string, sizeof(string), "снял мешок с головы %s", playername(params[0]));
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
		}
		else
		{
			format(string, sizeof(string), "[ Мысли ]: Я сняла мешок с головы %s", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
			format(string, sizeof(string), "* %s сняла мешок с головы %s", playername(playerid) ,playername(params[0]));
			ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
			format(string, sizeof(string), "сняла мешок с головы %s", playername(params[0]));
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
		}
		SetCameraBehindPlayer(params[0]);
		TextDrawHideForPlayer(params[0], Chernifon);
 		RemovePlayerAttachedObject(params[0],3);
		Stun[1][params[0]] = 0;
		StunTime[1][params[0]] = 0;
	}
	return 1;
}
CMD:tie(playerid, const params[])
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return ErrorMessage(playerid, "{FF6347}Вы находитесь в космосе");
	if(get_invent4(playerid, 13, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет верёвки {cccccc}[ Y >> GPS >> Услуги >> Супермаркет ]");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Связать руки игрока [ /tie ID ]");
	if(HealthAC[playerid] <= 0 || howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Нельзя связать себя");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	if(GetPVarInt(params[0],"afksystem") >= 5) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
	if(CheckPlayerNpc(playerid, params[0])) return 1;
	new string[144];
	if(Stun[0][params[0]] >= 1) return ErrorMessage(playerid, "{FF6347}У игрока уже связаны руки");
	if(Stun[0][params[0]] == 0 && StunTime[0][params[0]] >= 1) return format(string, sizeof(string), "{FF6347}Игрок только что развязался {cccccc}[ Можно повторно связать через %d секунд ]", StunTime[0][params[0]]), ErrorMessage(playerid, string);
	if(!howstun(params[0])) return ErrorMessage(playerid, "{FF6347}Прежде чем связать игрока, его необходимо нокаутировать {cccccc}[ Оглушить или ударить электрошокером ]");
	if(IsPlayerInAnyVehicle(params[0]))
	{
	    new vehicleid = GetPlayerVehicleID(params[0]);
	    if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
	    if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Вы не можете связать водителя");
	}
    format(string, sizeof(string), "[ Мысли ]: {33CCFF}%s связан [ Развязать - /untie ]", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
	format(string, sizeof(string), "связал(а) %s", playername(params[0])), SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	format(string, sizeof(string), "* %s связала(а) %s", playername(playerid) ,playername(params[0]));
	ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

    TextDrawShowForPlayer(params[0], MindDraw[0]), TextDrawShowForPlayer(params[0], MindDraw[1]), TextDrawShowForPlayer(params[0], MindDraw[2]);
	if(PlayerInfo[params[0]][pDrawLanguage] == false && Device[params[0]] != 1) PlayerTextDrawSetString(params[0], MindDraw1, RusToGame("Развяжусь: 300 сек."));
	else PlayerTextDrawSetString(params[0], MindDraw1, "Untied: 300 sec");
	PlayerTextDrawShow(params[0], MindDraw1);
	GameTextForPlayer(params[0], "~r~Tied", 5000, 3);
    SetPlayerSpecialAction(params[0], SPECIAL_ACTION_CUFFED);
	ApplyAnimation(params[0], "GYMNASIUM", "gym_jog_falloff",3.0, false, true, true, false, false, SYNC_ALL);
	format(string, sizeof(string), "{ffcc66}Вы были связаны {FF6347}%s\n\n{cccccc}Если вас никто не развяжет, персонаж сам развяжется через 5 минут", rpplayername(playerid));
	ShowDialog(params[0],1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*",string,"*","");
	format(string, sizeof(string), "[ Мысли ]: Меня связал(а) {33CCFF}%s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
	Stun[0][params[0]] = 1;
	StunTime[0][params[0]] = 300;
    TakeInvent(playerid, 13, 1, 0, 999);
    if(OnlineInfo[params[0]][oShowInterface] == 1) CloseFrisk(params[0]), CancelSelectTextDraw(params[0]);
	return 1;
}
CMD:untie(playerid, const params[])
{
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Развязать человека [ /untie ID ]");
	if(HealthAC[playerid] <= 0 || howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Нельзя развязать себя");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	if(Stun[0][params[0]] == 0) return ErrorMessage(playerid, "{FF6347}Этот игрок не связан");
	new string[144];
	if(PlayerInfo[playerid][pSex] == 1)
	{
		format(string, sizeof(string), "[ Мысли ]: Меня развязал %s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: Я развязал %s", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "* %s развязал %s", playername(playerid) ,playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "развязал %s", playername(params[0]));
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	}
	else
	{
		format(string, sizeof(string), "[ Мысли ]: Меня развязала %s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: Я развязала %s", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "* %s развязала %s", playername(playerid) ,playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "развязала %s", playername(params[0]));
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	}
	TextDrawHideForPlayer(params[0], MindDraw[0]), TextDrawHideForPlayer(params[0], MindDraw[1]), TextDrawHideForPlayer(params[0], MindDraw[2]), PlayerTextDrawHide(params[0], MindDraw1);
	GameTextForPlayer(params[0], "~g~Untied", 2500, 3);
	if(IsPlayerInAnyVehicle(params[0])) TogglePlayerControllable(params[0], true);
	Stun[0][params[0]] = 0, StunTime[0][params[0]] = 0;
	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_NONE);
	return 1;
}
CMD:jobtrash(playerid)
{
	if((IsPlayerInRangeOfPoint(playerid,2.0,1619.3165,-1895.1840,13.8599) || IsPlayerInRangeOfPoint(playerid,2.0,-1870.9408,-217.9861,18.6155) || IsPlayerInRangeOfPoint(playerid,2.0,1034.6143,2216.9155,11.0254)) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(PlayerInfo[playerid][pPlacement] >= 1 && PlayerInfo[playerid][pPlacement] != 8) return StopJob(playerid);
		new str[64],sctring[724];
		if(ServerInfo[53] == 8) format(str,sizeof(str),"{99ff66}Повышенная Оплата: Активна \t \n"), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Стандартная Оплата \t \n"), strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}Как заработать? \t \n"), strcat(sctring,str);
		if(GetPVarInt(playerid,"job_stat") != 8) format(str,sizeof(str),"{ff9000}Начать Работу \t \n"), strcat(sctring,str);
		else if(GetPVarInt(playerid,"job_stat") == 8) format(str,sizeof(str),"{ff9000}Завершить Работу \t \n"), strcat(sctring,str);
		format(str,sizeof(str),"{99ff66}Получить Зарплату \t {00cc00}[ %d$ ]\n", PlayerInfo[playerid][pSalary]), strcat(sctring,str);
		ShowDialog(playerid,1135,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Городская Клининговая Служба",sctring,"Выбор","Отмена");
    }
	return 1;
}
CMD:sellfish(playerid)
{
	if(blockwork[0] == 1) return ErrorMessage(playerid,"{ff6347}Работа временно отключена Администрацией");
	if(IsPlayerInRangeOfPoint(playerid,2.0,995.4169,-1955.7834,12.8842) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		new str[64],sctring[724];
		if(ServerInfo[53] == 0) format(str,sizeof(str),"{99ff66}Повышенная Оплата: Активна \t "), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Стандартная Оплата \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{0088ff}Как заработать? \t "), strcat(sctring,str);
		if(get_invent4(playerid, 20, 0) > 0) format(str,sizeof(str),"\n{ff9000}Рыба \t{cccccc}1 кг. = {99ff66}%d$", ServerInfo[0]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Рыба \t{cccccc}1 кг. = {99ff66}%d$", ServerInfo[0]), strcat(sctring,str);
		if(get_invent4(playerid, 46, 0) > 0) format(str,sizeof(str),"\n{ff9000}Морские Звёзды \t{cccccc}1 шт. = {99ff66}%d$", ServerInfo[50]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Морские Звёзды \t{cccccc}1 шт. = {99ff66}%d$", ServerInfo[50]), strcat(sctring,str);
		if(get_invent4(playerid, 47, 0) > 0) format(str,sizeof(str),"\n{ff9000}Ракушки \t{cccccc}1 шт. = {99ff66}%d$", ServerInfo[51]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Ракушки \t{cccccc}1 шт. = {99ff66}%d$", ServerInfo[51]), strcat(sctring,str);
		if(get_invent4(playerid, 49, 0) > 0) format(str,sizeof(str),"\n{ff9000}Сундук с Сокровищами \t{cccccc}1 шт. = {99ff66}%d$", ServerInfo[52]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Сундук с Сокровищами \t{cccccc}1 шт. = {99ff66}%d$", ServerInfo[52]), strcat(sctring,str);
		ShowDialog(playerid,1065,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Скупка Морепродуктов",sctring,"Выбор","Отмена");
    }
	return 1;
}
