		if(IsPlayerInRangeOfPoint(playerid,6.0,-489.1872,-169.5221,10.4068) || IsPlayerInRangeOfPoint(playerid,9.0,-489.3636,-169.0216,78.2040)) return pc_cmd_hlift(playerid, "");
		if(IsAOpen(playerid) >= 0 || IsAOpen2(playerid) >= 0) return pc_cmd_open(playerid);


		key_TrailerAttach(playerid);
		return 1;
 	}


 	//==========================================================================
	if(newkeys == KEY_ACTION && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && Protect_Veh[playerid] != 9999)
	{
	    new veh = Protect_Veh[playerid];
	 	if(VehInfo[veh][vModel] == 525)
		{
			if(IsTrailerAttachedToVehicle(veh)) return DetachTrailerFromVehicle(veh), VehInfo[VehInfo[veh][vTug]][vTug] = 0, VehInfo[veh][vTug] = 0;

			new Float:pX, Float:pY, Float:pZ, Float:vX, Float:vY, Float:vZ;
			GetPlayerPos(playerid, pX, pY, pZ);
			new yescar = 0;
			new Float:last_distance = 9999.0;
			for(new vid = 0; vid < MAX_CARS; vid++)
			{
				if(VehInfo[vid][vModel] == 0 || veh == vid) continue;

   				GetVehiclePos(vid, vX, vY, vZ);
				new Float:distance = GetDistancePoint(pX, pY, pZ, vX, vY, vZ);
				if(distance <= 7.0 && last_distance >= distance)
				{
					last_distance = distance;
					VehInfo[veh][vTug] = vid;
					VehInfo[vid][vTug] = veh;
					AttachTrailerToVehicle(vid, veh);
					yescar = vid;
				}
			}
			if(yescar >= 1 
				&& PlayerInfo[playerid][pMember] == 1 
				&& Cars[yescar] == 88) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу арестовать этот личный транспорт {ff9000}[ /arestcar Время Залог Причина ]");
	    }
	}
	return 1;
}

stock ClearChatbox(playerid, stat) { for(new i=0; i<stat; i++) SendClientMessage(playerid, COLOR_GREY, " "); return 1; }
stock ClearChatboxAll(stat) { for(new i=0; i< stat; i++) SendClientMessageToAll(COLOR_GREY, ""); return 1; }
stock ClearDeathBox(playerid, stat) { for(new i=0; i<stat; i++) SendDeathMessageToPlayer(playerid,INVALID_PLAYER_ID, 999, 0); return 1;}

forward ClearAnim(playerid);
public ClearAnim(playerid)
{
   if(GetPlayerSpeed(playerid) > 3 || NoAnim[playerid] == 1 || Stun[3][playerid] >= 1) return 0;
   ApplyAnimation(playerid,"PED","facanger",4.0, false, true, true, true, true, SYNC_ALL);
   return 1;
}

stock CheckRP_Nickname(const nickname[])
{
    static Regex:regex;
	if (!regex) regex = Regex_New("[A-Z][a-z]+_([A-Z][a-z]+_)?[A-Z][a-z]+");

	return Regex_Check(nickname, regex);
}

stock CheckVehHealth(playerid)
{
	 if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && PlayerInfo[playerid][pDrawVisible][7] == false && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8 && DrawSpeed[playerid] == true)
	 {
	 	new v = GetPlayerVehicleID(playerid), Float:sized_x = PlayerInfo[playerid][pDrawSize_X][7], Float:sized_y = PlayerInfo[playerid][pDrawSize_Y][7];
	 	if(Device[playerid] == 1 && PlayerInfo[playerid][pTypeSpeed] == 1) sized_y += DrawSizeSmart_Y[7];
	 	new Float:health;
 		GetVehicleHealth(v, health);
		if(health <= 0) PlayerTextDrawHide(playerid, PlayerSpeedDraw[playerid][6]);
		else
		{
			new Float:maxi, Float:section, Float:vremhe, Float:maxvhealth = MaxVehicleHealth(VehInfo[v][vModel], v);
			if(PlayerInfo[playerid][pTypeSpeed] == 0) maxi = 41.317187+sized_x;
			else if(PlayerInfo[playerid][pTypeSpeed] == 1) maxi = 78.0+sized_x/2;
			if(health > maxvhealth) vremhe = maxvhealth;
			else vremhe = health;
			section = maxi / maxvhealth;
			if(PlayerInfo[playerid][pTypeSpeed] == 0) PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][6], vremhe*section, 11.199962+sized_y/2);
			else if(PlayerInfo[playerid][pTypeSpeed] == 1) PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][6], vremhe*section, 20.0+sized_y/2);
			PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][6]);
		}
		new string[20];
		format(string, sizeof(string), "%.0f", health);
		PlayerTextDrawSetString(playerid, PlayerSpeedDraw[playerid][8], string);
		PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][8]);
	 }
	 return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
	if(CallPublic(killerid, 15)) return false;

	if(vehicleid == INVALID_VEHICLE_ID) return 0;
	if(vehicleid == train || vehicleid == train + 1 || vehicleid == train + 2 || vehicleid == train + 3) return 0;

	// Уничтожился автобус конвоя
	if(vehicleid == prisonbus_LS || vehicleid == prisonbus_SF)
	{
		if(vehicleid == prisonbus_LS) ComeBackPrisonBus(0, vehicleid);
		else if(vehicleid == prisonbus_SF) ComeBackPrisonBus(1, vehicleid);
	}

	// Если транспорт НЕ в воде или это Самолёт - Уничтожаем
	if(!CA_IsVehicleNearWater(vehicleid, 1.0, 1.0) || IsAAir(VehInfo[vehicleid][vModel]))
	{
		new Float:vehhp;
		GetVehicleHealth(vehicleid, vehhp);
		if(vehhp <= 300) VehInfo[vehicleid][vExplosion] = true, VehInfo[vehicleid][vHealth] = 400.0;

		/*if(server == 0)
		{
			new string[160];
			if(VehInfo[vehicleid][vExplosion]) format(string,sizeof(string),"OnVehicleDeath %d (%f), killerid %d [Explosion]", vehicleid, vehhp, killerid);
			else format(string,sizeof(string),"OnVehicleDeath %d (%f), killerid %d", vehicleid, vehhp, killerid);
			SendClientMessageToAll(-1, string);
		}*/
	}

	if(get_boot(vehicleid, 35) >= 0)
	{
	    new para1 = get_boot(vehicleid, 35);
		if(IsOnline(para1))
		{
			if(GetPVarInt(para1, "Boot") == vehicleid)
			{
				TempTake(para1, 0), PlayerInfo[para1][pJailed] = 4, PlayerInfo[para1][pJailTime] = 600;
				GameTextForPlayer(para1, RusToGame("~r~Транспорт Уничтожен"), 3000, 3);
				ShowDialog(para1,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Транспорт, в багажнике которого вы находились: Уничтожен\n{cccccc}Вы были отправлены в госпиталь","*","");
				PPSpawnPlayer(para1);
			}
		}
	}

    VehInfo[vehicleid][vEngine] = 0, VehInfo[vehicleid][vArest] = 0, VehInfo[vehicleid][vTug] = 0;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
    SetVehicleParamsEx(vehicleid, false, false, false, false, false, false, false);
    
	if(VehInfo[vehicleid][vNospawn] != 2 // Если спавн транспорта разрешен
		&& VehInfo[vehicleid][vExplosion]) // Если транспорт взорвался
	{
		for(new i = 0; i < 20; i++) ClearBootVehicle(vehicleid, i);
	}
	
	if(Cars[vehicleid] == 54)
	{
	    new s = VehInfo[vehicleid][vAgetid];
	    if(IsOnline(s))
	    {
	        if(OnlineInfo[s][oInflatableBoat] != NON)
	        {
	        	OnlineInfo[s][oInflatableBoat] = NON;
	        	TakeInvent(s, 48, 1, 0, 999);
	        }
	    }
	    ACDestroyVehicle(vehicleid);
	}
	if(VehInfo[vehicleid][vRent] > 0)
	{
	    new p = VehInfo[vehicleid][vAgetid], sl = VehInfo[vehicleid][vRentSlot];
	    if(IsOnline(p)) PlayerInfo[p][pRent][sl] = 0, PlayerInfo[p][pRentVeh][sl] = 0;
		ACDestroyVehicle(vehicleid);
	}
	
	// Сбрасываем Мусорку
	if(VehInfo[vehicleid][vJob] == 8) reset_trash(trash_player[VehInfo[vehicleid][vJobID]], VehInfo[vehicleid][vJobID], 2), VehInfo[vehicleid][vJob] = 0;
	return 1;
}

stock AntiMoneyCheat(playerid)
{
	if(GetPlayerMoney(playerid) != PlayerInfo[playerid][pMoney]) return oSetPlayerMoney(playerid,PlayerInfo[playerid][pMoney]);
	return 1;
}
stock CheckRentwh(wh)
{
	if(WhInfo[wh][wInvent][0] >= 1 && WhInfo[wh][wInvent][1] >= 1 && WhInfo[wh][wInvent][2] >= 1 && WhInfo[wh][wInvent][3] >= 1 && WhInfo[wh][wInvent][4] >= 1
	&& WhInfo[wh][wInvent][5] >= 1 && WhInfo[wh][wInvent][6] >= 1 && WhInfo[wh][wInvent][7] >= 1 && WhInfo[wh][wInvent][8] >= 1 && WhInfo[wh][wInvent][9] >= 1
	&& WhInfo[wh][wInvent][10] >= 1 && WhInfo[wh][wInvent][11] >= 1 && WhInfo[wh][wInvent][12] >= 1 && WhInfo[wh][wInvent][13] >= 1 && WhInfo[wh][wInvent][14] >= 1
	&& WhInfo[wh][wInvent][15] >= 1 && WhInfo[wh][wInvent][16] >= 1 && WhInfo[wh][wInvent][17] >= 1 && WhInfo[wh][wInvent][18] >= 1 && WhInfo[wh][wInvent][19] >= 1){return 1;}
	return 0;
}
stock RemoveAksess(playerid, inva)
{
	if(PlayerInfo[playerid][pOdet][inva] == 0) return 0;

	// Считаем патроны при снятие разгрузки
	new type = GetBustAksType(PlayerInfo[playerid][pOdet][inva]);
	if(type == 0)
	{
		for(new p = 27; p < 30; p++)
		{
			if(get_invent4(playerid,p,0) > 100*get_power(playerid))
			{
				SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: У меня {ff6347}%d {cccccc}%s, а носить я могу всего {ff6347}%d {cccccc}%s",get_invent4(playerid,p,0),friskName[p],100*get_power(playerid),friskName[p]);
				return ErrorMessage(playerid,"{ff6347}Вы не можете снять разгрузку, у вас слишком много патрон");
			}
		}
	}

	// Сняли рюкзак
	if(IsABackPack(PlayerInfo[playerid][pOdet][inva]))
	{
		//if(!BackPackInfo[playerid][backpackLoad]) return ErrorMessage(playerid,"{ff6347}Дождитесь загрузки рюкзака перед тем как снять его!");
		if(!get_backpack(playerid)) return ErrorMessage(playerid,"{ff6347}У вас общие количество рюкзаков больше 2. Выложите их и после снимайте рюкзак!");
		ClearPlayerBackPack(playerid);
		BackPackInfo[playerid][backpackLoad] = 0;
		// Была открыта вкладка рюкзака (закрываем её)
		if(Backpack[playerid] == 1) InventoryLoadPick(playerid);

		TabBackpackHide(playerid);
	}

	if(IsArmor(PlayerInfo[playerid][pOdet][inva])) // Снимаем бронежилет
	{
	    if(PlayerInfo[playerid][pArmor] >= 1)
		{
		    GiveThingPlayer(playerid, PlayerInfo[playerid][pOdet][inva], 1, floatround(PlayerInfo[playerid][pArmor], floatround_round), PlayerInfo[playerid][pOdetQara][inva], 2, 0, 9999);
    		HA_Tick[playerid] = GetTickCount();
			PlayerInfo[playerid][pArmor] = 0;
			SetPlayerArmour(playerid, PlayerInfo[playerid][pArmor]);
		}
	}
	else GiveThingPlayer(playerid, PlayerInfo[playerid][pOdet][inva], 1, PlayerInfo[playerid][pOdetPara][inva], PlayerInfo[playerid][pOdetQara][inva], 2, 0, 9999);

    PlayerInfo[playerid][pOdet][inva] = 0, PlayerInfo[playerid][pOdetPara][inva] = 0, PlayerInfo[playerid][pOdetQara][inva] = 0;
	UpdateOdet(playerid, inva);
    PlayerPlaySound(playerid,5601,0,0,0);

	if(inva == 0) RemovePlayerAttachedObject(playerid,5);
	else if(inva == 1) RemovePlayerAttachedObject(playerid,6);
	else if(inva == 2) RemovePlayerAttachedObject(playerid,7);
	else if(inva == 3) RemovePlayerAttachedObject(playerid,8);
	else if(inva == 4) RemovePlayerAttachedObject(playerid,9);
	if(OnlineInfo[playerid][oShowInterface] == 1) i_akses(playerid, inva);
	return 1;
}
stock famat_biz(f, b)
{
	for(new fb = 0; fb < 10; fb++)
	{
		if(FamilyInfo[f][fBiz][fb] == 0)
		{
			FamilyInfo[f][fBiz][fb] = b;
			break;
		}
	}
	return 1;
}
stock famdeat_biz(f, b)
{
	for(new fb = 0; fb < 10; fb++)
	{
		if(FamilyInfo[f][fBiz][fb] == b)
		{
			FamilyInfo[f][fBiz][fb] = 0;
			break;
		}
	}
	return 1;
}

// Чтобы не всегда сохранять сразу
// Иногда мы даём и в банк и на руки
// Зачем сохранять два раза внутри стока mysql_save
// Поэтому можно сделать так: oGivePlayerBank(playerid, money, false);
// А если хотим сохранить сразу, ничего не указываем: oGivePlayerBank(playerid, money);
// oGivePlayerMoney такая-же фигня
stock oGivePlayerBank(playerid, money, bool: save = true) // Можно не всегда сохранять сразу
{
	PlayerInfo[playerid][pAccount] += money;
    if(save == true) mysql_save(playerid, 0);
	return 1;
}

stock oGivePlayerMoney(playerid, money, bool:save = true)
{
	if(IsOnline(playerid))
	{
	    PlayerInfo[playerid][pMoney] += money;
	    if(OnlineInfo[playerid][oLogged] == 1)
		{
		    new string[24];
		    if(money >= 1)
			{
				format(string, sizeof(string), "~n~~n~~n~~g~+%d$", money);
	        	GameTextForPlayer(playerid, string, 3000, 1);
	        	PlayerPlaySound(playerid,1052,0,0,0);

				// Квест купить ноутбук (Требуется заработать две цены ноута)
				if(PlayerInfo[playerid][pQuest][9] == 1
					&& PlayerInfo[playerid][pMoney] >= getThingPriceGos(42, 0) * 2) ShowQwest(playerid, 9);
			}
		    else if(money <= -1)
			{
				format(string, sizeof(string), "~n~~n~~n~~r~%d$", money);
	        	GameTextForPlayer(playerid, string, 3000, 1);
	        	PlayerPlaySound(playerid,1053,0,0,0);
			}
			if(save == true) mysql_save(playerid, 0);
		}
	    return oSetPlayerMoney(playerid, PlayerInfo[playerid][pMoney]);
	}
	return 1;
}
stock oSetPlayerMoney(playerid, money)
{
	if(IsOnline(playerid))
	{
		PlayerInfo[playerid][pMoney] = money;
		ResetPlayerMoney(playerid);
		return GivePlayerMoney(playerid,money);
	}
	return 1;
}
stock oGetPlayerMoney(playerid) return PlayerInfo[playerid][pMoney];
stock UpdatePlayersSpeed(playerid)
{
    if(GetPVarInt(playerid,"antifloodcheat") == 0)
    {
    	new model = VehInfo[GetPlayerVehicleID(playerid)][vModel]; 
   		if(!IsAPlane(model) && model != 522)
	    {
	    	if(AntiSpeedHack(playerid) >= 400 && AntiSpeedHack(playerid) <= 450) // Анти Speed Hack (было 250 и 304)
	    	{
		          new string[128];
				  format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на Speed Hack {ff0000}[ /sp %d ]", PlayerInfo[playerid][pName],playerid,playerid);
		          ABroadCast(COLOR_ADM,string,1);
		          SetPVarInt(playerid,"antifloodcheat",3);
			}
			else if(AntiSpeedHack(playerid) >= 450 && PlayerInfo[playerid][pSoska] <= 0) // Анти Speed Hack (было 305)
	    	{
		          SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Code: 4005].");
  				  ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff0000}****  {FFFFFF}*[Protect Project]*  {ff0000}****","{ff0000}******** {ffffff}Вы были кикнуты по подозрению в читерстве [Code:4005] {ff0000}********","*","");
      			  Kickx(playerid);
			}
		}
	}
    return 1;
}
