CMD:ring(playerid)
{
	if(IsARing(playerid))
	{
		new ring;
		if(IsPlayerInRangeOfPoint(playerid,2.0,2523.2881,-1696.6648,13.5210) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) ring = 0;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,2510.6646,-1987.1370,13.5540) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) ring = 1;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,2249.1777,-1461.2014,24.0497) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) ring = 2;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1711.5629,-2087.6062,13.5469) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) ring = 3;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,-1381.4384,83.0507,2044.1340)) ring = 4;
		else if(IsPlayerInRangeOfPoint(playerid,2.0,1000.7909,2439.7969,10.8716) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) ring = 5;
	 	if(RingInfo[ring][rStat] == 1) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Бой скоро начинается");
	  	else if(RingInfo[ring][rStat] == 0)
	   	{
	    	if(box[playerid]>=1) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я уже участвую в спарринге");
	    	PlayerPlaySound(playerid,40405,0,0,0);
	    	ShowDialog(playerid,350,DIALOG_STYLE_INPUT,"{ff9000}Ринг","{cccccc}Введите {ff9000}ID игрока{cccccc}, чтобы предложить ему спарринг","Принять","Отмена");
	    }
	    else if(RingInfo[ring][rStat] == 2) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Бой уже идёт");
	}
	return 1;
}

stock checkqueststartinhotel(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1657.393310, -2273.031982, 30.147928) || IsPlayerInRangeOfPoint(playerid,2.0,1759.708740, 1384.628540, 27.828722))
	{
		if(NoCompleteQuest(playerid, 2))
		{
			if(PlayerInfo[playerid][pQuest][2] == 0) return ErrorMessage(playerid, "{FF6347}Неверный порядок квеста\n{ffcc66}Ваш персонаж хочет в душ");
			else if(PlayerInfo[playerid][pQuest][2] == 1) return ErrorMessage(playerid, "{FF6347}Неверный порядок квеста\n{ffcc66}Ваш персонаж хочет в туалет");
		}
	}
	return 0;
}

CMD:sleep(playerid)
{
	if(Sleep[playerid] > 0) return pc_cmd_stopsleep(playerid);
	if(gSkafandr[playerid] > 0 || gFormavvs[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Снимите форму или скафандр, чтобы лечь спать");
	if(Hand[playerid] >= 1 || Hold[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
	new daispat = 0;
	new nd = 0;
	if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000) nd = GetPlayerVirtualWorld(playerid)-1000;

	if(IsASleepR(playerid) || IsASleepR2(playerid)
	|| GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000 && IsPlayerInRangeOfPoint(playerid,1.0, DomInfo[nd][dInbedRX],DomInfo[nd][dInbedRY],DomInfo[nd][dInbedRZ]) && DomInfo[nd][dInbedR] >= 1) // Ложимся спать направо
	{
		if(checkqueststartinhotel(playerid)) return 1;

		new myslp = 0;
		if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000 && IsPlayerInRangeOfPoint(playerid,1.0, DomInfo[nd][dInbedRX],DomInfo[nd][dInbedRY],DomInfo[nd][dInbedRZ]) && DomInfo[nd][dInbedR] >= 1) myslp = 1;
		if(myslp == 0)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5,1761.2075,1386.2476,28.0187)) PPSetPlayerFacingAngle(playerid, 130.6509);
			else if(IsAS0(playerid))PPSetPlayerFacingAngle(playerid, 0.0);
			else if(IsAS90(playerid) || IsAS902(playerid))PPSetPlayerFacingAngle(playerid, 90.0);
			else if(IsAS180(playerid))PPSetPlayerFacingAngle(playerid, 180.0);
			else if(IsAS270(playerid))PPSetPlayerFacingAngle(playerid, 270.0);
			else if(IsAS360(playerid)) PPSetPlayerFacingAngle(playerid, 360.0);
		}
		else if(myslp == 1) PPSetPlayerFacingAngle(playerid, DomInfo[nd][dInbedRA]);
		ApplyAnimation(playerid,"INT_HOUSE","BED_In_R",4.0, false, false, false, true, false);
		GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
		Sleep[playerid] = 5555; // Признак того, что После сна нас просто выбросит
		NoAnim[playerid] = 1;
		daispat = 1;
		//SetTimerEx("bedload_r", 2600, false, "d", playerid);
	}
	else if(IsASleepL(playerid) || IsASleepL2(playerid)
	|| GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000 && IsPlayerInRangeOfPoint(playerid,1.0, DomInfo[nd][dInbedLX],DomInfo[nd][dInbedLY],DomInfo[nd][dInbedLZ]) && DomInfo[nd][dInbedL] >= 1) // Ложимся спать налево
	{
		if(checkqueststartinhotel(playerid)) return 1;

		new myslp = 0;
		if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000 && IsPlayerInRangeOfPoint(playerid,1.0, DomInfo[nd][dInbedLX],DomInfo[nd][dInbedLY],DomInfo[nd][dInbedLZ]) && DomInfo[nd][dInbedL] >= 1) myslp = 1;
		if(myslp == 0)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5,1758.0094,1383.2366,28.0187)) PPSetPlayerFacingAngle(playerid, 313.9292);
			else if(IsAS0(playerid)) PPSetPlayerFacingAngle(playerid, 0.0);
			else if(IsAS90(playerid) || IsAS902(playerid))PPSetPlayerFacingAngle(playerid, 90.0);
			else if(IsAS180(playerid)) PPSetPlayerFacingAngle(playerid, 180.0);
			else if(IsAS270(playerid)) PPSetPlayerFacingAngle(playerid, 270.0);
			else if(IsAS360(playerid)) PPSetPlayerFacingAngle(playerid, 360.0);
		}
		else if(myslp == 1) PPSetPlayerFacingAngle(playerid, DomInfo[nd][dInbedLA]);
		ApplyAnimation(playerid,"INT_HOUSE","BED_In_L",4.0, false, false, false, true, false);
		GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
		Sleep[playerid] = 5556; // Признак того, что После сна нас просто выбросит
		NoAnim[playerid] = 1;
		daispat = 1;
		//SetTimerEx("bedload_l", 2600, false, "d", playerid);
	}
	if(daispat == 1)
	{
		OnlineInfo[playerid][oSnoring] = 0;
		if(PlayerInfo[playerid][pMechSkill] >= 900) // Role Play Сон
		{
			new str[100],sctring[500];
			format(str,sizeof(str),"{ff9000} Вы находитесь в режиме Role Play сна.");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}В данном состоянии система анти AFK или администрация вас не кикнет.");
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n\n{cccccc}Когда захотите проснуться, просто нажмите ESC, Enter");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Или воспользуйтесь командой: /stopsleep");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ff9000}Сладких Снов :*");
			strcat(sctring,str);
			ShowDialog(playerid,548,DIALOG_STYLE_MSGBOX,"{0088ff}Role Play Сон",sctring,"Проснуться","");
			SleepRP[playerid] = 1;
		}
		else // Стандартный Сон
		{
			if((IsPlayerInRangeOfPoint(playerid,5.0,1657.393310, -2273.031982, 30.147928) || IsPlayerInRangeOfPoint(playerid,5.0,1759.708740, 1384.628540, 27.828722))
				&& NoCompleteQuest(playerid, 2)) SleepTime[playerid] = 20;
			else SleepTime[playerid] = ((1000-PlayerInfo[playerid][pMechSkill])/10)*2;
		}
	}
	return 1;
}
CMD:stopsleep(playerid)
{
	if(Sleep[playerid] > 0 || SleepRP[playerid] > 0)
	{
		SleepRP[playerid] = 0, Sleep[playerid] = 0, SleepTime[playerid] = 0;
	 	SetCameraBehindPlayer(playerid), TogglePlayerControllable(playerid, true), ClearAnim(playerid), NoAnim[playerid] = 0;
	 	if(PlayerInfo[playerid][pMechSkill] < 10 && Effect[playerid] == 0) SetPlayerDrunkLevel(playerid, 2800);
	 	GameTextForPlayer(playerid," ", 1500, 3);
 	}
	return 1;
}
forward Call_delakk(playerid, str_name[]);
public Call_delakk(playerid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datad3, datadid;
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Soska", datad1);
		cache_get_value_name_int(0, "Houserent", datad2);
		cache_get_value_name_int(0, "Family", datad3);
		if(datad1 >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя удалить аккаунт старшего админа");
		if(datad2 >= 1)
		{
			DomInfo[datad2][dLodger] --;
			SaveDom(datad2);
		}
		if(datad3 >= 1)
		{
			if(FamilyInfo[datad3][fDop1] >= 1) FamilyInfo[datad3][fDop1] --, FamilyInfo[datad3][fUpdate] = 1;
		}

		DeleteUser(datadid); // Удаление аккаунта

		new string[120];
		format(string, sizeof(string), " [ ADM ]: Администратор %s удалил аккаунт %s",PlayerInfo[playerid][pName],str_name);
        ABroadCast(COLOR_ADM,string,1);

        AdminLog("delakk", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "Удалил Аккаунт");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}

stock DeleteUser(user_id, bool:bridgeMessage = true)
{
	// Начало транзакции
	mysql_tquery(pearsq, "START TRANSACTION;");

	new string_mysql[140];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_igroki` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_quests` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_name` WHERE `acc` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_igroki_contacts` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_achieve` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_wanted` WHERE `playerid` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_cars` WHERE `sost` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_igroki_inventory` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_igroki_hint` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_igroki_maniac` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_igroki_top` WHERE `user_id` = '%d'", user_id), query_empty(pearsq, string_mysql);

	if(bridgeMessage == true) DeletePlayerBridge(user_id);

	// Завершение транзакции
	mysql_tquery(pearsq, "COMMIT;");
	return 1;
}

alias:delakk("idinahyi")
CMD:delakk(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 21) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не могу использовать эту команду");
	new f_str[200], f_name[24],giveplayerid,string[144];
	if(!sscanf(params, "s[24]", f_name))
	{
		giveplayerid = ReturnUser(f_name, 1);
		if(IsOnline(giveplayerid))
		{
			format(string,sizeof(string),"{cccccc}[ Мысли ]: Игрок %s в сети, его нужно кикнуть! [ {ff0000}/kick %d {cccccc}]",f_name,giveplayerid);
			SendClientMessage(playerid,COLOR_GREY,string);
		}
		else
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"SELECT user_id, Soska, Houserent, Family FROM `pp_igroki` WHERE `Name` = '%e'", f_name);
			mysql_tquery(pearsq, f_str, "Call_delakk", "ds", playerid, f_name);
		}
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Удалить аккаунт /delakk Nick_Name");
	return 1;
}

forward Call_reproof();
public Call_reproof()
{
	new rows,f_str[144];
	new aminonl;
	if(ServerInfo[26] <= 0) aminonl = 10800;
	else aminonl = ServerInfo[26]*3600;
	new lminonl;
	if(ServerInfo[27] <= 0) lminonl = 18000;
	else lminonl = ServerInfo[27]*3600;
	new unixtime = gettime();
	new Days = getdate();
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
	    new idak, datad2[24], datad8, datad9, datad5, datad10;
		cache_get_value_name_int(i, "user_id", idak);
		cache_get_value_name(i, "Name", datad2, 24);
		cache_get_value_name_int(i, "GameTime", datad8);
		cache_get_value_name_int(i, "GameAfk", datad9);
		cache_get_value_name_int(i, "Soska", datad5);
		cache_get_value_name_int(i, "Leader", datad10);
		if(server > 0)
		{
			new datad3, datad4, datad11, datad7;
			cache_get_value_name_int(i, "Reproof", datad3);
			cache_get_value_name_int(i, "AdmWarns", datad4);
			cache_get_value_name_int(i, "Vig", datad11);
			cache_get_value_name_int(i, "VacEnd", datad7);
			
			new giveplayerid, onl = 0, log = 0;
			giveplayerid = ReturnUser(datad2, 1);
			if(IsOnline(giveplayerid))
			{
				onl = 1;
				if(OnlineInfo[giveplayerid][oLogged] == 1)
				{
				    datad8 = PlayerInfo[giveplayerid][pGameTime];
				    datad9 = PlayerInfo[giveplayerid][pGameAfk];
					log = 1;
				}
   			}
			if(datad5 >= 1) // Если Админ
			{
				if(datad5 <= 8 && datad8 < aminonl && unixtime >= datad7+600)
				{
					if(datad3 >= 2)
					{
						mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `AdmWarns` = '%d',`Reproof` = '0' WHERE `user_id` = '%d'",datad4+1, idak);
						query_empty(pearsq, f_str);
						AdminLog("admwarn", 0, "Server", "", idak, datad2, "", datad4+1, "ADM Warn: 3 Косяк (Online)");
						if(onl == 1) PlayerInfo[giveplayerid][pAdmWarns] += 1;
						if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Система выдала вам 1 ADM Warn (3 Reproof). Причина: Online норма не выполнена");
						if(datad4 == 2)
						{
							mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Soska` = '%d' WHERE `user_id` = '%d'",datad4-1, idak);
							query_empty(pearsq, f_str);
							AdminLog("makeadmin", 0, "Server", "", idak, datad2, "", datad4-1, "Понижение: 3 ADM Warn");
							if(onl == 1) PlayerInfo[giveplayerid][pSoska] -= 1;
							if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Вы автоматически понижены: 3 ADM Warn");
						}
						else if(datad4 >= 5)
						{
							MakeadminPlayerBridge(idak, 0);

							mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Soska` = '0' WHERE `user_id` = '%d'", idak);
							query_empty(pearsq, f_str);
							AdminLog("makeadmin", 0, "Server", "", idak, datad2, "", datad5, "Снятие: 6 ADM Warn");
							if(onl == 1) PlayerInfo[giveplayerid][pSoska] = 0;
							if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Вы сняты с должности администратора: 6 ADM Warn");
						}
					}
					else
					{
						mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Reproof` = '%d' WHERE `user_id` = '%d'",datad3+1, idak);
						query_empty(pearsq, f_str);
						AdminLog("reproof", 0, "Server", "", idak, datad2, "", datad3+1, "Косяк за Online");
						if(onl == 1) PlayerInfo[giveplayerid][pReproof] ++;
						if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Система выдала вам 1 Reproof. Причина: Online норма не выполнена");
					}
				}
			}
			else if(datad10 >= 1 && datad5 <= 0) // Если Лидер
   			{
   				if(datad8 < lminonl && unixtime >= datad7+600)
				{
					if(datad3 >= 4)
					{
						new datadran;
	    				cache_get_value_name_int(i, "Rank", datadran);
						mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Vig` = '%d',`Reproof` = '0' WHERE `user_id` = '%d'",datad11+1, idak);
						query_empty(pearsq, f_str);
						OrgLog(datad10, "leadvig", 0, "Server", "", idak, datad2, "", 0, "Lead VIG: 3 Косяка (Online)");
						if(onl == 1) PlayerInfo[giveplayerid][pVig] += 1;
						if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Система выдала вам 1 Lead Vig (3 Reproof). Причина: Online норма не выполнена");

						if(datad4 >= 4)
						{
							UnmakeleaderPlayerBridge(idak, datad10, datadran-1);

							mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Leader` = '0',`Member` = '%d',`Rank` = '%d',`Vig` = '0' WHERE `user_id` = '%d'", datad10, datadran-1, idak);
     						query_empty(pearsq, f_str);
							OrgLog(datad10, "makeleader", 0, "Server", "", idak, datad2, "", 0, "Снятие: 5 Lead VIG (Online)");
							if(onl == 1) PlayerInfo[giveplayerid][pLeader] = 0;
							if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Вы сняты с должности лидера организации: 5 Lead VIG");
						}
					}
					else
					{
						mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Reproof` = '%d' WHERE `user_id` = '%d'",datad3+1, idak);
						query_empty(pearsq, f_str);
						OrgLog(datad10, "reproof", 0, "Server", "", idak, datad2, "", 0, "Косяк за Online");
						if(onl == 1) PlayerInfo[giveplayerid][pReproof] ++;
						if(log == 1) SendClientMessage(giveplayerid, COLOR_LIGHTRED, "[ Server ]: Система выдала вам 1 Reproof. Причина: Online норма не выполнена");
					}
				}
			}
			if(unixtime >= datad7+600) mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `VacBeg` = '0',`VacEnd` = '0' WHERE `user_id` = '%d'", idak), query_empty(pearsq, f_str);
		}
		if(datad5 >= 1) mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_work` SET `online` = '%d',`afk` = '%d' WHERE `admin` = '%e' AND `today` = '%d'", datad8/60, datad9/60, datad2, Days), query_empty(pearsq, f_str);
		else if(datad10 >= 1 && datad5 <= 0) mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_work` SET `online` = '%d',`afk` = '%d',`givegun` = '%d' WHERE `admin2` = '%e' AND `today` = '%d'",datad8/60, datad9/60, datad10, datad2, Days), query_empty(pearsq, f_str);
	}
	return 1;
}
forward Call_outbl();
public Call_outbl()
{
	new time = GetTickCount();
	new rows,f_str[144],kolk;
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
	    new plaid, g;
	    cache_get_value_name_int(i, "org", g);
		cache_get_value_name_int(i, "playerid", plaid);
		mysql_format(pearsq, f_str,sizeof(f_str),"DELETE FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", plaid, g), query_empty(pearsq, f_str);
		kolk ++;
	}
	printf("[Очистка черного списка]: Количество: %d (%d ms)", kolk, GetTickCount() - time);
	return 1;
}
forward Call_delets();
public Call_delets()
{
	new time = GetTickCount();
	new rows, kolk;
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
	    new idak, datad2[24];
		cache_get_value_name_int(i, "user_id", idak);
		cache_get_value_name(i, "Name", datad2, 24);
		new datad3, datad4;
		cache_get_value_name_int(i, "Houserent", datad3);
		cache_get_value_name_int(i, "Family", datad4);
		if(datad3 >= 1)
		{
			DomInfo[datad3][dLodger] --;
			SaveDom(datad3);
		}
		if(datad4 >= 1)
		{
			if(FamilyInfo[datad4][fDop1] >= 1) FamilyInfo[datad4][fDop1] --, FamilyInfo[datad4][fUpdate] = 1;
		}

		DeleteUser(idak); // Удаление аккаунта

		kolk ++;
		printf("[Delete Account]: %s", datad2);
	}
	printf("[Удаление Аккаунтов]: Количество: %d (%d ms)", kolk, GetTickCount() - time);
	return 1;
}
forward Call_deleteaccount(playerid, str_name[]);
public Call_deleteaccount(playerid, str_name[])
{
	new rows, datad[3], f_str[356], para1;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid, string[144];
		cache_get_value_name_int(0, "user_id", datadid);
	    cache_get_value_name_int(0, "Soska", datad[0]);
	    cache_get_value_name_int(0, "Banned", datad[1]);
	    cache_get_value_name_int(0, "BanDayz", datad[2]);
	    new unixtime = gettime();
	    if(datad[1] >= 2)
	    {
	    	new datadm[24], datdate[24], datres[64];
	    	new ostalos = datad[2]-unixtime;
			new osday = ostalos/86400;
	    	cache_get_value_name(0, "BanAdmin", datadm, 24);
	    	cache_get_value_name(0, "BanData", datdate, 24);
	    	cache_get_value_name(0, "BanResult", datres, 64);
	    	format(string,sizeof(string),"[ Мысли ADM ]: Аккаунт [ %s ] уже забанен админом %s %s.",str_name,datadm, datdate);
          	SendClientMessage(playerid,COLOR_GREY,string);
          	format(string,sizeof(string),"Причина: %s",datres);
          	SendClientMessage(playerid,COLOR_GREY,string);
      		format(string,sizeof(string),"{cccccc}Удаление аккаунта через: {FF8282}%d дней в 4:00",osday);
       		SendClientMessage(playerid,COLOR_GREY,string);
       		PlayerPlaySound(playerid,4203,0,0,0);
       		return 1;
	    }
	    if(datad[1] != 1) return ErrorMessage(playerid, "{FF6347}Аккаунт должен быть забанен, чтобы поместить его в список на удаление");
		if(datad[0] >= PlayerInfo[playerid][pSoska]) return ErrorMessage(playerid, "{FF6347}Нельзя удалить аккаунт администратора вашего уровня или выше");

		// Антипидор
		if(AntiPidor(playerid, 10)) return 1;

  		new vremya = 30*86400;
  		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Banned`='2',`BanDayz`='%d' WHERE `Name` = '%e'",unixtime+vremya,str_name);
		query_empty(pearsq, f_str);
  		format(f_str, sizeof(f_str), " [ ADM ]: %s поместил аккаунт %s в список для удаления",PlayerInfo[playerid][pName],str_name);
        ABroadCast(COLOR_ADM,f_str,1);
  		AdminLog("delacc", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
  		SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
  		AddWrong(playerid, 10, str_name, 30);
  		para1 = ReturnUser(str_name, 1);
		if(IsOnline(para1)) PlayerInfo[para1][pBanned] = 2, PlayerInfo[para1][pBanDayz] = unixtime+vremya;
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:delaccs(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
	new unixtime = gettime();
	new f_str[190];
	mysql_format(pearsq, f_str,sizeof(f_str),"SELECT user_id, Name, Houserent, Family FROM `pp_igroki` WHERE `Banned` = '2' AND `BanDayz` <= '%d' LIMIT 500", unixtime);
	mysql_tquery(pearsq, f_str, "Call_delets", "");
	SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Вы активировали удаление аккаунтов из списка");
	return 1;
}
CMD:delacc(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
	new f_name[24];
	if(sscanf(params, "s[24]", f_name)) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Поместить аккаунт в список на автоматическое удаление [ /delacc Nick_Name ]");
	if(!CheckRP_Nickname(f_name)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Для удаления аккаунта, мне нужно указать его никнейм. Пример: Lol_Lolkin");
	
	new f_str[200];
	mysql_format(pearsq, f_str,sizeof(f_str),"SELECT user_id, Soska, Banned, BanDayz, BanAdmin, BanData, BanResult FROM `pp_igroki` WHERE `Name` = '%e'", f_name);
	mysql_tquery(pearsq, f_str, "Call_deleteaccount", "ds", playerid, f_name);
	return 1;
}

forward Call_dels(playerid);
public Call_dels(playerid)
{
	new rows ,str[64], sctring[1264];
	new year, month,day;
 	getdate(year, month, day);
	format(str,sizeof(str),"{FFFFFF}***   {0088ff}Дата   {FFFFFF}%d.%d.%d\n",day,month,year);
 	strcat(sctring,str);
 	format(str,sizeof(str),"{cccccc}Отменить Удаление: [ /unban ]\n");
 	strcat(sctring,str);
	cache_get_row_count(rows);
	new unixtime = gettime();
	for(new i = 0; i < rows; i++)
	{
		new datad2[24],datad1;
		cache_get_value_name_int(i, "BanDayz", datad1);
		cache_get_value_name(i, "Name", datad2, 24);
		new ostalos = datad1-unixtime;
		new osday = ostalos/86400;
		if(osday <= 0) format(str,sizeof(str),"%s [сегодня]\n", datad2), strcat(sctring,str);
		else if(osday == 1) format(str,sizeof(str),"%s [завтра]\n", datad2), strcat(sctring,str);
		else format(str,sizeof(str),"%s [%d дней]\n", datad2, osday), strcat(sctring,str);
    }
    ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Удаление Аккаунтов",sctring,"Ок","");
	return 1;
}
CMD:dels(playerid)
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не могу это сделать..");
	mysql_tquery(pearsq, "SELECT Name, BanDayz FROM `pp_igroki` WHERE `Banned` = '2' ORDER BY `BanDayz` DESC LIMIT 50", "Call_dels", "d", playerid);
	return 1;
}

stock GetIdAccessory(model)
{
	new findSlot = -1;
	for(new i = 0; i < MAX_ACCESSORY; i++)
	{
	    if(AccessoryInfo[i][acModel] == model)
	    {
	        findSlot = i;
            break;
	    }
	}
	return findSlot;
}

alias:giveaksess("giveakses", "giveaks")
CMD:giveaksess(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return ErrorMessage(playerid, "{FF6347}Это действие вам недоступно [ Админ 19+ ]");
	new tmp[124], para1;
	if(sscanf(params, "s[124]i",tmp,params[1]))
	{
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать аксессуар /giveaksess ID ID Аксессуара");
	 	return 1;
 	}

	new string[110];
 	if(params[1] <= 320 || params[1] > MAX_OBJECT_MODEL_ID) return format(string,sizeof(string),"{FF6347}ID Аксессуара не меньше 321 и не больше %d", MAX_OBJECT_MODEL_ID), ErrorMessage(playerid, string);
 	
 	new bool:isAvailable, bool:isUnactive, findSlot;
    for(new i = 0; i < MAX_ACCESSORY; i++)
	{
	    if(AccessoryInfo[i][acModel] == params[1])
	    {
	        findSlot = i;
            isAvailable = true;
            if(AccessoryInfo[i][acStatus] == 0) isUnactive = true;
            break;
	    }
	}
	if(!isAvailable) return ErrorMessage(playerid, "{FF6347}Этого аксессуара нет в списке\n{444444}Требуется добавить, настроить гос. стоимость и отображение /accessory");
	if(isUnactive && PlayerInfo[playerid][pSoska] < 20) return ErrorMessage(playerid, "{FF6347}Аксессуар не активен в списке\n{444444}Возможно требуется завершить его настройку");
 	
	para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
	{
		if(OnlineInfo[para1][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок не залогинился");
		
		new put_inva = GiveThingPlayer(para1, params[1], 1, AccessoryInfo[findSlot][acBone], 0, 2, 0, 9999);
    	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У игрока нет места в инвентаре");

		format(string, sizeof(string), "Администратор %s выдал вам аксессуар ID: %d", PlayerInfo[playerid][pName], params[1]);
		SendClientMessage(para1, COLOR_WHITE, string);
		format(string, sizeof(string), "Вы выдали %s аксессуар ID %d", PlayerInfo[para1][pName],params[1]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		AdminLog("giveaksess", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], params[1], "");
	}
	else ErrorMessage(playerid, "{FF6347}Игрока с этим ID нет в сети");
	return 1;
}
CMD:trade(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,50.0,1273.1115,-21.0783,1000.9254) && GetPlayerInterior(playerid) == 100)
	{
		if(Blockas[3] == 1) return ErrorMessage(playerid, "{FF6347}Извините.. Центр обмена временно закрыт администрацией\n\n{cccccc}Возможно был обнаружен баг, который уже исправляют разработчики");
		new str[100],sctring[400];
		if(PlayerInfo[playerid][pTstat] == 0) format(str,sizeof(str),"{99ff66}[ Создать Сделку ]\n"), strcat(sctring,str);
	 	else
	 	{
			format(str,sizeof(str),"{FF6347}[ Отменить Сделку ]\n"), strcat(sctring,str);
			format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[playerid][pTslot][0]]), strcat(sctring,str);
			format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[playerid][pTslot][1]]), strcat(sctring,str);
			format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[playerid][pTslot][2]]), strcat(sctring,str);
		}
		ShowDialog(playerid,842,DIALOG_STYLE_LIST,"{ff9000}Центр Обмена",sctring,"Выбор","Отмена");
	}
	else ErrorMessage(playerid, "{FF6347}Сделки можно проводить только в центре обмена [ Y >> GPS >> Услуги >> Центр Обмена ]");
	return 1;
}
CMD:gotrade(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,50.0,1273.1115,-21.0783,1000.9254) && GetPlayerInterior(playerid) == 100)
	{
		if(Blockas[3] == 1) return ErrorMessage(playerid, "{FF6347}Извините.. Центр обмена временно закрыт администрацией\n\n{cccccc}Возможно был обнаружен баг, который уже исправляют разработчики");
		if(PlayerInfo[playerid][pTstat] == 0) return ErrorMessage(playerid, "{FF6347}Вам необходимо создать сделку [ /trade ]");
		if(PlayerInfo[playerid][pTid] == -1) return ErrorMessage(playerid, "{FF6347}Вам нужно предложить или согласиться с кем-то на сделку [ /sdelka ]");
		new para1 = PlayerInfo[playerid][pTid];
		if(IsOnline(para1))
		{
		    new string[144];
		    if(GetPVarInt(playerid,"antiflood") > 0) return format(string,sizeof(string),"[ Мысли ]: Мне нужно убедиться, что условия сделки верные {ff0000}/itrade {ffcc00}[ %d секунд ]",GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY, string);
			if(PlayerInfo[playerid][pTid] != para1) return format(string,sizeof(string),"[ Мысли ]: {ffcc00}%s {cccccc}не соглашался со мной на сделку",PlayerInfo[para1][pName]), SendClientMessage(playerid, COLOR_GREY, string);
			if(!ProxDetectorS(3.0, playerid, para1)) return format(string,sizeof(string),"[ Мысли ]: %s далеко от меня",PlayerInfo[para1][pName]), SendClientMessage(playerid, COLOR_GREY, string);
			if(GetPVarInt(para1,"afksystem") >= 2 && server != 0) return format(string,sizeof(string),"[ Мысли ]: {ffcc00}%s {cccccc}спит [ AFK ]",PlayerInfo[para1][pName]), SendClientMessage(playerid, COLOR_GREY, string);
			new str[130],sctring[860];
			format(str,sizeof(str),"{0088ff}Подтверждение Сделки\n");
			strcat(sctring,str);
			format(str,sizeof(str),"{cccccc}Участники: {ffffff}%s {cccccc}и {ffffff}%s\n\n",PlayerInfo[playerid][pName],PlayerInfo[para1][pName]);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{FF6347}- При продаже интерьера дома все объекты на улице, в доме покупателя, будут помещены в дом!");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- Убедитесь, что подробности товара второго участника сделки полностью вас устраивают {ff9000}[ /itrade ]");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- Помните, что любые действия, связанные с обменом, тщательно логируются.");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- После вашего согласия необходимо дождаться согласия второго участника.");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- Убедительная просьба не обманывать других игроков. Будьте дружелюбны {ff9000};)");
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n\n{ff9000}Вы уверены, что хотите провести обмен имущества с {cccccc}%s{ff9000}?",PlayerInfo[para1][pName]);
			strcat(sctring,str);
			ShowDialog(playerid,850,DIALOG_STYLE_MSGBOX,"{ff9000}Центр Обмена",sctring,"Да","Нет");
			PlayerPlaySound(playerid,40405,0,0,0);
		}
		else ErrorMessage(playerid, "{FF6347}Игрок покинул сервер");
	}
	else ErrorMessage(playerid, "{FF6347}Сделки можно проводить только в центре обмена [ Y >> GPS >> Услуги >> Центр Обмена ]");
	return 1;
}
CMD:itrade(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,50.0,1273.1115,-21.0783,1000.9254) && GetPlayerInterior(playerid) == 100)
	{
		if(Blockas[3] == 1) return ErrorMessage(playerid, "{FF6347}Извините.. Центр обмена временно закрыт администрацией\n\n{cccccc}Возможно был обнаружен баг, который уже исправляют разработчики");
		if(PlayerInfo[playerid][pTstat] == 0) return ErrorMessage(playerid, "{FF6347}Вам необходимо создать сделку [ /trade ]");
		if(PlayerInfo[playerid][pTid] == -1) return ErrorMessage(playerid, "{FF6347}Вам нужно предложить или согласиться с кем-то на сделку [ /sdelka ]");
		new para1 = PlayerInfo[playerid][pTid];
		if(IsOnline(para1))
		{
			new string[144];
			if(PlayerInfo[para1][pTid] != playerid) return format(string,sizeof(string),"[ Мысли ]: {ffcc00}%s {cccccc}не соглашался со мной на сделку",PlayerInfo[para1][pName]), SendClientMessage(playerid, COLOR_GREY, string);
			new str[100], sctring[400], lol[64];
			format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[para1][pTslot][0]]);
			strcat(sctring,str);
			format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[para1][pTslot][1]]);
			strcat(sctring,str);
			format(str,sizeof(str),"%s\n",tradeName[PlayerInfo[para1][pTslot][2]]);
			strcat(sctring,str);
			format(lol,sizeof(lol),"{ff9000}Товар {cccccc}[{0088ff}%s{cccccc}]",PlayerInfo[para1][pName]);
			ShowDialog(playerid,849,DIALOG_STYLE_LIST,lol,sctring,"Выбор","Отмена");
		}
		else ErrorMessage(playerid, "{FF6347}Игрок покинул сервер");
	}
	else ErrorMessage(playerid, "{FF6347}Сделки можно проводить только в центре обмена [ Y >> GPS >> Услуги >> Центр Обмена ]");
	return 1;
}
CMD:mytrade(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,50.0,1273.1115,-21.0783,1000.9254) && GetPlayerInterior(playerid) == 100)
	{
		if(Blockas[3] == 1) return ErrorMessage(playerid, "{FF6347}Извините.. Центр обмена временно закрыт администрацией\n\n{cccccc}Возможно был обнаружен баг, который уже исправляют разработчики");
		new numsl;
		if(!sscanf(params, "i",numsl))
		{
			if(numsl >= 0 && numsl <= 2)
			{
				DP[0][playerid] = numsl;
				new str[100],sctring[400],lol[64];
				if(PlayerInfo[playerid][pTslot][numsl] == 0)
	   			{
	   				format(str,sizeof(str),"Добавить Товар\n");
			    	strcat(sctring,str);
	   			}
	   			else if(PlayerInfo[playerid][pTslot][numsl] >= 1)
	   			{
	   				format(str,sizeof(str),"Удалить Товар\n");
			    	strcat(sctring,str);
			    	format(str,sizeof(str),"Информация о Товаре\n");
			    	strcat(sctring,str);
	   			}
	   			format(lol,sizeof(lol),"{ff9000}Центр Обмена [ Слот Товара №%d ]",numsl+1);
				ShowDialog(playerid,844,DIALOG_STYLE_LIST,lol,sctring,"Выбор","Отмена");
			}
			else pc_cmd_trade(playerid, "");
		}
		else pc_cmd_trade(playerid, "");
	}
	else ErrorMessage(playerid, "{FF6347}Сделки можно проводить только в центре обмена [ Y >> GPS >> Услуги >> Центр Обмена ]");
	return 1;
}
function Call_name(playerid, str_name[], stat, para1, tmp[])
{
	new rows, f_str[144];
	cache_get_row_count(rows);
	if(rows)
	{
		if(stat == 0)
		{
			new str[124],sctring[648];
			format(str,sizeof(str),"\n{ff9000}Введите ник нейм{cccccc}, чтобы занять его {FF6347}[ {ff0000}%s {FF6347}зарезервирован ]", str_name);
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ffffff}Что значит занять ник нейм?");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- Услуга позволяет записывать никнеймы, чтобы никто кроме вас не мог их использовать");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- Стоимость одного никнейма: {ffcc00}%dG", donatePrice[4]);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}- Вы можете занимать неограниченное количество ник неймов\n");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Важно: {FF6347}Все никнеймы потеряют привязку в случае удаления этого аккаунта!\n");
			strcat(sctring,str);
			ShowDialog(playerid,1004,DIALOG_STYLE_INPUT,"{cccccc}Меню {ff9000}Donate",sctring,"Принять","Отмена");
			PlayerPlaySound(playerid,4203,0,0,0);
		}
		else if(stat == 1)
  		{
            new datad1;
            cache_get_value_name_int(0, "acc", datad1);
            if(datad1 == PlayerInfo[playerid][pID]) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_goname", "ds", playerid, str_name);
            else
            {
   				new str[124],sctring[648];
				format(str,sizeof(str),"\n{ff9000}Введите ник нейм{cccccc}, чтобы сменить его {FF6347}[ {ff0000}%s {FF6347}зарезервирован ]", str_name);
				strcat(sctring,str);
				format(str,sizeof(str),"\n\n{ffffff}Как происходит смена никнейма?");
				strcat(sctring,str);
				format(str,sizeof(str),"\n{cccccc}- Введите никнейм и ожидайте одобрения от администрации");
				strcat(sctring,str);
				format(str,sizeof(str),"\n{cccccc}- Администрация может одобрить смену только когда вы в игре\n");
				strcat(sctring,str);
				ShowDialog(playerid,461,DIALOG_STYLE_INPUT,"{cccccc}Меню {ff9000}Donate",sctring,"Принять","Отмена");
				PlayerPlaySound(playerid,4203,0,0,0);
			}
		}
		else if(stat == 2)
		{
			new datad1;
            cache_get_value_name_int(0, "acc", datad1);
            if(datad1 == PlayerInfo[para1][pID]) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_setname", "ddsd", para1, playerid, PlayerInfo[para1][pSetName],1);
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это имя зарезервировано [ /offname ]");
		}
		else if(stat == 3)
		{
			new datad1;
            cache_get_value_name_int(0, "acc", datad1);
            if(datad1 == PlayerInfo[para1][pID]) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_setname", "ddsd", para1, playerid, str_name,0);
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это имя зарезервировано");
		}
		else if(stat == 4)
		{
			PlayerPlaySound(playerid,4203,0,0,0), SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это имя зарезервировано");
			ShowDialog(playerid,1123,DIALOG_STYLE_INPUT,"{ff9000}Скрытый Аккаунт","\n{cccccc}Введите {ff9000}новый никнейм\n","Принять","Отмена");
		}
		else if(stat == 5)
		{
			new datad1, datad2;
            cache_get_value_name_int(0, "user_id", datad1);
			cache_get_value_name_int(0, "acc", datad2);
            if((datad1 == datad2) || !datad2)
			{
				mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", str_name);
				mysql_tquery(pearsq, f_str, "Call_setname", "ddsdds", para1, playerid, str_name, 0, 1, tmp);
			}
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это имя зарезервировано");
		}
	}
   	else
   	{
		if(stat == 0) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_reservname", "ds", playerid, str_name);
		else if(stat == 1) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_goname", "ds", playerid, str_name);
		else if(stat == 2) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_setname", "ddsd", para1, playerid, PlayerInfo[para1][pSetName], 1);
		else if(stat == 3) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_setname", "ddsd", para1, playerid, str_name, 0);
		else if(stat == 4) mysql_format(pearsq, f_str, sizeof(f_str), "SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", str_name), mysql_tquery(pearsq, f_str, "Call_hiddenname", "ds", playerid, str_name);
	}
	return 1;
}
