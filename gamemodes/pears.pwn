function Float:VehicleSpeedPlane(vehicleid)
{
    new Float:Pos[3];
    GetVehicleVelocity(vehicleid,Pos[0],Pos[1],Pos[2]);
  	return floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1]) * 100.0;
}
function Float:PlayerSpeedPlane(playerid)
{
    new Float:Pos[3];
    GetPlayerVelocity(playerid,Pos[0],Pos[1],Pos[2]);
  	return floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1]) * 100.0;
}

function SetMaxPlayerHealth(playerid, Float: health) {
	new Float: prevMaxHealth = OnlineInfo[playerid][oMaxHealth];
	OnlineInfo[playerid][oMaxHealth] = health;

	new Float: newHealth = (HealthAC[playerid] < prevMaxHealth ? HealthAC[playerid] : health);
	return ACSetPlayerHealth(playerid, newHealth);
}

stock ProxDetector(Float:radi, playerid, const string[], col1, col2, col3, col4, col5, bool: shift_message = false)
{
	if(IsOnline(playerid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		//radi = 2.0; //Trigger Radius
		foreach (Player, id)
		{
			if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(id) && OnlineInfo[id][oLogged] == 1)
			{
				new vehicleid = GetPlayerVehicleID(playerid);
				if (IsValidVehicle(vehicleid) && GetPlayerVehicleID(id) == vehicleid) {
					// Игнорирование дальности чата для игроков в одном транспорте
					SendClientLongMessage(id, col1, string, shift_message ? 90 : 144);
				} else {
				 	GetPlayerPos(id, posx, posy, posz);
					tempposx = (oldposx -posx);
					tempposy = (oldposy -posy);
					tempposz = (oldposz -posz);
					//printf("DEBUG: X:%f Y:%f Z:%f",posx,posy,posz);

					for(new coefficient = 16, i = 0; i < 5; i++, coefficient /= 2) {
						if (((tempposx < radi / coefficient) && (tempposx > -radi / coefficient)) && ((tempposy < radi / coefficient) && (tempposy > -radi / coefficient)) && ((tempposz < radi / coefficient) && (tempposz > -radi / coefficient))) {
							new color;
							switch (i) {
								case 0: color = col1;
								case 1: color = col2;
								case 2: color = col3;
								case 3: color = col4;
								case 4: color = col5;
							}
							SendClientLongMessage(id, color, string, shift_message ? 90 : 144);
							break;
						}
					}
				}
			}
		}
	}
	return 1; //not connected
}

function IsDynamicObjectInRangeOfPoint(objectid, Float:radius, Float:x, Float:y, Float:z)
{
    new Float:actorX, Float:actorY, Float:actorZ;
    // Получаем позицию динамического актёра
    GetDynamicObjectPos(objectid, actorX, actorY, actorZ);
    
    // Вычисляем расстояние от актёра до заданной точки
    new Float:distance = GetDistanceBetweenCoords3d(actorX, actorY, actorZ, x, y, z);
    
    // Проверяем, находится ли актёр в заданном радиусе
    if(distance <= radius)
    {
        return true;
    }
    return false;
}

function IsVehicleInRangeOfPoint(vehicleid, Float:radius, Float:x, Float:y, Float:z)
{
    new Float:actorX, Float:actorY, Float:actorZ;
    // Получаем позицию динамического актёра
    GetVehiclePos(vehicleid, actorX, actorY, actorZ);
    
    // Вычисляем расстояние от актёра до заданной точки
    new Float:distance = GetDistanceBetweenCoords3d(actorX, actorY, actorZ, x, y, z);
    
    // Проверяем, находится ли актёр в заданном радиусе
    if(distance <= radius)
    {
        return true;
    }
    return false;
}

function IsDynamicActorInRangeOfPoint(actorid, Float:radius, Float:x, Float:y, Float:z)
{
    new Float:actorX, Float:actorY, Float:actorZ;
    // Получаем позицию динамического актёра
    GetDynamicActorPos(actorid, actorX, actorY, actorZ);
    
    // Вычисляем расстояние от актёра до заданной точки
	new Float:distance = GetDistanceBetweenCoords3d(actorX, actorY, actorZ, x, y, z);
    
    // Проверяем, находится ли актёр в заданном радиусе
    if(distance <= radius)
    {
        return true;
    }
    return false;
}

forward Call_delfam(f_fam);
public Call_delfam(f_fam)
{
	new rows,f_str[144];
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
	    new datad9;
		cache_get_value_name_int(0, "Spawnchange", datad9);
		if(datad9 == 2 || datad9 == 6) datad9 = 0;
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Family` = '0',`Spawnchange` = '%d' WHERE `Family` = '%d'",datad9,f_fam);
        query_empty(pearsq, f_str);
	}
	return true;
}
public Float:GetPlayerDistancePoint2D(playerid, Float:x1,Float:y1)
{
	new Float:pla_pos[3];
    GetPlayerPos(playerid,pla_pos[0],pla_pos[1],pla_pos[2]);
	return floatsqroot(floatpower(floatabs(floatsub(pla_pos[0],x1)),2)+floatpower(floatabs(floatsub(pla_pos[1],y1)),2));
}
public Float:GetDynamicObjectDistancePoint(objectid,Float:x2,Float:y2,Float:zo2)
{
	new Float:dobject_pos[3];
	GetDynamicObjectPos(objectid, dobject_pos[0], dobject_pos[1], dobject_pos[2]);
	return floatsqroot(floatpower(floatabs(floatsub(x2,dobject_pos[0])),2)+floatpower(floatabs(floatsub(y2,dobject_pos[1])),2)+floatpower(floatabs(floatsub(zo2,dobject_pos[2])),2));
}
public Float:GetDistancePoint(Float:x1,Float:y1,Float:zo1,Float:x2,Float:y2,Float:zo2)
{
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(zo2,zo1)),2));
}
public Float:GetDistanceBetweenPlayers(p1,p2)
{
	new Float:x1,Float:y1,Float:zo1,Float:x2,Float:y2,Float:zo2;
	if(!IsOnline(p1) || !IsOnline(p2))
	{
		return -1.00; 
	}
	GetPlayerPos(p1,x1,y1,zo1);
	GetPlayerPos(p2,x2,y2,zo2);
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(zo2,zo1)),2));
}

stock SendClientLongMessage(playerid, color, const message[], const max_len = 90) {
	const
		default_max_len = 144,
		minimal_chars_in_string = 6;

	new message_len = strlen(message);

	// Скипаем перенос, если строка меньше максимального размера для переноса
	if (message_len < max_len) return SendClientMessage(playerid, color, message);

	new last_space, current_shift,
		current_color = color, last_color = color, bool: correct_color;

	for (new i = 0; i < message_len; i++) {
		// Сохраняем последний цвет
		if (message[i] == '}') {
			new first_tag_pos = i - 7;
			if (message[first_tag_pos] == '{') {
				new color_tag[6 + 4 + 1];
				strmid(color_tag, message, first_tag_pos + 1, i);
				format(color_tag, sizeof(color_tag), "0x%sFF", color_tag);
				correct_color = !sscanf(color_tag, "x", current_color);
			}
		}

		// Перенос строк
		new bool: is_last_symbol = i == message_len - 1;
		if (message[i] == ' ' || is_last_symbol) {
			// Скипаем перенос, если она почти не содержит пробелов (чтобы избежать переносов пары символов на новую строку)
			if (current_shift == 0 && (message_len - minimal_chars_in_string) <= i) return SendClientMessage(playerid, color, message);

			new current_space = i;
			if ((i + 1) / max_len > current_shift || is_last_symbol) {
				current_shift++;
				new current_message[default_max_len];
				strmid(current_message, message, last_space, current_space + 1);
				last_space = current_space;
				
				if (!is_last_symbol) {
					strins(current_message, " ...", strlen(current_message) - 1);
				} else if(current_shift != 1) {
					strins(current_message, "... ", 0);
				}

				SendClientMessage(playerid, last_color, current_message);
				if (correct_color) last_color = current_color;
			}
		}
	}

	return 1;
}

stock howstun(playerid)
{
	if(Stun[0][playerid] >= 1 || Stun[1][playerid] >= 1 || Stun[2][playerid] >= 1 || Stun[3][playerid] >= 1 || Stun[4][playerid] >= 1 || Stun[5][playerid] >= 1
	|| DeathInfo[playerid][deathStatus]) return 1;
	return 0;
}
stock keep(playerid, bool:freezeLong = false)
{
	TogglePlayerControllable(playerid,false), Stopeee[playerid] = 1;

	if(freezeLong == true) Stopee[playerid] = 4;
	else
	{
		if(GetPlayerPing(playerid) >= 150) Stopee[playerid] = 3; // Высокий пинг, морозим чуть дольше
		else Stopee[playerid] = 2; // Норм пинг, морозим как обычно
	}
	return 1;
}
stock Protect_PutPlayerInVehicle(playerid,veh,mesto)
{
    Enterveh[playerid] = veh;
	ProteStat[playerid] = 14;
	GetPlayerPos(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // Protect Project
	new Float:X,Float:Y,Float:Z;
	GetVehiclePos(veh, X,Y,Z);
	PutPlayerInVehicle(playerid, veh,mesto);
	Protect_X[playerid] = X; Protect_Y[playerid] = Y; Protect_Z[playerid] = Z; // Protect Project
	AfterProtect_X[playerid] = X; AfterProtect_Y[playerid] = Y; AfterProtect_Z[playerid] = Z; // Protect Project
    return 1;
}
stock PPSetVehiclePos(playerid,Float:xox,Float:xyx,Float:xzx)
{
	ProteStat[playerid] = 14;
	GetPlayerPos(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // Protect Project

	new vehicleid = GetPlayerVehicleID(playerid);
	if (IsValidVehicle(vehicleid)) 
	{
		// Скидываем игроков, которые сёрфят на нашем транспорте
    	EjectSurfingVehicle(vehicleid);

		SetVehiclePos(vehicleid, xox, xyx, xzx);
	} 
	else 
	{
		SetPlayerPos(playerid, xox, xyx, xzx);
		SetTimerEx("CloseVehSpeed", 500, false, "d", playerid);
	}

	Protect_X[playerid] = xox; Protect_Y[playerid] = xyx; Protect_Z[playerid] = xzx; // Protect Project
	Move_X[playerid] = Protect_X[playerid], Move_Y[playerid] = Protect_Y[playerid], Move_Z[playerid] = Protect_Z[playerid];
	AfterProtect_X[playerid] = xox; AfterProtect_Y[playerid] = xyx; AfterProtect_Z[playerid] = xzx; // Protect Project
    return 1;
}

stock ACRepairVehicle(vehicleid)
{
	VehInfo[vehicleid][vRepairFix] = true;
	VehInfo[vehicleid][vPanels] = 0;
	VehInfo[vehicleid][vDoors] = 0;
	VehInfo[vehicleid][vFara]= 0;
	VehInfo[vehicleid][vTires] = 0;
	RepairVehicle(vehicleid);
	return 1;
}

stock ACSetVehicleHealth(vehicleid,Float:health)
{
	if(health < 400.0) health = 400.0;
	VehInfo[vehicleid][vHealthFix] = GetTickCount();
	VehInfo[vehicleid][vHealth] = health;
	SetVehicleHealth(vehicleid, VehInfo[vehicleid][vHealth]);
	return 1;
}

stock ACSetVehiclePos(vehicleid,Float:xox,Float:xyx,Float:xzx, bool:EjectSurf = true)
{
	if(VehInfo[vehicleid][vSeat] > 0)
	{
		new playerid = VehInfo[vehicleid][vSeat]-1;
		if(IsOnline(playerid)) return PPSetVehiclePos(playerid, xox, xyx, xzx);
	}

	// Скидываем игроков, которые сёрфят на нашем транспорте
    if(EjectSurf == true) EjectSurfingVehicle(vehicleid);

	SetVehiclePos(vehicleid,xox, xyx, xzx);
	return 1;
}
stock PPSetPlayerPos(playerid, Float:xox, Float:xyx, Float:xzx)
{
	ProteStat[playerid] = 14;
	GetPlayerPos(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // Protect Project
	SetPlayerPos(playerid, xox, xyx, xzx);
	Protect_X[playerid] = xox; Protect_Y[playerid] = xyx; Protect_Z[playerid] = xzx; // Protect Project
	Move_X[playerid] = Protect_X[playerid], Move_Y[playerid] = Protect_Y[playerid], Move_Z[playerid] = Protect_Z[playerid];
	AfterProtect_X[playerid] = xox; AfterProtect_Y[playerid] = xyx; AfterProtect_Z[playerid] = xzx; // Protect Project
    return 1;
}

stock PPSetPlayerFacingAngle(playerid, Float:a, bool:follow = true)
{
	AfterProtect_A[playerid] = a;

	// Если вели кого-то за собой, ставим его перед лицом
	// Если в PPSetPlayerFacingAngle в конце указать false, то к нам не тпнет игрока, которого мы ведём
	// Пример такой ситуации: садимся на стул (нам не нужно там тпать игрока)
	if(follow == true) SetPlayerPosFollowMe(playerid);

	SetPlayerFacingAngle(playerid, a);
	return 1;
}

stock PPSetPlayerPosFindZ(playerid,Float:xox,Float:xyx,Float:xzx)
{
	ProteStat[playerid] = 14;
	GetPlayerPos(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // Protect Project
	SetPlayerPosFindZ(playerid, xox, xyx, xzx);
	Protect_X[playerid] = xox; Protect_Y[playerid] = xyx; Protect_Z[playerid] = xzx; // Protect Project
	Move_X[playerid] = Protect_X[playerid], Move_Y[playerid] = Protect_Y[playerid], Move_Z[playerid] = Protect_Z[playerid];
	AfterProtect_X[playerid] = xox; AfterProtect_Y[playerid] = xyx; AfterProtect_Z[playerid] = xzx; // Protect Project
    return 1;
}

stock ProtectSetSpawnInfo(playerid, team, skin, Float:x, Float:y, Float:z, Float:rotation, weapon1, weapon1_ammo, weapon2, weapon2_ammo, weapon3, weapon3_ammo)
{
	ProteStat[playerid] = 14;
	GetPlayerPos(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // Protect Project
	// Protect_X[playerid] = x; Protect_Y[playerid] = y; Protect_Z[playerid] = z; // Protect Project
	Move_X[playerid] = x, Move_Y[playerid] = y, Move_Z[playerid] = z;
	AfterProtect_X[playerid] = x; AfterProtect_Y[playerid] = y; AfterProtect_Z[playerid] = z; // Protect Project

	m_custom_sync_SetSpawnInfo(playerid, team, skin, x, y, z, rotation, weapon1, weapon1_ammo, weapon2, weapon2_ammo, weapon3, weapon3_ammo);
	return 1;
}
stock PPSetSpawnInfo(playerid)
{
	printf("[PPSetSpawnInfo]: %s[%d]", PlayerInfo[playerid][pName], playerid);

	// Информация о спавне при входе в игру
	if(OnlineInfo[playerid][oLogged] == 0) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, 5, 1678.7029,1419.3121,10.7717, 0.0, 0, 0, 0, 0, 0, 0);

	new models = PlayerInfo[playerid][pModel];

	if (GetPlayerActiveComputerGame(playerid) > -1) return ComputerClubOnPlayerSpawn(playerid);
	if (GetPVarInt(playerid, "MineWarSpawn")) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, MineWarGetOutPosition[playerid][0], MineWarGetOutPosition[playerid][1], MineWarGetOutPosition[playerid][2], MineWarGetOutPosition[playerid][3], 0, 0, 0, 0, 0, 0);
	if (GetPVarInt(playerid, "TombSpawn")) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, TombGetOutPosition[playerid][0], TombGetOutPosition[playerid][1], TombGetOutPosition[playerid][2], TombGetOutPosition[playerid][3], 0, 0, 0, 0, 0, 0);
	if (MineWar_IsPlayerInGame(playerid)) return MineWar_SetSpectateSpawnInfo(playerid);
	if (Tomb_IsPlayerInGame(playerid)) return Tomb_SetSpectateSpawnInfo(playerid);
	
	// Временный спавн в Test Drive (Возвращаем обратно в магазин)
	if(VehShopInfo[playerid][vsTest])
	{
		if(gAutosalon[playerid] > 0) // Test Drive автосервиса
		{
			OnlineInfo[playerid][oSpawnWorld] = playerid+1, OnlineInfo[playerid][oSpawnInt] = 223;
			ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1131.3629,2865.5681,918.0888, 0.6306, 0, 0, 0, 0, 0, 0);
			return 1;
		}
		new Float:pos[4], world, interior;
    	GetPlayerVehicleShopPos(playerid, TP[0][playerid], pos[0], pos[1], pos[2], pos[3], world, interior);

		OnlineInfo[playerid][oSpawnWorld] = world, OnlineInfo[playerid][oSpawnInt] = interior;
		ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, pos[0], pos[1], pos[2], pos[3], 0, 0, 0, 0, 0, 0);
		return 1;
	}

	// Смерть на раскопках могил
	if (Graves_IsBattleNpc(playerid) || gettime() < GravePlayerInfo[playerid][gpiNoDeath]) {
		GravePlayerInfo[playerid][gpiNoDeath] = gettime() + 15;
		OnlineInfo[playerid][oSpawnWorld] = 0, OnlineInfo[playerid][oSpawnInt] = 0;
    	ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, PlayerInfo[playerid][pModel], 998.7671, -1106.4410, 23.8281, 90.0000, 0, 0, 0, 0, 0, 0);
		return 1;
	}

	// Death Player
	if(DeathInfo[playerid][deathStatus])
	{
		ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, PlayerInfo[playerid][pLastPos][0],PlayerInfo[playerid][pLastPos][1],PlayerInfo[playerid][pLastPos][2], PlayerInfo[playerid][pLastPos][3], 0, 0, 0, 0, 0, 0);
		return 1;
	}

	new frakid = fraction(playerid);
	if(gZaregal[playerid] == 2)
	{
		if(PlayerInfo[playerid][pKomnataCity] == 3) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.5471,1456.3102,10.8726,178.9046, 0, 0, 0, 0, 0, 0);
		else ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1706.9386,-2428.4026,13.5767,268.8323, 0, 0, 0, 0, 0, 0);
		return 1;
	}
	if(SetPosa[playerid] > 0) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, SpX[playerid], SpY[playerid], SpZ[playerid], SpA[playerid], 0, 0, 0, 0, 0, 0);
	if(GameInfo[gamSpawn] == 1 && MPGO[playerid] == 1) // Мероприятие
	{
 		if(MPSpawn[playerid] == 1) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, GameInfo[gamX],GameInfo[gamY],GameInfo[gamZ], GameInfo[gamA], 0, 0, 0, 0, 0, 0);
 		else if(MPSpawn[playerid] == 2) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, GameInfo[gamX2],GameInfo[gamY2],GameInfo[gamZ2], GameInfo[gamA2], 0, 0, 0, 0, 0, 0);
   		return 1;
    }
    if(MPGO[playerid] == 1) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, SpX[playerid], SpY[playerid], SpZ[playerid], SpA[playerid], 0, 0, 0, 0, 0, 0); // После мероприятия
    if(PlayerInfo[playerid][pJailed] == 1) // Тюрьма Областная
	{
		if(PlayerInfo[playerid][pJailCell] == 0) PlayerInfo[playerid][pJailCell] = 1 + random(8);

		if(PlayerInfo[playerid][pJailCell] == 1) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1056.0322,2438.1597,10.8639,1.0755, 0, 0, 0, 0, 0, 0);
		else if(PlayerInfo[playerid][pJailCell] == 2) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1049.3568,2437.9927,10.8639,1.0754, 0, 0, 0, 0, 0, 0);
		else if(PlayerInfo[playerid][pJailCell] == 3) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1042.5607,2438.0039,10.8639,1.3887, 0, 0, 0, 0, 0, 0);
		else if(PlayerInfo[playerid][pJailCell] == 4) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1035.8409,2438.1636,10.8639,0.7621, 0, 0, 0, 0, 0, 0);
		else if(PlayerInfo[playerid][pJailCell] == 5) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1035.9210,2458.8491,10.8639,179.9670, 0, 0, 0, 0, 0, 0);
		else if(PlayerInfo[playerid][pJailCell] == 6) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1042.7190,2458.6328,10.8639,179.9670, 0, 0, 0, 0, 0, 0);
		else if(PlayerInfo[playerid][pJailCell] == 7) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1049.3574,2458.5593,10.8639,181.2204, 0, 0, 0, 0, 0, 0);
		else ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1056.1536,2458.7449,10.8639,180.5938, 0, 0, 0, 0, 0, 0);
    	return 1;
	}
	if(PlayerInfo[playerid][pJailed] == 3) // КПЗ LS
	{
		switch(random(12))
		{
			case 0: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.3746,-1665.0786,6.2508,89.9276, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
			case 1: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.6293,-1663.8412,6.2508,89.9276, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
			case 2: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.3311,-1662.5491,6.2508,89.9276, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
			case 3: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.4155,-1662.4441,6.2508,89.9276, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
			case 4: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.2594,-1663.5651,6.2508,90.2410, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 4;
			case 5: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.5638,-1664.9413,6.2508,89.9276, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 5;

			case 6: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.9528,-1669.6576,6.2508,90.5777, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 6;
			case 7: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.6487,-1668.5752,6.2508,89.3244, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 7;
			case 8: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.6279,-1667.1835,6.2508,89.3244, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 8;
			case 9: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.5277,-1667.3167,6.2508,89.3244, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 9;
			case 10: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.6417,-1668.7109,6.2508,89.3244, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 10;
			case 11: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.6881,-1669.9681,6.2508,89.3244, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 11;
		}
		return 1;
	}
	if(PlayerInfo[playerid][pJailed] == 9) // КПЗ SF
	{
		switch(random(12))
		{
			case 0: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1619.1132,723.4711,-4.8892,179.9274, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
			case 1: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1620.3921,723.3018,-4.8892,182.4341, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
			case 2: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1621.6039,723.1500,-4.8892,179.9274, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
			case 3: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1621.6039,721.7750,-4.8892,179.9274, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
			case 4: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1620.2882,721.7437,-4.8892,179.9274, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 4;
			case 5: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1619.1118,721.8951,-4.8892,179.9274, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 5;

			case 6: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1614.5787,723.3618,-4.8892,182.4575, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 6;
			case 7: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1615.7704,723.2864,-4.8892,181.5175, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 7;
			case 8: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1617.1166,723.2790,-4.8892,181.5174, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 8;
			case 9: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1617.0798,721.8885,-4.8892,181.5174, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 9;
			case 10: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1615.6863,721.9120,-4.8892,180.5774, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 10;
			case 11: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -1614.3943,721.9764,-4.8892,180.5774, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 11;
		}
		return 1;
	}
	if(PlayerInfo[playerid][pJailed] == 5) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 909.0717,2497.9795,10.9088,359.7231, 0, 0, 0, 0, 0, 0); // Карцер
	if(PlayerInfo[playerid][pJailed] == 2) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 985.6393,2666.1626,896.3239, 0.0, 0, 0, 0, 0, 0, 0); // Prison ADM
	if(PlayerInfo[playerid][pBkyrenie] == 2) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1391.3470,1557.2507,10.8584, 0.0, 0, 0, 0, 0, 0, 0);
    if(PlayerInfo[playerid][pBkyrenie] == 3) return PlayerInfo[playerid][pBkyrenie] = 2, ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1391.3470,1557.2507,10.8584, 0.0, 0, 0, 0, 0, 0, 0); // Спавн бывший МКС (перемещаем на луну)
    if(PlayerInfo[playerid][pBkyrenie] == 4) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1396.0439,1556.8376,10.8584, 90.0, 0, 0, 0, 0, 0, 0);
	if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7 || PlayerInfo[playerid][pJailed] == 8) // Госпиталь
	{
		if(PlayerInfo[playerid][pMember] == 3) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1389.2944,-26.7245,1000.9099,90.0, 0, 0, 0, 0, 0, 0);
		else
		{
			switch(random(3))
	      	{
				case 0: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1412.8612,-3.1363,1000.9245,91.4428, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
				case 1: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1412.4015,-12.6740,1000.9243,90.2130, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
				case 2: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1412.0856,-22.2309,1000.9241,91.1764, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
			}
		}
		return 1;
	}
	if(PlayerInfo[playerid][pJailed] == 6) // Психушка
	{
 		switch(random(4))
 		{
			case 0: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1205.8076,-1431.3110,2001.0291, 359.2079, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
			case 1: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1208.8740,-1420.6132,2001.0491, 267.4003, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
			case 2: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1208.7776,-1416.7473,2001.0491, 269.5936, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
			case 3: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1209.0564,-1413.2080,2001.0491, 267.0870, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
    	}
		return 1;
	}

	if(PlayerInfo[playerid][pQuest][0] == 0) // Не пройден паспортный контроль (Спавнимся внутри Аэропорта)
 	{
		if(PlayerInfo[playerid][pKomnataCity] == 3) // LV
		{
			switch(random(9))
			{
				case 0: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.5471,1456.3102,10.8726,178.9046, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
				case 1: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1581.8739,1455.7368,10.8726,180.1580, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
				case 2: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1578.5601,1455.4353,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
				case 3: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1575.5455,1453.1757,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
				case 4: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1578.6984,1452.9020,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 4;
				case 5: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1582.3218,1452.7778,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 5;
				case 6: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1582.2981,1449.8221,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 6;
				case 7: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1578.7667,1449.5120,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 7;
				case 8: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1574.7686,1449.2871,10.8726,179.5313, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 8;
			}
		}
		else
		{
			switch(random(9))
			{
				case 0: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1706.9386,-2428.4026,13.5767,268.8323, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
				case 1: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1709.2461,-2428.4236,13.5767,269.4590, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
				case 2: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1712.4216,-2428.4529,13.5767,269.4590, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
				case 3: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1707.5978,-2425.1321,13.5767,267.2656, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
				case 4: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1710.5299,-2425.0483,13.5767,268.2056, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 4;
				case 5: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1713.3082,-2425.1357,13.5767,268.2056, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 5;
				case 6: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1707.0990,-2421.5386,13.5767,270.7122, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 6;
				case 7: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1710.2264,-2421.5808,13.5767,270.7122, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 7;
				case 8: ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1713.3613,-2421.6289,13.5767,270.7122, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 8;
			}
		}
		return 1;
	}

	if(PlayerInfo[playerid][pSelectspawn] == 1) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, PlayerInfo[playerid][pLastPos][0],PlayerInfo[playerid][pLastPos][1],PlayerInfo[playerid][pLastPos][2],PlayerInfo[playerid][pLastPos][3], 0, 0, 0, 0, 0, 0);
	
	if(PlayerInfo[playerid][pSelectspawn] == 2)
	{
		new fam = PlayerInfo[playerid][pFamily];
		ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, FamilyInfo[fam][fSpawnX],FamilyInfo[fam][fSpawnY],FamilyInfo[fam][fSpawnZ], 0.000, 0, 0, 0, 0, 0, 0);
		return 1;
	}
	
	if(PlayerInfo[playerid][pSelectspawn] == 3) // Division
	{
		new i = PlayerInfo[playerid][pDivision][0] - 1;
		if(PlayerInfo[playerid][pDivision][0] == 0 || frakid == 0) PlayerInfo[playerid][pSelectspawn] = 0;
		else
		{
			frakid -= 1;
			ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, DivisionInfo[frakid][i][divSpawnPos][0],DivisionInfo[frakid][i][divSpawnPos][1],DivisionInfo[frakid][i][divSpawnPos][2], DivisionInfo[frakid][i][divSpawnPos][3], 0, 0, 0, 0, 0, 0);
			return 1;
		}
	}

	if(PlayerInfo[playerid][pSelectspawn] == 4 || PlayerInfo[playerid][pSelectspawn] == 6 || PlayerInfo[playerid][pSelectspawn] == 7) // Home, Family Home, Rent Home
	{
		if(LIMITED_LOADING_SERVER >= 2) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 1529.6,-1691.2,13.3, 0.000, 0, 0, 0, 0, 0, 0);

		new domid;
		if(PlayerInfo[playerid][pSelectspawn] == 4) domid = PlayerInfo[playerid][pDom];
		else if(PlayerInfo[playerid][pSelectspawn] == 6) domid = FamilyInfo[PlayerInfo[playerid][pFamily]][fDop5];
		else if(PlayerInfo[playerid][pSelectspawn] == 7) domid = PlayerInfo[playerid][pHouserent];

		if(DomInfo[domid][dArest] >= 1) return ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, DomInfo[domid][dKoordinatX],DomInfo[domid][dKoordinatY],DomInfo[domid][dKoordinatZ], DomInfo[domid][dKoordinatA], 0, 0, 0, 0, 0, 0);
		if(DomInfo[domid][dInspa] == 0) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, DomInfo[domid][dEnterX], DomInfo[domid][dEnterY],DomInfo[domid][dEnterZ], 0.000, 0, 0, 0, 0, 0, 0);
		else ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, DomInfo[domid][dSpaX], DomInfo[domid][dSpaY],DomInfo[domid][dSpaZ], 0.000, 0, 0, 0, 0, 0, 0);
		return 1;
	}
	if(PlayerInfo[playerid][pSelectspawn] == 5)
	{
		if(PlayerInfo[playerid][pSpawnChangeDop] == 0) PlayerInfo[playerid][pSelectspawn] = 0; // Защита от проеба
		else return ApartmentsSpawnChoise(playerid,PlayerInfo[playerid][pSpawnChangeDop]-1);
	}

	if(PlayerInfo[playerid][pSelectspawn] == 9)
	{
		if(PlayerInfo[playerid][pTrailer] == 0) PlayerInfo[playerid][pSelectspawn] = 0; // Трейлер тю тю, меняем спавн на отель
		else
		{
			new tid = PlayerInfo[playerid][pTrailer] - 1;
			if(TrailerInfo[tid][tActive] == false) PlayerInfo[playerid][pSelectspawn] = 0; // Трейлер не установлен, меняем точку на отель
			else 
			{
				if(TrailerInfo[tid][tModel] == 12304) ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, 29.8153,1533.4000,12.7768,0.0, 0, 0, 0, 0, 0, 0);
				else ProtectSetSpawnInfo(playerid, DEFAULT_PLAYER_TEAM, models, -2.8078,1569.0706,12.7753,179.9875, 0, 0, 0, 0, 0, 0);
			}
		}
	}

	if(PlayerInfo[playerid][pSelectspawn] == 8)
	{
