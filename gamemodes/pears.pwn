		// Выводим Текст
		if(pobeda >= 1) // Выиграли
		{
			PlayerInfo[playerid][pAmmos1] += pobeda;
			if(pobeda >= 1000000) CompleteBattlePassTask(playerid, 8, 1);
		    //PlayerInfo[playerid][pKasinoStat] += pobeda;
		    //if(PlayerInfo[playerid][pKasinoStat] >= 10000000) PlayerInfo[playerid][pKasinoBlock] = gettime()+604800, PlayerInfo[playerid][pKasinoStat] = 0;  // ВРЕМКА
			new str[84],sctring[336];
	        format(str,sizeof(str),"{99ff66}Вы выиграли"), strcat(sctring,str);
	        format(str,sizeof(str),"\n\n{cccccc}На рулетке выпало: {ff9000}%s", rulName[num]), strcat(sctring,str);
	        format(str,sizeof(str),"\n{cccccc}Вы поставили %dF (%s) на {99ff66}%s", summ, get_k(summ), rulName[myst]), strcat(sctring,str);
	        format(str,sizeof(str),"\n{cccccc}Выигрыш: {99ff66}%dF (%s)", pobeda, get_k(pobeda)), strcat(sctring,str);
	        ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Рулетка",sctring,"Oк","");
	        CasinoLog(0, PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], pobeda, "Выиграл на Рулетке");
	        switch(random(3))
    		{
          		case 0:	PlayerPlaySound(playerid, 5448, 0,0,0);
          		case 1:	PlayerPlaySound(playerid, 5449, 0,0,0);
          		case 2:	PlayerPlaySound(playerid, 5450, 0,0,0);
	  		}
			ApplyAnimation(playerid,"CASINO","Roulette_win",4.0, false, true, true, false, false, SYNC_ALL);
			OrganInfo[0][gdrugs1] -= pobeda, SaveOrgan(0);
 			if(PlayerInfo[playerid][pAchieve][62] == 0) AchievePlayer(playerid, 62, 1);
		}
		else  // Проиграли
		{
		    PlayerInfo[playerid][pAmmos1] -= summ;
			new str[84],sctring[252];
	        format(str,sizeof(str),"{FF6347}Вы проиграли"), strcat(sctring,str);
	        format(str,sizeof(str),"\n\n{cccccc}На рулетке выпало: {ff9000}%s", rulName[num]), strcat(sctring,str);
	        format(str,sizeof(str),"\n{cccccc}Вы поставили %dF (%s) на {FF6347}%s", summ, get_k(summ), rulName[myst]), strcat(sctring,str);
	        ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Рулетка",sctring,"Oк","");
	        CasinoLog(0, PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -summ, "Проиграл на Рулетке");
	        switch(random(2))
    		{
          		case 0: ApplyAnimation(playerid,"CASINO","Roulette_lose",4.0, false, true, true, false, false, SYNC_ALL);
          		case 1: ApplyAnimation(playerid,"CASINO","Slot_lose_out",4.0, false, true, true, false, false, SYNC_ALL);
    		}
			OrganInfo[0][gdrugs1] += summ, SaveOrgan(0);
		}
		mysql_save(playerid, 67);
		updatefishki(playerid), SetPVarInt(playerid, "kas", 5), SetPVarInt(playerid, "oryjtemp", 0);
	}
	return 1;
}
