stock ShowSmartfon(playerid)
{
	if(get_invent4(playerid, 26, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет смартфона [ /gps >> Услуги >> Техника ]");
	if(get_para(playerid, 26) == 1) return ErrorMessage(playerid, "{FF6347}Ваш смартфон сломан [ /gps >> Услуги >> Техника ]");
	if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
	if(OnlineInfo[playerid][oShowInterface] > 1) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас достать смартфон [ Открыто другое меню ]");
	if(DeskStatus[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас достать смартфон [ Игровой стол в казино ]\n\n{cccccc}Команда для связи с администрацией: /report");
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid);
	create_smartfon_draw(playerid);
    ShowDetailSmartfon(playerid);
	if(GetPVarInt(playerid,"MobileStat") == 0) SmartfonMenu(playerid);
	else SmartfonCall(playerid);
	PlayerPlaySound(playerid,40405,0,0,0);
	OnlineInfo[playerid][oShowInterface] = 2;
	SelectColorDraw(playerid);
	if(PlayerInfo[playerid][pSex] == 1)SetPlayerChatBubble(playerid,"достал смартфон",COLOR_PURPLE,20.0,5000);
	else SetPlayerChatBubble(playerid,"достала смартфон",COLOR_PURPLE,20.0,5000);
	return 1;
}
stock CloseSmartfon(playerid)
{
    SetPVarInt(playerid,"Timez",0);
	for(new mob = 0; mob < MAX_SMARTFON_DRAW; mob++) PlayerTextDrawHide(playerid, PlayerSmartDraw[mob][playerid]), PlayerTextDrawDestroy(playerid, PlayerSmartDraw[mob][playerid]);
	OnlineInfo[playerid][oShowInterface] = 0;
	//CancelSelectTextDraw(playerid);
	if(GetPVarInt(playerid,"qweststat") < 8 || GetPVarInt(playerid,"qweststat") > 12) HidePlayerDialog(playerid);
	if(PlayerInfo[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"убрал смартфон",COLOR_PURPLE,20.0,5000);
	else SetPlayerChatBubble(playerid,"убрала смартфон",COLOR_PURPLE,20.0,5000);
	return 1;
}
stock PosSmartDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 6 || setting_size_draw[playerid] == 6) positiond_x = smartdraw_x+set_pos_x[playerid], positiond_y = smartdraw_y+set_pos_y[playerid];
    else positiond_x = smartdraw_x+PlayerInfo[playerid][pDrawPos_X][5], positiond_y = smartdraw_y+PlayerInfo[playerid][pDrawPos_Y][5];

    if(setting_pos_draw[playerid] == 6 || setting_size_draw[playerid] == 6) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][5], sized_y = PlayerInfo[playerid][pDrawSize_Y][5];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[5], positiond_y += DrawPosSmart_Y[5], sized_x += DrawSizeSmart_X[5], sized_y += DrawSizeSmart_Y[5];
    
    new Float:vrem_x, Float:vrem_y, Float:koef_x, Float:reset;
	koef_x = (79.109565+sized_x)/100;

    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[0][playerid], positiond_x, positiond_y); // Фон
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[1][playerid], positiond_x-1.124695, positiond_y-6.53334); // Левая Полоса
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[2][playerid], positiond_x+78.610168+sized_x/1.15, positiond_y-6.53334); // Правая Полоса
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[3][playerid], positiond_x+0.875305, positiond_y-10.600128); // Верх
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[4][playerid], positiond_x+57.738647, positiond_y+3.733322); // Время
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[33][playerid], positiond_x-2.623597, positiond_y-12.400085); // Верхнее Левое Скругление
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[34][playerid], positiond_x+72.612121+sized_x, positiond_y-12.400085); // Верхнее Правое Скругление
    PlayerTextDrawSetPos(playerid, PlayerSmartDraw[35][playerid], positiond_x-0.374329, positiond_y-5.866791); // Верх 2
    
    PlayerTextDrawTextSize(playerid, PlayerSmartDraw[0][playerid], 79.109565+sized_x, 164.200027+sized_y);
    PlayerTextDrawTextSize(playerid, PlayerSmartDraw[1][playerid], 1.499664+sized_x/8, 170.066543+sized_y);
    PlayerTextDrawTextSize(playerid, PlayerSmartDraw[2][playerid], 1.499664+sized_x/8, 170.066543+sized_y);
    PlayerTextDrawTextSize(playerid, PlayerSmartDraw[3][playerid], 76.859947+sized_x, 6.066592+sized_y/8);
    PlayerTextDrawTextSize(playerid, PlayerSmartDraw[35][playerid], 79.859329+sized_x, 6.533259+sized_y/8);
    
    new Float:size_pick_x = 23.6+sized_x*(23.6/95), Float:size_pick_y = 23.6+sized_y*(23.6/95);
	PlayerTextDrawGetPos(playerid, PlayerSmartDraw[1][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetPos(playerid, PlayerSmartDraw[35][playerid], reset, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[5][playerid], 1.7+vrem_x+1.499664+sized_x/8, 21.0+vrem_y+1.499664+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[7][playerid], 3.7+vrem_x+1.499664+sized_x/8+size_pick_x, 21.0+vrem_y+1.499664+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[9][playerid], 5.7+vrem_x+1.499664+sized_x/8+size_pick_x*2, 21.0+vrem_y+1.499664+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[11][playerid], 1.7+vrem_x+1.499664+sized_x/8, 24.0+vrem_y+1.499664+sized_y/8+size_pick_y);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[13][playerid], 3.7+vrem_x+1.499664+sized_x/8+size_pick_x, 24.0+vrem_y+1.499664+sized_y/8+size_pick_y);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[15][playerid], 5.7+vrem_x+1.499664+sized_x/8+size_pick_x*2, 24.0+vrem_y+1.499664+sized_y/8+size_pick_y);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[17][playerid], 1.7+vrem_x+1.499664+sized_x/8, 27.0+vrem_y+1.499664+sized_y/8+size_pick_y*2);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[19][playerid], 3.7+vrem_x+1.499664+sized_x/8+size_pick_x, 27.0+vrem_y+1.499664+sized_y/8+size_pick_y*2);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[21][playerid], 5.7+vrem_x+1.499664+sized_x/8+size_pick_x*2, 27.0+vrem_y+1.499664+sized_y/8+size_pick_y*2);
	PlayerTextDrawSetPos(playerid, PlayerSmartDraw[23][playerid], 1.7+vrem_x+1.499664+sized_x/8, 30.0+vrem_y+1.499664+sized_y/8+size_pick_y*3);
