public LoadBizzTerm()
{
	reloadVariableBizTermActor();

	new time = GetTickCount();
	new rows,stra[18],model,quan;
	cache_get_row_count(rows);
	for(new br; br < rows; ++br)
	{
		for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
		    format(stra,sizeof(stra),"RentStat%d",i), cache_get_value_name_int(br, stra, RentStat[br][i]);
			format(stra,sizeof(stra),"RentPos_X%d",i), cache_get_value_name_float(br, stra, RentPos_X[br][i]);
			format(stra,sizeof(stra),"RentPos_Y%d",i), cache_get_value_name_float(br, stra, RentPos_Y[br][i]);
			format(stra,sizeof(stra),"RentPos_Z%d",i), cache_get_value_name_float(br, stra, RentPos_Z[br][i]);
			format(stra,sizeof(stra),"RentPos_RX%d",i), cache_get_value_name_float(br, stra, RentPos_RX[br][i]);
			format(stra,sizeof(stra),"RentPos_RY%d",i), cache_get_value_name_float(br, stra, RentPos_RY[br][i]);
			format(stra,sizeof(stra),"RentPos_RZ%d",i), cache_get_value_name_float(br, stra, RentPos_RZ[br][i]);
			if(RentStat[br][i] > 0)
			{
			    new b = rentnumn(br);
				if(b >= 163 && b <= 172) model = 19324;
				else if(b >= 153 && b <= 162) model = 1340;
				else if(b >= 143 && b <= 152) model = 12287;
				else model = 2754;
				RentObject[br][i] = CreateDynamicObject(model, RentPos_X[br][i], RentPos_Y[br][i], RentPos_Z[br][i], RentPos_RX[br][i], RentPos_RY[br][i], RentPos_RZ[br][i], 0, 0, -1, 200.00, 200.00);
				CreateLabelTerm(br, i, RentObject[br][i]);
				UpdateLabelTerm(b, br, i);
				quan ++;
			}
		}
	}
	printf("[MODE]: Терминалы Бизнесов %d [%d ms]", quan, GetTickCount() - time);
	return 1;
}
stock frontobject(objectid, Float:distance, &Float:x, &Float:y, &Float:z, Float:rz)
{
	new Float:rx,Float:ry;
    GetDynamicObjectPos(objectid,x,y,z);
	GetDynamicObjectRot(objectid,rx,ry,rz);
	x=x+distance*floatsin(-rz+90,degrees);
	y=y+distance*floatcos(-rz+90,degrees);
	return 1;
}
stock backtobject(objectid, Float:distance, &Float:x, &Float:y, &Float:z, Float:rz)
{
	new Float:rx,Float:ry;
    GetDynamicObjectPos(objectid,x,y,z);
	GetDynamicObjectRot(objectid,rx,ry,rz);
	x=x-distance*floatsin(-rz+90,degrees);
	y=y-distance*floatcos(-rz+90,degrees);
	return 1;
}

stock lefttobject(objectid, Float:distance, &Float:x, &Float:y, &Float:z, Float:rz)
{
	new Float:rx,Float:ry;
    GetDynamicObjectPos(objectid,x,y,z);
	GetDynamicObjectRot(objectid,rx,ry,rz);
	x=x-distance*floatsin(-rz,degrees);
	y=y-distance*floatcos(-rz,degrees);
	return 1;
}

stock CreateLabelTerm(br, i, objectid)
{	
	new b = rentnumn(br);
	if(b >= 153 && b <= 162) // Ларек с Хот Догами
	{	
		if(RentPickupStat[br][i]) DestroyDynamicPickup(RentPickup[br][i]);
		new Float:x,Float:y,Float:z;
		frontobject(objectid,1.0,x,y,z,RentPos_RZ[br][i]);
		RentLabel[br][i] = CreateDynamic3DTextLabel(" ",0xA9C4E4FF,x, y, z,8.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0);
		RentPickup[br][i] = CreateDynamicPickup(1546, 1, x, y, z, 0, 0);
		RentPickupStat[br][i] = true;

		// Ставим бота для ларька с едой (Создаётся и переустанавливается в одном стоке)
		CreateTerminalActor(b, i);
	}
	else 
	{
		RentLabel[br][i] = CreateDynamic3DTextLabel(" ",0xA9C4E4FF,RentPos_X[br][i], RentPos_Y[br][i], RentPos_Z[br][i]+0.2,6.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0);
	}
	return 1;
}
stock findweather()
{
	new numw;
	switch(random(20))
	{
		case 0..7: numw = 1; // солнечно (Timecyc Update)
		case 8..14: numw = 0; // солнечно (Timecyc Update)
		case 15..19: numw = 4; // облачно (Timecyc Update)
	}
	return numw;
}

