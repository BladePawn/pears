			{
				if(!IsARentTruckPos(playerid)) return 0;
			}
			if(listitem < 0 || listitem > 5) return 0;

			if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Нельзя арендовать транспорт сидя в транспорте");
			if(get_invent2(playerid, 156, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет водительских прав [ Y >> GPS >> Образовательный Центр ]");

			new unix = gettime();
			if(PlayerInfo[playerid][pRent][0] > unix && PlayerInfo[playerid][pRent][1] > unix) return ErrorMessage(playerid, "{FF6347}У вас есть два арендованных транспорта [ Y >> Транспорт или /car ]");
				
			if(GetPVarInt(playerid,"delivery_biz") == 0
			&& (fraction(playerid) > 3 || fraction(playerid) <= 0)) return ErrorText(playerid, "{FF6347}У вас нет активных заказов доставки товаров"), orderbiz(playerid);

			new color;
			if(listitem == 0) color = 135; 
			if(listitem == 1) color = 137;
			if(listitem == 2) color = 6;
			if(listitem == 3) color = 3;
			if(listitem == 4) color = 0;
			if(listitem == 5) color = 1;

			new list = DP[1][playerid];
			new vehicleModel = List[list][playerid];
			if(oGetPlayerMoney(playerid) < GetVehiclePriceGos(vehicleModel)/100) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");

			CreateRentVehicle(playerid, vehicleModel, color, color, 1, unix, GetVehiclePriceGos(vehicleModel)/100);
		}
	}
