			else SendClientMessage(playerid, COLOR_LIGHTRED, "Вы попали в госпиталь после тяжёлого ранения и должны пройти лечение");
			if(Nolet[playerid] == 0)
			{
				Nolet[playerid] = 1;
				NoletObj[playerid] = CreatePlayerObject(playerid, 8661, 1404.78882, -13.97450, 1009.92572, -90.00000, 0.00000, -90.00000);
				SetPlayerObjectMaterial(playerid, NoletObj[playerid], 0, 18643, "laserpointer1", "laserbeam64x64", 0x00000000);
			}
