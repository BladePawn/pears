stock close_mind_object(playerid)
{
	MindStatObject[playerid] = false, DestroyDynamicObject(MindObject[0][playerid]), DestroyDynamicObject(MindObject[1][playerid]);
	return 1;
}

stock check_put_on(playerid)
{
    if((Hold[playerid] == 2 || Hold[playerid] == 3 || Hold[playerid] == 11 || Hold[playerid] == 12 || Hold[playerid] == 14) && HoldStat[playerid] != 125)
    {
		put_on_table(playerid, HoldFrisk[playerid], HoldStat[playerid], HoldQuan[playerid], HoldPara[playerid], HoldQara[playerid], 0, 0, HoldNoinvent[playerid]);
		if(Hold[playerid] == 12)
		{
			PPP15[playerid] = 0;
			if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ClearAnimations(playerid), ClearAnim(playerid);
		}
		if(HoldInva[playerid] >= 0) i_del(playerid, HoldInva[playerid]);
		i_takehands(playerid, HoldStat[playerid]);
	}
	return 1;
}
stock put_on_table(playerid, fpick_model, frisk, fquan, fpara, fqara, thingType, thingPack, noinvent)
{
    new objects[50] = {-1, ...}, object_model, Float:table_size[6], Float:table_pos[3], Float:fpick_size[6], Float:frontme_pos[4], yes;

    frontme(playerid, 0.8, frontme_pos[0], frontme_pos[1], frontme_pos[2], frontme_pos[3]);
	Streamer_GetAllVisibleItems(playerid, STREAMER_TYPE_OBJECT, objects);

	for(new i; i < sizeof objects; i++)
	{
	    if(IsValidDynamicObject(objects[i]))
	    {
  			object_model = Streamer_GetIntData(STREAMER_TYPE_OBJECT, objects[i], E_STREAMER_MODEL_ID);

			if(readput == 1) SendClientMessage(playerid, COLOR_GREY, "object_model: %d", object_model);

	        if(!isaobjectnearby(1, object_model) && !isaobjectnearby(2, object_model) && !isaobjectnearby(3, object_model))
			{
			    GetDynamicObjectPos(objects[i], table_pos[0], table_pos[1], table_pos[2]); // Положение объекта
                CA_GetModelBoundingBox(object_model, table_size[0], table_size[1], table_size[2], table_size[3], table_size[4], table_size[5]); // Коллизия Объекта
                if(IsPlayerInCube(playerid, table_pos[0]+table_size[0]-0.8, table_pos[1]+table_size[1]-0.8, table_pos[2]+table_size[2]-0.8, table_pos[0]+table_size[3]+0.8, table_pos[1]+table_size[4]+0.8, table_pos[2]+table_size[5]+0.8))
                {
	                if((table_pos[0] >= frontme_pos[0]-1.0 && table_pos[0] <= frontme_pos[0]+1.0) && (table_pos[1] >= frontme_pos[1]-1.0 && table_pos[1] <= frontme_pos[1]+1.0))
					{
						yes = 1;
						if(readput == 1) SendClientMessage(playerid, COLOR_GREY, "{ff9000}put to object model: %d", object_model);
					}
	                break;
  				}
			}
	    }
	}
	
	CA_GetModelBoundingBox(friskPick[fpick_model], fpick_size[0], fpick_size[1], fpick_size[2], fpick_size[3], fpick_size[4], fpick_size[5]); // Размеры Объекта
	new m = friskPick[fpick_model], Float:rx, Float:ry;
	new Float:cor_z = object_correct_z(m);
	if(m >= 2212 && m <= 2217 || m == 2353 || m == 2354) rx = -25.399997, ry = 23.199987, frontme_pos[3] -= 90;
	if(m == 2221 || m == 2222 || m == 2223) frontme_pos[3] -= 90;
	if(yes == 0) // На пол
	{
    	SetThrow(playerid, fpick_model, frisk, fquan, fpara, fqara, thingType, thingPack, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), frontme_pos[0], frontme_pos[1], frontme_pos[2]-1.0+cor_z, rx, ry, frontme_pos[3], 10800, 0, noinvent);
    	ApplyAnimation(playerid,"CARRY","putdwn",4.0, false, false, false, false, false, SYNC_ALL);

		// Квест знакомство с едой
		if(IsANaborsEdoi(HoldFrisk[playerid]) && PlayerInfo[playerid][pQuest][8] == 3)
    	{
			ErrorMessage(playerid, "{FF6347}Чтобы покушать, набор необходимо поставить на стол\
									\n\n{ffcc66}- Поднимите набор с пола [ N >> Рядом ] {FF6347}| Ваш набор будет выделяться белым фоном\
									\n{ffcc66}- С набором в руках, подойдите к краю стола и поставьте набор [ Кнопка F ]\
									\n{ffcc66}- Если не получилось, попробуйте подойти к столу с другой стороны");
    	}
	}
	else if(yes == 1) // На стол
	{
	    SetThrow(playerid, fpick_model, frisk, fquan, fpara, fqara, thingType, thingPack, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), frontme_pos[0], frontme_pos[1], table_pos[2]+table_size[5]+cor_z, rx, ry, frontme_pos[3], 10800, 1, noinvent);
		ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false, SYNC_ALL);

		// Квест знакомство с едой
		if(IsANaborsEdoi(HoldFrisk[playerid]) && PlayerInfo[playerid][pQuest][8] == 3)
    	{
        	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Теперь садитесь на стул или диван рядом с вашим набором [ Кнопка ALT ]","*","");
    	}
	}
	streamer_update_nearby(playerid);
	around_player_audio(playerid, 5601, 0, 5.0, 0);
	return 1;
}
stock isaobjectnearby(stat, m)
{
	if(stat == 0) // Стол
	{
		if(m == 2637 || m == 2644 || m == 2635 || m == 1516 || m == 2763 || m == 2764 || m == 1433 || m == 19997 || m == 2169 || m == 2180 || m == 2607 || m == 1999 || m == 2171 || m == 2175 || m == 11690 || m == 14869
	 	|| m == 2173 || m == 2008 || m == 1896 || m == 2762 || m == 2370 || m == 2313 || m == 2198 || m == 2637 || m == 2314 || m == 2747 || m == 2321 || m == 2205 || m == 2319 || m == 2206 || m == 11691 || m == 19922
	 	|| m == 2592 || m == 2315 || m == 2311 || m == 2165 || m == 2605 || m == 2319 || m == 2172 || m == 2009 || m == 2185 || m == 2174 || m == 2181 || m == 1963 || m == 1998 || m == 2207 || m == 2184 || m == 2166
	 	|| m == 936 || m == 937 || m == 941 || m == 19925 || m == 19926 || m == 19928 || m == 19929 || m == 19930 || m == 19931 || m == 19932 || m == 19934 || m == 2193 || m == 2308 || m == 2182 || m == 2183 || m == 2592
	 	|| m == 19934 || m == 19935 || m == 19936 || m == 19937 || m == 19474 || m == 2346 || m == 2784 || m == 1416 || m == 1740 || m == 1741 || m == 1743 || m == 1813 || m == 1815 || m == 1814 || m == 1817 || m == 1818
	 	|| m == 1819 || m == 1820 || m == 1821 || m == 1823 || m == 2081 || m == 2082 || m == 2083 || m == 2094 || m == 209 || m == 2126 || m == 2137 || m == 2087 || m == 2133 || m == 2134 || m == 2139 || m == 2137
	  	|| m == 2142 || m == 2148 || m == 2151 || m == 2155 || m == 2152 || m == 2156 || m == 2157 || m == 2160 || m == 2234 || m == 2236 || m == 2306 || m == 2323 || m == 2328 || m == 2334 || m == 2335 || m == 2338
	   	|| m == 2143 || m == 2562 || m == 2568 || m == 2570 || m == 2574 || m == 2368 || m == 2387 || m == 2414 || m == 2413 || m == 2423 || m == 2424 || m == 2434 || m == 2435 || m == 2439 || m == 2440 || m == 2441
    	|| m == 2442 || m == 2444 || m == 2445 || m == 2446 || m == 2450 || m == 2454 || m == 2455 || m == 2586) return 1;
 	}
 	else if(stat == 1) // Стул / Диван (Сидеть)
	{
	    if(m == 19996 || m == 19994 || m == 2121 || m == 2310 || m == 2788 || m == 2807 || m == 2309 || m == 1811 || m == 1811 || m == 1810 || m == 2639) return 1;
	}
	else if(stat == 2) // Игнор объекты
	{
	    if(m == 2422 || m == 18758 || m == 18887 || m == 18888 || m == 18889 || m == 18981 || m >= 19426 && m <= 19444 || m >= 19353 && m <= 19382 || m >= 19383 && m <= 19417
		|| m >= 19456 && m <= 19466 || m >= 19445 && m <= 19455
	 	|| m == 14383 || m == 14700 || m == 14701 || m == 14702 || m == 14703 || m == 14706 || m == 14708 || m == 14709 || m == 14710 || m == 14711 || m == 14712
 	 	|| m == 14713 || m == 14714 || m == 14717 || m == 14718 || m == 14735 || m == 14736 || m == 14748 || m == 14750 || m == 14754 || m == 14755 || m == 14756
	   	|| m == 14758 || m == 14759 || m == 14760 || m == 15041 || m == 15053 || m == 15054 || m == 15055 || m == 15058
	   	|| m == 1668 || m == 19822 || m == 19821 || m == 19820 || m == 19823 || m == 1544 || m == 1543 || m == 1951 || m == 2601 || m == 19835
	    || m == 19818 || m == 1666 || m == 1486 || m == 19824 || m == 19819 || m == 19893) return 1;
	}
	else if(stat == 3) // Игнорим объекты каркасов, чтобы он нам не попадался
	{
		if(IsAFrameObject(m)) return 1;
	}
 	return 0;
}
function streamer_update_nearby(playerid)
{
    foreach(Player,i)
	{
	    if(OnlineInfo[i][oLogged] == 0 || GetPlayerInterior(i) != GetPlayerInterior(playerid) && GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
	    if(IsPlayerInRangeOfPoint(playerid,20.0,Protect_X[i], Protect_Y[i], Protect_Z[i])) Streamer_Update(i);
	}
}


stock StreamerUpdateNearby(Float:radius, Float:x, Float:y, Float:z, world, interior, type = -1)
{
	foreach(Player,i)
	{
	    if(OnlineInfo[i][oLogged] == 1 
			&& GetPlayerVirtualWorld(i) == world
			&& GetPlayerInterior(i) == interior
	   		&& IsPlayerInRangeOfPoint(i, radius, x, y, z)) Streamer_Update(i, type);
	}
	return true;
}

stock update_label_rul(rt)
{
	new string[120];
    if(rulstol[rt] == 1) format(string,sizeof(string),"{ff9000}Рулетка\n{cccccc}ALT - Играть\n{cccccc}ENTER - выйти\n\n{99ff66}Ставка Сделана: {ff9000}%d",rultime[rt]+1);
	else if(rulstol[rt] == 2) format(string,sizeof(string),"{ff9000}Рулетка\n{cccccc}ALT - Играть\n{cccccc}ENTER - выйти\n\n{99ff66}Рулетка Крутится: {ff9000}%d",rultime[rt]+1);
	UpdateDynamic3DTextLabelText(RuletText[rt],0xA9C4E4FF,string);
	return 1;
}
stock reset_stavka_stol(desk)
{
    // Ставка стола или Начальная Ставка (сбрасываем)
    if(DeskInfo[desk][Typebid] == 1) DeskInfo[desk][Bet] = 1;
	else
	{
	    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
		{
			if(DeskInfo[desk][Betsize] == 0) DeskInfo[desk][Bet] = 100;
			else DeskInfo[desk][Bet] = 50000;
		}
	    else
	    {
			if(DeskInfo[desk][Betsize] == 0) DeskInfo[desk][Bet] = 10;
			else DeskInfo[desk][Bet] = 1000;
		}
	}

	// Максимальная ставка
	if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) DeskInfo[desk][Maxbet] = 0;
    else if(DeskInfo[desk][Game] == 3)
    {
        if(DeskInfo[desk][Typebid] == 1) DeskInfo[desk][Maxbet] = 100;
        else
        {
            if(DeskInfo[desk][Betsize] == 0) DeskInfo[desk][Maxbet] = 1000;
            else DeskInfo[desk][Maxbet] = 1000000;
        }
    }
    return 1;
}
stock isamute(playerid)
{
    if(PlayerInfo[playerid][pMuteTime] >= 1)
	{
		new string[80];
	    if(PlayerInfo[playerid][pMuteTime] >= 61) format(string, sizeof(string), "{FF6347}У вас бан чата [ Осталось %d минут ]", PlayerInfo[playerid][pMuteTime]/60);
	 	else format(string, sizeof(string), "{FF6347}У вас бан чата [ Осталось %d секунд ]", PlayerInfo[playerid][pMuteTime]);
	 	ErrorMessage(playerid, string);
	    return 1;
	}
	return 0;
}
