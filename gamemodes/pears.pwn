				}
			}
			if((PlayerInfo[i][pJailed] == 4 || PlayerInfo[i][pJailed] == 7) && MPGO[i] == 0 && GetPlayerState(i) == PLAYER_STATE_ONFOOT)
		    {
		    	if(HealthAC[i] < GetMaxPlayerHealth(i))
            	{
					if(PlayerInfo[i][pJailed] == 4) ACSetPlayerHealth(i, HealthAC[i] + 0.5);
					else if(PlayerInfo[i][pJailed] == 7)
					{
						if(!IsPlayerInRangeOfPoint(i,1.0,Job_X[i], Job_Y[i], Job_Z[i]))
						{
				        	NoAnim[i] = 0;
				        	PlayerInfo[i][pJailed] = 4;
				        	if(HospBed[i] != 9999) ClearBedMed(i);
				        	PlayerPlaySound(i,4203,0,0,0);
						}
						ACSetPlayerHealth(i, HealthAC[i] +1.0);
					}
					PlayerInfo[i][pRanentors] = 0;
					if(HealthAC[i] >= 1.0)
					{
						if(PlayerInfo[i][pSex] == 1) SetPlayerChatBubble(i,"пациент", COLOR_LIGHTRED,20.0,1500);
						else SetPlayerChatBubble(i,"пациентка", COLOR_LIGHTRED,20.0,1500);
					}
					else
					{
						if(PlayerInfo[i][pSex] == 1) SetPlayerChatBubble(i,"госпитализирован", COLOR_LIGHTRED,20.0,1500);
						else SetPlayerChatBubble(i,"госпитализирована", COLOR_LIGHTRED,20.0,1500);
					}
            	}
            	if(HealthAC[i] >= GetMaxPlayerHealth(i))
				{
					if(PlayerInfo[i][pJailed] == 7)
					{
						SetCameraBehindPlayer(i);
    					ClearAnim(i);
						if(HospBed[i] != 9999) ClearBedMed(i);
					}
					NoAnim[i] = 0;
					if(PlayerInfo[i][pMember] == 3)
					{
				    	SendClientMessage(i, COLOR_GREY,"  Вы прошли курс лечения и можете быть свободны! [ Оплата: 800$ ]");
						oGivePlayerMoney(i, -800);
					}
					else SendClientMessage(i, COLOR_GREY,"  Вы прошли курс лечения и можете быть свободны!");
				    PlayerInfo[i][pJailed] = 0;PlayerInfo[i][pJailTime] = 0;
				    TogglePlayerControllable(i, true);
				    SetPlayerWorldBounds(i,200000.0000,-200000.0000,200000.0000,-200000.0000); //Reset world to player
				    TempGive(i);
				    GameTextForPlayer(i, RusToGame("~w~Вы ~g~Свободны"), 5000, 3);
				    SetPlayerToTeamColor(i);
				    if(Nolet[i] == 1) DestroyPlayerObject(i, NoletObj[i]), Nolet[i] = 0;
				}
		    }
		    // Проверка на Стул
		    if(SitPlayer[i] >= 1 && OverHear[i] == 0)
		    {
		    	if(!IsPlayerInRangeOfPoint(i,1.5,Job_X[i], Job_Y[i], Job_Z[i])) exitsit(i, 0);
		    }
		    if(PortInfo[wStat] == 1)
  			{
  				new Float:posic[3];
  				GetPlayerPos(i, posic[0], posic[1], posic[2]);
  				if(MafiaBattle[0][i] == 1)
  				{
  				    if(!IsPlayerInSquare(i,-1739.7145, -103.8218,-1694.4082,-27.3040)) eject_mafiabattle(i);
  					if(IsPlayerInSquare(i,-1739.7145, -103.8218,-1694.4082,-27.3040) && (posic[2] <= 2.0 || posic[2] >= 18.0)) eject_mafiabattle(i);
  				}
  				if(IsPlayerInSquare(i,-1739.7145, -103.8218,-1694.4082,-27.3040) && posic[2] >= 3.0 && posic[2] <= 17.0 && HealthAC[i] >= 1.0 && PlayerInfo[i][pJailed] == 0 && PlayerInfo[i][pSoska] <= 0)
  				{
  					if(MafiaBattle[0][i] == 0 && PortInfo[wOne] == fraction(i)) kick_mafiabattle(i, 0);
					if(MafiaBattle[1][i] == PortInfo[wNumer] && PortInfo[wTwo] == fraction(i) && PortInfo[wTwo] >= 1) kick_mafiabattle(i, 0);
  					if(PortInfo[wOne] != fraction(i) && (PortInfo[wTwo] != fraction(i) && PortInfo[wTwo] >= 1)) kick_mafiabattle(i, 0);
  				}
  			}
  			if(PortInfo[wStat] == 2)
  			{
  				new Float:posic[3];
  				GetPlayerPos(i, posic[0], posic[1], posic[2]);
  				if(MafiaBattle[0][i] == 2)
  				{
  				    if(!IsPlayerInSquare(i,2401.7756,-2641.1243,2447.0828,-2564.6064)) eject_mafiabattle(i);
  					if(IsPlayerInSquare(i,2401.7756,-2641.1243,2447.0828,-2564.6064) && (posic[2] <= 12.0 || posic[2] >= 28.0)) eject_mafiabattle(i);
  				}
  				if(IsPlayerInSquare(i,2401.7756,-2641.1243,2447.0828,-2564.6064) && posic[2] >= 13.0 && posic[2] <= 27.0 && HealthAC[i] >= 1.0 && PlayerInfo[i][pJailed] == 0 && PlayerInfo[i][pSoska] <= 0)
  				{
  					if(MafiaBattle[0][i] == 0 && PortInfo[wOne] == fraction(i)) kick_mafiabattle(i, 1);
					if(MafiaBattle[1][i] == PortInfo[wNumer] && PortInfo[wTwo] == fraction(i) && PortInfo[wTwo] >= 1) kick_mafiabattle(i, 1);
  					if(PortInfo[wOne] != fraction(i) && (PortInfo[wTwo] != fraction(i) && PortInfo[wTwo] >= 1)) kick_mafiabattle(i, 1);
  				}
  			}
	      }
    }
    for(new gang = 1; gang < 23; gang++)
    {
		if(ChutC[gang] >= 1) ChutC[gang] --;
	}
    if(mafstat == 1 || mafstat == 2)
