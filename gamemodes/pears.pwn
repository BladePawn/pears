stock SettingSkladOrganization(playerid, g)
{
	new str[70], sctring[1500];
	if(OrganInfo[g][gWarehouse] == false) format(str,sizeof(str),"{cccccc}Доступ для всех \t{99ff66}[ Открыт ]\n"), strcat(sctring,str);
	else if(OrganInfo[g][gWarehouse] == true) format(str,sizeof(str),"{cccccc}Доступ для всех \t{FF6347}[ Закрыт ]\n"), strcat(sctring,str);

	strcat(sctring, "{cccccc}Доступное оружие {ff9000}>>\t\n");
	format(str,sizeof(str),"{cccccc}Лимит Ammo 20,8mm \t{ff9000}[ %d шт. ]\n",OrganInfo[g][gUnitStat][10]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Лимит Ammo 11,43mm \t{ff9000}[ %d шт. ]\n",OrganInfo[g][gUnitStat][11]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Лимит Ammo 5,45mm \t{ff9000}[ %d шт. ]\n",OrganInfo[g][gUnitStat][12]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Лимит Ammo 45mm \t{ff9000}[ %d шт. ]\n",OrganInfo[g][gUnitStat][13]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Ammo 20,8mm \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][14]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Ammo 11,43mm \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][15]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Ammo 5,45mm \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][16]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Ammo 45mm \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][17]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Оружия \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][18]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Аптечек \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][19]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Касок \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][20]), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Интервал Бронежилетов \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][21]), strcat(sctring,str);
	if(g == 2 || g == 5 || g == 6 || g == 8 || g == 10 || g >= 12 && g <= 20)
	{
		format(str,sizeof(str),"{cccccc}Лимит Веществ \t{ff9000}[ %d шт. ]\n",OrganInfo[g][gUnitStat][22]), strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Интервал Веществ \t{ff9000}[ %d минут ]\n",OrganInfo[g][gUnitStat][23]), strcat(sctring,str);
	}
	new lol[84];
	format(lol,sizeof(lol),"{cccccc}Настройки Склада %s",frakName[g]);
	ShowDialog(playerid,638,DIALOG_STYLE_TABLIST,lol,sctring,"Выбрать","Отмена");
   	return 1;
}

