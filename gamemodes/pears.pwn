CMD:stopanimka(playerid)
{
	if(GetPVarInt(playerid,"AnimSet") == 1) NoAnim[playerid] = 0, ClearAnim(playerid), SetPVarInt(playerid, "AnimSet", 0);
 	return 1;
}
function rope(p, v, pid, Float:x, Float:y, Float:z)
{
	if(IsOnline(p) && IsOnline(pid) && Protect_Veh[pid] == v && VehInfo[v][vStat] == 1)
	{
		if(!RopeStat[p])
		{
			new Float: zangle;
			GetVehicleZAngle(v, zangle), SetVehicleZAngle(v, zangle);
			if(pid != p) TogglePlayerControllable(pid, false);
			else pc_cmd_rvc(p);
			PPSetPlayerPos(p, x, y, z-2.0);
			ClearAnimations(p);
			ApplyAnimation(p,"PED","abseil",1.0,true,true,true,false,false,SYNC_ALL);
			RopeTimer[p] = SetTimerEx("ropeslide", 50, true, "ddd", p, v, pid), RopeStat[p] = true;
			RopeVeh[p] = v;
			RopeID[p] = pid;
			RopeQuan[p] += 1;
			if(VehInfo[v][vRope] == 0)
			{
				if(VehInfo[v][vRopeStat][0] == 0)
				{
					VehInfo[v][vRopeStat][0] = 1;
					VehInfo[v][vRopeObj][0] = CreateDynamicObject(19089, x, y, z, 0.000000, 0.000000, 0.000000, GetPlayerVirtualWorld(p), GetPlayerInterior(p), -1, 300.00, 300.00);
				}
				if(VehInfo[v][vRopeStat][1] == 0 && v_rope[1][p] >= 13)
				{
					VehInfo[v][vRopeStat][1] = 1;
					VehInfo[v][vRopeObj][1] = CreateDynamicObject(19089, x, y, z-7.0, 0.000000, 0.000000, 0.000000, GetPlayerVirtualWorld(p), GetPlayerInterior(p), -1, 300.00, 300.00);
				}
			}
			VehInfo[v][vRope] += 1;
			CompleteBattlePassTask(p, 14, 1);
		}
	}
}
stock ropedown(p, v, pid, stat)
{
	if(RopeStat[p]) KillTimer(RopeTimer[p]), RopeStat[p] = false;
	if(IsOnline(p))
	{
		if(stat == 1) TogglePlayerControllable(p, true), ApplyAnimation(p,"PED","Crouch_Roll_R",4.0, false, true, true, false, false, SYNC_ALL);
		else ClearAnimations(p);
		RopeQuan[p] = 0;
	}
	if(VehInfo[v][vRope] > 0) VehInfo[v][vRope] -= 1;
	if(VehInfo[v][vRope] == 0)
	{
		if(IsOnline(pid) && Protect_Veh[pid] == v) TogglePlayerControllable(pid, true);
		if(VehInfo[v][vRopeStat][0] > 0) DestroyDynamicObject(VehInfo[v][vRopeObj][0]), VehInfo[v][vRopeStat][0] = 0;
		if(VehInfo[v][vRopeStat][1] > 0) DestroyDynamicObject(VehInfo[v][vRopeObj][1]), VehInfo[v][vRopeStat][1] = 0;
	}
}
function ropeslide(p, v, pid)
{
	new Float:pos[3];
	GetPlayerPos(p, pos[0], pos[1], pos[2]);
    if(pos[2] > v_rope[0][p]+1.5)
	{
		if(IsOnline(p))
		{
		    if(GetPVarInt(p, "afksystem") >= 3) ropedown(p, v, pid, 0);
		    if(VehInfo[v][vStat] == 1) ACSetVehiclePos(v, VehInfo[v][vehX], VehInfo[v][vehY], VehInfo[v][vehZ]);
			SetPlayerVelocity(p, 0.0, 0.0, -0.09);
			RopeQuan[p] ++;
			if(RopeQuan[p] >= 70) ropedown(p, v, pid, 1);
		}
	}
    else ropedown(p, v, pid, 1);
	return 1;
}
CMD:rope(p)
{
	if(IsPlayerInAnyVehicle(p) && GetPlayerState(p) != PLAYER_STATE_DRIVER)
	{
		new v = GetPlayerVehicleID(p);
		new m = VehInfo[v][vModel];
		if(IsAHelicopter(m))
		{
			if(howstun(p)) return ErrorMessage(p, "{FF6347}Вашему персонажу плохо");
		    if(GetPlayerPing(p) > 250) return ErrorMessage(p, "{FF6347}У вашего персонажа кружится голова [ Высокий Ping 250+ ]");
		    if(!IsPoliceMember(p) && get_invent4(p, 13, 0) <= 0) return ErrorMessage(p, "{FF6347}У вас нет с собой верёвки [ Y >> GPS >> Услуги >> Супермаркет ]");
		    new Float:pos[3], Float:ropep, Float:vrempos, pid = -1;
		    GetVehiclePos(v, pos[0], pos[1], pos[2]);
		    VehInfo[v][vehX] = pos[0], VehInfo[v][vehY] = pos[1], VehInfo[v][vehZ] = pos[2];
		    vrempos = pos[2];
		    CA_FindZ_For2DCoord(pos[0], pos[1], pos[2]);
		    //MapAndreas_FindZ_For2DCoord(pos[0], pos[1], pos[2]);
		    v_rope[0][p] = pos[2];
		    ropep = vrempos-pos[2];
		    v_rope[1][p] = vrempos;
			if(ropep <= 4) return ErrorMessage(p, "{FF6347}Вертолёт слишком низко [ 5 - 20 метров ]");
			else if(ropep >= 21) return ErrorMessage(p, "{FF6347}Вертолёт слишком высоко [ 5 - 20 метров ]");
			foreach(Player, i)
			{
				if(OnlineInfo[i][oLogged] == 0) continue;
				if(GetPlayerState(i) != PLAYER_STATE_DRIVER) continue;
				if(Protect_Veh[i] != v) continue;
				pid = i;
			}
			if(pid < 0) return ErrorMessage(p, "{FF6347}В вертолёте нет пилота");
			if(GetPVarInt(pid,"afksystem") > 3) return ErrorMessage(p, "{FF6347}Пилот вертолёта уснул");
			if(RopeQuan[p] == 0)
			{
				RopeQuan[p] = 1, PlayerPlaySound(p,6401,0,0,0);
				if(VehInfo[v][vRope] > 0) SetTimerEx("rope", VehInfo[v][vRope]*500, false, "dddfff", p, v, pid, pos[0], pos[1], vrempos);
				else rope(p, v, pid, pos[0], pos[1], vrempos);
			}
		}
	}
	return 1;
}
alias:limiter("speedlimit", "limit")
CMD:limiter(playerid, const params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid ,COLOR_GREY, "[ Мысли ]: Мне нужно быть за рулём"), PlayerPlaySound(playerid,4203,0,0,0);
	new v = GetPlayerVehicleID(playerid);
	new model = VehInfo[v][vModel];
	if(IsAVello(v)) return SendClientMessage(playerid ,COLOR_GREY, "[ Мысли ]: Нельзя на велосипеде"), PlayerPlaySound(playerid,4203,0,0,0);
	if(IsAPlane(model)) return SendClientMessage(playerid ,COLOR_GREY, "[ Мысли ]: Нельзя на самолёте или вертолёте"), PlayerPlaySound(playerid,4203,0,0,0);
	sscanf(params, "I(-1)",params[0]);
	if(params[0] == -1 && PlayerInfo[playerid][pSLimit] > 0) {
		SendClientMessage(playerid ,COLOR_GREY, "{0088ff}[Ограничитель Скорости]: {FF6347}Выключен");
		PlayerPlaySound(playerid,31200,0,0,0);
		PlayerInfo[playerid][pSLimit] = 0;
	} else {
		if (params[0] < 50 || params[0] > 250) {
			SendClientMessage(playerid ,COLOR_GREY, "[ Мысли ]: Ограничитель скорости не меньше 50 и не больше 250");
			PlayerPlaySound(playerid,4203,0,0,0);
		} else {
			if(WatchSpeed[playerid] > 5.0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя в движении"), PlayerPlaySound(playerid,4203,0,0,0);
			PlayerInfo[playerid][pSLimit] = params[0];
			new string[84];
			format(string, sizeof(string), "{0088ff}[Ограничитель Скорости]: Установлен на {ff9000}%d КМ/Ч", params[0]);
			SendClientMessage(playerid ,COLOR_GREY, string);
			PlayerPlaySound(playerid,6401,0,0,0);
		}
	}
	UpdateVehEngine(playerid);
	return 1;
}
CMD:ram(playerid)
{
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		new g = fraction(playerid);
		if(!IsAFunctionOrganization(44, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
		if(!GetAccessRankOrg(playerid, g, 44, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(Piss[playerid] >= 1 || CnnVed[playerid] >= 11 || Sleep[playerid] >= 1 || GetPlayerSpeed(playerid) > 3 || IsPlayerInAnyVehicle(playerid)
	|| GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1 || NoAnim[playerid] == 1 || howstun(playerid)) return 1;
	new string[144];
	for(new d = 0; d < sizeof(DomInfo); d++)
	{
		if(IsPlayerInRangeOfPoint(playerid,2.0,DomInfo[d][dKoordinatX], DomInfo[d][dKoordinatY], DomInfo[d][dKoordinatZ]))
		{
			format(string, sizeof(string), "взламывает дверь дома № %d", d);
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,9000);
			S_SetPlayerVirtualWorld(playerid,d+1000,DomInfo[d][dInterior]);
			PPSetPlayerInterior(playerid,DomInfo[d][dInterior]);
			PPSetPlayerPos(playerid,DomInfo[d][dEnterX],DomInfo[d][dEnterY],DomInfo[d][dEnterZ]);
			PPSetPlayerFacingAngle(playerid, DomInfo[d][dEnterA]);
			keep(playerid);
			SetCameraBehindPlayer(playerid);
			break;
		}
	}
	return 1;
}
forward Call_renamemarried(playerid, datadid, str_name[], new_name[]);
public Call_renamemarried(playerid, datadid, str_name[], new_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new string[184];
 		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `MarriedTo`='%e' WHERE `user_id`='%d'", new_name, datadid), query_empty(pearsq, string);
 		format(string, sizeof(string), "Ваш(а) спруг(а) %s меняет имя на %s", PlayerInfo[playerid][pName], new_name);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	return 1;
}
forward Call_divorce(playerid, datadid, str_name[]);
public Call_divorce(playerid, datadid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new string[184];
 		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `MarriedTo`='нет',`Married`='0' WHERE `user_id`='%d'", datadid);
		query_empty(pearsq, string);
 		format(string, sizeof(string), "%s больше не в браке с вами (развод)", PlayerInfo[playerid][pName]);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	return 1;
}
CMD:stp(playerid, const params[]) // Команда: Закон
{
	if(!IsPoliceMember(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не представитель силовых структур..");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Потребовать остановиться [ /stp ID ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(!ProxDetectorS(30.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый далеко от меня");
	new vehicleid = GetPlayerVehicleID(params[0]);
	if(GetPlayerState(params[0]) != PLAYER_STATE_DRIVER || !IsValidVehicle(vehicleid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый не за рулём");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я что-то путаю.. Зачем я буду себя заставлять остановиться?");
	new string[144];
	if(GetPVarInt(playerid,"antiflood") > 0) return format(string, sizeof(string), "[ Мысли ]: Я не могу так часто требовать остановки [ Через %d сек. ]",GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY,string);

	new vehicle_name[35]; strcat(vehicle_name, GetVehicleName(VehInfo[vehicleid][vModel]));

	if (isnull(VehInfo[vehicleid][vNumer]))
		format(string, sizeof(string), "[%s]: {3398ff}Водитель %s, остановите транспортное средство и прижмитесь к обочине!", PlayerInfo[playerid][pName], vehicle_name);
	else
		format(string, sizeof(string), "[%s]: {3398ff}Водитель %s {99ff66}[%s]{3398ff}, остановите транспортное средство и прижмитесь к обочине!", PlayerInfo[playerid][pName], vehicle_name, VehInfo[vehicleid][vNumer]);
	
	ProxDetector(40.0, playerid, string, 0x33CCFFFF, 0x33CCFFFF, 0x33CCFFFF, 0x33CCFFFF, 0x33CCFFFF);
	if(OnlineInfo[params[0]][oListenRadioPears] == 0) PlayAudioStreamForPlayer(params[0], "https://cdn.pears.fun/sound/stop.mp3");
	if(OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/stop.mp3");
	SetPlayerChatBubble(params[0],"WTF?!?",COLOR_RED,30.0,10000);
	SetPlayerChatBubble(playerid, string, COLOR_GREY, 35.0, 5700);
	SetPVarInt(playerid,"antiflood",5);
   	return 1;
}

CMD:ship(playerid, const params[])
{
	if(!IsPoliceMember(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Бросить шипы под колёса [ /ship ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
	if(!ProxDetectorS(10.0, playerid, params[0]) 
	|| GetPlayerState(params[0]) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Вы далеко от подозреваемого");
	if(params[0] == playerid && server != 0) return ErrorMessage(playerid, "{FF6347}Вы не можете бросить себе шипы под колёса");
	new vehid = GetPlayerVehicleID(params[0]);
 	new Float:x,Float:y,Float:z;
  	new panels, vehdoors, vehlights, tires;
	GetVehiclePos(vehid, x, y, z);

	new string[80];
	format(string, sizeof(string), "* Вы выбросили шипы под колёса %s.", playername(params[0]));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "* %s выбрасывает шипы под колёса %s.", playername(playerid), playername(params[0]));
	ProxDetector(30.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	format(string, sizeof(string), "выбрасывает шипы под колёса %s", playername(params[0]));
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,10000);
	GetVehicleDamageStatus(vehid, VEHICLE_PANEL_STATUS:panels, VEHICLE_DOOR_STATUS:vehdoors, VEHICLE_LIGHT_STATUS:vehlights, VEHICLE_TYRE_STATUS:tires);
	VehInfo[vehid][vRepairFix] = true;
 	UpdateVehicleDamageStatus(vehid, VEHICLE_PANEL_STATUS:panels, VEHICLE_DOOR_STATUS:vehdoors, VEHICLE_LIGHT_STATUS:vehlights, VEHICLE_TYRE_STATUS:5);
 	if(GetPVarInt(playerid, "Shipstand") == 0) Shipi[playerid] = CreatePlayerObject(playerid,2899,x,y-4,z,0,0,-90), SetPVarInt(playerid,"Shipstand",6);
 	if(GetPVarInt(params[0], "Shipstand") == 0) Shipi[params[0]] = CreatePlayerObject(params[0],2899,x,y-4,z,0,0,-90), SetPVarInt(params[0],"Shipstand",6);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
	SetPlayerChatBubble(params[0],"WTF?!",COLOR_RED,30.0,10000);
   	return 1;
}
stock marriage_ceremony(playerid)
{
	if(MarriageOffer[playerid] == 2) return ErrorMessage(playerid, "{FF6347}Вы невеста, вам нужно дождаться когда жених начнет церемонию");
	if(MarriageOffer[playerid] == 3) return ErrorMessage(playerid, "{FF6347}Вы свидетель жениха, вам нужно дождаться когда жених начнет церемонию");
	if(MarriageOffer[playerid] == 4) return ErrorMessage(playerid, "{FF6347}Вы свидетель невесты, вам нужно дождаться когда жених начнет церемонию");
	if(PlayerInfo[playerid][pMarried] > 0) return ErrorMessage(playerid, "{FF6347}Вы уже в браке [ Y >> Меню >> Статистика ]\n{cccccc}Подать на развод можно в правительстве [ Y >> GPS >> Организации >> Фракции ]");
	
	new string[144];
	if(MarriageInfo[mStat] > 0 && MarriageInfo[mMan]-1 != playerid) return format(string,sizeof(string),"{FF6347}%s уже готовит или проводит церемонию\n{cccccc}Дождитесь окончания церемонии или попросите его покинуть церковь",PlayerInfo[MarriageInfo[mMan]-1][pName]), ErrorMessage(playerid, string);
	
    new str[64],sctring[256];
   	format(str,sizeof(str),"{ff99ff}Начать Церемонию"), strcat(sctring,str);
   	
	if(MarriageInfo[mWoman] > 0) format(str,sizeof(str),"\n{cccccc}Невеста: {ff99ff}%s",PlayerInfo[MarriageInfo[mWoman]-1][pName]), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Невеста: нет"), strcat(sctring,str);
	
	if(MarriageInfo[mWintess1] > 0) format(str,sizeof(str),"\n{cccccc}Свидетель Жениха: %s",PlayerInfo[MarriageInfo[mWintess1]-1][pName]), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Свидетель Жениха: нет"), strcat(sctring,str);
	
	if(MarriageInfo[mWitness2] > 0) format(str,sizeof(str),"\n{cccccc}Свидетель Невесты: %s",PlayerInfo[MarriageInfo[mWitness2]-1][pName]), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}Свидетель Невесты: нет"), strcat(sctring,str);
	
	ShowDialog(playerid,1235,DIALOG_STYLE_LIST,"{ff99ff}Церемония Бракосочетания",sctring,"Выбор","Отмена");
	return 1;
}

alias:spawnchange("sc", "spawn", "myspawn")
CMD:spawnchange(playerid)
{
	// Закрываем смартфон
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid);

	if(OnlineInfo[playerid][oShowInterface] > 0) return ErrorMessage(playerid, "{FF6347}Закройте другое, открытое меню");
    PlayerPlaySound(playerid,40405,0,0,0);

	HidePlayerDialog(playerid);
    Login[4][playerid] = 0;

	OnlineInfo[playerid][oShowInterface] = 17;
    for(new i = 0; i < MAX_SPAWNDRAWCHOISE; i++) TextDrawShowForPlayer(playerid, SpawnChoiseDraw[i]);
    SelectColorDraw(playerid);
 	return 1;
}
stock unamute(playerid, playa)
{
	if(!IsOnline(playa)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");

	new string[80];
	format(string, sizeof(string), "[PP]: %s снял мут %s обращения к администрации",PlayerInfo[playerid][pName],PlayerInfo[playa][pName]);
	AllMessage(COLOR_LIGHTRED,string);
	format(string, sizeof(string), "%s снял ваш мут обращения к администрации", PlayerInfo[playerid][pName]);
	SendClientMessage(playa, COLOR_LIGHTRED, string);
	PlayerInfo[playa][pAMute] = 0;
	mysql_save(playa, 24);
	AdminLog("unamute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], 0, "");
	return 1;
}
CMD:amute(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    new playa,tmp[24],string[164];
	if(sscanf(params, "s[24]is[64]",tmp,params[1],params[2])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать бан чата на обращения к администрации [ /amute ID время причина ]");
	if(params[1] < 1 || params[1] > 180) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Время не меньше 1 и не больше 180");
	playa = ReturnUser(tmp, 1);
	if(IsOnline(playa))
	{
		if(checksimvol(params[2])) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		if(OnlineInfo[playa][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Игрок не залогинился ]");
		new unixtime = gettime();
	    if(PlayerInfo[playa][pAMute] > unixtime)
	    {
	    	new ost = PlayerInfo[playa][pAMute]-unixtime;
	    	DP[0][playerid] = playa;
	    	format(string, sizeof(string), "{cccccc}У {FF6347}%s[%d] {cccccc}уже есть мут на обращение к администрации. {FF6347}Осталось: %s минут\n{ff9000}Хотите снять мут?",PlayerInfo[playa][pName],playa,ost/60);
			ShowDialog(playerid,1043,DIALOG_STYLE_MSGBOX,"{ff9000}Mute",string,"Да","Нет");
	    }
	    else
	    {
			format(string, sizeof(string), "[PP]: %s выдал мут %s обращения к администрации на %d минут, причина: %s",PlayerInfo[playerid][pName],PlayerInfo[playa][pName], params[1], params[2]);
			AllMessage(COLOR_LIGHTRED,string);
			format(string, sizeof(string), "Вы получили мут обращения к администрации от %s, на %d минут, причина: %s", PlayerInfo[playerid][pName], params[1], params[2]);
			SendClientMessage(playa, COLOR_LIGHTRED, string);
			PlayerInfo[playa][pAMute] = unixtime+params[1]*60;
			mysql_save(playa, 24);
			AdminLog("amute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], params[1], params[2]);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Игрок Offline ]");
	return 1;
}

alias:reports("rt")
CMD:reports(playerid)
{
    if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pHidden] >= 1)
    {
     	new str[214],sctring[4096],kolko;
     	PlayerPlaySound(playerid,40405,0,0,0);
     	foreach (Player, i)
     	{
            if(OnlineInfo[i][oLogged] == 1)
            {
				if(PlayerInfo[i][pReportStat] >= 1)
				{
					Supports[kolko] = i;
				    if(PlayerInfo[i][pReportStat] == 1)
					{
						if(KtoKomy[i] == 9999) format(str,sizeof(str),"{FF6347}%s[%d] {cccccc}[%s]\n",PlayerInfo[i][pName],i,PlayerInfo[i][pReportTime]); // Жалоба
						else format(str,sizeof(str),"{FF6347}%s[%d] {cccccc}[%s] {ff0000}[ Обрабатывается ]\n",PlayerInfo[i][pName],i,PlayerInfo[i][pReportTime]); // Жалоба
						strcat(sctring,str);
					}
				    else if(PlayerInfo[i][pReportStat] == 2)
					{
						if(KtoKomy[i] == 9999) format(str,sizeof(str),"{33CCFF}%s[%d] {cccccc}[%s]\n",PlayerInfo[i][pName],i,PlayerInfo[i][pReportTime]); // Вопрос
						else format(str,sizeof(str),"{33CCFF}%s[%d] {cccccc}[%s] {ff0000}[ Обрабатывается ]\n",PlayerInfo[i][pName],i,PlayerInfo[i][pReportTime]); // Вопрос
						strcat(sctring,str);
					}
               		kolko++;
	            }

			}
		}
		new lol[28];
		format(lol,sizeof(lol),"Сообщений: {FF6347}%d",kolko);
		ShowDialog(playerid,557,DIALOG_STYLE_LIST,lol,sctring,"Выбор","Отмена");
		if(kolko == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Жалоб и вопросов: {00cc00}нет");
		return 1;
 	}
 	if(PlayerInfo[playerid][pExpert] >= 1)
 	{
     	new str[150],sctring[4096],kolko;
     	PlayerPlaySound(playerid,40405,0,0,0);
     	foreach (Player, i)
     	{
            if(OnlineInfo[i][oLogged] == 1)
            {
				if(PlayerInfo[i][pReportStat] == 2)
				{
					Supports[kolko] = i;
					if(KtoKomy[i] == 9999) format(str,sizeof(str),"{33CCFF}%s[%d] {cccccc}[%s]\n",PlayerInfo[i][pName],i,PlayerInfo[i][pReportTime]); // Вопрос
					else format(str,sizeof(str),"{33CCFF}%s[%d] {cccccc}[%s] {ff0000}[ Обрабатывается ]\n",PlayerInfo[i][pName],i,PlayerInfo[i][pReportTime]); // Вопрос
					strcat(sctring,str);
               		kolko ++;
	            }
			}
		}
		new lol[28];
		format(lol,sizeof(lol),"Сообщений: {FF6347}%d",kolko);
		ShowDialog(playerid,557,DIALOG_STYLE_LIST,lol,sctring,"Выбор","Отмена");
		if(kolko == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Вопросов от игроков: {00cc00}нет");
 	}
 	return 1;
}

alias:report("dai", "request", "support", "vopros", "jaloba")
CMD:report(playerid)
{
    new string[144];
    new unixtime = gettime();
    new ost = PlayerInfo[playerid][pAMute]-unixtime;
    if(PlayerInfo[playerid][pAMute] > unixtime) return format(string, sizeof(string), "[ Мысли ]: Я не могу разговаривать {ff0000}[ Мут на обращение к администрации: %d минут ]", ost/60), SendClientMessage(playerid, COLOR_GREY, string);
	if(GetPVarInt(playerid,"antiflood") == 0)
	{
     	PlayerPlaySound(playerid,1150,0,0,0);
     	DP[0][playerid] = 0;
    	ShowDialog(playerid,555,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Обращение к Администрации", "{cccccc}Выберите вариант обращения к администрации\n" \
			"{FF6347}По мне стреляют или избивают (DM)\n" \
			"{FF6347}Меня давят / сбивают транспортом (DB)\n" \
			"{FF6347}Я столкнулся с оскорбительным отношением\n" \
			"{FF6347}Написать {ff0000}Жалобу\n" \
			"{33CCFF}Задать Вопрос\n"\
			"{D2B48C}FAQ"
		,"Выбор","Отмена");
	    return 1;
	}
	else
	{
		format(string, sizeof(string), "[ Мысли ]: Я не могу так часто отправлять обращения {ff0000}[ %d секунд ]", GetPVarInt(playerid,"antiflood"));
		SendClientMessage(playerid, COLOR_GREY, string);
		return 1;
	}
}
stock get_reason_stop(playerid, stat)
{
	if(stat == 0)
	{
	    if(MPGO[playerid] != 0)
		{
			ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
			return 0;
		}
	}
	else if(stat == 1)
	{
	    if(howstun(playerid) || HealthAC[playerid] <= 0 || Sleep[playerid] >= 1 || SleepRP[playerid] >= 1)
		{
			ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо или он спит");
			return 0;
		}
	}
	else if(stat == 2)
	{
	    if(PlayerInfo[playerid][pJailed] > 0)
		{
			ErrorMessage(playerid, "{FF6347}Вы находитесь в заключении или в больнице");
			return 0;
		}
	}
	else if(stat == 3) return ErrorMessage(playerid, "{FF6347}Вы указали своё имя или ID");
	return 1;
}
stock player_frisk(playerid, stat)
{
	new giveplayerid = DP[0][playerid], quan;
	for(new reset = 0; reset < 40; reset++) List[reset][playerid] = 0, ListQuan[reset][playerid] = 0, ListInva[reset][playerid] = 0, ListPara[reset][playerid] = 0, ListQara[reset][playerid] = 0, ListType[reset][playerid] = 0, ListPack[reset][playerid] = 0, ListUnlegal[reset][playerid] = 0;
	for(new reset = 0; reset < 80; reset++) List[reset][playerid] = 0, ListBackPackQuan[reset][playerid] = 0, ListBackPackInva[reset][playerid] = 0, ListBackPackPara[reset][playerid] = 0, ListBackPackQara[reset][playerid] = 0, ListBackPackType[reset][playerid] = 0, ListBackPackPack[reset][playerid] = 0, ListBackPackUnlegal[reset][playerid] = 0;
	if(stat == 1)
	{
	    for(new i = 0; i < 40; i++)
		{
			if(PlayerInfo[giveplayerid][pInven][i] >= 1 && PlayerInfo[giveplayerid][pInvenQuan][i] >= 1)
			{
				List[quan][playerid] = PlayerInfo[giveplayerid][pInven][i];
				ListQuan[quan][playerid] = PlayerInfo[giveplayerid][pInvenQuan][i];
				ListInva[quan][playerid] = i;
				ListPara[quan][playerid] = PlayerInfo[giveplayerid][pInvenPara][i];
				ListQara[quan][playerid] = PlayerInfo[giveplayerid][pInvenQara][i];
				ListType[quan][playerid] = PlayerInfo[giveplayerid][pInvenType][i];
				ListPack[quan][playerid] = PlayerInfo[giveplayerid][pInvenPack][i];
				quan ++;
			}
  		}
	}
	else if(stat == 2)
	{
	    for(new i = 0; i < 20; i++)
		{
			if(PlayerInfo[giveplayerid][pMarkInven][i] >= 1 && PlayerInfo[giveplayerid][pMarkInvenQuan][i] >= 1)
			{
				List[quan][playerid] = PlayerInfo[giveplayerid][pMarkInven][i];
				ListQuan[quan][playerid] = PlayerInfo[giveplayerid][pMarkInvenQuan][i];
				ListInva[quan][playerid] = i;
				ListPara[quan][playerid] = PlayerInfo[giveplayerid][pMarkInvenPara][i];
				ListQara[quan][playerid] = PlayerInfo[giveplayerid][pMarkInvenQara][i];
				ListType[quan][playerid] = PlayerInfo[giveplayerid][pMarkInvenType][i];
				ListPack[quan][playerid] = PlayerInfo[giveplayerid][pMarkInvenPack][i];
				quan ++;
			}
  		}
	}
	else if(stat == 3)
	{
        if(PlayerInfo[giveplayerid][pBeret] == 0) // В руках
 		{
			for(new i = 0; i < MAX_WEAPON_SLOTS; i++)
			{
				if(ProtectInfo[giveplayerid][prWeapon][i] > 0 && ProtectInfo[giveplayerid][prAmmo][i] > 0)
				{
				    List[quan][playerid] = ProtectInfo[giveplayerid][prWeapon][i];
				    ListQuan[quan][playerid] = ProtectInfo[giveplayerid][prAmmo][i];
					ListInva[quan][playerid] = i;
					ListPara[quan][playerid] = ProtectInfo[giveplayerid][prDet][i];
					ListQara[quan][playerid] = ProtectInfo[giveplayerid][prQet][i];
					ListType[quan][playerid] = 1;
					ListPack[quan][playerid] = 0;
					quan ++;
				}
			}
		}
		else if(PlayerInfo[giveplayerid][pBeret] >= 1) // Временное лишение
		{
			for(new i = 0; i < MAX_WEAPON_SLOTS; i++)
			{
				if(TempWeapon[giveplayerid][i] > 0 && TempAmmo[playerid][i] > 0)
				{
				    List[quan][playerid] = TempWeapon[giveplayerid][i];
				    ListQuan[quan][playerid] = TempAmmo[giveplayerid][i];
					ListInva[quan][playerid] = i;
					ListPara[quan][playerid] = TempDet[giveplayerid][i];
					ListQara[quan][playerid] = TempQet[giveplayerid][i];
					ListType[quan][playerid] = 1;
					ListPack[quan][playerid] = 0;
					quan ++;
				}
			}
		}
	}
	else if(stat == 4)
	{
        for(new i = 0; i < 5; i++)
		{
            if(PlayerInfo[giveplayerid][pOdet][i] > 0)
            {
                List[quan][playerid] = PlayerInfo[giveplayerid][pOdet][i];
			    ListQuan[quan][playerid] = 1;
				ListInva[quan][playerid] = i;
				ListPara[quan][playerid] = PlayerInfo[giveplayerid][pOdetPara][i];
				ListQara[quan][playerid] = PlayerInfo[giveplayerid][pOdetQara][i];
				ListType[quan][playerid] = 2;
				ListPack[quan][playerid] = 0;
				quan ++;
            }
		}
	}
	else if(stat == 5)
	{
		new Aks = HasABustAks(giveplayerid,1);
		new bpslots;
		if(Aks == -1) return ErrorMessage(playerid,"{ff6347}На игроке нет рюкзака");
		if(GetBustAksType(PlayerInfo[giveplayerid][pOdet][Aks]) == 1) bpslots = ResultCountBustAks(PlayerInfo[giveplayerid][pOdet][Aks], 1,PlayerInfo[giveplayerid][pOdetPara][Aks]);
		if(bpslots == 0) bpslots = 1;
        for(new i = 0; i < bpslots*20; i++)
		{
            if(BackPackInfo[giveplayerid][backpackInvent][i] > 0)
            {
                List[quan][playerid] = i;
			    ListBackPackQuan[quan][playerid] = BackPackInfo[giveplayerid][backpackInv][i];
				ListBackPackInva[quan][playerid] = BackPackInfo[giveplayerid][backpackInvent][i];
				ListBackPackPara[quan][playerid] = BackPackInfo[giveplayerid][backpackInvPara][i];
				ListBackPackQara[quan][playerid] = BackPackInfo[giveplayerid][backpackInvQara][i];
				ListBackPackType[quan][playerid] = BackPackInfo[giveplayerid][backpackInvType][i];
				ListBackPackPack[quan][playerid] = BackPackInfo[giveplayerid][backpackInvPack][i];
				quan ++;
            }
		}
	}

	// Записали ID организации
	FriskPlayerMember[playerid] = PlayerInfo[giveplayerid][pMember];

	if(quan == 0) return ErrorMessage(playerid,"{ff6347}У игрока пусто в данном инвентаре");
	showfrisk3(playerid);
	return 1;
}

stock get_frisklic(playerid, stat, datadid) // Поиск лицензий (Которые принадлежат игроку)
{
	new kolvo = 0;
	for(new i = 0; i < 40; i++)
	{
	    if(List[i][playerid] == stat && ListType[i][playerid] == 0 && ListPara[i][playerid] == datadid) kolvo ++;
	}
	return kolvo;
}
stock showfrisk3(playerid)
{
    new giveplayerid = DP[0][playerid], datadid, herelic[2];
    if(DP[1][playerid] < 1 || DP[1][playerid] > 5) return 1;
    if(DP[2][playerid] == 0)
    {
    	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
    	if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
    	datadid = PlayerInfo[giveplayerid][pID];
	}
	else datadid = giveplayerid;
	new str[64],sctring[2560], nenorm;
	format(str,sizeof(str),"{FF6347}%s \t  \t ", ListName[playerid]), strcat(sctring,str);
	
	if(DP[1][playerid] == 3 && DP[2][playerid] == 0)
	{
	    herelic[0] = get_lic(giveplayerid, 161);
	    herelic[1] = get_lic(giveplayerid, 162);
	}
	else if(DP[1][playerid] != 3)
	{
		herelic[0] = get_frisklic(playerid, 161, datadid);
		herelic[1] = get_frisklic(playerid, 162, datadid);
	}
	
	if(DP[1][playerid] == 5)
	{
		new Aks = HasABustAks(giveplayerid,1);
		new bpslots;
		if(GetBustAksType(PlayerInfo[giveplayerid][pOdet][Aks]) == 1) bpslots = ResultCountBustAks(PlayerInfo[giveplayerid][pOdet][Aks], 1,PlayerInfo[giveplayerid][pOdetPara][Aks]);
		if(bpslots == 0) bpslots = 1;
		for(new i = 0; i < bpslots*20; i++)
		{
			nenorm = 0;

			new thingId = ListBackPackInva[i][playerid], thingType = ListBackPackType[i][playerid], thingQuan = ListBackPackQuan[i][playerid], thingPack = ListBackPackPack[i][playerid];

			if(thingId > 0)
			{
				if(UnlegalThing(thingId, thingType, thingPack)
					|| UnlegalSkin(FriskPlayerMember[playerid], ListBackPackPara[i][playerid], thingType)) 
				{
					format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Нелегальный",GetNameThing(1, thingId, thingType, thingPack), thingQuan);
					strcat(sctring,str);
					nenorm = 1;
					ListBackPackUnlegal[i][playerid] = 1;
				}
				else
				{
					if(ListBackPackQara[i][playerid] > 0 && !IsABackPack(thingId)) format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Украденный",GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str), nenorm = 1, ListBackPackUnlegal[i][playerid] = 2;
					else
					{
						if(DocumentThing(thingId, thingType)) // Документы и лицы
						{
							if(thingId != 160) ListBackPackUnlegal[i][playerid] = 1;
							if(ListBackPackPara[i][playerid] != datadid) format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Чужой документ",GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str), nenorm = 1;
						}
						else if(thingType == 1) // Оружие, где бы оно не было
						{
							ListBackPackUnlegal[i][playerid] = 2;
							if(weapon_class(thingId) == 3 || weapon_class(thingId) == 2 && herelic[1] == 0 || weapon_class(thingId) == 1 && herelic[0] == 0 && herelic[1] == 0) format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Нелегальный",GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str), nenorm = 1;
						}
					}
				}
				if(nenorm == 0) format(str, sizeof(str), "\n{cccccc}%s \t %d \t ", GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str);
			}

			// Шкатулка не может быть нелегальным
			if (thingPack == 5) ListBackPackUnlegal[i][playerid] = 0;
		}
	}
	else
	{
		for(new i = 0; i < 40; i++)
		{
			nenorm = 0;

			new thingId = List[i][playerid], thingType = ListType[i][playerid], thingQuan = ListQuan[i][playerid], thingPack = ListPack[i][playerid];

			if(thingId > 0)
			{
				if(UnlegalThing(thingId, thingType, thingPack)
					|| UnlegalSkin(FriskPlayerMember[playerid], ListPara[i][playerid], thingType)) 
				{
					format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Нелегальный",GetNameThing(1, thingId, thingType, thingPack), thingQuan);
					strcat(sctring,str);
					nenorm = 1;
					ListUnlegal[i][playerid] = 1;
				}
				else
				{
					if(ListQara[i][playerid] > 0 && !IsABackPack(thingId)) format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Украденный",GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str), nenorm = 1, ListUnlegal[i][playerid] = 2;
					if(ListQara[i][playerid] > 0 && IsABackPack(thingId)) format(str, sizeof(str), "\n{cccccc}%s \t \t {cccccc}[ ID: %d ]",GetNameThing(1, thingId, thingType, thingPack), ListQara[i][playerid]), strcat(sctring,str), nenorm = 1;
					else
					{
						if(DocumentThing(thingId, thingType)) // Документы и лицы
						{
							if(thingId != 160) ListUnlegal[i][playerid] = 1;
							if(ListPara[i][playerid] != datadid) format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Чужой документ",GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str), nenorm = 1;
						}
						else if(thingType == 1) // Оружие, где бы оно не было
						{
							ListUnlegal[i][playerid] = 2;
							if(DP[2][playerid] == 0 || DP[1][playerid] == 1 || DP[1][playerid] == 2 || DP[1][playerid] == 4)
							{
								if(weapon_class(thingId) == 3 || weapon_class(thingId) == 2 && herelic[1] == 0 || weapon_class(thingId) == 1 && herelic[0] == 0 && herelic[1] == 0) format(str, sizeof(str), "\n{cccccc}%s \t %d \t {FF6347}Нелегальный",GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str), nenorm = 1;
							}
						}
					}
				}
				if(nenorm == 0) format(str, sizeof(str), "\n{cccccc}%s \t %d \t ", GetNameThing(1, thingId, thingType, thingPack), thingQuan), strcat(sctring,str);
			}

			// Шкатулка не может быть нелегальным
			if (thingPack == 5) ListUnlegal[i][playerid] = 0;
		}
	}
	ShowDialog(playerid,1218,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Обыск",sctring,"Выбор","Отмена");
	return 1;
}
function Call_frisk(playerid, const tmp[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new quan, stat = DP[1][playerid], f_str[24];

		new maxSlot = MAX_INVEN;
		if(stat == 2) maxSlot = MAX_MARK;
		else if(stat == 3) maxSlot = MAX_WEAPON_SLOTS;

		for(new reset = 0; reset < 40; reset++) List[reset][playerid] = 0, ListQuan[reset][playerid] = 0, ListInva[reset][playerid] = 0, ListPara[reset][playerid] = 0, ListQara[reset][playerid] = 0, ListType[reset][playerid] = 0, ListPack[reset][playerid] = 0, ListUnlegal[reset][playerid] = 0;
	    if(stat == 1 || stat == 2) // Инвентарь, Товары
		{
		    for(new i = 0; i < maxSlot; i++)
			{
				new bool:is_null, string_slot[20];
				format(string_slot, sizeof(string_slot), "%s_slot_%d", ((stat == 2) ? "m" : "i"), i);
				cache_is_value_name_null(0, string_slot, is_null);

				if(is_null == false)
				{
					new string_json[512];
					cache_get_value_name(0, string_slot, string_json, 512);

					new JsonNode:node = JSON_INVALID_NODE;
					if (JSON_Parse(string_json, node) == JSON_CALL_NO_ERR)
					{
						JSON_GetInt(node, "id", List[quan][playerid]);
						JSON_GetInt(node, "quan", ListQuan[quan][playerid]);
						JSON_GetInt(node, "para", ListPara[quan][playerid]);
						JSON_GetInt(node, "qara", ListQara[quan][playerid]);
						JSON_GetInt(node, "type", ListType[quan][playerid]);
						JSON_GetInt(node, "pack", ListPack[quan][playerid]);

						ListInva[quan][playerid] = i;
						quan ++;
					}
				}
	  		}
		}
		else if(stat == 3)
		{
			for(new i = 0; i < maxSlot; i++)
			{
				new bool:is_null, string_slot[20];
				format(string_slot, sizeof(string_slot), "gun_%d", i);
				cache_is_value_name_null(0, string_slot, is_null);

				if(is_null == false)
				{
					new string_json[512];
					cache_get_value_name(0, string_slot, string_json, 512);

					new JsonNode:node = JSON_INVALID_NODE;
					if (JSON_Parse(string_json, node) == JSON_CALL_NO_ERR)
					{
						JSON_GetInt(node, "weap", List[quan][playerid]);
						JSON_GetInt(node, "ammo", ListQuan[quan][playerid]);
						JSON_GetInt(node, "qet", ListQara[quan][playerid]);

						ListInva[quan][playerid] = i;
						ListType[quan][playerid] = 1;
						ListPack[quan][playerid] = 0;
						quan ++;
					}
				}
	  		}
		}
	    else if(stat == 4)
		{
	        for(new i = 0; i < 5; i++)
			{
			    format(f_str,sizeof(f_str),"Odet%d", i+1), cache_get_value_name_int(0, f_str, List[quan][playerid]);
			    format(f_str,sizeof(f_str),"OdetPara%d", i+1), cache_get_value_name_int(0, f_str, ListPara[quan][playerid]);
			    format(f_str,sizeof(f_str),"OdetQara%d", i+1), cache_get_value_name_int(0, f_str, ListQara[quan][playerid]);
			    ListType[quan][playerid] = 2;
				ListPack[quan][playerid] = 0;
	            if(List[quan][playerid] > 0) ListQuan[quan][playerid] = 1, ListInva[quan][playerid] = i+1, quan ++;
			}
		}

		// Записали ID организации
		cache_get_value_name_int(0, "Member", FriskPlayerMember[playerid]);

	    showfrisk3(playerid);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
function Call_findfrisk(playerid, const tmp[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    DP[2][playerid] = 1; // Признак Offline просмотра
	    cache_get_value_name_int(0, "user_id", DP[0][playerid]);
	    format(ListName[playerid],21,"%s", tmp);
	    new model, model3;
	    cache_get_value_name_int(0, "Model", model);
	    cache_get_value_name_int(0, "Model3", model3);
	    PlayerPlaySound(playerid,40405,0,0,0);
		PlayerPlaySound(playerid,5600,0,0,0);
       	new str[100],sctring[460];
       	format(str,sizeof(str),"{FF6347}%s \t ", tmp), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Инвентарь {ff9000}>> \t "), strcat(sctring,str);
    	format(str,sizeof(str),"\n{cccccc}Товары {ff9000}>> \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Оружие в руках {ff9000}>> \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Надетые аксессуары {ff9000}>> \t "), strcat(sctring,str);
       	if(model == 154 || model == 18 || model == 140 || model == 139) format(str,sizeof(str),"\n{444444}Голый"), strcat(sctring,str);
       	else
		{
		    if(model3 > 0) format(str,sizeof(str),"\n{ff9000}Одежда ID %d \t {FF6347}Украденный предмет", model), strcat(sctring,str);
			else format(str,sizeof(str),"\n{ff9000}Одежда ID %d \t ", model), strcat(sctring,str);
		}
    	ShowDialog(playerid,1217,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Обыск",sctring,"Выбрать","Отмена");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
}
CMD:frisk(playerid, const params[]) // Команда: Закон | Команда: Админ
{
	new g = fraction(playerid);
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(!IsAFunctionOrganization(25, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не работаете в правоохранительных органах");
		if(!GetAccessRankOrg(playerid, g, 25, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(get_reason_stop(playerid, 0) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1; // Мероприятие
	if(get_reason_stop(playerid, 1) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1; // Плохо или спит
	if(get_reason_stop(playerid, 2) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1; // Тюрьма или больница
	new tmp[64];
	if(sscanf(params, "s[64]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обыскать игрока [ /frisk ID ]");
	new giveplayerid;
	if(PlayerInfo[playerid][pSoska] >= 1) giveplayerid = ReturnUser(tmp, 1);
	else giveplayerid = ReturnUser(tmp);
	if(giveplayerid == playerid && PlayerInfo[playerid][pSoska] <= 0 && server != 0) return get_reason_stop(playerid, 3);
	if(IsOnline(giveplayerid))
	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети [ Не залогинился ]");
		if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
		if(GetPVarInt(giveplayerid,"afksystem") >= 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
		if(CheckPlayerNpc(playerid, giveplayerid)) return 1;
		if(!howstun(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Прежде чем обыскать, игрока необходимо обезвредить {cccccc}[ Наручники, оглушить или связать ]");
		if(IsPlayerInAnyVehicle(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0)
		{
			new vehicleid = GetPlayerVehicleID(giveplayerid);
			if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
			if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Этот игрок за рулём");
		}
		if(ProxDetectorS(5.0, playerid, giveplayerid) && playerid != giveplayerid && GetPlayerState(playerid) != PLAYER_STATE_SPECTATING && (OnlineInfo[playerid][oDialogID] < 1217 || OnlineInfo[playerid][oDialogID] > 1219) )
		{
			new string[80];
			if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
			format(string, sizeof(string), "обыскивает %s",playername(giveplayerid));
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
			format(string, sizeof(string), "* %s обыскивает %s", playername(playerid), playername(giveplayerid));
			ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		}
		
		format(ListName[playerid],21,"%s", PlayerInfo[giveplayerid][pName]);
		DP[0][playerid] = giveplayerid;
		DP[2][playerid] = 0;
		PlayerPlaySound(playerid,40405,0,0,0);
		PlayerPlaySound(playerid,5600,0,0,0);

		new Aks = HasABustAks(giveplayerid,1);

		new str[100],sctring[460];
		format(str,sizeof(str),"{FF6347}%s \t ", playername(giveplayerid)), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Инвентарь {ff9000}>> \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Товары {ff9000}>> \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Оружие в руках {ff9000}>> \t "), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Надетые аксессуары {ff9000}>> \t "), strcat(sctring,str);
		if(isnaked(giveplayerid)) format(str,sizeof(str),"\n{444444}Голый"), strcat(sctring,str);
		else
		{
			if(PlayerInfo[giveplayerid][pModel3] > 0) format(str,sizeof(str),"\n{ff9000}Одежда ID %d \t {FF6347}Украденный предмет", PlayerInfo[giveplayerid][pModel]), strcat(sctring,str);
			else if(UnlegalSkin(PlayerInfo[giveplayerid][pMember], PlayerInfo[giveplayerid][pModel2], 3))
			{
				format(str,sizeof(str),"\n{ff9000}Одежда ID %d \t {FF6347}Нелегальный", PlayerInfo[giveplayerid][pModel]), strcat(sctring,str);
			}
			else format(str,sizeof(str),"\n{ff9000}Одежда ID %d \t ", PlayerInfo[giveplayerid][pModel]), strcat(sctring,str);
		}
		if(Aks != -1) format(str,sizeof(str),"\n{cccccc}Надетый рюкзак >> \t [ ID: %d ]", PlayerInfo[giveplayerid][pOdetQara][Aks]), strcat(sctring,str);
		ShowDialog(playerid,1217,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Обыск",sctring,"Выбрать","Отмена");
	}
	else // Offline обыск
	{
		if(PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети {cccccc}[ Offline обыск доступен только администрации ]");
		if(!CheckRP_Nickname(tmp)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети {cccccc}[ Укажите никнейм Nick_Name ]");
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Обыск","{cccccc}Поиск игрока...","*","");
		
		new string_mysql[200];
		mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id, Model, Model3 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string_mysql, "Call_findfrisk", "ds", playerid, tmp);
	}
 	return 1;
}
function Call_takeskin(playerid, const tmp[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    DP[2][playerid] = 1; // Признак Offline просмотра
	    cache_get_value_name_int(0, "user_id", DP[0][playerid]);
	    format(ListName[playerid],21,"%s", tmp);
	    new skinid, model2, model3, sex, newskin;
	    cache_get_value_name_int(0, "Model", skinid);
    	if(skinid == 154 || skinid == 18 || skinid == 140 || skinid == 139) return ErrorMessage(playerid, "{FF6347}Игрок без одежды");
    	cache_get_value_name_int(0, "Sex", sex);
	    cache_get_value_name_int(0, "Model2", model2);
	    cache_get_value_name_int(0, "Model3", model3);
	    
	    new put_inva = GiveThingPlayer(playerid, skinid, 1, model2, model3, 3, 0, 9999); // Выдаём предмет игроку
    	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет
	    PlayerPlaySound(playerid,5600,0,0,0);

		if(sex == 1) newskin = 154;
    	else newskin = 140;
    	new string[160];
		mysql_format(pearsq, string, sizeof(string),"UPDATE `pp_igroki` SET `Model`='%d',`Model2`='0',`Model3`='0' WHERE `user_id`='%d'", newskin, DP[0][playerid]);
		query_empty(pearsq, string);
		format(string, sizeof(string), "**** Вы конфисковали одежду у %s [ Предмет в вашем инвентаре ]", tmp);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
    	AdminLog("takeskin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], DP[0][playerid], tmp, "", skinid, "Отнял одежду");
    	format(string, sizeof(string), "У вас изъята одежда, в которую вы были одеты [ ID %d ]", skinid);
	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], DP[0][playerid], tmp, string);

	    format(string, sizeof(string), "%s", ListName[playerid]);
		pc_cmd_frisk(playerid, string);
    	return 2;
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:takeskin(playerid, const params[])
{
    if(IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1 || PlayerInfo[playerid][pSoska] >= 1)
	{
	    if(get_reason_stop(playerid, 0) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	    if(get_reason_stop(playerid, 1) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	    if(get_reason_stop(playerid, 2) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	    new tmp[64];
	    if(sscanf(params, "s[64]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изъять одежду [ /takeskin ID ]");
	    new giveplayerid = ReturnUser(tmp, 1);
	    if(giveplayerid == playerid && server != 0) return get_reason_stop(playerid, 3);
	    if(giveplayerid == playerid && server != 0) return get_reason_stop(playerid, 3);
	    if(IsOnline(giveplayerid))
	    {
		    if(OnlineInfo[giveplayerid][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети [ Не залогинился ]");
			if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
			if(GetPVarInt(giveplayerid,"afksystem") >= 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
			if(CheckPlayerNpc(playerid, giveplayerid)) return 1;
			if(!howstun(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Прежде чем отнять предметы, игрока необходимо обезвредить {cccccc}[ Наручники, оглушить или связать ]");
			if(IsPlayerInAnyVehicle(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0)
			{
			    new vehicleid = GetPlayerVehicleID(giveplayerid);
			    if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
			    if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Этот игрок за рулём");
			}
			if(isnaked(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Игрок без одежды");
			if(PlayerInfo[giveplayerid][pModel3] > 0 
				|| UnlegalSkin(PlayerInfo[giveplayerid][pMember], PlayerInfo[giveplayerid][pModel2], 3)
				|| PlayerInfo[playerid][pSoska] >= 10)
			{
				new put_inva = GiveThingPlayer(playerid, PlayerInfo[giveplayerid][pModel], 1, PlayerInfo[giveplayerid][pModel2], PlayerInfo[giveplayerid][pModel3], 3, 0, 9999); // Выдаём предмет игроку
				if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет

				if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
				PlayerPlaySound(playerid,5600,0,0,0);
				new skinid = PlayerInfo[giveplayerid][pModel];
				
				new string[160];
				player_undress(giveplayerid);
				format(string, sizeof(string), "**** Вы конфисковали одежду у %s [ Предмет в вашем инвентаре ]", playername(giveplayerid));
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
				if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "**** %s конфисковал вашу одежду", PlayerInfo[playerid][pName]);
				else format(string, sizeof(string), "**** %s конфисковала вашу одежду", PlayerInfo[playerid][pName]);
				SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
				if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("takeskin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], skinid, "Отнял одежду");
				else OrgLog(fraction(playerid), "takeskin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], skinid, "Отнял одежду");
				return 2;
			}
			else ErrorMessage(playerid, "{FF6347}Это не украденный предмет\nВы можете изъять только украденные или нелегальные предметы");
  		}
  		else
  		{
  		    if(PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети {cccccc}[ Offline изъятие доступно только администрации ]");
  		    if(!CheckRP_Nickname(tmp)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети {cccccc}[ Укажите никнейм Nick_Name ]");

			new string_mysql[200];
  		    mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id, Model, Sex, Model2, Model3 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	  		mysql_tquery(pearsq, string_mysql, "Call_takeskin", "ds", playerid, tmp);
  		}
	}
   	else ErrorMessage(playerid, "{FF6347}Вы не работаете в правоохранительных органах");
	return 1;
}
CMD:take(playerid, const params[])
{
	new g = fraction(playerid);
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(!IsAFunctionOrganization(25, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не работаете в правоохранительных органах");
		if(!GetAccessRankOrg(playerid, g, 25, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(get_reason_stop(playerid, 0) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 1) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 2) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;

	new tmp[64];
	if(sscanf(params, "s[64]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изъять у преступника предметы [ /take ID ]");
	new giveplayerid;
	if(PlayerInfo[playerid][pSoska] >= 1) giveplayerid = ReturnUser(tmp, 1);
	else giveplayerid = ReturnUser(tmp);
	if(giveplayerid == playerid && server != 0) return get_reason_stop(playerid, 3);
	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	if(GetPVarInt(giveplayerid,"afksystem") >= 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
	if(!howstun(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Прежде чем отнять предметы, игрока необходимо обезвредить {cccccc}[ Наручники, оглушить или связать ]");
	if(IsPlayerInAnyVehicle(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0)
	{
		new vehicleid = GetPlayerVehicleID(giveplayerid);
		if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
		if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Этот игрок за рулём");
	}
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[giveplayerid][pSoska] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя отнять предметы у администратора");
	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0 && OnlineInfo[playerid][oDialogID] != 48) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
	PlayerPlaySound(playerid,5600,0,0,0);
	DP[0][playerid] = giveplayerid;
	new str[100],sctring[800], quan, mylic[6], alienlic[7], stolenlic[6];
	
	// Лицензии на своё имя
	mylic[0] = get_lic(giveplayerid, 156);
	mylic[1] = get_lic(giveplayerid, 157);
	mylic[2] = get_lic(giveplayerid, 158);
	mylic[3] = get_lic(giveplayerid, 159);
	mylic[4] = get_lic(giveplayerid, 161);
	mylic[5] = get_lic(giveplayerid, 162);
	
	// Лицензии на чужое имя
	get_alienlic(giveplayerid, alienlic[0], alienlic[1], alienlic[2], alienlic[3], alienlic[4], alienlic[5], alienlic[6]);
	
	// Лицензии украденные
	get_stolenlic(giveplayerid, stolenlic[0], stolenlic[1], stolenlic[2], stolenlic[3], stolenlic[4], stolenlic[5]);


	format(str,sizeof(str),"{FF6347}%s \t ", playername(giveplayerid)), strcat(sctring,str);
	if(alienlic[0] > 0) format(str,sizeof(str),"\n{cccccc}Водительские права (%d шт.) \t {FF6347}Чужие документы", alienlic[0]), strcat(sctring,str), List[quan][playerid] = 156, quan ++;
	else if(stolenlic[0] > 0) format(str,sizeof(str),"\n{cccccc}Водительские права (%d шт.) \t {FF6347}Украденные документы", stolenlic[0]), strcat(sctring,str), List[quan][playerid] = 156, quan ++;
	else if(mylic[0] > 0)
	{
		if(mylic[0] == 1) format(str,sizeof(str),"\n{cccccc}Водительские права \t {99ff66}Легальные документы"), strcat(sctring,str);
		else if(mylic[0] >= 2) format(str,sizeof(str),"\n{cccccc}Водительские права (%d шт.) \t {FF6347}Копии личных документов", mylic[0]), strcat(sctring,str);
		List[quan][playerid] = 156, quan ++;
	}
	
	if(alienlic[1] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия пилота (%d шт.) \t {FF6347}Чужие документы", alienlic[1]), strcat(sctring,str), List[quan][playerid] = 157, quan ++;
	else if(stolenlic[1] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия пилота (%d шт.) \t {FF6347}Украденные документы", stolenlic[1]), strcat(sctring,str), List[quan][playerid] = 157, quan ++;
	else if(mylic[1] > 0)
	{
		if(mylic[1] == 1) format(str,sizeof(str),"\n{cccccc}Лицензия пилота \t {99ff66}Легальные документы"), strcat(sctring,str);
		else if(mylic[1] >= 2) format(str,sizeof(str),"\n{cccccc}Лицензия пилота (%d шт.) \t {FF6347}Копии личных документов", mylic[1]), strcat(sctring,str);
		List[quan][playerid] = 157, quan ++;
	}
	
	if(alienlic[2] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия водного транспорта (%d шт.) \t {FF6347}Чужие документы", alienlic[2]), strcat(sctring,str), List[quan][playerid] = 158, quan ++;
	else if(stolenlic[2] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия водного транспорта (%d шт.) \t {FF6347}Украденные документы", stolenlic[2]), strcat(sctring,str), List[quan][playerid] = 158, quan ++;
	else if(mylic[2] > 0)
	{
		if(mylic[2] == 1) format(str,sizeof(str),"\n{cccccc}Лицензия водного транспорта \t {99ff66}Легальные документы"), strcat(sctring,str);
		else if(mylic[2] >= 2) format(str,sizeof(str),"\n{cccccc}Лицензия водного транспорта (%d шт.) \t {FF6347}Копии личных документов", mylic[2]), strcat(sctring,str);
		List[quan][playerid] = 158, quan ++;
	}
	
	if(alienlic[3] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия мототранспорта (%d шт.) \t {FF6347}Чужие документы", alienlic[3]), strcat(sctring,str), List[quan][playerid] = 159, quan ++;
	else if(stolenlic[3] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия мототранспорта (%d шт.) \t {FF6347}Украденные документы", stolenlic[3]), strcat(sctring,str), List[quan][playerid] = 159, quan ++;
	else if(mylic[3] > 0)
	{
		if(mylic[3] == 1) format(str,sizeof(str),"\n{cccccc}Лицензия мототранспорта \t {99ff66}Легальные документы"), strcat(sctring,str);
		else if(mylic[3] >= 2) format(str,sizeof(str),"\n{cccccc}Лицензия мототранспорта (%d шт.) \t {FF6347}Копии личных документов", mylic[3]), strcat(sctring,str);
		List[quan][playerid] = 159, quan ++;
	}
	
	new licw1;
	if(alienlic[4] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [1] (%d шт.) \t {FF6347}Чужие документы", alienlic[4]), strcat(sctring,str), List[quan][playerid] = 161, quan ++;
	else if(stolenlic[4] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [1] (%d шт.) \t {FF6347}Украденные документы", stolenlic[4]), strcat(sctring,str), List[quan][playerid] = 161, quan ++;
	else if(mylic[4] > 0)
	{
		if(mylic[4] == 1) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [1] \t {99ff66}Легальные документы"), strcat(sctring,str);
		else if(mylic[4] >= 2) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [1] (%d шт.) \t {FF6347}Копии личных документов", mylic[4]), strcat(sctring,str);
		List[quan][playerid] = 161, quan ++;
	}
	
	new licw2;
	if(alienlic[5] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [2] (%d шт.) \t {FF6347}Чужие документы", alienlic[5]), strcat(sctring,str), List[quan][playerid] = 162, quan ++;
	else if(stolenlic[5] > 0) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [2] (%d шт.) \t {FF6347}Украденные документы", stolenlic[5]), strcat(sctring,str), List[quan][playerid] = 162, quan ++;
	else if(mylic[5] > 0)
	{
		if(mylic[5] == 1) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [2] \t {99ff66}Легальные документы"), strcat(sctring,str);
		else if(mylic[5] >= 2) format(str,sizeof(str),"\n{cccccc}Лицензия на оружие [2] (%d шт.) \t {FF6347}Копии личных документов", mylic[5]), strcat(sctring,str);
		List[quan][playerid] = 162, quan ++;
	}
	
	if(mylic[4] > 0) licw1 = 1;
	if(mylic[5] > 0) licw2 = 1;
	
	new weapons[13][2], mojno_take1, yesgun;
	for(new i = 0; i < MAX_WEAPON_SLOTS; i++)
	{
		if(PlayerInfo[giveplayerid][pBeret] == 0) // В руках
		{
			weapons[i][0] = ProtectInfo[giveplayerid][prWeapon][i];
			weapons[i][1] = ProtectInfo[giveplayerid][prAmmo][i];
		}
		else
		{
			weapons[i][0] = TempWeapon[giveplayerid][i];
			weapons[i][1] = TempAmmo[giveplayerid][i];
		}
		if(weapons[i][0] > 0 && weapons[i][1] > 0)
		{
			yesgun = 1;
			if(weapon_class(weapons[i][0]) == 1)
			{
				if(licw1 == 0 && licw2 == 0) mojno_take1 = 1;
			}
			if(weapon_class(weapons[i][0]) == 2)
			{
				if(licw2 == 0) mojno_take1 = 1;
			}
			if(weapon_class(weapons[i][0]) == 3) mojno_take1 = 1;
			if(PlayerInfo[giveplayerid][pBeret] == 0)
			{
				if(ProtectInfo[giveplayerid][prQet][i] > 0) mojno_take1 = 2;
			}
			else
			{
				if(TempQet[giveplayerid][i] > 0) mojno_take1 = 2;
			}
		}
	}
	
	if(yesgun == 1)
	{
		List[quan][playerid] = 1, quan ++;
		if(mojno_take1 == 1) format(str,sizeof(str),"\n{cccccc}Оружие в руках \t {FF6347}Имеется нелегальное"), strcat(sctring,str);
		else if(mojno_take1 == 2) format(str,sizeof(str),"\n{cccccc}Оружие в руках \t {FF6347}Имеется украденное"), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Оружие в руках \t {99ff66}Легальное"), strcat(sctring,str);
	}

	new kolv[3];
	kolv[0] = get_drugs(giveplayerid, 4);
	kolv[1] = get_drugs(giveplayerid, 6);
	kolv[2] = get_drugs(giveplayerid, 7);
	if(kolv[0] > 0 || kolv[1] > 0 || kolv[2] > 0)
	{
		List[quan][playerid] = 2;//, quan ++;
		format(str,sizeof(str),"\n{cccccc}Вещества \t {FF6347}Имеются нелегальные"), strcat(sctring,str);
	}
	ShowDialog(playerid,48,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Отнять Предмет",sctring,"Выбор","Отмена");
	return 1;
}

alias:takeguns("takegun", "tgun", "tguns")
CMD:takeguns(playerid, const params[])
{
    new g = fraction(playerid);
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(!IsAFunctionOrganization(25, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не работаете в правоохранительных органах");
		if(!GetAccessRankOrg(playerid, g, 25, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(get_reason_stop(playerid, 0) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 1) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 2) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	new tmp[64];
	if(sscanf(params, "s[64]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изъять оружие у преступника [ /takeguns ID ]");
	new giveplayerid;
	if(PlayerInfo[playerid][pSoska] >= 1) giveplayerid = ReturnUser(tmp, 1);
	else giveplayerid = ReturnUser(tmp);
	if(giveplayerid == playerid && server != 0) return get_reason_stop(playerid, 3);
	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	if(GetPVarInt(giveplayerid,"afksystem") >= 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
	if(!howstun(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Прежде чем отнять предметы, игрока необходимо обезвредить {cccccc}[ Наручники, оглушить или связать ]");
	if(IsPlayerInAnyVehicle(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0)
	{
		new vehicleid = GetPlayerVehicleID(giveplayerid);
		if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
		if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Этот игрок за рулём");
	}
	new string[154], tquan, tgun;
	if(PlayerInfo[giveplayerid][pBeret] == 0) // В руках
	{
		for(new i = 0; i < MAX_WEAPON_SLOTS; i++)
		{
			if(ProtectInfo[giveplayerid][prWeapon][i] > 0 && ProtectInfo[giveplayerid][prAmmo][i] > 0)
			{
				tgun ++;
				if(ProtectInfo[giveplayerid][prQet][i] > 0)// Краденное оружие
				{
					GiveThingPlayer(playerid, ProtectInfo[giveplayerid][prWeapon][i], 1, ProtectInfo[giveplayerid][prDet][i], ProtectInfo[giveplayerid][prQet][i], 1, 0, 9999);
					tquan ++;
				}
			}
		}
	}
	else
	{
		for(new i = 0; i < MAX_WEAPON_SLOTS; i++)
		{
			if(TempWeapon[giveplayerid][i] > 0 && TempAmmo[giveplayerid][i] > 0)
			{
				tgun ++;
				if(TempQet[giveplayerid][i] > 0)// Краденное оружие
				{
					GiveThingPlayer(playerid, TempWeapon[giveplayerid][i], 1, TempDet[giveplayerid][i], TempQet[giveplayerid][i], 1, 0, 9999);
					tquan ++;
				}
			}
		}
	}
	
	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
	PlayerPlaySound(playerid,5600,0,0,0), PlayerPlaySound(giveplayerid,5600,0,0,0);
	if(tquan > 0) format(string, sizeof(string), "**** Вы конфисковали оружие у %s {FF6347}[ Имеются украденные (%d шт), загляните в инвентарь ]", playername(giveplayerid), tquan);
	else format(string, sizeof(string), "**** Вы конфисковали оружие у %s [ Предметы уничтожены ]", playername(giveplayerid));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	
	if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "**** %s конфисковал Ваше Оружие", PlayerInfo[playerid][pName]);
	else format(string, sizeof(string), "**** %s конфисковала Ваше Оружие", PlayerInfo[playerid][pName]);
	SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
	Protect_DestroyGuns(giveplayerid);
	if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("takeguns", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "Отнял оружие");
	else OrgLog(fraction(playerid), "takeguns", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "Отнял оружие");
	return 1;
}

alias:takedrugs("tdrugs", "tdrug", "takedrug")
CMD:takedrugs(playerid, const params[])
{
	new g = fraction(playerid);
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(!IsAFunctionOrganization(25, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не работаете в правоохранительных органах");
		if(!GetAccessRankOrg(playerid, g, 25, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(get_reason_stop(playerid, 0) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 1) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 2) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	new tmp[64];
	if(sscanf(params, "s[64]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изъять вещества у преступника [ /takedrugs ID ]");
	new giveplayerid;
	if(PlayerInfo[playerid][pSoska] >= 1) giveplayerid = ReturnUser(tmp, 1);
	else giveplayerid = ReturnUser(tmp);
	if(giveplayerid == playerid && server != 0) return get_reason_stop(playerid, 3);
	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	if(GetPVarInt(giveplayerid,"afksystem") >= 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
	if(!howstun(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Прежде чем отнять предметы, игрока необходимо обезвредить {cccccc}[ Наручники, оглушить или связать ]");
	if(IsPlayerInAnyVehicle(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0)
	{
		new vehicleid = GetPlayerVehicleID(giveplayerid);
		if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
		if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Этот игрок за рулём");
	}
	new kolv[3];
	kolv[0] = get_drugs(giveplayerid, 4);
	kolv[1] = get_drugs(giveplayerid, 6);
	kolv[2] = get_drugs(giveplayerid, 7);

	if(kolv[0] == 0 && kolv[1] == 0 && kolv[2] == 0) return ErrorMessage(playerid, "{FF6347}У него не обнаружено запрещённых веществ [ Проверьте упаковки, подарки и пакеты: Обыскать ]");
	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
	PlayerPlaySound(playerid,5600,0,0,0), PlayerPlaySound(giveplayerid,5600,0,0,0);
	new string[154];
	if(kolv[0] >= 1) DelInvent3(giveplayerid,4);
	if(kolv[1] >= 1) DelInvent3(giveplayerid,6);
	if(kolv[2] >= 1) DelInvent3(giveplayerid,7);
	
	if(PlayerInfo[playerid][pFbi] >= 1 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pLeader] == 2)
	{
		format(string, sizeof(string), "**** Вы конфисковали вещества у %s [ Отправлено на склад FBI ]", playername(giveplayerid));
		if(kolv[0] >= 1) putsklad(2, 4, kolv[0], 0, 0,1);
		if(kolv[1] >= 1) putsklad(2, 6, kolv[1], 0, 0,1);
		if(kolv[2] >= 1) putsklad(2, 7, kolv[2], 0, 0,1);
	}
	else format(string, sizeof(string), "**** Вы конфисковали вещества у %s [ Предметы уничтожены ]", playername(giveplayerid));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "**** %s конфисковал все вещества", PlayerInfo[playerid][pName]);
	else format(string, sizeof(string), "**** %s конфисковала все вещества", PlayerInfo[playerid][pName]);
	SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
	if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("takedrugs", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "Отнял вещества");
	else OrgLog(fraction(playerid), "takedrugs", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "Отнял вещества");
	return 1;
}
stock take_lic(playerid, const tmp[], stat)
{
    new g = fraction(playerid);
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(!IsAFunctionOrganization(25, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не работаете в правоохранительных органах");
		if(!GetAccessRankOrg(playerid, g, 25, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(get_reason_stop(playerid, 0) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 1) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	if(get_reason_stop(playerid, 2) == 0 && PlayerInfo[playerid][pSoska] <= 0) return 1;
	new giveplayerid;
	if(PlayerInfo[playerid][pSoska] >= 1) giveplayerid = ReturnUser(tmp, 1);
	else giveplayerid = ReturnUser(tmp);
	if(giveplayerid == playerid && server != 0) return get_reason_stop(playerid, 3);
	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(PlayerInfo[playerid][pFbi] >= 1)
	{
		if(PlayerInfo[playerid][pFbi] < 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}У вас недостаточный ранг [ Изымать лицензии можно с 5 ранга ]");
	}
	else
	{
		if(PlayerInfo[playerid][pRank] < 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}У вас недостаточный ранг [ Изымать лицензии можно с 5 ранга ]");
	}
	if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 0 || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко {cccccc}[ Не дальше 3-ёх метров ]");
	if(GetPVarInt(giveplayerid,"afksystem") >= 5 && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
	if(!howstun(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Прежде чем отнять предметы, игрока необходимо обезвредить {cccccc}[ Наручники, оглушить или связать ]");
	if(IsPlayerInAnyVehicle(giveplayerid) && PlayerInfo[playerid][pSoska] <= 0)
	{
		new vehicleid = GetPlayerVehicleID(giveplayerid);
		if(!IsPlayerInVehicle(playerid, vehicleid)) return ErrorMessage(playerid, "{FF6347}Вы не с игроком в транспорте {cccccc}[ Если игрок или вы в транспорте, вам нужно находиться вместе с ним ]");
		if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Этот игрок за рулём");
	}

	if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false), TurnPlayerFaceToPlayer(playerid, giveplayerid);
	PlayerPlaySound(playerid,5600,0,0,0), PlayerPlaySound(giveplayerid,5600,0,0,0);
	new string[244];
	if(stat == 1) DelInvent3(giveplayerid, 156);
	else if(stat == 2) DelInvent3(giveplayerid,157);
	else if(stat == 3) DelInvent3(giveplayerid,158);
	else if(stat == 4) DelInvent3(giveplayerid,159);
	else if(stat == 5) DelInvent3(giveplayerid,161);
	else if(stat == 6) DelInvent3(giveplayerid,162);
	
	format(string, sizeof(string), "**** Вы конфисковали %s у %s [ Предмет уничтожен ]", ocName[stat], playername(giveplayerid));
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "**** %s конфисковал %s", PlayerInfo[playerid][pName], ocName[stat]);
	else format(string, sizeof(string), "**** %s конфисковала %s", PlayerInfo[playerid][pName], ocName[stat]);
	SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "{33CCFF}*** %s отнял(а) у вас: %s ***\n\n{ff9000}Если вы не согласны с решением, {ff0000}Сделайте скриншот [ F8 ] и напишите жалобу на форум.\n{cccccc}pears.fun >> Форум >> Жалобы", PlayerInfo[playerid][pName], ocName[stat]);
	ShowDialog(giveplayerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Лишение Лицензии",string,"Oк","");
	if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("takelic", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, ocName[stat]);
	else OrgLog(fraction(playerid), "takelic", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, ocName[stat]);
	return 1;
}

