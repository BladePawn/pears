stock OnPlayerLoadCheckLoad(playerid)
{
	if(frog_use_query_in_connect[playerid] == true)
	{
		TextDrawShowForPlayer(playerid, Chernifon);
		ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Ошибка! Произошел запуск повторной загрузки аккаунта\n{cccccc}Чтобы выйти из игры введите в чат команду {FF6347}/q или ESC >> Выход\n","Ок","");
		Kickx(playerid);
		return true;
	}
	frog_use_query_in_connect[playerid] = true;
	return false;
}

forward OnLoadBanip(playerid, const str_ip[], race_check);
public OnLoadBanip(playerid, const str_ip[], race_check)
{
	new rows, f_str[128],datad1[24],datad2[24],datad3,datad4[64],datad5[24];
	cache_get_row_count(rows);
	if(rows) // Если этот IP в бане
	{
	    if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);
		cache_get_value_name(0, "admname", datad1, 24);
		cache_get_value_name(0, "date", datad2, 24);
		cache_get_value_name(0, "reason", datad4, 64);
		cache_get_value_name(0, "ipname", datad5, 24);
		cache_get_value_name_int(0, "razban", datad3);
		new unixtime = gettime();
		if(unixtime >= datad3)
		{
			// Время бана истекло
			mysql_format(pearsq, f_str, sizeof(f_str),"DELETE FROM `pp_banip` WHERE `ip` = '%e'", str_ip);
			query_empty(pearsq, f_str);
		    printf("OnPlayerConnect(%s) [ Начинаем Грузить Аккаунт ]", PlayerInfo[playerid][pName]);

			// Защита от повторной загрузки аккаунта
		    if(OnPlayerLoadCheckLoad(playerid)) return true;

	        frog_time[playerid] = GetTickCount();
		    new string[144];
	        mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", PlayerInfo[playerid][pName]);
	        mysql_tquery(pearsq, string, "OnPlayerLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
		}
		else
		{
			new ostalos = datad3-unixtime;
			new osday = ostalos/86400;
			new vrem = ostalos-osday*86400;
			new oshour = vrem/3600;
			new vrem2 = vrem-oshour*3600;
			new osminute = vrem2/60;
			TextDrawShowForPlayer(playerid, Chernifon);
			new str[100],sctring[640];
			format(str,sizeof(str),"{ff0000}______________________________________________________________________________");
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ffffff}Здравствуйте!");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}К сожалению этот IP {FF8282}Забанен");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}НикНейм во время Бана: {FF8282}%s",datad5);
			strcat(sctring,str);
			if(ostalos >= 86400) format(str,sizeof(str),"\n{ffffff}До окончания бана IP осталось: {FF8282}%d дней, %d часов, %d минут",osday,oshour,osminute), strcat(sctring,str);
			else if(ostalos <= 86399 && ostalos >= 3600) format(str,sizeof(str),"\n{ffffff}До окончания бана IP осталось: {FF8282}%d часов, %d минут",ostalos/3600,osminute), strcat(sctring,str);
			else format(str,sizeof(str),"\n{ffffff}До окончания бана IP осталось: {FF8282}%d минут",ostalos/60), strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Имя Администратора: {FF8282}%s",datad1);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Дата и Время Бана: {FF8282}%s",datad2);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Причина Бана: {cccccc}%s",datad4);
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ffffff}Если вы считаете, что это ошибка. Сделайте скриншот {FF8282}[ F8 ]");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Затем напишите жалобу на администратора на форум {FF8282}forum.pears.fun");
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ff0000}______________________________________________________________________________");
			strcat(sctring,str);
			ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{FFFFFF}**** {FF0000}*IP Забанен* {FFFFFF}****",sctring,"*","");
			Kickx(playerid, .time = 10000);
			return 1;
		}
	}
	else
	{
	    if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);
		printf("OnPlayerConnect(%s) [ Начинаем Грузить Аккаунт ]", PlayerInfo[playerid][pName]);

		// Защита от повторной загрузки аккаунта
		if(OnPlayerLoadCheckLoad(playerid)) return true;

		// Пароль виден по умолчанию при регистрации
		PlayerInfo[playerid][pTypoihyi] = 1;

		frog_time[playerid] = GetTickCount();
		new string[144];
		mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", PlayerInfo[playerid][pName]);
		mysql_tquery(pearsq, string, "OnPlayerLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
	}
	return true;
}
public ClearMarriage(playerid)
{
	format(PlayerInfo[playerid][pMarriedTo], 24, "нет");
	PlayerInfo[playerid][pMarried] = 0;
	return 1;
}
stock GetPlayerCameraLookAt(playerid, &Float:X, &Float:Y, &Float:Z)
{
    new Float:CamX, Float:CamY, Float:CamZ,Float:FrX, Float:FrY, Float:FrZ;
    GetPlayerCameraPos(playerid, CamX, CamY, CamZ);
    GetPlayerCameraFrontVector(playerid, FrX, FrY, FrZ);
    X = FrX + CamX;
    Y = FrY + CamY;
    Z = FrZ + CamZ;
}
public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z)
{
	if(weaponid <= 46)
    {
 		switch(weaponid)
		{
  			case 0..15,40,44..46: return true;
		}
		// Подсчёт выстрелов для капта
		if(gVidga[playerid] == true)
		{
	  		if(IsAZoneCapt(playerid)) PlayerInfo[playerid][pGangTemp][15] ++;
		}
		
		new expl;
		new fam = PlayerInfo[playerid][pFamily];
		// Летающая тарелка
		if(objectid == ufo_object && ufo_stat == 1)
		{
		    if(expl == 0) ufo_health -= 1;
		    else ufo_health -= 30+random(30);
			new string[54];
			format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~b~H‡O: ~w~%d/100",ufo_health), GameTextForPlayer(playerid,string, 2000, 3);
			if(ufo_health <= 0)
			{
			    fall_ufo(-1);
				update_ability(playerid, 1, 100);
				if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нихрена себе! Кажется, я сбил {0088ff}НЛО");
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ничего себе! Кажется, я сбила {0088ff}НЛО");
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу отследить куда оно упадёт. {ff9000}Вдруг, там будут ценные предметы!");
				PlayerPlaySound(playerid,6401,0,0,0);
				if(PlayerInfo[playerid][pAchieve][72] == 0) AchievePlayer(playerid, 72, 1);
				CompleteBattlePassTask(playerid, 9, 1);
			}
		}
		// Алтарь
		for(new i; i < MAX_FAMILY; i++)
		{
			if(objectid == SektaObject[i] && FamilyInfo[fam][fType] == 3 && fam != i)
			{
				if(expl == 0) SektaObjectHealt[i] -= 1;
				else SektaObjectHealt[i] -= 30+random(30);
				new string[80];
				format(string, sizeof(string), RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~b~Aћ¦ap© %d: ~w~%d/1000"),FamilyInfo[i][fIds],SektaObjectHealt[i]), GameTextForPlayer(playerid,string, 2000, 3);
				if(SektaObjectHealt[i] <= 0)
				{
					SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уничтожил алтарь другой секты. {ff9000}Надо сваливать");
					PlayerPlaySound(playerid,6401,0,0,0);
					SektaKillAltar(i);
				}
				break;
			}
		}

		// Радары
		Radar_OnShoot(playerid, weaponid, objectid);
    }
    return 1;
}
public OnPlayerWeaponShot(playerid, WEAPON:weaponid, BULLET_HIT_TYPE:hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
  //=====================
  //===[ Антикрашеры ]===
  if(!((WEAPON:22 <= weaponid <= WEAPON:34) || weaponid == WEAPON:38)) // Стреляет не стреляющим оружием
  {
  		new string[128];
  		printf("[SProtect Kick]: Crasher Weapon %s",PlayerInfo[playerid][pName]);
	    format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на Crasher Weapon {cccccc}[ KICK ]", PlayerInfo[playerid][pName],playerid);
     	ABroadCast(COLOR_ADM,string,2);
		SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Crasher Weapon]");
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Crasher Weapon]","*","");
  		Kickx(playerid);
  		return 0;
  }
  if(hittype != BULLET_HIT_TYPE_NONE) // Стреляет по неверной координате
  {
	  	if((fX <= -1000.0 || fX >= 1000.0) || (fY <= -1000.0 || fY >= 1000.0) || (fZ <= -1000.0 || fZ >= 1000.0) 
			|| ((hittype != BULLET_HIT_TYPE_PLAYER) && (hittype != BULLET_HIT_TYPE_VEHICLE) && (hittype != BULLET_HIT_TYPE_OBJECT) 
				&& (hittype != BULLET_HIT_TYPE_PLAYER_OBJECT)))
	   	{
	   		new string[128];
	   		printf("[SProtect Kick]: Crasher HitBullet %s",PlayerInfo[playerid][pName]);
		    format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на Crasher HitBullet {cccccc}[ KICK ]", PlayerInfo[playerid][pName],playerid);
	     	ABroadCast(COLOR_ADM,string,2);
			SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Crasher HitBullet]");
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Crasher HitBullet]","*","");
	    	Kickx(playerid);
	     	return 0;
	    }
  }
  new Float:Pos[3];
  GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
  if(floatabs(Pos[0]) > 10000.0 || floatabs(Pos[1]) > 10000.0 || floatabs(Pos[2]) > 10000.0)
  {
		new string[128];
		printf("[SProtect Kick]: Crasher PosBullet %s",PlayerInfo[playerid][pName]);
	    format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на Crasher PosBullet {cccccc}[ KICK ]", PlayerInfo[playerid][pName],playerid);
	 	ABroadCast(COLOR_ADM,string,2);
		SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Crasher PosBullet]");
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Crasher PosBullet]","*","");
		Kickx(playerid);
		return 0;
  }
  //=====================
  //=====================
  
  if(hittype == BULLET_HIT_TYPE_VEHICLE)
  {
		if(hitid != INVALID_VEHICLE_ID)
		{
			if(IsAVehicleNPC(hitid)) 
			{
				new Float:health_veh = MaxVehicleHealth(VehInfo[hitid][vModel], hitid);
				ACSetVehicleHealth(hitid, health_veh);
			}

			// Урон по авто союзников на МП
			if(MPGO[playerid] != 0 && MPGO[GetVehicleDriver(hitid)] != 0 && !GameInfo[gamTeamKill] && Pognalinamp && (MPSpawn[GetVehicleDriver(hitid)] == MPSpawn[playerid]))
			{
				new Float:health_veh = MaxVehicleHealth(VehInfo[hitid][vModel], hitid);
				ACSetVehicleHealth(hitid, health_veh);
			}

			// Наносим дамаг по машине инкассатора
			if(hitid == collectorveh && NPCInfo[3][npcStart] == true && collector_health > 0) CollectorDamage(playerid, NPCInfo[3][npcID]);

		    if(Cars[hitid] != 9999)
		    {
				new Float:health;
				GetVehicleHealth(hitid, health);
				if(health < 400.0)
				{
					ACSetVehicleHealth(hitid,400.0);
					return 0;
				}
			}
		}
  }
  if(weaponid == WEAPON:23 && GetPlayerAmmo(playerid) >= 7000 && MPGO[playerid] == 0)
  {
		if(OnDuty[playerid] <= 0) return 0;
		PlayerPlaySound(playerid, 6003, 0.0, 0.0, 0.0);
		OnDuty[playerid] -= 1;
		PoliceStick[1][playerid] = 2;
		new string[144];
		if(hittype == BULLET_HIT_TYPE_PLAYER)
		{
			if(ProxDetectorS(30.0, playerid, hitid) && !IsPlayerInAnyVehicle(hitid))
			{
				format(string, sizeof(string), "* %s выстрелил электрошоком в %s, и парализовал.", playername(playerid) ,playername(hitid));
				ProxDetector(30.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				tazerplayer(playerid, hitid);
			}
		}
		if(OnDuty[playerid] == 0)
		{
			Protect_Remove(playerid, 23);
			SetPlayerArmedWeapon(playerid, WEAPON:0);
		}
		format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~Tazer: ~w~%d/10",OnDuty[playerid]);
		GameTextForPlayer(playerid,string,5000,3);

		if(PoliceStick[1][playerid] >= 1 && !howstun(playerid))
		{
			ApplyAnimation(playerid,"COLT45","COLT45_RELOAD",4.0, false, false, false, false, false, SYNC_ALL);
			PlayerPlaySound(playerid, 36401, 0.0, 0.0, 0.0);
			return 0;
		}
		return 1;
  }

  if(weaponid >= WEAPON:22 && weaponid <= WEAPON:34 || weaponid == WEAPON:38)
  {
  	// Подсчёт выстрелов для капта
  	if(gVidga[playerid] == true)
	{
	  	if(IsAZoneCapt(playerid))
		{
			if(hittype == BULLET_HIT_TYPE_NONE || hittype == BULLET_HIT_TYPE_OBJECT || hittype == BULLET_HIT_TYPE_PLAYER_OBJECT) PlayerInfo[playerid][pGangTemp][15] ++; // 0 - пустота, 3 - объект, 4 - объект игрока
			else if(hittype == BULLET_HIT_TYPE_PLAYER) // 1 - игрок
			{
				new org = fraction(playerid), toorg = fraction(hitid);
				if(IsAZoneCapt(hitid))
				{
					if(Kapt[org] == toorg) PlayerInfo[playerid][pGangTemp][11] ++;
					else if(org == toorg) PlayerInfo[playerid][pGangTemp][12] ++;
				}
				if(IsAPlayerInZone(hitid))
				{
				    if(Kapt[org] != toorg && org != toorg) PlayerInfo[playerid][pGangTemp][13] ++;
				}
			}
			else if(hittype == BULLET_HIT_TYPE_VEHICLE) PlayerInfo[playerid][pGangTemp][14] ++; // 2 - транспорт
		}
		if(hittype == BULLET_HIT_TYPE_VEHICLE)
		{
			if(VehInfo[hitid][vSeat] > 0)
			{
				new dryaver = VehInfo[hitid][vSeat]-1;
		    	if(IsOnline(dryaver))
		    	{
					if(IsADeathMatch(playerid, dryaver, 2)) DamagePlayerLog(dryaver, playerid, weaponid, 2);
				}
			}
		}
	}
  	//=====================
  	//=====[ Анти +C ]=====
	if(!ComputerClubIsPlayerCbugActive(playerid) // Не в комп клубе (при разрешённом +C внутри комнаты)
		&& MPGO[playerid] == 0 // Не на мп
		&& !MineWar_IsPlayerInside(playerid) // Не в шахте
		&& !Tomb_IsPlayerInside(playerid)) // Не в гробнице
	{
		if(weaponid == WEAPON:24 || weaponid == WEAPON:25 || weaponid == WEAPON:33 || weaponid == WEAPON:34)
		{
			new current_tick = GetTickCount();
			new interval = GetTickDiff(current_tick, AntiC[playerid]);
			new tiskt;
			if(weaponid == WEAPON:24) tiskt = 500;
			else tiskt = 800;
			if(interval < tiskt)
			{
				CBug[playerid] = gettime()+2;
				if(ChutC[fraction(playerid)] == 0 && GoC[fraction(playerid)] == 0)
				{
					if(hittype == BULLET_HIT_TYPE_PLAYER && IsOnline(hitid) && !IsPlayerNPC(hitid) && GetPVarInt(hitid,"afksystem") <= 3)
					{
						if(AntiC2[playerid] < 2)
						{
							SetPlayerArmedWeapon(playerid, WEAPON:0);
							SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347} +C запрещено на сервере! [Code: 4010].");
							ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff0000}****  {FFFFFF}*[Protect Project]*  {ff0000}****","{ff0000}******** {0066ff}Protect Project: {FFffff} +C запрещено на сервере! [Code:4010] {ff0000}********","*","");
							AntiC2[playerid]++;
						}
						else
						{
							SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347} Вы были кикнуты по причине: +C [Code: 4011].");
							ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff0000}****  {FFFFFF}*[Protect Project]*  {ff0000}****","{ff0000}******** {ffffff}Вы были кикнуты по причине: +C [Code: 4011] {ff0000}********","*","");
							Kickx(playerid);
						}
						return 0;
					}
				}
			}
			AntiC[playerid] = current_tick;
		}
	}
	
	// Триггер охоты
	new areahunt = IsPlayerInWildZone(playerid);
	if(areahunt != -1) return EventHandlerHuntWildAnimalsShooting(playerid, areahunt,weaponid);
  }
  return 1;
}

forward DelAkula(playerid);
public DelAkula(playerid)
{
    StopDynamicObject(akula[playerid]);
    KillTimer(AkulaTimer[playerid]);
    if(GetPVarInt(playerid, "akula") == 1)
    {
        SetPVarInt(playerid, "akula", 2);
        new Float:obx, Float:oby, Float:obz;
        GetDynamicObjectPos(akula[playerid],obx, oby, obz);
        MoveDynamicObject(akula[playerid], obx, oby, obz-30.0, 3);
        AkulaTimer[playerid] = SetTimerEx("DelAkula", 3000, false, "d", playerid);
        return 1;
    }
    else if(GetPVarInt(playerid, "akula") == 2)
    {
        SetPVarInt(playerid, "akula", 0);
        DestroyDynamicObject(akula[playerid]);
        return 1;
    }
    return 1;
}
forward StopMuz(playerid);
public StopMuz(playerid)
{
    KillTimer(MuzTimer[playerid]);
    PlayerPlaySound(playerid,6400,0,0,0);
    return 1;
}
forward DelCam(playerid);
public DelCam(playerid)
{
    KillTimer(CamTimer[playerid]);
    TogglePlayerControllable(playerid, true);
    TextDrawHideForPlayer(playerid, Chernifon);
    return 1;
}

