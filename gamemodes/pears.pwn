					SuccessMessage(playerid, string);
  				}
   			}
			if(listitem == 1)
   			{
   				if(VehInfo[v][vModel] == 0 || VehInfo[v][vAgetid] != playerid || VehInfo[v][vModel] != PlayerInfo[playerid][pRentModel][sl])
				{
					format(string, sizeof(string), "{FF6347}%s был заспавнен! {ff9000}Его необходимо загрузить перед продлением аренды\n\n{cccccc}Хотите загрузить транспорт и отметить на карте?",GetVehicleName(PlayerInfo[playerid][pRentModel][sl]));
