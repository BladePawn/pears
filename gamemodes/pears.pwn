	case 1382:
	{
		new g = DP[4][playerid], ord = DP[1][playerid];
		if(response)
		{
			if(OrganInfo[g][gOrderStatus] == 1) return ErrorText(playerid, "{FF6347}Вы не можете редактировать активный заказ"), OrderEscort(playerid, g);
			if(OrganInfo[g][gOrder][ord] == 0) return ErrorText(playerid, "{FF6347}Ошибка! В этом слоте не выбран предмет"), OrderEscort(playerid, g);
			if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Вы не можете сейчас изменить заказ, доставку выполняет NGSA"), OrderEscort(playerid, g);
			new input, thingId = OrganInfo[g][gOrder][ord], thingType = OrganInfo[g][gOrderType][ord];
			if(sscanf(inputtext, "i", input)) return ErrorText(playerid, "{FF6347}Вы ничего не ввели"), InsertOrderEscort(playerid, g, ord);

			new maxQuan = sklad_limit(thingId, thingType);
			if(input < 1 || input > maxQuan/4) return format(string, sizeof(string), "{FF6347}Не меньше 1 и не больше %d", maxQuan/4), ErrorText(playerid, string), InsertOrderEscort(playerid, g, ord);

			new realQuan = get_sklad(g,thingId,thingType);

			if(realQuan+input > maxQuan)
			{
				if(maxQuan-realQuan <= 0) format(string, sizeof(string), "{FF6347}Нет места для этого предмета. Лимит: %d", maxQuan);
				else format(string, sizeof(string), "{FF6347}Лимит для этого предмета: %d {444444}[Укажите: %d]", maxQuan, maxQuan-realQuan);
				ErrorText(playerid, string);
				InsertOrderEscort(playerid, g, ord);
				return 1;
			}

  			OrganInfo[g][gOrderQuan][ord] = input;
  			PlayerPlaySound(playerid,6401,0,0,0);
  			InsertOrderEscort(playerid, g, ord);
		}
		else InsertOrderEscort(playerid, g, ord);
	}
