						{
							if(BizzInfo[b][bCity] == 2)
							{
								if(IsPlayerInRangeOfPoint(playerid, 9.0, 2393.6160, 1000.1471, 10.8203) || IsPlayerInRangeOfPoint(playerid, 9.0, 2394.4548, 990.9169, 10.8203))
								{
									shoppos(playerid, b, v);
								}
							}
							if(BizzInfo[b][bCity] == 1)
							{
								if(IsPlayerInRangeOfPoint(playerid, 9.0, -2531.3118, -23.5520, 16.4219) || IsPlayerInRangeOfPoint(playerid, 9.0, -2531.1018, -15.1876, 16.4219))
								{
									shoppos(playerid, b, v);
