	case 439:
	{
		if(response)
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0,-336.2932,1725.8201,42.8567) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
			{
				new input = strval(inputtext), fmoney, thingType = 0;
                if(sscanf(inputtext, "i", input)) return pc_cmd_egypt(playerid);
                if(input < 0 || input > 10000) return ErrorMessage(playerid, "{FF6347}Не меньше 0 и не больше 10000");
                
				new fpick = DP[0][playerid];
				if(fpick <= sizeof(friskName)) fmoney = friskPrice[fpick];
				else
				{
					if(fpick == 19591) fmoney = ServerInfo[6];
					else if(fpick == 19590) fmoney = ServerInfo[7];
					else if(fpick == 11712) fmoney = ServerInfo[8];
					thingType = 2;
				}
                
                new quan = get_invent4(playerid, fpick, thingType);
				if(quan <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет в свободной ячейке этого предмета");
				if(input > quan || input == 0) input = quan;
				new pay = input*fmoney;
				if(ServerInfo[53] == 4) pay += pay/4;
				if (!TakeMoneyFromTreasury(pay, "Зарплата (археология)"))
				{
					return ErrorMessage(playerid, "{FF6347}В казне недостаточно средств для выдачи зарплаты.\n{FF6347}Обратитесь к администрации.");
				}
				paysalary(playerid, pay, 0);
				DelInvent(playerid, fpick, input, thingType);
				ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false);
				MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", pay, "Археология");
				SendDynamicActorMessage(playerid, BotPears[204],"Отлично! Держи деньги");
				SetPlayerChatBubble(playerid,"продаёт предметы",COLOR_PURPLE,20.0,3000);
			
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я продал%s предметы %d шт. за {99ff66}%d$", gender(playerid), input, pay);
                
				if(PlayerInfo[playerid][pQuest][5] == 5) PlayerInfo[playerid][pQuest][5] = 7, QuestActorBruce(playerid);
    		}
  		}
  		else pc_cmd_egypt(playerid);
	}
	case 453:
	{
        if(response)
		{
  			if(listitem == 0)
			{
				if(PlayerInfo[playerid][pLeader] >= 1) return ErrorMessage(playerid, "{FF6347}Лидеру нельзя работать под прикрытием");
			    if(PlayerInfo[playerid][pRank] <= 1) return ErrorMessage(playerid, "{FF6347}Можно получить задание только со 2-го ранга");
				if(GetPVarInt(playerid,"razr") == 0) return ErrorMessage(playerid, "{FF6347}Вам нужно получить разрешение на задание у руководства");
				if(PlayerInfo[playerid][pFbi] >= 1) return ErrorMessage(playerid, "{FF6347}Вы уже агент под прикрытием");
				SetPVarInt(playerid,"razr",0);
				PlayerInfo[playerid][pFbi] = PlayerInfo[playerid][pRank];
				PlayerInfo[playerid][pMember] = 0;
				PlayerInfo[playerid][pRank] = 0;
				PlayerInfo[playerid][pVig] = 0;

				// Сохраняем подфракцию у FBI
				if(PlayerInfo[playerid][pDivision][0] > 0)
				{
					PlayerInfo[playerid][pDivision][1] = PlayerInfo[playerid][pDivision][0];
					PlayerInfo[playerid][pDivRank][1] = PlayerInfo[playerid][pDivRank][0];
					PlayerInfo[playerid][pDivision][0] = 0;
					PlayerInfo[playerid][pDivRank][0] = 0;
