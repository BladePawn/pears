						format(stro,sizeof(stro),"\n{cccccc}Убедитесь, что ваш спавн достаточно удобный и ваш не мешают другие объекты\n"), strcat(sctringo,stro);
						ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{FF9000}Дом",sctringo,"Ок","");
