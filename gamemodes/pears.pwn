	else if(place == 2) SetDynamicObjectPos(ArrowDesk[desk], 1380.861572, 1577.000122, 10.635492), SetDynamicObjectRot(ArrowDesk[desk], 0.000029, -89.999992, -0.000121);
	else if(place == 3) SetDynamicObjectPos(ArrowDesk[desk], 1380.861572, 1575.869018, 10.635492), SetDynamicObjectRot(ArrowDesk[desk], 0.000029, -89.999992, -0.000121);
	else if(place == 4) SetDynamicObjectPos(ArrowDesk[desk], 1380.541259, 1574.848022, 10.635492), SetDynamicObjectRot(ArrowDesk[desk], 0.000029, -89.999992, -90.000122);
	else if(place == 5) SetDynamicObjectPos(ArrowDesk[desk], 1379.600341, 1575.198608, 10.635492), SetDynamicObjectRot(ArrowDesk[desk], 0.000029, -89.999992, -180.000122);
	if(stat == 1) SetDynamicObjectMaterialText(ArrowDesk[desk], 0, "п", 140, "Wingdings", 199, 1, 0xFF900000, 0x00000000, 1);
	else SetDynamicObjectMaterialText(ArrowDesk[desk], 0, " ", 140, "Wingdings", 199, 1, 0xFF900000, 0x00000000, 1);
	
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
    	if(DeskInfo[desk][Playerstatus][p] > 0)
		{
			new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid))
			{
			    if(OnlineInfo[memberid][oShowInterface] == 11 && DeskStatus[memberid] == 1)
				{
				    PlayerTextDrawHide(memberid, HudPlaceDraw[13][memberid][0]), PlayerTextDrawHide(memberid, HudPlaceDraw[13][memberid][1]);
				    PlayerTextDrawHide(memberid, HudPlaceDraw[13][memberid][2]), PlayerTextDrawHide(memberid, HudPlaceDraw[13][memberid][3]);
				    PlayerTextDrawHide(memberid, HudPlaceDraw[13][memberid][4]), PlayerTextDrawHide(memberid, HudPlaceDraw[13][memberid][5]);
