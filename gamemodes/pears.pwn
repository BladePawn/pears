}

CMD:launch(playerid)
{
	if(PlayerInfo[playerid][pSoska] <= 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	new str[44],sctring[4096], kol, noquan;
	foreach(Player, i)
 	{
		if(IsPlayerSyncModels(i))
		{
			format(str,sizeof(str),"%s[%d]\n", PlayerInfo[i][pName], i), strcat(sctring,str);
			kol++;
		}
		else noquan ++;
	}
 	new qwer[72];
	format(qwer,sizeof(qwer),"{99ff66}С лаунчером: %d, {FF6347}Без лаунчера: %d", kol, noquan);
	ShowDialog(playerid,1742,DIALOG_STYLE_TABLIST,qwer,sctring,"*","");
	return 1;
}
//=======================
// Команды сброса сервера
CMD:rdomgarage(playerid) // Отключить гаражи во всех домах
{
    if(PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
    new quan;
    for(new i = 1; i < sizeof(DomInfo); i++)
	{
        if(DomInfo[i][dIngar] == 1)
        {
            DomInfo[i][dIngar] = 0;
            DestroyDynamicPickup(DomGarage[i]);
			DestroyDynamic3DTextLabel(IngarLabel[i]);
            SaveDom(i);
        	quan ++;
        }
	}
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}У всех домов отключены гаражи");

	new string[60];
	format(string,sizeof(string),"{99ff66}Сброшены гаражи в %d домах", quan);
	SuccessMessage(playerid, string);
	return 1;
}

CMD:rorgmoney(playerid) // Сбросить счета всех организаций и гос. казны
{
    if(PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
    for(new g = 1; g < MAX_ORG; g++)
	{
		bigint_set(OrganInfo[g][glave], 10000000);
        if(g == 7) bigint_set(OrganInfo[g][glave], 500000000);
    	SaveOrgan(g);
    }
    SuccessMessage(playerid, "{99ff66}Всем организациям сброшены деньги на счету (10кк)\n\nВ казне: 500кк");
	return 1;
}

