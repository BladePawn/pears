    else format(str,sizeof(str),"\n{cccccc}Городская Клининговая Служба \t "), strcat(sctring,str);
    if(ServerInfo[53] == 9) format(str,sizeof(str),"\n{cccccc}Автобусное Депо \t {99ff66}[Повышенная Оплата]"), strcat(sctring,str);
    else format(str,sizeof(str),"\n{cccccc}Автобусное Депо \t "), strcat(sctring,str);
