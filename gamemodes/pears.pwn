		cache_get_value_name_int(0, "Money", datad18);
		cache_get_value_name_int(0, "Account", datad19);
		cache_get_value_name_int(0, "AdmWarns", datad21);
		cache_get_value_name_int(0, "Soska", datad22);
		cache_get_value_name_int(0, "DrugPerk", datad26);
		cache_get_value_name_int(0, "TraderPerk", datad27);
		cache_get_value_name_int(0, "Meshk1", datad28);
		cache_get_value_name_int(0, "Gun13", datad29);
		cache_get_value_name_int(0, "Ammo13", datad30);
		cache_get_value_name_int(0, "Crimes", datad36);
		cache_get_value_name(0, "MarriedTo", married, 24);
		cache_get_value_name(0, "Mail", datad24, 128);
		cache_get_value_name_int(0, "MailStat", datad0);
		cache_get_value_name(0, "Offtime", datad25, 24);
		cache_get_value_name_int(0, "Ammo1", datad44);
		cache_get_value_name_int(0, "Banned", datad49);
		cache_get_value_name_int(0, "BanDayz", datad50);
		cache_get_value_name_int(0, "Google", datad51);
		cache_get_value_name_int(0, "Ammo8", datad52);
		cache_get_value_name_int(0, "Ammo6", ndat[7]);
		cache_get_value_name_int(0, "HeadValue", ndat[8]);
		cache_get_value_name_int(0, "Expert", ndat[9]);
		cache_get_value_name_int(0, "Question", ndat[10]);
		cache_get_value_name_int(0, "Unit", ndat[11]);
		cache_get_value_name_int(0, "GameDay", ndat[15]);
		cache_get_value_name_int(0, "GameTime", ndat[16]);
		cache_get_value_name_int(0, "GameAfk", ndat[17]);
		cache_get_value_name_int(0, "AdmPoint", ndat[18]);
		cache_get_value_name_int(0, "AdmScore", ndat[19]);
		cache_get_value_name_int(0, "Reproof", ndat[20]);
		cache_get_value_name_int(0, "Abandoned", ndat[21]);
		cache_get_value_name_int(0, "AData", ndat[22]);
		cache_get_value_name_int(0, "RegData", ndat[23]);
		cache_get_value_name(0, "Gpci", datgpci, 64);
		cache_get_value_name_int(0, "X2exp", ndat[0]);
		cache_get_value_name(0, "BanResult", banrea, 44);
		cache_get_value_name_int(0, "Media", ndat[1]);
		cache_get_value_name(0, "CallSign", datad54, 24);
		cache_get_value_name_int(0, "Division0", Division0);
		cache_get_value_name_int(0, "pTrailer", datad53);
		cache_get_value_name_int(0, "pDivRank0", DivRank);
		cache_get_value_name_int(0, "Djpears", DJ);

		new continental[7], continental_total;
		for (new i = 0; i < 7; i++)
		{
			FORMAT:coins_day("coins_%d", i);
			cache_get_value_name_int(0, coins_day, continental[i]);
			continental_total += continental[i];
		}
		
		new nxtlevel = datad1+1;
		new expamount = nxtlevel*4;
		new r = datad14, rtext[64];
		new g;
		if(datad13 >= 1) g = datad13;
		else if(datad13 == 0) g = datad12;
		new gz = g;
		if(r >= 1) strmid(rtext, RankOrg[g][r-1], 0, 34);
		else strmid(rtext, "none", 0, 34);
		
		new idacca;
		cache_get_value_name_int(0, "user_id", idacca);
		new str[168], sctring[2800], unixtime = gettime();
		format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n"), strcat(sctring,str);
		if(ndat[1]) format(str,sizeof(str),"{0088ff}Аккаунт № {ffffff}%d | {ff6699}Media [%d]\n",idacca,ndat[1]), strcat(sctring,str);
		else format(str,sizeof(str),"{0088ff}Аккаунт № {ffffff}%d\n",idacca), strcat(sctring,str);
		if(DJ >= 1) format(str,sizeof(str),"{0088ff}Radio DJ: {ffffff}%d\n",DJ), strcat(sctring,str);
		new vip;
		if(datad7 == 0) vip = 0;
		else if(datad7 == 1)
		{
			if(datad40 >= unixtime) vip = 1;
			else vip = 0;
		}
		else if(datad7 == 4) vip = 4;
		if(vip == 0) format(str,sizeof(str),"{0088ff}VIP: {444444}нет\n"), strcat(sctring,str);
		else if(vip == 1 || vip == 2)
		{
			new days, hour, minute, second;
			getunix(datad40-unixtime, days, hour, minute, second);
			format(str,sizeof(str),"{ffcc00}VIP: {ffffff}Осталось %02d дней, %02d часов, %02d минут\n", days, hour, minute), strcat(sctring,str);
		}
		else if(vip == 3 || vip == 4) format(str,sizeof(str),"{7474da}Platinum VIP\n"), strcat(sctring,str);
		format(str,sizeof(str),"{ffcc00}Gold: {ff9000}%dG\n",datad8), strcat(sctring,str);
		if(ndat[0] >= 1)
		{
			format(str,sizeof(str),"{0088ff}Уровень: {ffffff}%d   {0088ff}|   Опыт: {ffffff}%d/%d   {ff9000}X2 Exp {cccccc}Осталось: %d\n",datad1,datad2,expamount, ndat[0]), strcat(sctring,str);
		}
		else
		{
			format(str,sizeof(str),"{0088ff}Уровень: {ffffff}%d   {0088ff}|   Опыт: {ffffff}%d/%d \n",datad1,datad2,expamount), strcat(sctring,str);
		}
		format(str,sizeof(str),"{0088ff}Часов в игре: {ffffff}%d \n",datad3); // Обновлено
		strcat(sctring,str);

		{
			new w_day, w_hour, w_minute, w_second;
			getunix(datad56 - unixtime, w_day, w_hour, w_minute, w_second);

			new remains[100];
			format(remains, sizeof(remains), "%d %s %d %s %d %s", 
				w_day, PluralToText(w_day, "день", "дня", "дней"),
				w_hour, PluralToText(w_hour, "час", "часа", "часов"),
				w_minute, PluralToText(w_minute, "минута", "минуты", "минуту")
			);

			if(datad5 >= 1 && datad5 < MAX_WARNS - 1) format(str,sizeof(str),"{0088ff}Warn: {ffffff}%d/%d {cccccc}[ Снимется через %s ] \n",datad5, MAX_WARNS, remains), strcat(sctring,str);
			if(datad5 >= MAX_WARNS - 1) format(str,sizeof(str),"{0088ff}Warn: {ff0000}%d/%d {cccccc}[ Снимется через %s ]\n",datad5, MAX_WARNS, remains), strcat(sctring,str);
		}

		{
			new zz_time[144];
			if (datad57 > unixtime)
			{
				new w_day, w_hour, w_minute, w_second;
				getunix(datad57 - unixtime, w_day, w_hour, w_minute, w_second);
				
				new remains[100];
				format(remains, sizeof(remains), "%d %s %d %s %d %s", 
					w_day, PluralToText(w_day, "день", "дня", "дней"),
					w_hour, PluralToText(w_hour, "час", "часа", "часов"),
					w_minute, PluralToText(w_minute, "минута", "минуты", "минут")
				);

				format(zz_time, sizeof(zz_time), "{cccccc}[ Время ограничения: %s ]", remains);
			}

			if(datad55 >= 1 && datad55 < MAX_GUN_WARNS - 1) format(str,sizeof(str),"{0088ff}GunWarn: {ffffff}%d/%d %s\n", datad55, MAX_GUN_WARNS, zz_time), strcat(sctring,str);
			if(datad55 >= MAX_GUN_WARNS - 1) format(str,sizeof(str),"{0088ff}GunWarn: {ff0000}%d/%d %s\n", datad55, MAX_GUN_WARNS, zz_time), strcat(sctring,str);
		}
		
		if(datad6 >= 1 && datad6 <= 3)
		{
			format(str,sizeof(str),"{0088ff}Кол-во банов: {ffffff}%d/5 \n",datad6); // Обновлено
			strcat(sctring,str);
		}
		if(datad6 >= 4)
		{
			format(str,sizeof(str),"{0088ff}Кол-во банов: {ff0000}%d/5 \n",datad6); // Обновлено
			strcat(sctring,str);
		}
		if(datad9 >= 0) format(str,sizeof(str),"{0088ff}Репутация: {33CCFF}%d\n",datad9), strcat(sctring,str);
		else format(str,sizeof(str),"{0088ff}Репутация: {FF6347}%d\n",datad9), strcat(sctring,str);
		if(datad26>=1) format(str,sizeof(str),"{0088ff}Номер Телефона: {ffffff}%d {cccccc}[ Баланс: %d$ ]\n",datad26,datad27), strcat(sctring,str);
		if(ndat[9] >= 1) format(str,sizeof(str),"{66ffcc}Эксперт: {cccccc}[ Рейтинг: %d | Обращений: %d ]\n",ndat[7],ndat[10]), strcat(sctring,str);
		if(datad22 >= 1 || datad13 >= 1)
		{
			new Days = getdate();
			if(ndat[15] == Days)
			{
				new thour = ndat[16]/3600;
				new vremh = thour*3600;
				new vremmin = ndat[16]-vremh;
				new tmin = vremmin/60;
				new tsek = vremmin-tmin*60;
				new ahour = ndat[17]/3600;
				new avremh = ahour*3600;
				new avremmin = ndat[17]-avremh;
				new amin = avremmin/60;
				new asek = avremmin-amin*60;
				format(str,sizeof(str),"{0088ff}Online Сегодня: {cccccc}%02d:%02d {444444}%02d сек. {0088ff}| AFK: {cccccc}%02d:%02d {444444}%02d сек.\n",thour,tmin,tsek,ahour,amin,asek), strcat(sctring,str);
			}
			else format(str,sizeof(str),"{0088ff}Online Сегодня: {cccccc}00:00 {444444}00 сек. {0088ff}| AFK: {cccccc}00:00 {444444}00 сек.\n"), strcat(sctring,str);
		}
		format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n");
		strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}Семейное положение: {ffffff}%s \n",married); // Обновлено
		strcat(sctring,str);

		if(datad16 != 0)
		{
			format(str,sizeof(str),"\n{0088ff}%s: {ffffff}№ %d %s", famTypeName[FamilyInfo[datad16][fType]], datad16, FamilyInfo[datad16][fName]), strcat(sctring,str);
			format(str,sizeof(str),"\n{0088ff}Ранг: {ffffff}%d\n", datad17), strcat(sctring,str);
		}

		if(g > 0)
		{
			format(str,sizeof(str),"\n{0088ff}Организация: {ffffff}%s\n",orgName[gz]), strcat(sctring,str);
			
			if(gz == 8) format(str,sizeof(str),"{0088ff}Ранг: {ffffff}%s [%d] {950000}%s\n",rtext,r,datad54), strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Ранг: {ffffff}%s [%d]\n",rtext,r), strcat(sctring,str);

			if(datad13 >= 1)
			{
				if(datad22 == 0) format(str,sizeof(str),"{0088ff}Reproof: {ffffff}%d/3\n",ndat[20]), strcat(sctring,str);
				format(str,sizeof(str),"{0088ff}Лид. Выговоры: {ffffff}%d/5 \n",datad15), strcat(sctring,str);
				if(datad22 == 0) format(str,sizeof(str),"{0088ff}Point: {ffffff}%d {0088ff}| Score: {ffffff}%d\n",ndat[18],ndat[19]), strcat(sctring,str);
			}
			else format(str,sizeof(str),"{0088ff}Выговоры: {ffffff}%d/5 \n",datad15), strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}Юниты: {9900ff}%d {cccccc}[%s]\n",ndat[11],get_k(ndat[11])), strcat(sctring,str);
			if(IsAMafiaID(gz)) format(str,sizeof(str),"{0088ff}Монеты Континенталь: {ff4500}%d {cccccc}[%s]\n", continental_total, get_k(continental_total)), strcat(sctring,str);
		}

		// Подфракция
		if(Division0 > 0 && gz > 0)
		{
			new i = Division0 - 1;
			format(str,sizeof(str),"\n{0088ff}Подфракция: {ffffff}%s [%d]\n",DivisionInfo[gz-1][i][divName], i + 1), strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}Ранг: {ffffff}%d\n", DivRank), strcat(sctring,str);
		}

		if(ndat[6] > 0 && PlayerInfo[playerid][pSoska] >= 10) format(str,sizeof(str),"{FF6347}Сектант: %d\n",ndat[6]), strcat(sctring,str);
		format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n"), strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}Наличные: {99ff66}%d$ {cccccc}[%s]\n",datad18,get_k(datad18)), strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}Банковский Счёт: {99ff66}%d$ {cccccc}[%s]\n",datad19,get_k(datad19)), strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}Фишек в Казино: {ffffff}%dF | {ffcc00}Gold %dF\n",datad44,datad52), strcat(sctring,str);
		if(datad29 > 0) format(str,sizeof(str),"{0088ff}Дом №: {ffffff}%d\n",datad29), strcat(sctring,str);
		if(datad30 > 0) format(str,sizeof(str),"{0088ff}Квартира №: {ffffff}%d\n",datad30), strcat(sctring,str);
		if(datad28 > 0) format(str,sizeof(str),"{0088ff}Бизнес: {ffffff}%s [%d] \n",bizname(datad28),datad28), strcat(sctring,str);
		if(datad36 > 0) format(str,sizeof(str),"{0088ff}Уровень Розыска: {ff9000}%d\n",datad36), strcat(sctring,str);
		if(datad53 > 0) format(str,sizeof(str),"{0088ff}Трейлер №: {ffffff}%d\n",datad53), strcat(sctring,str);

		if(PlayerInfo[playerid][pSoska] > 0)
		{
			format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n"), strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}IP: {ffffff}[ Игрок Offline ] \n"), strcat(sctring,str);
			if(datad22 >= 1)
			{
				format(str,sizeof(str),"{0088ff}Рейтинг Администратора: {ffffff}%d\n",ndat[7]), strcat(sctring,str);
				format(str,sizeof(str),"{0088ff}Point: {ffffff}%d {0088ff}| Score: {ffffff}%d\n",ndat[18],ndat[19]), strcat(sctring,str);
				format(str,sizeof(str),"{0088ff}Предупреждения ADM: {ffffff}[Reproof %d/3] [ADM Warn %d/6]\n",ndat[20],datad21), strcat(sctring,str);
				format(str,sizeof(str),"{0088ff}Уровень ADM: {ffffff}%d \n",datad22), strcat(sctring,str);
			}
			if(ndat[8] == 1) format(str,sizeof(str),"{0088ff}Разрешение на +C: {ffffff}имеется\n"); // Обновлено
			else if(ndat[8] == 0) format(str,sizeof(str),"{0088ff}Разрешение на +C: {ffffff}нет\n"); // Обновлено
			strcat(sctring,str);
			if(datad49 >= 1)
			{
			new ostalos = datad50-unixtime;
			new osday = ostalos/86400;
			new vrem = ostalos-osday*86400;
			new oshour = vrem/3600;
			new vrem2 = vrem-oshour*3600;
			new osminute = vrem2/60;
			if(datad49 == 1) format(str,sizeof(str),"{FF0000}BANNED: {ff9000}разбан через %d дней, %d часов, %d минут\n",osday,oshour,osminute), strcat(sctring,str);
			else format(str,sizeof(str),"{FF0000}NOUNBAN: {ff9000}удаление через %d дней в 4:00\n",osday), strcat(sctring,str);
			format(str,sizeof(str),"{FF6347}Причина: %s\n",banrea), strcat(sctring,str);
			}
			if(datad51 >= 1) format(str,sizeof(str),"{0088ff}Google Authenticator: {ffffff}установлен \n"); // Обновлено
			else format(str,sizeof(str),"{0088ff}Google Authenticator: {ff6347}не установлен \n"); // Обновлено
			strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}GPCI: {ffffff}%s \n",datgpci), strcat(sctring,str);
			if(!strcmp(datad24,"\0",true)) format(str,sizeof(str),"{0088ff}Email: {ffffff}не установлен \n"), strcat(sctring,str);
			else
			{
			if(datad0 > 0) format(str,sizeof(str),"{0088ff}Email: {FF6347}%s [ не подтверждён ]\n",datad24), strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Email: {ffffff}%s\n",datad24), strcat(sctring,str);
			}
			if(ndat[23] >= 1)
			{
				new tyear, tmonth, tday, thour, tminute, tsecond;
				stamp2datetime(ndat[23], tyear, tmonth, tday, thour, tminute, tsecond, 3);
				format(str,sizeof(str),"{0088ff}Регистрация: {444444}[ %02d.%02d.%d %02d:%02d ] \n", tday, tmonth, tyear, thour, tminute), strcat(sctring,str);
			}
			else format(str,sizeof(str),"{0088ff}Регистрация: {444444}[ нет данных ] \n"), strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}Последний раз был Online: {ffffff}%s \n",datad25), strcat(sctring,str);
			if(ndat[22] < gettime()) format(str,sizeof(str),"{0088ff}Статус Игрока: {FF6347}Неактивный [%d/10] \n",ndat[21]), strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Статус Игрока: {99ff66}Активный\n"), strcat(sctring,str);
		}
		format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n");
		strcat(sctring,str);
		new lol[128];
		if(stat == 0) format(lol,sizeof(lol),"{ffffff}%s Offline {ff9000}%02d:%02d %02d.%02d.%d",str_name,tmphour, tmpminute,day,month,year);
		else format(lol,sizeof(lol),"{ffffff}%s Offline {ff9000}%02d:%02d %02d.%02d.%d",names,tmphour, tmpminute,day,month,year);
		ShowDialog(playerid,1722,DIALOG_STYLE_MSGBOX,lol,sctring,"Ok","");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
alias:check("ch")
CMD:check(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 2 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	
	new tmp[121];
	if(sscanf(params, "s[121]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть статистику игрока [ /check ID или !Номер ]");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Длина никнейма не больше 20-ти символов");
	new giveplayerid;
 	giveplayerid = ReturnUser(tmp, 1);

	if (!IsPlayerConnected(giveplayerid)) {
		if (!sscanf(params, "'!'d", giveplayerid)) {
			foreach (new id : Player) {
				if (PlayerInfo[id][pID] == giveplayerid) {
					giveplayerid = id;
					break;
				}
			}
		}
	}

	if(IsPlayerConnected(giveplayerid) && tmp[0] != '!')
	{
		ShowStats(playerid, giveplayerid);
		PlayerPlaySound(playerid,40405,0,0,0);
	}
	else
	{
	    new string[140];
		if(CheckRP_Nickname(tmp))
		{
			mysql_format(pearsq, string,sizeof(string), "SELECT i.*, uc.* FROM `pp_igroki` i LEFT JOIN pp_user_continental uc ON i.user_id = uc.userid WHERE i.Name = '%e'", tmp);
			mysql_tquery(pearsq, string, "Call_check", "dsd", playerid, tmp, 0);
		}
		else if (!sscanf(params, "'!'d", giveplayerid))
		{
			mysql_format(pearsq, string,sizeof(string), "SELECT i.*, uc.* FROM `pp_igroki` i LEFT JOIN pp_user_continental uc ON i.user_id = uc.userid WHERE i.user_id = %d", giveplayerid);
			mysql_tquery(pearsq, string, "Call_check", "dsd", playerid, tmp, giveplayerid);
		} else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверное имя или номер аккаунта [ /check Никнейм или !Номер ]");
	}
	
	return 1;
}
forward Call_work2(playerid);
public Call_work2(playerid)
{
	new rows, str[214], sctring[4096], datad1[24], datad2, datad3, datad4, datad5, datad7, datad8, datad9, datad10, datad11,
	datad12, datad13, datad14, datad15, datad16, datad17, datad20[24], datad21[24], datad22[24], kol, string[180];
	cache_get_row_count(rows);
	if(DP[0][playerid] == 0)
	{
		format(str,sizeof(str),"{cccccc}Nick_Name           \tOnline\tAFK\tSleep\tРепорты\tSpec\tOtv\tRe\tCom\tVzlom\tJail\tPrison\tMute\tKick\tBan\tWarn\tDate\n\n");
		strcat(sctring,str);
		if(DP[2][playerid] == 1)SendClientMessage(playerid, COLOR_GREY, "{cccccc}Nick_Name Online AFK Sleep Репорты Spec Otv Re Com Vzlom Jail Prison Mute Kick Ban Warn Date");
	}
	else if(DP[0][playerid] == 1)
	{
		format(str,sizeof(str),"{cccccc}Nick_Name           \tOnline\tAFK\tSleep\tInvite\tUninvite\tVig\tFmute\tGiverank\tUnvig\tDate\n\n");
		strcat(sctring,str);
		if(DP[2][playerid] == 1)SendClientMessage(playerid, COLOR_GREY, "{cccccc}Nick_Name Online AFK Sleep Invite Uninvite Vig Fmute Giverank Unvig Date");
	}
	for(new i = 0; i < rows; i++)
	{
		cache_get_value_name(i, "admin", datad1, 24);
		cache_get_value_name_int(i, "online", datad2);
		cache_get_value_name_int(i, "afk", datad3);
		cache_get_value_name_int(i, "sleep", datad4);
		cache_get_value_name_int(i, "activity", datad5);
		cache_get_value_name_int(i, "sp", datad7);
		cache_get_value_name_int(i, "otv", datad8);
		cache_get_value_name_int(i, "re", datad9);
		cache_get_value_name_int(i, "com", datad10);
		cache_get_value_name_int(i, "vzlom", datad11);
		cache_get_value_name_int(i, "jail", datad12);
		cache_get_value_name_int(i, "prison", datad13);
		cache_get_value_name_int(i, "mute", datad14);
		cache_get_value_name_int(i, "kick", datad15);
		cache_get_value_name_int(i, "ban", datad16);
		cache_get_value_name_int(i, "warn", datad17);
		cache_get_value_name(i, "date", datad20, 24);
		cache_get_value_name(i, "date2", datad21, 24);
		cache_get_value_name(i, "admin2", datad22, 24);

		if(DP[0][playerid] == 0)
		{
			new kolsim = strlen(datad1),atext[34];
			if(kolsim == 19) atext = "{000000}*";
			else if(kolsim == 18) atext = " {000000}*";
			else if(kolsim == 17) atext = "  {000000}*";
			else if(kolsim == 16) atext = "   {000000}*";
			else if(kolsim == 15) atext = "    {000000}*";
			else if(kolsim == 14) atext = "     {000000}*";
			else if(kolsim == 13) atext = "      {000000}*";
			else if(kolsim == 12) atext = "       {000000}*";
			else if(kolsim == 11) atext = "        {000000}*";
			else if(kolsim == 10) atext = "         {000000}*";
			else if(kolsim == 9) atext = "          {000000}*";
			else if(kolsim == 8) atext = "           {000000}*";
			else if(kolsim == 7) atext = "            {000000}*";
			else if(kolsim == 6) atext = "             {000000}*";
			else if(kolsim == 5) atext = "              {000000}*";
			else if(kolsim == 4) atext = "               {000000}*";
			else if(kolsim == 4) atext = "                {000000}*";

			format(str,sizeof(str),"{ff9000}%s%s\t{ffffff}%d\t%d\t%d\t%d\t\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t\t%s\n",datad1,atext,datad2,datad3,datad4,datad5,datad7,datad8,datad9,datad10,
			datad11,datad12,datad13,datad14,datad15,datad16,datad17,datad20);
			strcat(sctring,str);
			if(DP[2][playerid] == 1)
			{
				format(string,sizeof(string), "{ff9000}%s {ffffff}%d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %s",datad1,datad2,datad3,datad4,datad5,datad7,datad8,datad9,datad10,
				datad11,datad12,datad13,datad14,datad15,datad16,datad17,datad20);
				SendClientMessage(playerid, COLOR_GREY, string);
			}
 	 	}
		else if(DP[0][playerid] == 1)
		{
			new kolsim = strlen(datad22),atext[34];
			if(kolsim == 19) atext = "";
			else if(kolsim == 18) atext = " {000000}*";
			else if(kolsim == 17) atext = "  {000000}*";
			else if(kolsim == 16) atext = "   {000000}*";
			else if(kolsim == 15) atext = "    {000000}*";
			else if(kolsim == 14) atext = "     {000000}*";
			else if(kolsim == 13) atext = "      {000000}*";
			else if(kolsim == 12) atext = "       {000000}*";
			else if(kolsim == 11) atext = "        {000000}*";
			else if(kolsim == 10) atext = "         {000000}*";
			else if(kolsim == 9) atext = "          {000000}*";
			else if(kolsim == 8) atext = "           {000000}*";
			else if(kolsim == 7) atext = "            {000000}*";
			else if(kolsim == 6) atext = "             {000000}*";
			else if(kolsim == 5) atext = "              {000000}*";
			else if(kolsim == 4) atext = "               {000000}*";
			else if(kolsim == 4) atext = "                {000000}*";
			format(str,sizeof(str),"{0088ff}%s%s\t{ffffff}%d\t%d\t%d\t%d\t%d\t\t%d\t%d\t%d\t\t%d\t%s\n",datad22,atext,datad2,datad3,datad4,datad7,datad8,datad9,datad10,datad11,datad12,datad21);
			strcat(sctring,str);
			if(DP[2][playerid] == 1)
			{
				format(string,sizeof(string), "{0088ff}%s {ffffff}%d %d %d %d %d %d %d %d %d %s",datad22,datad2,datad3,datad4,datad7,datad8,datad9,datad10,datad11,datad12,datad21);
				SendClientMessage(playerid, COLOR_GREY, string);
			}
		}
		kol ++;
    }
    if(kol >= 1)
	{
		if(DP[0][playerid] == 0) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Admin Work",sctring,"Ок","");
		else if(DP[0][playerid] == 1) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}Leader Work",sctring,"Ок","");
	}
    else if(kol == 0)
	{
		if(DP[0][playerid] == 0) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Admin Work","{cccccc}По запросу ничего не найдено","Ок","");
		else if(DP[0][playerid] == 1) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}Leader Work","{cccccc}По запросу ничего не найдено","Ок","");
	}
	return true;
}
CMD:work2(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	PlayerPlaySound(playerid,40405,0,0,0);
   	new str[100],sctring[400];
   	format(str,sizeof(str),"{ff9000}Admin Work\n");
	strcat(sctring,str);
	format(str,sizeof(str),"{0088ff}Leader Work\n");
	strcat(sctring,str);
	if(DP[2][playerid] == 0) format(str,sizeof(str),"{cccccc}Вывод в чат [ {ff0000}Off {cccccc}]\n"), strcat(sctring,str);
	else if(DP[2][playerid] == 1) format(str,sizeof(str),"{cccccc}Вывод в чат [ {00cc00}ON {cccccc}]\n"), strcat(sctring,str);
	ShowDialog(playerid,875,DIALOG_STYLE_LIST,"{ff9000}Work 2",sctring,"Выбор","Отмена");
	return 1;
}
CMD:checkskill(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть навыки игрока [ /checkskill ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(params[0] != INVALID_PLAYER_ID) ShowSkill(playerid,params[0]);
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}

CMD:checkveh(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить эту команду");
	
	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть статистику игрока [ /checkveh ID ]");
	if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Длина никнейма не больше 20-ти символов");

	new giveplayerid, user_id = -1;
 	giveplayerid = ReturnUser(params[0], 1);
	if(IsOnline(giveplayerid)) user_id = PlayerInfo[giveplayerid][pID];

	new string[128];
	if(CheckRP_Nickname(params[0]))
	{
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Name FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
		mysql_tquery(pearsq, string, "Call_finduser_checkveh", "dd", playerid, -1);
	}
	else
	{
		if(!checknum(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверное имя или номер аккаунта [ /checkveh Номер Аккаунта или Никнейм ]");
		if(user_id == -1) user_id = strval(params[0]);
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Name FROM `pp_igroki` WHERE `user_id` = '%d'", user_id);
		mysql_tquery(pearsq, string, "Call_finduser_checkveh", "dd", playerid, giveplayerid);
	}
	return 1;
}

// Поиск аккаунта для просмотра транспорта игрока оффлайн
function Call_finduser_checkveh(playerid, giveplayerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new user_id, name[24];
		cache_get_value_name_int(0, "user_id", user_id);
		cache_get_value_name(0, "Name", name, sizeof(name));

		new string[100];
		mysql_format(pearsq, string,sizeof(string),"SELECT newid, slot, model, Sklad FROM `pp_cars` WHERE `sost` = '%d'", user_id);
		mysql_tquery(pearsq, string, "Call_checkveh", "dsdd", playerid, name, user_id, giveplayerid);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
}

// Отображаем тачки
function Call_checkveh(playerid, const str_name[], user_id, giveplayerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new line[214],lines[4096];
		format(line,sizeof(line),"{cccccc}Личный Транспорт {ff9000}%s\n", str_name), strcat(lines,line);

		new newid, slot, model, Sklad;
		for(new f = 0; f < rows; f++)
		{
			cache_get_value_name_int(f, "newid", newid);
			cache_get_value_name_int(f, "slot", slot);
			cache_get_value_name_int(f, "model", model);
			cache_get_value_name_int(f, "Sklad", Sklad);
			if(model == 0) continue;

			// Если в угоне (то она точно не загружена)
			if(Sklad > 0) format(line,sizeof(line),"\n{cccccc}Слот %d %s [ Model: %d | DB: %d ] {FF6347}В угоне", slot, GetVehicleName(model), model, newid), strcat(lines,line);
			
			// Если не в угоне (мб кто-то её загрузил)
			else
			{
				if(giveplayerid == INVALID_PLAYER_ID) format(line,sizeof(line),"\n{cccccc}Слот %d %s [ Model: %d | DB: %d ]", slot, GetVehicleName(model), model, newid), strcat(lines,line);
				else
				{
					format(line,sizeof(line),"\n{cccccc}Слот %d %s [ Model: %d | DB: %d ]", slot, GetVehicleName(model), model, newid), strcat(lines,line);
				}
			}
		}
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{999999}*",lines,"*","");
	}
	else ErrorMessage(playerid, "{FF6347}У этого игрока нет личного транспорта");
	return true;
}

CMD:checkpotreb(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть потребности игрока [ /checkpotreb ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(params[0] != INVALID_PLAYER_ID) ShowPotreb(playerid,params[0]);
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}
CMD:checkmed(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть болезни игрока [ /checkmed ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(params[0] != INVALID_PLAYER_ID) getmed(playerid, params[0], true);
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}

CMD:checkgoods(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть журнал торговли игрока [ /checkgoods ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	PlayerPlaySound(playerid,40405,0,0,0);
	if(GetPVarInt(playerid,"aflog1") == 1) return ErrorMessage(playerid, "{FF6347}Дождитесь загрузки логов");
	SetPVarInt(playerid,"aflog1",1);
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}Поиск логов...","*","");
	new string[400];
	mysql_format(pearsq_2, string, sizeof(string), "SELECT *, DATE_FORMAT(timestamp, \'%%d.%%c.%%Y %%H:%%i:%%s\', \'Europe/Moscow\') AS timestamp_fmt, \
			convertCharset(`rows`, \'utf-8\', \'windows-1251\') AS rows_1251 \
			FROM `inventory_logs` WHERE `primary_player_id` = '%d' AND (`action` = 'buygoods' OR `action` = 'sellgoods') ORDER BY `timestamp` DESC LIMIT 40", PlayerInfo[params[0]][pID]);
	mysql_tquery(pearsq_2, string, "Call_logs5", "d", playerid);
	return 1;
}

