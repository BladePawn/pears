						GameTextForPlayer(playerid, RusToGame("~w~Вы ~g~Свободны"), 5000, 3);
						SetPlayerToTeamColor(playerid);
						GF_OnPlayerUpdate(playerid);
						ClearAnim(playerid);
					}
