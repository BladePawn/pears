			DomInfo[103][dProd0] = 10000, UpdateBenz(103);
			yes = 1;
		}
        if(IsPlayerInRangeOfPoint(playerid,9.0,357.5112,-1807.9323,4.5737))
		{
			if(DomInfo[105][dProd0] >= 9800) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В цистернах ещё достаточно топлива");
