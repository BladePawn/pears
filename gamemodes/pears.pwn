    foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && playerid != i && ProxDetectorS(30.0, playerid, i) && GetPlayerState(i) != PLAYER_STATE_SPECTATING) kolko ++;
	}
	return 1;
}

CMD:try(playerid, const params[])
{
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	if(sscanf(params, "s[350]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Попытка, что-либо сделать [ /try действие ]");
	new string[350];
	if(isamute(playerid) == 1) return 1;
	new unix = gettime();
	if(a_flood[3][playerid] > unix) return format(string, sizeof(string), "[ Мысли ]: Не так быстро... {FF6347}[ %d сек. ]", a_flood[3][playerid]-unix), SendClientMessage(playerid, COLOR_GREY, string);
	a_flood[3][playerid] = unix+20;
	new randa = random(2);
	if(NameTag[playerid] == true)
	{
		if(PlayerInfo[playerid][pSex] == 1)
		{
			  if(randa == 0) format(string, sizeof(string), "* Незнакомец %s и у него это получается", params[0]);
			  else format(string, sizeof(string), "* Незнакомец %s и у него это не получается", params[0]);
	    }
	    else if(PlayerInfo[playerid][pSex] == 2)
		{
			  if(randa == 0) format(string, sizeof(string), "* Незнакомка %s и у неё это получается", params[0]);
			  else format(string, sizeof(string), "* Незнакомка %s и у неё это не получается", params[0]);
	    }
  	}
  	else
  	{
		if(PlayerInfo[playerid][pSex] == 1)
		{
			  if(randa == 0) format(string, sizeof(string), "* %s %s и у него это получается", playername(playerid), params[0]);
			  else format(string, sizeof(string), "* %s %s и у него это не получается", playername(playerid), params[0]);
	    }
	    else if(PlayerInfo[playerid][pSex] == 2)
		{
			  if(randa == 0) format(string, sizeof(string), "* %s %s и у неё это получается", playername(playerid), params[0]);
			  else format(string, sizeof(string), "* %s %s и у неё это не получается", playername(playerid), params[0]);
	    }
  	}
	ProxDetectorScream(30.0, playerid, string, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, true);
	return 1;
}
CMD:z(playerid, const params[])
{
	if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(MPGO[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сотрудник департамента [ /z текст ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	new positionName[64], positionColor, textColor[6 + 1];
	if(fraction(playerid) == 4)
	{
		positionColor = COLOR_LIGHTRED22;
		strcat(positionName, "Доктор");
		strcat(textColor, "fd7474");
	} else if (fraction(playerid) == 7) {
		positionColor = COLOR_PRAV;
		strcat(positionName, "Сотрудник правительства");
		strcat(textColor, "cccccc");
	} else if (fraction(playerid) == 3) {
		positionColor = 0x459245FF;
		strcat(positionName, "Военный");
		strcat(textColor, "4f794f");
	} else if(IsPolice(fraction(playerid))) {
		positionColor = COLOR_LIGHTBLUE;
		strcat(positionName, "Офицер полиции");
		strcat(textColor, "3398ff");
	} else if (fraction(playerid) == 2 || PlayerInfo[playerid][pFbi] >= 1) {
		positionColor = COLOR_FBI;
		strcat(positionName, "Федеральный агент");
		strcat(textColor, "858585");
	}
	else return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не сотрудник департамента");

	if(AntiCam[playerid] >= 1) AntiCam[playerid] = 0;
	format(string, sizeof(string), "%s %s: {%s}%s", positionName, playername(playerid), textColor, params[0]);
	ProxDetectorScream(30.0, playerid, string, positionColor, positionColor, positionColor, positionColor, positionColor, positionColor);
	format(string, sizeof(string), "%s", params[0]);
	SetPlayerChatBubble(playerid, string, positionColor, 30.0, 7000);
	
	return 1;
}
//----------------------------------[Local]-----------------------------------------------
CMD:b(playerid, const params[])
{
	if(CnnVed[playerid] >= 11
	|| GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж сейчас не может разговаривать");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чат внеигровой информации [ /b текст ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	format(string, sizeof(string), "(( %s[%d] пишет: %s ))", playername(playerid), playerid, params[0]);
	ProxDetectorScream(20.0, playerid, string, COLOR_FADE1, COLOR_FADE2, COLOR_FADE3, COLOR_FADE4, COLOR_FADE5, COLOR_FADE5, true);
	if(AntiCam[playerid] >= 1) AntiCam[playerid] = 0;
	return 1;
}
CMD:ab(playerid, const params[])
{
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1 || CnnVed[playerid] >= 11
	|| GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж сейчас не может разговаривать");
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сообщение над головой внеигровой информации [ /ab текст ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	format(string, sizeof(string), "%s", params[0]);
	SetPlayerChatBubble(playerid,string,COLOR_TALK_PLAYER,30.0,7000);
	format(string, sizeof(string), ">> (( %s %s ))", playername(playerid), params[0]);
	SendClientMessage(playerid, COLOR_FADE1, string);
	if(AntiCam[playerid] >= 1) AntiCam[playerid] = 0;
	return 1;
}
CMD:frames(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	new str[100],sctring[2000];
	for(new h = 0; h < sizeof(DomInfo); h++)
 	{
		new kolobj, erobj;
		for(new oba = 0; oba < MAX_OBJECT_INT; oba++)
		{
			if(DomInfo[h][dOmodel][oba] >= 1) kolobj ++;
		}
		if(DomInfo[h][dOmodel][0] <= 0) erobj = 1;
		if(erobj == 0) format(str,sizeof(str),"{cccccc}Дом № %d {999999}[Объекты: %d/%d]\n",h,kolobj,GetMaxDomObjects(h)), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Дом № %d {ff0000}[Объекты: %d/%d]\n",h,kolobj,GetMaxDomObjects(h)), strcat(sctring,str);
 	}
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Планировки Домов",sctring,"Ок","");
	return 1;
}
CMD:frame(playerid)
{
    if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
    if(OnlineInfo[playerid][oShowInterface] > 0) return ErrorMessage(playerid, "{FF6347}Закройте открытое меню");
    if(DrawFrame[playerid] == true) ExitFrame(playerid);
    else DP[0][playerid] = 0, TP[0][playerid] = 0, TP[1][playerid] = 0, LoadMenuFrame(playerid, 0);
	return 1;
}
stock ExitFrame(playerid)
{
    DelMenuFrame(playerid);
    if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;
    CancelSelectTextDraw(playerid);
    SetCameraBehindPlayer(playerid);
	HidePlayerDialog(playerid);
	if(TP[0][playerid] == 0)
	{
    	S_SetPlayerVirtualWorld(playerid, SpWorld[playerid], SpInt[playerid]), PPSetPlayerInterior(playerid, SpInt[playerid]);
  		PPSetPlayerPos(playerid, SpX[playerid], SpY[playerid], SpZ[playerid]);
		PPSetPlayerFacingAngle(playerid, SpA[playerid]);
	}
	else if(TP[0][playerid] >= 1 && TP[0][playerid] <= 2000)
	{
		new i = TP[0][playerid];
		S_SetPlayerVirtualWorld(playerid,i+1000,DomInfo[i][dInterior]);
		PPSetPlayerInterior(playerid,DomInfo[i][dInterior]);
		PPSetPlayerPos(playerid,DomInfo[i][dEnterX],DomInfo[i][dEnterY],DomInfo[i][dEnterZ]);
		PPSetPlayerFacingAngle(playerid, DomInfo[i][dEnterA]);
		TogglePlayerControllable(playerid, false);Stopeee[playerid] = 1;Stopee[playerid] = 2;
	}
	else if(TP[0][playerid] >= 3001 && TP[0][playerid] < 4000) // Бизнес
 	{
	    new b = TP[0][playerid]-3000;
		S_SetPlayerVirtualWorld(playerid, b+3000,BizzInfo[b][bInterior]), PPSetPlayerInterior(playerid,BizzInfo[b][bInterior]);
		PPSetPlayerPos(playerid,BizzInfo[b][bInteriorX],BizzInfo[b][bInteriorY],BizzInfo[b][bInteriorZ]), PPSetPlayerFacingAngle(playerid, BizzInfo[b][bInteriorA]);
	}
	else if(TP[0][playerid] >= 4000 && TP[0][playerid] < 5000) // Личный Редактор
 	{
	    new peoId = TP[0][playerid]-4000;
		S_SetPlayerVirtualWorld(playerid, peoId+4000, 90), PPSetPlayerInterior(playerid, 90);
		PPSetPlayerPos(playerid, 1387.4436,-16.2143,1000.8868), PPSetPlayerFacingAngle(playerid, 0.0);
	}
	OnlineInfo[playerid][oShowInterface] = 0;
	return 1;
}
stock LoadMenuFrame(playerid, stat)
{
    SetPVarInt(playerid,"ModelInt", 0);
	if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING && stat == 0) // Сохраняем позицию
	{
 		GetPlayerPos(playerid, SpX[playerid], SpY[playerid], SpZ[playerid]); GetPlayerFacingAngle(playerid, SpA[playerid]);
		SpInt[playerid] = GetPlayerInterior(playerid);
		SpWorld[playerid] = GetPlayerVirtualWorld(playerid);
	}
	
	LoadBuyIntDraw(playerid);
	PlayerTextDrawShow(playerid, BuyIntDraw[0][playerid]); // Стрелка ВЛЕВО
	PlayerTextDrawShow(playerid, BuyIntDraw[1][playerid]); // Стрелка ВПРАВО
	PlayerTextDrawShow(playerid, BuyIntDraw[2][playerid]); // Подложка информации
	if(PlayerInfo[playerid][pSoska] >= 10 && DP[0][playerid] == 0) PlayerTextDrawShow(playerid, BuyIntDraw[9][playerid]); // Редактировать текущий инт или добавить новый
    SelectTextDraw(playerid,0x666666AA);

	TogglePlayerControllable(playerid, true);
	S_SetPlayerVirtualWorld(playerid,playerid+1,99);
	PPSetPlayerInterior(playerid,99);
	PPSetPlayerPos(playerid, 1369.68274, -41.33120, 1000.75281);
	ShowFrame(playerid, DP[0][playerid]);
	OnlineInfo[playerid][oShowInterface] = 14;
	return 1;
}
stock DelMenuFrame(playerid)
{
	if(DrawFrame[playerid] == true)
	{
		for(new i = 0; i < 10; i ++) PlayerTextDrawHide(playerid, BuyIntDraw[i][playerid]), PlayerTextDrawDestroy(playerid, BuyIntDraw[i][playerid]);
		DrawFrame[playerid] = false;
	}
	return 1;
}
/*
// Старая перезагрузка интов в домах
CMD:reloadframe(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 22) return 1;
	new quan;
	for(new d = 1; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dOmodel][0] == 0)
		{
			setDomDefaultFrame(d);
			quan ++;
		}
