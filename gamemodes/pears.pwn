		    else if(PlayerInfo[playerid][pRusk] >= 2 && PlayerInfo[playerid][pRusk] <= 9) PlayerInfo[playerid][pRusk] ++, end = 2;
		    else if(PlayerInfo[playerid][pRusk] >= 10) PlayerInfo[playerid][pRusk] = 1, end = 3;
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Rusk`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pRusk] ,PlayerInfo[playerid][pID]);
