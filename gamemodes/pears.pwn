stock getbiz_city(b)
{
	return BizzInfo[b][bCity];
}
stock createdoor_biznes(b)
{
	new Float:X, Float:Y, Float:Z, Float:ROX, Float:ROY, Float:ROZ;
	GetDynamicObjectPos(BizzInfo[b][bBizObject][0], X,Y,Z);
	GetDynamicObjectRot(BizzInfo[b][bBizObject][0], ROX, ROY, ROZ);
	ROZ += 90.0;
	X += 0.7*floatsin(-ROZ,degrees);
 	Y += 0.7*floatcos(-ROZ,degrees);
 	GetDynamicObjectRot(BizzInfo[b][bBizObject][0], ROX, ROY, ROZ);
 	X -= 0.6*floatsin(-ROZ,degrees);
 	Y -= 0.6*floatcos(-ROZ,degrees);
	BizPickup2[b] = CreateDynamicPickup(19132, 1, X,Y,Z+0.99, 0, 0);
	BizzInfo[b][bEnterX] = X, BizzInfo[b][bEnterY] = Y, BizzInfo[b][bEnterZ] = Z+0.99;
	return 1;
}
stock admin_right(adm, sphere)
{
	if(sphere == 1) // Админ за Лидеров
	{
		if(adm == 10 || adm == 15 || adm >= 20) return 1;
	}
	else if(sphere == 2) // Админ за Экспертов
	{
		if(adm == 11 || adm == 16 || adm >= 20) return 1;
	}
	else if(sphere == 3) // Админ за Хелперов
	{
		if(adm == 12 || adm == 17 || adm >= 20) return 1;
	}
	else if(sphere == 4) // Админ за Админов
	{
		if(adm == 13 || adm >= 15) return 1;
	}
	else if(sphere == 5) // Менеджеры
	{
		if(adm == 9 || adm == 14 || adm >= 15) return 1;
	}
	return 0;
}
CMD:rrank(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Сбросить названия рангов [ /rrank ID Фракции ][ 0: Все Организации ]");
	if(params[0] < 0 || params[0] > 34) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Номер организации не меньше 1 и не больше 33 [ 0: Все Организации ]");
	new string[128];
	if(params[0] == 0)
	{
		for(new org = 1; org < MAX_ORG; org++) ReloadRank(playerid, org);
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил названия рангов всех организаций",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("rrank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Все организации");
	}
	else
	{
		ReloadRank(playerid, params[0]);
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил названия рангов %s",PlayerInfo[playerid][pName],frakName[params[0]]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("rrank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "");
	}
	return 1;
}
CMD:rsetting(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Сбросить настройки организации [ /rsetting ID Фракции ][ 0: Все Организации ]");
	if(params[0] < 0 || params[0] > 34) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Номер организации не меньше 1 и не больше 33 [ 0: Все Организации ]");
	new string[128];
	if(params[0] == 0)
	{
		for(new org = 1; org < 34; org++)
		{
			resetunitorg(org);
			SaveOrganUnitAll(org);
			SaveUnitAll(org);
		}
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил настройки всех организаций",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("rsetting", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Все организации");
	}
	else
	{
		resetunitorg(params[0]);
		SaveOrganUnitAll(params[0]);
		SaveUnitAll(params[0]);
		format(string, sizeof(string), " [ ADM ]: Админ %s сбросил настройки  %s",PlayerInfo[playerid][pName], frakName[params[0]]);
		ABroadCast(COLOR_ADM,string,1);
		AdminLog("rsetting", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], orgName[params[0]]);
	}
	return 1;
}
stock resetunitorg(g)
{
	for(new i = 0; i < sizeof(unitDefault); i++)
	{
		OrganInfo[g][gUnit][i] = unitDefault[i];
	}
	OrganInfo[g][gUnitStat][3] = 7; // Интервал вывода
	OrganInfo[g][gUnitStat][4] = 300000; // Сумма вывода

	// Настройки использования склада
 	OrganInfo[g][gUnitStat][10] = 100;
 	OrganInfo[g][gUnitStat][11] = 100;
 	OrganInfo[g][gUnitStat][12] = 100;
 	OrganInfo[g][gUnitStat][13] = 100;
 	OrganInfo[g][gUnitStat][14] = 5;
 	OrganInfo[g][gUnitStat][15] = 5;
 	OrganInfo[g][gUnitStat][16] = 5;
 	OrganInfo[g][gUnitStat][17] = 5;
 	OrganInfo[g][gUnitStat][18] = 5;
 	OrganInfo[g][gUnitStat][19] = 5;
 	OrganInfo[g][gUnitStat][20] = 5;
 	OrganInfo[g][gUnitStat][21] = 5;
 	OrganInfo[g][gUnitStat][22] = 50;
 	OrganInfo[g][gUnitStat][23] = 10;
	return 1;
}
