					{
						PlayerInfo[targetid][pDom] = 0, PlayerInfo[targetid][pSelectspawn] = 0;
					}
					if(PlayerInfo[playerid][pAData] > unix) DomInfo[dom][dPastime] = 0, DomInfo[dom][dData] = gettime()+2592000;
					else DomInfo[dom][dPastime] = PlayerInfo[playerid][pAbandoned], DomInfo[dom][dData] = unix+864000;
					DomInfo[dom][dSost] = PlayerInfo[playerid][pID];
					if(DomInfo[dom][dFam] >= 1) FamilyInfo[DomInfo[dom][dFam]][fDop5] = 0, SaveFamily(DomInfo[dom][dFam]), DomInfo[dom][dFam] = 0;
					DomInfo[dom][dSell] = 0;
					DomInfo[dom][dAcccupO] = 0, DomInfo[dom][dAcccupP] = 0, DomInfo[dom][dAcccupG] = 0, DomInfo[dom][dAcccupD] = 0, DomInfo[dom][dAccgar] = 0, DomInfo[dom][dAccdoo] = 0, DomInfo[dom][dAccfur] = 0;
					DomInfo[dom][dAccint] = 0, DomInfo[dom][dFamcar] = 0;
					if(DomInfo[dom][dDescrip] == 2) DomInfo[dom][dDescrip] = 0;
					if(DomInfo[dom][dIngar] >= 1) DomInfo[dom][dIngar] = 0, DestroyDynamicPickup(DomGarage[dom]), DestroyDynamic3DTextLabel(IngarLabel[dom]);
					strmid(DomInfo[dom][dVlad], PlayerInfo[playerid][pName], 0, strlen(PlayerInfo[playerid][pName]));
					SaveDom(dom);
					UpdateDom(dom);
					HouseLog(0, "selldom", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], dom, ServerInfo[46], "Сделка: Продал Дом");
					HouseLog(0, "buydom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], dom, ServerInfo[46], "Сделка: Купил Дом");
					format(str,sizeof(str),"{cccccc}Дом: {ff9000}№ %d\n", dom), strcat(sctring,str);
					mysql_save(playerid, 6), mysql_save(targetid, 6);
					if(PlayerInfo[playerid][pAchieve][10] == 0) AchievePlayer(playerid, 10, 1);
				}
				if(PlayerInfo[playerid][pTslot][s] == 7)
				{
					/*new rum = PlayerInfo[playerid][pTmodel][s], Days = getdate();
					PlayerInfo[targetid][pRoom] = PlayerInfo[playerid][pTmodel][s];
					PlayerInfo[targetid][pSelectspawn] = 5;
