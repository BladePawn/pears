    PlayerPlaySound(playerid,1150,0,0,0);
	return 1;
}
CMD:damage(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть дамаг по игроку [ /damage ID ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
    new str[70],sctring[13800], qwer[60], shotid, tyear, tmonth, tday, thour, tminute, tsecond, atext[24];
    format(str,sizeof(str),"Нападающий\tОружие\tВремя\tПовреждение"), strcat(sctring,str);
    for(new d = 0; d < 200; d++)
	{
	    if(DamageStat[d][params[0]] == 0) format(str,sizeof(str),"\n{cccccc}- \t "), strcat(sctring,str);
	    else
		{
		    shotid = DamageLog[d][params[0]];
	        stamp2datetime(DamageUnix[d][params[0]], tyear, tmonth, tday, thour, tminute, tsecond, 3);
	        
	        if(DamageType[d][params[0]] == 1) atext = "Персонаж";
	        else if(DamageType[d][params[0]] == 2) atext = "Транспорт";
	        
		    if(IsOnline(shotid)) format(str,sizeof(str),"\n%s[%d]\t%s\t%02d:%02d:%02d\t%s", PlayerInfo[shotid][pName], shotid, gunName[DamageWeapon[d][params[0]]], thour, tminute, tsecond, atext), strcat(sctring,str);
		    else format(str,sizeof(str),"\nOffline [Acc № %d]\t%s\t%02d:%02d:%02d\t%s",DamageStat[d][params[0]], gunName[DamageWeapon[d][params[0]]], thour, tminute, tsecond, atext), strcat(sctring,str);
	    }
    }
    format(qwer,sizeof(qwer),"{cccccc}Дамаг по {ff9000}%s [%d]",PlayerInfo[params[0]][pName], params[0]);
    ShowDialog(playerid,1742,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Выбор","Отмена");
	return 1;
}
function Call_bl(playerid, g)
{
	new rows, datad1[24], datad4, str[64],sctring[4096], tyear, tmonth, tday, thour, tminute, tsecond, quan;
	cache_get_row_count(rows);
	format(str,sizeof(str),"{cccccc}Черный список: %s \t \n", frakName[g]), strcat(sctring,str);
	format(str,sizeof(str),"{FF6347}Занести в черный список \t \n"), strcat(sctring,str);
	format(str,sizeof(str),"{99ff66}Вынести из черного списка \t \n"), strcat(sctring,str);
	for(new i = 0; i < rows; i++)
	{
	    cache_get_value_name_int(i, "playerid", List[quan][playerid]);
	    quan ++;
	    cache_get_value_name(i, "player", datad1, 24);
	    cache_get_value_name_int(i, "term", datad4);
		stamp2datetime(datad4, tyear, tmonth, tday, thour, tminute, tsecond, 3);

		format(str, sizeof(str), "%s \t До %02d.%02d.%d \n", datad1, tday, tmonth, tyear), strcat(sctring,str);
	}
	ShowDialog(playerid,1210,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Черный Список",sctring,"Выбрать","Выход");
	return 1;
}
CMD:blacklist(playerid)
{
    stop_dialog(playerid);
    new g = fraction(playerid);
	new gw = g;
	if(BL[playerid] > 0) g = BL[playerid];
    if(g == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
    if(g == 34)
	{
		if(!GetAccessRankOrg(playerid, gw, 41, PlayerInfo[playerid][pFbi]) && PlayerInfo[playerid][pSoska] == 0) return 1;
	}
	else if(g != 28 && g != 30)
	{
    	if(!GetAccessRankOrg(playerid, gw, 23, NO_FBI)) return 1;
	}
	DP[0][playerid] = g;
	ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Сообщения","{cccccc}Загрузка черного списка...","*","");
	new string[101];
	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `blacklist` WHERE `org` = '%d' AND `term` > '%d' ORDER BY `term` LIMIT 70", g, gettime());
	mysql_tquery(pearsq, string, "Call_bl", "dd", playerid, g);
	return 1;
}
CMD:inbl(playerid, const params[])
{
    new g = fraction(playerid);
	new gw = g;
	if(BL[playerid] > 0) g = BL[playerid];
    if(g == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
    if(g == 28)
    {
    	if(!GetAccessRankOrg(playerid, gw, 23, NO_FBI)) return 1;
	}
	else if(g == 34)
	{
	    if(!GetAccessRankOrg(playerid, gw, 41, PlayerInfo[playerid][pFbi]) && PlayerInfo[playerid][pSoska] == 0) return 1;
	}
	else if(g != 28 && g != 30)
	{
    	if(!GetAccessRankOrg(playerid, gw, 23, NO_FBI)) return 1;
	}
    new tmp[24], term, bailed, reason[64];
    if(sscanf(params, "s[24]iis[64]", tmp, term, bailed, reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Занести в черный список [ /inbl ID Срок Залог Причина ]");
    if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(term < 1 || term > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Срок не меньше 1 дня и не больше 1000 дней"), PlayerPlaySound(playerid,4203,0,0,0);
    if(bailed < 0 || bailed > 100000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Залог не меньше 0 и не больше 100кк [ 0 - досрочный выход невозможен ]"), PlayerPlaySound(playerid,4203,0,0,0);
    new para = ReturnUser(tmp, 1);

	new string_mysql[120];
    if(IsOnline(para))
    {
		if(IsARealNPC(para)) return ErrorMessage(playerid, "{FF6347}Это NPC");
	  	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", PlayerInfo[para][pID], g);
      	mysql_tquery(pearsq, string_mysql, "in_blacklist", "dsdddsdd", playerid, PlayerInfo[para][pName], para, term, bailed, reason, g, 1);
    }
    else
    {
        if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
        mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string_mysql, "get_inblacklist", "dsdddsdd", playerid, tmp, para, term, bailed, reason, g, 0);
    }
	return 1;
}
stock info_bl(playerid, g, const tmp[], stat)
{
    new datad1[24], datad2[24], datad3[24], datad4, datad5, string[256];
    cache_get_value_name(0, "player", datad1, 24);
    cache_get_value_name(0, "reason", datad2, 24);
    cache_get_value_name(0, "sender", datad3, 24);
    cache_get_value_name_int(0, "term", datad4);
    cache_get_value_name_int(0, "bailed", datad5);
    new tyear, tmonth, tday, thour, tminute, tsecond;
	stamp2datetime(datad4, tyear, tmonth, tday, thour, tminute, tsecond, 3);
	if(stat == 0) format(string,sizeof(string),"{FF6347}%s в черном списке %s под именем: %s\n\nЗанес: %s | Залог: %d$\nПричина: %s\n{cccccc}До: %02d.%02d.%d %02d:%02d", tmp, frakeasyName[g], datad1, datad3, datad5 ,datad2, tday, tmonth, tyear, thour, tminute), ErrorMessage(playerid, string);
	else
	{
		format(string,sizeof(string),"{FF6347}%s | Черный список %s\n\nЗанес: %s | Залог: %d$\nПричина: %s\n{cccccc}До: %02d.%02d.%d %02d:%02d", datad1, frakeasyName[g], datad3, datad5 ,datad2, tday, tmonth, tyear, thour, tminute);
		ShowDialog(playerid,1213,DIALOG_STYLE_MSGBOX,"{ffcc00}*",string,"Ок","");
	}
	return 1;
}
function get_inblacklist(playerid, const tmp[], para, term, bailed, const reason[], g, stat)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new plaid;
	    cache_get_value_name_int(0, "user_id", plaid);

		new string_mysql[120];
	    mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", plaid, g);
      	mysql_tquery(pearsq, string_mysql, "in_blacklist", "dsdddsdd", playerid, tmp, plaid, term, bailed, reason, g, stat);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
function in_blacklist(playerid, const tmp[], para, term, bailed, const reason[], g, stat)
{
    new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		if(playerid >= 0) info_bl(playerid, g, tmp, 0);
	}
	else
	{
	    new plaid, plaip[24], unix = gettime(), query[512], name[24], admid, admip[24],type = 0;
	    if(playerid >= 0) {
			format(name, sizeof(name),"%s",PlayerInfo[playerid][pName]), admid = PlayerInfo[playerid][pID], format(admip, sizeof(admip),"%s", PlayerInfo[playerid][pPlaIP]);
			if(PlayerInfo[playerid][pSoska] > 10) type = 1;
		}
		else if(playerid == -1) format(name, sizeof(name),"Сервер"), admid = 0, format(admip, sizeof(admip),"");
	    
	    if(stat == 1)
		{
			plaid = PlayerInfo[para][pID], format(plaip, sizeof(plaip), PlayerInfo[para][pPlaIP]);
			if(OnlineInfo[para][oLogged] == 1)
			{
				format(query, sizeof(query),"{FF6347}[ %s ]: поместил вас в черный список %s {FF6347}на %d дней | {ffcc66}Причина: %s\n",name, frakName[g], term, reason);
   				SendClientMessage(para, COLOR_GREY, query);
   				if(playerid >= 0) format(query, sizeof(query),"\n{FF6347}%s поместил вас в черный список %s {FF6347}на %d дней\n\n{ffcc66}Причина: %s\n", name, frakName[g], term, reason), ShowDialog(para,1012,DIALOG_STYLE_MSGBOX,"{ff0000}*", query,"*","");
		    	PlayerPlaySound(para, 31202, 0,0,0);
		    	if(PlayerInfo[para][pDrawVisible][2] == false) PlayerTextDrawShow(para, PlayerSiteDraw[2][para]);
			}
		}
	    else plaid = para, format(plaip, sizeof(plaip), "");
	    if(playerid >= 0)
	    {
		    PlayerPlaySound(playerid, 6401, 0,0,0);
		    SendClientMessage(playerid, COLOR_GREY,"{ffcc66}Вы занесли {FF6347}%s {ffcc66}в черный список %s {ffcc66}на %d дней | {FF6347}Причина: %s",tmp,frakName[g],term,reason);
		    format(query, sizeof(query),"\n{cccccc}Вы занесли %s в черный список %s {cccccc}на %d дней\n{FF6347}Залог: %d$\nПричина: %s",tmp,frakName[g],term,bailed,reason);
			ShowDialog(playerid,1012,DIALOG_STYLE_MSGBOX, "{ff0000}*", query, "Ок", "");
		}
        mysql_format(pearsq, query, sizeof(query), "INSERT INTO `blacklist` (`org`, `playerid`, `player`, `playerip`, `unix`, `term`, `reason`, `bailed`, `senderid`, `sender`, `senderip`, `type`) VALUES ( '%d', '%d', '%e', '%e', '%d', '%d', '%e', '%d', '%d', '%e', '%e', '%d' )",
    	g, plaid, tmp, plaip, unix, unix+(86400*term), reason, bailed, admid, name, admip,type);
    	mysql_tquery(pearsq, query, "", "");
    	
    	format(query, sizeof(query), "Вы занесены в чёрный список %s на %d дней. Причина: %s", frakeasyName[g], term, reason);
		notify(admid, name, plaid, tmp, query);
		
		if(g == 28) format(query, sizeof(query), "ЧС %s | Причина: %s", frakeasyName[g], reason), OrgLog(3, "inbl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], plaid, tmp, plaip, term, query);
		else if(g == 30) format(query, sizeof(query), "ЧС %s | Причина: %s", frakeasyName[g], reason), AdminLog("inbl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], plaid, tmp, plaip, term, query);
		else format(query, sizeof(query), "ЧС %s | Причина: %s", frakeasyName[g], reason), OrgLog(g, "inbl", admid, name, admip, plaid, tmp, plaip, term, query);
	}
	return 1;
}
CMD:outbl(playerid, const params[])
{
    new g = fraction(playerid);
	new gw = g;
	if(BL[playerid] > 0) g = BL[playerid];
    if(g == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(g == 28)
    {
    	if(!GetAccessRankOrg(playerid, gw, 24, NO_FBI)) return 1;
	}
	else if(g == 34)
	{
		if(!GetAccessRankOrg(playerid, gw, 42, PlayerInfo[playerid][pFbi]) && PlayerInfo[playerid][pSoska] == 0) return 1;
	}
	else if(g != 28 && g != 30)
	{
    	if(!GetAccessRankOrg(playerid, gw, 24, NO_FBI)) return 1;
	}
    new tmp[24];
    if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Вынести из чёрного списка [ /outbl ID ]");
    new para = ReturnUser(tmp, 1);

	new string_mysql[120];
    if(IsOnline(para))
    {
	  	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", PlayerInfo[para][pID], g);
      	mysql_tquery(pearsq, string_mysql, "out_blacklist", "dsddd", playerid, PlayerInfo[para][pName], para, g, 1);
    }
    else
    {
        if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
        mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string_mysql, "get_outblacklist", "dsddd", playerid, tmp, para, g, 0);
    }
	return 1;
}
function get_outblacklist(playerid, const tmp[], para, g, stat)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new plaid;
	    cache_get_value_name_int(0, "user_id", plaid);

		new string_mysql[120];
	    mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", plaid, g);
      	mysql_tquery(pearsq, string_mysql, "out_blacklist", "dsddd", playerid, tmp, plaid, g, stat);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
function out_blacklist(playerid, const tmp[], para, g, stat)
{
    new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new plaid, plaip[24], string[200],type;
		cache_get_value_name_int(0, "type", type);
		if(type && PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid,"{ff6347}Выносить данного человека из ЧС может только администрация");
	    if(stat == 1)
		{
		    plaid = PlayerInfo[para][pID], format(plaip, 24, PlayerInfo[para][pPlaIP]);
		    if(OnlineInfo[para][oLogged] == 1)
			{
	    		if(OnlineInfo[para][oListenRadioPears] == 0) StopAudioStreamForPlayer(para), PlayAudioStreamForPlayer(para, "https://cdn.pears.fun/sound/hallelujah.mp3");
	    		format(string, sizeof(string),"{99ff66}[ %s ]: {cccccc}вынес вас из черного списка %s",PlayerInfo[playerid][pName], frakName[g]);
   				SendClientMessage(para, COLOR_GREY, string);
   				format(string, sizeof(string),"{99ff66}%s {cccccc}вынес вас из черного списка %s", PlayerInfo[playerid][pName], frakName[g]);
		    	ShowDialog(para,1012,DIALOG_STYLE_MSGBOX,"{ff0000}*", string,"*","");
		    	if(PlayerInfo[para][pDrawVisible][2] == false) PlayerTextDrawShow(para, PlayerSiteDraw[2][para]);
 			}
		}
		else plaid = para, format(plaip, 24, "");
		PlayerPlaySound(playerid, 6401, 0,0,0);
	    SendClientMessage(playerid, COLOR_GREY,"{ffcc66}Вы вынесли {99ff66}%s {ffcc66}из черного списка %s",tmp,frakName[g]);
	    format(string, sizeof(string),"{cccccc}Вы вынесли %s из черного списка %s",tmp,frakName[g]);
		ShowDialog(playerid,1012,DIALOG_STYLE_MSGBOX, "{ff0000}*", string, "Ок", "");
	    mysql_format(pearsq, string,sizeof(string),"DELETE FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", plaid, g);
		query_empty(pearsq, string);
	    
	    format(string, sizeof(string), "Вас вынесли из черного списка %s", frakeasyName[g]);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], plaid, tmp, string);
	
	    if(g == 28) format(string, sizeof(string), "Вынес из чс %s", frakeasyName[g]), OrgLog(3, "outbl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], plaid, tmp, plaip, 0, string);
		else if(g == 30) format(string, sizeof(string), "Вынес из чс %s", frakeasyName[g]), AdminLog("outbl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], plaid, tmp, plaip, 0, string);
		else format(string, sizeof(string), "Вынес из чс %s", frakeasyName[g]), OrgLog(g, "outbl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], plaid, tmp, plaip, 0, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:admduty(playerid)
{
   	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    if(ADUTY[playerid] == 0)
    {
 		SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Pears ]: {ffcc66}ADM Дежурство {99ff66}[ ON ]");
   		PlayerPlaySound(playerid, 1052, 0,0,0);
   		ADUTY[playerid] = 1;
   		SetPVarInt(playerid,"Readkill",1);
   		if(PlayerInfo[playerid][pSoska] >= 2)SetPlayerColor(playerid,COLOR_ADMIN);
   		else if(PlayerInfo[playerid][pSoska] == 1)SetPlayerColor(playerid, COLOR_HELPER);
        foreach(Player,i)
		{
			if(NameTag[i] == true) ShowPlayerNameTagForPlayer(playerid, i, true);
		}
    }
    else if (ADUTY[playerid] == 1)
    {
        SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Pears ]: {ffcc66}ADM Дежурство {FF6347}[ OFF ]");
 		SetPlayerColor(playerid,INV_COLOR);
 		ADUTY[playerid] = 0;
 		SetPVarInt(playerid,"Readkill",0);
 		foreach(Player,i)
		{
			if(NameTag[i] == true) ShowPlayerNameTagForPlayer(playerid, i, false);
		}
    }
	AdminAks(playerid);
	return 1;
}
CMD:start(playerid, const params[]) return ShowDialog(playerid, 368, DIALOG_STYLE_LIST, "{ff9000}Обратный отсчёт", "{FFFFFF}Отсчёт от 5\n{FFFFFF}Отсчёт от 15", "Выбрать", "Отмена");
CMD:gps(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	PlayerPlaySound(playerid,1150,0,0,0);
	ShowDialog(playerid, 10, DIALOG_STYLE_LIST, "{ff9000}GPS Навигатор", "{99ff66}Работа\n{ff9000}Аренда Скутеров\n{ff9000}Электрозарядная станция\n{ff9000}Заправки\n{ff9000}Автосервисы\n{ff9000}Парковки\n{ff9000}Образовательный Центр\n{cccccc}Транспорт\n{cccccc}Услуги\n{cccccc}Организации\n{cccccc}Прочее\n{cccccc}Развлечения\n{cccccc}Недвижимость\n{cccccc}Бизнесы\n{ff6347}Отключить Метку", "Выбрать", "Выход");
	return 1;
}
CMD:safe(playerid)
{
	new str[100],sctring[400];
	format(str,sizeof(str),"{ff9000}Сменить Пароль\n"), strcat(sctring,str);
	if(strcmp(PlayerInfo[playerid][pMail],"\0",true))
	{
		if(PlayerInfo[playerid][pMailStat] > 0) format(str,sizeof(str),"{cccccc}Email {FF6347}Не подтверждён [ %s ]\n", PlayerInfo[playerid][pMail]), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Email {99ff66}[ %s ]\n", PlayerInfo[playerid][pMail]), strcat(sctring,str);
	}
	else if(!strcmp(PlayerInfo[playerid][pMail],"\0",true)) format(str,sizeof(str),"{cccccc}Email {FF6347}[ Не Установлен ]\n"), strcat(sctring,str);
	if(PlayerInfo[playerid][pGoogle] >= 1)format(str,sizeof(str),"{cccccc}Google Authenticator {99ff66}[ Установлен ]\n"), strcat(sctring,str);
	else format(str,sizeof(str),"{cccccc}Google Authenticator {FF6347}[ Не Установлен ]\n"), strcat(sctring,str);
	if(PlayerInfo[playerid][pBdPoletDayz] == 0) format(str,sizeof(str),"{cccccc}Автологин {99ff66}[ On ]\n"), strcat(sctring,str);
	else if(PlayerInfo[playerid][pBdPoletDayz] == 1) format(str,sizeof(str),"{cccccc}Автологин {FF6347}[ Off ]\n"), strcat(sctring,str);
	if(PlayerInfo[playerid][pTypoihyi] == 0) format(str,sizeof(str),"{cccccc}Окно Пароля {444444}[ Скрытое ]\n"), strcat(sctring,str);
	else format(str,sizeof(str),"{cccccc}Окно Пароля {ffffff}[ Открытое ]\n"), strcat(sctring,str);

	format(str,sizeof(str),"{cccccc}Привязать Форум {ff9000}>>\n"), strcat(sctring,str);
	ShowDialog(playerid,244,DIALOG_STYLE_TABLIST,"{ff9000}Аккаунт",sctring,"Выбрать", "Отмена");
	return 1;
}
