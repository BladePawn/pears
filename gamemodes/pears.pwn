		{
			TextDrawShowForPlayer(playerid, Chernifon);
			ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","\n{FF6347}Игрок с таким именем уже авторизовался\n{cccccc}Чтобы выйти из игры введите в чат команду {FF6347}/q или ESC >> Выход\n","Ок","");
			Kickx(playerid);
			return 1;
		}
		new n_string[30];
		format(n_string, 30, "player%d", playerid);
		SetPlayerName(playerid, n_string);
			// Сбрасываем скин
		PlayerInfo[playerid][pModel] = 5;
		m_custom_sync_SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);

		if(!CheckRP_Nickname(PlayerInfo[playerid][pName]))
		{
			PlayerPlaySound(playerid,40405,0,0,0);
			new str[100],sctring[500];
			format(str,sizeof(str),"{FFFFFF}*{FF6000}К сожалению ваш {FF0000}никнейм не подошёл {FF6000}под правила нашего сервера.\n");
			strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}*{FFFFFF}Ник должен состоять из английских {0088ff}Имени {FFFFFF}и {0088ff}Фамилии \n");
			strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}Примеры: {FFFFFF}Ivan_Ivanov   John_Sanders   Ken_Block\n");
			strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}*{FFFFFF}Выйдите,смените свой ник в окне клиента SA:MP и заходите снова.\n\n");
			strcat(sctring,str);
			format(str,sizeof(str),"{FFFFFF}Приятной игры...\n");
			strcat(sctring,str);
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}Никнейм не подходит",sctring,"*","");
			SendClientMessage(playerid, COLOR_LIGHTRED, "{FFFFFF}*{FF6000}К сожалению ваш никнейм не подошёл под правила нашего сервера.");
