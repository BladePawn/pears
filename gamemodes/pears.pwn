			strmid(DomInfo[kolmon][dVlad], str_name, 0, strlen(str_name));
			SaveDom(kolmon);
			UpdateDom(kolmon);
			AdminLog("givedom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", kolmon, "Выдал Дом");
