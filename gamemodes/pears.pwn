					return 1;
				}
				mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `pp_cars` WHERE `sost` = '%d' AND `slot` = '%d'", PlayerInfo[playerid][pKeyVeh][1], PlayerInfo[playerid][pKeyVeh][2]);
