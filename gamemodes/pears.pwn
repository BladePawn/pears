  		mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "call_relpallcapt", "ds", playerid, tmp);
	}
	return 1;
}
function call_giveunit(playerid, str_name[], kolvo)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[144];
	    new datad1, datadid;
		cache_get_value_name_int(0, "Unit", datad1);
		cache_get_value_name_int(0, "user_id", datadid);
		format(string, sizeof(string), "   %s получил от меня %d юнитов", str_name,kolvo), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s выдал %d юнитов %s", PlayerInfo[playerid][pName],kolvo,str_name);
		ABroadCast(COLOR_ADM,string,2);
		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Unit` = '%d' WHERE `Name` = '%e'",datad1+kolvo, str_name);
		query_empty(pearsq, string);
		AdminLog("giveunit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", kolvo, "");
		format(string, sizeof(string), "Вам выдано %d юнитов", kolvo);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:givecontinental(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    new tmp[24], kolvo, giveplayerid, string[144];
	if(sscanf(params, "s[24]i", tmp, kolvo)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать монеты Континенталь [ /givecontinental ID Количество ]");
	if(kolvo < 1 || kolvo > 10000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество монет не меньше 1 и не больше 10000");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		format(string, sizeof(string), "   %s[%d] получил от меня %d монет Континенталь", PlayerInfo[giveplayerid][pName],giveplayerid,kolvo), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), "   %s[%d] выдал мне %d монет Континенталь",PlayerInfo[playerid][pName], playerid,kolvo), SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s выдал %d монет Континенталь %s[%d]", PlayerInfo[playerid][pName],kolvo,PlayerInfo[giveplayerid][pName],giveplayerid);
		ABroadCast(COLOR_ADM,string,2);
		GivePlayerContinentalCoins(giveplayerid, kolvo);
		AdminLog("givecontinental", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolvo, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT i.user_id, uc.* FROM pp_igroki i LEFT JOIN pp_user_continental uc ON i.user_id = uc.userid WHERE i.Name = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_givecontinental", "dsd", playerid, tmp, kolvo);
	}
	return 1;
}
CMD:giveunit(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    new tmp[24], kolvo, giveplayerid, string[144];
	if(sscanf(params, "s[24]i", tmp, kolvo)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать юниты [ /giveunit ID Количество ]");
	if(kolvo < 1 || kolvo > 1000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество юнитов не меньше 1 и не больше 1000000");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		format(string, sizeof(string), "   %s[%d] получил от меня %d юнитов", PlayerInfo[giveplayerid][pName],giveplayerid,kolvo), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), "   %s[%d] выдал мне %d юнитов",PlayerInfo[playerid][pName], playerid,kolvo), SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s выдал %d юнитов %s[%d]", PlayerInfo[playerid][pName],kolvo,PlayerInfo[giveplayerid][pName],giveplayerid);
		ABroadCast(COLOR_ADM,string,2);
		GivePlayerUnit(giveplayerid, kolvo);
		AdminLog("giveunit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolvo, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Unit FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "call_giveunit", "dsd", playerid, tmp, kolvo);
	}
	return 1;
}

stock showDialogErrorPayUnit(playerid, playerUnit, g)
{
	new string[256], glave_str[MAX_BIGINT_LEN];
	bigint_get_str(OrganInfo[g][glave], glave_str);
	format(string, sizeof(string), "{FF6347}На счету организации недостаточно средств\
									\n{ffcc66}На счету игрока: %dU\
									\n{ffcc66}На счету организации: %s$\
									\n\n{cccccc}При выдаче юнитов учитываются юниты на счету игрока"
									,playerUnit, glave_str);
	ErrorMessage(playerid, string);
	return true;
}

function Call_payunit(playerid, str_name[], kolvo, g)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[144];
	    new datad1, datadid, member, leader;
		cache_get_value_name_int(0, "Unit", datad1);
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Member", member);
		cache_get_value_name_int(0, "Leader", leader);
		
		if(OrganInfo[g][glave] < datad1 + kolvo) return showDialogErrorPayUnit(playerid, datad1, g);
		if(g != member) return ErrorMessage(playerid, "{FF6347}Это не участник вашей организации");
		if(leader > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете начислить юниты лидеру");

		SendClientMessage(playerid, COLOR_LIGHTBLUE, "** Вы передали %s %dU **", str_name, kolvo);
		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Unit` = '%d' WHERE `user_id` = '%d'",datad1+kolvo, datadid);
		query_empty(pearsq, string);
		OrgLog(PlayerInfo[playerid][pLeader], "payunit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", kolvo, "Передал юниты");

		format(string, sizeof(string), "Вам выдано %d юнитов", kolvo);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:payunit(playerid, const params[])
{
	new g = fraction(playerid);
	if(PlayerInfo[playerid][pLeader] == 0 && !IsSubLeader(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
    new tmp[24], kolvo, giveplayerid, string[160];
	if(sscanf(params, "s[24]i", tmp, kolvo)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Передать юниты [ /payunit ID Количество ]");
	if(kolvo < 1 || kolvo > 1000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество юнитов не меньше 1 и не больше 1000000");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		if(giveplayerid == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете начислить юниты самому себе");
		if(g != PlayerInfo[giveplayerid][pMember]) return ErrorMessage(playerid, "{FF6347}Это не участник вашей организации");
		if(PlayerInfo[giveplayerid][pLeader] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете начислить юниты лидеру");
		if(OrganInfo[g][glave] < PlayerInfo[giveplayerid][pUnit] + kolvo) return showDialogErrorPayUnit(playerid, PlayerInfo[giveplayerid][pUnit], g);
		SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, "** %s передал вам %dU **", PlayerInfo[playerid][pName], kolvo);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, "** Вы передали %s %dU **", PlayerInfo[giveplayerid][pName], kolvo);
		GivePlayerUnit(giveplayerid, kolvo);
		OrgLog(g, "payunit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolvo, "Передал юниты");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Member, Leader, Unit FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_payunit", "dsdd", playerid, tmp, kolvo, g);
	}
	return 1;
}

CMD:paycontinental(playerid, const params[])
{
	new g = fraction(playerid);
	if (PlayerInfo[playerid][pLeader] == 0 && !IsSubLeader(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if (!IsAMafiaID(g)) return ErrorMessage(playerid, "{FF6347}Вы не являетесь участником мафии");

	new tmp[24], amount, giveplayerid;
	if (sscanf(params, "s[24]i", tmp, amount)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Передать монеты Континенталь [ /paycontinental ID Количество ]");
	if (amount < 1 || amount > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество монет не меньше 1 и не больше 1000");
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
    {
		if(giveplayerid == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете начислить монеты самому себе");
		if(g != PlayerInfo[giveplayerid][pMember]) return ErrorMessage(playerid, "{FF6347}Это не участник вашей организации");
		if(PlayerInfo[giveplayerid][pLeader] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете начислить монеты лидеру");

		SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, "** %s передал вам %d монет Континенталь **", PlayerInfo[playerid][pName], amount);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, "** Вы передали %s %d монет Континенталь **", PlayerInfo[giveplayerid][pName], amount);

		GivePlayerContinentalCoins(giveplayerid, amount);
		OrgLog(g, "paycontinental", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Передал монеты");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		new string[256];
		mysql_format(pearsq, string, sizeof(string), "SELECT i.user_id, i.Member, i.Leader, uc.* FROM pp_igroki i LEFT JOIN pp_user_continental uc ON i.user_id = uc.userid WHERE i.Name = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_paycontinental", "dsdd", playerid, tmp, amount, g);
	}

	return 1;
}

CMD:takecontinental(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    new tmp[24], kolvo, giveplayerid, string[144];
	if(sscanf(params, "s[24]i", tmp, kolvo)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Забрать монеты Континенталь [ /takecontinental ID Количество ]");
	if(kolvo < 1 || kolvo > 100000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество монет не меньше 1 и не больше 100000");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		if (!TakePlayerContinentalCoins(giveplayerid, kolvo)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет такого количества монет (Доступно: %d)", GetPlayerContinentalCoins(giveplayerid));
		format(string, sizeof(string), "   Я забираю у %s[%d] %d монет Континенталь", PlayerInfo[giveplayerid][pName],giveplayerid,kolvo), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), "   %s[%d] забрал у меня {FF6347}%d монет Континенталь",PlayerInfo[playerid][pName], playerid,kolvo), SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s забрал %d монет Континенталь у %s[%d]", PlayerInfo[playerid][pName],kolvo,PlayerInfo[giveplayerid][pName],giveplayerid);
		ABroadCast(COLOR_ADM,string,2);
		AdminLog("takecontinental", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolvo, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT i.user_id, uc.* FROM pp_igroki i LEFT JOIN pp_user_continental uc ON i.user_id = uc.userid WHERE i.Name = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_takecontinental", "dsd", playerid, tmp, kolvo);
	}

	return 1;
}

function call_takeunit(playerid, str_name[], kolvo)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datad1, datadid, string[144];
		cache_get_value_name_int(0, "Unit", datad1);
		cache_get_value_name_int(0, "user_id", datadid);
		if(datad1 < kolvo) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет такого количества юнитов");
		format(string, sizeof(string), "   Я забираю у %s %d юнитов", str_name,kolvo), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s забрал %d юнитов у %s", PlayerInfo[playerid][pName],kolvo,str_name);
		ABroadCast(COLOR_ADM,string,2);
		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Unit` = '%d' WHERE `Name` = '%e'",datad1-kolvo, str_name);
		query_empty(pearsq, string);
		AdminLog("takeunit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", kolvo, "");
		format(string, sizeof(string), "У вас отняли %d юнитов", kolvo);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:takeunit(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    new tmp[24], kolvo, giveplayerid, string[144];
	if(sscanf(params, "s[24]i", tmp, kolvo)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Забрать юниты [ /takeunit ID Количество ]");
	if(kolvo < 1 || kolvo > 1000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество юнитов не меньше 1 и не больше 1000000");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
        if(PlayerInfo[giveplayerid][pUnit] < kolvo) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет такого количества юнитов");
		format(string, sizeof(string), "   Я забираю у %s[%d] %d юнитов", PlayerInfo[giveplayerid][pName],giveplayerid,kolvo), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), "   %s[%d] забрал у меня {FF6347}%d юнитов",PlayerInfo[playerid][pName], playerid,kolvo), SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s забрал %d юнитов у %s[%d]", PlayerInfo[playerid][pName],kolvo,PlayerInfo[giveplayerid][pName],giveplayerid);
		ABroadCast(COLOR_ADM,string,2);
		PlayerInfo[giveplayerid][pUnit] -= kolvo;
		AdminLog("takeunit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolvo, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Unit FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "call_takeunit", "dsd", playerid, tmp, kolvo);
	}
	return 1;
}
CMD:pay(playerid, const params[])
{
	if(PlayerInfo[playerid][pConnectTime] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу передавать деньги, так как играл менее одного часа");
	if(GetPVarInt(playerid,"antiflood") > 0 && PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм... не могу найти деньги в кошельке [ Подождите %d сек. ]", GetPVarInt(playerid,"antiflood"));
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
    if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
    new tmp[124], money, giveplayerid, string[144];
    if(sscanf(params, "s[124]i", tmp, money)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Передать деньги [ /pay ID сумма ]");
    if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	if(PlayerInfo[playerid][pConnectTime] < 3 && money > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу передавать больше 1000$ [ Отыграл меньше 3 часов ]");
	if(PlayerInfo[playerid][pSoska] >= 2 || PlayerInfo[playerid][pMedia] >= 2)
	{
    	if(money < 1 || money > 10000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1$ и не больше 10.000.000$");
	}
	else if(GetPlayerVip(playerid)) 
	{
		if(money < 1 || money > 500000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1$ и не больше 500.000$");
	}
	else 
	{
    	if(money < 1 || money > 10000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1$ и не больше 10.000$");
	}
    if(money > 0 && PlayerInfo[playerid][pMoney] >= money)
	{
		if(PlayerInfo[playerid][pSoska] > 0) giveplayerid = ReturnUser(tmp, 1);
		else giveplayerid = ReturnUser(tmp);
	    if(IsOnline(giveplayerid))
	    {
	    	if(giveplayerid == playerid && PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу передавать деньги себе");
			if(GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
			if(IsARealNPC(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Это NPC");
			if(!ProxDetectorS(3.0, playerid, giveplayerid) && PlayerInfo[playerid][pSoska] <= 7) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
			if(!IsPlayerInAnyVehicle(playerid))
			{
				ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false, SYNC_ALL), TurnPlayerFaceToPlayer(playerid, giveplayerid);
				Eat[playerid] = 1; EatTime[playerid] = 4;
   				RemovePlayerAttachedObject(playerid,1);
   				SetPlayerAttachedObject(playerid, 1, 1212, 6, 0.109999, 0.060999, 0.000000, 0.000000, -85.199966, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
			}
			oGivePlayerMoney(playerid, -money);
			oGivePlayerMoney(giveplayerid, money);
			if(GetPlayerVip(playerid)) SetPVarInt(playerid,"antiflood",2);
			else SetPVarInt(playerid,"antiflood",5);
			format(string, sizeof(string), "   Вы передали %s, {99ff66}%d$", playername(giveplayerid), money);
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			SendClientMessage(playerid, COLOR_GRAD1, string);
			format(string, sizeof(string), "   Вы получили %d$ от %s", money, playername(playerid));
			SendClientMessage(giveplayerid, COLOR_GRAD1, string);
			PlayerPlaySound(giveplayerid, 1052, 0.0, 0.0, 0.0);
			if(ProxDetectorS(5.0, playerid, giveplayerid))
			{
				format(string, sizeof(string), "* %s передаёт немного наличных %s.", playername(playerid) ,playername(giveplayerid));
				ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
			}
			MoneyLog("pay", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], -money, "Передал Деньги");
			MoneyLog("pay", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], money, "Получил Деньги");
		}
		else
		{
			if(PlayerInfo[playerid][pSoska] < 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			if(!strcmp(PlayerInfo[playerid][pName],tmp,true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу передавать деньги себе");
  			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  			mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,21,money);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет столько денег");
	return 1;
}
CMD:medlift(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1381.3992,-15.8750,1000.9217) && GetPlayerInterior(playerid) == 5 && GetPlayerVirtualWorld(playerid) == 5
 	|| IsPlayerInRangeOfPoint(playerid,2.0,1147.6481,-1317.7469,13.6494)
 	|| IsPlayerInRangeOfPoint(playerid,2.0,1161.5708,-1329.9696,31.4937))
	{
		if(PlayerInfo[playerid][pJailed] >= 1)
		{
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно пройти курс лечения");
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Меня выпишут только, когда будет полное {ff0000}HP");
			return 1;
		}
		ShowDialog(playerid,741,DIALOG_STYLE_LIST,"{ff9000}Лифт {ff6666}ASGH","{cccccc}[1 Этаж] {ff6666}Больница\n{cccccc}[1 Lvl] {444444}Парковка\n{cccccc}[Крыша] {444444}Вертолётная Площадка","Ок","Отмена");
 		PlayerPlaySound(playerid,40405,0,0,0);
	}
	return 1;
}
CMD:psihlift(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1208.2892,-1355.1340,2001.1897) || IsPlayerInRangeOfPoint(playerid,2.0,1220.7668,-1406.8683,2001.1897))
	{
		if(PlayerInfo[playerid][pJailed] >= 1)
		{
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно пройти курс лечения");
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Меня выпишут только, когда я буду здоров {ff0000}[ /time ]");
			return 1;
		}
		ShowDialog(playerid,788,DIALOG_STYLE_LIST,"{ff9000}Лифт","{ff9000}1{cccccc} Этаж\n{ff9000}2{cccccc} Этаж","Ок","Отмена");
