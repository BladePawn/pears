stock FindAptek(playerid, bool:findforQuest = false)
{
	new Float:dist, Float:findpos, kakoi = 123, quan;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, BizzInfo[123][bEnterX],BizzInfo[123][bEnterY],BizzInfo[123][bEnterZ]);
	for(new b = 123; b < 133; b++)
	{
		if(findforQuest == true) // Распределяем игроков во время квеста
		{
			if(NextFindBiz(b)) continue; // В этот биз отправили уже максимальное количество игроков, значит ищем следующий
		}

		if(BizzInfo[b][bBizOStat][0] == 1 && BizzInfo[b][bArest] == 0 && BizzInfo[b][bStat] == 0)
		{
		    quan ++;
	    	findpos = GetDistancePoint(x, y, z, BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]);
	    	if(findpos <= dist) dist = findpos, kakoi = b;
		}
	}
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Все аптеки закрыты {ff9000}[ Обратитесь к администрации /report ]");
	new string[160];
	format(string,sizeof(string),"{ff9000}Ближайшая Аптека: %s {99ff66}отмечен на карте\n{cccccc}Бизнес № %d", BizzInfo[kakoi][bName], kakoi);
	SuccessMessage(playerid, string);
	CreateGps(playerid, BizzInfo[kakoi][bEnterX],BizzInfo[kakoi][bEnterY],BizzInfo[kakoi][bEnterZ], 0, 0, 5.0);

	// Записываем, что мы нашли биз для игрока
	if(findforQuest == true) WriteFindBiz(kakoi);
	return 1;
}


//================================
// Система, распределяет игроков по бизнесам, чтобы они не столпились
const MAX_BIZ_FIND = 30; // Максимальное количество игроков, которых мы отправляем в один биз

// Записываем что мы находили ближайший биз
stock WriteFindBiz(b)
{
	BizzInfo[b][bQuanFind] ++;
	if(BizzInfo[b][bQuanFind] >= MAX_BIZ_FIND) // В бизнес отправлено максимальное количество игроков
	{
		// Получили диапазон бизнесов для нужного нам типа
		new minB, maxB;
		bizTypeMin(BizType(b), minB, maxB);

		// Посчитали сколько бизов существует в этом типе
		new quanBizType = maxB - minB;

		// Запускаем цикл поиска посещяемых бизов
		new quanResetBiz;
		for(new i = minB; i < maxB; i++)
		{
			if(NextFindBiz(i)) quanResetBiz ++;
		}

		// Мы отправляли во все бизы, кроме последнего, значит всё очищаем
		if(quanResetBiz >= quanBizType - 1)
		{
			for(new i = minB; i < maxB; i++) BizzInfo[i][bQuanFind] = 0;
		}
	}
	return 1;
}

// return 1 означает, что в бизнес уже отправлено максимальное количество игроков, ищем следующий
stock NextFindBiz(b)
{
	if(BizzInfo[b][bQuanFind] >= MAX_BIZ_FIND) return 1;
	return 0;
}

