CMD:lesopoval(playerid, const params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
	new newcar = GetPlayerVehicleID(playerid);
	new model = VehInfo[GetPlayerVehicleID(playerid)][vModel];
	if(model == 530)
	{
		if(IsPlayerInRangeOfPoint(playerid,6.0,-2038.9722,-2392.1184,30.6250) && VehInfo[newcar][vObjstat] == 4)
		{
			PlayerPlaySound(playerid,6401,0,0,0); new string[64]; PlayerInfo[playerid][pOrigin]++;
			VehInfo[newcar][vObjstat] = 0; DestroyDynamicObject(VehInfo[newcar][vObject]);
			format(string, sizeof(string), RusToGame("~n~~n~~n~~n~~n~~n~~n~ ~w~Деревьев Обработано: ~y~%d"),PlayerInfo[playerid][pOrigin]);
			GameTextForPlayer(playerid, string, 4000, 3);
