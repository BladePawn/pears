	case 1250:
	{
	    if(response)
	    {
	        if(listitem < 0 || listitem > 9) return 1;
	        if(PlayerInfo[playerid][pAspecCol] != listitem)
	        {
	        	PlayerInfo[playerid][pAspecCol] = listitem;
	        	if(LoadSP[playerid] == true) DelSpecDraw(playerid);
	        	if(LoadSP[playerid] == false) LoadSpecDraw(playerid);
				if(gSpectateID[playerid] != INVALID_PLAYER_ID) StartSpectate(playerid, gSpectateID[playerid], 0);
