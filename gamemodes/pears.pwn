	    //InterpolateCameraPos(playerid, FrameInfo[frame][frCamposX], FrameInfo[frame][frCamposY], FrameInfo[frame][frCamposZ], FrameInfo[frame][frCamposRX], FrameInfo[frame][frCamposRY], FrameInfo[frame][frCamposRZ], 1000);
		//InterpolateCameraLookAt(playerid, FrameInfo[frame][frCamLookAtX], FrameInfo[frame][frCamLookAtY], FrameInfo[frame][frCamLookAtZ], FrameInfo[frame][frCamLookAtRX], FrameInfo[frame][frCamLookAtRY], FrameInfo[frame][frCamLookAtRZ], 1000);
