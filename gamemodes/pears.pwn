				case 7: PPSetPlayerPos(playerid, 1710.2264,-2421.5808,13.5767), PPSetPlayerFacingAngle(playerid,270.7122);
				case 8: PPSetPlayerPos(playerid, 1713.3613,-2421.6289,13.5767), PPSetPlayerFacingAngle(playerid,270.7122);
