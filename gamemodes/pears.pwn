 		format(str,sizeof(str),"\n{cccccc}Объекты: {ff9000}%d/200",kolobj), strcat(sctring,str);
	}
	format(str,sizeof(str),"\n\n{cccccc}Команды: {999999}/cob /eob /dob /iob /3d"), strcat(sctring,str);
