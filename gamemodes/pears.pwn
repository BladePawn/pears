	        if(get_invent4(playerid, 2, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет обручального кольца [ Y >> GPS >> Услуги >> Супермаркет ]");
			if(!sscanf(inputtext, "s[24]", inputtext))
	 	 	{
	        	if(checksimvol(inputtext)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённые символы");
	        	new giveplayerid = ReturnUser(inputtext);
	        	if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	        	if(GetPlayerState(giveplayerid) != PLAYER_STATE_ONFOOT || !ProxDetectorS(5.0, playerid,giveplayerid)) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко");
	        	if(giveplayerid == playerid) return ErrorMessage(playerid, "{FF6347}Вы указали свой никнейм или ID");
	        	if(CheckInvent(giveplayerid)) return ErrorMessage(playerid, "{FF6347}У вашей невесты не хватает места в инвентаре [ Некуда положить обручальное кольцо ]");

	        	format(string, sizeof(string), "* Вы сделали предложение руки и сердца %s {cccccc}[ Дождитесь её ответа ]", PlayerInfo[giveplayerid][pName]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);

                MarriageOffer[playerid] = 1;
                MarriageInfo[mStat] = 1;
                MarriageInfo[mMan] = playerid+1;
                
                ProposeOffer[giveplayerid] = playerid;
				format(string, sizeof(string), "{ff99ff}%s {cccccc}любит вас и хочет сделать вам предложение руки и сердца\n{ff99ff}Вы согласны?", PlayerInfo[playerid][pName]);
