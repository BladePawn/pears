						format(line,sizeof(line),"\n{ffcc66}Если совсем забить на гигиену, ваш персонаж может заболеть."), strcat(lines,line);
						format(line,sizeof(line),"\n{cccccc}Подробнее о болезнях вы узнаете в сюжетной линии"), strcat(lines,line);
