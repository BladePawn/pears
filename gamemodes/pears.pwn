	    	    if(listitem == 3) // Переместить Предмет
				{
					DP[0][playerid] = 0;
					showDialogInteriorDom(playerid);
				}
	    	    if(listitem == 4) // Изменить Текстуры
				{
					DP[0][playerid] = 1;
                    showDialogInteriorDom(playerid);
				}
				if(listitem == 5) // Убрать Предмет
				{
					DP[0][playerid] = 2;
                    showDialogInteriorDom(playerid);
				}
				if(listitem == 6) // Убрать все объекты в дом
				{
				    PlayerPlaySound(playerid,40405,0,0,0);
					new kolobj = 0;
				 	for(new oba = 0; oba < MAX_OBJECT_INT; oba++)
					{
						if(DomInfo[nd][dOmodel][oba] > 0 && IsValidDynamicObject(DomInfo[nd][dObject][oba]))
						{
							if(IsAFrameObject(DomInfo[nd][dOmodel][oba])) continue;
					 		kolobj ++;
						}
					}
					if(kolobj == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме нет ни одного объекта"), format(string, sizeof(string), "%d", nd), pc_cmd_dedit(playerid, string);
					format(string, sizeof(string), "{cccccc}В Доме № %d установлено %d предметов мебели\n{FF6347}Вы уверены, что хотите их убрать в дом?",nd,kolobj);
					ShowDialog(playerid,917,DIALOG_STYLE_MSGBOX,"{ff9000}Редактор Объектов",string,"Да","Нет");
				}
				if(listitem == 7) // Удалить все объекты
				{
				    PlayerPlaySound(playerid,40405,0,0,0);
					new kolobj = 0, remobj = 0;
				 	for(new oba = 0; oba < MAX_OBJECT_INT; oba++)
					{
						if(DomInfo[nd][dOmodel][oba] > 0 && IsValidDynamicObject(DomInfo[nd][dObject][oba]))
						{
							if(IsAFrameObject(DomInfo[nd][dOmodel][oba])) continue; // Игнорим объекты планировки

							kolobj ++;
							if(Streamer_HasIntData(STREAMER_TYPE_OBJECT, DomInfo[nd][dObject][oba], STREAMER_EDITABLE_DYNAMIC_OBJECT)
								&& Streamer_GetIntData(STREAMER_TYPE_OBJECT, DomInfo[nd][dObject][oba], STREAMER_EDITABLE_DYNAMIC_OBJECT) >= 1) remobj ++;
						}
					}
					if(kolobj == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме нет ни одного объекта"), format(string, sizeof(string), "%d", nd), pc_cmd_dedit(playerid, string);
					if(remobj >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме кто-то занимается ремонтом, полное удаление невозможно!"), format(string, sizeof(string), "%d", nd), pc_cmd_dedit(playerid, string);
					format(string, sizeof(string), "{FF6347}Внимание! Все предметы будут полностью уничтожены и НЕ окажутся в инвентаре\n\n{cccccc}В Доме № %d установлено %d предметов мебели\n{FF6347}Вы уверены, что хотите их удалить?",nd,kolobj);
					ShowDialog(playerid,919,DIALOG_STYLE_MSGBOX,"{ff9000}Удаление Объектов",string,"Да","Нет");
				}
	    	}
	    	else ErrorMessage(playerid, "{FF6347}Вам нужно находиться в интерьере или возле дома");
		}
		else
		{
			if(DP[5][playerid] == 0) pc_cmd_mydom(playerid);
		}
	}
	case 889: // Выбрасываем предмет из дома
	{
	    if(response)
	    {
	    	if(Veshi[playerid] >= 1) return 0;
	    	
	    	new inva = DP[0][playerid];
	    	new d = OnlineInfo[playerid][oShowTabs], fpick = DomInfo[d][dInvent][inva], thingQuan = DomInfo[d][dInv][inva],
				thingType = DomInfo[d][dInvType][inva], thingPack = DomInfo[d][dInvPack][inva];
			if(inva == 9999 || d == 9999 || fpick == 0 || Tabs_Load[playerid] != 2) return 1;
			
			if(IsANearWardrobeDom(playerid, d))
			{
				Veshi[playerid] = 0;
				if(PlayerInfo[playerid][pDom] != d)
				{
