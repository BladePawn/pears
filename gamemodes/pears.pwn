    else format(str,sizeof(str),"{cccccc}Арабский Язык \t {FF6347}[ Off ]\n");
    strcat(sctring,str);
  	ShowDialog(playerid,882,DIALOG_STYLE_TABLIST,"{ff9000}Иностранные Языки",sctring,"Ок", "Отмена");
	return 1;
}
CMD:speed(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно быть за рулём");
	if(IsAVello(GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На велосипед нельзя установить спидометр..");
	new str[100],sctring[100];
	if(PlayerInfo[playerid][pSped] <= 0) format(str,sizeof(str),"{cccccc}3D Спидометр {99ff66}[ On ]\n"), strcat(sctring,str);
	else if(PlayerInfo[playerid][pSped] >= 1) format(str,sizeof(str),"{cccccc}3D Спидометр {FF6347}[ Off ]\n"), strcat(sctring,str);
 	ShowDialog(playerid,246,DIALOG_STYLE_LIST,"{ff9000}Настройки Спидометра",sctring,"Ок","Отмена");
 	return 1;
}
CMD:pers(playerid)
{
	new line[90],lines[630];
 	if(PlayerInfo[playerid][pMeshk11]==0) format(line,sizeof(line),"{cccccc}Мотошлем \t {99ff66}[ On ]");
	else if(PlayerInfo[playerid][pMeshk11]==1) format(line,sizeof(line),"{cccccc}Мотошлем \t {FF6347}[ Off ]");
	strcat(lines,line);
	if(PlayerInfo[playerid][pAccessoryReload] == 0) format(line,sizeof(line),"\n{cccccc}Подстраивание аксессуаров при переодевании \t {99ff66}[ On ]");
	else if(PlayerInfo[playerid][pAccessoryReload] == 1) format(line,sizeof(line),"\n{cccccc}Подстраивание аксессуаров при переодевании \t {FF6347}[ Off ]");
	strcat(lines,line);
 	ShowDialog(playerid,245,DIALOG_STYLE_TABLIST,"{ff9000}Управление Персонажем",lines,"Ок","Отмена");
 	return 1;
}
CMD:thing(playerid)
{
	if(OnlineInfo[playerid][oShowInterface] == 1 && (OnlineInfo[playerid][oInventSelectLeft] != 9999 || OnlineInfo[playerid][oInventSelectRight] != 9999))
	if(OnlineInfo[playerid][oInventSelectLeft] != 9999 && OnlineInfo[playerid][oInventSelectRight] != 9999) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу посмотреть... Выбрано сразу два предмета"), i_resetveshi(playerid), i_resettabs(playerid);
	new fpick, fquan, fpara, fqara, ftype, thingPack, inva, tab, aga, vibros;
	if(OnlineInfo[playerid][oInventSelectLeft] != 9999)
	{
	    inva = OnlineInfo[playerid][oInventSelectLeft];
	    fpick = PlayerInfo[playerid][pInven][inva];
		fquan = PlayerInfo[playerid][pInvenQuan][inva];
		fpara = PlayerInfo[playerid][pInvenPara][inva];
		fqara = PlayerInfo[playerid][pInvenQara][inva];
		ftype = PlayerInfo[playerid][pInvenType][inva];
		thingPack = PlayerInfo[playerid][pInvenPack][inva];
		aga = 1;
	}
	else if(OnlineInfo[playerid][oInventSelectBackPack] != 9999)
	{
	    inva = OnlineInfo[playerid][oInventSelectBackPack];
	    fpick = BackPackInfo[playerid][backpackInvent][inva]; 
		fquan = BackPackInfo[playerid][backpackInv][inva];
		fpara = BackPackInfo[playerid][backpackInvPara][inva];
		fqara = BackPackInfo[playerid][backpackInvQara][inva];
		ftype = BackPackInfo[playerid][backpackInvType][inva];
		thingPack = BackPackInfo[playerid][backpackInvPack][inva];
		aga = 1;
	}
	else if(OnlineInfo[playerid][oInventSelectRight] != 9999)
	{
	    inva = OnlineInfo[playerid][oInventSelectRight];
	    if(Tabs_Load[playerid] == 1) // Лавка Товаров
		{
			tab = OnlineInfo[playerid][oShowTabs];
			if(!IsOnline(tab)) return 1;
     		fpick = PlayerInfo[tab][pMarkInven][inva];
			fquan = PlayerInfo[tab][pMarkInvenQuan][inva];
			fpara = PlayerInfo[tab][pMarkInvenPara][inva];
			fqara = PlayerInfo[tab][pMarkInvenQara][inva];
			ftype = PlayerInfo[tab][pMarkInvenType][inva];
			thingPack = PlayerInfo[tab][pMarkInvenPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 2) // Дом
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = DomInfo[tab][dInvent][inva];
			fquan = DomInfo[tab][dInv][inva];
			fpara = DomInfo[tab][dInvPara][inva];
			fqara = DomInfo[tab][dInvQara][inva];
			ftype = DomInfo[tab][dInvType][inva];
			thingPack = DomInfo[tab][dInvPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 3) // Склад
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = OrganInfo[tab][gInvent][inva];
			fquan = OrganInfo[tab][gInv][inva];
			fpara = OrganInfo[tab][gInvPara][inva];
			ftype = OrganInfo[tab][gInvType][inva];
			thingPack = 0;
		}
		else if(Tabs_Load[playerid] == 4) // Арендованный Склад
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = WhInfo[tab][wInvent][inva];
			fquan = WhInfo[tab][wInv][inva];
			ftype = WhInfo[tab][wInvType][inva];
			thingPack = 0;
		}
		else if(Tabs_Load[playerid] == 5) // Багажник
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = VehInfo[tab][vInvent][inva];
			fquan = VehInfo[tab][vInv][inva];
 			fpara = VehInfo[tab][vInvPara][inva];
 			fqara = VehInfo[tab][vInvQara][inva];
 			ftype = VehInfo[tab][vInvType][inva];
 			thingPack = VehInfo[tab][vInvPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 6) // Мои Товары
		{
			fpick = PlayerInfo[playerid][pMarkInven][inva];
			fquan = PlayerInfo[playerid][pMarkInvenQuan][inva];
			fpara = PlayerInfo[playerid][pMarkInvenPara][inva];
			fqara = PlayerInfo[playerid][pMarkInvenQara][inva];
			ftype = PlayerInfo[playerid][pMarkInvenType][inva];
			thingPack = PlayerInfo[playerid][pMarkInvenPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 7) // Выбошенные Предметы
		{
			if(MyThrow[inva][playerid] >= 0)
			{
				fpick = ThrowInfo[MyThrow[inva][playerid]][tId];
				fquan = ThrowInfo[MyThrow[inva][playerid]][tQuan];
				fpara = ThrowInfo[MyThrow[inva][playerid]][tPara];
				fqara = ThrowInfo[MyThrow[inva][playerid]][tQara];
				ftype = ThrowInfo[MyThrow[inva][playerid]][tType];
				thingPack = ThrowInfo[MyThrow[inva][playerid]][tPack];
				aga = 1;
				vibros = 1;
			}
		}
		else if(Tabs_Load[playerid] == 8) // Мусорка
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = gTrash[inva][tab];
			fquan = gTrashKol[inva][tab];
			fpara = gTrashPara[inva][tab];
			fqara = gTrashQara[inva][tab];
			ftype = gTrashType[inva][tab];
			thingPack = gTrashPack[inva][tab];
		}
		else if(Tabs_Load[playerid] == 9) // Бизнес
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = BizzInfo[tab][bInvent][inva];
			fquan = BizzInfo[tab][bInv][inva];
			fpara = BizzInfo[tab][bInvPara][inva];
			fqara = BizzInfo[tab][bInvQara][inva];
			ftype = BizzInfo[tab][bInvType][inva];
			thingPack = BizzInfo[tab][bInvPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 14) // Тумба
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = PrisonTableInfo[tab][ptInvent][inva];
			fquan = PrisonTableInfo[tab][ptInv][inva];
			fpara = PrisonTableInfo[tab][ptInvPara][inva];
			fqara = PrisonTableInfo[tab][ptInvQara][inva];
			ftype = PrisonTableInfo[tab][ptInvType][inva];
			thingPack = PrisonTableInfo[tab][ptInvPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 15) // Квартиры тумба
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = ApartmentsRoom[tab][aprInvent][inva];
			fquan = ApartmentsRoom[tab][aprInv][inva];
			fpara = ApartmentsRoom[tab][aprInvPara][inva];
			fqara = ApartmentsRoom[tab][aprInvQara][inva];
			ftype = ApartmentsRoom[tab][aprInvType][inva];
			thingPack = ApartmentsRoom[tab][aprInvPack][inva];
			aga = 1;
		}
		else if(Tabs_Load[playerid] == 16) // Холодильник
		{
			tab = OnlineInfo[playerid][oShowTabs];
			fpick = Refrigerator[tab][fridgeInvent][inva];
			fquan = Refrigerator[tab][fridgeInv][inva];
			fpara = Refrigerator[tab][fridgeInvPara][inva];
			fqara = Refrigerator[tab][fridgeInvQara][inva];
			ftype = Refrigerator[tab][fridgeInvType][inva];
			thingPack = Refrigerator[tab][fridgeInvPack][inva];
			aga = 1;
		}
	}
	i_resetveshi(playerid);
	if(fpick == 0) return ErrorMessage(playerid, "{FF6347}В выбранной ячейке ничего нет");
	new str[84],sctring[450], unix = gettime();
	
	if(thingPack == 1) // Упакованный подарок
	{
	    format(str,sizeof(str),"{ff9000}Подарок"), strcat(sctring,str);
 		if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	}
	else if(thingPack == 2) // Упакованный ящик
	{
	    format(str,sizeof(str),"{ff9000}Ящик"), strcat(sctring,str);
 		if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	}
	else if(thingPack == 3) // Упакованный мешок
	{
	    format(str,sizeof(str),"{ff9000}Мешок"), strcat(sctring,str);
 		if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	}
	else if(thingPack == 4) // Запечатанный ящик
	{
	    format(str,sizeof(str),"{ff9000}Запечатанный Ящик"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Используется в доставке NGSA"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Его не получится положить на склад"), strcat(sctring,str);
 		if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	}
	else if(IsACasePackID(thingPack)) // Шкатулка
	{
	    format(str, sizeof(str),"{ff9000}%s", GetCaseName(thingPack)), strcat(sctring,str);
 		if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	}
	else if(thingPack == 0) // Предмет без упаковки
	{
	    if(ftype == 0) // Обычный предмет
	    {
			new days, hour, minute, second;
			getunix(fpara-unix, days, hour, minute, second);
			if(CheckThingQuan(fpick) == 1)
			{
				format(str,sizeof(str),"{ff9000}%s [Количество: %d]", friskName[fpick], fquan), strcat(sctring,str);
				if(fpick == 27) format(str,sizeof(str),"\n{cccccc}Патроны к дробовику"), strcat(sctring,str);
				else if(fpick == 28) format(str,sizeof(str),"\n{cccccc}Патроны к пистолету или пистолету-пулемёту"), strcat(sctring,str);
				else if(fpick == 29) format(str,sizeof(str),"\n{cccccc}Патроны к автомату"), strcat(sctring,str);
				else if(fpick == 30) format(str,sizeof(str),"\n{cccccc}Патроны к винтовке"), strcat(sctring,str);
				else if(fpick == 88) format(str,sizeof(str),"\n{99ff66}Эти семена можно посадить"), strcat(sctring,str);
				else if(fpick == 89) format(str,sizeof(str),"\n{FF6347}Эта картошка странно выглядит"), strcat(sctring,str);
				else if(fpick >= 256 && fpick <= 260) format(str,sizeof(str),"\n{cccccc}Предмет для создания одежды/аксессуаров"), strcat(sctring,str);
			}
			else
			{
				format(str,sizeof(str),"{ff9000}%s", friskName[fpick]), strcat(sctring,str);
				if(IsThingCanBroke(fpick, ftype, thingPack))
				{
					if(fpara == 1) format(str,sizeof(str),"\n{FF6347}Предмет Сломан {cccccc}Возможно сломался при падении с высоты"), strcat(sctring,str);
					else format(str,sizeof(str),"\n{99ff66}Предмет Рабочий"), strcat(sctring,str);
				}
				if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) 
				{
					if(fpick == 11 && Tabs_Load[playerid] == 7) {}
					else format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
				}
				if(fpick >= 207 && fpick <= 224)
				{
					new tuningType = friskDetail[fpick-207][1];
					if(tuningType == 0) format(str,sizeof(str),"\n{ff9000}Двигатель {cccccc}[Скорость: +%s %% | Ускорение: +%s %%]",friskDetailPoint[fpick-207][0],friskDetailPoint[fpick-207][1]), strcat(sctring,str);
					else if(tuningType == 1) format(str,sizeof(str),"\n{ff9000}Трансмиссия {cccccc}[Ускорение: +%s %%]",friskDetailPoint[fpick-207][0]), strcat(sctring,str);
					else if(tuningType == 2) format(str,sizeof(str),"\n{ff9000}Подвеска {cccccc}[Качество поворотов: +%s %%]",friskDetailPoint[fpick-207][0]), strcat(sctring,str);
					else if(tuningType == 3) format(str,sizeof(str),"\n{ff9000}Шины {cccccc}[Сцепление с дорогой: +%s %%]",friskDetailPoint[fpick-207][0]), strcat(sctring,str);
					else if(tuningType == 4) format(str,sizeof(str),"\n{ff9000}Тормоз {cccccc}[Качество тормозов: +%s %%]",friskDetailPoint[fpick-207][0]), strcat(sctring,str);
				}
				if(fpick >= 244 && fpick <= 248) format(str,sizeof(str),"\n{cccccc}Качество: %s {cccccc}[ %d%% / 100%% ]",friskQualityColorAndText[fpara/20],fpara), strcat(sctring,str);

			}
			if(fpick == 96) format(str,sizeof(str),"\n{FF6347}Кровь очень темного цвета"), strcat(sctring,str);
			if(fpick == 98) format(str,sizeof(str),"\n{FF6347}Обычная человеческая кровь"), strcat(sctring,str);
			if(fpick == 14 || fpick == 37 || fpick >= 112 && fpick <= 121 || fpick == 124|| fpick == 139|| fpick == 172|| fpick == 173 || fpick == 261) format(str,sizeof(str),"\n{cccccc}Содержимое: {ff9000}%d мл.", (fquan-1)*100), strcat(sctring,str);
			if(fpick == 125 || fpick == 126 || fpick == 127 || IsANaborsEdoi(fpick) || fpick == 163 || fpick == 164 || fpick == 166 || fpick == 167 || fpick == 262) format(str,sizeof(str),"\n{cccccc}Содержимое: {ff9000}%d гр.", (fquan-1)*100), strcat(sctring,str);
			if(fpick == 16) format(str,sizeof(str),"\n{cccccc}Содержимое: {ff9000}%d (сигарет)", fquan), strcat(sctring,str);
			if(fpick == 43) format(str,sizeof(str),"\n{cccccc}Зарядов: {ff9000}%d/10", fquan - 1), strcat(sctring,str); // Электрошокер ручной

			// Детекторы и глушилка радаров
			if(fpick == 231) strcat(sctring, "\n\n{cccccc}Устройство предупреждает о наличии радара за "#RADAR_DETECT_RADIUS" метров от него");
			else if(fpick == 232) strcat(sctring, "\n\n{cccccc}Устройство предупреждает о наличии радара за "#RADAR_ENHANCED_DETECT_RADIUS" метров от него\nЭтот тип детектора помечает радар на мини-карте на 80 метрах от него, а также обладает индикатором,\nотражающим вашу скорость, относительно ограничения скорости у радара");
			else if(fpick == 233) strcat(sctring, "\n\n{cccccc}Устройство позволяет заглушать радары, мимо которых вы проезжаете, на небольшой промежуток времени\nГлушилка срабатывает не чаще чем 1 раз в "#RADAR_JAMMER_COOLDOWN" секунд и выключает радар для всех в течение "#RADAR_JAMMED_TIME" секунд\nТакже будет функционировать, если находится в багажнике автомобиля");

			// Радиоперехватчик
			else if(fpick == 236) strcat(sctring, "\n\n{cccccc}Устройство для перехвата радиосообщений полицейских");

			// Кофе
			else if(fpick == 121)
			{
				format(str,sizeof(str),"\n\n{ffcc66}Кофе восполняет бодрость персонажа"), strcat(sctring,str);
			}

			// Пропуск Годжо
			else if(fpick == 239)
			{
				if(fpara < unix) format(str,sizeof(str),"\n\n{FF6347}Пропуск недействителен"), strcat(sctring,str);
				else
				{
					new undays, unhour, unminute, unsecond;
					getunix(fpara - unix, undays, unhour, unminute, unsecond);
					format(str,sizeof(str),"\n\n{ffcc66}Пропуск доступен в течении %d дней %02d часов %02d минут", undays, unhour, unminute), strcat(sctring,str);
				}
			}

			// Книга Анархиста
			else if (fpick == 273)
			{
				strcat(sctring, "\n\n" \
					"{cccccc}Позволяет узнать верный ингредиент при изготовлении синего порошка в лаборатории\n" \
					"{ff9000}Использование: {cccccc}Достать книгу рядом с местом изготовления порошка"
				);
			}

			// Артефакты (Раскопка могил)
			else if (fpick == 243) strcat(sctring, "\n\n{cccccc}Повышает шанс появления Призрака или Разгневанного Духа при раскопке могил {555555}[+15%]"); // Некрономикон
			else if (fpick == 5) strcat(sctring, "\n\n{cccccc}Повышает шанс появления Призрака или Разгневанного Духа при раскопке могил {555555}[+12%]"); // Доска Уиджи
			else if (fpick == 180) strcat(sctring, "\n\n{cccccc}Повышают шанс появления Призрака или Разгневанного Духа при раскопке могил {555555}[+8%]"); // Карты таро
			else if (fpick == 198) strcat(sctring, "\n\n{cccccc}Повышает шанс появления Призрака или Разгневанного Духа при раскопке могил {555555}[+5%]"); // Кукла вуду
			else if (fpick == 242) { // Череп Осириса
				strcat(sctring, "\n\n{cccccc}Таинственный амулет упрощает убийство Призрака и Разгневанного Духа при раскопке могил");
				format(sctring, sizeof(sctring), "%s\n\n{ff9000}Осталось использований: %d", sctring, GRAVES_OSIRIS_SKULL_TIMES - fpara);
			}
			else if (fpick == 281)
			{
				format(str,sizeof(str),"\n\n{ffcc66}Данная консерва подойдет к кормлению только собакам."), strcat(sctring,str);
				format(str,sizeof(str),"\n{ffcc66}Пополняет 20 голода питомцу и уменьшает КД на игру с ним на 2 часа"), strcat(sctring,str);
			}
			else if (fpick == 280)
			{
				format(str,sizeof(str),"\n\n{ffcc66}Данная консерва подойдет к кормлению только кошкам."), strcat(sctring,str);
				format(str,sizeof(str),"\n{ffcc66}Пополняет 20 голода питомцу и уменьшает КД на игру с ним на 2 часа"), strcat(sctring,str);
			}
			else if (fpick == 282)
			{
				format(str,sizeof(str),"\n\n{ffcc66}Если скормить её питомцу, он получит одну уникальную способность"), strcat(sctring,str);
			}
			else if (fpick == 283)
			{
				format(str,sizeof(str),"\n\n{ffcc66}Если скормить её питомцу, то здоровья питомца полностью восстановится"), strcat(sctring,str);
			}
			
			
			// Документы и лицы
			if(DocumentThing(fpick, ftype))
   			{
   			    if(fpara == PlayerInfo[playerid][pID]) format(str,sizeof(str),"\n{99ff66}Личные документы"), strcat(sctring,str);
   			    else format(str,sizeof(str),"\n{FF6347}Чужие документы"), strcat(sctring,str);
				if(fpick == 156 && fquan == 2)
				{
					format(str,sizeof(str),"\n\n{ffcc66}Водительские права, получены не в нашем штате,"), strcat(sctring,str);
					format(str,sizeof(str),"\n{ffcc66}Нельзя передать, выбросить или продать"), strcat(sctring,str);
				}
				else
				{
					format(str,sizeof(str),"\n\n{ffcc66}Вы можете продать или передать свои документы другому игроку"), strcat(sctring,str);
					format(str,sizeof(str),"\n{ffcc66}Чтобы он мог использовать соответствующий транспорт"), strcat(sctring,str);
					format(str,sizeof(str),"\n{ffcc66}За это незаконное действие вас может арестовать полиция"), strcat(sctring,str);
				}
   			}
			
			// Портящиеся продукты
			if(PerishableThing(fpick, ftype))
			{
				new perishable_text[64];
				if(Tabs_Load[playerid] == 16 && OnlineInfo[playerid][oInventSelectRight] != 9999)
				{
					if(fpara < 0 && (fpick == 124 && fquan-1 > 0 || fpick != 124)) format(str,sizeof(str),"\n{FF6347}Испорчено"), strcat(sctring,str);
					else 
					{
						strcat(perishable_text, "Испортится если взять из холодильника");
						getunix(fpara, days, hour, minute, second);
						format(str, sizeof(str),
							"\n{cccccc}%s через: %d %s, %d %s, %d %s",

							perishable_text,
							days, PluralToText(days, "день", "дня", "дней"),
							hour, PluralToText(hour, "час", "часа", "часов"),
							minute, PluralToText(minute, "минуту", "минуты", "минут")
						);
						strcat(sctring, str);
					}
				}
				else if(unix > fpara)
				{
					if (fpick == 233) format(str, sizeof(str), "\n{FF6347}Прошивка устарела"), strcat(sctring,str);
					else if(fpick == 236) format(str, sizeof(str), "\n{FF6347}Требуется настройка частоты"), strcat(sctring,str);
					else if(fpick == 124 && fquan-1 > 0 || fpick != 124) format(str,sizeof(str),"\n{FF6347}Испорчено"), strcat(sctring,str);
				}
				else {
					if (fpick == 233) strcat(perishable_text, "Прошивка устареет");
					else if (fpick == 236) strcat(perishable_text, "Обновление частоты потребуется");
					else strcat(perishable_text, "Испортится");

					format(str, sizeof(str),
						"\n{cccccc}%s через: %d %s, %d %s, %d %s",

						perishable_text,
						days, PluralToText(days, "день", "дня", "дней"),
						hour, PluralToText(hour, "час", "часа", "часов"),
						minute, PluralToText(minute, "минуту", "минуты", "минут")
					);
					strcat(sctring, str);
				}
			}

			// Бомба
			if(fpick == 11)
			{
				if(fpara > 0 && Tabs_Load[playerid] == 7)
				{
					format(str,sizeof(str),"\n{cccccc}Взорвется через: %d секунд", fpara), strcat(sctring,str);
					if(fqara > 0) format(str,sizeof(str),"\n{555555}Установлена на Железнодорожные Пути"), strcat(sctring,str);
				}
				else
				{
					format(str,sizeof(str),"\n{cccccc}Бомбу можно установить на железнодорожные пути"), strcat(sctring,str);
					format(str,sizeof(str),"\n{cccccc}для ограбления конвоя NGSA с боеприпасами"), strcat(sctring,str);
				}
			}
		}
	    if(ftype == 1) // Оружие
	 	{
		 	format(str,sizeof(str),"{ff9000}Оружие: %s [ID %d]", gunName[fpick], fpick), strcat(sctring,str);
		 	if(fpick == 3 || fpick == 5)
		 	{
		 		format(str,sizeof(str),"\n{99ff66}Этим оружием можно нокаутировать человека"), strcat(sctring,str);
		 	    format(str,sizeof(str),"\n\n{cccccc}Есть вероятность выпадения предметов | Условия:"), strcat(sctring,str);
	            format(str,sizeof(str),"\n{cccccc}- Находиться на территории гетто или за городом"), strcat(sctring,str);
	            format(str,sizeof(str),"\n{cccccc}- Состоять в банде или мафии"), strcat(sctring,str);
	            format(str,sizeof(str),"\n{cccccc}- 1 раз в 3 часа"), strcat(sctring,str);
		 	}
		 	if(aga == 1 && fpick >= 22 && fpick <= 34)
		 	{
		 		if(fpara <= 0) format(str,sizeof(str),"\n{FF6347}Изношенность: 100 проц. [ Оружие испорчено ]"), strcat(sctring,str);
				else if(fpara >= GUN_HEALTH) format(str,sizeof(str),"\n{cccccc}Изношенность: 0.00 / 100 проц."), strcat(sctring,str);
		 		else
			 	{
			 	    new Float:koef = GUN_HEALTH/(GUN_HEALTH-fpara);
					new Float:itog = 100/koef;
			 		format(str,sizeof(str),"\n{cccccc}Изношенность: %.2f / 100 проц.", itog), strcat(sctring,str);
		 		}
		 		if(PlayerInfo[playerid][pSoska] >= 1) format(str,sizeof(str),"\n{cccccc}Процесс Изношенности: %d {444444}(Видит только админ)", fpara), strcat(sctring,str);
		 	}
		 	if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	 	}
	    if(ftype == 2) // Аксессуар
		{
		    if(IsCustomObject(fpick)) format(str,sizeof(str),"{ff9000}Аксессуар {cccccc}[ ID %d ] {0088ff}[ Custom ]", fpick), strcat(sctring,str);
			else format(str,sizeof(str),"{ff9000}Аксессуар {cccccc}[ ID %d ]", fpick), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Название: {ff9000}%s", GetNameThing(1, fpick, ftype, thingPack)), strcat(sctring,str);
			
			new AksType = GetBustAksType(fpick);
			if(AksType == -1)
			{
				if(IsArmor(fpick)) format(str,sizeof(str),"\n{cccccc}Броня: {ff9000}%d/100", fpara), strcat(sctring,str);
				else format(str,sizeof(str),"\n{cccccc}Крепление: %s", boneName[fpara]), strcat(sctring,str);
			}
			else{
				format(str,sizeof(str),"\n{cccccc}Качество: %s",friskQualityColorAndText[fpara/100]), strcat(sctring,str);
				format(str,sizeof(str),"\n{cccccc}Бонус: %s +%d",friskQualityBust[AksType],ResultCountBustAks(fpick,AksType,fpara)), strcat(sctring,str);
			}
			if(IsABackPack(fpick) && fqara > 0) format(str,sizeof(str),"\n{cccccc}[ID в базе %d]", fqara), strcat(sctring,str);
			if(!IsABackPack(fpick) && fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
		}
		if(ftype == 3) // Одежда
		{
		 	if(fpick > 311) format(str,sizeof(str),"{ff9000}Одежда: ID %d {0088ff}[ Custom ]", fpick), strcat(sctring,str);
			else format(str,sizeof(str),"{ff9000}Одежда: ID %d", fpick), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}%s", GetSkinName(fpick)), strcat(sctring,str);
			format(str,sizeof(str),"\n{cccccc}Редкость: %s", GetSkinClassName(fpick)), strcat(sctring,str);

		 	if(fpara == 0 || fpara >= 50) format(str,sizeof(str),"\n{cccccc}Принадлежит: Гражданский (Общий Доступ)"), strcat(sctring,str);
		 	else if(fpara <= 33) format(str,sizeof(str),"\n{cccccc}Принадлежит: %s", fraklastName[fpara]), strcat(sctring,str);
		 	if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);

			if(fpick > 311 && !IsPlayerSyncModels(playerid))
			{
				format(str,sizeof(str),"\n\n{FF6347}Чтобы увидеть реальную модель скина,\nскачайте лаунчер с нашего сайта"), strcat(sctring,str);
			}
		}
	    if(ftype == 4) // Мебель
	    {
		 	format(str,sizeof(str),"{ff9000}Мебель: ID %d",fpick), strcat(sctring,str);
		 	format(str,sizeof(str),"\n{cccccc}%s",GetNameThing(1, fpick, ftype, thingPack)), strcat(sctring,str);
		 	if(fqara > 0 && (IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi] >= 1)) format(str,sizeof(str),"\n{ff0000}Украденный предмет [ID %d]", fqara), strcat(sctring,str);
	 	}
		if(ftype == 5) // Транспорт
		{
		 	if(fpick > 611) format(str,sizeof(str),"{ff9000}Транспорт: {cccccc}Model %d {0088ff}[ Custom ]", fpick), strcat(sctring,str);
			else format(str,sizeof(str),"{ff9000}Транспорт: {cccccc}Model %d", fpick), strcat(sctring,str);
			format(str,sizeof(str),"\n{ff9000}Название: {cccccc}%s", GetVehicleName(fpick)), strcat(sctring,str);
			format(str,sizeof(str),"\n{ff9000}Класс: {cccccc}%s", vehClassName[GetVehicleClass(fpick)]), strcat(sctring,str);
			if(fpick > 611 && !IsPlayerSyncModels(playerid))
			{
				format(str,sizeof(str),"\n\n{FF6347}Чтобы увидеть реальную модель транспорта,\nскачайте лаунчер с нашего сайта"), strcat(sctring,str);
			}
		}
		if(ftype == 6) // Питомец
		{
			format(str,sizeof(str),"{ff9000}Питомец: {cccccc}Model %d {444444}DB ID:[ %d ]", fpick, fpara), strcat(sctring,str);
			format(str,sizeof(str),"\n{ff9000}Название: {cccccc}%s", GetSkinName(fpick)), strcat(sctring,str);
		}
	}

	if (UnlegalThing(fpick, ftype, thingPack)) {
		strcat(sctring, "\n\n{ff6347}Предмет является нелегальным и может быть изъят");
	} else if (UnlegalSkin(fraction(playerid), fpara, ftype)) {
		strcat(sctring, "\n\n{ff6347}Этот комплект одежды нелегален и может быть изъят");
	}
	
	// Информация о предмете на земле
	if(vibros == 1)
	{
		if((fpick == 38 || fpick == 122 || fpick == 123) && ftype == 0) // Стаканы, бокалы и ёмкости
		{
			if(ThrowInfo[MyThrow[inva][playerid]][tModel] == 38) format(str,sizeof(str),"\n{cccccc}Содержимое: пусто"), strcat(sctring,str);
			else format(str,sizeof(str),"\n{cccccc}Содержимое: %s (%d мл.)",friskName[ThrowInfo[MyThrow[inva][playerid]][tModel]], (ThrowInfo[MyThrow[inva][playerid]][tQuan]-1)*10), strcat(sctring,str);
		}
		format(str,sizeof(str),"\n"), strcat(sctring,str);
		if(ThrowInfo[MyThrow[inva][playerid]][tPlayerid] > 0) format(str,sizeof(str),"\n{cccccc}Оставил: %s", ThrowInfo[MyThrow[inva][playerid]][tName]), strcat(sctring,str);
		if(ThrowInfo[MyThrow[inva][playerid]][tTime] > 0)
		{
		    new ahour = ThrowInfo[MyThrow[inva][playerid]][tTime]/3600;
			new avremh = ahour*3600;
			new avremmin = ThrowInfo[MyThrow[inva][playerid]][tTime]-avremh;
			new amin = avremmin/60;
			new asek = avremmin-amin*60;
			if(ahour >= 1) format(str,sizeof(str),"\n{cccccc}Исчезнет через: {444444}%02d часов %02d минут %02d секунд", ahour, amin, asek), strcat(sctring,str);
			else format(str,sizeof(str),"\n{cccccc}Исчезнет через: {444444}%02d минут %02d секунд", amin, asek), strcat(sctring,str);
		}
		else format(str,sizeof(str),"\n{cccccc}Предмет не исчезнет"), strcat(sctring,str);
	}

	format(str,sizeof(str),"\n"), strcat(sctring,str);
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Предмет",sctring,"*","");
 	return 1;
}
CMD:undress(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerSpeed(playerid) > 3 || MPGO[playerid] > 0 || gSkafandr[playerid] > 0 || gFormavvs[playerid] > 0
	|| GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1 || Sleep[playerid] >= 1 || SleepRP[playerid] >= 1
	|| CnnVed[playerid] >= 11 || Ash[playerid] >= 1 || GetPVarInt(playerid, "SelectCharPlace") >= 1
	|| HospBed[playerid] >= 0 && HospBed[playerid] <= 25 || playerSeat[playerid] || Piss[playerid] >= 1 || Hold[playerid] >= 1
	|| DeathInfo[playerid][deathStatus]) return ErrorMessage(playerid, "{FF6347}Сейчас нельзя переодеться");
	if(Tabs_Load[playerid] == 11 || Tabs_Load[playerid] == 12 || Tabs_Load[playerid] == 13 || Tabs_Load[playerid] == 17) return ErrorMessage(playerid, "{FF6347}Нельзя переодеться при открытом меню крафта, ремонта или кухни");
	if(isnaked(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж уже без одежды");
	new put_inva = GiveThingPlayer(playerid, PlayerInfo[playerid][pModel], 1, PlayerInfo[playerid][pModel2], PlayerInfo[playerid][pModel3], 3, 0, 9999);
	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}В инвентаре нет места");
   	if(PlayerInfo[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"снял одежду",COLOR_PURPLE,20.0,5000);
   	else SetPlayerChatBubble(playerid,"сняла одежду",COLOR_PURPLE,20.0,5000);
   	player_undress(playerid);
 	return 1;
}
CMD:taxis(playerid, const params[])
{
	new string[144];
	SendClientMessage(playerid, COLOR_LIGHTBLUE, " Таксисты Онлайн:");
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && GetPlayerState(i) == PLAYER_STATE_DRIVER)
		{
			new veh = GetPlayerVehicleID(i);
			if(VehInfo[veh][v3dstat] >= 1 && VehInfo[veh][v3dstat] <= 900)
			{
				new model = VehInfo[veh][vModel];
				format(string, 144, "** %s [ {0088ff}%s {cccccc}| {99ff66}%d$ ] {cccccc}Тел. {ff9000}%d", playername(i), GetVehicleName(model), VehInfo[veh][v3dstat], PlayerInfo[i][pDrugPerk]);
				SendClientMessage(playerid, COLOR_GREY, string);
			}
		}
	}
	return 1;
}
CMD:lawyers(playerid)
{
	SendClientMessage(playerid, COLOR_LIGHTBLUE, " Адвокаты Онлайн:");
	new string[100];
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 0 || PlayerInfo[i][pMember] != 7) continue;

		if(GetAccessRankOrgMay(i, 7, 54, NO_FBI))
		{
			format(string, sizeof(string), "** %s Тел. {ff9000}%d", playername(i), PlayerInfo[i][pDrugPerk]);
			SendClientMessage(playerid, COLOR_GREY, string);
		}
	}
	return 1;
}
CMD:online(playerid, const params[]) return ShowDialog(playerid,67,DIALOG_STYLE_LIST,"{0088ff}...:::Online:::...","Лидеры\nПодчиненные\nАдминистраторы\nАдвокаты\nТаксисты","Выбрать","Отмена");
CMD:eject(playerid, const params[])
{
	new vehicleid = GetClosestVehicle(playerid);
	if(!IsValidVehicle(vehicleid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не нахожусь рядом с транспортом");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выкинуть из транспорта [ /eject ID ]");
	if(GetPlayerVehicleID(playerid) != vehicleid) { // Если игрок снаружи
		if(VehInfo[vehicleid][vCarLock]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сперва мне нужно открыть этот транспорт");
	} else { // Если игрок в автомобиле
		if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выкинуть из транспорта водителя..");
	}
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выкинуть из транспорта себя");
	if(howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сейчас я не могу это сделать..");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его нет вообще..");
	if(CheckPlayerNpc(playerid, params[0])) return 1;

	new string[144];
	if(GetPlayerVehicleID(params[0]) == vehicleid)
	{
		format(string, sizeof(string), "[ Мысли ]: Я выкинул%s %s из транспорта", gender(playerid), playername(params[0]));
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: %s выкинул%s вас из транспорта", playername(playerid), gender(playerid));
		SendClientMessage(params[0], COLOR_GREY, string);
		//format(string, sizeof(string), "%s выкидывает %s из транспорта", playername(playerid), playername(params[0]));
		//ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "выкинул%s из машины %s.", gender(playerid), playername(params[0]));
		SetPlayerChatBubble(playerid, string, COLOR_PURPLE,20.0,1500);
		RemovePlayerFromVehicle(params[0]);
		if(Stun[4][params[0]] >= 1 || Stun[5][params[0]] >= 1)
		{
			if(Stun[1][params[0]] == 0 && Stun[3][params[0]] == 0) TogglePlayerControllable(params[0], true);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он не находится со мной в одном транспорте");
	return 1;
}
CMD:incar(playerid, const params[])
{
	//if(PlayerInfo[playerid][pLevel] <= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно минимум 3 года проживания в штате [ 3 Level ]");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	new mycar = GetClosestVehicle(playerid);
	if (!IsValidVehicle(mycar)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не нахожусь рядом с машиной");
	if(GetPlayerVehicleID(playerid) != mycar && VehInfo[mycar][vCarLock]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сперва мне нужно открыть эту машину");
	new tmp[24],giveplayerid,string[144];
	if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посадить в машину [ /incar ID ]");
	giveplayerid = ReturnUser(tmp);
	if(giveplayerid == INVALID_PLAYER_ID || !IsOnline(giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сейчас я не могу это сделать..");
	if(!ProxDetectorS(10.0, playerid, giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он далеко от меня");
	if(GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && gSpectateID[giveplayerid] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он далеко от меня");
	if(CheckPlayerNpc(playerid, giveplayerid)) return 1;
	if(DeathInfo[giveplayerid][deathStatus]) return ErrorMessage(playerid,"{ff6347}Реанимируйте игрока, преждечем затолкать в транспорт");
	
 	if(howstun(giveplayerid))
	{
		if(IsACar(VehInfo[mycar][vModel]) || IsAPlane(VehInfo[mycar][vModel]))
		{
			if (PlayerInfo[giveplayerid][pJailed] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя затолкать в транспорт заключённого");
			if (IsPlayerInAnyVehicle(giveplayerid)) return format(string, sizeof(string), "[ Мысли ]: %s уже сидит в транспорте",playername(giveplayerid)), SendClientMessage(playerid, COLOR_GREY, string);
			
			new seats_count,
				model = VehInfo[mycar][vModel],
				empty_seatid = -1,
				bool: occupied_seats[3 + 1];

			if (model == 520 && PlayerInfo[playerid][pSoska] > 0) seats_count = 1;
			else seats_count = GetVehicleMaxPassengers(GetVehModelOriginal(model));

			if (seats_count >= 1 && seats_count <= 3)
   			{
				foreach(Player, i)
				{
			        if (GetPlayerVehicleID(i) != mycar) continue;

					for (new seatid = 1; seatid <= seats_count; seatid++) {
						if (GetPlayerVehicleSeat(i) == seatid) {
							occupied_seats[seatid] = true;
							break;
						}
					}
   				}
				for (new seatid = seats_count; seatid >= 1; seatid--) {
					if (!occupied_seats[seatid]) {
						empty_seatid = seatid;
						break;
					}
				}
			}
			if(Follow[giveplayerid] == playerid && Follow[playerid] == giveplayerid)
			{
				StopFollow(playerid);
			}
			if(empty_seatid == -1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу затолкать в этот транспорт");
			Protect_PutPlayerInVehicle(giveplayerid, mycar, empty_seatid); // Помещаем игрока на пассажирское место в автомобиле
	     	format(string, sizeof(string), "[ Мысли ]: Меня посадили в машину");
			SendClientMessage(giveplayerid, COLOR_GREY, string);
			format(string, sizeof(string), "[ Мысли ]: Я посадил%s %s в машину", gender(playerid), playername(giveplayerid));
			SendClientMessage(playerid, COLOR_GREY, string);
			//format(string, sizeof(string), "* %s затолкал%s в машину %s.", playername(playerid), gender(playerid), playername(giveplayerid));
			//ProxDetector(30.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
			format(string, sizeof(string), "затолкал%s в машину %s.", gender(playerid), playername(giveplayerid));
			SetPlayerChatBubble(playerid, string, COLOR_PURPLE,20.0,1500);
	  		if(Stun[4][giveplayerid] >= 1 || Stun[5][giveplayerid] >= 1) TogglePlayerControllable(giveplayerid, false);
 		}
 		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу посадить его только в автомобиль или вертолёт");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Прежде чем затолкать в машину, его нужно нейтрализовать [ наручники, бита, электрошокер ]");
	return 1;
}
CMD:cuff(playerid, const params[])
{
	new g = fraction(playerid);
	if (PlayerInfo[playerid][pSoska] < 2)
	{
		if(!IsAFunctionOrganization(37, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
		if(!GetAccessRankOrg(playerid, g, 37, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(PlayerInfo[playerid][pJailed] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я нахожусь в заключении");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заковать в наручники [ /cuff ID ]");
	if(CheckPlayerNpc(playerid, params[0])) return 1;
	if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем мне надевать наручники на самого себя?");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
	if(!ProxDetectorS(2.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
	if(GetPVarInt(params[0],"kas") >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он играет в казино");
	if(Stun[4][params[0]] >= 1) {
		// Наручники уже надеты - пытаемся снять
		new	tmp[5]; format(tmp, sizeof(tmp), "%d", params[0]);
		return pc_cmd_uncuff(playerid, tmp);
	}
	if(Stun[5][params[0]] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На нём смирительная рубашка");
	if(GetPVarInt(params[0],"afksystem") >= 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он спит..");
	if(IsACapt(params[0])) return ErrorMessage(playerid,"{FF6347}Подозреваемый находится в гетто\n{ffcc66}Работа на капте запрещена");
	if(IsPlayerInAnyVehicle(params[0]) && !IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не в транспорте с подозреваемым");
	if(!IsPlayerInAnyVehicle(params[0]) && IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый не со мной в транспорте");
	new mojno = 0;
	if(!IsPlayerInAnyVehicle(params[0]) && !IsPlayerInAnyVehicle(playerid)) mojno = 1;
	if(IsPlayerInAnyVehicle(playerid))
	{
		new car = GetPlayerVehicleID(playerid);
		if(IsPlayerInAnyVehicle(playerid) && IsPlayerInVehicle(params[0], car))
		{
			if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу заковать в наручники водителя");
			mojno = 1;
		}
	}
	if(mojno == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подозреваемый не со мной в транспорте");

	new string[114];
	if(PlayerInfo[playerid][pSex] == 1)
	{
		format(string, sizeof(string), "[ Мысли ]: На меня надел наручники {33CCFF}%s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
		//SendClientMessage(params[0], COLOR_LIGHTBLUE, "* Вы сломаете наручники через: 3 минуты");
		format(string, sizeof(string), "[ Мысли ]: Я надел наручники на {33CCFF}%s [ Снять - /uncuff ]", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "* %s снял наручники с пояса и надел их на %s", playername(playerid),playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "снял наручники с пояса и надел их на %s", playername(params[0]));
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	}
	else
	{
		format(string, sizeof(string), "[ Мысли ]: На меня надела наручники {33CCFF}%s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
		//SendClientMessage(params[0], COLOR_LIGHTBLUE, "* Вы сломаете наручники через: 3 минуты");
		format(string, sizeof(string), "[ Мысли ]: Я надела наручники на {33CCFF}%s [ Снять - /uncuff ]", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "* %s сняла наручники с пояса и надела их на %s", playername(playerid) ,playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "сняла наручники с пояса и надела их на %s", playername(params[0]));
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	}
	if(NoAnim[params[0]] == 0) ApplyAnimation(params[0], "GYMNASIUM", "gym_jog_falloff", 4.0, false, true, true, false, false, SYNC_ALL);
	CuffedPlayer(params[0], playerid);

	// Сообщение по радиоперехватчику
	{
		new findraiontolist = FindRaionPos(Protect_X[params[0]], Protect_Y[params[0]], Protect_Z[params[0]]);
		format(string, sizeof(string), "Сообщение о задержании: %s [Район: %s]", rpplayername(params[0]), gSAZones[findraiontolist][zName]);
		RadioInterceptor_SendMessage(RADIO_INTERCEPTOR_STATE_CUFF, 0xFFA07AFF, string, .excludeid = params[0]);
	}

	return 1;
}
stock CuffedPlayer(playerid, giveplayerid = INVALID_PLAYER_ID)
{
	GameTextForPlayer(playerid, "~r~Cuffed", 3000, 4);
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
	SetPlayerAttachedObject(playerid, 0, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	Stun[4][playerid] = 1;
	StunTime[4][playerid] = 180;
	CuffedId[playerid] = giveplayerid;
	PlayerPlaySound(playerid, 36401, 0,0,0);
	if (IsOnline(giveplayerid)) PlayerPlaySound(giveplayerid, 36401, 0,0,0);
	if(Stun[0][playerid] >= 1)
	{
		TextDrawHideForPlayer(playerid, MindDraw[0]);
		TextDrawHideForPlayer(playerid, MindDraw[1]);
		TextDrawHideForPlayer(playerid, MindDraw[2]);
		PlayerTextDrawHide(playerid, MindDraw1);
		TogglePlayerControllable(playerid, true);
		Stun[0][playerid] = 0;
		StunTime[0][playerid] = 0;
	}
	if(IsPlayerInAnyVehicle(playerid)) TogglePlayerControllable(playerid, false);
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
	return 1;
}
CMD:uncuff(playerid, const params[])
{
	new g = fraction(playerid);
	if (PlayerInfo[playerid][pSoska] < 2)
	{
		if(!IsAFunctionOrganization(37, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
		if(!GetAccessRankOrg(playerid, g, 37, PlayerInfo[playerid][pFbi])) return 1;
	}

	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять наручники [ /uncuff ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Эм.. что?");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
	if(howstun(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо..");
	if(Stun[4][params[0]] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На нём нет наручников");

	new string[114];
	if(PlayerInfo[playerid][pSex] == 1)
	{
		format(string, sizeof(string), "[ Мысли ]: С меня снял наручники %s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: Я снял наручники с %s", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "* %s снял наручники с %s", playername(playerid) ,playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "снял наручники с %s", playername(params[0]));
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	}
	else
	{
		format(string, sizeof(string), "[ Мысли ]: С меня сняла наручники %s", playername(playerid)), SendClientMessage(params[0], COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: Я сняла наручники с %s", playername(params[0])), SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "* %s сняла наручники с %s", playername(playerid) ,playername(params[0]));
		ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		format(string, sizeof(string), "сняла наручники с %s", playername(params[0]));
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	}

	// Отпускаем
	if(FollowTime[params[0]] != 9999) StopFollow(params[0]);

	GameTextForPlayer(params[0], "~g~Uncuffed", 3000, 4);
	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(params[0],0);
	if(Stun[1][params[0]] == 0 && Stun[3][params[0]] == 0) TogglePlayerControllable(params[0], true);
	Stun[4][params[0]] = 0;
	StunTime[4][params[0]] = 0;
	CuffedId[params[0]] = 9999;
	return 1;
}
CMD:stun(playerid, const params[])
{
	new g = fraction(playerid);
	if (PlayerInfo[playerid][pSoska] < 2)
	{
		if(!IsAFunctionOrganization(38, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не работаете в ASGH");
		if(!GetAccessRankOrg(playerid, g, 38, NO_FBI)) return 1;
	}

	if(CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Вы смотрите CNN Channel");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Надеть смирительную рубашку [ /stun ID ]");
	if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(params[0]==playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете надеть смирительную рубашку на самого себя");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(!ProxDetectorS(2.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(CheckPlayerNpc(playerid, params[0])) return 1;
	if(GetPVarInt(params[0],"kas") >= 1) return ErrorMessage(playerid, "{FF6347}Он играет в казино\n{cccccc}Дождитесь завершения его игры");
	if(Stun[5][params[0]] >= 1) return ErrorMessage(playerid, "{FF6347}Он уже в смирительной рубашке [ /unstun ]");
	if(Stun[4][params[0]] >= 1) return ErrorMessage(playerid, "{FF6347}Он в наручниках");
	if(GetPVarInt(params[0],"afksystem") >= 5) return ErrorMessage(playerid, "{FF6347}Игрок AFK");
	if(IsACapt(params[0])) return ErrorMessage(playerid,"{FF6347}Подозреваемый находится в гетто\n{ffcc66}Работа на капте запрещена");
	if(IsPlayerInAnyVehicle(params[0]) && !IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Пациент не в вашем транспорте");
	if(!IsPlayerInAnyVehicle(params[0]) && IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Пациент не в вашем транспорте");
	new mojno = 0;
	if(!IsPlayerInAnyVehicle(params[0]) && !IsPlayerInAnyVehicle(playerid)) mojno = 1;
	if(IsPlayerInAnyVehicle(playerid))
	{
		new car = GetPlayerVehicleID(playerid);
		if(IsPlayerInAnyVehicle(playerid) && IsPlayerInVehicle(params[0], car))
		{
			if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Вы не можете надеть смирительную рубашку на водителя");
			mojno = 1;
		}
	}
	if(mojno == 0) return ErrorMessage(playerid, "{FF6347}Пациент не в вашем транспорте");

	new string[114];
	SendClientMessage(params[0], COLOR_GREY, "[ Мысли ]: %s надел%s на меня смирительную рубашку", playername(playerid), gender(playerid));
	SendClientMessage(params[0], COLOR_LIGHTBLUE, "* Вы самостоятельно высвободитесь через: 3 минуты");
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я надел%s смирительную рубашку на {33CCFF}%s {cccccc}[ Снять - /unstun ]", gender(playerid), playername(params[0]));
	format(string, sizeof(string), "* %s надел%s смирительную рубашку на %s", playername(playerid), gender(playerid), playername(params[0]));
	ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	format(string, sizeof(string), "надел%s смирительную рубашку на %s", gender(playerid), playername(params[0]));
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);

	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_CUFFED);
	ApplyAnimation(params[0], "GYMNASIUM", "gym_jog_falloff",4.0, false, true, true, false, false, SYNC_ALL);
	SetPlayerAttachedObject(params[0], 0, 2060, 1, -0.050999, 0.029000, 0.004000, -88.699867, 0.000000, 0.000000, 0.732999, 1.151000, 1.570999, 0, 0);
	Stun[5][params[0]] = 1;
	StunTime[5][params[0]] = 180;
	CuffedId[params[0]] = playerid;
	PlayerPlaySound(playerid, 36401, 0,0,0);
	PlayerPlaySound(params[0], 36401, 0,0,0);
	if(Stun[1][params[0]] >= 1)
	{
		TextDrawHideForPlayer(params[0], MindDraw[0]);
		TextDrawHideForPlayer(params[0], MindDraw[1]);
		TextDrawHideForPlayer(params[0], MindDraw[2]);
		PlayerTextDrawHide(params[0], MindDraw1);
		TogglePlayerControllable(params[0], true);
		Stun[1][params[0]] = 0;
		StunTime[1][params[0]] = 0;
	}
	if(IsPlayerInAnyVehicle(params[0])) TogglePlayerControllable(params[0], false);
	if(OnlineInfo[params[0]][oShowInterface] == 1) CloseFrisk(params[0]), CancelSelectTextDraw(params[0]);
	return 1;
}

CMD:unstun(playerid, const params[])
{
	new g = fraction(playerid);
	if (PlayerInfo[playerid][pSoska] < 2)
	{
		if(!IsAFunctionOrganization(38, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не работаете в ASGH");
		if(!GetAccessRankOrg(playerid, g, 38, NO_FBI)) return 1;
	}

	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять смирительную рубашку [ /unstun ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
	if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете снять с себя смирительную рубашку");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(Stun[5][params[0]] == 0) return ErrorMessage(playerid, "{FF6347}На нём нет смирительной рубашки");

	new string[114];
	SendClientMessage(params[0], COLOR_GREY, "[ Мысли ]: %s снял%s с меня смирительну рубашку", playername(playerid), gender(playerid));
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я снял%s смирительную рубашку с %s", gender(playerid), playername(params[0]));
	format(string, sizeof(string), "* %s снял%s смирительную рубашку с %s", playername(playerid), gender(playerid), playername(params[0]));
	ProxDetector(20.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	format(string, sizeof(string), "снял%s смирительную рубашку с %s", gender(playerid), playername(params[0]));
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);

	// Отпускаем
	if(FollowTime[params[0]] != 9999) StopFollow(params[0]);

	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(params[0],0);
	if(Stun[1][params[0]] == 0 && Stun[3][params[0]] == 0) TogglePlayerControllable(params[0], true);
	Stun[5][params[0]] = 0;
	StunTime[5][params[0]] = 0;
	CuffedId[params[0]] = 9999;
	return 1;
}

CMD:maketaxi(playerid, const params[])
{
	new para1,string[128],est = 0;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new veh = GetPlayerVehicleID(playerid);
		if(VehInfo[veh][v3dstat] >= 1 && VehInfo[veh][v3dstat] <= 900) est = 1;
	}
	if(PlayerInfo[playerid][pMember] != 1 && PlayerInfo[playerid][pLeader] != 1 && PlayerInfo[playerid][pMember] != 4 && PlayerInfo[playerid][pLeader] != 4
	&& PlayerInfo[playerid][pMember] != 11 && PlayerInfo[playerid][pLeader] != 11 && PlayerInfo[playerid][pMember] != 21 && PlayerInfo[playerid][pLeader] != 21 && est == 0) return ErrorMessage(playerid, "{FF6347}Вы не полицейский, не сотрудник ASGH и не таксист");
	if (sscanf(params, "u", para1)) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Принять вызов [ /maketaxi ID ]");

	if(GetPVarInt(para1, "Service") == 0) return ErrorMessage(playerid, "{FF6347}Этот гражданин никого не вызывал");
	if(!IsOnline(para1)) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");

	if(est == 1)
	{
		new model = VehInfo[GetPlayerVehicleID(playerid)][vModel];
		if(GetPVarInt(para1, "Service") != 4) return ErrorMessage(playerid, "{FF6347}Этот гражданин не вызывал такси");
		format(string, sizeof(string), " {AFAFAF}Вызов принят! к вам подъедет автомобиль {ccffff}%s [ Водитель: %s ]", GetVehicleName(model),playername(playerid));
		SendClientMessage(para1, COLOR_GREY, string);
		PlayerPlaySound(para1,6400,0,0,0);
		SetPVarInt(playerid,"GP",1);
		SetPlayerCheckpoint(playerid,SpX[para1],SpY[para1],SpZ[para1],2.0);
		format(string, sizeof(string), " {0088ff}[ {ffffff}Карта {0088ff}]{ffffff}: {0088ff}Вызов %s {ffffff}отмечен на карте",playername(para1));
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		PlayerPlaySound(playerid,6400,0,0,0);
	}
	SetPVarInt(para1, "Service",0);
 	return 1;
}

CMD:poisk(playerid)
{
 	if(PlayerInfo[playerid][pSoska] >= 2 || PlayerInfo[playerid][pLeader] == 4 || PlayerInfo[playerid][pMember] == 4)
  	{
        new str[214],sctring[4096],kol;
		format(str,sizeof(str),"{cccccc}Выполняйте поиск больных с помощью /find"), strcat(sctring,str);
		foreach (Player, i)
     	{
			if(OnlineInfo[playerid][oLogged] == 1 && PlayerInfo[i][pAmmos2] >= 50 && PlayerInfo[i][pJailed] == 0)
			{
				format(str,sizeof(str),"\n{ff9000}%s[%d] {cccccc}Ур. Опасности: %d", rpplayername(i), i, PlayerInfo[i][pAmmos2]), strcat(sctring,str);
				kol++;
			}
		}
   		ShowDialog(playerid,1505,DIALOG_STYLE_TABLIST_HEADERS,"{FFFFFF}Психически Больные {00FF00}Online",sctring,"Ок","");
   		if(kol == 0) ErrorMessage(playerid, "{FF6347}Сейчас нет психически больных");
	}
	return 1;
}

CMD:jailed(playerid)
{
 	if(IsPoliceMember(playerid) || PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pFbi] >= 1 || PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 && PlayerInfo[playerid][pRank] >= 7)
  	{
  		if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
        new str[214], sctring[4096], qwer[74], year, month, day, kol,quan;
		getdate(year, month, day);
        format(str,sizeof(str),"{cccccc}Имя\t{FF6347}Осталось\t{ff9000}Заключение\n"), strcat(sctring,str);
		foreach (Player, i)
     	{
			if(quan >= 200) break;
			List[quan][playerid] = 0;
     	    if(OnlineInfo[i][oLogged] == 1 && PlayerInfo[i][pJailed] > 0)
     	    {
            	if(PlayerInfo[i][pJailed] == 1) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{444444}Тюрьма\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
				if(PlayerInfo[i][pJailed] == 5) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{444444}Тюрьма Карцер\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
				if(PlayerInfo[i][pJailed] == 3) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{444444}КПЗ LSPD\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
				if(PlayerInfo[i][pJailed] == 9) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{444444}КПЗ SFPD\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
				if(PlayerInfo[i][pJailed] == 4) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}Лечение\t{ff6666}Госпиталь\n", rpplayername(i), i), strcat(sctring,str),kol++;
				if(PlayerInfo[i][pJailed] == 8) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{ff6666}Госпиталь\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
				if(PlayerInfo[i][pJailed] == 6) format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{ff6666}Психбольница\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
				if(PlayerInfo[playerid][pSoska] >= 1)
				{
	                if(PlayerInfo[i][pJailed] == 2)  format(str,sizeof(str),"{cccccc}%s[%d]\t{FF6347}%s\t{ff0000}Prison Danger\n", rpplayername(i), i, fine_time(PlayerInfo[i][pJailTime])), strcat(sctring,str),kol++;
	            }
				List[quan][playerid] = i;
				quan++;
    		}
		}
		format(qwer,sizeof(qwer),"{ff9000}Заключённые [%d] {99ff66}Online {cccccc}[%02d.%02d.%d]",kol,day,month,year);
   		ShowDialog(playerid,1482,DIALOG_STYLE_TABLIST_HEADERS,qwer,sctring,"Ок","");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не работаю в законной организации");
	return 1;
}

CMD:release(playerid, const params[])
{
	new currentid;
	if (sscanf(params, "u", currentid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отпустить подозреваемого в качестве поощрения [ /release ID ]");
	if (!IsOnline(currentid)) return ErrorMessage(playerid, "{FF6347}Игрок не в сети");
	if (currentid == playerid) return ErrorMessage(playerid, "{FF6347}Нельзя отпустить самого себя");

	if (PlayerInfo[playerid][pSoska] < 6)
	{
		if (!IsPoliceMember(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не полицейский");
		if (GetDistanceBetweenPlayers(playerid, currentid) > 5) return ErrorMessage(playerid, "{FF6347}Необходимо находиться рядом с игроком");
	}
	if (!IsPlayersNearArestPosition(playerid, currentid)) return ErrorMessage(playerid, "{FF6347}Отпустить преступника можно возле камер заключения или в зоне ареста");

	new quan = ClearAllWantedPlayer(currentid);
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Гражданин не находится в розыске");

	new string[144];
	format(string, sizeof(string), "{ffffff}[ {0088ff}LEADER {ffffff}] Гражданин {0088ff}%s {ffffff}отпущен в качестве поощрения", rpplayername(currentid));
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "[ Мысли ]: {99ff66}%s {cccccc}вычеркнул меня из списка разыскиваемых преступников", PlayerInfo[playerid][pName]);
	SendClientMessage(currentid, COLOR_GREY, string);

	format(string, sizeof(string), "[DEP]: %s[%d] снимает розыск с обвиняемого %s[%d] в качестве поощрения", PlayerInfo[playerid][pName],playerid, rpplayername(currentid), currentid);
	SendDepartMessage(COLOR_ALLDEPT, string);

	DestroyPursuit(currentid);
	OrgLog(fraction(playerid), "release", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[currentid][pID], PlayerInfo[currentid][pName], PlayerInfo[currentid][pPlaIP], 0, "");
	
	GivePlayerUnit(playerid, floatround(float(OrganInfo[PlayerInfo[playerid][pMember]][gUnit][2]) * 1.5) );

	return 1;
}

CMD:clear(playerid,const params[])
{
	new giveplayerid, string[145], result[44];
	new available_fractions[] = {1, 2, 3, 7, 11, 21, 22};
	new bool: is_have_access = false;
	for (new i = 0; i < sizeof(available_fractions); i++) {
		new fractionid = available_fractions[i];
		if (PlayerInfo[playerid][pLeader] == fractionid || PlayerInfo[playerid][pMember] == fractionid && PlayerInfo[playerid][pRank] >= get_maxrank(fractionid) - 1) {
			is_have_access = true;
			break;
		}
	}
	if (!is_have_access && PlayerInfo[playerid][pSoska] < 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	
	if (sscanf(params, "is[44]",giveplayerid,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Очистить розыск [ /clear ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(!IsOnline(giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");

	new quan = ClearAllWantedPlayer(giveplayerid);
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Гражданин не находится в розыске");

	format(string, sizeof(string), "{ffffff}[ {0088ff}LEADER {ffffff}] Гражданину {0088ff}%s {ffffff}очищен уровень розыска", rpplayername(giveplayerid));
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "[ Мысли ]: {99ff66}%s {cccccc}вычеркнул меня из списка разыскиваемых преступников", PlayerInfo[playerid][pName]);
	SendClientMessage(giveplayerid, COLOR_GREY, string);

	format(string, sizeof(string), "[DEP]: %s[%d] снимает розыск с обвиняемого %s[%d]. По причине: %s", PlayerInfo[playerid][pName],playerid, rpplayername(giveplayerid),giveplayerid,result);
	SendDepartMessage(COLOR_ALLDEPT, string);

	DestroyPursuit(giveplayerid);
	OrgLog(fraction(playerid), "clear", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "");

	return 1;
}
stock fineparking(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,10.0,-1681.4595,710.5051,24.8906) || IsPlayerInRangeOfPoint(playerid,10.0,1598.9126,-1626.2933,13.4538) || IsPlayerInRangeOfPoint(playerid,10.0,2267.2634,2051.0439,10.8203)
 	|| IsPlayerInRangeOfPoint(playerid,10.0,2509.7461,2532.0371,10.8203))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new g = fraction(playerid), r = PlayerInfo[playerid][pRank];
			if(g == 1 || g == 11 || g == 21 || g == 22 || g == 7 && (r == 10 || r == 11 || r == 12 || r == 13 || r == 17 || r >= 20) || PlayerInfo[playerid][pSoska] >= 2)
 			{
				new veh = GetPlayerVehicleID(playerid);
			    if(VehInfo[veh][vModel] != 525) return ErrorMessage(playerid, "{FF6347}Вам необходимо быть за рулём эвакуатора [ Towcar ]");
				if(!IsTrailerAttachedToVehicle(veh)) return ErrorMessage(playerid, "{FF6347}На буксире нет арестованного транспорта");
				new tug = GetVehicleTrailer(veh);
				if(tug == INVALID_VEHICLE_ID) return ErrorMessage(playerid, "{FF6347}Ошибка! Этого транспорта не существует");
				if(Cars[tug] != 88) return ErrorMessage(playerid, "{FF6347}Отправить на штраф стоянку можно только личный транспорт");
				if(VehInfo[tug][vFine] < gettime()) return ErrorMessage(playerid, "{FF6347}Вам необходимо оформить арест транспорта [ /arestcar ]");
				send_arestcar(playerid, tug, 0, -1);
			}
			else ErrorMessage(playerid, "{FF6347}Вы не имеете права арестовать транспорт");
		}
	}
	return 1;
}
CMD:unarestcar(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять арест с транспорта [ /unarestcar ID ]");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	if(playerid == params[0] && PlayerInfo[playerid][pSoska] <= 12) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу снять арест со своего транспорта");
	if(params[0] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID || !ProxDetectorS(5.0, playerid,params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко..");
	PlayerPlaySound(playerid,40405,0,0,0);

	DP[0][playerid] = 0;
	DP[1][playerid] = params[0];

	new line[100],lines[2000];
	for(new i = 0; i < MAX_MYVEHICLE; i++)
	{
		if(PlayerInfo[params[0]][pMyVeh][i] > 0) format(line,sizeof(line),"{0088ff}[ %d ] {ff9000}%s\n", i + 1, GetVehicleName(PlayerInfo[params[0]][pMyVeh][i])), strcat(lines,line);
		else format(line,sizeof(line),"{0088ff}[ %d ] {cccccc}Нет\n", i + 1), strcat(lines,line);
	}
	ShowDialog(playerid,995,DIALOG_STYLE_LIST,"{ff9000}Отмена Ареста Транспорта",lines,"Выбор","Отмена");
	return 1;
}
CMD:finecar(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,2262.5549,2039.3546,10.8203))
	{
		if(GetPVarInt(playerid,"stopload") >= 1) return 1;
		PlayerPlaySound(playerid,40405,0,0,0);
		new line[100],lines[2000];

		new quan;
		for(new i = 0; i < MAX_MYVEHICLE; i++)
		{
			if(PlayerInfo[playerid][pMyVeh][i] > 0)
        	{
				List[quan][playerid] = i;
				quan ++;
				format(line,sizeof(line),"{0088ff}[ %d ] {ff9000}%s\n", i + 1, GetVehicleName(PlayerInfo[playerid][pMyVeh][i])), strcat(lines,line);
			}
		}
		ShowDialog(playerid,964,DIALOG_STYLE_TABLIST,"{ff9000}Штраф Стоянка",lines,"Выбор","Отмена");
	}
	return 1;
}
CMD:arestcar(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		new g = fraction(playerid);
		if(!IsAFunctionOrganization(46, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
		if(!GetAccessRankOrg(playerid, g, 46, NO_FBI)) return 1;
	}

	new veh = GetPlayerVehicleID(playerid), string[144];
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && VehInfo[veh][vModel] == 525 && IsTrailerAttachedToVehicle(veh))
	{
		new tug = GetVehicleTrailer(veh);
		if(tug == INVALID_VEHICLE_ID) return ErrorMessage(playerid, "{FF6347}Ошибка! Этого транспорта не существует");
		if(Cars[tug] != 88) return ErrorMessage(playerid, "{FF6347}Отправить на штраф стоянку можно только личный транспорт");
		if(VehInfo[tug][vFine] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт уже арестован и отправляется на штраф стоянку");
		new reason[121];
		if(sscanf(params, "iis[121]", params[0], params[1], reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отправить на штраф стоянку личный транспорт [ /arestcar Время Залог Причина ]");
		if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		if(params[0] < 1 || params[0] > 10) return ErrorMessage(playerid, "{FF6347}Время ареста от 1 до 10 дней");
		if(params[1] < 1 || params[1] > 50000) return ErrorMessage(playerid, "{FF6347}Стоимость залога не менее 1$ не более 50.000$");
		if(strlen(reason) > 60) return ErrorMessage(playerid, "{FF6347}Слишком длинная причина.. [ Лимит 60 символов ]");
		new unixtime = gettime();
		VehInfo[tug][vFine] = unixtime+params[0]*86400;
		VehInfo[tug][vFineLien] = params[1];
		VehInfo[tug][vFineTime] = unixtime;
		new strong[64];
		format(strong, sizeof(strong), reason);
		strmid(VehInfo[tug][vFineReason], strong, 0, strlen(strong), 64);
		format(strong, sizeof(strong), PlayerInfo[playerid][pName]);
		strmid(VehInfo[tug][vFineName], strong, 0, strlen(strong), 64);
		format(string, sizeof(string), "[ Мысли ]: Транспорт арестован {ff9000}[ %d Дней | {99ff66}%d$ Залог {ff9000}| Причина: {444444}%s {ff9000}]", params[0], params[1], reason);
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "[ Мысли ]: Нужно доставить транспорт в зону ареста, чтобы получить (20 проц. от залога) {99ff66}[ %d$ ]", params[1]/100*20);
		SendClientMessage(playerid, COLOR_GREY, string);
		PlayerPlaySound(playerid,6401,0,0,0);
		new s = VehInfo[tug][vIdvlad];
		if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("arestcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[s][pID], PlayerInfo[s][pName], PlayerInfo[s][pPlaIP], params[0], reason);
		else OrgLog(fraction(playerid), "arestcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[s][pID], PlayerInfo[s][pName], PlayerInfo[s][pPlaIP], params[0], reason);
	}
	else
	{
		new reason[64];
		if(sscanf(params, "iiis[64]", params[0], params[1], params[2], reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отправить на штраф стоянку личный транспорт [ /arestcar VehID Время Залог Причина ]");
		if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		if(params[0] < 1 || params[0] > 1999) return ErrorMessage(playerid, "{FF6347}Ошибка! Этого транспорта не существует");
		if(params[0] == INVALID_VEHICLE_ID) return ErrorMessage(playerid, "{FF6347}Ошибка! Этого транспорта не существует");
		if(Cars[params[0]] != 88) return ErrorMessage(playerid, "{FF6347}Отправить на штраф стоянку можно только личный транспорт");
		if(VehInfo[params[0]][vFine] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт уже арестован и отправляется на штраф стоянку");
		if(params[1] < 1 || params[1] > 10) return ErrorMessage(playerid, "{FF6347}Время ареста от 1 до 10 дней");
		if(params[2] < 1 || params[2] > 50000) return ErrorMessage(playerid, "{FF6347}Стоимость залога не менее 1$ не более 50.000$");
		if(strlen(reason) > 60) return ErrorMessage(playerid, "{FF6347}Слишком длинная причина.. [ Лимит 60 символов ]");
		if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от транспорта");
		new Float:X,Float:Y,Float:Z;
		GetVehiclePos(params[0], X, Y, Z);
		if(!IsPlayerInRangeOfPoint(playerid, 10.0, X, Y, Z)) return ErrorMessage(playerid, "{FF6347}Вы далеко от транспорта");
		new s = VehInfo[params[0]][vIdvlad];
		if(PlayerInfo[playerid][pSoska] >= 1) AdminLog("arestcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[s][pID], PlayerInfo[s][pName], PlayerInfo[s][pPlaIP], params[1], reason);
		else OrgLog(fraction(playerid), "arestcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[s][pID], PlayerInfo[s][pName], PlayerInfo[s][pPlaIP], params[1], reason);
		new unixtime = gettime();
		VehInfo[params[0]][vFine] = unixtime+params[1]*86400;
		VehInfo[params[0]][vFineLien] = params[2];
		VehInfo[params[0]][vFineTime] = unixtime;
		new strong[64];
		format(strong, sizeof(strong), reason);
		strmid(VehInfo[params[0]][vFineReason], strong, 0, strlen(strong), 64);
		format(strong, sizeof(strong), PlayerInfo[playerid][pName]);
		strmid(VehInfo[params[0]][vFineName], strong, 0, strlen(strong), 64);
		send_arestcar(playerid, params[0], 1, params[1]);
	}
	return 1;
}

stock IsPlayersNearArestPosition(playerid, giveplayerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 6.0, 987.3389,2713.2466,901.9059) || IsPlayerInRangeOfPoint(playerid, 6.0, 983.6774,2713.3418,901.9059)
	|| IsPlayerInRangeOfPoint(playerid, 6.0, 1572.8442,-1666.5383,6.2508) && GetPlayerVirtualWorld(playerid) == 257 || IsPlayerInRangeOfPoint(playerid, 6.0, -1953.1715,2347.6687,1549.6833)
	|| IsPlayerInRangeOfPoint(playerid, 6.0, -1617.6615,719.8404,-4.8892) && GetPlayerVirtualWorld(playerid) == 208 || IsPlayerInRangeOfPoint(playerid, 6.0, 2710.6975,930.8117,1501.0000)
	|| IsPlayerInRangeOfPoint(playerid, 6.0, 972.8834,2418.6482,10.8503) && GetPlayerVirtualWorld(playerid) == WORLD_PRISON_1LVL && GetPlayerInterior(playerid) == INT_PRISON_1LVL
	|| IsPlayerInRangeOfPoint(playerid, 6.0, 150.4520,1929.8372,19.2984) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
	{
		return true;
	}
	for(new c = 0; c < MAX_CARS; c++)
	{
		if(VehInfo[c][vObjstat] == 2)
		{
			new Float: X, Float: Y, Float: Z;
			GetVehiclePos(c, X, Y, Z);
			if(IsPlayerInRangeOfPoint(giveplayerid, 8.0, X, Y, Z)) { return true; }
		}
	}
	if(IsPlayerInVehicle(giveplayerid, GetPlayerVehicleID(playerid))) {
		if(IsPlayerInRangeOfPoint(playerid, 10.0, 1560.5383,-1694.1886,5.8906) || IsPlayerInRangeOfPoint(playerid, 10.0, -1589.6813,707.8725,-5.2344) || IsPlayerInRangeOfPoint(playerid, 10.0, 2113.0354,2429.6821,10.8203)) {
			return true;
		}
	}
	return false;
}

alias:arest("arrest")
CMD:arest(playerid, const params[])
{
	new giveplayerid;
 	if (!sscanf(params, "u",giveplayerid))
  	{
		if(IsPoliceMember(playerid) 
			|| PlayerInfo[playerid][pFbi] >= 1 
			|| PlayerInfo[playerid][pMember] == 3)
		{
			if(giveplayerid == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете арестовать себя");
			if(IsOnline(giveplayerid))
			{
				if(GetDistanceBetweenPlayers(playerid,giveplayerid) < 5)
				{
					if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете арестовать преступника сидя в транспорте");
					if(GetPlayerSpeed(playerid) > 3) return ErrorMessage(playerid, "{FF6347}Вы не можете арестовать преступника во время движения");

					if(PlayerInfo[playerid][pMember] == 3 && !IsPlayerInRangeOfPoint(playerid, 6.0, 150.4520,1929.8372,19.2984)) return ErrorMessage(playerid, "{FF6347}Вы можете арестовать только на базе NGSA");

					if(IsPlayersNearArestPosition(playerid, giveplayerid))
					{
						if(PlayerInfo[giveplayerid][pJailed] == 0)
						{
  							if(PlayerInfo[giveplayerid][pCrimes] < 1) return ErrorMessage(playerid, "{FF6347}У подозрваемого нет розыска");
  							ArestPlayer(giveplayerid, playerid, AREST_TYPE_NORMAL_FOOT);
						}
						else ErrorMessage(playerid, "{FF6347}Вы не можете посадить заключённого");
					}
					else ErrorMessage(playerid, "{FF6347}Посадить преступника можно возле камер заключения или в зоне ареста");
				}
			}
			else ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
		}
		else ErrorMessage(playerid, "{FF6347}Вы не ментяра");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посадить преступника [ /arest ID ]");
	return 1;
}

CMD:inarest(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 10.0, 1560.5383,-1694.1886,5.8906) || IsPlayerInRangeOfPoint(playerid, 10.0, -1589.6813,707.8725,-5.2344) || IsPlayerInRangeOfPoint(playerid, 10.0, 2113.0354,2429.6821,10.8203))
	{
		if(IsPoliceMember(playerid) || PlayerInfo[playerid][pFbi]>=1)
		{
  			if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
			ShowDialog(playerid,393,DIALOG_STYLE_INPUT,"{cccccc}Введите ID игрока","{cccccc}Введите {ff9000}ID игрока{cccccc}, чтобы посадить его в {ff0000}тюрьму","Принять","Отмена");
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не сотрудник правоохранительных органов");
	}
 	return 1;
}
CMD:gopsih(playerid, const params[])
{
    if(IsPlayerInRangeOfPoint(playerid,2.0,1391.4840,-12.2090,1000.9217) || IsPlayerInRangeOfPoint(playerid,2.0,1218.2517,-1354.6871,2001.0449))
 	{
        if(PlayerInfo[playerid][pAmmos2] >= 50)
		{
			if(PlayerInfo[playerid][pJailed] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я беглый заключённый или уже нахожусь под стражей..");
            new str[100],sctring[400];
            format(str,sizeof(str),"\n\n{ffffff}Здраствуйте! Посмотрим что тут у нас...");
            strcat(sctring,str);
            format(str,sizeof(str),"\n{cccccc}Имя Фамилия: {ff3333}%s",PlayerInfo[playerid][pName]);
            strcat(sctring,str);
            format(str,sizeof(str),"\n{cccccc}Возраст: {ff3333}%d",PlayerInfo[playerid][pAge]);
            strcat(sctring,str);
            format(str,sizeof(str),"\n{cccccc}Уровень Неадекватности: {ff3333}%d",PlayerInfo[playerid][pAmmos2]);
            strcat(sctring,str);
            format(str,sizeof(str),"\n{ffffff}Вам придётся пройти обследование: {ff3333}%d секунд",PlayerInfo[playerid][pAmmos2]*7);
            strcat(sctring,str);
            ShowDialog(playerid,873,DIALOG_STYLE_MSGBOX,"{ff6666}Госпиталь",sctring,"Согласиться","Бежать");
        }
        else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я адекватный человек и не собираюсь обследоваться в психиатрии");
    }
    return 1;
}
CMD:contract(playerid,const params[])
{
 	if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Пожелать смерти человеку [ /contract ID сумма ]");
	if(params[1] < 5000 || params[1] > 1000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 5000$ и не больше 1000000$");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[params[0]][pLevel] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я его совсем не знаю.. Как я могу желать ему смерти? [ 2+ Level ]");
	if(PlayerInfo[playerid][pMoney] <= params[1]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает денег");
	if(PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нет смысла назначать контракты, я убийца");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слуга дьявола и только он может направить меня на убийство");
	new string[144];
	if(PlayerInfo[params[0]][pMember] == 8 || PlayerInfo[params[0]][pLeader] == 8)
	{
		if(gHitMoney[playerid] == 0)
		{
			format(string, sizeof(string), "{8B8B8B}Агентство: {FF0000}новый контракт {8B8B8B}%s{FF0000}, сумма {8B8B8B}%d$ [ /goc принять ][ /givec поручить ]", PlayerInfo[playerid][pName], params[1]);
			SendRadioMessage(8,COLOR_YELLOW, string);
		}
		gHitMoney[playerid] += params[1];
	}
	else
	{
		if(PlayerInfo[params[0]][pTeam] > gettime()) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На него недавно было покушение. Зачем я буду ломать ему жизнь? [ Один раз в 60 минут ]");
		if(gHitMoney[params[0]] == 0)
		{
			format(string, sizeof(string), "{8B8B8B}Агентство: {FF0000}новый контракт {8B8B8B}%s{FF0000}, сумма {8B8B8B}%d$ [ /goc принять ][ /givec поручить ]", PlayerInfo[params[0]][pName], params[1]);
			SendRadioMessage(8,COLOR_YELLOW, string);
		}
		gHitMoney[params[0]] += params[1];
	}
	format(string, sizeof(string), "[ Мысли ]: Да, чтоб %s сдох ко всем чертям! {ff0000}[ -%d$ ]",rpplayername(params[0]), params[1]);
 	SendClientMessage(playerid, COLOR_GREY, string);
	oGivePlayerMoney(playerid, -params[1]);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	MoneyLog("contract", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], -params[1], "Заказал Жертву");
	return 1;
}
CMD:contractas(playerid)
{
    new g = fraction(playerid);
	if(!IsAFunctionOrganization(67, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
	if(!GetAccessRankOrg(playerid, g, 67, NO_FBI)) return 1;

	new str[130],sctring[4000];
	PlayerPlaySound(playerid,40405,0,0,0);
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && gHitMoney[i] >= 1 && gHitID[i] == 9999)
		{
			format(str,sizeof(str),"{444444}* {ff9000}%s[%d] {444444}| Сумма: {99ff66}%d$\n",rpplayername(i),i,gHitMoney[i]);
			strcat(sctring,str);
		}
	}
	ShowDialog(playerid,1700,DIALOG_STYLE_LIST,"{444444}[ {ff9000}/goc - принять {444444}]",sctring,"*","");
	return 1;
}
CMD:cancel(playerid, const params[])
{
	new string[144];
 	if(PlayerInfo[playerid][pMember] == 8 && PlayerInfo[playerid][pRank] >= 2 || PlayerInfo[playerid][pLeader] == 8)
	{
		if(PlayerInfo[playerid][pRank] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не смею отменять контракт [ 2+ Ранг ]");
 		if(gJerID[playerid] == 9999) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не выполняю контракт");
 		new myjer = gJerID[playerid];
   		if(IsOnline(myjer))
     	{
     		if(OnlineInfo[myjer][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Моей жертвы нет..");
         	format(string, sizeof(string), "{FF0000}** {8B8B8B}Агент №%d {FF0000}отказывается выполнять контракт на: {8B8B8B}%s[%d] {FF0000}**", PlayerInfo[playerid][pID], PlayerInfo[myjer][pName], myjer);
          	SendRadioMessage(8, COLOR_GREY, string);
          	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я отказываюсь выполнять контракт...");
          	gHitID[myjer] = 9999;
          	gJerID[playerid] = 9999;
           	return 1;
      	}
	}
	return 1;
}
CMD:goc(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(68, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
	if(!GetAccessRankOrg(playerid, g, 68, NO_FBI)) return 1;

	new jertva;
    if(sscanf(params, "u",jertva)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Принять контракт [ /goc ID ]");
	if(gJerID[playerid] != 9999) return ErrorMessage(playerid, "{FF6347}Вы уже выполняете контракт [ /myc ]");
	if(jertva == playerid) return ErrorMessage(playerid, "{FF6347}Вы не можете принять контракт на самого себя");
	if(!IsOnline(jertva)) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");

	if(gHitID[jertva] != 9999) return ErrorMessage(playerid, "{FF6347}Кто-то уже принял этот контракт");
	if(gHitMoney[jertva] == 0) return ErrorMessage(playerid, "{FF6347}На этого игрока нет контракта");

	new string[180];
	format(string, sizeof(string), "** {8B8B8B}Агент %s {FF6347}принял контракт на: {8B8B8B}%s[%d] {00AC31}Цена: %d$ {cccccc}**", PlayerInfo[playerid][pCallSign], PlayerInfo[jertva][pName], jertva, gHitMoney[jertva]);
	SendRadioMessage(8, COLOR_GREY, string);
	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Для того, чтобы найти жертву мне нужно использовать {ff9000}[ /find ]");
	gJerID[playerid] = jertva;
	gHitID[jertva] = playerid;
	return 1;
}
CMD:myc(playerid, const params[])
{
 	if(PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8)
 	{
 		if(gJerID[playerid] == 9999) return ErrorMessage(playerid, "{FF6347}У вас нет активного контракта");
		new string[120];
		format(string, sizeof(string), "[ Мысли ]: Я выполняю контракт на {ff9000}%s[%d]", PlayerInfo[gJerID[playerid]][pName], gJerID[playerid]);
		SendClientMessage(playerid, COLOR_GREY, string);
	}
	else ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
	return 1;
}
CMD:givec(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(69, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
	if(!GetAccessRankOrg(playerid, g, 69, NO_FBI)) return 1;

	new hitid,jertva;
    if(sscanf(params, "ii",hitid,jertva)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поручить контракт [ /givec ID ]");

	if(!IsOnline(jertva)) return ErrorMessage(playerid, "{FF6347}Ошибка! Жертвы нет в игре");
	if(!IsOnline(hitid)) return ErrorMessage(playerid, "{FF6347}Ошибка! Подчинённого нет в игре");
	if(PlayerInfo[hitid][pMember] != 8 && PlayerInfo[hitid][pLeader] != 8) return ErrorMessage(playerid, "{FF6347}Это не агент ICA");
	if(gJerID[hitid] != 9999) return ErrorMessage(playerid, "{FF6347}У этого агента уже есть активный контракт");
	if(gHitID[jertva] != 9999) return ErrorMessage(playerid, "{FF6347}Этот контракт уже принят");
	if(gHitMoney[jertva] == 0) return ErrorMessage(playerid, "{FF6347}На этого человека не было контрактов");
	
	new string[180];
	format(string, sizeof(string), "{FF0000}** {8B8B8B}Агент %s поручил {FF0000}Агенту {8B8B8B}%s {FF0000}выполнить контракт на: {8B8B8B}%s **", PlayerInfo[playerid][pCallSign], PlayerInfo[hitid][pCallSign], rpplayername(jertva));
	SendRadioMessage(8,COLOR_WHITE, string);
	gJerID[hitid] = jertva;
	gHitID[jertva] = hitid;
	SendClientMessage(hitid, COLOR_WHITE, "{950000}[ Агентство ]: {444444}Вам поручили выполнить контракт!");
	new str[100],sctring[300];
	format(str,sizeof(str),"\n\n{444444}Вам поручили выполнить контракт!");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}Найди и убей {950000}%s[%d] [ /find ]", rpplayername(jertva), jertva);
	strcat(sctring,str);
	format(str,sizeof(str),"\n{444444}Стоимость: {950000}%d$", gHitMoney[jertva]);
	strcat(sctring,str);
	ShowDialog(hitid,1700,DIALOG_STYLE_MSGBOX,"             {000000}*",sctring,"*","");
	SendClientMessage(hitid, COLOR_GREY, "[ Мысли ]: Для того, чтобы найти жерту мне нужно использовать {ff9000}[ /find ]");
	return 1;
}
// Феиерверки
CMD:firework(playerid, const params[])
{
	if(!sscanf(params, "i", params[0]))
 	{
		if(get_invent4(playerid, 40, 0) <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет фейерверка [ Y >> GPS >> Услуги >> Супермаркет ]");
		if(GetPlayerInterior(playerid) >= 1 || GetPlayerVirtualWorld(playerid) >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу запускать феиерверк в здании");
	    new eid=EmptyFireworkSlot();
	    if(!eid)return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Сейчас запущено очень много фейерверков [ Лимит: 100 ]");
	    new tmphour, tmpminute, tmpsecond;
		gettime(tmphour, tmpminute, tmpsecond);
		if(tmphour >= 7 && tmphour <= 21 && PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Нет смысла запускать фейерверк в светлое время суток [ Запуск с 22:00 до 6:00 ]");
		if(OnlineInfo[playerid][oShowInterface] != 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно посмотреть мои вещи [ Только через инвентарь - N ]");
		if(MyFireWork(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мною уже запущен один феиерверк, нужно подождать когда он закончится..");
		if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу запускать фейерверк из транспорта");
		TakeInvent(playerid, 40, 1, 0, params[0]);
	    GetPlayerPos(playerid,FireworkInfo[eid][FW_Pos][0],FireworkInfo[eid][FW_Pos][1],FireworkInfo[eid][FW_Pos][2]);
	    GetPlayerFacingAngle(playerid,FireworkInfo[eid][FW_Pos][3]);
	    //Enum info settimine
	    FireworkInfo[eid][FW_RocketsReleased]=-2;
	    FireworkInfo[eid][FW_Radius]=8.0;
	    FireworkInfo[eid][FW_Height]=30.0; // Высота
	    FireworkInfo[eid][FW_Owner]=playerid;
	    FireworkInfo[eid][FW_Amount]=30;
	    FireworkInfo[eid][FW_Pos][0]+= (2.0 * floatsin(-FireworkInfo[eid][FW_Pos][3],degrees));
	    FireworkInfo[eid][FW_Pos][1]+= (2.0 * floatcos(-FireworkInfo[eid][FW_Pos][3],degrees));
	    FireworkInfo[eid][FW_Pos][2]-=0.9;
	    FireworkInfo[eid][FW_Box] = CreateDynamicObject(3016,FireworkInfo[eid][FW_Pos][0],FireworkInfo[eid][FW_Pos][1],FireworkInfo[eid][FW_Pos][2], 0,0,0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 100.00, 100.00);
		PlayerPlaySound(playerid,6401,0,0,0);
	    if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я {ff9000}установил {cccccc}фейерверк, нужно быстрее отойти!"), SetPlayerChatBubble(playerid,"установил фейерверк",COLOR_PURPLE,20.0,3000);
	    else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я {ff9000}установила {cccccc}фейерверк, нужно быстрее отойти!"), SetPlayerChatBubble(playerid,"установила фейерверк",COLOR_PURPLE,20.0,3000);
	    ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0, false, true, true, false, false);
	    FireworkInfo[eid][FW_Timer] = SetTimerEx("StartFirework",600,true,"d",eid);
	    Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
	    if(PlayerInfo[playerid][pAchieve][114] == 0) AchievePlayer(playerid, 114, 1);
  	}
    return 1;
}

public CrimInRange(Float:radi, playerid,copid)
{
	if(IsOnline(playerid)&&IsOnline(copid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		GetPlayerPos(copid, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)))
		{
			return 1;
		}
	}
	return 0;
}

public ProxDetectorS(Float:radi, playerid, targetid)
{
    if(IsOnline(playerid)&&IsOnline(targetid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		GetPlayerPos(targetid, posx, posy, posz);

		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);

		if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
		{
			if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(targetid))
			{
				return 1;
			}
		}
	}
	
	return 0;
}

function ProxDetectorActor(Float:radi, playerid, actorid)
{
    if(IsOnline(playerid) && IsValidDynamicActor(actorid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		//radi = 2.0; //Trigger Radius
		GetDynamicActorPos(actorid, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		//printf("DEBUG: X:%f Y:%f Z:%f",posx,posy,posz);
		if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
		{
			if(GetPlayerVirtualWorld(playerid) == GetDynamicActorVirtualWorld(actorid))
			{
				return 1;
			}
		}
	}
	return 0;
}

stock CustomPickups(playerid)//входы\выходы
{
	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	if(IsPlayerInAnyVehicle(playerid)) return 0;

	if(IsPlayerInRangeOfPoint(playerid,2.0,-89.5324,1378.2632,10.4698)) // Вход в Sons Of A 1
	{
		S_SetPlayerVirtualWorld(playerid,1,18);
		PPSetPlayerInterior(playerid,18);
		PPSetPlayerPos(playerid,-227.1517,1401.1912,27.7656);
		PPSetPlayerFacingAngle(playerid,269.2068);
		SetCameraBehindPlayer(playerid);
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,-229.2938,1401.2589,27.7656)) // Выход из Sons Of A 1
	{
		S_SetPlayerVirtualWorld(playerid,0,0);
		PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,-86.9876,1378.4202,10.2734);
		PPSetPlayerFacingAngle(playerid,275.1835);
		SetCameraBehindPlayer(playerid);
	}
