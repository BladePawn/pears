		new desk = DeskID[playerid], p = DeskMyPlace[playerid];
        new combo = combo_poke(desk, p, CardPlayer[0][desk][p], CardPlayer[1][desk][p], DeskInfo[desk][DeskCard][0], DeskInfo[desk][DeskCard][1], DeskInfo[desk][DeskCard][2], DeskInfo[desk][DeskCard][3], DeskInfo[desk][DeskCard][4]);
		SendClientMessage(playerid, COLOR_DARK, "%s [%s] [%s]", comboName[combo], cardName[DeskInfo[desk][ComboKicker][p]], cardName[DeskInfo[desk][ComboTwicker][p]]);
