			if(IsPlayerInRangeOfPoint(playerid,2.0,-36.3192,78.8492,3.1331) && GetPlayerInterior(playerid) == 228 && GetPlayerVirtualWorld(playerid) == 228 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
			{
				if(listitem == 0)
				{
					new stro[86],sctringo[1892];
			        format(stro,sizeof(stro),"{0088ff}Как заработать?"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}На ферме есть несколько способов заработка:"), strcat(sctringo,stro);

			        format(stro,sizeof(stro),"\n\n{ff9000}1. Сбор яблок в саду"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- На полях есть сады с деревьями, на которых растут яблоки"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Возьмите на улице пустую корзинку и отправляйтесь в сад"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Зарплата начисляется в зависимости от стоимости яблок"), strcat(sctringo,stro);

			        format(stro,sizeof(stro),"\n\n{ff9000}2. Дойка Коров"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- В сараях есть два ангара, в которых стоят коровы"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Возьмите там пустое ведро, сядьте на стул и начните доить корову"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Зарплата начисляется в зависимости от стоимости молока"), strcat(sctringo,stro);
			        ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Ферма",sctringo,"Ок","");
				}
		    	if(listitem == 1)
				{
					if(PlayerInfo[playerid][pPlacement] >= 1 && PlayerInfo[playerid][pPlacement] != 9) return StopJob(playerid);
					if(PlayerInfo[playerid][pSalary] <= 0) return ErrorMessage(playerid, "{FF6347}Вы ничего не заработали на Ферме");
					new yesprem = 0, pay;
					pay = PlayerInfo[playerid][pSalary];

					if(ServerInfo[53] == 5) pay += pay/4;
					if (!TakeMoneyFromTreasury(pay, "Зарплата (ферма)"))
					{
						return ErrorMessage(playerid, "{FF6347}В казне недостаточно средств для выдачи зарплаты.\n{FF6347}Обратитесь к администрации.");
					}
					paysalary(playerid, pay, 0);
					ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false);
					MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", pay, "Зарплата Ферма");
					if(yesprem == 1)
					{
						if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"[ Мысли ]: Я получил зарплату {99ff66}%d$ {cccccc}(+%d$ премия)", PlayerInfo[playerid][pSalary], friskPrice[156]/2),SendClientMessage(playerid, COLOR_GREY, string);
						else format(string,sizeof(string),"[ Мысли ]: Я получила зарплату {99ff66}%d$ {cccccc}(+%d$ премия)", PlayerInfo[playerid][pSalary], friskPrice[156]/2),SendClientMessage(playerid, COLOR_GREY, string);
					}
					else
					{
						if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"[ Мысли ]: Я получил зарплату {99ff66}%d$", PlayerInfo[playerid][pSalary]),SendClientMessage(playerid, COLOR_GREY, string);
						else format(string,sizeof(string),"[ Мысли ]: Я получила зарплату {99ff66}%d$", PlayerInfo[playerid][pSalary]),SendClientMessage(playerid, COLOR_GREY, string);
					}
					SendDynamicActorMessage(playerid, BotPears[250],"Отлично! Держи деньги");
					PlayerInfo[playerid][pPlacement] = 0;
					PlayerInfo[playerid][pSalary] = 0;
					mysql_save(playerid, 58);
					new skill = pay/1000;
					if(skill >= 1) update_ability(playerid, 5, skill);
				}
				if(listitem == 2) buyinferm(playerid);
				//if(listitem == 3) sellinferm(playerid);
			}
		}
	}
