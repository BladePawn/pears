      					SendClientMessage(playerid,COLOR_GREY,string);
      					pc_cmd_reports(playerid);
      					return 1;
					}
					if(PlayerInfo[playerid][pSoska] >= 1)
					{
						format(string, sizeof(string), " [ ADM ]: %s открывает обращение %s[%d] {cccccc}[ /messoff ]", PlayerInfo[playerid][pName],PlayerInfo[para1][pName], para1);
		   				MessCast(COLOR_ADM,string,1);
  					}
  					else if(PlayerInfo[playerid][pExpert] >= 1)
  					{
  						if(PlayerInfo[playerid][pExchat] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не активировано дежурство [ /exp ]");
  						if(PlayerInfo[para1][pReportStat] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу отвечать только на вопросы..");
  						if(para1 == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу отвечать на собственное обращение");
  						format(string, sizeof(string), " [ Expert ]: %s открывает обращение %s[%d] {cccccc}[ /exp ]", PlayerInfo[playerid][pName],PlayerInfo[para1][pName], para1);
  						ExpertCast(COLOR_ADM, string);
  					}
		   			// Объяснение для админа
		   			SendClientMessage(playerid, COLOR_GREY, "{FFFFFF}Отвечайте игроку с помощью команд: {ff9000}/an /ot /otv /otvet");
		   			SendClientMessage(playerid, COLOR_GREY, " ");
      				format(string, sizeof(string), "{cccccc}Игрок: {0088ff}%s{ffffff}[%d]",PlayerInfo[para1][pName], para1);
      				SendClientMessage(playerid, COLOR_GREY, string);
      				format(string, sizeof(string), "{cccccc}Обращение: {FF6347}%s",PlayerInfo[para1][pReport]);
      				SendClientMessage(playerid, COLOR_GREY, string);
      				SendClientMessage(playerid, COLOR_GREY, " ");
      				format(string, sizeof(string), "{FFFFFF}По завершению, закройте его обращение: {ffcc00}/com %d",para1);
      				SendClientMessage(playerid, COLOR_GREY, string);
      				PlayerPlaySound(playerid,21000,0,0,0); // 001 завершить

      				KtoKomy[playerid] = para1; // Отвечаем Игроку
      				KtoKomy[para1] = playerid; // Игроку Отвечают
      				if(PlayerInfo[playerid][pSoska] >= 1) work_admin(playerid, 7);
  				}
   				else { SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Обращение игрока обработано или он не обращался"); pc_cmd_reports(playerid); return 1; }
   			}
   			else { SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок отключился от сервера..."); pc_cmd_reports(playerid); return 1; }
		}
	}
