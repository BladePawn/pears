stock IsABizInteriorFrame(b)
{
	if(b >= 93 && b <= 102 || b >= 103 && b <= 117) return 1; // Клубы, Закусочные
	return 0;
}
stock fraction(playerid)
{
	new frakid;
	if(PlayerInfo[playerid][pLeader] >= 1) frakid = PlayerInfo[playerid][pLeader];
	else if(PlayerInfo[playerid][pLeader] == 0) frakid = PlayerInfo[playerid][pMember];
 	return frakid;
}

stock division(playerid, index = 0) {
	if (index < 0 || index > 1) return 0;
	return PlayerInfo[playerid][pDivision][index];
}

stock IsLeader(playerid) {
	return PlayerInfo[playerid][pRank] >= get_maxrank(fraction(playerid)) || PlayerInfo[playerid][pLeader] > 0;
}

stock IsSubLeader(playerid) {
	return PlayerInfo[playerid][pRank] == get_maxrank(fraction(playerid)) - 1;
}

stock SaveCar(veh)
{
	if(Cars[veh] == 88)
	{
		if(VehInfo[veh][vIdvlad] != 9999 && VehInfo[veh][vDatabase] >= 1 && VehInfo[veh][vDatabase] <= MAX_MYVEHICLE)
		{
			new unix = gettime();
			new Float:health;
			if(VehInfo[veh][vTestDrive] > 0) health = MaxVehicleHealth(VehInfo[veh][vModel], veh); // В тестдрайве сохраняем максимальное хп
			else health = VehInfo[veh][vHealth];

			new string_mysql[1400];
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_cars` SET `sost`='%d',`slot`='%d',`model`='%d',`koordinatx`='%f',\
			`koordinaty`='%f',`koordinatz`='%f',`koordinata`='%f',`vArmor`='%f',`vehcol1`='%d',`vehcol2`='%d',`numer`='%e',`arest`='%d',`lock`='%d',`health`='%f',",
				VehInfo[veh][vSost],VehInfo[veh][vDatabase],VehInfo[veh][vModel],VehInfo[veh][vKoordinatX],
				VehInfo[veh][vKoordinatY],VehInfo[veh][vKoordinatZ],VehInfo[veh][vKoordinatA],VehInfo[veh][vArmor],VehInfo[veh][vVehcol1],VehInfo[veh][vVehcol2],
				VehInfo[veh][vNumer],VehInfo[veh][vArest],VehInfo[veh][vCarLock],health); // 219 + 77 + 100 + 20
			
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "%s`fine`='%d',`finelien`='%d',`finetime`='%d',`finereason`='%e',`finename`='%e',", string_mysql,
				VehInfo[veh][vFine], VehInfo[veh][vFineLien], VehInfo[veh][vFineTime], VehInfo[veh][vFineReason], VehInfo[veh][vFineName]); // 81 + 33 + 64 + 24

			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "%s`panels`='%d',`doors`='%d',`fara`='%d',`tires`='%d',`death`='%i',`Alarm`='%d',`AlarmUnix`='%d',`vHandlingModel`='%d',`vTunningBPAN`='%f',", string_mysql,
				VehInfo[veh][vPanels], VehInfo[veh][vDoors], VehInfo[veh][vFara], VehInfo[veh][vTires], VehInfo[veh][vDeath], 
				VehInfo[veh][vAlarmSystem], VehInfo[veh][vAlarmUnix],VehInfo[veh][vHandlingModel],VehInfo[veh][vTunningBPAN]); // 98 + 77

			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "%s`comp1`='%d',`comp2`='%d',`comp3`='%d',`comp4`='%d',`comp5`='%d',`comp6`='%d',`comp7`='%d',`comp8`='%d',`comp9`='%d',\
			`comp10`='%d',`comp11`='%d',`benz`='%d',`benz2`='%d',`god`='%d',`upgrade`='%d',`Unixload`='%d',`keyveh`='%d',`keyunix`='%d',`Sklad`='%d' WHERE `newid`='%d'", string_mysql,
				VehInfo[veh][vComp1],VehInfo[veh][vComp2],VehInfo[veh][vComp3],VehInfo[veh][vComp4],VehInfo[veh][vComp5],VehInfo[veh][vComp6],VehInfo[veh][vComp7],VehInfo[veh][vComp8],
				VehInfo[veh][vComp9],VehInfo[veh][vComp10],VehInfo[veh][vComp11],VehInfo[veh][vGas],VehInfo[veh][vGelium],VehInfo[veh][vGod],VehInfo[veh][vEnhancedBoot], 
				unix,VehInfo[veh][vKey],VehInfo[veh][vKeyUnix],VehInfo[veh][vSklad],VehInfo[veh][vNewid]); // 280 + 220
			query_empty(pearsq, string_mysql); // 1293
		}
	}
	return 1;
}
//----------------------------------[zachistka]-----------------------------------------------
CMD:zachistka(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(81, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов.");
	if(!GetAccessRankOrg(playerid, g, 81, NO_FBI)) return 1;
	{
		PlayerPlaySound(playerid,40405,0,0,0);
       	new str[100],sctring[700];
       	if(Zach[5] == 1) format(str,sizeof(str),"{cccccc}Cosa Nostra {ff9000}[ Зачистка ]\n");
       	else if(Zach[5] == 0) format(str,sizeof(str),"{cccccc}Cosa Nostra\n");
    	strcat(sctring,str);
       	if(Zach[6] == 1) format(str,sizeof(str),"{cccccc}Yakuza Mafia {ff9000}[ Зачистка ]\n");
       	else if(Zach[6] == 0) format(str,sizeof(str),"{cccccc}Yakuza Mafia\n");
    	strcat(sctring,str);
      	if(Zach[10] == 1) format(str,sizeof(str),"{cccccc}Triada Mafia {ff9000}[ Зачистка ]\n");
       	else if(Zach[10] == 0) format(str,sizeof(str),"{cccccc}Triada Mafia\n");
    	strcat(sctring,str);
    	if(Zach[12] == 1) format(str,sizeof(str),"{cccccc}Russian Mafia {ff9000}[ Зачистка ]\n");
       	else if(Zach[12] == 0) format(str,sizeof(str),"{cccccc}Russian Mafia\n");
    	strcat(sctring,str);
    	if(Zach[13] == 1) format(str,sizeof(str),"{cccccc}Grove Street {ff9000}[ Зачистка ]\n");
       	else if(Zach[13] == 0) format(str,sizeof(str),"{cccccc}Grove Street\n");
    	strcat(sctring,str);
    	if(Zach[14] == 1) format(str,sizeof(str),"{cccccc}Ballas Gang {ff9000}[ Зачистка ]\n");
       	else if(Zach[14] == 0) format(str,sizeof(str),"{cccccc}Ballas Gang\n");
    	strcat(sctring,str);
    	if(Zach[15] == 1) format(str,sizeof(str),"{cccccc}Vagos Gang {ff9000}[ Зачистка ]\n");
       	else if(Zach[15] == 0) format(str,sizeof(str),"{cccccc}Vagos Gang\n");
    	strcat(sctring,str);
    	if(Zach[16] == 1) format(str,sizeof(str),"{cccccc}Los Aztecas Gang {ff9000}[ Зачистка ]\n");
       	else if(Zach[16] == 0) format(str,sizeof(str),"{cccccc}Los Aztecas Gang\n");
    	strcat(sctring,str);
    	if(Zach[18] == 1) format(str,sizeof(str),"{cccccc}Arabian Mafia {ff9000}[ Зачистка ]\n");
       	else if(Zach[18] == 0) format(str,sizeof(str),"{cccccc}Arabian Mafia\n");
    	strcat(sctring,str);
    	ShowDialog(playerid,380,DIALOG_STYLE_LIST,"{ff9000}Меню Зачистки",sctring,"Выбор","Отмена");
   	}
   	return 1;
}
public OnRconLoginAttempt(ip[], password[], success)
{
    new pip[18];
    if(!success)
    {
        foreach (Player, i)
		{
			GetPlayerIp(i, pip, sizeof(pip));
			if(!strcmp(ip, pip, true)) SendClientMessage(i,COLOR_GREY,"{FF6347}[Server] Попытка подобрать Rcon Password: не удалась"), Kickx(i);
		}
    }
    /*else
    {
       if(!strcmp(ip, pip, true))
       {
         for(new i=0; i<MAX_REALPLAYERS; i++){GetPlayerIp(i, pip, sizeof(pip));GetPlayerName(i, pname, sizeof(pname));}
         format(string, sizeof(string), " [ ADM ]: {ff0000}%s {ffcc33}авторизовался в Rcon. {ff0000}IP %s",pname, pip);
         ABroadCast(COLOR_ADM,string,7);
       }
    }*/
    return 1;
}
stock walk_card(playerid, desk, cd, place) // Хожу или подкидываю
{
    PlayerPlaySound(playerid,17803,0,0,0);
   	if(DeskInfo[desk][QuanDeskCard] >= 6) return ErrorMessage(playerid, "{FF6347}Больше нельзя подкидывать");
   	new deskid_card, yeshod, nepokrit;
   	if(DeskInfo[desk][QuanDeskCard] >= 1)
   	{
	   	for(new dc = 0; dc < 6; dc++)
	    {
	        if(DeskInfo[desk][DeskCard][dc] > 0)
	    	{
	    	    if(DeskInfo[desk][DeskCardCover][dc] == 0) nepokrit ++;
	            if(cardDignity[DeskInfo[desk][DeskCard][dc]] == cardDignity[CardPlayer[cd][desk][place]] || cardDignity[DeskInfo[desk][DeskCardCover][dc]] == cardDignity[CardPlayer[cd][desk][place]]) yeshod = 1;
	    	}
	    	if(DeskInfo[desk][DeskCard][dc] == 0)
	    	{
	    	    deskid_card = dc;
	    	    break;
	    	}
	   	}
   	}
   	else yeshod = 1;
   	if(yeshod == 0) return PlayerPlaySound(playerid,4203,0,0,0);
   	if(DeskInfo[desk][Kon] <= 0 && DeskInfo[desk][QuanDeskCard] >= 5) return ErrorMessage(playerid, "{FF6347}Первый отбой 5 карт");
   	if(DeskInfo[desk][Underwalk] > 0)
   	{
   	    if(nepokrit+1 > QuanCardPlayer[desk][DeskInfo[desk][Underwalk]-1]) return ErrorMessage(playerid, "{FF6347}Больше нельзя подкидывать");
	}
   	if(DeskInfo[desk][Walking] <= 0) hide_trumpcard_all(desk, place);
   	if(DeskInfo[desk][Playerwalk][place] == 0) // Подсчёт порядка ходов в кону
   	{
   		DeskInfo[desk][Hodwalk] ++;
  		DeskInfo[desk][Playerwalk][place] = DeskInfo[desk][Hodwalk];
	}
   	DeskInfo[desk][QuanDeskCard] ++;
   	DeskInfo[desk][Walking] ++;
   	DeskInfo[desk][Nowhod] = place;
   	DeskInfo[desk][DeskCard][deskid_card] = CardPlayer[cd][desk][place];
   	DeskInfo[desk][CardWalk][deskid_card] = place;
   	CardPlayer[cd][desk][place] = 0;
   	QuanCardPlayer[desk][place] --;
   	update_desk_card_walk(desk, deskid_card);
   	update_textdraw_card_player(desk, place);
   	
	new yescover;
   	if(QuanCardPlayer[desk][place] <= 0 && DeskInfo[desk][Quancard] <= 0) // Последнняя карта
 	{
 	    if(DeskInfo[desk][Underwalk] > 0)
 	    {
 	        new plwalk = DeskInfo[desk][Underwalk]-1;
 	        if(QuanCardPlayer[desk][plwalk] == 1 && DeskInfo[desk][QuanGame] <= 2) // Последняя карта у кроющегося и последние 2 игрока
 	        {
 	            yescover = iscovercard(desk, DeskInfo[desk][DeskCard][deskid_card], get_last_card(desk, plwalk));
 	        }
 	    }
  		if(yescover == 0) player_out_card_durak(desk, place, 0); // Только если последнюю карту нельзя покрыть
	}
   	if(DeskInfo[desk][QuanGame] >= 2)
   	{
	   	if(DeskInfo[desk][Lastor] == 2) // Берёт
	   	{
	   	    if(DeskInfo[desk][DeskCard][5] > 0) DeskInfo[desk][Timer] = 3;
	   	}
	   	else if(DeskInfo[desk][Lastor] != 2 && DeskInfo[desk][QuanDeskCard] <= 6) // Кроется или подкидываем
	   	{
	   	    DeskInfo[desk][Status] = 4;
	   		go_walk(desk, DeskInfo[desk][Underwalk]-1, 0, 1);
	   	}
   	}
    return 1;
}
stock get_last_card(desk, place)
{
	new last;
	for(new cd = 0; cd < 52; cd++)
	{
 		if(CardPlayer[cd][desk][place] > 0)
 		{
 			last = CardPlayer[cd][desk][place];
			break;
 		}
	}
	return last;
}
stock transfer_card(playerid, desk, tdc, place) // Перевожу
{
    new sel = SelectCard[desk][place]-1;
	if(CardPlayer[sel][desk][place] > 0)
	{
		if(cardDignity[DeskInfo[desk][DeskCard][0]] == cardDignity[CardPlayer[sel][desk][place]])
		{
		    // Передаём ход
   			new place_walk = get_member_next(desk, place);
			if(DeskInfo[desk][QuanDeskCard]+1 > QuanCardPlayer[desk][place_walk]) return ErrorMessage(playerid, "{FF6347}У следующего игрока недостаточно карт на руках");
			if(DeskInfo[desk][Walking] <= 1) return ErrorMessage(playerid, "{FF6347}Первый ход переводить нельзя!");
			send_hud_message(playerid, desk, place, 1);
			DeskInfo[desk][QuanDeskCard] ++;
		    DeskInfo[desk][Walking] ++;
		    if(DeskInfo[desk][Playerwalk][place] == 0) // Подсчёт порядка ходов в кону
		   	{
		   		DeskInfo[desk][Hodwalk] ++;
		  		DeskInfo[desk][Playerwalk][place] = DeskInfo[desk][Hodwalk];
			}
			DeskInfo[desk][Nakidali] = 0;
			DeskInfo[desk][Nowhod] = place;
			
			// if(DeskInfo[desk][QuanGame] <= 2) DeskInfo[desk][Nowhod] = place; // Если играют 2 на 2 (делаем возвратный ход тому кто перевёл)
			// if(place_walk == DeskInfo[desk][Nowhod] && DeskInfo[desk][QuanGame] >= 3) DeskInfo[desk][Nowhod] = place; // Если играют 3 и больше и возвратный ход вернётся кроющемуся (делаем возвратный ход тому кто перевёл)
			DeskInfo[desk][Status] = 4;
	        DeskInfo[desk][DeskCard][tdc] = CardPlayer[sel][desk][place];
			DeskInfo[desk][CardUnderwalk][tdc] = place;
			CardPlayer[sel][desk][place] = 0;
			SelectCard[desk][place] = 0;
			QuanCardPlayer[desk][place] --;
			update_desk_card_walk(desk, tdc);
			update_textdraw_card_player(desk, place);
			if(QuanCardPlayer[desk][place] <= 0 && DeskInfo[desk][Quancard] <= 0) player_out_card_durak(desk, place, 0);

            if(DeskInfo[desk][QuanGame] >= 2)
   			{
				new getttingwalk = new_underwalk(desk, place); // Под кого ходим
	    		go_walk(desk, getttingwalk-1, 0, 1);
  			}
		}
		else return PlayerPlaySound(playerid,4203,0,0,0);
	}
	return 1;
}
stock iscovercard(desk, card1, card2)
{
    if(DeskInfo[desk][Trump] == cardSuit[card2]) // Если ходим козырем
	{
	    if(cardSuit[card2] != cardSuit[card1]) return 1;
        else if(cardSuit[card2] == cardSuit[card1])
        {
	    	if(card2 > card1) return 1;
	    	else return 0;
    	}
	}
    else // Если ходим обычной картой
	{
	    if(DeskInfo[desk][Trump] == cardSuit[card1]) // Если на столе лежит козырь
	    {
	        if(DeskInfo[desk][Trump] != cardSuit[card2]) return 0;
	    }
	    else
	    {
	        if(cardSuit[card2] != cardSuit[card1]) return 0;
		    if(card2 > card1) return 1;
		    else return 0;
		}
	}
	return 1;
}
stock underwalk_card(playerid, desk, tdc, place) // Кроюсь
{
	new sel = SelectCard[desk][place]-1, yeshod;
	if(CardPlayer[sel][desk][place] > 0)
	{
        yeshod = iscovercard(desk, DeskInfo[desk][DeskCard][tdc], CardPlayer[sel][desk][place]);
        if(yeshod == 0) return PlayerPlaySound(playerid,4203,0,0,0);
		else if(yeshod == 1)
		{
		    if(DeskInfo[desk][Walking] <= 0) hide_trumpcard_all(desk, place);
		    DeskInfo[desk][Nakidali] = 0;
	        DeskInfo[desk][Walking] ++;
	        if(DeskInfo[desk][Playerwalk][place] == 0) // Подсчёт порядка ходов в кону
		   	{
		   		DeskInfo[desk][Hodwalk] ++;
		  		DeskInfo[desk][Playerwalk][place] = DeskInfo[desk][Hodwalk];
			}
	        DeskInfo[desk][DeskCardCover][tdc] = CardPlayer[sel][desk][place];
			DeskInfo[desk][CardUnderwalk][tdc] = place;
			CardPlayer[sel][desk][place] = 0;
			SelectCard[desk][place] = 0;
			QuanCardPlayer[desk][place] --;
			update_desk_card_underwalk(desk, tdc);
			update_textdraw_card_player(desk, place);
			
			if(DeskInfo[desk][DeskCard][0] > 0 && DeskInfo[desk][DeskCardCover][0] == 0 || DeskInfo[desk][DeskCard][1] > 0 && DeskInfo[desk][DeskCardCover][1] == 0 || DeskInfo[desk][DeskCard][2] > 0 && DeskInfo[desk][DeskCardCover][2] == 0
			|| DeskInfo[desk][DeskCard][3] > 0 && DeskInfo[desk][DeskCardCover][3] == 0 || DeskInfo[desk][DeskCard][4] > 0 && DeskInfo[desk][DeskCardCover][4] == 0 || DeskInfo[desk][DeskCard][5] > 0 && DeskInfo[desk][DeskCardCover][5] == 0)
			{
				// Ещё остались не покрытые карты на столе
			}
			else
			{
			    DeskInfo[desk][Status] = 3;
				if(QuanCardPlayer[desk][place] <= 0)
				{
				    if(DeskInfo[desk][QuanGame] <= 2 && QuanCardPlayer[desk][DeskInfo[desk][Nowhod]] <= 0 && DeskInfo[desk][Quancard] <= 0) DeskInfo[desk][Timer] = 1, DeskInfo[desk][Lastor] = 3; // Ничья!
					else DeskInfo[desk][Timer] = 3, DeskInfo[desk][Lastor] = 1; // Всё покрыл, больше нет карт
				}
				else go_walk(desk, DeskInfo[desk][Nowhod], 0, 1); // Возвращаем ход, чтобы ещё подкинул
			}
	    }
	}
	return 1;
}
stock update_desk_card_walk(desk, cardid)
{
    for(new p = 0; p < MAX_PLAYER_DESK; p++) textdraw_desk_card_walk(desk, p, cardid);
	return 1;
}
stock textdraw_desk_card_walk(desk, place, cardid)
{
    if(DeskInfo[desk][Playerstatus][place] > 0)
	{
	    new memberid = DeskInfo[desk][Playerid][place];
	    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
	    {
	        PlayerPlaySound(memberid,1145,0,0,0);
		    new string[24];
		    format(string,sizeof(string),"%s",cardtextDraw[DeskInfo[desk][DeskCard][cardid]]);
		    PlayerTextDrawSetString(memberid, DeskCardDraw[cardid][memberid], string);
		    if(DeskInfo[desk][DeskCard][cardid] > 0) PlayerTextDrawColour(memberid, DeskCardDraw[cardid][memberid], -1);
			else PlayerTextDrawColour(memberid, DeskCardDraw[cardid][memberid], 80);
			PlayerTextDrawShow(memberid, DeskCardDraw[cardid][memberid]);
		}
	}
	return 1;
}
stock textdraw_desk_card_underwalk(desk, place, cardid)
{
    if(DeskInfo[desk][Playerstatus][place] > 0)
	{
	    new memberid = DeskInfo[desk][Playerid][place];
	    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
	    {
		    if(DeskInfo[desk][Playermessage][place] > 0) DeskInfo[desk][Playermessage][place] = 0, hide_hud_message_members(memberid, desk, place);
	        PlayerPlaySound(memberid,1145,0,0,0);
		    if(DeskInfo[desk][DeskCardCover][cardid] > 0)
		    {
			    new string[24];
			    format(string,sizeof(string),"%s",cardtextDraw[DeskInfo[desk][DeskCardCover][cardid]]);
				PlayerTextDrawSetString(memberid, DeskCardDraw[cardid+6][memberid], string);
				PlayerTextDrawColour(memberid, DeskCardDraw[cardid+6][memberid], -1);
				PlayerTextDrawShow(memberid, DeskCardDraw[cardid+6][memberid]);
			}
			else PlayerTextDrawHide(memberid, DeskCardDraw[cardid+6][memberid]);
		}
	}
	return 1;
}
stock update_desk_card_underwalk(desk, cardid)
{
    for(new p = 0; p < MAX_PLAYER_DESK; p++) textdraw_desk_card_underwalk(desk, p, cardid);
	return 1;
}
stock deselect_card(playerid, desk, place)
{
    new sel = SelectCard[desk][place]-1;
	SelectCard[desk][place] = 0;
	if(CardPlayer[sel][desk][place] > 0) PlayerTextDrawColour(playerid, PlayerCardDraw[sel][playerid], -1), PlayerTextDrawShow(playerid, PlayerCardDraw[sel][playerid]);
	return 1;
}
stock select_card(playerid, desk, cd, place) // Выбираю карту (какой буду крыться или переводить)
{
    PlayerPlaySound(playerid,17803,0,0,0);
    new sel = -1;
    if(SelectCard[desk][place] > 0)
	{
	    sel = SelectCard[desk][place]-1;
		deselect_card(playerid, desk, place);
	}
	if(sel != cd) SelectCard[desk][place] = cd+1, PlayerTextDrawColour(playerid, PlayerCardDraw[cd][playerid], -5963676), PlayerTextDrawShow(playerid, PlayerCardDraw[cd][playerid]);
    return 1;
}
stock next_card_poke(desk)
{
	new yes_card;
	if(DeskInfo[desk][QuanDeskCard] == 3) desk_card_poke(desk, 3), yes_card = 1;
	else if(DeskInfo[desk][QuanDeskCard] == 4) desk_card_poke(desk, 4), yes_card = 1;
	
	if(yes_card == 1)
	{
	    DeskInfo[desk][Status] = 3;
	    DeskInfo[desk][Raise] = 0;
	    DeskInfo[desk][Nakidali] = 0;
	    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    	{
        	if(DeskInfo[desk][Playerstatus][p] > 0)
			{
		    	new memberid = DeskInfo[desk][Playerid][p];
		    	if(DeskInfo[desk][Playermessage][p] > 0) DeskInfo[desk][Playermessage][p] = 0, hide_hud_message_members(memberid, desk, p);
  			}
		}
		update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
		
		new place_walk = get_member_next(desk, DeskInfo[desk][Walk]-1);
		go_walk(desk, place_walk, 0, 1);
	}
    else if(DeskInfo[desk][QuanDeskCard] == 5)
    {
        combo_desk(desk, DeskInfo[desk][DeskCard][0], DeskInfo[desk][DeskCard][1], DeskInfo[desk][DeskCard][2], DeskInfo[desk][DeskCard][3], DeskInfo[desk][DeskCard][4]);
        if(DeskInfo[desk][DesComb][0] == 1) return endgame_card(desk, 9); // Делим на всех (Флеш Рояль на Столе)
        
        new quan_combo[10];
        for(new p = 0; p < MAX_PLAYER_DESK; p++)
    	{
        	if(DeskInfo[desk][Playerstatus][p] == 3)
			{
		    	DeskInfo[desk][Combo][p] = combo_poke(desk, p, CardPlayer[0][desk][p], CardPlayer[1][desk][p], DeskInfo[desk][DeskCard][0], DeskInfo[desk][DeskCard][1], DeskInfo[desk][DeskCard][2], DeskInfo[desk][DeskCard][3], DeskInfo[desk][DeskCard][4]);
                quan_combo[DeskInfo[desk][Combo][p]] ++;
  			}
		}
		
		new string[144];
		if(server == 0)
		{
		    SendClientMessageToAll(COLOR_DARK, "Количество комбинаций:");
		    format(string,sizeof(string),"%s %d, %s %d, %s %d, %s %d, %s %d",comboName[0],quan_combo[0],comboName[1],quan_combo[1],comboName[2],quan_combo[2],comboName[3],quan_combo[3],comboName[4],quan_combo[4]);
		    SendClientMessageToAll(COLOR_DARK, string);
		    format(string,sizeof(string),"%s %d, %s %d, %s %d, %s %d, %s %d",comboName[5],quan_combo[5],comboName[6],quan_combo[6],comboName[7],quan_combo[7],comboName[8],quan_combo[8],comboName[9],quan_combo[9]);
		    SendClientMessageToAll(COLOR_DARK, string);
		}
		
		// Ищем самые высокие комбинации из всех
		new maxcomb, thisp = -1;
		for(new p = 0; p < MAX_PLAYER_DESK; p++)
    	{
        	if(DeskInfo[desk][Playerstatus][p] == 3)
			{
			    if(thisp == -1) maxcomb = DeskInfo[desk][Combo][p], thisp = p, DeskInfo[desk][Playerwin][p] = 1;
			    if(thisp != p)
			    {
			        if(DeskInfo[desk][Combo][p] > maxcomb)
					{
					    for(new p2 = 0; p2 < MAX_PLAYER_DESK; p2++) DeskInfo[desk][Playerwin][p2] = 0;
						maxcomb = DeskInfo[desk][Combo][p], thisp = p, DeskInfo[desk][Playerwin][p] = 1;
					}
			        else if(DeskInfo[desk][Combo][p] == maxcomb) DeskInfo[desk][Playerwin][p] = 1;
			    }
			}
		}
		
		
		if(server == 0)
		{
		    SendClientMessageToAll(COLOR_DARK, " ");
			SendClientMessageToAll(COLOR_DARK, "Потенциальные победители:");
			for(new p = 0; p < MAX_PLAYER_DESK; p++)
    		{
        		if(DeskInfo[desk][Playerstatus][p] == 3 && DeskInfo[desk][Playerwin][p] == 1)
        		{
        		    new memberid = DeskInfo[desk][Playerid][p];
        		    format(string,sizeof(string),"%s %s | Первая: %s, Вторая: %s",PlayerInfo[memberid][pName],comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]], cardName[DeskInfo[desk][ComboTwicker][p]]);
		    		SendClientMessageToAll(COLOR_DARK, string);
        		}
    		}
    	}
		
		
		// Несколько чел собрали комбинацию (Побеждает тот, чья карта в комбе выше)
		
		if(server == 0) SendClientMessageToAll(COLOR_DARK, " "), SendClientMessageToAll(COLOR_DARK, "Поиск повторяющихся:");
		
		for(new comb = 0; comb < 9; comb++)
		{
			if(quan_combo[comb] > 1)
			{
			    if(server == 0) format(string,sizeof(string),"%s, %d раз",comboName[comb], quan_combo[comb]), SendClientMessageToAll(COLOR_DARK, string);
				reload_win_combo(desk, comb);
			}
		}
		
		if(server == 0) SendClientMessageToAll(COLOR_DARK, " ");
		
		endgame_card(desk, 0);
    }
	return 1;
}
stock reload_win_combo(desk, combo) // Сброс лишних победителей с одинаковыми комбинациями
{
    new mincard, findplace = -1, stope;
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
    	if(DeskInfo[desk][Playerstatus][p] == 3 && DeskInfo[desk][Combo][p] == combo)
    	{
    	    if(findplace == -1) mincard = cardDignity[DeskInfo[desk][ComboKicker][p]], findplace = p;
			if(findplace != p)
			{
				if(mincard > cardDignity[DeskInfo[desk][ComboKicker][p]]) DeskInfo[desk][Playerwin][p] = 0; // Карта Меньше
				else if(cardDignity[DeskInfo[desk][ComboKicker][p]] > mincard) // Карта больше
				{
				    DeskInfo[desk][Playerwin][findplace] = 0; // Предыдущему 0
				    mincard = cardDignity[DeskInfo[desk][ComboKicker][p]], findplace = p;
				}
				else if(cardDignity[DeskInfo[desk][ComboKicker][p]] == mincard) // Карты равны (ситуация ничьи)
				{
				    DeskInfo[desk][Playerwin][findplace] = 1;
				    mincard = cardDignity[DeskInfo[desk][ComboKicker][p]], findplace = p;
				    stope = 1;
				}
			}
    	}
	}
	if((combo == 1 || combo == 2 || combo == 3 || combo == 4 || combo == 6) && stope == 1) reload_win_twocombo(desk, combo);
	return 1;
}
stock reload_win_twocombo(desk, combo)
{
    new mincard, findplace = -1;
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
    	if(DeskInfo[desk][Playerstatus][p] == 3 && DeskInfo[desk][Combo][p] == combo)
    	{
			if(findplace == -1) mincard = cardDignity[DeskInfo[desk][ComboTwicker][p]], findplace = p;
			if(findplace != p)
			{
				if(mincard > cardDignity[DeskInfo[desk][ComboTwicker][p]]) DeskInfo[desk][Playerwin][p] = 0; // Карта Меньше
				else if(cardDignity[DeskInfo[desk][ComboTwicker][p]] > mincard) // Карта больше
				{
				    DeskInfo[desk][Playerwin][findplace] = 0; // Предыдущему 0
				    mincard = cardDignity[DeskInfo[desk][ComboTwicker][p]], findplace = p;
				}
				else if(cardDignity[DeskInfo[desk][ComboTwicker][p]] == mincard) // Карты равны (ситуация ничьи)
				{
				    DeskInfo[desk][Playerwin][findplace] = 1;
				    mincard = cardDignity[DeskInfo[desk][ComboTwicker][p]], findplace = p;
				}
			}
    	}
	}
	return 1;
}
stock is_flushroyal(c, stat)
{
	if(stat == 0)
	{
		if(c == 52 || c == 48 || c == 44 || c == 40 || c == 36) return 1;
	}
	else if(stat == 1)
	{
		if(c == 51 || c == 47 || c == 43 || c == 39 || c == 35) return 1;
	}
	else if(stat == 2)
	{
		if(c == 50 || c == 46 || c == 42 || c == 38 || c == 34) return 1;
	}
	else if(stat == 3)
	{
		if(c == 49 || c == 45 || c == 41 || c == 37 || c == 33) return 1;
	}
	return 0;
}
stock is_mast(c, stat)
{
	if(stat == 0)
	{
		if(c == 52 || c == 48 || c == 44 || c == 40 || c == 36 || c == 32 || c == 28 || c == 24 || c == 20 || c == 16 || c == 12 || c == 8 || c == 4) return 1;
	}
	else if(stat == 1)
	{
		if(c == 51 || c == 47 || c == 43 || c == 39 || c == 35 || c == 31 || c == 27 || c == 23 || c == 19 || c == 15 || c == 11 || c == 7 || c == 3) return 1;
	}
	else if(stat == 2)
	{
		if(c == 50 || c == 46 || c == 42 || c == 38 || c == 34 || c == 30 || c == 26 || c == 22 || c == 18 || c == 14 || c == 10 || c == 6 || c == 2) return 1;
	}
	else if(stat == 3)
	{
		if(c == 49 || c == 45 || c == 41 || c == 37 || c == 33 || c == 29 || c == 25 || c == 21 || c == 17 || c == 13 || c == 9 || c == 5 || c == 1) return 1;
	}
	return 0;
}
stock is_kare(c, stat)
{
	if(stat == 2)
	{
		if(c >= 1 && c <= 4) return 1;
	}
	else if(stat == 3)
	{
		if(c >= 5 && c <= 8) return 1;
	}
	else if(stat == 4)
	{
		if(c >= 9 && c <= 12) return 1;
	}
	else if(stat == 5)
	{
		if(c >= 13 && c <= 16) return 1;
	}
	else if(stat == 6)
	{
		if(c >= 17 && c <= 20) return 1;
	}
	else if(stat == 7)
	{
		if(c >= 21 && c <= 24) return 1;
	}
	else if(stat == 8)
	{
		if(c >= 25 && c <= 28) return 1;
	}
	else if(stat == 9)
	{
		if(c >= 29 && c <= 32) return 1;
	}
	else if(stat == 10)
	{
		if(c >= 33 && c <= 36) return 1;
	}
	else if(stat == 11)
	{
		if(c >= 37 && c <= 40) return 1;
	}
	else if(stat == 12)
	{
		if(c >= 41 && c <= 44) return 1;
	}
	else if(stat == 13)
	{
		if(c >= 45 && c <= 48) return 1;
	}
	else if(stat == 14)
	{
		if(c >= 49 && c <= 52) return 1;
	}
	return 0;
}
stock is_nextstraightflush(c, next, stat)
{
	if(stat == 0)
	{
		if(c == 4 && next == 8 || c == 8 && next == 12 || c == 12 && next == 16 || c == 16 && next == 20 || c == 20 && next == 24 || c == 24 && next == 28
 		|| c == 28 && next == 32 || c == 32 && next == 36 || c == 36 && next == 40 || c == 40 && next == 44 || c == 44 && next == 48) return 1;
	}
	else if(stat == 1)
	{
		if(c == 3 && next == 7 || c == 7 && next == 11 || c == 11 && next == 15 || c == 15 && next == 19 || c == 19 && next == 23 || c == 23 && next == 27
 		|| c == 27 && next == 31 || c == 31 && next == 35 || c == 35 && next == 39 || c == 39 && next == 43 || c == 43 && next == 47) return 1;
 	}
 	else if(stat == 2)
 	{
 		if(c == 2 && next == 6 || c == 6 && next == 10 || c == 10 && next == 14 || c == 14 && next == 18 || c == 18 && next == 22 || c == 22 && next == 26
 		|| c == 26 && next == 30 || c == 30 && next == 34 || c == 34 && next == 38 || c == 38 && next == 42 || c == 42 && next == 46) return 1;
	}
 	else if(stat == 3)
 	{
 		if(c == 1 && next == 5 || c == 5 && next == 9 || c == 9 && next == 13 || c == 13 && next == 17 || c == 17 && next == 21 || c == 21 && next == 25
 		|| c == 25 && next == 29 || c == 29 && next == 33 || c == 33 && next == 37 || c == 37 && next == 41 || c == 41 && next == 45) return 1;
	}
	return 0;
}
stock is_nextstraight(c, n)
{
 	if((c == 1 || c == 2 || c == 3 || c == 4) && (n == 5 || n == 6 || n == 7 || n == 8)) return 1;
 	if((c == 5 || c == 6 || c == 7 || c == 8) && (n == 9 || n == 10 || n == 11 || n == 12)) return 1;
 	if((c == 9 || c == 10 || c == 11 || c == 12) && (n == 13 || n == 14 || n == 15 || n == 16)) return 1;
 	if((c == 13 || c == 14 || c == 15 || c == 16) && (n == 17 || n == 18 || n == 19 || n == 20)) return 1;
 	if((c == 17 || c == 18 || c == 19 || c == 20) && (n == 21 || n == 22 || n == 23 || n == 24)) return 1;
 	if((c == 21 || c == 22 || c == 23 || c == 24) && (n == 25 || n == 26 || n == 27 || n == 28)) return 1;
 	if((c == 25 || c == 26 || c == 27 || c == 28) && (n == 29 || n == 30 || n == 31 || n == 32)) return 1;
 	if((c == 29 || c == 30 || c == 31 || c == 32) && (n == 33 || n == 34 || n == 35 || n == 36)) return 1;
 	if((c == 33 || c == 34 || c == 35 || c == 36) && (n == 37 || n == 38 || n == 39 || n == 40)) return 1;
 	if((c == 37 || c == 38 || c == 39 || c == 40) && (n == 41 || n == 42 || n == 43 || n == 44)) return 1;
 	if((c == 41 || c == 42 || c == 43 || c == 44) && (n == 45 || n == 46 || n == 47 || n == 48)) return 1;
 	if((c == 45 || c == 46 || c == 47 || c == 48) && (n == 49 || n == 50 || n == 51 || n == 52)) return 1;
	return 0;
}
stock combo_desk(desk, p2, p3, p4, p5, p6)
{
	new k[5], find_kare[15], fleshroyal[4], find_straightflush[4], find_flush[4], set[15], stapid[3], da_flush;
    k[0] = p2;
	k[1] = p3;
	k[2] = p4;
	k[3] = p5;
	k[4] = p6;
    for(new card = 0; card < 5; card++)
	{
	    for(new m = 0; m < 4; m++)
	    {
	        if(is_flushroyal(k[card], m)) fleshroyal[m] ++;
	        if(fleshroyal[m] >= 5) return DeskInfo[desk][DesComb][0] = 1; // Только [ФЛЕШ РОЯЛЬ]
	        
	        if(is_mast(k[card], m) && k[card] < 49) find_straightflush[m] ++; // Карты одной Масти (Без тузов)
	        if(is_mast(k[card], m)) find_flush[m] ++; // Карты одной Масти (с тузами)
	        if(find_flush[m] >= 5) da_flush = 1;
	    }
	    
	    for(new ac = 2; ac < 15; ac++) // Карты одного Достоинства
		{
	    	if(is_kare(k[card], ac)) find_kare[ac] ++;
	    	if(find_kare[ac] >= 4) return DeskInfo[desk][DesComb][2] = 1; // Только [КАРЭ]
	    	
	    	if(find_kare[ac] >= 3) set[ac] = 1, stapid[0] = 1;
	    	if(find_kare[ac] >= 2 && set[ac] == 0) set[ac] = 1, stapid[1] = 1;
	    	if(find_kare[ac] >= 2 && set[ac] == 0) stapid[2] = 1;
		}
 	}
 	
	new mincard, findcard, straightflush = 1, ska;
	for(new m = 0; m < 4; m++)
	{
		if(find_straightflush[m] >= 5)
		{
		    for(new card = 0; card < 5; card++)
			{
			    if(k[card] > 0 && cardSuit[k[card]] == m+1)
			    {
	                if(mincard <= (findcard = k[card])) continue;
		            mincard = findcard;
		            ska = card;
       			}
			}
			mincard = k[ska];
			for(new card = 0; card < 5; card++)
			{
			    if(is_nextstraightflush(mincard, k[card], m)) mincard = k[card], straightflush ++;
			}
			break;
		}
	}
	if(straightflush >= 5) return DeskInfo[desk][DesComb][1] = 1; // Только [СТРИТ ФЛЕШ]
	
	if(stapid[0] == 1 && stapid[1] == 1) return DeskInfo[desk][DesComb][3] = 1; // Только [ФУЛЛ ХАУС]
	
	if(da_flush == 1) return DeskInfo[desk][DesComb][4] = 1; // Только [ФЛЕШ]
	
	new find_straight = 1;
	for(new card = 0; card < 5; card++)
	{
	    if(k[card] > 0)
	    {
	        if(mincard <= (findcard = k[card])) continue;
	        mincard = findcard;
	        ska = card;
		}
	}
	mincard = k[ska];
	for(new card = 0; card < 5; card++)
	{
	    if(is_nextstraight(mincard, k[card])) mincard = k[card], find_straight ++;
	}
	if(find_straight >= 5) return DeskInfo[desk][DesComb][5] = 1; // Только [СТРИТ]
	
	if(stapid[0] == 1 && stapid[1] == 0) return DeskInfo[desk][DesComb][6] = 1; // Только [СЭТ]
	
	if(stapid[1] == 1 && stapid[2] == 1) return DeskInfo[desk][DesComb][7] = 1; // Только [ДВЕ ПАРЫ]
	
	if(stapid[1] == 1) return DeskInfo[desk][DesComb][8] = 1; // Только [ПАРА]
	return 1;
}
stock kicker_combo(desk, p, mast)
{
    if(cardSuit[CardPlayer[0][desk][p]] == mast && cardSuit[CardPlayer[1][desk][p]] != mast) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
	else if(cardSuit[CardPlayer[1][desk][p]] == mast && cardSuit[CardPlayer[0][desk][p]] != mast) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
    else if(cardSuit[CardPlayer[0][desk][p]] == mast && cardSuit[CardPlayer[1][desk][p]] == mast)
    {
        if(cardDignity[CardPlayer[0][desk][p]] > cardDignity[CardPlayer[1][desk][p]]) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		else if(cardDignity[CardPlayer[1][desk][p]] > cardDignity[CardPlayer[0][desk][p]]) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
        else DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
    }
    return 1;
}
stock kicker_combo_nomast(desk, p, cardid)
{
	if(DeskInfo[desk][ComboKicker][p] == 0) DeskInfo[desk][ComboKicker][p] = CardPlayer[cardid][desk][p];
	else
	{
	    if(cardDignity[CardPlayer[cardid][desk][p]] > cardDignity[DeskInfo[desk][ComboKicker][p]]) DeskInfo[desk][ComboKicker][p] = CardPlayer[cardid][desk][p];
	}
    return 1;
}
stock combo_poke(desk, p, p0, p1, p2, p3, p4, p5, p6)
{
	new fleshroyal[4], find_straightflush[4], find_kare[15], k[7];
	new da_flushroyal[4], da_straightflush[4], da_kare[15], da_straight[4], hand_card[2];
	k[0] = p0;
	k[1] = p1;
	k[2] = p2;
	k[3] = p3;
	k[4] = p4;
	k[5] = p5;
	k[6] = p6;
	for(new card = 0; card < 7; card++)
	{
	    for(new m = 0; m < 4; m++)
		{
		    if(is_flushroyal(k[card], m))
			{
				fleshroyal[m] ++;
				if(card == 0 || card == 1) da_flushroyal[m] ++;
			}
			if(is_mast(k[card], m) && k[card] < 49)
			{
				find_straightflush[m] ++;
				if(card == 0 || card == 1) da_straightflush[m] ++;
			}
		}
	    
	    for(new ac = 2; ac < 15; ac++)
		{
		    if(is_kare(k[card], ac))
			{
				find_kare[ac] ++;
				if(card == 0 || card == 1) da_kare[ac] ++, hand_card[card] = ac;
			}
		}
	}
	
	// Флеш Рояль
	for(new m = 0; m < 4; m++)
	{
		if(fleshroyal[m] >= 5 && da_flushroyal[m] > 0)
		{
		    kicker_combo(desk, p, m+1);
			return 9;
		}
	}
	
	// Стрит Флеш
	new mincard, findcard, straightflush = 1, ska;
	for(new m = 0; m < 4; m++)
	{
		if(find_straightflush[m] >= 5 && da_straightflush[m] > 0)
		{
		    for(new card = 0; card < 7; card++)
			{
			    if(k[card] > 0 && cardSuit[k[card]] == m+1)
			    {
	                if(mincard <= (findcard = k[card])) continue;
		            mincard = findcard;
		            ska = card;
       			}
			}
			mincard = k[ska];
			for(new card = 0; card < 7; card++)
			{
			    if(is_nextstraightflush(mincard, k[card], m)) mincard = k[card], straightflush ++;
			}
			kicker_combo(desk, p, m+1);
			break;
		}
	}
	if(straightflush >= 5) return 8;
	
	// Карэ
	for(new ac = 0; ac < 15; ac++)
	{
		if(find_kare[ac] >= 4 && da_kare[ac] > 0)
		{
		    if(hand_card[0] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		    else if(hand_card[1] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
			return 7;
		}
	}
 	
 	// Фулл Хаус
 	new bool:full_one[15], stapid[2];
 	for(new ac = 0; ac < 15; ac++)
 	{
 		if(find_kare[ac] >= 3 && da_kare[ac] > 0)
	 	{
	 		full_one[ac] = true, stapid[0] = 1;
	 		if(hand_card[0] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		    else if(hand_card[1] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
 		}
 		if(find_kare[ac] >= 2 && da_kare[ac] > 0 && full_one[ac] == false)
	 	{
	 		stapid[1] = 1;
	 		if(stapid[0] == 0)
	 		{
	 			if(hand_card[0] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		    	else if(hand_card[1] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
    		}
    		else if(stapid[0] == 1)
    		{
    		    if(hand_card[0] == ac) DeskInfo[desk][ComboTwicker][p] = CardPlayer[0][desk][p];
		    	else if(hand_card[1] == ac) DeskInfo[desk][ComboTwicker][p] = CardPlayer[1][desk][p];
    		}
   		}
 	}
 	if(stapid[0] == 1 && stapid[1] == 1) return 6;
	
	// Флеш
	for(new m = 0; m < 4; m++)
	{
		if(find_straightflush[m] >= 5 && da_straightflush[m] > 0)
		{
		    kicker_combo(desk, p, m+1);
			return 5;
		}
	}
	
	// Стрит
	new find_straight = 1;
	DeskInfo[desk][ComboKicker][p] = 0;
	for(new card = 0; card < 7; card++)
	{
	    if(k[card] > 0)
	    {
            if(mincard <= (findcard = k[card])) continue;
            mincard = findcard;
            ska = card;
		}
	}
	mincard = k[ska];
	for(new card = 0; card < 7; card++)
	{
	    if(is_nextstraight(mincard, k[card]))
		{
			mincard = k[card], find_straight ++;
			if(card == 0 || card == 1)
			{
			    kicker_combo_nomast(desk, p, card);
			    da_straight[card] ++;
			}
		}
	}
	if(find_straight >= 5 && (da_straight[0] > 0 || da_straight[1] > 0)) return 4;
	
	// Сэт
	for(new ac = 0; ac < 15; ac++)
 	{
 	    if(find_kare[ac] >= 3 && da_kare[ac] > 0)
 	    {
 	        if(hand_card[0] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		    else if(hand_card[1] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
 	        if(DeskInfo[desk][DesComb][6] == 1 || DeskInfo[desk][DesComb][7] == 1) return 6;
			return 3;
 	    }
 	}
 	
 	// Две Пары
 	new bool:par_one[15], bool:newstapid[2];
 	for(new ac = 0; ac < 15; ac++)
 	{
 		if(find_kare[ac] >= 2 && da_kare[ac] > 0)
	 	{
	 		par_one[ac] = true, newstapid[0] = true;
	 		if(hand_card[0] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		    else if(hand_card[1] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
    	}
 		if(find_kare[ac] >= 2 && da_kare[ac] > 0 && par_one[ac] == false)
	 	{
		 	newstapid[1] = true;
		 	if(hand_card[0] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p];
		    else if(hand_card[1] == ac) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p];
    	}
	}
	if(newstapid[0] == true && newstapid[1] == true)
	{
	    if(DeskInfo[desk][DesComb][6] == 1) return 6;
	    else return 2;
	}
	
	// Пара
	if(newstapid[0] == true && newstapid[1] == false) return 1;
	
	
	if(cardDignity[CardPlayer[0][desk][p]] > cardDignity[CardPlayer[1][desk][p]]) DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p], DeskInfo[desk][ComboTwicker][p] = CardPlayer[1][desk][p];
	else if(cardDignity[CardPlayer[1][desk][p]] > cardDignity[CardPlayer[0][desk][p]]) DeskInfo[desk][ComboKicker][p] = CardPlayer[1][desk][p], DeskInfo[desk][ComboTwicker][p] = CardPlayer[0][desk][p];
    else DeskInfo[desk][ComboKicker][p] = CardPlayer[0][desk][p], DeskInfo[desk][ComboTwicker][p] = CardPlayer[1][desk][p];
	return 0;
}
stock dialog_raise(playerid)
{
    new str[100],sctring[630],desk = DeskID[playerid], atext[9], btext[9], ctext[3];
    if(DeskInfo[desk][Typebid] == 0) atext = "{0088ff}", ctext = "F";
    else atext = "{ffcc00}", ctext = "GF";
    if(DP[0][playerid] == 0) btext = "{cccccc}";
    else btext = "{ff9000}";
    
    format(str,sizeof(str),"%sВыбрано: %s%d %s (%s) \t ", btext, atext, DP[0][playerid], ctext, get_k(DP[0][playerid])), strcat(sctring,str);
    if(DP[0][playerid] <= 0) format(str,sizeof(str),"\n{ff9000}Выберите фишки \t "), strcat(sctring,str);
    else format(str,sizeof(str),"\n{99ff66}Повысить на %d %s \t ", DP[0][playerid], ctext), strcat(sctring,str);
    if(DeskInfo[desk][Typebid] == 0)
	{
	    if(DeskInfo[desk][Betsize] == 0)
	    {
	        for(new i = 0; i < 6; i++)
			{
				if(List[i][playerid] == 0) format(str,sizeof(str),"\n{cccccc}>> %d \t {cccccc}[%d]", betPoke_1[i], List[i][playerid]), strcat(sctring,str);
				else format(str,sizeof(str),"\n{ff9000}>> %d \t {ff9000}[%d]", betPoke_1[i], List[i][playerid]), strcat(sctring,str);
			}
		}
		else if(DeskInfo[desk][Betsize] == 1)
	    {
	        for(new i = 0; i < 6; i++)
			{
				if(List[i][playerid] == 0) format(str,sizeof(str),"\n{cccccc}>> %d \t {cccccc}[%d]", betPoke_2[i], List[i][playerid]), strcat(sctring,str);
				else format(str,sizeof(str),"\n{ff9000}>> %d \t {ff9000}[%d]", betPoke_2[i], List[i][playerid]), strcat(sctring,str);
			}
		}
	}
	else
	{
	    for(new i = 0; i < 6; i++)
		{
			if(List[i][playerid] == 0) format(str,sizeof(str),"\n{cccccc}>> %d \t {cccccc}[%d]", betPoke_0[i], List[i][playerid]), strcat(sctring,str);
			else format(str,sizeof(str),"\n{ff9000}>> %d \t {ff9000}[%d]", betPoke_0[i], List[i][playerid]), strcat(sctring,str);
		}
	}
	ShowDialog(playerid,1209,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Повысить Ставку",sctring,"Выбрать","Отмена");
	return 1;
}


public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if(CallPublic(playerid, 23)) return false;

    if(OnlineInfo[playerid][oLogged] == 0) return false;

	// Запрет прокликивания инвентаря при активном диалоге
	if (playertextid >= PlaInventDraw[0][playerid] && playertextid <= PlaNestTabs[11][playerid] && IsDialogOpened(playerid)) return 1;

	// Антифлуд
	new current_tick = GetTickCount();
    new interval = GetTickDiff(current_tick, Aftextdraw[playerid]);
    if(interval < 300) return 0; // Блокируем, если игрок клацает часто на кнопку

	// Мини-игра в нарколаборатории
	if(NarcoSpotPlayerInfo[playerid][nspLaboratoryGameHealth] > 0.0) return ClickTextDraw_LaboratoryGame(playerid, playertextid);

	// Редактор Текстур
	if(MenuInfo[playerid][zStat] == 1) return ClickTextDraw_TextureEditor(playerid, playertextid);

	if(OnlineInfo[playerid][oShowInterface] == 1 
		&& (Tabs_Load[playerid] == 10 || Tabs_Load[playerid] == 11 
			|| Tabs_Load[playerid] == 12 || Tabs_Load[playerid] == 13 || Tabs_Load[playerid] == 17)) ClickTextDraw_CraftProcess(playerid, playertextid);

	// Автосалон, Мотосалон, Авиасалон, Салон Катеров
	if(OnlineInfo[playerid][oShowInterface] == 16) return ClickTextDraw_VehicleShop(playerid, playertextid);

	// Редактор отображения модели в текстдраве
    if(typeDynamicTextDraw[playerid] == 1 && OnlineInfo[playerid][oShowInterface] == 15)
    {
        if(playertextid == DynamicTextDraw[1][playerid]) UpdateColorButtonEditModelDraw(playerid, 0), PlayerPlaySound(playerid,17803,0,0,0);
        if(playertextid == DynamicTextDraw[3][playerid]) UpdateColorButtonEditModelDraw(playerid, 1), PlayerPlaySound(playerid,17803,0,0,0);
        if(playertextid == DynamicTextDraw[5][playerid]) UpdateColorButtonEditModelDraw(playerid, 2), PlayerPlaySound(playerid,17803,0,0,0);
		if(playertextid == DynamicTextDraw[7][playerid]) UpdateColorButtonEditModelDraw(playerid, 3), PlayerPlaySound(playerid,17803,0,0,0);
        
        if(playertextid == DynamicTextDraw[9][playerid]) UpdatePositionEditModelDraw(playerid, 0); // Кнопка влево
        if(playertextid == DynamicTextDraw[10][playerid]) UpdatePositionEditModelDraw(playerid, 1); // Кнопка вправо
        
        if(playertextid == DynamicTextDraw[11][playerid]) // Кнопка Input
		{
			ShowDialog(playerid,1286,DIALOG_STYLE_INPUT,"{ff9000}Редактор Текстдравов","{cccccc}Введите значение для {ff9000}выбранной оси [ От -360.0 и до 360.0 ]","Принять","Отмена");
		}
		if(playertextid == DynamicTextDraw[12][playerid]) PlayerPlaySound(playerid,17803,0,0,0), SaveEditModelTextDraw(playerid); // Кнопка Save
    }
	
	// Кнопка ключ взлома текстдравов
	if(breakingDraw[playerid] == true)
	{
		if(playertextid == BreakingPlayerDraw[10][playerid]) ClickBreaking(playerid);
	}
	
	// Меню выбора каркаса
	if(DrawFrame[playerid] == true)
	{
		if(playertextid == BuyIntDraw[0][playerid]) // Стрелка влево
	    {
	        HidePlayerDialog(playerid);
	        PlayerPlaySound(playerid,17803,0,0,0);
	        DP[0][playerid] = GetWatchFramePrev(playerid, TP[0][playerid], GetPVarInt(playerid,"ModelInt"));
	        if(DP[0][playerid] == -1)
			{
				DP[0][playerid] = 0;
				SetPVarInt(playerid,"ModelInt",0);
			}
	        ShowFrame(playerid, DP[0][playerid]);
	    }
	    if(playertextid == BuyIntDraw[1][playerid]) // Стрелка вправо
	    {
	        HidePlayerDialog(playerid);
	        PlayerPlaySound(playerid,17803,0,0,0);
	        DP[0][playerid] = GetWatchFrameNext(playerid, TP[0][playerid], GetPVarInt(playerid,"ModelInt"), 1);
	        ShowFrame(playerid, DP[0][playerid]);
	    }
	    if(playertextid == BuyIntDraw[3][playerid]) // Кнопка купить
	    {
	        if(TP[0][playerid] == 0) return ErrorMessage(playerid, "{FF6347}В этом режиме нельзя купить планировку");
	        new frame = GetPVarInt(playerid,"ModelInt");
	        if(FrameInfo[frame][frModel] == 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Планировка не существует в этом слоте");
			if(FrameInfo[frame][frSale] == 0) return ErrorMessage(playerid, "{FF6347}Эта планировка временно не продаётся\nАдминистрация заблокировала продажу планировки");
			new string[174], stat = 0;
			if(TP[0][playerid] >= 1 && TP[0][playerid] <= 1000) // Дом
	        {
	            new d = TP[0][playerid];
	            if(FrameInfo[frame][frType] != 0 && FrameInfo[frame][frType] != 1) return ErrorMessage(playerid, "{FF6347}Эта планировка недоступна для домов");
	            if(DomInfo[d][dOmodel][0] == FrameInfo[frame][frModel]) return ErrorMessage(playerid, "{FF6347}Эта планировка уже установлен в дом");
	            if(DomInfo[d][dClass] > FrameInfo[frame][frClass] 
					&& FrameInfo[frame][frClass] > 0 && DomInfo[d][dClass] != 5
					&& FrameInfo[frame][frClass] != 5) return format(string,sizeof(string),"{FF6347}Эта планировка подходит для домов класса 1 - %d\nКласс дома, для которого вы хотите установить планировку: %d", FrameInfo[frame][frClass], DomInfo[d][dClass]), ErrorMessage(playerid, string);
        	    if(FrameInfo[frame][frClass] != DomInfo[d][dClass] && FrameInfo[frame][frClass] == 5) return format(string,sizeof(string),"{FF6347}Эта планировка подходит для домов VIP класса\nКласс дома, для которого вы хотите установить планировку: %d", DomInfo[d][dClass]), ErrorMessage(playerid, string);
	            stat = 0;
				if(oGetPlayerMoney(playerid) < FrameInfo[frame][frPrice]) return format(string, sizeof(string), "{FF6347}Вам не хватает денег\n{cccccc}Стоимость: %d$ [%s]",FrameInfo[frame][frPrice],get_k(FrameInfo[frame][frPrice])), ErrorMessage(playerid, string);
	        }
	        else if(TP[0][playerid] >= 3001 && TP[0][playerid] < 4000) // Бизнес
	        {
				if(FrameInfo[frame][frType] != 0 && FrameInfo[frame][frType] != 2) return ErrorMessage(playerid, "{FF6347}Эта планировка недоступна для бизнесов");
				stat = 1;
				if(oGetPlayerMoney(playerid) < FrameInfo[frame][frPrice]) return format(string, sizeof(string), "{FF6347}Вам не хватает денег\n{cccccc}Стоимость: %d$ [%s]",FrameInfo[frame][frPrice],get_k(FrameInfo[frame][frPrice])), ErrorMessage(playerid, string);
	        }
			else if(TP[0][playerid] >= 4000 && TP[0][playerid] < 5000) // Личный Редактор
	        {
				// if(!peoInfo[playerid][peoInEditor]) return ErrorMessage(playerid, "{FF6347}Вы не находитесь в редакторе");

				new line[100], lines[500];
	        	format(line,sizeof(line),"{cccccc}Вы хотите использовать эту планировку?\n"), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Тип планировки: {ff9000}%s", frameType[FrameInfo[frame][frType]]), strcat(lines,line);
	        	format(line,sizeof(line),"\n{cccccc}%s | Model: %d",FrameInfo[frame][frName],FrameInfo[frame][frModel]), strcat(lines,line);
				format(line,sizeof(line),"\n\n{FF6347}Внимание! Учитывайте тип планировки, при создании интерьера!"), strcat(lines,line);
				format(line,sizeof(line),"\n{FF6347}Пример: Вы не сможете установить интерьер с планировкой от бизнеса в дом"), strcat(lines,line);
	        	ShowDialog(playerid,1269,DIALOG_STYLE_MSGBOX,"{ff9000}Планировка",lines,"Да","Нет");
				return 1;
			}

	        new str[124],sctring[620];
	        format(str,sizeof(str),"{cccccc}Вы хотите приобрести эту планировку?\n"), strcat(sctring,str);
	        if(stat == 0) format(str,sizeof(str),"\n{cccccc}Установка: Дом № %d", TP[0][playerid]), strcat(sctring,str);
	        else if(stat == 1) format(str,sizeof(str),"\n{cccccc}Установка: %s № %d", bizname(TP[0][playerid]-3000), TP[0][playerid]-3000), strcat(sctring,str);
	        format(str,sizeof(str),"\n{cccccc}Стоимость: {99ff66}%d$ [%s]",FrameInfo[frame][frPrice],get_k(FrameInfo[frame][frPrice])), strcat(sctring,str);
	        format(str,sizeof(str),"\n{cccccc}%s | Model: %d",FrameInfo[frame][frName],FrameInfo[frame][frModel]), strcat(sctring,str);
	        format(str,sizeof(str),"\n\n{FF6347}Внимание! Если в здании уже имеется мебель - она будет полностью удалена"), strcat(sctring,str);
	        ShowDialog(playerid,1269,DIALOG_STYLE_MSGBOX,"{ff9000}Планировка",sctring,"Да","Нет");
	    }
	    if(playertextid == BuyIntDraw[9][playerid]) // Редактор каркасов
	    {
	        if(PlayerInfo[playerid][pSoska] >= 10) SettingFrame(playerid, GetPVarInt(playerid,"ModelInt"));
	    }
	}
	
	// Аксессуары, Оружие и Одежда
	if(OnlineInfo[playerid][oShowInterface] == 1)
	{
		if(playertextid == PlaInventDraw[13][playerid] && Backpack[playerid] != 0) return ShowTabInventory(playerid); // Открыть инвентарь
		if(playertextid == PlaInventDraw[15][playerid] && Backpack[playerid] != 1) return ShowTabBackpack(playerid); // Открыть рюкзак

	    if(playertextid == PlaNestAkses[0][playerid]) return aksess_tile(playerid, 0);
	    if(playertextid == PlaNestAkses[1][playerid]) return aksess_tile(playerid, 1);
	    if(playertextid == PlaNestAkses[2][playerid]) return aksess_tile(playerid, 2);
	    if(playertextid == PlaNestAkses[3][playerid]) return aksess_tile(playerid, 3);
	    if(playertextid == PlaNestAkses[4][playerid]) return aksess_tile(playerid, 4);
	    if(playertextid == PlaNestGun[0][playerid]) return gun_tile(playerid, 0);
	    if(playertextid == PlaNestGun[1][playerid]) return gun_tile(playerid, 1);
	    if(playertextid == PlaNestGun[2][playerid]) return gun_tile(playerid, 2);
	    if(playertextid == PlaNestGun[3][playerid]) return gun_tile(playerid, 3);
	    if(playertextid == PlaNestGun[4][playerid]) return gun_tile(playerid, 4);
	    if(playertextid == PlaNestGun[5][playerid]) return gun_tile(playerid, 5);
	    if(playertextid == PlaNestOthe[0][playerid]) return pc_cmd_undress(playerid);
	    if(playertextid == PlaNestOthe[2][playerid]) return pc_cmd_thing(playerid);
		if(playertextid == PlaInventDraw[1][playerid]) // Передать (Кнопка внизу)
		{
			if(OnlineInfo[playerid][oInventSelectLeft] == 9999) return ErrorMessage(playerid, "{FF6347}Выберите предмет в инвентаре, чтобы передать его другому игроку");
			new inva = OnlineInfo[playerid][oInventSelectLeft];
			
			new fpick = PlayerInfo[playerid][pInven][inva], thingType = PlayerInfo[playerid][pInvenType][inva], thingPack = PlayerInfo[playerid][pInvenPack][inva];
			PlayerPlaySound(playerid,17803,0,0,0);
			Veshi[playerid] = OnlineInfo[playerid][oInventSelectLeft];

			new string[140];
   			format(string,sizeof(string),"{cccccc}Введите ID или Никнейм игрока, которому хотите передать: {ff9000}%s", GetNameThing(1, fpick, thingType, thingPack));
			ShowDialog(playerid,905,DIALOG_STYLE_INPUT,"{FF9000}Инвентарь",string,"Принять","Отмена");
		}
		if(playertextid == PlaInventDraw[2][playerid]) // Продать
		{
		    if(OnlineInfo[playerid][oInventSelectLeft] == 9999) return ErrorMessage(playerid, "{FF6347}Выберите предмет в инвентаре, чтобы продать его другому игроку");
		    new inva = OnlineInfo[playerid][oInventSelectLeft];
		
		    new fpick = PlayerInfo[playerid][pInven][inva], thingType = PlayerInfo[playerid][pInvenType][inva], thingPack = PlayerInfo[playerid][pInvenPack][inva];
			if(thingPack == 1) return ErrorMessage(playerid, "{FF6347}Подарок нельзя продать\n\n{cccccc}Подарите его кому-нибудь ;)");
			//if(thingPack >= 2) return ErrorMessage(playerid, "{FF6347}Нельзя продать упакованный предмет");
			PlayerPlaySound(playerid,17803,0,0,0);
			Veshi[playerid] = OnlineInfo[playerid][oInventSelectLeft];

			new string[140];
   			format(string,sizeof(string),"{cccccc}Введите ID или Никнейм игрока, которому хотите {99ff66}продать {ff9000}%s", GetNameThing(1, fpick, thingType, thingPack));
			ShowDialog(playerid,1095,DIALOG_STYLE_INPUT,"{FF9000}Инвентарь",string,"Принять","Отмена");
		}
		if(playertextid == PlaInventDraw[3][playerid]) PlayerPlaySound(playerid,17803,0,0,0), pc_cmd_shop(playerid); // Торговля
		if(playertextid == PlaInventDraw[4][playerid]) // Выбросить
		{
			if(OnlineInfo[playerid][oInventSelectLeft] != 9999 && OnlineInfo[playerid][oInventSelectRight] != 9999) return ErrorMessage(playerid, "{FF6347}Вы выбрали сразу два предмета в разных вкладках"), Veshi[playerid] = 0, i_resetveshi(playerid);
			if(OnlineInfo[playerid][oInventSelectLeft] != 9999)
			{
			    new inva = OnlineInfo[playerid][oInventSelectLeft];
				Veshi[playerid] = inva;
				new fpick = PlayerInfo[playerid][pInven][inva], thingQuan = PlayerInfo[playerid][pInvenQuan][inva], thingType = PlayerInfo[playerid][pInvenType][inva], thingPack = PlayerInfo[playerid][pInvenPack][inva], fPara = PlayerInfo[playerid][pInvenPara][inva];
				
				// Проверка на особые предметы
				if(NotGiveInflatabelBoat(playerid, fpick, thingType)) return i_resetveshi(playerid);
				if(MineWar_IsPlayerInside(playerid) || Tomb_IsPlayerInside(playerid)) return ErrorMessage(playerid, "{ff6347}Нельзя выбрасывать предметы в этом месте"), i_resetveshi(playerid);
				
				new string[140];
				DP[0][playerid] = inva;

				
				new price = getThingPriceGos(fpick, thingType) / 10;
				DP[1][playerid] = price;

				if(thingType == 0 && thingPack == 0)
				{
				    if(CheckThingQuan(fpick) == 1)
					{
						if(IsPlayerInRangeOfPoint(playerid,3.0,1327.3071, 1555.0947, 1114.9565) && GetPlayerVirtualWorld(playerid) == WORLD_SKUPSHIK && GetPlayerInterior(playerid) == INT_SKUPSHIK)
						{
							if(getThingPriceGos(fpick, thingType) == -1) return ErrorMessage(playerid, "{ff6347}Скупщик не покупает данный предмет"), i_resetveshi(playerid);
							if(SkupshikListItem(fpick,thingType,fPara) != 1) 
							{
								Veshi[playerid] = 0;
								if(fPara < gettime() && PerishableThing(fpick,thingType)) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Его срок годности истек."),i_resetveshi(playerid);
								//else if(thingType != 0) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Скупщик скупает только обычные предметы"),i_resetveshi(playerid);
								else return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику"),i_resetveshi(playerid);
							}
							new line[120],lines[240];
							format(line,sizeof(line),"{cccccc}Вы уверены, что хотите продать {ff9000}Скупщику {cccccc}предмет {ff9000}%s ?", GetNameThing(0, fpick, thingType, thingPack)), strcat(lines,line);
							format(line,sizeof(line),"\n{cccccc}1 {ff9000}%s {cccccc}стоит {44ff99}%d$",GetNameThing(0, fpick, thingType, thingPack), price), strcat(lines,line);
							ShowDialog(playerid,495,DIALOG_STYLE_INPUT,"{FF9000}Скупщик",lines,"Да","Нет");
							return 1;
						}
						else
						{
							format(string,sizeof(string),"{cccccc}Чтобы выбросить {ff9000}%s {FFFFFF}введите количество\n\nНе меньше 1 и не больше 1.000.000",GetNameThing(1, fpick, thingType, thingPack));
							ShowDialog(playerid,495,DIALOG_STYLE_INPUT,"{FF9000}Инвентарь",string,"Принять","Отмена");
							return 1;
						}
					}
				}

				// Шкатулка нельзя выбрасывать на 3 уровне и ниже
				if(IsNotGiveCase(playerid, thingPack)) return i_resetveshi(playerid),i_resettabs(playerid);

				if(IsPlayerInRangeOfPoint(playerid,3.0,1327.3071, 1555.0947, 1114.9565) && GetPlayerVirtualWorld(playerid) == WORLD_SKUPSHIK && GetPlayerInterior(playerid) == INT_SKUPSHIK)
				{
					if(getThingPriceGos(fpick, thingType) == -1) return ErrorMessage(playerid, "{ff6347}Скупщик не покупает данный предмет"), i_resetveshi(playerid);
					if(thingPack != 0) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Он принимает только распакованные предметы."),i_resetveshi(playerid),Veshi[playerid] = 0;
					if(SkupshikListItem(fpick,thingType,fPara) != 1) 
					{
						Veshi[playerid] = 0;
						if(fPara < gettime() && PerishableThing(fpick,thingType)) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Его срок годности истек."),i_resetveshi(playerid);
						//else if(thingType != 0) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Скупщик скупает только обычные предметы"),i_resetveshi(playerid);
						else return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику"),i_resetveshi(playerid);
					}
					else
					{
						new line[120],lines[240];
						format(line,sizeof(line),"{cccccc}Вы уверены, что хотите продать {ff9000}Скупщику {cccccc}предмет {ff9000}%s ?", GetNameThing(0, fpick, thingType, thingPack)), strcat(lines,line);
						format(line,sizeof(line),"\n{cccccc}1 {ff9000}%s {cccccc}стоит {44ff99}%d$",GetNameThing(0, fpick, thingType, thingPack), price), strcat(lines,line);
						ShowDialog(playerid,495,DIALOG_STYLE_MSGBOX,"{FF9000}Скупщик",lines,"Да","Нет");
						return 1;
					}
				}
				else
				{
					if(NotGiveThing(fpick, thingType, thingQuan, thingPack))
					{
						format(string,sizeof(string),"{cccccc}Вы уверены, что хотите выбросить {ff9000}%s ?\n{FF6347}Внимание! Этот предмет будет полностью уничтожен",GetNameThing(0, fpick, thingType, thingPack));
						ShowDialog(playerid,495,DIALOG_STYLE_MSGBOX,"{FF9000}Инвентарь",string,"Да","Нет");
					}
					else
					{
						new line[120],lines[720];
						format(line,sizeof(line),"{cccccc}Вы уверены, что хотите выбросить {ff9000}%s ?", GetNameThing(0, fpick, thingType, thingPack)), strcat(lines,line);
						format(line,sizeof(line),"\n\n{FF6347}Внимание!"), strcat(lines,line);
						format(line,sizeof(line),"\n{ffcc66}Запрещено выбрасывать предметы на дороги и проезжие части"), strcat(lines,line);
						format(line,sizeof(line),"\n{ffcc66}Не создавайте помехи дорожному движению"), strcat(lines,line);
						format(line,sizeof(line),"\n\n{FF6347}В случае нарушения"), strcat(lines,line);
						format(line,sizeof(line),"\n{ffcc66}Администрация может выдать вам {FF6347}WARN или отправить в Prison"), strcat(lines,line);
						ShowDialog(playerid,495,DIALOG_STYLE_MSGBOX,"{FF9000}Инвентарь",lines,"Да","Нет");
					}
				}
			}
			else if(OnlineInfo[playerid][oInventSelectRight] != 9999)
			{
				if(Tabs_Load[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя выбросить чужие товары"), i_resettabs(playerid);
				else if(Tabs_Load[playerid] == 3) return ErrorMessage(playerid, "{FF6347}Нельзя выбрасывать предметы со склада"), i_resettabs(playerid);
				else if(Tabs_Load[playerid] == 4) return ErrorMessage(playerid, "{FF6347}Нельзя выбрасывать предметы со склада"), i_resettabs(playerid);
				else if(Tabs_Load[playerid] == 6) return ErrorMessage(playerid, "{FF6347}Нельзя выбросить товары [ Переложите предмет в основной инвентарь ]"), i_resettabs(playerid);
			    else if(Tabs_Load[playerid] == 7) return ErrorMessage(playerid, "{FF6347}Этот предмет уже выброшен"), i_resettabs(playerid);
			    else if(Tabs_Load[playerid] == 5) return ErrorMessage(playerid, "{FF6347}Предмет нужно взять к себе и только потом выбросить"), i_resettabs(playerid);
				else if(Tabs_Load[playerid] == 2) // Дом
				{
					if(Veshi[playerid] >= 1) return 0;
					new d = OnlineInfo[playerid][oShowTabs], inva = OnlineInfo[playerid][oInventSelectRight];
					new fpick = DomInfo[d][dInvent][inva], thingType = DomInfo[d][dInvType][inva], thingPack = DomInfo[d][dInvPack][inva];
					PlayerPlaySound(playerid,17803,0,0,0);
					if(IsANearWardrobeDom(playerid, d))
					{
						if(PlayerInfo[playerid][pDom] != d)
						{
							if(DomInfo[d][dAcccupD] == 0) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа этого дома может только владелец"), i_resettabs(playerid);
							if(DomInfo[d][dAcccupD] == 1 && PlayerInfo[playerid][pHouserent] != d) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа этого дома может только владелец и проживающие"), i_resettabs(playerid);
							if(DomInfo[d][dAcccupD] == 2 && (DomInfo[d][dFam] == 0 || DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[d][dFam])) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа этого дома может только владелец и семья, которая здесь живёт"), i_resettabs(playerid);
							if(DomInfo[d][dAcccupD] == 3 && (DomInfo[d][dFam] == 0 || DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[d][dFam]) && PlayerInfo[playerid][pHouserent] != d) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа этого дома может только владелец, проживающие и семья, которая здесь живёт"), i_resettabs(playerid);
						}
						if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или редактированием объекта"), i_resettabs(playerid);
						if(thingType == 4 && DomInfo[d][dInv][inva] == 1000) return ErrorMessage(playerid, "{FF6347}Этот предмет мебели кто-то устанавливает"), i_resettabs(playerid);

						new string[180];
						DP[0][playerid] = inva;
						format(string,sizeof(string),"{cccccc}Вы уверены что хотите выбросить {ff9000}%s ?\n\n{FF6347}Внимание!\nПредмет, выброшенный из дома, полностью удаляется с сервера",GetNameThing(0, fpick, thingType, thingPack));
						ShowDialog(playerid,889,DIALOG_STYLE_MSGBOX,"{FF9000}Дом",string,"Да","Нет");
					}
				}
				else if(Tabs_Load[playerid] == 9) // Бизнес
				{
					if(Veshi[playerid] >= 1) return 0;
					new b = OnlineInfo[playerid][oShowTabs], inva = OnlineInfo[playerid][oInventSelectRight];
					new fpick = BizzInfo[b][bInvent][inva], thingType = BizzInfo[b][bInvType][inva], thingPack = BizzInfo[b][bInvPack][inva];
					PlayerPlaySound(playerid,17803,0,0,0);
					if(IsPlayerInRangeOfPoint(playerid,200.0,BizzInfo[b][bInteriorX], BizzInfo[b][bInteriorY], BizzInfo[b][bInteriorZ]))
					{
						new string[180];
					    DP[0][playerid] = inva;
						format(string,sizeof(string),"{cccccc}Вы уверены что хотите выбросить {ff9000}%s ?\n\n{FF6347}Внимание!\nПредмет, выброшенный из бизнеса, полностью удаляется с сервера",GetNameThing(0, fpick, thingType, thingPack));
						ShowDialog(playerid,1270,DIALOG_STYLE_MSGBOX,"{FF9000}Бизнес",string,"Да","Нет");
					}
				}
			}
			else if(IsPlayerInRangeOfPoint(playerid,3.0,1327.3071, 1555.0947, 1114.9565) && GetPlayerVirtualWorld(playerid) == WORLD_SKUPSHIK && GetPlayerInterior(playerid) == INT_SKUPSHIK) ErrorMessage(playerid, "{FF6347}Выберите предмет в инвентаре, чтобы продать его {ff9000}Скупщику\n\n{cccccc}После подтверждения продажи предмет нельзя будет вернуть!");
			else ErrorMessage(playerid, "{FF6347}Выберите предмет в инвентаре, чтобы выбросить его\n\n{cccccc}Предметы из инвентаря - падают на землю\n{cccccc}Предметы из дома и склада бизнеса - полностью удаляются");
		}
		if(playertextid == PlaInventDraw[11][playerid]) // Настроить Аксессуар
		{
			if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Вы уже редактируете предмет");
			PlayerPlaySound(playerid,17803,0,0,0);
			if(LoadPick[playerid] != 9999)
			{
			    new inva = LoadPick[playerid], atta;
				if(PlayerInfo[playerid][pOdet][inva] >= 1)
			 	{
			 	    if(Device[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Недоступно во время игры на смартфоне");
			 		CancelSelectTextDraw(playerid);
			 		CloseFrisk(playerid);
			 	    if(inva == 0) atta = 5;
			 	    else if(inva == 1) atta = 6;
			 	    else if(inva == 2) atta = 7;
			 	    else if(inva == 3) atta = 8;
			 	    else if(inva == 4) atta = 9;
			 	    gRedakt[playerid] = REDAKT_TYPE_ACCS;
			 		EditAttachedObject(playerid, atta);
				}
			}
			else ErrorMessage(playerid, "{FF6347}Ошибка! Выберите аксессуар");
		}
		if(playertextid == PlaInventDraw[7][playerid]) // Сытость Повысить (Админ команда)
		{
		    if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] <= 0 && PlayerInfo[playerid][pMedia] <= 0) return 1;
			if(PlayerInfo[playerid][pNeon] >= 1000) return 1;
			UpdateHunger(playerid, 1000), PlayerPlaySound(playerid,1052,0,0,0), UpdatePotreb(playerid);
			PlayerTextDrawSetSelectable(playerid, PlaInventDraw[7][playerid], false);
			PlayerTextDrawShow(playerid, PlaInventDraw[7][playerid]);
		}
		if(playertextid == PlaInventDraw[8][playerid]) // Бодрость Повысить (Админ команда)
		{
		    if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] <= 0 && PlayerInfo[playerid][pMedia] <= 0) return 1;
		    if(PlayerInfo[playerid][pMechSkill] >= 1000) return 1;
		    PlayerInfo[playerid][pMechSkill] = 1000, PlayerPlaySound(playerid,1052,0,0,0), UpdatePotreb(playerid);
		    if(Effect[playerid] == 0) SetPlayerDrunkLevel(playerid, 0);
		    PlayerTextDrawSetSelectable(playerid, PlaInventDraw[8][playerid], false);
		    PlayerTextDrawShow(playerid, PlaInventDraw[8][playerid]);
		}
		if(playertextid == PlaInventDraw[9][playerid]) // Нужда Повысить (Админ команда)
		{
		    if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] <= 0 && PlayerInfo[playerid][pMedia] <= 0) return 1;
		    if(PlayerInfo[playerid][pCap] >= 100) return 1;
		    PlayerInfo[playerid][pCap] = 100, PlayerPlaySound(playerid,1052,0,0,0), UpdatePotreb(playerid);
		    TextDrawHideForPlayer(playerid, PissDraw), TextDrawHideForPlayer(playerid, PissDraw2);
		    PlayerTextDrawSetSelectable(playerid, PlaInventDraw[9][playerid], false);
		    PlayerTextDrawShow(playerid, PlaInventDraw[9][playerid]);
		}
		if(playertextid == PlaInventDraw[10][playerid]) // Гигиена Повысить (Админ команда)
		{
		    if(PlayerInfo[playerid][pSoska] <= 0 && PlayerInfo[playerid][pHidden] <= 0 && PlayerInfo[playerid][pMedia] <= 0) return 1;
		    if(PlayerInfo[playerid][pInfoload] >= 1000) return 1;
		    PlayerInfo[playerid][pInfoload] = 1000, PlayerPlaySound(playerid,1052,0,0,0), UpdatePotreb(playerid);
		    RemovePlayerAttachedObject(playerid,0);
   			if(vampire[playerid] == 1) SetPlayerAttachedObject(playerid, 0, 18726, 1, -2.033999, 0.000000, -0.203000, 0.000000, 86.199981, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
   			PlayerTextDrawSetSelectable(playerid, PlaInventDraw[10][playerid], false);
   			PlayerTextDrawShow(playerid, PlaInventDraw[10][playerid]);
		}
 	}
	
	// Казино (Карты)
	if(DeskStatus[playerid] == 1)
	{
	    // Настройки Комнаты Казино
	    new desk = DeskID[playerid], place = DeskMyPlace[playerid];
	    if(DeskInfo[desk][Leaderid] == playerid && DeskInfo[desk][Leaderidstatus] > 0)
	    {
			if(playertextid == DeskLeaderDraw[playerid]) PlayerPlaySound(playerid,17803,0,0,0), dialog_setting_kasino(playerid);
		}
	
	    // Кнопка Участника Казино
		for(new p = 0; p < MAX_PLAYER_DESK; p++)
	    {
	        if(DeskInfo[desk][Playerstatus][p] > 0)
			{
			    new memberid = DeskInfo[desk][Playerid][p];
			    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
				{
				    if(playertextid == HudPlaceDraw[1][playerid][p]) PlayerPlaySound(playerid,17803,0,0,0), dialog_member_kasino(playerid, memberid, p);
				}
			}
		}
		
		if(OnlineInfo[playerid][oShowInterface] == 11)
		{
		    if(playertextid == DeskPlayerMenuDraw[0][playerid]) // Кнопка FOLD (Покер)
		    {
				if(DeskInfo[desk][Game] == 3 && DeskInfo[desk][Playerstatus][place] == 3)
				{
				    DeskInfo[desk][Walking] ++;
				    PlayerPlaySound(playerid,17803,0,0,0);
				    playaudiodesk(desk, 6801);
				    CardPlayer[0][desk][place] = 0, CardPlayer[1][desk][place] = 0;
   					QuanCardPlayer[desk][place] = 0;
                    DeskInfo[desk][Playerstatus][place] = 1;
                    update_textdraw_card_player(desk, place);
                    DeskInfo[desk][QuanGame] --;
                    if(DeskInfo[desk][QuanGame] >= 2) send_hud_message(playerid, desk, place, 4), show_draw_player_menu(playerid, desk);
                    new net;
				    if(DeskInfo[desk][QuanGame] <= 1 && DeskInfo[desk][Status] >= 3) // Последний Вышел
				    {
				        for(new p = 0; p < MAX_PLAYER_DESK; p++)
						{
						    if(DeskInfo[desk][Playerstatus][p] > 0)
							{
							    new memberid = DeskInfo[desk][Playerid][p];
							    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
								{
									if(DeskInfo[desk][Playerstatus][p] == 3) win_game(desk, p, memberid, DeskInfo[desk][Bank], 2, DeskInfo[desk][Game]);
								}
							}
						}
				        stop_game(desk);
				        net = 1;
				    }
                    if(DeskInfo[desk][Status] >= 3 && DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place && net == 0) go_walk(desk, get_member_next(desk, place), 0, 0); // Сделал FOLD чел, который ходит
				    return 1;
				}
			}
			
            // Кнопка GO или CHECK в Покере (в дурака этой кнопки нет)
			if(playertextid == DeskPlayerMenuDraw[2][playerid])
		    {
			    if(DeskInfo[desk][Status] <= 1) // Ожидание
				{
				    new tmphour,tmpminute,tmpsecond;
					gettime(tmphour, tmpminute, tmpsecond);
					if((tmphour == 2 && tmpminute >= 30 || tmphour == 3 && tmpminute <= 3) && PlayerInfo[playerid][pSoska] <= 22) return ErrorMessage(playerid, "{FF6347}Скоро ночной рестарт сервера [ Начать игру в карты можно только после 3:00 ]");
				    if(DeskInfo[desk][QuanPlayer] <= 1) return ErrorMessage(playerid, "{FF6347}За столом недостаточно участников");
					if(DeskInfo[desk][Playerstatus][place] >= 2) return ErrorMessage(playerid, "{FF6347}Вы уже сообщили о готовности. Дождитесь остальных игроков");

					new string[120];
					if(DeskInfo[desk][Typebid] == 0 && PlayerInfo[playerid][pAmmos1] < DeskInfo[desk][Bet]) return format(string,sizeof(string),"{FF6347}Вам не хватает Фишек {cccccc}[Ставка стола: %d F]", DeskInfo[desk][Bet]), ErrorMessage(playerid, string);
                    if(DeskInfo[desk][Typebid] == 1 && PlayerInfo[playerid][pAmmos8] < DeskInfo[desk][Bet]) return format(string,sizeof(string),"{FF6347}Вам не хватает Gold Фишек {cccccc}[Ставка стола: %d GF]", DeskInfo[desk][Bet]), ErrorMessage(playerid, string);
				    DeskInfo[desk][Playerstatus][place] = 2;
				    DeskInfo[desk][QuanGame] ++;
				    DeskInfo[desk][Timer] = 3;
				    DeskInfo[desk][Status] = 1;
					send_hud_message(playerid, desk, place, 8); // Отправляем Сообщение GO!
					return 1;
				}
				else
				{
					if(DeskInfo[desk][Playerstatus][place] <= 2 || DeskInfo[desk][Playerstatus][place] == 4) return ErrorMessage(playerid, "{FF6347}Дождитесь завершения текущей игры");
				}
			}
			
			// Кнопка БЕРУ, БИТО, НЕТ (Дурак)
			if(playertextid == DeskPlayerMenuDraw[2][playerid])
			{
			    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
			    {
				    if(DeskInfo[desk][Lastor] == 0 && DeskInfo[desk][Status] == 4 && DeskInfo[desk][Push] == 0) // БЕРУ
					{
				        if(DeskInfo[desk][Underwalk] > 0 && DeskInfo[desk][Underwalk]-1 == place && DeskInfo[desk][DeskCard][0] > 0)
		    	    	{
		    	    	    if(SelectCard[desk][place] > 0) deselect_card(playerid, desk, place);
		    	    	    PlayerPlaySound(playerid,17803,0,0,0);
		    	    	    DeskInfo[desk][Lastor] = 2;
		    	    	    send_hud_message(playerid, desk, place, 2);
		    	    	    for(new p = 0; p < MAX_PLAYER_DESK; p++)
							{
							    if(DeskInfo[desk][Playerstatus][p] > 0) show_draw_player_menu(DeskInfo[desk][Playerid][p], desk);
							}
		    	    	    if(DeskInfo[desk][DeskCard][5] > 0) DeskInfo[desk][Timer] = 3;
		    	    	    else if(DeskInfo[desk][DeskCard][5] == 0 && DeskInfo[desk][Walk]-1 == place)
							{
								DeskInfo[desk][Timer] = -1, DeskInfo[desk][Status] = 3, go_walk(desk, DeskInfo[desk][Nowhod], 0, 1); // Сейчас ход на мне, потому сразу переключаем обратно челу
							}
		    	    	    return 1;
		    	    	}
					}
					if(DeskInfo[desk][Status] == 3 && DeskInfo[desk][Timer] <= 0 && DeskInfo[desk][Lastor] != 1 && DeskInfo[desk][Push] == 0) // БИТО или НЕТ
					{
					    if(DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place && DeskInfo[desk][DeskCard][0] > 0)
		    	    	{
		    	    	    if(SelectCard[desk][place] > 0) deselect_card(playerid, desk, place);
						    if(DeskInfo[desk][Lastor] == 0) send_hud_message(playerid, desk, place, 3);
						    else if(DeskInfo[desk][Lastor] == 2) send_hud_message(playerid, desk, place, 9);
						    PlayerPlaySound(playerid,17803,0,0,0);
						    DeskInfo[desk][Nakidali] ++;
							if(DeskInfo[desk][Nakidali] >= DeskInfo[desk][QuanGame]-1) // Все челы нажали "Бито или НЕТ"
							{
							    if(DeskInfo[desk][Lastor] == 0) DeskInfo[desk][Lastor] = 1;
								DeskInfo[desk][Timer] = 3;
								DeskInfo[desk][Push] = 1;
							}
							else
							{
							    new place_walk;
							    place_walk = get_member_next(desk, DeskInfo[desk][Underwalk]-1);
							    if(place_walk == DeskInfo[desk][Walk]-1) place_walk = get_member_next(desk, DeskInfo[desk][Walk]-1);
								go_walk(desk, place_walk, 0, 1);
							}
							return 1;
						}
					}
				}
				else if(DeskInfo[desk][Game] == 3) // Кнопка CHECK
			    {
			        if(DeskInfo[desk][Status] == 3)
			        {
			            if(DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place)
			            {
				            send_hud_message(playerid, desk, place, 5);
				            PlayerPlaySound(playerid,17803,0,0,0);
				            DeskInfo[desk][Walking] ++;
				            DeskInfo[desk][Nakidali] ++;
				            if(DeskInfo[desk][Nakidali] >= DeskInfo[desk][QuanGame]) next_card_poke(desk);
				            else
							{
							    new place_walk = get_member_next(desk, DeskInfo[desk][Walk]-1);
								go_walk(desk, place_walk, 0, 1);
							}
			            }
			            else PlayerPlaySound(playerid,4203,0,0,0);
			        }
			        else PlayerPlaySound(playerid,4203,0,0,0);
			    }
			}
			
			// Кнопка CALL (Уравнять ставку)
			if(playertextid == DeskPlayerMenuDraw[4][playerid])
			{
				if(DeskInfo[desk][Game] == 3)
			    {
			        if(DeskInfo[desk][Status] >= 4)
			        {
			            if(DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place)
						{
						    send_hud_message(playerid, desk, place, 6);
						    PlayerPlaySound(playerid,17803,0,0,0);
						    DeskInfo[desk][Walking] ++;
				            DeskInfo[desk][Nakidali] ++;
				            new price_call = DeskInfo[desk][Raise];
						    if(DeskInfo[desk][Typebid] == 0)
						    {
						    	if(PlayerInfo[playerid][pAmmos1] < DeskInfo[desk][Raise]) price_call = PlayerInfo[playerid][pAmmos1];
					    	}
					    	else
							{
							    if(PlayerInfo[playerid][pAmmos8] < DeskInfo[desk][Raise]) price_call = PlayerInfo[playerid][pAmmos8];
							}
						    put_bank_desk(playerid, desk, place, price_call, 2);
						    update_bank_desk(desk);
						    if(DeskInfo[desk][Nakidali] >= DeskInfo[desk][QuanGame]) next_card_poke(desk);
						}
			            else PlayerPlaySound(playerid,4203,0,0,0);
			        }
			        else PlayerPlaySound(playerid,4203,0,0,0);
			    }
			}
			
			// Кнопка RAISE (Повысить ставку в Покере)
			if(playertextid == DeskPlayerMenuDraw[6][playerid])
			{
				if(DeskInfo[desk][Game] == 3)
			    {
			        if(DeskInfo[desk][Status] >= 3)
			        {
			            if(DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place)
						{
						    List[0][playerid] = 0, List[1][playerid] = 0, List[2][playerid] = 0, List[3][playerid] = 0, List[4][playerid] = 0, List[5][playerid] = 0;
							DP[0][playerid] = 0, dialog_raise(playerid), PlayerPlaySound(playerid,17803,0,0,0);
						}
			            else PlayerPlaySound(playerid,4203,0,0,0);
			        }
			    }
			}
		}

		// Нажимаем на карту в моих руках
		new yescard;
	    for(new gcd = 0; gcd < 52; gcd++)
		{
		    if(playertextid == PlayerCardDraw[gcd][playerid])
	    	{
	    	    if(CardPlayer[gcd][desk][place] > 0) yescard = gcd+1;
	    	}
  		}
  		if(yescard >= 1)
  		{
  		    new cd = yescard-1;
	        if(CardPlayer[cd][desk][place] > 0 && (DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) && DeskInfo[desk][Push] == 0)
	    	{
	    	    if(DeskInfo[desk][Status] <= 2 || DeskInfo[desk][Walk] == 0 || DeskInfo[desk][Underwalk] == 0) return ErrorMessage(playerid, "{FF6347}Игра ещё не началась, дождитесь раздачи карт и распределения ходов");
	    	    // Хожу (Или подкидываю карты)
	    	    if(DeskInfo[desk][Status] == 3)
	    	    {
	    	    	if(DeskInfo[desk][Walk]-1 != place) return PlayerPlaySound(playerid,4203,0,0,0);
	    	    	else if(DeskInfo[desk][Walk]-1 == place) walk_card(playerid, desk, cd, place);
    	    	}
    	    	
    	    	// Кроюсь (Крою чужие карты)
    	    	else if(DeskInfo[desk][Status] == 4)
	    	    {
	    	        if(DeskInfo[desk][Walk]-1 != place || DeskInfo[desk][Underwalk]-1 != place) return PlayerPlaySound(playerid,4203,0,0,0);
	    	    	else if(DeskInfo[desk][Walk]-1 == place && DeskInfo[desk][Underwalk]-1 == place) select_card(playerid, desk, cd, place);
	    	    }
	    	}
	    }
	    
	    // Нажимаем на карту на столе
	    if((DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) && DeskInfo[desk][Status] == 4 && DeskInfo[desk][Lastor] == 0 && DeskInfo[desk][Push] == 0)
		{
		    for(new tdc = 0; tdc < 6; tdc++)
		    {
		        if(playertextid == DeskCardDraw[tdc][playerid])
		        {
		            if(DeskInfo[desk][Underwalk]-1 == place)
		            {
						if(SelectCard[desk][place] > 0 && DeskInfo[desk][DeskCard][tdc] > 0 && DeskInfo[desk][DeskCardCover][tdc] == 0) underwalk_card(playerid, desk, tdc, place);
						else if(SelectCard[desk][place] > 0 && DeskInfo[desk][Game] == 2 && DeskInfo[desk][DeskCard][0] > 0 && DeskInfo[desk][DeskCardCover][0] == 0 && DeskInfo[desk][DeskCard][tdc] == 0) transfer_card(playerid, desk, tdc, place);
					}
		        }
	    	}
 		}
		return 1;
	}
	
    // Инвентарь
	if(OnlineInfo[playerid][oShowInterface] == 1)
	{
		// Стоимость Товара
		if(playertextid == PlaNestPrice[playerid])
		{
			if(OnlineInfo[playerid][oShowInterface] == 1 && Tabs_Load[playerid] == 6 && OnlineInfo[playerid][oInventSelectRight] != 9999)
			{
			    if(PlayerInfo[playerid][pMarkInven][OnlineInfo[playerid][oInventSelectRight]] == 0) return ErrorMessage(playerid, "{FF6347}В этом слоте нет товара! {cccccc}[ Возможно его уже кто-то купил ]");
				PlayerPlaySound(playerid,17803,0,0,0);
	 			ShowDialog(playerid,1105,DIALOG_STYLE_INPUT,"{ff9000}Торговля","{cccccc}Введите {99ff66}стоимость {cccccc}выбранного предмета\n\n{ff9000}Внимание! Если предмет имеет количество -\nвы указываете его стоимость за единицу","Принять","Отмена");
			}
			return 1;
		}
		
		// Инвентарь Первая Часть
		if(Backpack[playerid] == 0) // Открыт инвентарь
		{
			for(new inva = 0; inva < 20; inva++)
			{
				if(playertextid == PlaNestPick[inva][playerid])
				{
					if(Page[playerid] == 0) player_tile(playerid, inva);
					else if(Page[playerid] == 1) player_tile(playerid, inva+20);
					else if(Page[playerid] == 2) player_tile(playerid, inva+40);
					else if(Page[playerid] == 3) player_tile(playerid, inva+60);
				}
			}
		}
		else // Открыт рюкзак (Сюда кладём такой же цикл как наверху, но для рюкзака свой аналог player_tile()
		{
			for(new inva = 0; inva < 20; inva++)
			{
				if(playertextid == PlaNestPick[inva][playerid])
				{
					if(Page[playerid] == 0) player_tile_backpack(playerid, inva);
					else if(Page[playerid] == 1) player_tile_backpack(playerid, inva+20);
					else if(Page[playerid] == 2) player_tile_backpack(playerid, inva+40);
					else if(Page[playerid] == 3) player_tile_backpack(playerid, inva+60);
				}
			}
		}

		// Инвентарь Вторая Часть
		for(new inva = 20; inva < 40; inva++)
		{
			if(playertextid == PlaNestPick[inva][playerid])
			{
				if(Pagetwo[playerid] == 0) tile_second(playerid, inva);
				else if(Pagetwo[playerid] == 1) tile_second(playerid, inva+20);
				else if(Pagetwo[playerid] == 2) tile_second(playerid, inva+40);
				else if(Pagetwo[playerid] == 3) tile_second(playerid, inva+60);
			}
		}
		
		// Переключатели страниц инвентаря
		if(Backpack[playerid] == 0) // Рюкзак закрыт
		{
			if(playertextid == PlaNestTabs[0][playerid]) return i_page(playerid, 0);
			if(playertextid == PlaNestTabs[1][playerid]) return i_page(playerid, 1);
		}
		else
		{
			if(playertextid == PlaNestTabs[0][playerid]) return i_page(playerid, 0);
			if(playertextid == PlaNestTabs[1][playerid]) return i_page(playerid, 1);
			if(playertextid == PlaNestTabs[12][playerid]) return i_page(playerid, 2);
			if(playertextid == PlaNestTabs[13][playerid]) return i_page(playerid, 3);
		}
		
		// Переключатели Второй Страницы (Дома и Бизнесы)
		if((Tabs_Load[playerid] == 2 || Tabs_Load[playerid] == 9) && OnlineInfo[playerid][oShowTabs] != 9999)
		{
			if(playertextid == PlaNestTabs[8][playerid]) return i_pagetwo(playerid, 0);
			if(playertextid == PlaNestTabs[9][playerid]) return i_pagetwo(playerid, 1);
			if(playertextid == PlaNestTabs[10][playerid]) return i_pagetwo(playerid, 2);
			if(playertextid == PlaNestTabs[11][playerid]) return i_pagetwo(playerid, 3);
		}

		if(playertextid == PlaNestTabs[2][playerid]) // Мои Товары Открыть
		{
			if(OnlineInfo[playerid][oShowInterface] == 1)
			{
			    if(PlayerInfo[playerid][pShop] == 0 && Goods[playerid] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас открыть товары\n{cccccc}Купите или арендуйте торговую лавку"), i_resetveshi(playerid), i_resettabs(playerid);
				PlayerPlaySound(playerid,17803,0,0,0);
				if(OnlineInfo[playerid][oInventSelectRight] != 9999) i_resettabs(playerid);
				if(Tabs_Load[playerid] == 6)
				{	
					closetab(playerid, 0);
					UpdateInventTwoBlock(playerid, 0, 0);
					return 1;
				}
				if(Tabs_Load[playerid] > 0) closetab(playerid, 0);
				Tabs_Load[playerid] = 6, showmygoods(playerid);

				UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
			}
			return 1;
		}
		if(playertextid == PlaNestTabs[3][playerid]) // Рядом Открыть (Выброшенные)
		{
			if(OnlineInfo[playerid][oShowInterface] == 1)
			{
				PlayerPlaySound(playerid,17803,0,0,0);
				if(OnlineInfo[playerid][oInventSelectRight] != 9999) i_resettabs(playerid);
				if(Tabs_Load[playerid] == 7)
				{
					closetab(playerid, 0);
					UpdateInventTwoBlock(playerid, 0, 0);
					return 1;
				}
				if(Tabs_Load[playerid] > 0) closetab(playerid, 0);
				Tabs_Load[playerid] = 7, showthrow(playerid);

				UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
			}
			return 1;
		}
		if(playertextid == PlaNestTabs[4][playerid]) // Лавка, Дом, Склад, Арендованный Склад, Багажник, Мусорка Открыть
		{
			if(OnlineInfo[playerid][oShowInterface] == 1)
			{
				PlayerPlaySound(playerid,17803,0,0,0);
				if(OnlineInfo[playerid][oInventSelectRight] != 9999) i_resettabs(playerid);
				if(Tabs_Load[playerid] > 0) 
				{
					if(Tabs_Load[playerid] != 6 && Tabs_Load[playerid] != 7) // Закрываем и останавливаем
					{
						closetab(playerid, 0);
						UpdateInventTwoBlock(playerid, 0, 0);
						return 1;
					}
					else closetab(playerid, 0); // Просто закрываем
				}

				if(Tabs_Type[playerid] != 2 && Tabs_Type[playerid] != 9) UpdateInventTwoBlock(playerid, Tabs_Type[playerid], 0);

				new resultOpen = 1;
				if(Tabs_Type[playerid] == 1) Tabs_Load[playerid] = 1, showgoods(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 2) Tabs_Load[playerid] = 2, showdom(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 3) Tabs_Load[playerid] = 3, showsklad(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 4) Tabs_Load[playerid] = 4, showrent(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 5) Tabs_Load[playerid] = 5, resultOpen = showboot(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 8) Tabs_Load[playerid] = 8, showtrash(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 9) Tabs_Load[playerid] = 9, showbiz(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 10) Tabs_Load[playerid] = 10, resultOpen = showbonet(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 12)
				{
					new world = GetPlayerVirtualWorld(playerid);
					if(world > 1000 && world <= 2000)
					{
						if(DomInfo[world-1000][dElectroConnect] == 0) return ErrorMessage(playerid, "{FF6347}Дом не подключен к электростанции.\n\n{ff9000}Пользоваться плитой без электричества нельзя!");
					}
					Tabs_Load[playerid] = Tabs_Type[playerid], showworkbehch(playerid, Tabs_ID[playerid]);
				}
				else if(Tabs_Type[playerid] == 11 || Tabs_Type[playerid] == 13 || Tabs_Type[playerid] == 17) // Верстак, Химический Стол, Станок
				{
					Tabs_Load[playerid] = Tabs_Type[playerid], showworkbehch(playerid, Tabs_ID[playerid]);
				}
				else if(Tabs_Type[playerid] == 14) Tabs_Load[playerid] = 14, showprisontable(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 15) Tabs_Load[playerid] = 15, showapartmentstable(playerid, Tabs_ID[playerid]);
				else if(Tabs_Type[playerid] == 16) Tabs_Load[playerid] = 16, showRefrigerator(playerid, Tabs_ID[playerid]);

				// Меню по какой-то причине закрылось, значит сворачиваем фон
				if(resultOpen == 0) UpdateInventTwoBlock(playerid, 0, 0);
			}
			return 1;
		}

		// Переложить из дома в багажник
		if(playertextid == PlaNestAct[0][playerid])
	    {
	        if(Tabs_Load[playerid] == 2 && OnlineInfo[playerid][oShowTabs] != 9999) // Из дома в багажник
			{
				if(OnlineInfo[playerid][oInventSelectRight] != 9999)
				{
					new dom = OnlineInfo[playerid][oShowTabs], inva = OnlineInfo[playerid][oInventSelectRight];
					if(DomInfo[dom][dInvent][inva] <= 0) return 1;
					new fpick = DomInfo[dom][dInvent][inva], thingType = DomInfo[dom][dInvType][inva], thingPack = DomInfo[dom][dInvPack][inva];
					if(DomInfo[dom][dIngar] == 0) return ErrorMessage(playerid, "{FF6347}В этом доме не установлен гараж");
					if(PlayerInfo[playerid][pDom] != dom)
					{
						if(DomInfo[dom][dAcccupG] == 0) return ErrorMessage(playerid, "{FF6347}Брать из шкафа этого дома может только владелец");
						if(DomInfo[dom][dAcccupG] == 1 && PlayerInfo[playerid][pHouserent] != dom) return ErrorMessage(playerid, "{FF6347}Брать из шкафа этого дома может только владелец и проживающие");
						if(DomInfo[dom][dAcccupG] == 2 && (DomInfo[dom][dFam] == 0 || DomInfo[dom][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[dom][dFam])) return ErrorMessage(playerid, "{FF6347}Брать из шкафа этого дома может только владелец и семья, которая здесь живёт");
						if(DomInfo[dom][dAcccupG] == 3 && (DomInfo[dom][dFam] == 0 || DomInfo[dom][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[dom][dFam]) && PlayerInfo[playerid][pHouserent] != dom) return ErrorMessage(playerid, "{FF6347}Брать из шкафа этого дома может только владелец, проживающие и семья, которая здесь живёт");
					}
					new kolcar = 0, vehicleid;
					for(new veh = 1; veh < MAX_CARS; veh++)
					{
						if(IsABoot(veh))
						{
							new Float:fDisveh = GetVehicleDistanceFromPoint(veh, DomInfo[dom][dGarageX], DomInfo[dom][dGarageY], DomInfo[dom][dGarageZ]);
					        if(fDisveh <= 10.0)
					        {
					        	kolcar ++;
								vehicleid = veh;
					        }
	       				}
					}
					if((VehInfo[vehicleid][vSost] == PlayerInfo[playerid][pID] || VehInfo[vehicleid][vKey] == PlayerInfo[playerid][pID] && VehInfo[vehicleid][vKeyUnix] > gettime()) && GetPlayerVip(playerid) > 0) {}
					else
					{
						if(VehInfo[vehicleid][vCarLock] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт заперт");
					}
					
					if(fpick == 25 && thingType == 0) return ErrorMessage(playerid, "{FF6347}В багажнике нельзя хранить деньги");
					if(kolcar <= 0) return ErrorMessage(playerid, "{FF6347}Возле гаража нет транспорта {cccccc}[ Возможно он сдвинулся далеко от гаража ]");

					new string[180];
					if(kolcar >= 2) return format(string,sizeof(string),"{FF6347}Возле гаража %d автомобилей\nСистема не понимает в какой транспорт перекладывать предметы",kolcar), ErrorMessage(playerid, string);
					
					DP[0][playerid] = vehicleid;
					DP[1][playerid] = inva;
					if(thingType == 0 && thingPack == 0)
					{
						if(CheckThingQuan(fpick) == 1)
						{
							format(string,sizeof(string),"{cccccc}Чтобы переложить из дома в багажник {ff9000}%s {cccccc}введите количество\n\nНе меньше 1 и не больше 1.000.000",GetNameThing(0, fpick, thingType, thingPack));
							ShowDialog(playerid,897,DIALOG_STYLE_INPUT,"{ff9000}Дом",string,"Принять","Отмена");
							return 1;
						}
					}
					put_boot_fromdom(playerid, dom, vehicleid, fpick, DomInfo[dom][dInv][inva], inva);
					return 1;
				}
				else ErrorMessage(playerid, "{FF6347}Выберите предмет в шкафу дома, чтобы переложить его в багажник");
			}
			if(Tabs_Load[playerid] == 9 && OnlineInfo[playerid][oShowTabs] != 9999) // Из бизнеса в багажник
			{
				if(OnlineInfo[playerid][oInventSelectRight] != 9999)
				{
					new b = OnlineInfo[playerid][oShowTabs], inva = OnlineInfo[playerid][oInventSelectRight];
					new fpick = BizzInfo[b][bInvent][inva];
					if(fpick <= 0) return 1;
					new kolcar = 0, vehicleid;
					for(new veh = 1; veh < MAX_CARS; veh++)
					{
						if(IsABoot(veh))
						{
							new Float:fDisveh = GetVehicleDistanceFromPoint(veh, BizzInfo[b][bX], BizzInfo[b][bY], BizzInfo[b][bZ]);
					        if(fDisveh <= 10.0)
					        {
					        	kolcar ++;
								vehicleid = veh;
					        }
	       				}
					}
					if(fpick == 25) return ErrorMessage(playerid, "{FF6347}В багажнике нельзя хранить деньги");
					if(kolcar <= 0) return ErrorMessage(playerid, "{FF6347}Возле гаража нет транспорта {cccccc}[ Возможно он сдвинулся далеко от гаража ]");
					if(kolcar >= 2)
					{
						new string[120];
						format(string,sizeof(string),"{FF6347}Возле гаража %d автомобилей\nСистема не понимает в какой транспорт перекладывать предметы",kolcar);
						ErrorMessage(playerid, string);
						return 1;
					}
					put_boot_frombiz(playerid, b, vehicleid, fpick, BizzInfo[b][bInv][inva], inva);
					return 1;
				}
				else ErrorMessage(playerid, "{FF6347}Выберите предмет на складе бизнеса, чтобы переложить его в багажник");
			}
			if(Tabs_Load[playerid] == 5 && OnlineInfo[playerid][oShowTabs] != 9999)
			{
				ShowDialog(playerid,899,DIALOG_STYLE_LIST,"{ff9000}Положить в Багажник","{cccccc}Ящик\n{cccccc}Человек","Выбрать","Отмена");
				PlayerPlaySound(playerid,17803,0,0,0);
			}
			return 1;
	    }

	    // Переложить из багажника в дом
		if(playertextid == PlaNestAct[1][playerid])
	 	{
	 	    if(OnlineInfo[playerid][oInventSelectRight] == 9999) return ErrorMessage(playerid, "{FF6347}Выберите предмет в багажнике, чтобы его переложить");
	 	    new v = OnlineInfo[playerid][oShowTabs], inva = OnlineInfo[playerid][oInventSelectRight];
			if(v == INVALID_VEHICLE_ID || v == 9999 || Tabs_Load[playerid] != 5) return 1;
			if(!IsABoot(v)) return 1;
			if((VehInfo[v][vSost] == PlayerInfo[playerid][pID] || VehInfo[v][vKey] == PlayerInfo[playerid][pID] && VehInfo[v][vKeyUnix] > gettime()) && GetPlayerVip(playerid) > 0) {}
			else
			{
				if(VehInfo[v][vCarLock] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт заперт");
			}
			if(VehInfo[v][vInvent][inva] <= 0) return 1;
			new fpick = VehInfo[v][vInvent][inva], thingType = VehInfo[v][vInvType][inva], thingPack = VehInfo[v][vInvPack][inva];
			new Float:Boot[3], Float:Bonnet[3];
	 		GetCoordBonnetVehicle(v, Bonnet[0], Bonnet[1], Bonnet[2]);
			GetCoordBootVehicle(v, Boot[0], Boot[1], Boot[2]);
			if(IsPlayerInRangeOfPoint(playerid, 1.0, Boot[0], Boot[1], Boot[2]) && !IsABootFront(v) || IsPlayerInRangeOfPoint(playerid, 1.0, Bonnet[0], Bonnet[1], Bonnet[2]) && IsABootFront(v))
			{
				if(OnlineInfo[playerid][oShowTabs] != 9999)
				{
				    new biz = -1;
	                for(new b = 0; b < sizeof(BizzInfo); b++)
					{
				        if(IsABizInteriorFrame(b))
					    {
					        if(IsPlayerInRangeOfPoint(playerid,10.0,BizzInfo[b][bX], BizzInfo[b][bY], BizzInfo[b][bZ]))
							{
							    biz = 0;
								if(GetAccessBizMay(playerid, b, 6)) biz = b;
							}
						}
					}
				    if(biz == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете переложить предмет на склад этого бизнеса");
				    if(biz > 0)
				    {
				        if(thingType == 0 && thingPack == 0)
						{
							if(CheckThingQuan(fpick) == 1) return ErrorMessage(playerid, "{FF6347}Этот предмет нельзя положить на склад бизнеса");
						}
				        put_biz_fromboot(playerid, v, biz, fpick, VehInfo[v][vInv][inva], inva);
				    }
				    else
				    {
					    new dom = 0;
						for(new d = 0; d < sizeof(DomInfo); d++)
						{
							if(IsPlayerInRangeOfPoint(playerid,10.0,DomInfo[d][dGarageX], DomInfo[d][dGarageY], DomInfo[d][dGarageZ]) && DomInfo[d][dIngar] >= 1 && d >= 1)
							{
								if(PlayerInfo[playerid][pDom] == d) dom = d;
								else if(PlayerInfo[playerid][pDom] != d)
								{
									if(DomInfo[d][dAcccupP] == 1 && PlayerInfo[playerid][pHouserent] == d) dom = d;
									if(DomInfo[d][dAcccupP] == 2 && (DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] == DomInfo[d][dFam])) dom = d;
									if(DomInfo[d][dAcccupP] == 3 && (DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] == DomInfo[d][dFam] || PlayerInfo[playerid][pHouserent] == d)) dom = d;
									if(DomInfo[d][dAcccupP] == 4) dom = d;
								}
							}
						}
						if(dom == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете переложить предмет в этот дом");
						if(thingType == 0 && thingPack == 0)
						{
							if(CheckThingQuan(fpick) == 1)
							{
								if(CheckDom(dom) && get_dom(dom, fpick) <= 0) return ErrorMessage(playerid, "{FF6347}В доме нет места");

								new string[140];
								format(string,sizeof(string),"{cccccc}Чтобы положить в дом № %d {ff9000}%s {cccccc}введите количество\n\nНе меньше 1 и не больше 1.000.000",dom,GetNameThing(1, fpick, thingType, thingPack));
								ShowDialog(playerid,898,DIALOG_STYLE_INPUT,"{ff9000}Багажник",string,"Принять","Отмена");
								return 1;
							}
						}
						put_dom_fromboot(playerid, v, dom, fpick, VehInfo[v][vInv][inva], inva);
					}
				}
			}
			return 1;
		}
		if(playertextid == PlaInter[1][playerid]) // Передать предмет через интерактивное окно
		{
			if(OnlineInfo[playerid][oInventSelectLeft] == 9999) return ErrorMessage(playerid, "{FF6347}Выберите предмет в инвентаре, чтобы передать его игроку");
            if(Moiplayer[playerid] == 9999) return 1;
			Veshi[playerid] = OnlineInfo[playerid][oInventSelectLeft];
			new giveplayerid = Moiplayer[playerid];
			PreviouslyGiveThingPlayer(playerid, giveplayerid, "");
		}
		if(playertextid == PlaInter[2][playerid]) // Продать предмет через интерактивное окно
		{
			if(OnlineInfo[playerid][oShowInterface] == 1 && OnlineInfo[playerid][oInventSelectLeft] != 9999)
			{
			    PreviouslySellThingPlayer(playerid, Moiplayer[playerid], "");
			}
		}
		return 1;
	}

	if(OnlineInfo[playerid][oShowInterface] == 18) // Меню выбора скина
	{
		// Изменить Ранг Скина
		if(playertextid == PlaDressDraw[2])
		{
			if(Fractia[playerid] >= 1 && Fractia[playerid] <= 22)
			{
				new g = fraction(playerid);
				if(Fractia[playerid] == g)
				{
					if(!GetAccessRankOrg(playerid, g, 22, NO_FBI)) return 1;
					ShowDialog(playerid,1070,DIALOG_STYLE_INPUT,"Настройки Одежды", "{cccccc}Введите ранг, с которого будет доступна {ff9000}эта одежда","Принять","Отмена");
				}
			}
			return 1;
		}
		
		// Изменить Стоимость Скина
		if(playertextid == PlaDressDraw[3])
		{
			if(Fractia[playerid] >= 1 && Fractia[playerid] <= 22)
			{
				new g = fraction(playerid);
				if(Fractia[playerid] == g)
				{
					if(!GetAccessRankOrg(playerid, g, 22, NO_FBI)) return 1;
					ShowDialog(playerid,1071,DIALOG_STYLE_INPUT,"Настройки Одежды", "{cccccc}Введите {99ff66}стоимость {cccccc}этой одежды","Принять","Отмена");
					PlayerPlaySound(playerid,17803,0,0,0);
				}
			}
			else if(Fractia[playerid] == 100)
			{
				new b = Bid[playerid], sel = GetPVarInt(playerid, "SelectCharPlace"), string[144];
				if(!GetAccessBiz(playerid, b, 2)) return 0;

				new skin = StoreItem[b-173][sel];
				if(skin == 0) return ErrorMessage(playerid, "{FF6347}В этом слоте нет одежды {cccccc}[ Возможно её кто-то купил ]");
				format(string,sizeof(string),"\n{cccccc}Введите {99ff66}стоимость {cccccc}этой одежды [ %d$ - %d$ ]\nГос. Цена Одежды: %d$", SkinGos[skin], SkinGos[skin]*2, SkinGos[skin]);
				ShowDialog(playerid,1079,DIALOG_STYLE_INPUT,"Прайс Бизнеса",string,"Принять","Отмена");
				PlayerPlaySound(playerid,17803,0,0,0);
			}
			else if(Fractia[playerid] == 400) return ErrorMessage(playerid, "{FF6347}В Gold меню нельзя настроить стоимость одежды");
			else if(Fractia[playerid] == 300)
			{
				new b = Bid[playerid], sel = GetPVarInt(playerid, "SelectCharPlace"), string[144];
				if(!GetAccessBiz(playerid, b, 2)) return 0;

				new aksea = AksesItem[b-173][sel];
				if(aksea == 0) return ErrorMessage(playerid, "{FF6347}В этом слоте нет аксессуара {cccccc}[ Возможно его кто-то купил ]");
				format(string,sizeof(string),"\n{cccccc}Введите {99ff66}стоимость {cccccc}%s ID %d [ 1$ - 50.000$ ]", GetNameAccessory(aksea), aksea);
				ShowDialog(playerid,1087,DIALOG_STYLE_INPUT,"Прайс Бизнеса",string,"Принять","Отмена");
				PlayerPlaySound(playerid,17803,0,0,0);
			}
			return 1;
		}
	}
 	
 	// Карта
 	if(OnlineInfo[playerid][oShowInterface] == 10)
	{
		// Информация Автобусной Остановки
		for(new sta = 1; sta < MAX_BUSSTATION; sta++)
		{
		    if(playertextid == StationBusDraw[sta][playerid]) info_bus_station(playerid, sta);
	 	}
	 	
	 	// Водитель Автобуса
		for(new i = 0; i < MAX_BUSDRIVER; i++)
		{
		    if(playertextid == BusBusDraw[i][playerid]) info_bus_driver(playerid, i);
	 	}
 	}
 	
	// Меню покупок
 	if(OnlineInfo[playerid][oShowInterface] == 12)
	{
	    // Выбрать продукт
	    for(new i = 0; i < 16; i++)
		{
		    if(playertextid == PlayerBuyDraw_Items[i][playerid])
			{
				if(SelectMenu[playerid][Cells][i] > 0) select_shop(playerid, i);
			}
	 	}
	 	
	 	// Удалить покупку
	 	for(new i = 0; i < 5; i ++)
    	{
	 		if(playertextid == PlayerBuyDraw_SelectFon[i][playerid])
	 		{
	 		    if(SelectMenu[playerid][Item][i] > 0) deselect_shop(playerid, i);
	 		}
 		}
 		
 		// Купить или забрать продукты
 		if(playertextid == PlayerBuyDraw[3][playerid])
 		{
 			if(SelectMenu[playerid][Time] > 0) return PlayerPlaySound(playerid,4203,0,0,0);
 			if(SelectMenu[playerid][Done] == 0) return order_shop(playerid);
		    if(SelectMenu[playerid][Done] == 1) return buy_shop(playerid);
		}
	}
	
	// Открытый Компьютер
 	if(OnlineInfo[playerid][oShowInterface] == 13)
	{
	    if(IsDialogOpened(playerid)) return 1;
	    if(playertextid == PlayerPcDraw[13][playerid]) // Банк Online
	    {
	        if(Komputer[playerid] == 2) pc_cmd_bonline(playerid), PlayerPlaySound(playerid,17803,0,0,0);
	    }
	    if(playertextid == PlayerPcDraw[15][playerid]) // Бизнес
	    {
	        if(Komputer[playerid] == 2) pc_cmd_mybiz(playerid), PlayerPlaySound(playerid,17803,0,0,0);
	    }
	    if(playertextid == PlayerPcDraw[17][playerid]) // База Данных | Серверная для взлома базы данных
	    {
			if(Komputer[playerid] >= 1) pc_cmd_mdc(playerid), PlayerPlaySound(playerid,17803,0,0,0);
	    }
	    if(playertextid == PlayerPcDraw[19][playerid]) // Система FBI | NGSA | Правительство | МЗ
	    {
	        if(Komputer[playerid] >= 1)
	        {
	            PlayerPlaySound(playerid,17803,0,0,0);
				if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1) return pc_cmd_overhear(playerid);
	        	if(PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pMember] == 3) return pc_cmd_boom(playerid);
	        	if(PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 && PlayerInfo[playerid][pRank] >= 10) return pc_cmd_goverment(playerid);
				if(PlayerInfo[playerid][pLeader] == 4 || PlayerInfo[playerid][pMember] == 4 && PlayerInfo[playerid][pRank] >= 1) return pc_cmd_mz(playerid);
   			}
	    }
	    if(playertextid == PlayerPcDraw[24][playerid]) // Gold Trade
	    {
	        if(Komputer[playerid] == 2) DP[6][playerid] = 1, TradeList(playerid, 0), PlayerPlaySound(playerid,17803,0,0,0);
	    }
		if(playertextid == PlayerPcDraw[21][playerid]) // Компьютер
	    {
	        if(Komputer[playerid] != 2) return ErrorMessage(playerid, "{FF6347}Настройки компьютера доступны только на личных ноутбуках");
	        pc_cmd_desktop(playerid);
	    }
	    if(playertextid == PlayerPcDraw[23][playerid]) // Положить на пол или на стол
	    {
	    	if(Komputer[playerid] == 2 && Hold[playerid] != 13) 
			{
				PlayerPlaySound(playerid,17803,0,0,0);
				ShowDialog(playerid,1253,DIALOG_STYLE_MSGBOX,"{ff9000}Положить","{ffcc66}Если вы нажмёте да, то не уберёте ноутбук, а разместите его в мире\
																				\n{ffcc66}Если вы хотите убрать ноутбук, {ff9000}просто нажмите ESC\
																				\n\n{cccccc}Вы уверены, что хотите положить ноутбук на пол или стол?","Да","Нет");
			}
		}
		if(playertextid == PlayerPcDraw[26][playerid]) // Игры
	    {
	        if(Komputer[playerid] != 2) return ErrorMessage(playerid, "{FF6347}Играть в игры можно только на своем личном ноутбуке");
			if(playerSeat[playerid] == false) return ErrorMessage(playerid, "{FF6347}Играть в игры можно только сидя за столом\n\n{ffcc66}Подойдите к столу и положите ноутбук на стол\n{ffcc66}Чтобы положить ноутбук, нажмите на стрелочку в нижнем правом углу");
	        
			if(server > 0) return ErrorMessage(playerid, "{FF6347}Игры временно недоступны [ Доступно только на тестовом сервере ]");
			ShowComputerClubMenu(playerid);
	    }
	}
	
	// Смартфон
	if(OnlineInfo[playerid][oShowInterface] == 2)
	{
	    PlayerPlaySound(playerid,17803,0,0,0), SetPVarInt(playerid,"Timez",0);
		if(playertextid == PlayerSmartDraw[4][playerid]) Times(playerid); // Время
  		if(playertextid == PlayerSmartDraw[29][playerid] || playertextid == PlayerSmartDraw[32][playerid]) pc_cmd_hangup(playerid); // Сбросить вызов
       	if(playertextid == PlayerSmartDraw[30][playerid]) pc_cmd_pickup(playerid); // Ответить на вызов
		if(playertextid == PlayerSmartDraw[40][playerid]) // Кнопка HOME
		{
			if(GetPVarInt(playerid, "Mobile") >= 2500
				&& GetPVarInt(playerid, "MobileStat") == 2) return ErrorMessage(playerid, "{FF6347}Вам нужно ответить на вызов\n{ffcc66}Нажмите на зелёную кнопку"), SelectColorDraw(playerid);
			CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
		}
  		if(playertextid == PlayerSmartDraw[5][playerid]) pc_cmd_phone(playerid); // Кнопка Телефон
    	if(playertextid == PlayerSmartDraw[7][playerid]) pc_cmd_contacts(playerid); // Кнопка КОНТАКТЫ
     	if(playertextid == PlayerSmartDraw[9][playerid]) pc_cmd_message(playerid); // Кнопка SMS
        if(playertextid == PlayerSmartDraw[11][playerid]) pc_cmd_car(playerid); // Кнопка ТРАНСПОРТ
        if(playertextid == PlayerSmartDraw[13][playerid]) pc_cmd_myhouse(playerid); // Кнопка ЖИЛЬЁ
        if(playertextid == PlayerSmartDraw[15][playerid]) pc_cmd_fam(playerid); // Кнопка СЕМЬЯ
        if(playertextid == PlayerSmartDraw[17][playerid]) pc_cmd_gps(playerid); // Кнопка GPS
        if(playertextid == PlayerSmartDraw[19][playerid]) // Кнопка ОРГАНИЗАЦИЯ
       	{
			if(fraction(playerid) > 0) pc_cmd_lmenu(playerid);
			else pc_cmd_invites(playerid);
       	}
        if(playertextid == PlayerSmartDraw[21][playerid]) pc_cmd_donate(playerid); // Кнопка DONATE
        if(playertextid == PlayerSmartDraw[23][playerid]) pc_cmd_report(playerid); // Кнопка Жалоба
        if(playertextid == PlayerSmartDraw[25][playerid]) pc_cmd_mypets(playerid); // Кнопка PETS
        if(playertextid == PlayerSmartDraw[27][playerid]) pc_cmd_mm(playerid); // Кнопка НАСТРОЙКИ
		if(playertextid == PlayerSmartDraw[42][playerid]) pc_cmd_quest(playerid); // Кнопка КВЕСТЫ
		if(playertextid == PlayerSmartDraw[44][playerid]) pc_cmd_radio(playerid); // Кнопка МУЗЫКА
		if(playertextid == PlayerSmartDraw[46][playerid]) pc_cmd_battlepass(playerid); // Кнопка BP
   	}
   	
   	// Слежка Администратор
   	if(PlayerInfo[playerid][pSoska] >= 1 && LoadSP[playerid] == true && gSpectateID[playerid] != INVALID_PLAYER_ID && noclipdata[playerid][cameramode] == CAMERA_MODE_NONE)
   	{
   	    if(playertextid == PlayerSpecDraw[29][playerid]) PlayerPlaySound(playerid,17803,0,0,0), pc_cmd_admin(playerid);
   	    if(playertextid == PlayerSpecDraw[14][playerid])
   	    {
   	        PlayerPlaySound(playerid,17803,0,0,0);
   	        if(PlayerInfo[playerid][pAspecBlock1] == false)
   	        {
   	        	PlayerInfo[playerid][pAspecBlock1] = true;
   	        	UpdateBlock1(playerid);
   	        	PlayerTextDrawHide(playerid, PlayerSpecDraw[10][playerid]);
   	        	PlayerTextDrawHide(playerid, PlayerSpecDraw[11][playerid]);
   	        	PlayerTextDrawHide(playerid, PlayerSpecDraw[13][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[4][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[14][playerid]);
       		}
       		else
	   		{
   	        	PlayerInfo[playerid][pAspecBlock1] = false;
   	        	UpdateBlock1(playerid);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[10][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[11][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[13][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[4][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[14][playerid]);
       		}
   	    }
   	    if(playertextid == PlayerSpecDraw[16][playerid])
   	    {
   	        PlayerPlaySound(playerid,17803,0,0,0);
   	        if(PlayerInfo[playerid][pAspecBlock2] == false)
   	        {
   	        	PlayerInfo[playerid][pAspecBlock2] = true;
   	        	UpdateBlock2(playerid);
   	        	PlayerTextDrawHide(playerid, PlayerSpecDraw[17][playerid]);
   	        	PlayerTextDrawHide(playerid, PlayerSpecDraw[18][playerid]);
   	        	PlayerTextDrawHide(playerid, PlayerSpecDraw[19][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[7][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[16][playerid]);
       		}
       		else
	   		{
   	        	PlayerInfo[playerid][pAspecBlock2] = false;
   	        	UpdateBlock2(playerid);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[17][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[18][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[19][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[7][playerid]);
   	        	PlayerTextDrawShow(playerid, PlayerSpecDraw[16][playerid]);
       		}
   	    }
   	}

	Aftextdraw[playerid] = current_tick;
    return 1;
}
stock buy_shop(playerid)
{
    PlayerPlaySound(playerid,40405,0,0,0);
    new quan, price, quaninvent, sel, quanhand;
    for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0)
		{
		    sel = SelectMenu[playerid][Item][i]-1;
			quan ++;
			if(SelectMenu[playerid][Cells][sel] == 121 || SelectMenu[playerid][Cells][sel] == 124 || SelectMenu[playerid][Cells][sel] == 120
			|| SelectMenu[playerid][Cells][sel] == 125 || SelectMenu[playerid][Cells][sel] == 127) quaninvent ++;
			price += SelectMenu[playerid][Price][sel];
			if(IsANaborsEdoi(SelectMenu[playerid][Cells][sel])) quanhand ++;
		}
	}
	if(quan == 0) return PlayerPlaySound(playerid,4203,0,0,0);
	if(quanhand > 0 && (Hand[playerid] >= 1 || Hold[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || OnlineInfo[playerid][oInHandThing][0] > 0)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет, действие или оружие]");
	if(!free_invent(playerid, quaninvent)) return ErrorMessage(playerid, "{FF6347}В инвентаре недостаточно свободных ячеек");
	if(SelectMenu[playerid][Payer] == 0 && SelectMenu[playerid][Shop] != 2)
	{
		if(oGetPlayerMoney(playerid) < price) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
		SelectMenu[playerid][Payer] = 1;
		oGivePlayerMoney(playerid, -price);
		if(SelectMenu[playerid][Shop] <= 2) PutMoneyToTreasury(price, "Покупка в магазине");
		else paybiz(SelectMenu[playerid][Shop], price);
	}
	
	new stopehand;
	for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0)
		{
			sel = SelectMenu[playerid][Item][i]-1;
			new fpick = SelectMenu[playerid][Cells][sel], fquan = 0;
			SetSatiety(fpick,fquan);
		    if(fpick == 121)
			{
				GiveThingPlayer(playerid, fpick, 0, 0, 0, 0, 0, 9999);
				SelectMenu[playerid][Item][i] = 0; // Кофе
			}
		    if(fpick == 124)
			{
				GiveThingPlayer(playerid, fpick, 0, 0, 0, 0, 0, 9999);
				SelectMenu[playerid][Item][i] = 0; // Sprunk Стакан
			}
		    if(fpick == 120)
			{
				GiveThingPlayer(playerid, fpick, 0, 0, 0, 0, 0, 9999);
				SelectMenu[playerid][Item][i] = 0; // Sprunk Банка
			}
		    if(fpick == 125)
			{
				GiveThingPlayer(playerid, 126, 0, 0, 0, 0, 0, 9999);
				SelectMenu[playerid][Item][i] = 0; // Бургер
			}
		    if(fpick == 127)
			{
				GiveThingPlayer(playerid, fpick, 0, 0, 0, 0, 0, 9999);
				SelectMenu[playerid][Item][i] = 0; // Ролл
			}
		    if(IsANaborsEdoi(fpick) && stopehand == 0)
		    {
		        in_hand_podnos(playerid, fpick, fquan, gettime()+172800, 0);
		        SelectMenu[playerid][Item][i] = 0;
		        stopehand = 1;
		    }

			// Снимаем продукты в бизнесе
			if(SelectMenu[playerid][Shop] > 2) takeWareBusiness(SelectMenu[playerid][Shop] , fpick);
		}
	}

	// Квест, заказали еду и взяли в руки
	if(stopehand > 0 && PlayerInfo[playerid][pQuest][8] == 1)
	{
		PlayerInfo[playerid][pQuest][8] = 2;
		QuestActorJoneHavka(playerid);
	}

	new itogquan;
	for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0) itogquan ++;
	}
	if(itogquan == 0) SelectMenu[playerid][Time] = 0, SelectMenu[playerid][Done] = 0, SelectMenu[playerid][Payer] = 0;
	closeshop(playerid), OnlineInfo[playerid][oShowInterface] = 0, CancelSelectTextDraw(playerid);
	/*if(PlayerInfo[playerid][pQwest] == 16)
	{
 		if(stopehand == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно поставить поднос с едой на стол {ff9000}[ Подойдите к столу в зале и нажмите F ]");
 		else if(stopehand == 0) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно заказать один из наборов");
	}*/
	return 1;
}

// Определяем набор с едой
stock IsANaborsEdoi(fpick)
{
	if(fpick >= 128 && fpick <= 138) return 1;
	return 0;
}

stock order_shop(playerid)
{
    PlayerPlaySound(playerid,40405,0,0,0);
    new quan, price, findHabor;
    for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0)
		{
			if(IsANaborsEdoi(SelectMenu[playerid][Cells][SelectMenu[playerid][Item][i]-1])) findHabor ++;
			quan ++;
			price += SelectMenu[playerid][Price][SelectMenu[playerid][Item][i]-1];
		}
	}
	if(quan == 0) return PlayerPlaySound(playerid,4203,0,0,0);

	// Мы берём хавку в тюрьме или столовке армейки, значит цена 0
	// if(SelectMenu[playerid][Shop] == 2) price = 0; // Нихуя, в столовке армейки и столовке тюрьмы еда будет платная по гос. стоимости, ибо нехуй

	// Квест знакомство с едой требует приобрести именно набор
	if(PlayerInfo[playerid][pQuest][8] == 1)
	{
		if(findHabor <= 0) return ErrorMessage(playerid, "{FF6347}Закажите любой из больших Наборов\
														\n{ffcc66}Квест покажет вам, как взаимодействовать с предметами");

		if(oGetPlayerMoney(playerid) < price) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег\
																			\n{ffcc66}Чтобы продолжить квест, вам придётся заработать денег [ Y >> GPS >> Работа ]");
	}
	else
	{
		if(oGetPlayerMoney(playerid) < price) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
	}

	new time;
	for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0)
		{
            time += preparation_fpick(SelectMenu[playerid][Cells][SelectMenu[playerid][Item][i]-1]);
		}
	}
	if(ADUTY[playerid] == 1) time = 0, SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Pears ]: {ffcc66}Админ дежурство позволяет получить товары без ожидания");
	if(time <= 0) time = 1;
	SelectMenu[playerid][Time] = time;
	PlayerTextDrawSetSelectable(playerid, PlayerBuyDraw[3][playerid], false);
	PlayerTextDrawShow(playerid, PlayerBuyDraw[3][playerid]);
	PlayerTextDrawShow(playerid, PlayerBuyDraw[4][playerid]);
	PlayerTextDrawShow(playerid, PlayerBuyDraw[6][playerid]);
	updatetimeshop(playerid);
	PlayerTextDrawHide(playerid, PlayerBuyDraw[2][playerid]);
	if(PlayerInfo[playerid][pQuest][8] == 1) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Теперь дождитесь приготовления вашего заказа\nВы можете закрыть меню и подождать в зале","*","");
	return 1;
}
stock preparation_fpick(fpick)
{
	new time;
	switch(fpick)
	{
	    case 121, 124: time = 4;
	    case 125, 127: time = 6;
	    case 128, 129, 130, 137, 138: time = 12;
	    case 131, 132, 133: time = 15;
	    case 134, 135, 136: time = 8;
	    default: time = 0;
	}
	return time;
}
stock deselect_shop(playerid, sel)
{
    PlayerPlaySound(playerid,6801,0,0,0);
    SelectMenu[playerid][Item][sel] = 0;
    PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectFon[sel][playerid]);
    PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectPick[sel][playerid]);
    PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectName[sel][playerid]);
    PlayerTextDrawHide(playerid, PlayerBuyDraw_SelectPrice[sel][playerid]);
    new quan;
    for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0) quan ++;
	}
	if(quan == 0)
	{
		SelectMenu[playerid][Time] = 0, SelectMenu[playerid][Done] = 0;
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlayerBuyDraw[2][playerid], "KYЊ…Џ’");
		else PlayerTextDrawSetString(playerid, PlayerBuyDraw[2][playerid], "BUY");
		PlayerTextDrawShow(playerid, PlayerBuyDraw[2][playerid]), PlayerTextDrawSetSelectable(playerid, PlayerBuyDraw[3][playerid], true), PlayerTextDrawShow(playerid, PlayerBuyDraw[3][playerid]);
		PlayerTextDrawHide(playerid, PlayerBuyDraw[4][playerid]), PlayerTextDrawHide(playerid, PlayerBuyDraw[5][playerid]), PlayerTextDrawHide(playerid, PlayerBuyDraw[6][playerid]);
	}
	return 1;
}
stock checkHaveWareBusiness(b, thingId) // Проверка на наличие ингредиентов при готовке
{
	new ingId[6], ingQuan[6], slot, noProduct;
	menuEatIngredient(thingId, ingId[0], ingId[1], ingId[2], ingId[3], ingId[4], ingId[5], ingQuan[0], ingQuan[1], ingQuan[2], ingQuan[3], ingQuan[4], ingQuan[5]);

	for(new i = 0; i < 6; i++)
	{
		if(ingId[i] > 0)
		{
			slot = getSlotIngredientBusiness(ingId[i]);
			if(BizzInfo[b][bItem][slot] - ingQuan[i] < 0) 
			{
				noProduct = 1;
				break;
			}
		}
	}
	if(noProduct) return 1;
	return 0;
}
stock select_shop(playerid, sel)
{
    if(SelectMenu[playerid][Time] > 0) return ErrorMessage(playerid, "{FF6347}Дождитесь приготовления, прежде чем сделать новый заказ");
    if(SelectMenu[playerid][Done] == 1) return ErrorMessage(playerid, "{FF6347}Заберите приготовленные позиции, прежде чем сделать новый заказ");
    PlayerPlaySound(playerid,17803,0,0,0);

	// Если мы в закусочной с бизнесом, проверяем наличие ингредиентов
	if(SelectMenu[playerid][Shop] > 2) 
	{
		if(checkHaveWareBusiness(SelectMenu[playerid][Shop], SelectMenu[playerid][Cells][sel])) return ErrorMessage(playerid, "{FF6347}Блин блинский... Извините, но в этой закусочной закончились\nингредиенты для приготовления вашего блюда");
	}

	new quan;
    for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] > 0) quan ++;
	}
	if(quan >= 5) return PlayerPlaySound(playerid,4203,0,0,0);
	for(new i = 0; i < 5; i ++)
    {
		if(SelectMenu[playerid][Item][i] == 0)
		{
		    SelectMenu[playerid][Item][i] = sel+1;
		    show_select_item(playerid, i);
		    break;
		}
	}
	return 1;
}
stock show_select_item(playerid, i)
{
    new fpick = SelectMenu[playerid][Cells][SelectMenu[playerid][Item][i]-1], price = SelectMenu[playerid][Price][SelectMenu[playerid][Item][i]-1], string[24];
    PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectFon[i][playerid]);
    PlayerTextDrawSetPreviewModel(playerid, PlayerBuyDraw_SelectPick[i][playerid], friskPick[fpick]);
    
    new Float:modelPos[4], findModel;
	GetModelTextDraw(friskPick[fpick], 0,0, modelPos[0], modelPos[1], modelPos[2], modelPos[3], findModel);
    
	PlayerTextDrawSetPreviewRot(playerid, PlayerBuyDraw_SelectPick[i][playerid], modelPos[0], modelPos[1], modelPos[2], modelPos[3]);
    PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectPick[i][playerid]);
    
    if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), "%s", fdrawName[fpick]);
    else format(string, sizeof(string), "%s", fdrawNameEN[fpick]);
	PlayerTextDrawSetString(playerid, PlayerBuyDraw_SelectName[i][playerid], string);
    PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectName[i][playerid]);

	if(SelectMenu[playerid][Shop] != 2)
	{
		format(string, sizeof(string), "%d$", price), PlayerTextDrawSetString(playerid, PlayerBuyDraw_SelectPrice[i][playerid], string);
    	PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectPrice[i][playerid]);
	}
	return 1;
}
stock info_bus_driver(playerid, i)
{
	if(busdriverid[i] > 0)
	{
 		new bdid = busdriverid[i]-1, bdplayer;
 		if(IsOnline(bdid))
 		{
 		    if(driverid[bdid] > 0) bdplayer = driverid[bdid]-1;
 		    PlayerPlaySound(playerid,17803,0,0,0);
		    new stro[84],sctringo[588];
		    format(stro,sizeof(stro),"\n{ff9000}Автобус"), strcat(sctringo,stro);
		    if(GetPVarInt(bdid,"afksystem") <= 3) format(stro,sizeof(stro),"\n{cccccc}Водитель: %s",playername(bdid)), strcat(sctringo,stro);
		    else format(stro,sizeof(stro),"\n{cccccc}Водитель: %s [ Уснул %d сек. ]",playername(bdid), GetPVarInt(bdid,"afksystem")), strcat(sctringo,stro);
		    if(busdriverstat[bdplayer] == 1)
		    {
		        format(stro,sizeof(stro),"\n{cccccc}Статус: {99ff66}на маршруте"), strcat(sctringo,stro);
			    if(Protect_Veh[bdid] != 9999)
				{
		    		new v = Protect_Veh[bdid];
		    		format(stro,sizeof(stro),"\n{cccccc}Транспорт: %s",GetVehicleName(VehInfo[v][vModel])), strcat(sctringo,stro);
	 			}
			    format(stro,sizeof(stro),"\n{cccccc}Скорость: %.0f KM/H",WatchSpeed[bdid]), strcat(sctringo,stro);

			    format(stro,sizeof(stro),"\n\n{0088ff}Маршрут:"), strcat(sctringo,stro);
			    if(busrout[bdid] >= 0) format(stro,sizeof(stro),"\n{ff9000}%s",FullRout[busrout[bdid]][brNameRout]), strcat(sctringo,stro);
			}
			else if(busdriverstat[bdplayer] == 0) format(stro,sizeof(stro),"\n{cccccc}Статус: {FF6347}вышел из автобуса или не выполняет маршрут"), strcat(sctringo,stro);
		    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Автобус",sctringo,"Ок","");
		}
	}
	return 1;
}
stock info_bus_station(playerid, sta)
{
    PlayerPlaySound(playerid,17803,0,0,0);
	new stro[84],sctringo[3360];
    format(stro,sizeof(stro),"\n{ff9000}Автобусная Остановка {0088ff}№ %d",sta+1), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}%s",BusStationInfo[sta][bsName]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n\n{0088ff}Маршруты с этой остановкой:"), strcat(sctringo,stro);

	new quan[MAX_ROUT];
	for(new i; i < MAX_ROUT; i++)
	{
		if(BusStationInfo[sta][bsRouts][i] == 0) continue;
		if(quan[BusStationInfo[sta][bsRouts][i]-1] == 0) format(stro,sizeof(stro),"\n{cccccc}%s | Водителей: %d",FullRout[BusStationInfo[sta][bsRouts][i]-1][brNameRout],busdrivers[BusStationInfo[sta][bsRouts][i]-1]), strcat(sctringo,stro);
		quan[BusStationInfo[sta][bsRouts][i]-1] ++;
	}
    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Автобусная Остановка",sctringo,"Ок","");
	return 1;
}
public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
	if(CallPublic(playerid, 4)) return false;

	if(OnlineInfo[playerid][oLogged] == 0)
	{
		if(clickedid == Text:INVALID_TEXT_DRAW)
		{
			if(gZaregal[playerid] == 1)
			{
				ShowDialog(playerid,1183,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Вы уверены, что хотите отменить создание персонажа и выйти из игры?","Да","Нет");
				return 1;
			}
			if(Login[4][playerid] == 1) return SelectColorDraw(playerid);
		}

		if(clickedid == DressDraw[3] || clickedid == DressDraw[5] || clickedid == DressDraw[7] || clickedid == DressDraw[10] || clickedid == DressDraw[12]
		|| clickedid == SpawnChoiseDraw[0] || clickedid == SpawnChoiseDraw[3] || clickedid == SpawnChoiseDraw[6] || clickedid == SpawnChoiseDraw[9]) { }
		else return 0;
	}
		   
	// Закрываем интерфейс с текстдравами на ESC
	if(clickedid == Text:INVALID_TEXT_DRAW)
	{
		if(gZaregal[playerid] == 1) return ShowDialog(playerid,1183,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Вы уверены, что хотите отменить создание персонажа и выйти из игры?","Да","Нет");
		if(DrawFrame[playerid] == true) return ExitFrame(playerid);

		if(!IsPlayerEditObject(playerid) && gAutosalon[playerid] > 0
			&& VehShopInfo[playerid][vsTest] == false) return SelectColorDraw(playerid);

		// Инвентарь
		if(OnlineInfo[playerid][oShowInterface] == 1) return CloseFrisk(playerid), CancelSelectTextDraw(playerid);

		// Смартфон
		else if(OnlineInfo[playerid][oShowInterface] == 2)
		{
			if(GetPVarInt(playerid, "Mobile") >= 2500 
				&& GetPVarInt(playerid, "MobileStat") == 2) return ErrorMessage(playerid, "{FF6347}Вам нужно ответить на вызов\n{ffcc66}Нажмите на зелёную кнопку"), SelectColorDraw(playerid);
			CloseSmartfon(playerid);
			if(DrawFrame[playerid] == false && !IsPlayerEditObject(playerid) && MenuInfo[playerid][zStat] == 0) CancelSelectTextDraw(playerid);
		}

		else if(OnlineInfo[playerid][oShowInterface] == 10) return CloseMapBus(playerid), PlayerPlaySound(playerid,5600,0,0,0);
		else if(OnlineInfo[playerid][oShowInterface] == 11) return close_hud_desk(playerid);
		else if(OnlineInfo[playerid][oShowInterface] == 12) return closeshop(playerid), OnlineInfo[playerid][oShowInterface] = 0, CancelSelectTextDraw(playerid);
		if(Komputer[playerid] > 0)
		{
			if(IsPlayerEditObject(playerid)) exitkomp(playerid, 2);
			else exitkomp(playerid, 0);
			return 1;
		}
		if(Fractia[playerid] >= 1 && Fractia[playerid] <= 100 || Fractia[playerid] == 300 || Fractia[playerid] == 400) return CloseShmot(playerid), ExitShmot(playerid);
		if(GetPVarInt(playerid,"kas") == 3 || GetPVarInt(playerid,"kas") == 4 || GetPVarInt(playerid,"kas") == 7) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Восстановить кликабельность мышки {00cc00}[ ПРОБЕЛ ]");
		if(OnlineInfo[playerid][oShowInterface] == 15 && typeDynamicTextDraw[playerid] == 1)
		{
			CloseEditModelMenu(playerid), CancelSelectTextDraw(playerid);
			if(DP[4][playerid] == 1995) AccessorySetting(playerid, DP[3][playerid]);
			return 1;
		}
		if(OnlineInfo[playerid][oShowInterface] == 16) return closeMenu_VehicleShop(playerid);
		if(OnlineInfo[playerid][oShowInterface] == 17) return CloseSpawnChoise(playerid), CancelSelectTextDraw(playerid);

		// Редактор Текстур (Закрываем отображение слотов текстур)
		if(MenuInfo[playerid][zStat] == 1) return CloseDraw3DMenu(playerid);
	}

	// Выбор спавна
	if(OnlineInfo[playerid][oShowInterface] == 17) return ClickDraw_SpawnChoise(playerid, clickedid);

	if(clickedid == BusDraw[4]) // Help Автобусная Остановка
	{
		if(OnlineInfo[playerid][oShowInterface] == 10)
		{
			PlayerPlaySound(playerid,17803,0,0,0);
			new stro[84],sctringo[924];
			format(stro,sizeof(stro),"{ff9000}Обозначения на карте:"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n\n{FF6347}Красная метка {cccccc}- вы"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{ffcc00}Жёлтые метки {cccccc}- автобусные остановки"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{0066ff}Синий автомобиль {cccccc}- автобусы на дежурстве"), strcat(sctringo,stro);

			format(stro,sizeof(stro),"\n\n{ff9000}Когда прибудет автобус?"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}- Нажмите на автобусную остановку, на которой вы стоите"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}- Таким образом вы сможете увидеть все автобусы на маршруте"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}- Если автобусов на маршруте нет, значит вам придётся найти другой способ"), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}добраться до нужного места на карте..."), strcat(sctringo,stro);
			ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Автобусная Остановка",sctringo,"Ок","");
			return 1;
		}
	}

	// Автосервис
	if(OnlineInfo[playerid][oShowInterface] == 20)
	{
		if(ClickTextDraw_Autoservice(playerid, clickedid)) return 1;

		if(clickedid == TuningDraw[2])
		{
			new tun;
			for(new i; i < sizeof(friskDetailTypeName); i++)
			{
				if(TempDetail[playerid][i] > 0)
				{
					tun++;
					break;
				}
			}
			if(tun > 0) return ExitTuningOrSave(playerid);
			else if(GetPVarInt(playerid,"tunstat") == 0) return ExitTuning(playerid);
		}
		if(clickedid == TuningDraw[3]) // Обслуживание
		{
			if(GetPVarInt(playerid,"tunstat") == 0)
			{
				new vid = OnlineInfo[playerid][oAutoserviceVeh];
				new model = VehInfo[vid][vModel];
				new Float:health;
         		GetVehicleHealth(vid, health);
				new quanRem;
				if(health < MaxVehicleHealth(model, vid)) quanRem ++;
				if(VehInfo[vid][vPanels] == 0 || VehInfo[vid][vDoors] == 0
					|| VehInfo[vid][vFara] == 0 || VehInfo[vid][vTires] == 0) quanRem ++;
				if(IsABig(model)) FlyCameraPos(playerid,-1126.360839, 2872.423583, 921.058837,  -1126.964599, 2877.103515, 919.405761  ,900, 800);
				else if(IsAMoto(model)) FlyCameraPos(playerid,-1133.228515, 2869.713378, 918.452941,  -1137.843627, 2867.819824, 918.113342  ,900, 800);
				else FlyCameraPos(playerid,-1133.449584, 2873.514404, 919.182678,  -1138.001831, 2874.953613, 917.697631  ,900, 800);
				PlayerPlaySound(playerid,40405,0,0,0);
				if(IsACar(model))
				{
					GetVehicleParamsEx(vid, engine, lights, alarm, doors, bonnet, boot, objective);
					SetVehicleParamsEx(vid, engine, lights, alarm, doors, true, boot, objective);
					VehInfo[vid][vBonnet] = 1;
				}
				new line[100],lines[1600];
				format(line,sizeof(line),"{ff9000}Полный Ремонт\t{99ff66}%d$ / %d$",BizzInfo[gAutosalon[playerid]][bPrice][0]*quanRem,BizzInfo[gAutosalon[playerid]][bPrice][0]*2), strcat(lines,line);
				format(line,sizeof(line),"\n{ff9000}Ремонт Двигателя\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][0]), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Сигнализация 1 ур.\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][7]), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Сигнализация 2 ур.\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][8]), strcat(lines,line);
				format(line,sizeof(line),"\n{cccccc}Обновление ПО Сигнализации\t{ffffff}Бесплатно"), strcat(lines,line);
				format(line,sizeof(line),"\n{ff9000}Перенос характеристик\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][9]), strcat(lines,line);
				format(line,sizeof(line),"\n{ff9000}Протестировать характеристики переноса\t"), strcat(lines,line);
				format(line,sizeof(line),"\n{ff9000}Бронеплёнка 1000\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][29]), strcat(lines,line);
				format(line,sizeof(line),"\n{ff9000}Бронеплёнка 2000\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][30]), strcat(lines,line);
				format(line,sizeof(line),"\n{ff9000}Бронеплёнка 3000\t{99ff66}%d$",BizzInfo[gAutosalon[playerid]][bPrice][31]), strcat(lines,line);
				ShowDialog(playerid,562,DIALOG_STYLE_TABLIST,"{ff9000}Обслуживание",lines,"Выбор","Отмена");
			}
		}
		if(clickedid == TuningDraw[4]) // Стайлинг
		{
			if(GetPVarInt(playerid,"tunstat") == 0)
			{
				PlayerPlaySound(playerid,40405,0,0,0);
				ShowDialog(playerid,714,DIALOG_STYLE_LIST,"{ff9000}Стайлинг","{ff9000}Цвет \n{ff9000}Покрасочная Работа \n{ff9000}Диски\n{ff9000}Стандартные Обвесы\n{ff9000}Высота подвески","Выбор","Отмена");
			}
		}
		if(clickedid == TuningDraw[5]) // Тюнинг
		{
			if(GetPVarInt(playerid,"tunstat") == 0)
			{
				PlayerPlaySound(playerid,40405,0,0,0);
				ShowDialog(playerid,729,DIALOG_STYLE_LIST,"{ff9000}Тюнинг","{ff9000}Гидравлика \n{ff9000}Азот \n{ff9000}Снять Гидравлику\n{ff9000}Снять Азот\n{ff9000}Улучшения Характеристик","Выбор","Отмена");
			}
		}
		if(clickedid == TuningDraw[1]) // Диагностика
		{
			if(GetPVarInt(playerid,"tunstat") == 0)
			{
				DiagnosVehicle(playerid, OnlineInfo[playerid][oAutoserviceVeh], 1);
			}
		}
		if(clickedid == TuningDraw[13]) // SAVE
		{
			if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192)
			{
				new b = gAutosalon[playerid];
				if(oGetPlayerMoney(playerid) < GetPVarInt(playerid,"Laveska")) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
				new veh = OnlineInfo[playerid][oAutoserviceVeh];
				if(OnlineInfo[playerid][oAutoserviceVeh] != veh) return ErrorMessage(playerid, "{FF6347}Ошибка! Это не тот транспорт, на котором вы заехали в автосервис");
				if(GetPVarInt(playerid,"tunstat") == 1)
				{
					if(BizzInfo[b][bItem][1] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет автомобильной краски в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][1] -= 1;
					ChangeVehicleColours(veh, GetPVarInt(playerid,"tunone"), GetPVarInt(playerid,"tuntwo"));
					VehInfo[veh][vVehcol1] = GetPVarInt(playerid,"tunone");
					VehInfo[veh][vVehcol2] = GetPVarInt(playerid,"tuntwo");
					CloseTuning(playerid);
					SetPVarInt(playerid,"tunstat",0);
				}
				else if(GetPVarInt(playerid,"tunstat") == 2)
				{
					if(BizzInfo[b][bItem][1] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет автомобильной краски в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][1] -= 1;
					ChangeVehicleColours(veh, 1, 1);
					ChangeVehiclePaintjob(veh, GetPVarInt(playerid,"tunone"));
					VehInfo[veh][vComp1]=GetPVarInt(playerid,"tunone");
					VehInfo[veh][vVehcol1] = 1;
					VehInfo[veh][vVehcol2] = 1;
					CloseTuning(playerid);
					SetPVarInt(playerid,"tunstat",0);
				}
				else if(GetPVarInt(playerid,"tunstat") == 4) // Сохраняем диски
				{
					if(BizzInfo[b][bItem][2] < 4)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет дисков в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][2] -= 4;
					AddVehicleComponent(veh, GetPVarInt(playerid,"tunone"));
					VehInfo[veh][vComp4] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,3);
				}
				else if(GetPVarInt(playerid,"tunstat") == 5) // Удаляем диски
				{
					VehInfo[veh][vComp4] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,3);
				}
				else if(GetPVarInt(playerid,"tunstat") == 6) // Сохраняем Передний Бампер
				{
					if(BizzInfo[b][bItem][5] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет деталей тюнинга в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][5] -= 1;
					VehInfo[veh][vComp5] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 7) // Сохраняем Задний Бампер
				{
					if(BizzInfo[b][bItem][5] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет деталей тюнинга в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][5] -= 1;
					VehInfo[veh][vComp6] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 8) // Сохраняем Крышу
				{
					if(BizzInfo[b][bItem][5] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет деталей тюнинга в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][5] -= 1;
					VehInfo[veh][vComp11] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 9) // Сохраняем Спойлер
				{
					if(BizzInfo[b][bItem][5] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет деталей тюнинга в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][5] -= 1;
					VehInfo[veh][vComp9] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 10) // Отключаем Пороги
				{
					if(Cars[veh] == 88 || Cars[veh] == 99)
					{
						VehInfo[veh][vComp7]=GetPVarInt(playerid,"tunone");
						VehInfo[veh][vComp8]=GetPVarInt(playerid,"tuntwo");
					}
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 11) // Сохраняем Глушитель
				{
					if(BizzInfo[b][bItem][5] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет деталей тюнинга в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][5] -= 1;
					VehInfo[veh][vComp10] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				// Сохраняем снятый Тюнинг
				else if(GetPVarInt(playerid,"tunstat") == 12)
				{
					VehInfo[veh][vComp5] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 13)
				{
					VehInfo[veh][vComp6] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 14)
				{
					VehInfo[veh][vComp11] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 15)
				{
					VehInfo[veh][vComp9] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 16)
				{
					VehInfo[veh][vComp7] = 0, VehInfo[veh][vComp8] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 17)
				{
					VehInfo[veh][vComp10] = 0;
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 18) // Сохраняем гидравлику
				{
					if(BizzInfo[b][bItem][3] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет гидравлики в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][3] -= 1;
					VehInfo[veh][vComp3] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 19) // Сохраняем Азот
				{
					if(BizzInfo[b][bItem][4] < 1)  return ErrorMessage(playerid, "{FF6347}В этом автосервисе нет азота в наличии");
					if(BizzInfo[b][bSost] > 0) BizzInfo[b][bItem][4] -= 1;
					VehInfo[veh][vComp2] = GetPVarInt(playerid,"tunone");
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 20) // Снимаем Гидравлику
				{
					VehInfo[veh][vComp3] = 0;
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 21) // Снимаем Азот
				{
					VehInfo[veh][vComp2] = 0;
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				PlayerPlaySound(playerid,6401,0,0,0);
				oGivePlayerMoney(playerid, -GetPVarInt(playerid,"Laveska"));
				BizzInfo[b][bUpdate] = 1;
				paybiz(b,GetPVarInt(playerid,"Laveska"));
				PlayerTextDrawHide(playerid, PlaTuningDraw);
				SetPVarInt(playerid,"Laveska",0);SetPVarInt(playerid,"tunone",0);
				SetPVarInt(playerid,"tuntwo",0);
				TextDrawHideForPlayer(playerid, TuningDraw[12]);
				TextDrawHideForPlayer(playerid, TuningDraw[13]);
				TextDrawHideForPlayer(playerid, TuningDraw[14]);
				TextDrawHideForPlayer(playerid, TuningDraw[15]);
				TextDrawHideForPlayer(playerid, TuningDraw[16]);

				new string[50];
				format(string,sizeof(string),"Дефолт тюнинг в бизе № %d", b);
				MoneyLog("buy", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -GetPVarInt(playerid,"Laveska"), string);
			}
		}
		if(clickedid == TuningDraw[14]) // CANCEL
		{
			if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192)
			{
				new veh = OnlineInfo[playerid][oAutoserviceVeh];
				if(GetPVarInt(playerid,"tunstat") == 1)
				{
					ChangeVehicleColours(veh, VehInfo[veh][vVehcol1], VehInfo[veh][vVehcol2]);
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 2)
				{
					ChangeVehiclePaintjob(veh, 3);
					if(VehInfo[veh][vComp1] != 999)ChangeVehiclePaintjob(veh, VehInfo[veh][vComp1]);
					ChangeVehicleColours(veh, VehInfo[veh][vVehcol1], VehInfo[veh][vVehcol2]);
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 4)
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					if(VehInfo[veh][vComp4] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp4]);
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,3);
				}
				else if(GetPVarInt(playerid,"tunstat") == 5)
				{
					if(VehInfo[veh][vComp4] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp4]);
					SetPVarInt(playerid,"tunstat",3);
					statun(playerid,3);
				}
				else if(GetPVarInt(playerid,"tunstat") == 6) // Отключаем Передний Бампер
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					if(VehInfo[veh][vComp5] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp5]);
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 7) // Отключаем Задний Бампер
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					if(VehInfo[veh][vComp6] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp6]);
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 8) // Отключаем Крышу
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					if(VehInfo[veh][vComp11] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp11]);
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 9) // Отключаем Спойлер
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					if(VehInfo[veh][vComp9] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp9]);
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 10) // Отключаем Пороги
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tuntwo"));
					if(VehInfo[veh][vComp7] != 0)AddVehicleComponent(veh, VehInfo[veh][vComp7]);
					if(VehInfo[veh][vComp8] != 0)AddVehicleComponent(veh, VehInfo[veh][vComp8]);
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 11) // Отключаем Глушитель
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					if(VehInfo[veh][vComp10] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp10]);
					SetPVarInt(playerid,"tunstat",0);
					statun(playerid,0);
					CloseTuning(playerid);
				}
				// Возвращаем снятый Тюнинг
				else if(GetPVarInt(playerid,"tunstat") >= 12 && GetPVarInt(playerid,"tunstat") <= 17)
				{
					AddVehicleComponent(veh, GetPVarInt(playerid,"tunone"));statun(playerid,4);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 18 || GetPVarInt(playerid,"tunstat") == 19) // Отключаем Гидравлику / Азот
				{
					RemoveVehicleComponent(veh,GetPVarInt(playerid,"tunone"));
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 20) // Возвращаем Гидравлику
				{
					if(VehInfo[veh][vComp3] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp3]);
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				else if(GetPVarInt(playerid,"tunstat") == 21) // Возвращаем Азот
				{
					if(VehInfo[veh][vComp2] != 0) AddVehicleComponent(veh, VehInfo[veh][vComp2]);
					SetPVarInt(playerid,"tunstat",0);
					CloseTuning(playerid);
				}
				PlayerPlaySound(playerid,1055,0,0,0);
				PlayerTextDrawHide(playerid, PlaTuningDraw);
				SetPVarInt(playerid,"Laveska",0);SetPVarInt(playerid,"tunone",0);
				SetPVarInt(playerid,"tuntwo",0);
				TextDrawHideForPlayer(playerid, TuningDraw[12]);
				TextDrawHideForPlayer(playerid, TuningDraw[13]);
				TextDrawHideForPlayer(playerid, TuningDraw[14]);
				TextDrawHideForPlayer(playerid, TuningDraw[15]);
				TextDrawHideForPlayer(playerid, TuningDraw[16]);
			}
		}
		return 1;
	}
	if(clickedid == DressDraw[10]) // Male
	{
		if(Fractia[playerid] == 200)
		{
			if(PlayerInfo[playerid][pSex] != 1)
			{
				new current_tick = GetTickCount();
				new interval = GetTickDiff(current_tick, a_flood[2][playerid]);
				a_flood[2][playerid] = current_tick;
				if(interval < 300) return GameTextForPlayer(playerid, "~r~Stop Flood", 1500, 4);
				PlayerInfo[playerid][pSex] = 1;
				show_skin(playerid, 200, 0, 0);
				PlayerPlaySound(playerid,17803,0,0,0);
			}
		}
	}
	if(clickedid == DressDraw[12]) // Female
	{
		if(Fractia[playerid] == 200)
		{
			if(PlayerInfo[playerid][pSex] != 2)
			{
				new current_tick = GetTickCount();
				new interval = GetTickDiff(current_tick, a_flood[2][playerid]);
				a_flood[2][playerid] = current_tick;
				if(interval < 300) return GameTextForPlayer(playerid, "~r~Stop Flood", 1500, 4);
				PlayerInfo[playerid][pSex] = 2;
				show_skin(playerid, 200, 0, 0);
				PlayerPlaySound(playerid,17803,0,0,0);
			}
		}
	}
	if(clickedid == DressDraw[14]) // Список всех скинов в магазине
	{
		if(Fractia[playerid] == 100)
		{
			new str[45],sctring[2250], b = Bid[playerid]-173;
			PlayerPlaySound(playerid,17803,0,0,0);
			format(str,sizeof(str),"Одежда ID\tЦена\tВ наличии"), strcat(sctring,str);
			for(new s = 0; s < 50; s++)
			{
				if(StoreItem[b][s] > 0) format(str,sizeof(str),"\n%d. %d\t{99ff66}%d$\t%d",s+1,StoreItem[b][s],StorePrice[b][s],StoreQuan[b][s]), strcat(sctring,str);
				else format(str,sizeof(str),"\n%d. {444444}None\t \t ",s+1), strcat(sctring,str);
			}
			ShowDialog(playerid,1080,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Магазин Одежды",sctring,"Выбрать","Выход");
		}
		else if(Fractia[playerid] == 300)
		{
			new str[80],sctring[4096], b = Bid[playerid]-173;
			PlayerPlaySound(playerid,17803,0,0,0);
			format(str,sizeof(str),"Аксессуар\tЦена\tВ наличии"), strcat(sctring,str);
			for(new s = 0; s < 100; s++)
			{
				if(AksesItem[b][s] > 0) format(str,sizeof(str),"\n%d. %s\t{99ff66}%d$\t%d",s+1,GetNameAccessory(AksesItem[b][s]),AksesPrice[b][s],AksesQuan[b][s]), strcat(sctring,str);
				else format(str,sizeof(str),"\n%d. {444444}None\t \t ",s+1), strcat(sctring,str);
			}
			ShowDialog(playerid,1083,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Магазин Одежды",sctring,"Выбрать","Выход");
		}
	}
           
	if(clickedid == DressDraw[7]) // Выбор скина или завершение регистрации
	{
		if(Fractia[playerid] >= 1 && Fractia[playerid] <= 200 || Fractia[playerid] == 400) return buy_skin(playerid);
		else if(Fractia[playerid] == 300) return buy_akses(playerid);
	}

	if(Fractia[playerid] >= 1) ClickTextDraw_ClothesShop(playerid, Text:clickedid);
	return 1;
}

stock GetVehiclePosRent(vehicleid)
{
	if(IsOnline(VehInfo[vehicleid][vAgetid]))
	{
	    new playerid = VehInfo[vehicleid][vAgetid], sl = VehInfo[vehicleid][vRentSlot];
		SaveRentVehiclePos(playerid, vehicleid, sl);
		if(sl == 0) mysql_save(playerid, 46);
		else if(sl == 1) mysql_save(playerid, 65);
	}
	return 1;
}

stock ACDestroyVehicle(vehicleid)
{
	if(vehicleid != INVALID_VEHICLE_ID && vehicleid != 9999)
	{
		if(Cars[vehicleid] == 5 || Cars[vehicleid] == 6 || Cars[vehicleid] == 10 || Cars[vehicleid] == 12 || Cars[vehicleid] == 13 || Cars[vehicleid] == 14
		|| Cars[vehicleid] == 15 || Cars[vehicleid] == 16 || Cars[vehicleid] == 18) car_org[Cars[vehicleid]][VehInfo[vehicleid][vTypeaget]] ++;

		// Открепляем прикреплённый транспорт
		if(VehInfo[vehicleid][vTug] >= 1)
		{
			if(VehInfo[vehicleid][vTug] != INVALID_VEHICLE_ID) DetachTrailerFromVehicle(VehInfo[vehicleid][vTug]), VehInfo[VehInfo[vehicleid][vTug]][vTug] = 0, VehInfo[vehicleid][vTug] = 0;
		}
		
		// Сбрасываем Мусорку
		if(VehInfo[vehicleid][vJob] == 8) reset_trash(trash_player[VehInfo[vehicleid][vJobID]], VehInfo[vehicleid][vJobID], 1), VehInfo[vehicleid][vJob] = 0;

		// Выкидываем челов из багажника
		if(VehInfo[vehicleid][vPeople] > 0) EjectBoot(VehInfo[vehicleid][vPeople] - 1, vehicleid);

		foreach (Player, i)
		{
			if(OnlineInfo[i][oLogged] == 0) continue;
		
			if(OnlineInfo[i][oShowInterface] == 1 && OnlineInfo[i][oShowTabs] == vehicleid && (Tabs_Load[i] == 5 || Tabs_Load[i] == 10)) closetab(i, 1);

			// Выгружаем транспорт владельцу
			if(VehInfo[vehicleid][vDatabase] > 0)
			{
				if(PlayerInfo[i][pMyVehID][VehInfo[vehicleid][vDatabase] - 1] == vehicleid) PlayerInfo[i][pMyVehID][VehInfo[vehicleid][vDatabase] - 1] = 0;
			}

			// Выгружаем транспорт с ключам
			if(vehicleid == PlayerInfo[i][pKeyVehID]) PlayerInfo[i][pKeyVehID] = 0;
		}

		if(VehInfo[vehicleid][vObjstat] >= 1) DestroyDynamicObject(VehInfo[vehicleid][vObject]), VehInfo[vehicleid][vObjstat] = 0;
		if(VehInfo[vehicleid][vRopeStat][0] > 0) DestroyDynamicObject(VehInfo[vehicleid][vRopeObj][0]), VehInfo[vehicleid][vRopeStat][0] = 0, VehInfo[vehicleid][vRope] = 0;
  		if(VehInfo[vehicleid][vRopeStat][1] > 0) DestroyDynamicObject(VehInfo[vehicleid][vRopeObj][1]), VehInfo[vehicleid][vRopeStat][1] = 0;
		if(VehInfo[vehicleid][v3dstat] >= 1) DestroyDynamic3DTextLabel(VehLabel[vehicleid]);
    	
		if(VehInfo[vehicleid][vBiz] > 0) BizzInfo[VehInfo[vehicleid][vBiz]][bUseItem][VehInfo[vehicleid][vBizItem]] --;

		if(VehInfo[vehicleid][vSellcar] > 0) 
		{
			DestroyDynamicObject(SellCarObj[0][vehicleid]);
			DestroyDynamicObject(SellCarObj[1][vehicleid]);
			DestroyDynamicObject(SellCarObj[2][vehicleid]);
			VehInfo[vehicleid][vSellcar] = 0;
			if(IsOnline(VehInfo[vehicleid][vIdvlad])) SellVeh[VehInfo[vehicleid][vIdvlad]] = 0;
		}

		if(VehInfo[vehicleid][vTrailerID] > 0) UnloadAttachedTrailer(VehInfo[vehicleid][vTrailerID] - 1);

		Cars[vehicleid] = 0;
		VehInfo[vehicleid][vBiz] = 0;
		VehInfo[vehicleid][vBizItem] = 0;
		VehInfo[vehicleid][vStat] = 0;
		VehInfo[vehicleid][vSost] = 0;
		VehInfo[vehicleid][vModel] = 0;
		VehInfo[vehicleid][vKoordinatX] = 0.0;
		VehInfo[vehicleid][vKoordinatY] = 0.0;
		VehInfo[vehicleid][vKoordinatZ] = 0.0;
		VehInfo[vehicleid][vKoordinatA] = 0.0;
		VehInfo[vehicleid][vVehcol1] = 0;
		VehInfo[vehicleid][vVehcol2] = 0;
		VehInfo[vehicleid][vComp1] = 999;
		VehInfo[vehicleid][vComp2] = 0;
		VehInfo[vehicleid][vComp3] = 0;
		VehInfo[vehicleid][vComp4] = 0;
		VehInfo[vehicleid][vComp5] = 0;
		VehInfo[vehicleid][vComp6] = 0;
		VehInfo[vehicleid][vComp7] = 0;
		VehInfo[vehicleid][vComp8] = 0;
		VehInfo[vehicleid][vComp9] = 0;
		VehInfo[vehicleid][vComp10] = 0;
		VehInfo[vehicleid][vComp11] = 0;
		VehInfo[vehicleid][vGod] = 0;
		VehInfo[vehicleid][vGas] = 0;
		VehInfo[vehicleid][vGelium] = 0;

		VehInfo[vehicleid][vVodila] = 9999;
		VehInfo[vehicleid][vPassajir] = 9999;
		VehInfo[vehicleid][v3dstat] = 0;
		VehInfo[vehicleid][vEngine] = 0;
		VehInfo[vehicleid][vLights] = 0;
		VehInfo[vehicleid][vAlarm] = 0;
		VehInfo[vehicleid][vBonnet] = 0;
		VehInfo[vehicleid][vBoot] = 0;
		VehInfo[vehicleid][vCarLock] = 0;
		VehInfo[vehicleid][vObject] = 0;
		VehInfo[vehicleid][vNospawn] = 0;
		VehInfo[vehicleid][vIdvlad] = 9999;
		VehInfo[vehicleid][vArest] = 0;
		VehInfo[vehicleid][vTug] = 0;
		VehInfo[vehicleid][vFine] = 0;
		VehInfo[vehicleid][vFineLien] = 0;
		VehInfo[vehicleid][vFineTime] = 0;
		VehInfo[vehicleid][vAgetid] = 9999;
		VehInfo[vehicleid][vKey] = 0;
		VehInfo[vehicleid][vEnhancedBoot] = false;
		VehInfo[vehicleid][vDatabase] = 0;
		VehInfo[vehicleid][vRent] = 0;
		VehInfo[vehicleid][vRentSlot] = 0;
		VehInfo[vehicleid][vSeat] = 0;
		VehInfo[vehicleid][vJob] = 0;
		VehInfo[vehicleid][vJobStat] = 0;
		VehInfo[vehicleid][vJobID] = 0;
		VehInfo[vehicleid][vProcess] = 0;
		VehInfo[vehicleid][vNosell] = 0;
		VehInfo[vehicleid][vNewid] = 0;
		VehInfo[vehicleid][vPeople] = 0;
		VehInfo[vehicleid][vBreaking] = 0;
		VehInfo[vehicleid][vOrderBizz] = 0;
		VehInfo[vehicleid][vTimerSpawn] = 0;
		VehInfo[vehicleid][vRepairFix] = false;
		VehInfo[vehicleid][vHealthFix] = 0;
		VehInfo[vehicleid][vDeath] = false;
		VehInfo[vehicleid][vExplosion] = false;
		VehInfo[vehicleid][vCallParking] = 0;
		VehInfo[vehicleid][vCallTimer] = 0;
		VehInfo[vehicleid][vCallPlayerid] = 0;
		VehInfo[vehicleid][vPanels] = 0;
		VehInfo[vehicleid][vDoors] = 0;
		VehInfo[vehicleid][vFara] = 0;
		VehInfo[vehicleid][vTires] = 0;
		VehInfo[vehicleid][vTheft] = 0;
		VehInfo[vehicleid][vOnVehicle] = 0;
		VehInfo[vehicleid][vAlarmSystem] = 0;
		VehInfo[vehicleid][vAlarmUnix] = 0;
		VehInfo[vehicleid][vTrailerID] = 0;
		VehInfo[vehicleid][vAlarmSound] = 0;
		VehInfo[vehicleid][vBreakingStatus] = 0;
		VehInfo[vehicleid][vTestDrive] = 0;
		VehInfo[vehicleid][vArmor] = 0.0;
		VehInfo[vehicleid][vTunningBPANTemp] = 0.0;
		VehInfo[vehicleid][vTunningBPAN] = 0.0;
		VehInfo[vehicleid][vAttachTrailer] = 0;
		VehInfo[vehicleid][vSklad] = 0;
		VehInfo[vehicleid][vSittingPassenger] = 0;
		VehInfo[vehicleid][vExitSeat] = 0;

		for(new i = 0; i < 20; i++) ClearBootVehicle(vehicleid, i);

		// Очищаем тюнинг с транспорта
		ClearAllTunning(vehicleid);

		// Очищаем хендлинг
		VehInfo[vehicleid][vHandlingModel] = 0;
		VehInfo[vehicleid][vHandlingModelTemp] = 0;
		ResetVehicleHandling(vehicleid);

		// Удаляем музло
		if (IsVehicleHavingMusicStream(vehicleid)) DestroyVehicleMusicStream(vehicleid);

		DestroyVehicle(vehicleid);
		QuantityVehicles --;
	}
	return 1;
}
stock FlyCameraPos(playerid,Float:xox,Float:xyx,Float:xzx,Float:rxox,Float:rxyx,Float:rxzx,speedMove,speedAngle)
{
	new Float:X, Float:Y, Float:Z, Float:rX, Float:rY, Float:rZ;
 	GetPlayerCameraPos(playerid, X, Y, Z);
  	GetPlayerCameraFrontVector(playerid, rX, rY, rZ);
	InterpolateCameraPos(playerid, X, Y, Z, xox, xyx, xzx, speedMove);
	InterpolateCameraLookAt(playerid, X+5.0*rX, Y+5.0*rY, Z+5.0*rZ, rxox, rxyx, rxzx, speedAngle);
    return 1;
}
stock SpecInfo(playerid, stat, dopid)
{
	foreach(Player,x)
	{
		if(noclipdata[x][cameramode] == CAMERA_MODE_NONE && (GetPlayerState(x) == PLAYER_STATE_SPECTATING || LoadSP[x] == true) && gSpectateID[x] == playerid)
		{
			switch(stat)
    		{
    		    case 0: // Игрок Заглушил или Завёл двигатель
    		    {
    		        if(LoadSP[x] == true) UpdateSpecEngine(x, playerid);
    		    }
    		    case 1: // Игрок Сменил Скин
    		    {
    		        if(LoadSP[x] == true) UpdateSpecSkin(x, playerid);
    		    }
				case 2: // Игрока Убили
				{
				    if(GetPlayerState(x) == PLAYER_STATE_SPECTATING)
				    {
						if(PlayerInfo[x][pSoska] >= 1) StartSpectate(x, dopid, 1);
						else StopSpectate(x), GameTextForPlayer(x,RusToGame("~r~Персонаж Умер"),3500,4);
					}
				}
				case 3: // Игрок сам Умер
				{
					if(GetPlayerState(x) == PLAYER_STATE_SPECTATING) StopSpectate(x), GameTextForPlayer(x,RusToGame("~r~Персонаж Умер"),3500,4);
				}
     		}
  		}
	}
	return 1;
}
stock TeleportCheat(playerid)
{
	if(IsPlayerInAnyVehicle(playerid)) // В транспорте
    {
    	new vehid = GetPlayerVehicleID(playerid);
    	if(protect[4] == 0 || protect[4] == 1)
    	{
    		if(Protect_Veh[playerid] != 9999 && Protect_Veh[playerid] != vehid)
    		{
    			new string[144];
				if(protect[4] == 0)
				{
					printf("[SProtect Kick]: Car Changer %s",PlayerInfo[playerid][pName]);
					format(string, sizeof(string), " [ PP ]: %s[%d] Car Changer {cccccc}[ KICK ]", PlayerInfo[playerid][pName], playerid);
					ABroadCast(COLOR_ADM,string,2);
					SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Car Changer]");
					ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Car Changer]","*","");
					Kickx(playerid);
					return 1;
				}
				else if(protect[4] == 1) format(string, sizeof(string), " [ PP ]: %s[%d] Car Changer", PlayerInfo[playerid][pName], playerid), ABroadCast(COLOR_ADM,string,2);
    		}
    	}
    	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    	{
    		new Float:spa[3],Float:health, model;
    		GetVehicleHealth(vehid, health);
			// Вычисление id авто + скорости
      		UpdatePlayersSpeed(playerid);
      		GetVehicleVelocity(vehid,spa[0],spa[1],spa[2]);
      		model = VehInfo[vehid][vModel];
      		//new Float:skorost2 = speda*(spa[0]*spa[0]+spa[1]*spa[1]);
      		new Float:skorost = floatsqroot(spa[0] * spa[0] + spa[1] * spa[1] + spa[2] * spa[2]) * speedCoefficient * 100.0;
      		// Лимитер
			{
				if(VehInfo[vehid][vEngine] == 1
					&& (PlayerInfo[playerid][pSLimit] >= 1 && skorost > PlayerInfo[playerid][pSLimit]
						|| VehInfo[vehid][vTrailerID] > 0 && skorost > 90))
				{
					if (spa[2] > -0.05) { // Машина не падает
						new Float:dif;
						if (VehInfo[vehid][vTrailerID] > 0) {
							new Float: trailerSpeed = 90.0;
							if (PlayerInfo[playerid][pSLimit] > 0 && trailerSpeed > PlayerInfo[playerid][pSLimit]) trailerSpeed = PlayerInfo[playerid][pSLimit];
							dif = trailerSpeed / skorost, skorost = trailerSpeed;
						} else {
							dif = PlayerInfo[playerid][pSLimit] / skorost, skorost = PlayerInfo[playerid][pSLimit];
						}
						SetVehicleVelocity(vehid,spa[0]*dif,spa[1]*dif,spa[2]);
					}
				}
			}
			// Повреждённый Транспорт
			if(Cars[vehid] != 9999)
			{
				if(health <= 500)
				{
					if(IsAMoto(model) || IsACar(model))
					{
			        	if(skorost > 50)
						{
			        		new Float:dif = 50/skorost;
							SetVehicleVelocity(vehid,spa[0]*dif,spa[1]*dif,spa[2]);
							skorost = 50;
						}
					}
				}
			}
			
			WatchSpeed[playerid] = skorost;
      		// Подсчёт километража
			//PlayerInfo[playerid][pCarLic] += (10.0*(spa[0]*spa[0]+spa[1]*spa[1]))/1000;
			
	      	// Подсчёт километража в такси
      		if(VehInfo[vehid][vPassajir] != 9999){ VehInfo[vehid][vKilom] += (10.0*(spa[0]*spa[0]+spa[1]*spa[1]))/1000; }
      		// 3D Спидометр
      		if(UpdateSpeed[playerid]>=1 && PlayerInfo[playerid][pSped]==0)
	  		{
	      		new str[20];
	      		format(str,20,"%.0f KM/H",skorost);
	      		if(UpdateSpeed[playerid]==1)SetDynamicObjectMaterialText(SpdObj[playerid][0],0,str,OBJECT_MATERIAL_SIZE_256x128,"Arial",24,true,0xFFFFFFFF,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
	      		else if(UpdateSpeed[playerid]==2)SetDynamicObjectMaterialText(SpdObj[playerid][0],0,str,OBJECT_MATERIAL_SIZE_512x256,"Arial",64,true,0xFFFFFFFF,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
	  		}
	  		// Стандартный спидометр
	  		if(VehInfo[vehid][vEngine] == 1 && PlayerInfo[playerid][pDrawVisible][7] == false && Cars[vehid] != 52 && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8 && DrawSpeed[playerid] == true)
	  		{
	  			if(!IsAVello(vehid))
	  			{
	      			new stro[20];
  	      			format(stro, sizeof(stro), "%.0f",skorost);
          			PlayerTextDrawSetString(playerid, PlayerSpeedDraw[playerid][5], stro);
	      			PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][5]);
    			}
   			}
   			
   			// Езда без бенза наказуема
			new keys,ud,lr;
  			GetPlayerKeys(playerid,KEY:keys,ud,lr);
  			if(VehInfo[vehid][vGas] <= 0 && VehInfo[vehid][vGelium] <= 0)
			{
				if(skorost >= 60.0) SetVehicleVelocity(vehid,spa[0]/1.090, spa[1]/1.090, spa[2]);
				new vehmod = VehInfo[vehid][vModel];
				GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
				if(keys == 8 && skorost >= 30.0 && engine == false && (IsACar(vehmod) || IsAMoto(vehmod)))
				{
					AntiBenz[playerid] ++;
					if(AntiBenz[playerid] >= 120)
					{
						SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Code: 1018].");
      					ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}****  {FFFFFF}*[Protect Project]*  {ff0000}****","{ff0000}******** {ffffff}Вы были кикнуты по подозрению в читерстве [Code:1018] {ff0000}********","*","");
						Kickx(playerid);// кикаем
           				return 1;
					}
				}
			}
			//===
    	}
	}
	if(PlayerInfo[playerid][pSoska] >= 1 && LoadSP[playerid] == true && gSpectateID[playerid] != INVALID_PLAYER_ID && noclipdata[playerid][cameramode] == CAMERA_MODE_NONE)
	{
		if(IsOnline(gSpectateID[playerid]))
		{
			if(GetPlayerState(gSpectateID[playerid]) == PLAYER_STATE_DRIVER)
			{
				new string[14];
				format(string, sizeof(string), "%.0f", WatchSpeed[gSpectateID[playerid]]);
				PlayerTextDrawSetString(playerid, PlayerSpecDraw[26][playerid], string);
	    		PlayerTextDrawShow(playerid, PlayerSpecDraw[26][playerid]);
			}
		}
	}
    return 1;
}

public CreateWork(playerid,today,action)
{
	new her, f_str[256],string[184];
	cache_get_row_count(her);
	if(!her) // Если нету за сегодняшний день, создаём
	{
		new year, month,day;
 		getdate(year, month, day);
		if(PlayerInfo[playerid][pSoska] >= 1)
		{
			mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_work` SET `admin` = '%e', `today` = '%d', `date` = '%d-%d-%d'", PlayerInfo[playerid][pName],today,year,month,day);
			query_empty(pearsq, f_str);
			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_work` WHERE `admin` = '%e' AND `today` = '%d'", PlayerInfo[playerid][pName],today);
 			mysql_tquery(pearsq, string, "insert_work", "ddd", playerid,today,action);
		}
		else if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)
	    {
			mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_work` SET `admin2` = '%e', `today` = '%d', `date2` = '%d-%d-%d'", PlayerInfo[playerid][pName],today,year,month,day);
			query_empty(pearsq, f_str);
			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_work` WHERE `admin2` = '%e' AND `today` = '%d'", PlayerInfo[playerid][pName],today);
 			mysql_tquery(pearsq, string, "insert_work", "ddd", playerid,today,action);
		}
		return 1;
	}
	else
	{
		if(PlayerInfo[playerid][pSoska] >= 1)
		{
			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_work` WHERE `admin` = '%e' AND `today` = '%d'", PlayerInfo[playerid][pName],today);
 			mysql_tquery(pearsq, string, "insert_work", "ddd", playerid,today,action);
		}
		else if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)
	    {
	    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_work` WHERE `admin2` = '%e' AND `today` = '%d'", PlayerInfo[playerid][pName],today);
 			mysql_tquery(pearsq, string, "insert_work", "ddd", playerid,today,action);
 		}
	}
	return 1;
}
stock FindTrashUnload(playerid)
{
	new Float:dist, Float:findpos, kakoi;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, TrashUnloadPos[0][0], TrashUnloadPos[0][1], TrashUnloadPos[0][2]);
	for(new i = 0; i < sizeof(TrashUnloadPos); ++i)
	{
	    findpos = GetDistancePoint(x, y, z, TrashUnloadPos[i][0], TrashUnloadPos[i][1], TrashUnloadPos[i][2]);
	    if(findpos <= dist) dist = findpos, kakoi = i;
	}
	CreateGps(playerid, TrashUnloadPos[kakoi][0], TrashUnloadPos[kakoi][1], TrashUnloadPos[kakoi][2], 0, 0, 5.0);
	return 1;
}
stock FindFill(playerid)
{
	new Float:dist, Float:findpos, kakoi = 1, quan;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, FillPos[0][0], FillPos[0][1], FillPos[0][2]);
	for(new i = 0; i < sizeof(FillPos); ++i)
	{
	    if(BizzInfo[i+1][bItem][0] >= 20)
	    {
	        quan ++;
	    	findpos = GetDistancePoint(x, y, z, FillPos[i][0], FillPos[i][1], FillPos[i][2]);
	    	if(findpos <= dist) dist = findpos, kakoi = i;
		}
	}
	if(quan == 0)
	{
		ErrorMessage(playerid, "{FF6347}На всех заправках нет топлива {ff9000}[ Обратитесь к администрации /report ]");
		return 0;
	}

	new string[120];
	format(string,sizeof(string),"{ff9000}Ближайший Заправка: %s {99ff66}отмечен на карте\n{cccccc}Бизнес № %d", BizzInfo[kakoi + 1][bName], kakoi + 1);
	SuccessMessage(playerid, string);
	CreateGps(playerid, FillPos[kakoi][0], FillPos[kakoi][1], FillPos[kakoi][2], 0, 0, 10.0);
	return 1;
}

