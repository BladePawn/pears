stock FindScoot(playerid)
{
	new Float:dist, Float:findpos, biz = 16, kakoi, quan;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, RentPos_X[16][0], RentPos_Y[16][0], RentPos_Z[16][0]);
	for(new b = 16; b < 25; b++)
	{
		if(BizzInfo[b][bItem][0]-BizzInfo[b][bUseItem][0] <= 0) continue; // Если нет скутеров в наличии, не показываем этот терминал
	    for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
		    if(RentStat[b][i] == 1)
		    {
		        quan ++;
	    		findpos = GetDistancePoint(x, y, z, RentPos_X[b][i], RentPos_Y[b][i], RentPos_Z[b][i]);
	    		if(findpos <= dist) dist = findpos, kakoi = i, biz = b;
			}
		}
	}
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Все аренды скутеров закрыты или не имеют транспорта в наличии {ff9000}[ Обратитесь к администрации /report ]");

	new string[160];
	format(string,sizeof(string),"{ff9000}Ближайшая Аренда Скутеров: %s {99ff66}отмечена на карте\n{cccccc}Бизнес № %d | Терминал № %d", BizzInfo[biz+51][bName], biz+51, kakoi+1);
	SuccessMessage(playerid, string);
	CreateGps(playerid, RentPos_X[biz][kakoi], RentPos_Y[biz][kakoi], RentPos_Z[biz][kakoi], 0, 0, 5.0);
	return 1;
}
