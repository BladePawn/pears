stock relprodbiz(b, force)
{
	if(b >= 1 && b <= 12) LoadBusinessProduct(b, force); // Сбрасываем заправки
	else if(b >= 13 && b <= 26) LoadBusinessProduct(b, force); // Сбрасываем супермаркеты
	else if(b >= 27 && b <= 41) LoadBusinessProduct(b, force); // Оружейный Магазин
	else if(b >= 42 && b <= 52) LoadBusinessProduct(b, force); // Сбрасываем Аренду Автомобилей
