	|| IsPlayerInRangeOfPoint(playerid,9.0,1585.1774,-1677.7784,5.8979) || IsPlayerInRangeOfPoint(playerid,15.0,1570.9508,-1640.7448,28.4021)
	|| IsPlayerInRangeOfPoint(playerid,9.0,-1606.1071,732.9869,-5.2344) || IsPlayerInRangeOfPoint(playerid,15.0,-1631.6208,712.2404,49.0737)
	|| IsPlayerInRangeOfPoint(playerid,9.0,-131.4318,-148.0569,3.1172)
