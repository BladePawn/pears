alias:mm("mymenu", "menu", "меню", "mn")
CMD:mm(playerid)
{
    PlayerPlaySound(playerid,1150,0,0,0);
    new line[70],lines[1360];

    format(line,sizeof(line),"{ff9000}Промокод\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{ff9000}Рефералы\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{99ff66}Аккаунт\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Языки\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Анимации\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Настройки чата\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Сменить место спавна\t"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Настройки спидометра\t"), strcat(lines,line);
    if(PlayerInfo[playerid][pSim] == 0) format(line,sizeof(line),"\n{cccccc}Сим карта \t{99ff66}[ On ]"), strcat(lines,line);
    else if(PlayerInfo[playerid][pSim] == 1) format(line,sizeof(line),"\n{cccccc}Сим карта \t{FF6347}[ Off ]"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Настройки оформления\t"), strcat(lines,line);
	if(PlayerInfo[playerid][pCustomLabel] == 0) format(line,sizeof(line),"\n{cccccc}Лейблы кастомного транспорта \t{99ff66}[ On ]"), strcat(lines,line);
    else if(PlayerInfo[playerid][pCustomLabel] == 1) format(line,sizeof(line),"\n{cccccc}Лейблы кастомного транспорта \t{FF6347}[ Off ]"), strcat(lines,line);
	if(PlayerInfo[playerid][pNotCloseVeh] == false) format(line,sizeof(line),"\n{cccccc}Автоматически запирать транспорт \t{99ff66}[ On ]"), strcat(lines,line);
    else if(PlayerInfo[playerid][pNotCloseVeh] == true) format(line,sizeof(line),"\n{cccccc}Автоматически запирать транспорт \t{FF6347}[ Off ]"), strcat(lines,line);
	if(PlayerInfo[playerid][pJobHint]) format(line,sizeof(line),"\n{cccccc}Подсказки на работах \t{99ff66}[ On ]"), strcat(lines,line);
    else format(line,sizeof(line),"\n{cccccc}Подсказки на работах \t{FF6347}[ Off ]"), strcat(lines,line);
	if(PlayerInfo[playerid][pDamagInf]) format(line,sizeof(line),"\n{cccccc}Звуковое уведомление дамага \t{99ff66}[ On ]"), strcat(lines,line);
    else format(line,sizeof(line),"\n{cccccc}Звуковое уведомление дамага \t{FF6347}[ Off ]"), strcat(lines,line);
    format(line,sizeof(line),"\n{444444}Статистика >>\t [ /stats ]"), strcat(lines,line);
  	format(line,sizeof(line),"\n{444444}Навыки >>\t [ /skill ]"), strcat(lines,line);
  	format(line,sizeof(line),"\n{444444}Потребности >>\t [ /needs ]"), strcat(lines,line);
  	format(line,sizeof(line),"\n{444444}Достижения >>\t [ /achieve ]"), strcat(lines,line);
  	ShowDialog(playerid,243, DIALOG_STYLE_TABLIST,"{cccccc}Меню {ff9000}Игрока",lines,"Ок", "Отмена");
    return 1;
}

CMD:textdraw(playerid)
{
    if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
    PlayerPlaySound(playerid,1150,0,0,0);

    new line[60],lines[900];
   	format(line,sizeof(line),"{cccccc}Цвет Оформления: %s", styleName[PlayerInfo[playerid][pSty]]), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Фон Меню: %s", styleBackName[PlayerInfo[playerid][pStyBack]]), strcat(lines,line);
   	if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(line,sizeof(line),"\n{cccccc}Язык: {ff9000}RUS"), strcat(lines,line);
   	else format(line,sizeof(line),"\n{cccccc}Язык: {ff9000}EN"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Чекер битв"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Меню взаимодействия"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Название сервера"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Время"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Ноутбук"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Смартфон"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Инвентарь"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Спидометр"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Меню покупок"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Подсказка двигателя"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Датчик скафандра"), strcat(lines,line);
    format(line,sizeof(line),"\n{cccccc}Админский spec"), strcat(lines,line);
  	ShowDialog(playerid,1241,DIALOG_STYLE_LIST,"{ff9000}Настройки Оформления",lines,"Выбрать","Отмена");
    return 1;
}

// Меню управления всеми квестами
alias:quest("qwest", "qvest", "kvest", "kwest", "квест", "квесты")
CMD:quest(playerid)
{
    PlayerPlaySound(playerid,1150,0,0,0);
    new line[70],lines[350];

	if(PlayerInfo[playerid][pQwestMessageOff] == true) format(line,sizeof(line),"{cccccc}Звонки от квестовых персонажей {FF6347}[ Off ]\t \n"), strcat(lines,line);
	else format(line,sizeof(line),"{cccccc}Звонки от квестовых персонажей {99ff66}[ On ]\t \n"), strcat(lines,line);

    format(line,sizeof(line),"{ff9000}Начальные Квесты\t \n"), strcat(lines,line);
	if(DailyInfo[playerid][daiFull] == false) format(line,sizeof(line),"{ff9000}Ежедневные Задания \t{99ff66}[ Есть новые задания ]\n"), strcat(lines,line);
	else format(line,sizeof(line),"{ff9000}Ежедневные Задания \t{cccccc}[ Выполнены ]\n"), strcat(lines,line);

	if(NPCInfo[5][npcStart] == false) format(line,sizeof(line),"{0088ff}Доминик \t{99ff66}[ Свободен ]\n"), strcat(lines,line);
	else format(line,sizeof(line),"{0088ff}Доминик \t{FF6347}[ В гонке ]\n"), strcat(lines,line);

	if(VillageInfo[villActive] == true) format(line,sizeof(line),"{0088ff}Деревенские \t{FF6347}[ Битва активна ]\n"), strcat(lines,line);
	else format(line,sizeof(line),"{0088ff}Деревенские \t{99ff66}[ Пацаны на чиле ]\n"), strcat(lines,line);

	format(line,sizeof(line),"{0088ff}Маньяк\n"), strcat(lines,line);
	format(line,sizeof(line),"{0088ff}Заброшенная шахта\n"), strcat(lines,line);
	format(line,sizeof(line),"{0088ff}Дуэль на Катанах\n"), strcat(lines,line);

	// Сюда добавлять другие типы квестов:
	// - Квесты от Организации
	// - Еженедельные задания для Организации (Для всей фраки целиком - просто инфа)
  	ShowDialog(playerid,1233, DIALOG_STYLE_TABLIST,"{ff9000}Квесты",lines,"Ок", "Отмена");
    return 1;
}

stock ShowAchieve(playerid, targetid, page)
{
    new str[214],sctring[4096], list, minimum, listonpage = 70;
    DP[0][playerid] = targetid;

    if(page == 0) minimum = 0;
    else minimum = page * listonpage;

    format(str,sizeof(str),"ID Достижение \t Действие \t Получено Игроками"), strcat(sctring,str);
    for(new ach = minimum; ach < MAX_ACHIEVE; ach++)
    {
		List[list][playerid] = ach;
        if(PlayerInfo[targetid][pAchieve][ach] == 1) format(str,sizeof(str),"\n{ff9000}%d. %s \t %s \t %d", ach+1, achieveName[ach], achieveAction[ach], achieve_quan[ach]);
		else 
		{
			if(achieveType[ach] >= 3) format(str,sizeof(str),"\n{666666}%d. Секретное достижение \t  \t %d", ach+1, achieve_quan[ach]);
			else format(str,sizeof(str),"\n{cccccc}%d. %s \t %s \t %d", ach+1, achieveName[ach], achieveAction[ach], achieve_quan[ach]);
		}

		strcat(sctring,str);
		list ++;
        if(list >= listonpage) break;
    }
    if(list >= listonpage) format(str,sizeof(str),"\nДалее >> \t  \t "), strcat(sctring,str);
	format(str,sizeof(str),"{ff9000}Достижения %s (%d)",playername(targetid), PlayerInfo[targetid][pAchievequan]);
	ShowDialog(playerid,1185,DIALOG_STYLE_TABLIST_HEADERS,str,sctring,"Выбрать","Выход");
	return 1;
}
CMD:achieve(playerid)
{
	DP[1][playerid] = 0;
	ShowAchieve(playerid, playerid, 0);
	return 1;
}

alias:sa("showachieve")
CMD:sa(playerid, const params[])
{
	if(CnnVed[playerid] >= 11 || MPGO[playerid] != 0 || box[playerid] >= 1
	|| GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас показать свои достижения");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать достижения [ /showachieve ID или /sa ]");
    if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Игрока нет на сервере");
	if(!ProxDetectorS(2.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко");
	if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Зачем показывать навыки себе? [ /achieve или Y >> Меню >> Достижения ]");
 	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы слишком далеко");
 	DP[1][params[0]] = 0;
 	ShowAchieve(params[0], playerid, 0);
  	PlayerPlaySound(params[0],40405,0,0,0);

	new string[80];
    format(string, sizeof(string), "* %s демонстрирует свои достижения %s", playername(playerid), playername(params[0]));
    ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
    return 1;
}
