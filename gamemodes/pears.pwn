}*/
stock backbank(playerid)
{
	if(DP[1][playerid] == 0) pc_cmd_bonline(playerid);
 	else if(DP[1][playerid] == 1) pc_cmd_bank(playerid);
 	return 1;
}

DIALOG:continental_to_offshore(playerid, response, listitem, const inputtext[])
{
	if (!response) return backbank(playerid);

	if (!IsMafiaMember(playerid)) return ErrorText(playerid, "{FF6347}Доступно только участникам мафий"), pc_cmd_bank(playerid);
	if (!IsLeader(playerid)) return ErrorText(playerid, "{FF6347}Доступно только лидерам"), pc_cmd_bank(playerid);

	new amount;
	if (sscanf(inputtext, "d", amount)) return ShowAdvancedDialog(playerid, "continental_to_offshore");
	if (amount < 0 || amount > 100000) return ErrorText(playerid, "{FF6347}Количество монет от 1 до 100000"), ShowAdvancedDialog(playerid, "continental_to_offshore");

	new g = fraction(playerid);

	if (GetFractionContinentalCoins(g) < amount) return ErrorText(playerid, "{FF6347}У организации нет такого количества монет"), ShowAdvancedDialog(playerid, "continental_to_offshore");
	
	new offshore = amount * ContinentalCoinInfo[cciExchangeRate];
	OrganInfo[g][goffshore] += offshore;
	OrganInfo[g][gUpdate] = 1;
	TakeFractionContinentalCoins(g, amount);
	OrgLog(g, "giveoffshore", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", offshore, "Обменял монеты");

	FORMAT:message("{99ff66}Вы успешно обменяли %d монет на %d$", amount, offshore);
	SuccessMessage(playerid, message);

	return 1;
}

stock bank(playerid, stat)
{
	new g = fraction(playerid), string[354];
	if(stat == 0)
    {
    	PlayerPlaySound(playerid,40405,0,0,0);
		new stro[100],sctringo[2700], f = PlayerInfo[playerid][pFamily], b = PlayerInfo[playerid][pBusiness];
		// Личный Счёт
	 	format(stro,sizeof(stro),"{ff9000}Личный Счёт"), strcat(sctringo,stro);
	 	format(stro,sizeof(stro),"\n{cccccc}%s: {99ff66}%d$ [%s]",PlayerInfo[playerid][pName],PlayerInfo[playerid][pAccount], get_k(PlayerInfo[playerid][pAccount])), strcat(sctringo,stro);
	 	format(stro,sizeof(stro),"\n{cccccc}Юниты: {9900ff}%d",PlayerInfo[playerid][pUnit]), strcat(sctringo,stro);
		
		new workout_deposit = CourtGetWorkoutDeposit(playerid);
		if(workout_deposit > 0) {
			format(stro,sizeof(stro),"\n{cccccc}Долг по исправительным работам: {ff6347}%d$", workout_deposit), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{999999}- Вы можете покрыть долг, работая в Клининговой Компании"), strcat(sctringo,stro);
		}

		// Счёт Организации
		if(g >= 1)
		{
	 		if(OrganInfo[g][gCash] == 0) format(stro,sizeof(stro),"\n\n{ff9000}Счёт Организации {FF6347}[ Закрыт ]"), strcat(sctringo,stro);
	 		else format(stro,sizeof(stro),"\n\n{ff9000}Счёт Организации {99ff66}[ Открыт ]"), strcat(sctringo,stro);
			new glave_str[MAX_BIGINT_LEN];
			bigint_get_str(OrganInfo[g][glave], glave_str);
	 		format(stro,sizeof(stro),"\n%s{cccccc}: {99ff66}%s$ [%s]",frakName[g],glave_str, get_k(OrganInfo[g][glave])), strcat(sctringo,stro);
			if(IsAMafiaID(g)) format(stro,sizeof(stro),"\n{cccccc}Монеты Континенталь: {ff4500}%d [%s]", GetFractionContinentalCoins(g), get_k(GetFractionContinentalCoins(g))), strcat(sctringo, stro);
		}
		else
		{
			format(stro,sizeof(stro),"\n\n{ff9000}Счёт Организации"), strcat(sctringo,stro);
	 		format(stro,sizeof(stro),"\n{444444}нет"), strcat(sctringo,stro);
	 	}

	 	// Счёт Семьи
	 	format(stro,sizeof(stro),"\n\n{ff9000}Счёт Семьи"), strcat(sctringo,stro);
	 	if(f >= 1) format(stro,sizeof(stro),"\n{cccccc}[№ %d] %s{cccccc}: {99ff66}%d$ [%s]",f,FamilyInfo[f][fName],FamilyInfo[f][fMoney],get_k(FamilyInfo[f][fMoney])), strcat(sctringo,stro);
	 	else format(stro,sizeof(stro),"\n{444444}нет"), strcat(sctringo,stro);

	 	// Счёт Бизнеса
	 	format(stro,sizeof(stro),"\n\n{ff9000}Счёт Бизнеса"), strcat(sctringo,stro);
	 	if(b >= 1) format(stro,sizeof(stro),"\n{cccccc}[№ %d] %s{cccccc}: {99ff66}%d$ [%s]",b,bizname(b),BizzInfo[b][bSchet], get_k(BizzInfo[b][bSchet])), strcat(sctringo,stro);
	 	else format(stro,sizeof(stro),"\n{444444}нет"), strcat(sctringo,stro);

		// Штрафы
		format(stro,sizeof(stro),"\n\n{cccccc}Штрафы: {FF6347}%d$",PlayerInfo[playerid][pAmmos11]), strcat(sctringo,stro);

	 	// Информация
		format(stro,sizeof(stro),"\n\n{cccccc}Информация:"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{999999}- Положить деньги на личный счёт можно в банке или банкомате"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{999999}- 1 Юнит равняется 1$"), strcat(sctringo,stro);
		ShowDialog(playerid,1021,DIALOG_STYLE_MSGBOX,"{99ff66}Банк",sctringo,"*","");
	}
	else if(stat == 1)
    {
	    if(g == 0) return InfoUnit(playerid), PlayerPlaySound(playerid,4203,0,0,0);
	    if(Payment[playerid] > gettime() || OrganInfo[g][gCash] == 1)
		{
			new glave_str[MAX_BIGINT_LEN];
			bigint_get_str(OrganInfo[g][glave], glave_str);
			format(string,sizeof(string),"\n{cccccc}Введите количество {9900ff}юнитов{cccccc}, чтобы обменять их на {99ff66}$\n\n{cccccc}Юниты: {0088ff}%dU\n{cccccc}Счёт Организации: {99ff66}%s$ [%s]\n",PlayerInfo[playerid][pUnit],glave_str, get_k(OrganInfo[g][glave]));
			ShowDialog(playerid,1013,DIALOG_STYLE_INPUT,"{99ff66}Банк",string,"Принять","Отмена");
		}
		else SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Счёт организации закрыт"), PlayerPlaySound(playerid,4203,0,0,0), backbank(playerid);
	}
	else if(stat == 10)
	{
		if (!IsMafiaMember(playerid)) return ErrorText(playerid, "{FF6347}Доступно только участникам мафий"), pc_cmd_bank(playerid);
		if (!IsLeader(playerid)) return ErrorText(playerid, "{FF6347}Доступно только лидерам"), pc_cmd_bank(playerid);

		new dialog_text[512];
		format(dialog_text, sizeof(dialog_text), "\n{cccccc}Введите количество {ff4500}монет{cccccc}, чтобы перевести их на {99ff66}офшорный счёт\n\n{cccccc}Доступные монеты: {ff4500}%d\n", GetFractionContinentalCoins(g));
		format(dialog_text, sizeof(dialog_text), "%s{cccccc}Курс: {ff4500}1 монета {cccccc}= {99ff66}%d${cccccc}", dialog_text, ContinentalCoinInfo[cciExchangeRate]);
		strcat(dialog_text, "\n\nОфшорный счёт используется для оплаты некоторых из услуг нелегальных торговцев\n{ff6347}[!] {cccccc}Имейте ввиду, что эта операция необратима");
		ShowAdvancedDialog(playerid, "continental_to_offshore", DIALOG_STYLE_INPUT, "{99ff66}Банк", dialog_text, "Принять", "Назад");
	}
	else if(stat == 2) ShowDialog(playerid,1014,DIALOG_STYLE_INPUT,"{99ff66}Банк","\n{cccccc}Введите {ff9000}ID или Имя{cccccc}, чтобы перевести деньги на счёт\n","Принять","Отмена");
	else if(stat == 3)
	{
		new stro[49],sctringo[780];
		format(stro,sizeof(stro),"\nLSPD"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nFBI"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nНациональная Гвардия"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nПравительство"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nAll Saints General Hospital"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nCNN"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nПохоронное Бюро"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nОтель Ресторан Cosa Nosta"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nОтель Ресторан Yakuza"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nОтель Ресторан Triada"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nОтель Ресторан Russian Mafia"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nОтель Ресторан Arabian Mafia"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nБаксетбольный клуб Grove"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nБаксетбольный клуб Ballas"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nВолонтёрская орг. Vagos"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nВолонтёрская орг. Aztecas"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\nОбразовательный Центр {99ff66}(Выход из ЧС)"), strcat(sctringo,stro);
		ShowDialog(playerid,1016,DIALOG_STYLE_LIST,"{99ff66}Банк",sctringo,"Выбрать","Отмена");
	}
	else if(stat == 4) ShowDialog(playerid,1018,DIALOG_STYLE_INPUT,"{99ff66}Банк","\n{cccccc}Введите {ff9000}номер семьи{cccccc}, чтобы перевести деньги на счёт\n","Принять","Отмена");
	else if(stat == 5)
	{
		new glave_str[MAX_BIGINT_LEN];
		bigint_get_str(OrganInfo[g][glave], glave_str);

	    if(PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я не лидер"), PlayerPlaySound(playerid,4203,0,0,0), backbank(playerid);
		format(string, sizeof(string),"\n{cccccc}Введите {99ff66}количество денег{cccccc}, чтобы вывести их со счёта организации\n\nСчёт Организации: {99ff66}%s$ [%s]\n",glave_str, get_k(OrganInfo[g][glave]));
		ShowDialog(playerid,1020,DIALOG_STYLE_INPUT,"{99ff66}Банк",string,"Принять","Отмена");
	}
	else if(stat == 6) ShowDialog(playerid,289,DIALOG_STYLE_INPUT,"{99ff66}Банк","\n{cccccc}Введите {99ff66}количество денег{cccccc}, чтобы {99ff66}положить {cccccc}их на свой банковский счёт\n","Принять","Отмена");
	else if(stat == 7)
	{
		format(string, sizeof(string),"\n{cccccc}Введите {99ff66}количество денег{cccccc}, чтобы {FF6347}снять {cccccc}их со своего банковского счёта\n\nБанковский Счёт: {99ff66}%d$ [%s]\n",PlayerInfo[playerid][pAccount],get_k(PlayerInfo[playerid][pAccount]));
		ShowDialog(playerid,290,DIALOG_STYLE_INPUT,"{99ff66}Банк",string,"Принять","Отмена");
	}
	else if(stat == 8)
	{
	    if(PlayerInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: У меня нет семьи"), PlayerPlaySound(playerid,4203,0,0,0), backbank(playerid);
	    new f = PlayerInfo[playerid][pFamily];
	    if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccmonget]) return format(string,sizeof(string),"[ Мысли ]: Я не могу снимать деньги с банковского счёта семьи [ %d+ Ранг ]",FamilyInfo[f][fAccmonget]), SendClientMessage(playerid, COLOR_GREY, string), PlayerPlaySound(playerid,4203,0,0,0), backbank(playerid);
		format(string, sizeof(string),"\n{cccccc}Введите {99ff66}количество денег{cccccc}, чтобы вывести их со счёта семьи\n\nСчёт Семьи: {99ff66}%d$ [%s]\n",FamilyInfo[f][fMoney], get_k(FamilyInfo[f][fMoney]));
		ShowDialog(playerid,1041,DIALOG_STYLE_INPUT,"{99ff66}Банк",string,"Принять","Отмена");
	}
	else if(stat == 9)
	{
		new stro[124],sctringo[1240], b = PlayerInfo[playerid][pBusiness], f = PlayerInfo[playerid][pFamily], kol = 1;
		if(b > 0) format(stro,sizeof(stro),"{ff9000}[№ %d] %s\t\n", b, bizname(b)), strcat(sctringo,stro);
		else format(stro,sizeof(stro),"{444444}нет\t\n"), strcat(sctringo,stro);
		if(f > 0)
		{
			if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3051 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
			for(new fb = 0; fb < 10; fb++)
			{
				if(FamilyInfo[f][fBiz][fb] >= 1 && FamilyInfo[f][fBiz][fb] != b)
				{
					List[kol][playerid] = FamilyInfo[f][fBiz][fb];
					kol ++;
					format(stro,sizeof(stro),"{cccccc}[№ %d] %s\t{cccccc}%s\n",FamilyInfo[f][fBiz][fb],bizname(FamilyInfo[f][fBiz][fb]),BizzInfo[FamilyInfo[f][fBiz][fb]][bVlad]), strcat(sctringo,stro);
				}
			}
		}
		else format(stro,sizeof(stro),"{444444}нет семьи\t"), strcat(sctringo,stro);
		ShowDialog(playerid,1044,DIALOG_STYLE_TABLIST,"{99ff66}Банк",sctringo,"Выбрать","Отмена");
	}
	else if(stat == 11)
	{
		new stro[64],sctringo[256], d = PlayerInfo[playerid][pDom], b = PlayerInfo[playerid][pBusiness], realtax;
		if(d > 0) realtax += DomInfo[d][dTaxes];
		format(stro,sizeof(stro),"{cccccc}Налог на Транспорт\t{FF6347}[%d$]", PlayerInfo[playerid][pTaxes][0]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Налог на Недвижимость\t{FF6347}[%d$]", realtax), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Подоходный Налог\t{FF6347}[%d$]", PlayerInfo[playerid][pTaxes][1]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"\n{cccccc}Налог на Бизнес\t{FF6347}[%d$]", BizzInfo[b][bTaxes]), strcat(sctringo,stro);
		ShowDialog(playerid,1049,DIALOG_STYLE_TABLIST,"{99ff66}Банк",sctringo,"Выбрать","Отмена");
	}
    return 1;
}
stock agetavia2(playerid)
{
	new string[100];
	if(GetPVarInt(playerid,"antiflood") > 0) return format(string,sizeof(string),"[ Мысли ]: В гараже ещё нет свободного транспорта {ffcc00}[ Подождите %d сек. ]", GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY, string);
	if(GetPlayerVirtualWorld(playerid) != 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в другом виртуальном мире");
	if(Stun[4][playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы в наручниках");
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вам нужно выйти из транспорта");
	new g = fraction(playerid);
	if(IsPlayerInRangeOfPoint(playerid,3.0,1262.4432,-2027.3105,59.3501)) // Cosa Nostra
	{
		if(g != 5) return ErrorMessage(playerid, "{FF6347}Это транспорт Cosa Nostra");
	    format(string,sizeof(string),"{cccccc}Maverick \t{ff9000}[ %d ]\t{444444}%d+ Ранг\n", car_org[g][9],OrganInfo[g][gCarAcc][9]);
		ShowDialog(playerid,1023,DIALOG_STYLE_TABLIST,"{cccccc}Транспорт {cccc00}Cosa Nostra", string,"Выбрать","Выход");
	}
	else if(IsPlayerInRangeOfPoint(playerid,3.0,-1435.9430,998.7063,15.0056)) // Triada Mafia
	{
		if(g != 10) return ErrorMessage(playerid, "{FF6347}Это транспорт Triada Mafia");
	    format(string,sizeof(string),"{cccccc}Maverick \t{ff9000}[ %d ]\t{444444}%d+ Ранг\n", car_org[g][9],OrganInfo[g][gCarAcc][9]);
		ShowDialog(playerid,1023,DIALOG_STYLE_TABLIST,"{cccccc}Транспорт {003366}Triada Mafia", string,"Выбрать","Выход");
	}
	else if(IsPlayerInRangeOfPoint(playerid,3.0,-2061.2146,1110.3062,58.2007)) // Russian Mafia
	{
		if(g != 12) return ErrorMessage(playerid, "{FF6347}Это транспорт Russian Mafia");
	    format(string,sizeof(string),"{cccccc}Maverick \t{ff9000}[ %d ]\t{444444}%d+ Ранг\n", car_org[g][9],OrganInfo[g][gCarAcc][9]);
		ShowDialog(playerid,1023,DIALOG_STYLE_TABLIST,"{cccccc}Транспорт {444444}Russian Mafia", string,"Выбрать","Выход");
	}
	return 1;
}
stock agetcar2(playerid)
{
	new string[100];
	if(GetPVarInt(playerid,"antiflood") > 0) return format(string,sizeof(string),"[ Мысли ]: В гараже ещё нет свободного транспорта {ffcc00}[ Подождите %d сек. ]", GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY, string);
	if(Stun[4][playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы в наручниках");
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вам нужно выйти из транспорта");
	new g = fraction(playerid);
	if(IsPlayerInRangeOfPoint(playerid,3.0,1248.6566,-2055.3650,59.7468) && GetPlayerVirtualWorld(playerid) == 0) // Cosa Nostra
	{
		if(g != 5) return ErrorMessage(playerid, "{FF6347}Это транспорт Cosa Nostra");
