CMD:givepoint(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	new tmp[144], kolv, giveplayerid, string[144];
	if(sscanf(params, "s[144]i", tmp, kolv)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать очки [ /givepoint ID Количество ]");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	if(kolv < 1 || kolv > 100) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество очков не меньше 1 и не больше 100");
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
		if(PlayerInfo[playerid][pSoska] < 15 && (PlayerInfo[playerid][pSoska] != 12 && PlayerInfo[playerid][pSoska] != 13))
		{
			if(PlayerInfo[giveplayerid][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать очки администратору..");
			if(PlayerInfo[giveplayerid][pLeader] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не лидер..");
		}
		if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать очки себе");
		if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать очки администратору своего уровня или выше");
		PlayerInfo[giveplayerid][pAdmPoint] += kolv;
		if(PlayerInfo[giveplayerid][pAdmPoint] >= ServerInfo[23] && kolv >= 1)
		{
			PlayerInfo[giveplayerid][pAdmScore] += 1;
			PlayerInfo[giveplayerid][pAdmPoint] -= ServerInfo[23];
		}
		format(string, sizeof(string), " [ ADM ]: %s выдал %d очков (Point) %s", PlayerInfo[playerid][pName], kolv, PlayerInfo[giveplayerid][pName]);
 		ABroadCast(COLOR_ADM,string,1);
 		format(string, sizeof(string), "* Администратор %s выдал мне %d очков (Point)", PlayerInfo[playerid][pName], kolv);
		SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
		AdminLog("givepoint", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolv, "");
	}
	else
 	{
  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,25,kolv);
      	return 1;
 	}
	return 1;
}
CMD:takepoint(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	new tmp[144], kolv, giveplayerid, string[144];
	if(sscanf(params, "s[144]i", tmp, kolv)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Забрать очки [ /takepoint ID Количество ]");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	if(kolv < 1 || kolv > 100000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество очков не меньше 1 и не больше 100000");
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
		if(PlayerInfo[playerid][pSoska] < 15 && (PlayerInfo[playerid][pSoska] != 12 && PlayerInfo[playerid][pSoska] != 13))
		{
			if(PlayerInfo[giveplayerid][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу забрать очки у администратора..");
			if(PlayerInfo[giveplayerid][pLeader] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не лидер..");
		}
		if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу забрать очки у себя");
		if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу забрать очки у администратора своего уровня или выше");
		if(PlayerInfo[giveplayerid][pAdmPoint] < kolv) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет такого количества очков");
		update_admpoint(giveplayerid, -kolv);
		format(string, sizeof(string), " [ ADM ]: %s забрал %d очков (Point) у %s", PlayerInfo[playerid][pName], kolv, PlayerInfo[giveplayerid][pName]);
 		ABroadCast(COLOR_ADM,string,1);
 		format(string, sizeof(string), "* Администратор %s забрал у меня %d очков (Point)", PlayerInfo[playerid][pName], kolv);
		SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
		AdminLog("takepoint", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolv, "");
	}
	else
 	{
  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,26,kolv);
      	return 1;
 	}
	return 1;
}
CMD:givescore(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	new tmp[144], kolv, giveplayerid, string[144], reason[128];
	if(sscanf(params, "s[144]is[128]", tmp, kolv, reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать баллы [ /givescore ID Количество Причина ]");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
	if(strlen(reason) < 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не указана причина [ Минимум 3 символа ]");
	if(kolv < 1 || kolv > 100) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Количество баллов не меньше 1 и не больше 100");
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
	    if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать баллы себе");
		if(PlayerInfo[playerid][pSoska] < 15 && (PlayerInfo[playerid][pSoska] != 12 && PlayerInfo[playerid][pSoska] != 13))
		{
			if(PlayerInfo[giveplayerid][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать баллы администратору..");
			if(PlayerInfo[giveplayerid][pLeader] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не лидер..");
		}
		else
		{
  			if(PlayerInfo[giveplayerid][pSoska] >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать баллы администратору своего уровня или выше");
		}
		PlayerInfo[giveplayerid][pAdmScore] += kolv;
		format(string, sizeof(string), " [ ADM ]: %s выдал %d баллов (Score) %s (Причина: %s)", PlayerInfo[playerid][pName], kolv, PlayerInfo[giveplayerid][pName], reason);
 		ABroadCast(COLOR_ADM,string,1);
 		format(string, sizeof(string), "* Администратор %s выдал мне %d баллов (Score)", PlayerInfo[playerid][pName], kolv);
		SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
		mysql_save(giveplayerid, 30);
		AdminLog("givescore", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], kolv, reason);
	}
	else
 	{
  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, reason,27,kolv);
      	return 1;
 	}
	return 1;
}
