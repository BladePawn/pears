    || PlayerInfo[playerid][pMember] == 12 || PlayerInfo[playerid][pLeader] == 12 || PlayerInfo[playerid][pMember] == 18 || PlayerInfo[playerid][pLeader] == 18
	|| PlayerInfo[playerid][pMember] == 10 || PlayerInfo[playerid][pLeader] == 10)
   	{
       format(str,sizeof(str),"\n{0088ff}/r {ffffff}- канал рации"), strcat(sctring,str);
       format(str,sizeof(str),"\n{0088ff}/u {ffffff}- общий канал мафий"), strcat(sctring,str);
       format(str,sizeof(str),"\n{0088ff}/members {ffffff}- участники Online"), strcat(sctring,str);
       format(str,sizeof(str),"\n{0088ff}/color {ffffff}- цветовой значок отличия"), strcat(sctring,str);
       format(str,sizeof(str),"\n{0088ff}/mafiabiz {ffffff}- информации о бизнесах"), strcat(sctring,str);
       format(str,sizeof(str),"\n{0088ff}/mafia {ffffff}- забить стрелу"), strcat(sctring,str);
       format(str,sizeof(str),"\n{0088ff}/dip {ffffff}- дипломатия"), strcat(sctring,str);
       if(PlayerInfo[playerid][pMember] == 6 || PlayerInfo[playerid][pLeader] == 6) format(str,sizeof(str),"\n{0088ff}/harakiri {ffffff}- совершить самоубийство"), strcat(sctring,str);
       if(PlayerInfo[playerid][pMember] == 18 || PlayerInfo[playerid][pLeader] == 18) format(str,sizeof(str),"\n{0088ff}/setcolor {ffffff}- использовать цвет другой организации"), strcat(sctring,str);
   	}

	format(str,sizeof(str),"\n{0088ff}/div {ffffff}- меню подфракции"), strcat(sctring,str);
	return ShowDialog(playerid, 2004, DIALOG_STYLE_MSGBOX, "{ff9000}Команды Организации", sctring, "*", "");
}

CMD:light(playerid)
{
    new v = GetPlayerVehicleID(playerid);
	if(IsACar(VehInfo[v][vModel]) || IsAMoto(VehInfo[v][vModel]))
	{
	    if(VehInfo[v][vLights] == 0)
		{
			GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
    		SetVehicleParamsEx(v, engine, true, alarm, doors, bonnet, boot, objective);
    		GameTextForPlayer(playerid, RusToGame("~w~Фары ~g~Вкл"), 3000, 4);
    		VehInfo[v][vLights] = 1, PlayerPlaySound(playerid, 14404, 0,0,0);
		}
		else if(VehInfo[v][vLights] == 1)
		{
			GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
    		SetVehicleParamsEx(v, engine, false, alarm, doors, bonnet, boot, objective);
    		GameTextForPlayer(playerid, RusToGame("~w~Фары ~r~Выкл"), 3000, 4);
    		VehInfo[v][vLights] = 0, PlayerPlaySound(playerid, 14405, 0,0,0);
		}
	}
	return 1;
}
CMD:lock(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
		// Если игрок стоит, и находится рядом с транспортом - узнаем ID транспорта
		vehicleid = GetClosestVehicle(playerid);
	}
	else if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) {
		return ErrorMessage(playerid, "{FF6347}Вы не за рулём транспортного средства [ Управление транспортом ALT ]");
	}
	if (vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID)
	{
		// GetPlayerVehicleID возвращает 0 если игрок не в машине (скорее всего баг дефолтного серверного сампа)
		// GetClosestVehicle (наша функция) возвращает INVALID_VEHICLE_ID если поблизости нет машин
		return ErrorMessage(playerid, "{FF6347}Рядом с вами нет транспортных средств");
	}
    if(IsAVello(vehicleid)) return ErrorMessage(playerid, "{FF6347}Велосипед нельзя запереть");
	
	LockedVehicle(playerid, vehicleid);
	return 1;
}

stock LockedVehicle(playerid, vehicleid)
{
	new bool: is_can_lock = GetPlayerVehicleID(playerid) == vehicleid && GetPlayerState(playerid) == PLAYER_STATE_DRIVER || notakey(playerid, vehicleid) == 1;
	if (!is_can_lock) {
		if (!IsVehicleOpen(playerid, vehicleid)) {
			DP[0][playerid] = vehicleid;
			DP[1][playerid] = 1;
			PlayerPlaySound(playerid,17803,0,0,0);
			ShowDialog(playerid,1350,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт","{FF6347}У вас нет ключей от этого транспорта{cccccc}\nХотите взломать замок транспорта?\n\n{FF6347}Как взломать замок?\n{ffcc66}- Нажимайте на Ключ в тот момент, когда полоска будет на зелёной линии","Да","Нет");	
		}
		return false;
	}

	if(VehInfo[vehicleid][vCarLock] == 0)
	{
	    LockCar(vehicleid, 1);
	    SetPlayerChatBubble(playerid,"запирает транспорт",COLOR_PURPLE,20.0,3000);
	    GameTextForPlayer(playerid, "~w~ЏPAHCЊOPЏ ~r~3AЊEPЏ", 3000, 4);
	}
	else if(VehInfo[vehicleid][vCarLock] == 1)
	{
	    LockCar(vehicleid, 0);
	    SetPlayerChatBubble(playerid,"открывает транспорт",COLOR_PURPLE,20.0,3000);
	    GameTextForPlayer(playerid, "~w~ЏPAHCЊOPЏ ~g~OЏKP‘Џ", 3000, 4);
	}
	PlayerPlaySound(playerid, 1145, 0,0,0);
	if(PlayerInfo[playerid][pDrawVisible][7] == false && Cars[vehicleid] != 52 
		&& setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8) UpdateVehLock(playerid);

	return true;
}

stock engineStalled(playerid, v)
{
	if(VehInfo[v][vModel] == 509 || VehInfo[v][vModel] == 510 || VehInfo[v][vModel] == 481) return 0;

	if(IsAPlane(VehInfo[v][vModel]) && VehInfo[v][vHealth] <= 0) {}
	else
	{
		ErrorMessage(playerid, "{FF6347}Двигатель заглох в результате сильного повреждения или переворота транспорта\n\n{cccccc}Используйте рем. комплект, чтобы починить двигатель");

		// Квест 4 (Ремонт Транспорта)
		if(NoCompleteQuest(playerid, 4) && IsACar(VehInfo[v][vModel]))
		{
			if(get_boot(v, 183) > 0) ShowQwest(playerid, 4);
		}
	}
	GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
	SetVehicleParamsEx(v, false, false, alarm, doors, bonnet, boot, objective);
	VehInfo[v][vEngine] = 0, VehInfo[v][vLights] = 0;
	UpdateVehEngine(playerid);
	return 1;
}
CMD:engine(playerid)
{
	new v = GetPlayerVehicleID(playerid);
	if(VehInfo[v][vModel] == 509 || VehInfo[v][vModel] == 510 || VehInfo[v][vModel] == 481) return 1;
   	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
   	{
   		if(VehInfo[v][vEngine] == 0)
		{
		    if(notakey(playerid, v) == 0)
			{
				DP[0][playerid] = v;
				DP[1][playerid] = 2;
				PlayerPlaySound(playerid,17803,0,0,0);
				ShowDialog(playerid,1350,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт","{FF6347}У вас нет ключей от этого транспорта{cccccc}\n\nХотите взломать замок зажигания?","Да","Нет");	
				return 1;			
			}
			EngineStart(playerid, v);
		}
		else if(VehInfo[v][vEngine] == 1)
		{
		    GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(v, false, false, alarm, doors, bonnet, boot, objective);
			SetPlayerChatBubble(playerid,"глушит двигатель",COLOR_PURPLE,25.0,5000);
			VehInfo[v][vEngine] = 0, VehInfo[v][vLights] = 0;
			UpdateVehEngine(playerid);
		}
   	}
	return 1;
}
stock EngineStart(playerid, v, bool:bubble = true)
{
	if(VehInfo[v][vHealth] <= 400)
	{
		if(bubble == true) SetPlayerChatBubble(playerid,"пытается запустить двигатель",COLOR_PURPLE,25.0,4000);

		new line[100],lines[200];
		format(line,sizeof(line),"{FF6347}Двигатель повреждён\n\n{cccccc}Используйте рем. комплект, чтобы починить двигатель"), strcat(lines,line);
		if(IsAPlane(VehInfo[v][vModel]) || IsABoat(VehInfo[v][vModel]))
		{
			format(line,sizeof(line),"\n{cccccc}[ Y >> GPS >> Транспорт >> Обслуживание и Ремонт ]"), strcat(lines,line);
		}
		else 
		{
			format(line,sizeof(line),"\n{cccccc}[ Y >> GPS >> Автосервисы ]"), strcat(lines,line);
		}
		ErrorMessage(playerid, lines);
		return 1;
	}
	if(VehInfo[v][vGas] <= 0 && VehInfo[v][vGelium] <= 0)
	{
		if(bubble == true)  SetPlayerChatBubble(playerid,"пытается запустить двигатель",COLOR_PURPLE,25.0,4000);
		new str[100],sctring[200];
		format(str,sizeof(str),"\n{FF6347}В транспорте нет топлива! {cccccc}[ Y >> GPS >> Транспорт >> Заправки ]\n"), strcat(sctring,str);
		if(get_invent4(playerid, 9, 0) >= 1) format(str,sizeof(str),"{cccccc}У вас есть канистра. Можно подзаправить {ff9000}[ N - Инвентарь ]\n"), strcat(sctring,str);
		ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{FF6347}Нет Топлива",sctring,"*","");
		CheckBenz(playerid);
	}
	else if(VehInfo[v][vGas] >= 1 || VehInfo[v][vGelium] >= 1)
	{
		GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
		SetVehicleParamsEx(v, true, lights, alarm, doors, bonnet, boot, objective);
		if(bubble == true)  SetPlayerChatBubble(playerid,"запускает двигатель",COLOR_PURPLE,25.0,5000);
		VehInfo[v][vEngine] = 1, CheckBenz(playerid);
		new tmphour,tmpminute,tmpsecond;
		gettime(tmphour, tmpminute, tmpsecond);
		if(tmphour >= 20 || tmphour >= 0 && tmphour <= 6)
		{
			GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(v, engine, true, alarm, doors, bonnet, boot, objective);
			VehInfo[v][vLights] = 1;
		}
		UpdateVehEngine(playerid);
	}
	return 1;
}
stock automobile(playerid)
{
	new v = DP[0][playerid];
   	new str[100],sctring[550];
   	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
   	{
		format(str,sizeof(str),"{ff9000}%s {555555}| Model %d ID %d\t ",GetVehicleName(VehInfo[v][vModel]), VehInfo[v][vModel], v), strcat(sctring,str);
		if(VehInfo[v][vCarLock] == 0) format(str,sizeof(str),"\n{cccccc}Двери \t {99ff66}[ Open ]"), strcat(sctring,str);
		else if(VehInfo[v][vCarLock] == 1) format(str,sizeof(str),"\n{cccccc}Двери \t {FF6347}[ Close ]"), strcat(sctring,str);
	   	if(VehInfo[v][vEngine] == 1) format(str,sizeof(str),"\n{cccccc}Двигатель \t {99ff66}[ On ]"), strcat(sctring,str);
	   	else if(VehInfo[v][vEngine] == 0) format(str,sizeof(str),"\n{cccccc}Двигатель \t {FF6347}[ Off ]"), strcat(sctring,str);
	   	if(IsACar(VehInfo[v][vModel]) || IsAMoto(VehInfo[v][vModel]))
		{
	   		if(VehInfo[v][vLights] == 1) format(str,sizeof(str),"\n{cccccc}Фары \t {99ff66}[ On ]"), strcat(sctring,str);
	   		else if(VehInfo[v][vLights] == 0) format(str,sizeof(str),"\n{cccccc}Фары \t {FF6347}[ Off ]"), strcat(sctring,str);
	   		if(PlayerInfo[playerid][pSLimit] == 0) format(str,sizeof(str),"\n{cccccc}Ограничитель \t {FF6347}[ Off ]"), strcat(sctring,str);
	   		else if(PlayerInfo[playerid][pSLimit] > 0) format(str,sizeof(str),"\n{cccccc}Ограничитель \t {99ff66}[ %d КМ/H ]", PlayerInfo[playerid][pSLimit]), strcat(sctring,str);
		}
		if(IsACar(VehInfo[v][vModel]))
		{
			GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
			if(IsABootFront(v))
			{
				if(boot == true) format(str,sizeof(str),"\n{cccccc}Капот \t {99ff66}[ Open ]"), strcat(sctring,str);
				else if(boot == false) format(str,sizeof(str),"\n{cccccc}Капот \t {FF6347}[ Close ]"), strcat(sctring,str);
				if(bonnet == true) format(str,sizeof(str),"\n{cccccc}Багажник \t {99ff66}[ Open ]"), strcat(sctring,str);
				else if(bonnet == false) format(str,sizeof(str),"\n{cccccc}Багажник \t {FF6347}[ Close ]"), strcat(sctring,str);
			}
			else
			{
				if(bonnet == true) format(str,sizeof(str),"\n{cccccc}Капот \t {99ff66}[ Open ]"), strcat(sctring,str);
				else if(bonnet == false) format(str,sizeof(str),"\n{cccccc}Капот \t {FF6347}[ Close ]"), strcat(sctring,str);
				if(boot == true) format(str,sizeof(str),"\n{cccccc}Багажник \t {99ff66}[ Open ]"), strcat(sctring,str);
				else if(boot == false) format(str,sizeof(str),"\n{cccccc}Багажник \t {FF6347}[ Close ]"), strcat(sctring,str);
			}
		   	GetVehicleParamsCarWindows(v, driver, passenger, backleft, backright);
		   	if(driver == false) format(str,sizeof(str),"\n{cccccc}Окно Переднее Левое \t {99ff66}[ Open ]"), strcat(sctring,str);
		   	else if(driver != false) format(str,sizeof(str),"\n{cccccc}Окно Переднее Левое \t {FF6347}[ Close ]"), strcat(sctring,str);
		   	if(passenger == false) format(str,sizeof(str),"\n{cccccc}Окно Переднее Правое \t {99ff66}[ Open ]"), strcat(sctring,str);
		   	else if(passenger != false) format(str,sizeof(str),"\n{cccccc}Окно Переднее Правое \t {FF6347}[ Close ]"), strcat(sctring,str);
		   	if(IsAZad(VehInfo[v][vModel]))
	 		{
		   		if(backleft == false) format(str,sizeof(str),"\n{cccccc}Окно Заднее Левое \t {99ff66}[ Open ]"), strcat(sctring,str);
		   		else if(backleft != false) format(str,sizeof(str),"\n{cccccc}Окно Заднее Левое \t {FF6347}[ Close ]"), strcat(sctring,str);
		   		if(backright == false) format(str,sizeof(str),"\n{cccccc}Окно Заднее Правое \t {99ff66}[ Open ]"), strcat(sctring,str);
		   		else if(backright != false) format(str,sizeof(str),"\n{cccccc}Окно Заднее Правое \t {FF6347}[ Close ]"), strcat(sctring,str);
  			}
		   	if(driver == false || passenger == false || backleft == false || backright == false) format(str,sizeof(str),"\n{FF6347}Закрыть Все Окна \t "), strcat(sctring,str);
		   	else if(driver != false || passenger != false || backleft != false || backright != false) format(str,sizeof(str),"\n{99ff66}Открыть Все Окна \t "), strcat(sctring,str);
 		}
		ShowDialog(playerid,66,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Управление Транспортом",sctring,"Выбор","Отмена");
	}
	else AutomobileInteraction(playerid);
	return 1;
}
CMD:auto(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "{FF6347}Вы не за рулём транспортного средства");
    DP[0][playerid] = GetPlayerVehicleID(playerid);
	automobile(playerid);
	return 1;
}
CMD:window(playerid)
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		new v = GetPlayerVehicleID(playerid);
		if(IsABus(VehInfo[v][vModel])) return 1;
		if(IsACar(VehInfo[v][vModel]))
		{
			if(GetPlayerWeapon(playerid) <= WEAPON:1)
			{
				new iSeat = GetPlayerVehicleSeat(playerid);
				GetVehicleParamsCarWindows(v, driver, passenger, backleft, backright);
		 		if(iSeat == 1)
				{
					if(passenger == false) SetVehicleParamsCarWindows(v, driver, true, backleft, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0), SetPlayerChatBubble(playerid,"нажимает на кнопку стеклоподъёмника и закрывает окно",COLOR_PURPLE,20.0,5000);
					else if(passenger != false) SetVehicleParamsCarWindows(v, driver, false, backleft, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0), SetPlayerChatBubble(playerid,"нажимает на кнопку стеклоподъёмника и открывает окно",COLOR_PURPLE,20.0,5000);
		 		}
		 		if(IsAZad(VehInfo[v][vModel]))
		 		{
			 		if(iSeat == 2)
					{
						if(backleft == false) SetVehicleParamsCarWindows(v, driver, passenger, true, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0), SetPlayerChatBubble(playerid,"нажимает на кнопку стеклоподъёмника и закрывает окно",COLOR_PURPLE,20.0,5000);
						else if(backleft != false) SetVehicleParamsCarWindows(v, driver, passenger, false, backright), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0), SetPlayerChatBubble(playerid,"нажимает на кнопку стеклоподъёмника и открывает окно",COLOR_PURPLE,20.0,5000);
			 		}
			 		else if(iSeat == 3)
					{
						if(backright == false) SetVehicleParamsCarWindows(v, driver, passenger, backleft, true), GameTextForPlayer(playerid, RusToGame("~w~Окно ~r~Закрыто"), 3000, 4), PlayerPlaySound(playerid, 14405, 0,0,0), SetPlayerChatBubble(playerid,"нажимает на кнопку стеклоподъёмника и закрывает окно",COLOR_PURPLE,20.0,5000);
						else if(backright != false) SetVehicleParamsCarWindows(v, driver, passenger, backleft, false), GameTextForPlayer(playerid, RusToGame("~w~Окно ~g~Открыто"), 3000, 4), PlayerPlaySound(playerid, 14404, 0,0,0), SetPlayerChatBubble(playerid,"нажимает на кнопку стеклоподъёмника и открывает окно",COLOR_PURPLE,20.0,5000);
			 		}
		 		}
	 		}
		}
	}
	return 1;
}
CMD:styles(playerid, const params[])
{
   if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
   if(PlayerInfo[playerid][pBoxSkill]>=200)
   {
      ShowDialog(playerid,9,DIALOG_STYLE_LIST,"{ffffff}* {0088ff}Стили Боя {ffffff}*","{0088ff}* {ffffff}Normal\n{0088ff}* {ffffff}Kneehead\n{0088ff}* {ffffff}Boxing\n{0088ff}* {ffffff}Kungfu\n{0088ff}* {ffffff}Grabkick","Выбор","Отмена");
   }
   else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изменить свой стиль боя [ /skill > Сила (100+) ]");
   return 1;
}

CMD:weather(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить погоду [ /weather ID ]");
	if(params[0] < 1 || params[0] > 500) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Погода не меньше 1 и не больше 500");
	SetWeather(params[0]);
	Pogoda = params[0];
	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s установил погоду ID: %d",PlayerInfo[playerid][pName],params[0]);
	ABroadCast(COLOR_ADM,string,1);
	return 1;
}
CMD:plweather(playerid, const params[])
{
    new weather;
	if (!sscanf(params, "i", weather))
	{
	    if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
		if(weather < 0||weather > 500) return SendClientMessage(playerid, COLOR_GREY, "   ID погоды от 0 до 500 !");
		SetPlayerWeather(playerid,weather);
		SendClientMessage(playerid, COLOR_GREY, "    Установлена погода для меня !");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить погоду для себя [ /weather ID ]");
	return 1;
}
forward Call_setmoney(playerid, kolmon, str_name[], stat);
public Call_setmoney(playerid, kolmon, str_name[], stat)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid,f_str[256],string[144];
		cache_get_value_name_int(0, "user_id", datadid);
		if(stat == 1)
		{
			new datad1;
		    cache_get_value_name_int(0, "Money", datad1);
 			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Money` = '%d' WHERE `Name` = '%e'", datad1+kolmon, str_name);
   			query_empty(pearsq, f_str);
   			format(f_str, sizeof(f_str), "{0088ff}Вы дали OFFLINE {FFFFFF}%s {00cc00}%d$",str_name,kolmon);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, f_str);
			AdminLog("givemoney", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", kolmon, "");
			format(string, sizeof(string), "Вам выдали %d$", kolmon);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
