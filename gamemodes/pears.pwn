public PlayFrak(frak, idmuz)
{
  foreach (Player, i)
  {
    if(OnlineInfo[i][oLogged] == 1)
	{
	  if(PlayerInfo[i][pMember] == frak || PlayerInfo[i][pLeader] == frak) PlayerPlaySound(i,idmuz,0,0,0);
    }
  }
}
public SendFounder(const string[])
{
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && PlayerInfo[i][pSoska] >= 22) SendClientMessage(i, COLOR_GREY, string);
	}
}
public SendDeath(killerid, playerid, reason)
{
	// Фракция убийцы
	new frakkil;
	if(PlayerInfo[killerid][pLeader] >= 1) frakkil = PlayerInfo[killerid][pLeader];
	else if(PlayerInfo[killerid][pLeader] == 0) frakkil = PlayerInfo[killerid][pMember];

	// Фракция Жертвы
	new frakpla;
	if(PlayerInfo[playerid][pLeader] >= 1) frakpla = PlayerInfo[playerid][pLeader];
	else if(PlayerInfo[playerid][pLeader] == 0) frakpla = PlayerInfo[playerid][pMember];

	// Отправляем инфу
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && PlayerInfo[i][pBkyrenie] <= 1 && GetPVarInt(i,"Readkill") == 0)
		{
		    // Банды
			if(IsGangMember(killerid)) // Показываем своим киллера, что он кого-то убил
			{
	  			if(PlayerInfo[i][pMember] == frakkil || PlayerInfo[i][pLeader] == frakkil)
	  			{
		    		if(Kapt[frakkil] > 0) SendDeathMessageToPlayer(i,killerid,playerid,reason);
	  			}
			}
			if(IsGangMember(playerid)) // Показываем своим киллера жертвы, что его кто-то убил
			{
	  			if(PlayerInfo[i][pMember] == frakpla || PlayerInfo[i][pLeader] == frakpla)
	  			{
	  				if(PlayerInfo[killerid][pMember] != 8 && PlayerInfo[killerid][pLeader] != 8)
	  			    {
		    			if(Kapt[frakpla] > 0) SendDeathMessageToPlayer(i,killerid,playerid,reason);
    				}
	  			}
			}
			
			// Мафии
			if(IsMafiaMember(killerid)) // Показываем своим киллера, что он кого-то убил
			{
	  			if(PlayerInfo[i][pMember] == frakkil || PlayerInfo[i][pLeader] == frakkil)
	  			{
		    		if(Strel[frakkil] > 0 || Zahvat[frakkil] > 0) SendDeathMessageToPlayer(i,killerid,playerid,reason);
	  			}
			}
			if(IsMafiaMember(playerid)) // Показываем своим киллера жертвы, что его кто-то убил
			{
	  			if(PlayerInfo[i][pMember] == frakpla || PlayerInfo[i][pLeader] == frakpla)
	  			{
	  				if(PlayerInfo[killerid][pMember] != 8 && PlayerInfo[killerid][pLeader] != 8)
	  			    {
		    			if(Strel[frakpla] > 0 || Zahvat[frakkil] > 0) SendDeathMessageToPlayer(i,killerid,playerid,reason);
    				}
	  			}
			}
		}
	}
}
public PlayAudioMember(member, const string[])
{
	foreach(Player,i)
	{
		if(OnlineInfo[i][oLogged] == 0 || OnlineInfo[i][oListenRadioPears] == 1 || GetPVarInt(i,"afksystem") >= 3) continue;
		if(PlayerInfo[i][pMember] == member || PlayerInfo[i][pLeader] == member)
		{
			StopAudioStreamForPlayer(i);
			PlayAudioStreamForPlayer(i, string);
		}
	}
	return 1;
}
public SendDjMessage(color, const string[])
{
  foreach (Player, i)
  {
	  if(PlayerInfo[i][pDjpears] >= 1 && OnlineInfo[i][oLogged] == 1) SendClientMessage(i, color, string);
  }
}
function SendBizzMessage(b, const string[])
{
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1)
		{
			if(PlayerInfo[i][pBusiness] == b || BizzInfo[b][bFam] >= 1 && PlayerInfo[i][pFamily] == BizzInfo[b][bFam])
			{
				SendClientMessage(i, COLOR_GREY, string);
			}
		}
	}
}
public SendMpMessage(const string[])
{
  foreach (Player, i)
  {
	  if(OnlineInfo[i][oLogged] == 1 && (MPGO[i] >= 1 || PlayerInfo[i][pSoska] >= 1|| PlayerInfo[i][pHidden] >= 1))SendClientMessage(i, COLOR_GREY, string);
  }
}
public PlayerPlayMusic(playerid)
{
	if(IsOnline(playerid))
	{
		SetTimer("StopMusic", 5000, false);
		PlayerPlaySound(playerid, 1068, 0.0, 0.0, 0.0);
	}
}
public StopMusic()
{
	foreach (Player, i)
	{
		PlayerPlaySound(i, 1069, 0.0, 0.0, 0.0);
	}
}
public PlayerFixRadio(playerid)
{
  if(IsOnline(playerid))
  {
     SetTimer("PlayerFixRadio2", 1000, false);
	 PlayerPlaySound(playerid, 1068, 0.0, 0.0, 0.0);
	 Fixr[playerid] = 1;
  }
}
public PlayerFixRadio2()
{
  foreach (Player, i)
  {
    if(IsOnline(i))
	{
	  if(Fixr[i])
	  {
	    PlayerPlaySound(i, 1069, 0.0, 0.0, 0.0);
		Fixr[i] = 0;
	  }
    }
  }
}
//==========================================
//===============[ GANG ZONE ]==============
//==========================================
stock IsPosInSquare(Float:posx, Float:posy ,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
  if((posx <= max_x && posx >= min_x) && (posy <= max_y && posy >= min_y)) return 1;
  return 0;
}
stock IsVehicleInSquare(vehicleid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
  new Float:xxp,Float:yyp,Float:zzp;GetVehiclePos(vehicleid, xxp, yyp, zzp);
  if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return 1;
  return 0;
}
stock IsPlayerInSquare(playerid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
  new Float:xxp,Float:yyp,Float:zzp;GetPlayerPos(playerid, xxp, yyp, zzp);
  if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return 1;
  return 0;
}
stock IsPlayerInCube(playerid, Float:minx, Float:miny, Float:minz, Float:maxx, Float:maxy, Float:maxz)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
   	if(x > minx && x < maxx && y > miny && y < maxy && z > minz && z < maxz) return 1;
	return 0;
}
stock IsPosInCube(Float:x, Float:y, Float:z, Float:minx, Float:miny, Float:minz, Float:maxx, Float:maxy, Float:maxz)
{
   	if(x > minx && x < maxx && y > miny && y < maxy && z > minz && z < maxz) return 1;
	return 0;
}
stock NormalizeCoordinates3D(Float: x1, Float: y1, Float: z1, Float: x2, Float: y2, Float: z2, &Float: min_x, &Float: min_y, &Float: min_z, &Float: max_x, &Float: max_y, &Float: max_z)
{
	min_x = (x1 < x2) ? x1 : x2;
	max_x = (x1 > x2) ? x1 : x2;
	min_y = (y1 < y2) ? y1 : y2;
	max_y = (y1 > y2) ? y1 : y2;
	min_z = (z1 < z2) ? z1 : z2;
	max_z = (z1 > z2) ? z1 : z2;

	return 1;
}
stock NormalizeCoordinates2D(Float: x1, Float: y1, Float: x2, Float: y2, &Float: min_x, &Float: min_y, &Float: max_x, &Float: max_y)
{
	min_x = (x1 < x2) ? x1 : x2;
	max_x = (x1 > x2) ? x1 : x2;
	min_y = (y1 < y2) ? y1 : y2;
	max_y = (y1 > y2) ? y1 : y2;

	return 1;
}

stock GetCityArea(Float: x, Float: y, bool: only_city = false) {
	if (!only_city) {
		// Весь штат SA, включая сельские территории
		if(IsPosInSquare(x, y, -1236, -370, 3000, 598) || IsPosInSquare(x, y, 40, -3000, 3000, -369)) // LS2, LS1
			return CITY_AREA_LOS_SANTOS;
		if(IsPosInSquare(x, y, -3000, -3000.0, -1236, 1623) || IsPosInSquare(x, y, -1236, -3000, 39, -369)) // SF city, SF village
			return CITY_AREA_SAN_FIERRO;
		if(IsPosInSquare(x, y, -3000, 1623, 3000, 3000) || IsPosInSquare(x, y, -1236, 597, 3000, 1623)) // LV1, LV2
			return CITY_AREA_LAS_VENTURAS;
	} else {
		// Только LS/SF/LV
		if (IsPosInSquare(x, y, 148.0469, -2762.0000, 2972.0000, -859.6853))
			return CITY_AREA_LOS_SANTOS;
		if (IsPosInSquare(x, y, -2986.0547, -413.5603, -1473.7344, 1589.2522))
			return CITY_AREA_SAN_FIERRO;
		if (IsPosInSquare(x, y, 867.7269, 726.3235, 2944.0000, 2860.3391))
			return CITY_AREA_LAS_VENTURAS;
	}

	return CITY_AREA_NONE;
}

stock GetPlayerCityArea(playerid, bool: only_city = false) {
	new Float: x, Float: y, Float: z;
	GetPlayerPos(playerid, x, y, z);

	return GetCityArea(x, y, only_city);
}

stock IsPlayerInBandOnline(bandid)
{
	foreach (Player, i)
	{
		if((PlayerInfo[i][pMember] == bandid || PlayerInfo[i][pLeader] == bandid) && OnlineInfo[i][oLogged] == 1) return 1;
	}
	return 0;
}
stock IsPoliceInNear(playerid)
{
	new kol = 0;
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1)
		{
			if(PlayerInfo[i][pMember] == 1 || PlayerInfo[i][pLeader] == 1 || PlayerInfo[i][pMember] == 11 || PlayerInfo[i][pLeader] == 11 || PlayerInfo[i][pMember] == 21 || PlayerInfo[i][pLeader] == 21 || PlayerInfo[i][pMember] == 22 || PlayerInfo[i][pLeader] == 22)
			{
				kol++;
				if(kol == 1)
				{
					if(ProxDetectorS(300.0, playerid, i)) return 1;
				}
			}
		}
	}
	return 0;
}
CMD:checkwater(playerid)
{
    if(server != 0) return 1;

	new check = CA_IsPlayerNearWater(playerid, 1.0, 1.0);
	if(check) SendClientMessage(playerid, -1, "{99ff66}In Water");
	else SendClientMessage(playerid, -1, "No Water");
    return 1;
}
CMD:kickme(playerid)
{
	if(server != 0) return 1;
	kicked(playerid, playerid);
	return 1;
}

CMD:testcam(playerid)
{
    if(PlayerInfo[playerid][pSoska] < 22) return 1;
	InterpolateCameraPos(playerid, 1092.789306, -2043.082763, 90.107772, 564.572692, -1804.235595, 6.305634, 3000);
	InterpolateCameraLookAt(playerid, 1088.708129, -2040.220581, 89.717864, 564.680175, -1809.234375, 6.325490, 3000);
	return 1;
}
CMD:testshop(playerid)
{
	if(server != 0) return 1;
	PlayerInfo[playerid][pShop] = 1;
	return 1;
}
CMD:testq(playerid)
{
	if(server != 0) return 1;
	PlayerInfo[playerid][pSalary] += 20000;
	return 1;
}
CMD:testeammo(playerid)
{
	if(server != 0) return 1;
	GiveThingPlayer(playerid, 65, 10, 0, 0, 0, 0, 9999);
	return 1;
}
CMD:testinter(playerid)
{
	if(server != 0) return 1;
	show_interaction(playerid, playerid);
	return 1;
}
CMD:testspec(playerid)
{
	if(server != 0) return 1;
	if(LoadSP[playerid] == false) LoadSpecDraw(playerid);
	gSpectateID[playerid] = playerid;
	ShowSpecPlayer(0, playerid, playerid);
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) ShowSpecPlayer(1, playerid, playerid);
	ShowSpecPlayer(2, playerid, playerid);
	ShowSpecPlayer(3, playerid, playerid);
	return 1;
}
