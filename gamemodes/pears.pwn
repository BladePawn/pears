					format(str,sizeof(str),"\n\n{cccccc}Деньги: {99ff66}%d$",PlayerInfo[giveplayerid][pMoney]), strcat(sctring,str);
					format(str,sizeof(str),"\n{cccccc}Банковский Счёт: {99ff66}%d$",PlayerInfo[giveplayerid][pAccount]), strcat(sctring,str);

					new d = PlayerInfo[giveplayerid][pDom], b = PlayerInfo[giveplayerid][pBusiness], taxes;
					if(d > 0) taxes += DomInfo[d][dTaxes];
			 		if(b > 0) taxes += BizzInfo[b][bTaxes];
					format(str,sizeof(str),"\n{cccccc}Налоги: {FF6347}%d$",taxes+PlayerInfo[giveplayerid][pTaxes][0]+PlayerInfo[giveplayerid][pTaxes][1]), strcat(sctring,str);

					if(PlayerInfo[giveplayerid][pDom] >= 1) format(str,sizeof(str),"\n{cccccc}Дом: №%d",PlayerInfo[giveplayerid][pDom]), strcat(sctring,str);
					else if(PlayerInfo[giveplayerid][pDom] == 0) format(str,sizeof(str),"\n{cccccc}Дом: {444444}нет"), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pBusiness] >= 1) format(str,sizeof(str),"\n{cccccc}Бизнес: №%d {ff9000}[%s]\n",PlayerInfo[giveplayerid][pBusiness], bizname(PlayerInfo[giveplayerid][pBusiness])), strcat(sctring,str);
					else if(PlayerInfo[giveplayerid][pBusiness] == 0) format(str,sizeof(str),"\n{cccccc}Бизнес: {444444}нет\n"), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pMyVeh][0] >= 400) format(str,sizeof(str),"\n{cccccc}Транспорт [1]: {ff9000}[ %s ]",GetVehicleName(PlayerInfo[giveplayerid][pMyVeh][0])), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pMyVeh][1] >= 400) format(str,sizeof(str),"\n{cccccc}Транспорт [2]: {ff9000}[ %s ]",GetVehicleName(PlayerInfo[giveplayerid][pMyVeh][1])), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pMyVeh][2] >= 400) format(str,sizeof(str),"\n{cccccc}Транспорт [3]: {ff9000}[ %s ]",GetVehicleName(PlayerInfo[giveplayerid][pMyVeh][2])), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pMyVeh][3] >= 400) format(str,sizeof(str),"\n{cccccc}Транспорт [4]: {ff9000}[ %s ]",GetVehicleName(PlayerInfo[giveplayerid][pMyVeh][3])), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pMyVeh][4] >= 400) format(str,sizeof(str),"\n{cccccc}Транспорт [5]: {ff9000}[ %s ]",GetVehicleName(PlayerInfo[giveplayerid][pMyVeh][4])), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pCrimes] >= 1)
					{
						format(str,sizeof(str),"\n\n{cccccc}Розыск: {ff0000}%d",PlayerInfo[giveplayerid][pCrimes]), strcat(sctring,str);
					}
					else if(PlayerInfo[giveplayerid][pCrimes] == 0) format(str,sizeof(str),"\n\n{cccccc}Розыск: {444444}не находится в розыске"), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pJailed] == 1 || PlayerInfo[giveplayerid][pJailed] == 5)
					{
						format(str,sizeof(str),"\n\n{cccccc}Тюремный Срок: %d сек {444444}[ Арестовал: %s ]",PlayerInfo[giveplayerid][pJailTime],PlayerInfo[giveplayerid][pVictim]), strcat(sctring,str);
					}
					if(PlayerInfo[giveplayerid][pJailed] == 4) format(str,sizeof(str),"\n\n{cccccc}Лечение в Больнице: %d сек",PlayerInfo[giveplayerid][pJailTime]), strcat(sctring,str);
					if(PlayerInfo[giveplayerid][pJailed] == 2) format(str,sizeof(str),"\n\n{cccccc}Психиатрическая Больница: %d сек",PlayerInfo[giveplayerid][pJailTime]), strcat(sctring,str);
					ShowDialog(playerid,511,DIALOG_STYLE_MSGBOX,"{444444}База Данных",sctring,"Ок","");
				}
				else
				{
					stop_dialog(playerid);
					if(!CheckRP_Nickname(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
					mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", inputtext);
					mysql_tquery(pearsq, string, "Call_mdc", "ds", playerid, inputtext);
				}
			}
			else ShowDialog(playerid,566,DIALOG_STYLE_INPUT,"{444444}База Данных","{cccccc}Введите {ff9000}ID или никнейм {cccccc}игрока\nчтобы посмотреть всю информацию о нём","Принять","Отмена");
		}
		else {
			if (GetPVarInt(playerid, "HackDatabaseMDC")) {
				DeletePVar(playerid, "HackDatabaseMDC");
				return PDatabase_Dialog_ClearMenu(playerid);
			}
			mdc_menu(playerid);
		}
	}
