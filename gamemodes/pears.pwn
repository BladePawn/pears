stock SaveNalog(cases)
{
	new f_str[84];
	switch(cases)
	{
		case 0: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_config` SET `nned` = '%f'",nalog[0]), query_empty(pearsq, f_str);
		case 1: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_config` SET `ntra` = '%f'",nalog[1]), query_empty(pearsq, f_str);
		case 2: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_config` SET `ndoh` = '%f'",nalog[2]), query_empty(pearsq, f_str);
		case 3: mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_config` SET `nbiz` = '%f'",nalog[3]), query_empty(pearsq, f_str);
		default: { }
	}
	return 1;
}
