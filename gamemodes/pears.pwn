        	if(Hold[playerid] == 4) Hold[playerid] = 0;
        	new inva = DP[0][playerid], packinva = DP[1][playerid];
        	if(inva == 9999) return 1;
        	
        	new fpick = PlayerInfo[playerid][pInven][inva], fquan = PlayerInfo[playerid][pInvenQuan][inva], thingType = PlayerInfo[playerid][pInvenType][inva], thingPack = PlayerInfo[playerid][pInvenPack][inva];
			new fpickpack = PlayerInfo[playerid][pInven][packinva];
        	if(fpick == 0 || fpickpack != 39) return 1;
        	if(thingPack == 1) return ErrorMessage(playerid, "{FF6347}Этот предмет уже упакован в подарок");
        	if(thingType != 5 && (thingPack >= 2 || NotGiveThing(fpick, thingType, fquan))) return ErrorMessage(playerid, "{FF6347}Этот предмет нельзя упаковать в подарок");
        	
			if(NotGiveInflatabelBoat(playerid, fpick, thingType)) return i_resetveshi(playerid);
        	if(fpick == 51 || fpick == 63 || DocumentThing(fpick, thingType)) return ErrorMessage(playerid, "{FF6347}Документы нельзя упаковать в подарок");

        	PlayerPlaySound(playerid,1139,0,0,0);
        	format(string,sizeof(string),"{99ff66}Вы упаковали в подарок %s [Кол-во: %d]", GetNameThing(0, fpick, thingType, 0), fquan), SuccessMessage(playerid, string);
        	
    		PlayerInfo[playerid][pInvenPack][inva] = 1; // Пакуем в подарок
    		if(OnlineInfo[playerid][oShowInterface] == 1) i_tile(playerid, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenQuan][inva], inva, PlayerInfo[playerid][pInvenPara][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]);
    		TakeInvent(playerid, 39, 1, 0, packinva); // Забираем упаковку
        }
        else
        {
        	Veshi[playerid] = 0;
        	i_resetveshi(playerid);
        	if(Hold[playerid] == 4) Hold[playerid] = 0;
        }
  	}
