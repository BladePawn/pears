//=======================================
//===========[ Protect Project ]=========
//=======================================

// Поиск слота оружия
stock Protect_Slot(weaponid)
{
	switch(weaponid)
	{
		case 0,1: return 0;
		case 2..9: return 1;
		case 10..15: return 10;
		case 16..18,39: return 8;
		case 22..24: return 2;
		case 25..27: return 3;
		case 28,29,32: return 4;
		case 30,31: return 5;
		case 33,34: return 6;
		case 35..38: return 7;
		case 40: return 12;
		case 41..43: return 9;
		case 44..46: return 11;
		default: return 0;
	}
	return -1;
}

// Выдаём или отнимаем патроны с оружием
// ВНИМАНИЕ! При спавне оружие выдаётся в Protect_MyWeapon (Это важно всегда учитывать)
stock Protect_GiveWeapons(playerid, weaponid, ammo, det = GUN_HEALTH, qet = 0) // Выдаём патроны с оружием
{
	// weaponid Оружие
    // ammo Патроны
    // det Статус изношенности оружия
    // qet Статус краденного оружия

	new sl = Protect_Slot(weaponid);
	ResetWeaponUnix[playerid][sl] = gettime() + 5; // Кд на античит 5 сек (для одного слота с оружием, значит у других в этот момент будет детектиться)

	// Выдаём изношенность оружия
	if(det > ProtectInfo[playerid][prDet][sl] && ProtectInfo[playerid][prWeapon][sl] <= 0) ProtectInfo[playerid][prDet][sl] = det;

	// Прописываем статус краденного оружия
	if(qet > 0 && ProtectInfo[playerid][prWeapon][sl] <= 0) ProtectInfo[playerid][prQet][sl] = qet;

	// Меняем переменные отвечающие за оружие
	ProtectInfo[playerid][prWeapon][sl] = weaponid;
	if (!IsShootingWeapon(weaponid)) {
		// Для оружий ближнего боя - максимум 1 патрон
		ammo = 1;
		ProtectInfo[playerid][prAmmo][sl] = 1;
	} else {
		ProtectInfo[playerid][prAmmo][sl] += ammo;
	}

	// Записываем ID пушки, которую выдавали
	ProtectInfo[playerid][prGiveWeapon][weaponid] = true;

	// Меняем оружие в руках
	if(ProtectInfo[playerid][prAmmo][sl] > 0) GivePlayerWeapon(playerid, WEAPON:weaponid, ammo);
	else // Если мы отнимали оружие и патронов не осталось, чистим
	{
		RemovePlayerWeapon(playerid, WEAPON:weaponid);
		ProtectWeaponClear(playerid, sl);
	}

	// Обновляем отображение в инвентаре, если он открыт
	if(OnlineInfo[playerid][oShowInterface] == 1) UpdateGun(playerid);
    return true;
}

// Отнимаем одно оружие
stock Protect_Remove(playerid, weaponid, bool:typeCd = false) // когда typeCd true - мы не включаем кд античита
{
  new sl = Protect_Slot(weaponid);
  if (weaponid != ProtectInfo[playerid][prWeapon][sl] || ProtectInfo[playerid][prAmmo][sl] < 1) return 0; // Ничего не делаем, если в слоте не это оружие

  if(typeCd == false) ResetWeaponUnix[playerid][sl] = gettime() + 5; // Исключение кд на оружие
  else ResetAmmoUnix[playerid][sl] = 1; // Исключение кд на патроны

  RemovePlayerWeapon(playerid, WEAPON:weaponid);
  ProtectWeaponClear(playerid, sl);

  if(typeCd == false)
  {
    // Обновляем отображение в инвентаре, если он открыт
    if(OnlineInfo[playerid][oShowInterface] == 1) UpdateGun(playerid);
  }
  return 1;
}

// Отнимаем оружие
stock Protect_TakeGuns(playerid, stat) // Отнимаем Всё Оружие
{
	// Отнимаем всё оружие в руках
	if(stat == 0)
	{
		// Кд античита на оружие
		GivePlayerResetWeaponUnix(playerid);

		// Отнимаем всё оружие
		ResetPlayerWeapons(playerid);

		for(new i = 0; i < MAX_WEAPON_SLOTS; i++ ) ProtectWeaponClear(playerid, i);
  	}

	// Отнимаем всё оружие в руках КРОМЕ некоторых
  	else if(stat == 1)
	{
		new unix = gettime();
		for(new i = 0; i < MAX_WEAPON_SLOTS; i++ )
		{
			if(ProtectInfo[playerid][prWeapon][i] == 23 && OnDuty[playerid] >= 1 // Электрошокер
				|| ProtectInfo[playerid][prWeapon][i] == 41 // Spray
				|| ProtectInfo[playerid][prWeapon][i] == 42 // Огнетушитель
				|| ProtectInfo[playerid][prWeapon][i] == 43 // Камера
				|| ProtectInfo[playerid][prWeapon][i] == 46) continue; // Парашют

			// Всё остальное отнимаем
			if(ProtectInfo[playerid][prWeapon][i] > 0)
			{
				ResetWeaponUnix[playerid][i] = unix + 5;
				RemovePlayerWeapon(playerid, WEAPON:ProtectInfo[playerid][prWeapon][i]);
				ProtectWeaponClear(playerid, i);
			}
		}
	}
    return 1;
}

// Уничтожаем всё Оружие (Временно лишённое и на руках)
stock Protect_DestroyGuns(playerid)
{
	// Кд античита на оружие
	GivePlayerResetWeaponUnix(playerid);

	// Отнимаем всё оружие
 	ResetPlayerWeapons(playerid);

	// Очищаем все переменные для хранения оружия
	for(new i = 0; i < MAX_WEAPON_SLOTS; i++) 
	{
		TempWeaponClear(playerid, i);
		ProtectWeaponClear(playerid, i);
	}
    return 1;
}

// Выдаём оружие игрока после спавна
stock Protect_MyWeapon(playerid)
{
	if(PlayerInfo[playerid][pBeret] == 0 && YesGiveMyWeapon(playerid))
	{
		// Позиция игрока находится на территории зелёной зоны, не смотря на отсутствие статуса нахождения в ней
        // Это фикс проблемы, когда игрок спавнится в зелёной зоне
        if(PlayerInGreenZonePosition(playerid)) return TempTake(playerid, 1);

		// Кд античита на оружие
		GivePlayerResetWeaponUnix(playerid);

		// Отнимаем всё оружие
		ResetPlayerWeapons(playerid);

		for(new i = 0; i < MAX_WEAPON_SLOTS; i++)
		{
			if(ProtectInfo[playerid][prWeapon][i] >= 1 && ProtectInfo[playerid][prWeapon][i] <= 8 || ProtectInfo[playerid][prWeapon][i] >= 10 && ProtectInfo[playerid][prWeapon][i] <= 15
			|| ProtectInfo[playerid][prWeapon][i] == 23 && OnDuty[playerid] >= 1 || ProtectInfo[playerid][prWeapon][i] == 38
			|| WeaponAmmoType(ProtectInfo[playerid][prWeapon][i]))
			{
				if(ProtectInfo[playerid][prWeapon][i] > 0 && ProtectInfo[playerid][prAmmo][i] > 0)
				{
					ProtectInfo[playerid][prGiveWeapon][ProtectInfo[playerid][prWeapon][i]] = true;
					GivePlayerWeapon(playerid, WEAPON:ProtectInfo[playerid][prWeapon][i], ProtectInfo[playerid][prAmmo][i]);
				}
			}
		}
		SetPlayerArmedWeapon(playerid, WEAPON:0);
	}
	return 1;
}

stock Protect_DeathTakeWeapon(playerid)
{
	// Кд античита на оружие
	GivePlayerResetWeaponUnix(playerid);

	// Отнимаем всё оружие
	ResetPlayerWeapons(playerid);
	return 1;
}

stock object_name(model)
{
	new obname[24];
	switch(model)
	{
		case 1798, 1797, 2090, 2302, 1812, 2301, 2566, 2300, 1725, 1794, 1793, 1796, 1795, 1799, 11720, 11731: obname = "Кровать";
		case 2121, 2310, 2124, 2120, 2079: obname = "Стул";
		case 1714, 1715, 2356, 1735, 1755, 1765, 1759, 1762, 2292, 2291, 1711, 1767, 1758, 1705, 1769, 1727, 1724: obname = "Кресло";
