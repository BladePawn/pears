		}
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:givemoneybank(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 23) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new string[144], playa, tmp[24];
	if(sscanf(params, "s[24]i", tmp,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать деньги в банк [ /givemoneybank ID количество ]");
	if(params[1] > 100000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 100.000.000");
	playa = ReturnUser(tmp, 1);
	if(IsOnline(playa))
	{
		PlayerInfo[playa][pAccount] += params[1];
		format(string, sizeof(string), "{0088ff}Вы зачислили на банковский счёт {FFFFFF}%s {00cc00}%d$",PlayerInfo[playa][pName],params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		format(string, sizeof(string), "{0088ff}Администратор {FFFFFF}%s {0088ff}зачислил вам на банковский счёт {00cc00}%d$",PlayerInfo[playerid][pName],params[1]);
		SendClientMessage(playa, COLOR_LIGHTBLUE, string);
		MoneyLog("givemoneybank", PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], 0, "", "", params[1], "Админ начислил");
		AdminLog("givemoneybank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], params[1], "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Account, Money, Ammo1 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_setmoney", "ddsd", playerid, params[1],tmp,3);
	}
	return 1;
}
CMD:takemoneybank(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 14) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
    new string[144], playa, tmp[24];
	if(sscanf(params, "s[24]i", tmp,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять деньги с банковского счёта [ /takemoneybank ID количество ]");
	if(params[1] > 100000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 100.000.000");
	playa = ReturnUser(tmp, 1);
	if(IsOnline(playa))
	{
		PlayerInfo[playa][pAccount] -= params[1];
		format(string, sizeof(string), "{0088ff}Вы сняли с банковского счёта {FFFFFF}%s {FF0000}%d$",PlayerInfo[playa][pName],params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		format(string, sizeof(string), "{0088ff}Администратор {FFFFFF}%s {0088ff}снял у вас с банковского счёта {FF0000}%d$",PlayerInfo[playerid][pName],params[1]);
		SendClientMessage(playa, COLOR_LIGHTBLUE, string);
		MoneyLog("takemoneybank", PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], 0, "", "", -params[1], "Админ изъял");
		AdminLog("takemoneybank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], params[1], "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Account, Money, Ammo1 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_setmoney", "ddsd", playerid, params[1], tmp,4);
	}
	return 1;
}
