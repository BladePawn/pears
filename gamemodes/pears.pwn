			}
			else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Мне нужно сесть за компьютерный стол в кабинете FBI Special Operations");
		}
		else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Мне нужно сесть за компьютерный стол в кабинете FBI Special Operations");
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не сотрудник FBI");
	return 1;
}
CMD:exitcam(playerid)
{
	if(OverHear[playerid] >= 1) PPExitSpectating(playerid);
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не использую систему слежения");
	return 1;
}
CMD:allcam(playerid)
{
	if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1)
	{
		if(SitPlayer[playerid] >= 1 || OverHear[playerid] >= 1 && OverHear[playerid] <= 999)
		{
			new sitid = SitPlayer[playerid]-1;
			if(sitid >= 174 && sitid <= 186 || OverHear[playerid] >= 1 && OverHear[playerid] <= 999)
			{
				if(camerafbi < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В данный момент не установлено ни одной камеры слежения"), pc_cmd_overhear(playerid);
				new sctring[3400], listid = 0;
				for(new cam = 0; cam < sizeof(CamInfo); cam++)
				{
					if(CamInfo[cam][cStat] >= 1)
					{
						format(sctring, sizeof(sctring), "%s[%d] {cccccc}%s\n", sctring, listid + 1, CamInfo[cam][cName]);
						List[listid][playerid] = cam;
						listid++;
					}
				}
				ShowDialog(playerid,953,DIALOG_STYLE_LIST,"{cccccc}Камеры Слежения",sctring,"Выбрать","Отмена");
			}
			else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Мне нужно сесть за компьютерный стол в кабинете FBI Special Operations");
		}
		else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Мне нужно сесть за компьютерный стол в кабинете FBI Special Operations");
	}
	else SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не сотрудник FBI"), stop_dialog(playerid);
	return 1;
}
