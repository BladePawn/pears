const RPC_SCMEvent = 96;
const VEHICLE_SYNC = 200;
const AIM_SYNC = 203;
const BULLET_SYNC = 206;
const PLAYER_SYNC = 207;
const UNOCCUPIED_SYNC = 209;
const PASSENGER_SYNC = 211;
const SPEC_SYNC = 212;
const TRAILER_SYNC = 210;

function IsValidFloat(Float:value) return (value == value && value != Float:0x7F800000 && value != Float:0xFF800000);

// Защита от пакетов в AFK
OPacket:VEHICLE_SYNC(playerid, BitStream:bs) {
	if(playerid == -1) return true;
    return !IsPlayerAfk(playerid);
}

OPacket:AIM_SYNC(playerid, BitStream:bs) {
	if(playerid == -1) return true;
