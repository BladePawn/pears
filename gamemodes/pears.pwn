			if(oGetPlayerMoney(playerid) < GetVehiclePriceGos(vehicleModel)/100) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");

			if(PlayerInfo[playerid][pRent][0] > unix && PlayerInfo[playerid][pRentModel][0] == vehicleModel || PlayerInfo[playerid][pRent][1] > unix && PlayerInfo[playerid][pRentModel][1] == vehicleModel) return ErrorMessage(playerid, "{FF6347}Вы уже арендовали этот транспорт [ Y >> Транспорт или /car ]");
   				
