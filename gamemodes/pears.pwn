				if(realtax > PlayerInfo[playerid][pAccount]) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: На моём банковском счету недостаточно средств"), PlayerPlaySound(playerid,4203,0,0,0), bank(playerid, 11);
				ClearPlayerTaxes(playerid);
