			{
				if(SitPlayer[playerid]-1 >= 102 && SitPlayer[playerid]-1 <= 140)
				{
					if(Yaderstat == 0 || Yaderstat >= 3) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Точка для ядерного удара не установлена"), pc_cmd_boom(playerid);
					SetPVarInt(playerid,"GP",1);
