 	case 893: pc_cmd_mydom(playerid);
	case 896:
	{
		if(response)
        {
            i_resetveshi(playerid);
			i_resettabs(playerid);
			new useinva = OnlineInfo[playerid][oInventSelectRight];
            if(OnlineInfo[playerid][oShowTabs] == 9999 || Tabs_Load[playerid] != 5) return 1;
			new v = OnlineInfo[playerid][oShowTabs];
			if(!IsABoot(v)) return 1;
			if((VehInfo[v][vSost] == PlayerInfo[playerid][pID] || VehInfo[v][vKey] == PlayerInfo[playerid][pID] && VehInfo[v][vKeyUnix] > gettime()) && GetPlayerVip(playerid) > 0) {}
			else
			{
				if(VehInfo[v][vCarLock] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт заперт");
			}
			new Float:Boot[3], Float:Bonnet[3];
			GetCoordBonnetVehicle(v, Bonnet[0], Bonnet[1], Bonnet[2]);
			GetCoordBootVehicle(v, Boot[0], Boot[1], Boot[2]);
			if(IsPlayerInRangeOfPoint(playerid, 1.0, Boot[0], Boot[1], Boot[2]) && !IsABootFront(v) || IsPlayerInRangeOfPoint(playerid, 1.0, Bonnet[0], Bonnet[1], Bonnet[2]) && IsABootFront(v))
			{
			    new inva = DP[0][playerid];
			    HidePlayerDialog(playerid);
				new fpick = VehInfo[v][vInvent][inva], fquan = VehInfo[v][vInv][inva], thingType = VehInfo[v][vInvType][inva], thingPack = VehInfo[v][vInvPack][inva];
				if(fpick == 0 || thingType != 0 || thingPack > 0) return 1;

                if(useinva != 9999)
				{
					if(!IsAItemMatch(playerid, useinva, VehInfo[v][vInvent][inva])) return 0;
				}

				if(CheckThingQuan(fpick) != 1) return 1;
				new input = strval(inputtext);
		     	if(sscanf(inputtext, "i", input)) return ErrorMessage(playerid, "{FF6347}Вы ничего не ввели");
		    	if(input > 1000000 || input < 1) return ErrorMessage(playerid, "{FF6347}Не меньше 1 и не больше 1.000.000");
		    	if(input > fquan) return ErrorMessage(playerid, "{FF6347}У вас нет такого количества в этой ячейке");
		    	
		    	new getQuan, getLimit;
			    i_limit(playerid, fpick, getQuan, getLimit);
			    if(getQuan+input > getLimit) return format(string,sizeof(string),"{FF6347}У вас нет места в инвентаре\nЛимит для этого предмета: %d\n\n{cccccc}Предметы учитываются из раздела торговли и упаковок с подарками и рюкзаков", getLimit), ErrorMessage(playerid, string);

				new put_inva = GiveThingPlayer(playerid, fpick, input, VehInfo[v][vInvPara][inva], VehInfo[v][vInvQara][inva], thingType, VehInfo[v][vInvPack][inva], useinva);
				if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет

                TakeBoot(v, fpick, input, thingType, inva);

				if(VehInfo[v][vNewid] > 0) format(string,sizeof(string),"Взял из %s [DB %d]: %s", GetVehicleName(VehInfo[v][vModel]), VehInfo[v][vNewid], GetNameThing(1, fpick, thingType, thingPack));
				else format(string,sizeof(string),"Взял из %s: %s", GetVehicleName(VehInfo[v][vModel]), GetNameThing(1, fpick, thingType, thingPack));
				UserLog("getboot", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", input, string);

				// Квест ремонт транспорта
				if(NoCompleteQuest(playerid, 4) && fpick == 183 && IsACar(VehInfo[v][vModel]) && VehInfo[v][vHealth] <= 400.0)
				{
					PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_repair3.mp3");
					SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Теперь подойди к капоту и открой его так-же как багажник");
				}
			}
		}
	}
	case 897:
	{
		if(response)
        {
			if(OnlineInfo[playerid][oShowTabs] == 9999 || Tabs_Load[playerid] != 2) return 1;
			new dom = OnlineInfo[playerid][oShowTabs], inva = DP[1][playerid];
			new fpick = DomInfo[dom][dInvent][inva], thingType = DomInfo[dom][dInvType][inva], thingPack = DomInfo[dom][dInvPack][inva];
 	 		if(fpick == 0 || thingType != 0 || thingPack > 0) return 1;
 	 		if(CheckThingQuan(fpick) != 1) return 1;
 	 		
   	 		if(DomInfo[dom][dIngar] == 0) return ErrorMessage(playerid, "{FF6347}Ошибка! В доме не установлен гараж");
     		if(!strlen(inputtext)) return ErrorMessage(playerid, "{FF6347}Вы ничего не ввели");
			new v = DP[0][playerid];
			if(v == INVALID_VEHICLE_ID) return 1;

			if(IsVehicleInRangeOfPoint(v, 10.0, DomInfo[dom][dGarageX], DomInfo[dom][dGarageY], DomInfo[dom][dGarageZ]))
   			{
				if(CheckThingQuan(fpick) == 1) // Вещь имеет количество
				{
					new level = strval(inputtext);
	                if(!sscanf(inputtext, "i", level))
	   	            {
	   	            	if(level > 1000000 || level < 1) return ErrorMessage(playerid, "{FF6347}Не меньше 1 и не больше 1.000.000");
	   	            	if(level > DomInfo[dom][dInv][inva]) return ErrorMessage(playerid, "{FF6347}В этой ячейке нет такого количества"), i_resettabs(playerid);
	   	            	put_boot_fromdom(playerid, dom, v, fpick, level, inva);
					}
				}
 			}
 			else ErrorMessage(playerid, "{FF6347}Транспорт далеко от гаража");
		}
	}
	case 898:
	{
