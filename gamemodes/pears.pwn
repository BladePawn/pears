CMD:formavvs(playerid)
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(49, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не боец NGSA");
	if(!GetAccessRankOrg(playerid, g, 49, NO_FBI)) return 1;

	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || NoAnim[playerid] == 1 || PlayerInfo[playerid][pBkyrenie] >= 2
	|| Sleep[playerid] >= 1 || SleepRP[playerid] >= 1 || GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1
	|| gSkafandr[playerid] >= 1 || MPGO[playerid] != 0 || Stopeee[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас надеть форму ВВС");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(GetPlayerVirtualWorld(playerid) == 2001) return ErrorMessage(playerid, "{FF6347}Вы не можете переодеться в казино");
	if(gFormavvs[playerid] == 0)
	{
		SetPlayerAttachedObject(playerid,3,19472,2,0.017000,0.128999,0.009999,-0.200000,92.100013,88.999984,0.795000,1.073000,1.066000);
		m_custom_sync_SetPlayerSkin(playerid, 285);
		keep(playerid);
		PlayerPlaySound(playerid, 30801, 0.0, 0.0, 0.0);
		gFormavvs[playerid] = 1;
		SetPlayerChatBubble(playerid,"надевает форму ВВС",COLOR_PURPLE,20.0,3000);
		ApplyAnimation(playerid,"PED","Turn_R",4.0, false, true, true, false, false);
	}
	else
	{
		RemovePlayerAttachedObject(playerid,3);
		m_custom_sync_SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);
		PlayerPlaySound(playerid, 30803, 0.0, 0.0, 0.0);
		gFormavvs[playerid] = 0;
		SetPlayerChatBubble(playerid,"снимает форму ВВС",COLOR_PURPLE,20.0,3000);
		ApplyAnimation(playerid,"PED","Turn_R",4.0, false, true, true, false, false);
	}
	return 1;
}
