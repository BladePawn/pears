stock UpdateTextdrawFrame(playerid, frame)
{
    if(FrameInfo[frame][frModel] > 0)
	{
		new string[44];
	    // ID Модели
	    format(string,sizeof(string),"ID: %d",FrameInfo[frame][frModel]);
		PlayerTextDrawSetString(playerid, BuyIntDraw[5][playerid], string);
		PlayerTextDrawShow(playerid, BuyIntDraw[5][playerid]);
		
		// Class Интерьера (с какого класса подходит)
		if(FrameInfo[frame][frType] == 1)
		{
			format(string,sizeof(string),"Class: %d",FrameInfo[frame][frClass]);
			PlayerTextDrawSetString(playerid, BuyIntDraw[6][playerid], string);
			PlayerTextDrawShow(playerid, BuyIntDraw[6][playerid]);
		}
		else
		{
		    if(FrameInfo[frame][frType] == 0) format(string,sizeof(string),"ЏњЈ: O—Ўњќ");
		    else if(FrameInfo[frame][frType] == 1) format(string,sizeof(string),"ЏњЈ: ѓoЇ");
            else format(string,sizeof(string),"ЏњЈ: Ђњџ®ec");
            /*
			else if(FrameInfo[frame][frType] == 3) format(string,sizeof(string),"ЏњЈ: 3akyco¤®a¬");
            else if(FrameInfo[frame][frType] == 5) format(string,sizeof(string),"ЏњЈ: Pec¦opa®");
            else if(FrameInfo[frame][frType] == 6) format(string,sizeof(string),"ЏњЈ: Kћy— њћњ Pec¦opa®");
            */
			PlayerTextDrawSetString(playerid, BuyIntDraw[6][playerid], string);
			PlayerTextDrawShow(playerid, BuyIntDraw[6][playerid]);
		}
		
	 	// Стоимость Интерьера
		PlayerTextDrawColour(playerid, BuyIntDraw[7][playerid], 904549887);
		format(string,sizeof(string),"%d$",FrameInfo[frame][frPrice]);
		PlayerTextDrawSetString(playerid, BuyIntDraw[7][playerid], string);
		PlayerTextDrawShow(playerid, BuyIntDraw[7][playerid]);
	
	    // Название интерьера
	    format(string,sizeof(string),RusToGame(FrameInfo[frame][frName]));
		PlayerTextDrawSetString(playerid, BuyIntDraw[8][playerid], string);
		PlayerTextDrawShow(playerid, BuyIntDraw[8][playerid]); 
		
		if(TP[0][playerid] == 0)
		{
			PlayerTextDrawHide(playerid, BuyIntDraw[3][playerid]); // Кнопка КУПИТЬ
	    	PlayerTextDrawHide(playerid, BuyIntDraw[4][playerid]); // Надпись купить
		}
		else
		{
			PlayerTextDrawShow(playerid, BuyIntDraw[3][playerid]); // Кнопка КУПИТЬ
	    	PlayerTextDrawShow(playerid, BuyIntDraw[4][playerid]); // Надпись купить
		}
	}
	else
	{
	    PlayerTextDrawHide(playerid, BuyIntDraw[3][playerid]); // Кнопка КУПИТЬ
	    PlayerTextDrawHide(playerid, BuyIntDraw[4][playerid]); // Надпись купить
	    PlayerTextDrawHide(playerid, BuyIntDraw[8][playerid]); // Название интерьера
	}
	return 1;
}
