stock load_dirt()
{
	new d = random(21);
	if(DirtStat[d] == 0)
	{
		DirtObject[d] = CreateDynamicObject(19898, DirtPos[d][DirtPos_X], DirtPos[d][DirtPos_Y], DirtPos[d][DirtPos_Z], 0.0, 0.0, DirtPos[d][DirtPos_RZ], 0, 0, -1, 100.0, 100.0);
		DirtStat[d] = 1;
		DirtWash[d] = -1;
		dirtunix = gettime()+300;
		dirtkol ++;
	}
	return 1;
}
stock GetSkladStat(playerid)
{
	new skladstat = -1;
 	if(IsPlayerInRangeOfPoint(playerid,1.5,1578.7206,-1688.5414,6.2508) && GetPlayerVirtualWorld(playerid) == 257) skladstat = 1; // LSPD
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2544.0967,911.8699,1551.0039) && GetPlayerVirtualWorld(playerid) == 2) skladstat = 2; // FBI
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2544.0967,911.8699,1551.0039) && (GetPlayerVirtualWorld(playerid) == 3 || GetPlayerVirtualWorld(playerid) == WORLD_POLYGON_NGSA)) skladstat = 3; // Army СВ
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1505.7444,1989.9176,1357.0447)) skladstat = 5; // Cosa Nostra
	else if(IsPlayerInRangeOfPoint(playerid,1.5,878.3548,1387.7391,1029.3552) 
		&& GetPlayerVirtualWorld(playerid) == WORLD_YAKUZA_GARAGE && GetPlayerInterior(playerid) == INT_YAKUZA_GARAGE
			|| IsPlayerInRangeOfPoint(playerid,1.5,912.1558,1387.3573,1029.3673) 
			&& GetPlayerVirtualWorld(playerid) == WORLD_YAKUZA_1LVL && GetPlayerInterior(playerid) == INT_YAKUZA_1LVL) skladstat = 6; // Yakuza
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-2008.3356,150.4872,1666.0313)) skladstat = 7; // Правительство
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-506.6882,-84.0073,964.8114) && GetPlayerVirtualWorld(playerid) == 8) skladstat = 8; // Hitman
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1926.6970,903.6937,1402.0776)) skladstat = 10; // Triada
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1595.5094,726.3425,-4.8892) && GetPlayerVirtualWorld(playerid) == 208) skladstat = 11; // SFPD
	else if(IsPlayerInRangeOfPoint(playerid,1.5,-1998.0454,1106.5149,1018.6735)) skladstat = 12; // RM
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2490.5615,-1697.0072,2073.9805) && GetPlayerVirtualWorld(playerid) == 212) skladstat = 13; // Grove
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2477.0288,-2026.1244,2052.2808) && GetPlayerVirtualWorld(playerid) == 213) skladstat = 14; // Ballas
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2250.0166,-1464.9080,2089.4360) && GetPlayerVirtualWorld(playerid) == 214) skladstat = 15; // Vagos
	else if(IsPlayerInRangeOfPoint(playerid,1.5,1685.2411,-2094.6841,2091.8059) && GetPlayerVirtualWorld(playerid) == 215) skladstat = 16; // Actecas
	else if(IsPlayerInRangeOfPoint(playerid,1.5,930.3347,1383.3193,1029.4221) 
		&& GetPlayerVirtualWorld(playerid) == WORLD_ARABIAN_M1LVL && GetPlayerInterior(playerid) == INT_ARABIAN_M1LVL) skladstat = 18; // Arabian
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2544.0967,911.8699,1551.0039) && GetPlayerVirtualWorld(playerid) == 22) skladstat = 1; // SWAT
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2544.0967,911.8699,1551.0039) && GetPlayerVirtualWorld(playerid) == 33) skladstat = 3; // Army ВМС
	else if(IsPlayerInRangeOfPoint(playerid,1.5,2544.0967,911.8699,1551.0039) && GetPlayerVirtualWorld(playerid) == 29) skladstat = 1; // Тюрьма

	else if(IsPlayerInRangeOfPoint(playerid,1.5,1373.4683,2.4651,1000.9217)
		&& GetPlayerVirtualWorld(playerid) == 8 && GetPlayerInterior(playerid) == 5) skladstat = 4; // ASGH

		else if(IsPlayerInRangeOfPoint(playerid,1.5,1230.0952,-1422.5015,2001.0491)
		&& GetPlayerVirtualWorld(playerid) == 4 && GetPlayerInterior(playerid) == 4) skladstat = 4; // Психушка
		
	return skladstat;
}

function door(playerid)
{
	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	if(VehShopInfo[playerid][vsTest]) return 0;
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 0;

	new unix = gettime();
	if(a_flood[5][playerid] > unix) return 1;
	new yes;
	if(IsPlayerInRangeOfPoint(playerid,2.0,840.7153,-1629.5062,13.5328) && GetPlayerVirtualWorld(playerid) == WORLD_ZOOPET && GetPlayerInterior(playerid) == INT_ZOOPET) // Выход в ZooPet
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,840.8594,-1627.7410,13.5469), PPSetPlayerFacingAngle(playerid,182.8443);
		SetCameraBehindPlayer(playerid), yes = true;
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,840.8594,-1627.7410,13.5468) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в ZooPet
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,WORLD_ZOOPET,INT_ZOOPET), PPSetPlayerInterior(playerid,INT_ZOOPET);
		PPSetPlayerPos(playerid,840.7153,-1629.5062,13.5328), PPSetPlayerFacingAngle(playerid,182.8443);
		SetCameraBehindPlayer(playerid), yes = true;
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1555.5037,-1675.6438,16.1953) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в LSPD 1
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,255,0), PPSetPlayerInterior(playerid,0);
		Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
		PPSetPlayerPos(playerid,1558.1005,-1675.7172,16.2218), PPSetPlayerFacingAngle(playerid,270.8443);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,2.0,1555.8568,-1675.5680,16.2218) && GetPlayerVirtualWorld(playerid) == 255 && GetPlayerInterior(playerid) == 0) // Выход из LSPD 1
	{
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,1552.9423,-1675.5476,16.1953), PPSetPlayerFacingAngle(playerid,91.6599);
		SetCameraBehindPlayer(playerid), yes = true;
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,1560.5458,-1690.5068,5.8906) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в LSPD 2
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,257,0), PPSetPlayerInterior(playerid,0);
		Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
		PPSetPlayerPos(playerid,1561.2573,-1687.2087,6.2408), PPSetPlayerFacingAngle(playerid,0.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,2.0,1561.1942,-1689.5693,6.2408) && GetPlayerVirtualWorld(playerid) == 257 && GetPlayerInterior(playerid) == 0) // Выход из LSPD 2
	{
		if(PlayerInfo[playerid][pJailed] > 0) return ErrorMessage(playerid, "{FF6347}Заключённый не может покинуть здание полиции");
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,1560.5034,-1693.2789,5.8906), PPSetPlayerFacingAngle(playerid,180.0);
		SetCameraBehindPlayer(playerid), yes = true;
	}
	else if(IsPlayerInRangeOfPoint(playerid,2.0,2127.6677,2379.0337,10.8203) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в FBI New
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,243,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,2164.4932,2366.0176,23.6143), PPSetPlayerFacingAngle(playerid,270.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,2.0,2162.5190,2366.0842,23.6143) && GetPlayerVirtualWorld(playerid) == 243) // Выход из FBI New
	{
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,2127.5498,2376.3074,10.8203), PPSetPlayerFacingAngle(playerid,180.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,2.0,2116.3997,2431.8613,10.8203) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в Dep (0 Этаж) из гаража FBI
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,2,245), PPSetPlayerInterior(playerid,245);
		PPSetPlayerPos(playerid,2718.3315,920.9872,1501.0000), PPSetPlayerFacingAngle(playerid,90.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,2.0,2719.9980,920.9954,1501.0000) && GetPlayerInterior(playerid) == 245) // Выход из Dep (0 Этаж)
	{
		new world = GetPlayerVirtualWorld(playerid);
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
	    if(world == 2) PPSetPlayerPos(playerid,2113.9167,2431.7769,10.8203), PPSetPlayerFacingAngle(playerid,91.1086); // В гараж FBI
		SetCameraBehindPlayer(playerid), yes = true;
    }
	else if(IsPlayerInRangeOfPoint(playerid,1.0,-1605.6208,710.6066,13.8672) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в SFPD Основной
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,209,0), PPSetPlayerInterior(playerid,0);
		Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
		PPSetPlayerPos(playerid,-1605.4857,707.3784,13.8918), PPSetPlayerFacingAngle(playerid,180.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,1.0,-1605.4882,709.4955,13.8918) && GetPlayerVirtualWorld(playerid) == 209 && GetPlayerInterior(playerid) == 0) // Выход из SFPD Основной
	{
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,-1605.7705,715.7830,12.1117), PPSetPlayerFacingAngle(playerid,0.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
	else if(IsPlayerInRangeOfPoint(playerid,1.0,-1663.8527,698.4083,24.8976) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в SFPD Второй
	{
		if(GetPVarInt(playerid,"endorse") == 1 || PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1)
		{
			keep(playerid);
			S_SetPlayerVirtualWorld(playerid,210,0), PPSetPlayerInterior(playerid,0);
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
			PPSetPlayerPos(playerid,-1610.4319,706.5192,17.4628), PPSetPlayerFacingAngle(playerid,270.0);
			SetCameraBehindPlayer(playerid), yes = true;
		}
		else ErrorMessage(playerid, "{FF6347}У вас нет ключей от этой двери");
    }
    else if(IsPlayerInRangeOfPoint(playerid,1.0,-1613.6794,706.5187,17.4628) && GetPlayerVirtualWorld(playerid) == 210 && GetPlayerInterior(playerid) == 0) // Выход из SFPD Второй
	{
		if(GetPVarInt(playerid,"endorse") == 1 || PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1)
		{
			S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
			PPSetPlayerPos(playerid,-1667.2300,698.4034,24.8906), PPSetPlayerFacingAngle(playerid,90.0);
			SetCameraBehindPlayer(playerid), yes = true;
		}
		else ErrorMessage(playerid, "{FF6347}У вас нет ключей от этой двери");
    }
    else if(IsPlayerInRangeOfPoint(playerid,1.0,-1593.6697,708.0528,-5.2422) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в SFPD Гараж - 0 Этаж
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,208,0), PPSetPlayerInterior(playerid,0);
		Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
		PPSetPlayerPos(playerid,-1596.6202,708.6531,-4.8992), PPSetPlayerFacingAngle(playerid,90.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,1.0,-1594.6154,708.7490,-4.8992) && GetPlayerVirtualWorld(playerid) == 208 && GetPlayerInterior(playerid) == 0) // Выход из SFPD 0 Этаж - Гараж
	{
		if(PlayerInfo[playerid][pJailed] > 0) return ErrorMessage(playerid, "{FF6347}Заключённый не может покинуть здание полиции");
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		PPSetPlayerPos(playerid,-1591.3807,708.0076,-5.2422), PPSetPlayerFacingAngle(playerid,270.0);
		SetCameraBehindPlayer(playerid), yes = true;
    }
    else if(IsPlayerInRangeOfPoint(playerid,1.0,-1594.8738,687.5035,17.1641) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в SFPD с Балкона
	{
		if(GetPVarInt(playerid,"endorse") == 1 || PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1)
		{
			keep(playerid);
			S_SetPlayerVirtualWorld(playerid,210,0), PPSetPlayerInterior(playerid,0);
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
			PPSetPlayerPos(playerid,-1588.7915,691.6874,17.4568), PPSetPlayerFacingAngle(playerid,0.0);
			SetCameraBehindPlayer(playerid), yes = true;
		}
		else ErrorMessage(playerid, "{FF6347}У вас нет ключей от этой двери");
    }
    else if(IsPlayerInRangeOfPoint(playerid,1.0,-1588.8374,689.4076,17.4568) && GetPlayerVirtualWorld(playerid) == 210 && GetPlayerInterior(playerid) == 0) // Выход из SFPD на Балкон
	{
		if(GetPVarInt(playerid,"endorse") == 1 || PlayerInfo[playerid][pMember] == 1 || PlayerInfo[playerid][pLeader] == 1)
		{
			S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
			PPSetPlayerPos(playerid,-1594.8595,685.1586,17.1641), PPSetPlayerFacingAngle(playerid,180.0);
			SetCameraBehindPlayer(playerid), yes = true;
		}
		else ErrorMessage(playerid, "{FF6347}У вас нет ключей от этой двери");
    }
	else if(IsPlayerInRangeOfPoint(playerid,2.0,-2766.1516,375.5795,6.1447) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) // Вход в Правительство
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,189,0), PPSetPlayerInterior(playerid,0);
		Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
