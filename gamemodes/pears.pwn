    }
    else
    {
        if(BizzInfo[params[0]][bFreeze] == 1) return ErrorMessage(playerid, "{FF6347}Этот бизнес уже заморожен");
    	BizzInfo[params[0]][bFreeze] = 1, SaveBizz(params[0]);
    	format(string, sizeof(string), "~w~Biz %d: ~b~Freeze", params[0]), GameTextForPlayer(playerid, string, 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s заморозил бизнес № %d", PlayerInfo[playerid][pName], params[0]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("fbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Заморозил бизнес");

    }
	return 1;
}
CMD:unfbiz(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Вы не можете это сделать");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разморозить автослив бизнеса [ /unfbiz № Бизнеса ] (0 - Все бизнесы)");
    if(params[0] > 200 || params[0] < 0) return ErrorMessage(playerid, "{FF6347}Номер бизнеса от 1 до 200 (0 - Все бизнеса)");
	new string[84], unix = gettime(), quan;
    if(params[0] == 0)
    {
    	for(new b = 1; b < sizeof(BizzInfo); b++)
    	{
    		if(BizzInfo[b][bFreeze] == 1)
			{
			    quan ++;
			    BizzInfo[b][bPastime] = 0;
				BizzInfo[b][bData] = unix+2592000;
				BizzInfo[b][bFreeze] = 0;
				SaveBizz(b);
			}
    	}
    	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Нет ни одного замороженного бизнеса");
    	GameTextForPlayer(playerid, "~w~All biz: ~y~Unfreeze", 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s разморозил все бизнесы", PlayerInfo[playerid][pName]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("unfbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Разморозил все бизнесы");
    }
    else
    {
    	if(BizzInfo[params[0]][bFreeze] == 0) return ErrorMessage(playerid, "{FF6347}Этот бизнес не заморожен");
	 	BizzInfo[params[0]][bPastime] = 0;
		BizzInfo[params[0]][bData] = unix+2592000;
		BizzInfo[params[0]][bFreeze] = 0;
		SaveBizz(params[0]);
    	format(string, sizeof(string), "~w~Biz %d: ~y~Unfreeze", params[0]), GameTextForPlayer(playerid, string, 10000, 3);
    	format(string, sizeof(string), " [ ADM ]: %s разморозил бизнес № %d", PlayerInfo[playerid][pName], params[0]), ABroadCast(COLOR_ADM,string,1);
 		AdminLog("unfbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Разморозил бизнес");

    }
	return 1;
}
CMD:aselldom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Продать дом [ /aselldom ID ]");
    if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
    if(DomInfo[params[0]][dSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот дом никому не принадлежит");
    if(isarepairdom(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме кто-то занимается ремонтом. Продажа невозможна!");
    new string[144], giveplayerid;
    GameTextForPlayer(playerid, RusToGame("~w~Дом продан"), 10000, 3);
	format(string, sizeof(string), " [ ADM ]: %s продал дом № %d", PlayerInfo[playerid][pName],params[0]);
 	ABroadCast(COLOR_ADM,string,1);
    format(string, sizeof(string), "[ Мысли ADM ]: Дом принадлежал %s [User: %d]", DomInfo[params[0]][dVlad],DomInfo[params[0]][dSost]);
    SendClientMessage(playerid, COLOR_GREY, string);
    giveplayerid = ReturnUser(DomInfo[params[0]][dVlad], 1);
	if(IsOnline(giveplayerid))
	{
		if(OnlineInfo[giveplayerid][oLogged] == 1) format(string, sizeof(string), "* Администратор %s продал ваш Дом №%d.", PlayerInfo[playerid][pName], params[0]), SendClientMessage(giveplayerid, COLOR_LIGHTBLUE, string);
		PlayerInfo[playerid][pDom] = 0;
	}
    DomInfo[params[0]][dSost] = 0;
    DomInfo[params[0]][dPastime] = 0;
	DomInfo[params[0]][dData] = 0;
	DomInfo[params[0]][dLock] = 0;
	if(DomInfo[params[0]][dFam] >= 1) FamilyInfo[DomInfo[params[0]][dFam]][fDop5] = 0, SaveFamily(DomInfo[params[0]][dFam]), DomInfo[params[0]][dFam] = 0;
	DomInfo[params[0]][dSell] = 0;
	DomInfo[params[0]][dAcccupO] = 0, DomInfo[params[0]][dAcccupP] = 0, DomInfo[params[0]][dAcccupG] = 0, DomInfo[params[0]][dAcccupD] = 0, DomInfo[params[0]][dAccgar] = 0, DomInfo[params[0]][dAccdoo] = 0, DomInfo[params[0]][dAccfur] = 0;
	DomInfo[params[0]][dAccint] = 0;
	DomInfo[params[0]][dArest] = 0, DomInfo[params[0]][dFamcar] = 0;
	if(DomInfo[params[0]][dDescrip] == 2) DomInfo[params[0]][dDescrip] = 0;
	strmid(DomInfo[params[0]][dVlad], "none", 0, strlen("none"));
 	PlayerPlaySound(playerid, 1052, 0,0,0);
 	HouseLog(0, "aselldom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Администратор Продал Дом");
 	if(DomInfo[params[0]][dIngar] >= 1) DomInfo[params[0]][dIngar] = 0, DestroyDynamicPickup(DomGarage[params[0]]), DestroyDynamic3DTextLabel(IngarLabel[params[0]]);
 	UpdateDom(params[0]);
  	SaveDom(params[0]);
	return 1;
}
CMD:dompos(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить координаты дома [ /dompos ID ]");
	if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
 	new string[144];
	GetPlayerPos(playerid, DomInfo[params[0]][dKoordinatX], DomInfo[params[0]][dKoordinatY], DomInfo[params[0]][dKoordinatZ]);
	GetPlayerFacingAngle(playerid, DomInfo[params[0]][dKoordinatA]);
	format(string, sizeof(string), " [ ADM ]: %s перенёс дом № %d", PlayerInfo[playerid][pName],params[0]);
 	ABroadCast(COLOR_ADM,string,1);
 	if(DomInfo[params[0]][dIngar] >= 1)
 	{
		DomInfo[params[0]][dIngar] = 0;
		DestroyDynamicPickup(DomGarage[params[0]]);
		DestroyDynamic3DTextLabel(IngarLabel[params[0]]);
 	}
	UpdateDom(params[0]);
	SaveDom(params[0]);
	HouseLog(0, "t", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Перенёс Дом");
	HouseLog(0, "dominteraction", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Отключил Гараж");
	return 1;
}
CMD:rdomobject(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сбросить все объекты мебели в доме [ /rdomobject ID ]");
	if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
 	PlayerPlaySound(playerid,40405,0,0,0);
	new kolobj = 0, remobj = 0, string[144];
 	for(new oba = 0; oba < MAX_OBJECT_INT; oba++)
	{
		if(DomInfo[params[0]][dOmodel][oba] == 0) continue;
		if(IsAFrameObject(DomInfo[params[0]][dOmodel][oba])) continue;

		if(IsValidDynamicObject(DomInfo[params[0]][dObject][oba]))
		{
			kolobj ++;
			if(Streamer_HasIntData(STREAMER_TYPE_OBJECT, DomInfo[params[0]][dObject][oba], STREAMER_EDITABLE_DYNAMIC_OBJECT)
				&& Streamer_GetIntData(STREAMER_TYPE_OBJECT, DomInfo[params[0]][dObject][oba], STREAMER_EDITABLE_DYNAMIC_OBJECT) >= 1) remobj ++;
		}
	}
	if(kolobj == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме нет ни одного объекта");
	if(remobj >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом доме кто-то занимается ремонтом, полное удаление невозможно!");
	DP[0][playerid] = params[0];
	format(string, sizeof(string), "{FF6347}Внимание! Все предметы будут полностью уничтожены и НЕ окажутся в инвентаре\n\n{cccccc}В Доме № %d установлено %d предметов мебели\n{FF6347}Вы уверены, что хотите их удалить?",params[0],kolobj);
	ShowDialog(playerid,919,DIALOG_STYLE_MSGBOX,"{ff9000}Удаление Объектов",string,"Да","Нет");
	return 1;
}

alias:domname("dn")
CMD:domname(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 6) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new tmp[34];
    if(sscanf(params, "is[34]",params[0],tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить описание дома [ /domname № Текст ]");
    if(checksimvolfam(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хм... я пытаюсь указать в описании какие-то каракули... [ Запрещённый Символ ]");
    if(strlen(tmp) < 3 || strlen(tmp) > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Описание должно быть не больше 30-ти и не меньше 3-ёх символов..");
	if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	strmid(DomInfo[params[0]][dName], tmp, 0, strlen(tmp), 34);
	DomInfo[params[0]][dDescrip] = 1;
 	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s изменил описание дома дома № %d: {cccccc}%s", PlayerInfo[playerid][pName],params[0],tmp);
 	ABroadCast(COLOR_ADM,string,1);
 	UpdateDom(params[0]);
	SaveDom(params[0]);
	HouseLog(0, "domname", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, tmp);
	return 1;
}

alias:domclass("dc")
CMD:domclass(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить класс дома [ /domclass ID Класс ]");
    if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(params[1] > 5 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс дома 1 - 5");
 	
	new string[144];
	DomInfo[params[0]][dClass] = params[1];
	format(string, sizeof(string), " [ ADM ]: %s изменил класс дома № %d {cccccc}[Class: %d]", PlayerInfo[playerid][pName],params[0],params[1]);
 	ABroadCast(COLOR_ADM,string,1);
	SaveDom(params[0]);
	UpdateDom(params[0]);
	HouseLog(0, "domclass", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], params[1], "");
	return 1;
}
CMD:relsliv(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	new dkol, bkol, rkol;
	for(new d = 0; d < sizeof(DomInfo); d++)
 	{
		if(DomInfo[d][dSost] == 0 && (DomInfo[d][dTaxes] > 0 || DomInfo[d][dTaxday] > 0))
		{
			DomInfo[d][dTaxes] = 0;
			DomInfo[d][dTaxday] = 0;
			dkol++;
			SaveTax_Dom(d);
		}
	}
	for(new b = 0; b < sizeof(BizzInfo); b++)
	{
		if(BizzInfo[b][bSost] == 0 && (BizzInfo[b][bTaxes] > 0 || BizzInfo[b][bTaxday] > 0))
		{
			BizzInfo[b][bTaxes] = 0;
			BizzInfo[b][bTaxday] = 0;
			bkol++;
			SaveBizz(b);
		}
	}
	for(new r = 0; r < sizeof(ApartmentsRoom); r++)
 	{
 		if(ApartmentsRoom[r][aprStatus] == 1 && (ApartmentsRoom[r][aprTaxes] > 0 || ApartmentsRoom[r][aprTaxday] > 0))
		{
			ApartmentsRoom[r][aprTaxes] += Procent(0, Apartments[ApartmentsRoom[r][aprApartmentsID]][apPrice]);
			ApartmentsRoom[r][aprTaxday] ++;
			rkol++;
			SaveApartmentsRoom(r);
		}
 	} // квартиры

	if(dkol == 0 && bkol == 0 && rkol == 0) return ErrorMessage(playerid, "{FF6347}В всех свободных домах, бизнесах и квартирах нет неоплаченных налогов");
	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s сбросил налоги свободных %d домов, %d бизнесов и %d квартир", PlayerInfo[playerid][pName],dkol,bkol,rkol);
 	ABroadCast(COLOR_ADM,string,1);
	return 1;
}
CMD:slivall(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 23 && (strfind(PlayerInfo[playerid][pName],"Elon_Musk",true) != (-1) || strfind(PlayerInfo[playerid][pName],"Cardinale_Reveal",true) != (-1)) )
	{
		for(new b; b < sizeof(BizzInfo); b++)
		{
			BizzInfo[b][bPastime] = 0;
			BizzInfo[b][bData] = 0;
			BizzInfo[b][bSost] = 0;
			BizzInfo[b][bSell] = 0;
			if(BizzInfo[b][bFam] >= 1)
			{
				if(FamilyInfo[BizzInfo[b][bFam]][fSost] >= 1) famdeat_biz(BizzInfo[b][bFam], b), SaveFamily(BizzInfo[b][bFam]);
				BizzInfo[b][bFam] = 0;
			}
			BizzInfo[b][bArest] = 0;
			BizzInfo[b][bSchet] = 0;
			bizsbrosprava(b);
			strmid(BizzInfo[b][bVlad], "none", 0, strlen("none"), 24);
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			if(BizzInfo[b][bLab] == 1) UpdateBizLabel(b, BizzInfo[b][bLab]);
			SaveBizz(b);
		}
		for(new d; d < sizeof(DomInfo); d++)
		{
			DomInfo[d][dSost] = 0;
			DomInfo[d][dPastime] = 0;
			DomInfo[d][dData] = 0;
			DomInfo[d][dLock] = 0;
			if(DomInfo[d][dFam] >= 1) FamilyInfo[DomInfo[d][dFam]][fDop5] = 0, SaveFamily(DomInfo[d][dFam]), DomInfo[d][dFam] = 0;
			DomInfo[d][dSell] = 0;
			DomInfo[d][dAcccupO] = 0, DomInfo[d][dAcccupP] = 0, DomInfo[d][dAcccupG] = 0, DomInfo[d][dAcccupD] = 0, DomInfo[d][dAccgar] = 0, DomInfo[d][dAccdoo] = 0, DomInfo[d][dAccfur] = 0;
			DomInfo[d][dAccint] = 0;
			DomInfo[d][dArest] = 0, DomInfo[d][dFamcar] = 0;
			if(DomInfo[d][dDescrip] == 2) DomInfo[d][dDescrip] = 0;
			strmid(DomInfo[d][dVlad], "none", 0, strlen("none"));
			PlayerPlaySound(playerid, 1052, 0,0,0);
			//HouseLog(0, "aselldom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], d, 0, "Администратор Продал Дом");
			if(DomInfo[d][dIngar] >= 1) DomInfo[d][dIngar] = 0, DestroyDynamicPickup(DomGarage[d]), DestroyDynamic3DTextLabel(IngarLabel[d]);
			UpdateDom(d);
			SaveDom(d);
		}

		// Сливаем все квартиры
		for(new r = 0; r < sizeof(ApartmentsRoom); r++)
 		{
			SlivApartments(r);
		}

		new string[80];
		format(string, sizeof(string), " [ ADM ]: %s слил все дома, бизнесы и квартиры",PlayerInfo[playerid][pName]);
  		ABroadCast(COLOR_ADM,string,1);
		AdminLog("slivall", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	}
	return 1;
}

CMD:domgetc(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выполнить это действие");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть список домов по классам [ /domgetc Класс ]");

	DP[0][playerid] = 0;
	DP[1][playerid] = params[0];
	ShowDomGetC(playerid, params[0]);
	return 1;
}

stock ShowDomGetC(playerid, domClass)
{
	new minDom = DP[0][playerid];
	new str[214], sctring[4096], kol, maxstroke = 60;
	format(str,sizeof(str),"{cccccc}№ Дома Класс\t{99ff66}Гос Цена\t{ffcc00}Gold Цена\n"), strcat(sctring,str);
	for(new d = minDom; d < sizeof(DomInfo); d++)
 	{
		if(kol >= maxstroke) break;
		if(DomInfo[d][dClass] == domClass) 
		{
			if(DomInfo[d][dGold] > 0) format(str,sizeof(str),"{cccccc}№ %d\t{99ff66}%d$ [ %s ]\t{ffcc00}%dG\n",d,DomInfo[d][dSost2],get_k(DomInfo[d][dSost2]),DomInfo[d][dGold]);
			else format(str,sizeof(str),"{cccccc}№ %d\t{99ff66}%d$ [ %s ]\t \n",d,DomInfo[d][dSost2],get_k(DomInfo[d][dSost2]));
			strcat(sctring,str);
			DP[0][playerid] = d;
			kol ++;
		}
	}

	new string[60];
	format(string,sizeof(string),"{ff9000}Дома Класса %d [%d]", domClass, kol);
	ShowDialog(playerid,573,DIALOG_STYLE_TABLIST_HEADERS,string,sctring,"Далее","Выход");
	return 1;
}

CMD:domup(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Повысить стоимость домов по классам [ /domup Класс Сумма ]");
    if(params[0] > 5 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс дома 1 - 5");
	if(params[1] > 1000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сумма повышения не меньше 1$ и не больше 1.000.000$");
 	for(new d = 0; d < sizeof(DomInfo); d++)
	{
	    if(DomInfo[d][dClass] != params[0]) continue;
		DomInfo[d][dSost2] += params[1];
		UpdateDom(d);
		SaveDom(d);
	}
	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s повысил стоимость домов %d класса {cccccc}[+%d$]", PlayerInfo[playerid][pName],params[0],params[1]);
 	ABroadCast(COLOR_ADM,string,1);
 	AdminLog("domup", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Повысил стоимость домов");
	return 1;
}
CMD:domdown(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Понизить стоимость домов по классам [ /domdown Класс Сумма ]");
    if(params[0] > 5 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс дома 1 - 5");
	if(params[1] > 1000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сумма понижения не меньше 1$ и не больше 1.000.000$");
 	for(new d = 0; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dClass] != params[0]) continue;
		if(DomInfo[d][dSost2]-params[1] <= 1) DomInfo[d][dSost2] = 1;
		DomInfo[d][dSost2] -= params[1];
		UpdateDom(d);
		SaveDom(d);
	}
	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s понизил стоимость домов %d класса {cccccc}[-%d$]", PlayerInfo[playerid][pName],params[0],params[1]);
 	ABroadCast(COLOR_ADM,string,1);
 	AdminLog("domdown", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Понизил стоимость домов");
	return 1;
}

alias:domprice("dp")
CMD:domprice(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить стоимость дома [ /domprice ID Цена ]");
	if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(params[1] > 100000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Цена дома не меньше 1$ и не больше 100.000.000$");
 	new string[144];
	DomInfo[params[0]][dSost2] = params[1];
	format(string, sizeof(string), " [ ADM ]: %s изменил стоимость дома № %d {cccccc}[%d$] [%s]", PlayerInfo[playerid][pName],params[0],params[1],get_k(params[1]));
 	ABroadCast(COLOR_ADM,string,1);
 	UpdateDom(params[0]);

	new string_mysql[100];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_dom` SET `Sost2`='%d' WHERE `Ids`='%d'",params[1],params[0]);
	query_empty(pearsq, string_mysql);

	format(string, sizeof(string), "Изменил стоимость дома № %d",params[0]);
	AdminLog("domprice", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], string);
	HouseLog(0, "domprice", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], params[1], "");
	return 1;
}

