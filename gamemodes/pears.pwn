			if(OrganInfo[g][gOrderStatus] == 1) return ErrorText(playerid, "{FF6347}Вы не можете редактировать активный заказ"), OrderEscort(playerid, g);
		    if(OrganInfo[g][gOrder][i] == 0) return ErrorText(playerid, "{FF6347}В слоте нет заказа"), OrderEscort(playerid, g);
		    if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Предмет нельзя удалить, доставку выполняет NGSA"), OrderEscort(playerid, g);
            delproductEscort(g, i);
