		/*for(new aprid; aprid < 10; aprid++)
		{
			if(ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][aprid]][aprOwn] == PlayerInfo[playerid][pID]) continue;
			else PlayerInfo[playerid][pApartmentsRoom][aprid] = 0;
		}*/
 
		new string_mysql[256];
		if (IsPlayerConnected(playerid)) {
			// Загружаем инвентарь
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `pp_igroki_inventory` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, string_mysql, "OnPlayerInventoryLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
			
			new Aks = HasABustAks(playerid,1);
			if(Aks != -1) 
			{
				new backpackid = PlayerInfo[playerid][pOdetQara][Aks];
				if(backpackid == 0)
				{
					mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `backpacks` SET `b_slot_0` = NULL");
					mysql_tquery(pearsq, string_mysql, "Call_getidBackPack", "dd", playerid,Aks);
				}
				else
				{
					mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `backpacks` WHERE `backpackid` = '%d'", backpackid);
					mysql_tquery(pearsq, string_mysql, "OnPlayerBackPackLoad", "ddd",playerid, g_MysqlRaceCheck[playerid],Aks);
				}
			}
			// Создаем заявку в суд
			if(PlayerInfo[playerid][pCourtsStatus] == 1) CourtCreateOrder(playerid, false);

			// Загружаем сохранения квестов
			LoadPlayerQuest(playerid);

			// Загружаем настройки рации
			OnPlayerLoadTransmitter(playerid);

			// Загружаем оружие в руках
			OnPlayerLoadWeapon(playerid);

			// Загружаем ловушку для акулы из базы
			OnPlayerLoadSharkTrap(playerid);

			// Загружаем забаненные команды
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `pp_igroki_bancmds` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, string_mysql, "OnPlayerBannedCommandsLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Загружаем прочие данные об игроке
			cache_get_value_name(0, "PameText", PameText[playerid], 84);
			cache_get_value_name(0, "PameText2", PameText2[playerid], 84);
			cache_get_value_name_int(0, "Hit", gHitMoney[playerid]);
			cache_get_value_name_int(0, "Anima", AnimInfo[0][playerid]);
			cache_get_value_name_int(0, "Animb", AnimInfo[1][playerid]);
			cache_get_value_name_int(0, "Animc", AnimInfo[2][playerid]);
			cache_get_value_name_int(0, "Animd", AnimInfo[3][playerid]);
			cache_get_value_name_int(0, "Anime", AnimInfo[4][playerid]);
			cache_get_value_name_int(0, "Animf", AnimInfo[5][playerid]);
			cache_get_value_name_int(0, "Pame", Pame[playerid]);
			cache_get_value_name_int(0, "Fame", Fame[playerid]);
			
			// Сносим RP описания админам
			if (PlayerInfo[playerid][pSoska] > 0 && PlayerInfo[playerid][pSoska] < 25)
			{
				Pame[playerid] = false;
				PameText[playerid][0] = EOS;
				PameText2[playerid][0] = EOS;
			}

			cache_get_value_name_int(0, "pManiacCD", PlayerInfo[playerid][pManiacCD]);
			cache_get_value_name_int(0, "pGymUnix", PlayerInfo[playerid][pGymUnix]);
			cache_get_value_name_int(0, "pDatabaseActive", PlayerInfo[playerid][pDatabaseActive]);
			cache_get_value_name_int(0, "pCDVillage", PlayerInfo[playerid][pCDVillage]);
			cache_get_value_name_int(0, "pCDKatana", PlayerInfo[playerid][pCDKatana]);
			cache_get_value_name_int(0, "pCDAd", PlayerInfo[playerid][pCDAd]);
			cache_get_value_name_int(0, "pCDGraves", PlayerInfo[playerid][pCDGraves]);
			cache_get_value_name_int(0, "pMenstrDay", PlayerInfo[playerid][pMenstrDay]);
			cache_get_value_name_int(0, "pMenstrProkl", PlayerInfo[playerid][pMenstrProkl]);
			cache_get_value_name_int(0, "pPackInteriors", PlayerInfo[playerid][pPackInteriors]);

			Unlogged[playerid] = 361;
			printf("OnPlayerLoad(%s) Аккаунт Найден", PlayerInfo[playerid][pName]);
			gWindowPass[playerid] = 1; // Так как мы авторизовываемся для пароля ставим Window 1
		}

		//============= Корректировки ===============
		// Если игрок в FBI под прикрытием и имеет подфракцию FBI, выдаём корректный ранг подфракции FBI
		if(PlayerInfo[playerid][pFbi] > 0
			&& PlayerInfo[playerid][pDivision][1] > 0
			&& PlayerInfo[playerid][pDivRank][1] == 0) PlayerInfo[playerid][pDivRank][1] = PlayerInfo[playerid][pFbi];
		
		// Если игрок в орг и в подфракции и не имеет ранга подфракции, выдаём ранг из обычной организации
		if(PlayerInfo[playerid][pMember] > 0
			&& PlayerInfo[playerid][pDivision][0] > 0 
			&& PlayerInfo[playerid][pDivRank][0] == 0) PlayerInfo[playerid][pDivRank][0] = PlayerInfo[playerid][pRank];
	}
	else
	{
		printf("OnPlayerLoad(%s) Аккаунт Отсутствует", PlayerInfo[playerid][pName]);
		gWindowPass[playerid] = 2;
	}
	
	if (IsPlayerConnected(playerid)) {
		if(IsPlayerMobile(playerid)) // Мобила
		{
			Device[playerid] = 1;
			for(new pdra = 0; pdra < 14; pdra++) PlayerInfo[playerid][pDrawPos_X][pdra] = 0.0, PlayerInfo[playerid][pDrawPos_Y][pdra] = 0.0, PlayerInfo[playerid][pDrawSize_X][pdra] = 0.0, PlayerInfo[playerid][pDrawSize_Y][pdra] = 0.0;
			PlayerInfo[playerid][pTypeSpeed] = 1;
			PlayerInfo[playerid][pAspecBlock3] = false;
		}
		else Device[playerid] = 0; // ПК

		go_dalee_autorize(playerid);

		GetPlayerPos(playerid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
		TextDrawHideForPlayer(playerid, Chernifon);
		S_SetPlayerVirtualWorld(playerid, playerid + 1, 0);
		ACSetPlayerHealth(playerid, 90);

		DeleteObject(playerid);
		PlayerPlaySound(playerid,17803,0,0,0);
	}
	return true;
}
stock go_dalee_autorize(playerid)
{
	if(gWindowPass[playerid] == 1)
	{
	    new loginmsg[144];
	    if(PlayerInfo[playerid][pBdPoletDayz] == 0)
		{
			new senderip[24], buffer[64], unixtime = gettime();
 			GetPlayerIp(playerid, senderip, sizeof(senderip));
    		GetPlayerClientID(playerid, buffer);

			/*
			if(strcmp(PlayerInfo[playerid][pSafeIP],senderip, true ) != 0) SendClientMessageToAll(-1, "проверка автологина не пройдена IP");
			else if(strcmp(PlayerInfo[playerid][pGpci],buffer, true ) != 0) SendClientMessageToAll(-1, "проверка автологина не пройдена GPCI");
			else if(unixtime >= PlayerInfo[playerid][pSafeUnix]) SendClientMessageToAll(-1, "проверка автологина не пройдена UNIX");
			*/

			if(strcmp(PlayerInfo[playerid][pSafeIP],senderip, true ) != 0 || strcmp(PlayerInfo[playerid][pGpci],buffer, true ) != 0 || unixtime >= PlayerInfo[playerid][pSafeUnix]) // Не вошли
			{
	 			format(loginmsg,sizeof(loginmsg),"{cccccc}Привет, {ff9000}%s\nВведите ваш пароль\n\n{cccccc}Если вы забыли пароль, нажмите ESC или Отмена",PlayerInfo[playerid][pName]);
				if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,1,DIALOG_STYLE_PASSWORD,"{ff9000}Авторизация",loginmsg,"Далее","Отмена");
				else ShowDialog(playerid,1,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",loginmsg,"Далее","Отмена");
			}
			else
			{
				format(loginmsg,sizeof(loginmsg),"{cccccc}Привет, {ff9000}%s\nНажмите Enter или кнопку Далее",PlayerInfo[playerid][pName]);
	   		  	ShowDialog(playerid,220,DIALOG_STYLE_MSGBOX,"{ff9000}Авторизация",loginmsg,"Далее","Отмена");
			}
		}
		else
		{
 			format(loginmsg,sizeof(loginmsg),"{cccccc}Привет, {ff9000}%s\nВведите ваш пароль\n\n{cccccc}Если вы забыли пароль, нажмите ESC или Отмена",PlayerInfo[playerid][pName]);
			if(PlayerInfo[playerid][pTypoihyi] == 0) ShowDialog(playerid,1,DIALOG_STYLE_PASSWORD,"{ff9000}Авторизация",loginmsg,"Далее","Отмена");
			else ShowDialog(playerid,1,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",loginmsg,"Далее","Отмена");
		}
	}
	else if(gWindowPass[playerid] == 2) registerhelp(playerid, 0);
	return 1;
}

