	case 495: // Выбрасываем предмет из инвентаря
	{
	    if(response)
	    {
	    	Veshi[playerid] = 0;
	    	i_resetveshi(playerid);
	    	i_resettabs(playerid);
	    	new inva = DP[0][playerid];
			new fpick = PlayerInfo[playerid][pInven][inva], fquan = PlayerInfo[playerid][pInvenQuan][inva], fpara = PlayerInfo[playerid][pInvenPara][inva], fqara = PlayerInfo[playerid][pInvenQara][inva], thingType = PlayerInfo[playerid][pInvenType][inva], thingPack = PlayerInfo[playerid][pInvenPack][inva];
			if(fpick == 0) return 1;

			if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerSpeed(playerid) > 3 || MPGO[playerid] > 0 || gSkafandr[playerid] > 0 || gFormavvs[playerid] > 0
			|| GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1 || Sleep[playerid] >= 1 || SleepRP[playerid] >= 1
			|| CnnVed[playerid] >= 11 || Ash[playerid] >= 1 || GetPlayerVirtualWorld(playerid) == 2001 || GetPVarInt(playerid, "SelectCharPlace") >= 1
			|| HospBed[playerid] >= 0 && HospBed[playerid] <= 25) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас или здесь выбросить предмет\n{cccccc}На ходу, в транспорте, на мероприятии, в казино, в форме или ваш персонаж занят");

			// Шкатулка нельзя выбрасывать на 3 уровне и ниже
			if(IsNotGiveCase(playerid, thingPack)) return i_resetveshi(playerid);

			if(IsPlayerInRangeOfPoint(playerid,3.0,1327.3071, 1555.0947, 1114.9565) && GetPlayerVirtualWorld(playerid) == WORLD_SKUPSHIK && GetPlayerInterior(playerid) == INT_SKUPSHIK)
			{
				new input;
				if(getThingPriceGos(fpick, thingType) == -1) return ErrorMessage(playerid, "{ff6347}Скупщик не покупает данный предмет"), i_resetveshi(playerid);
				if(thingPack != 0) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Он принимает только распакованные предметы."),i_resetveshi(playerid),Veshi[playerid] = 0;
				if(SkupshikListItem(fpick,thingType,fpara) != 1) 
				{
					Veshi[playerid] = 0;
					if(fpara < gettime() && PerishableThing(fpick,thingType)) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Его срок годности истёк."),i_resetveshi(playerid);
					//else if(thingType != 0) return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику. Скупщик скупает только обычные предметы"),i_resetveshi(playerid);
					else return ErrorText(playerid,"{ff6347} Данный предмет нельзя продать скупщику"),i_resetveshi(playerid);
				}
				if(CheckThingQuan(fpick) == 1 && thingType == 0)
				{
				    input = strval(inputtext);
   					if(sscanf(inputtext, "i", input)) return ErrorMessage(playerid, "{FF6347}Вы ничего не ввели");
   					if(input < 1 || input > 1000000) return ErrorMessage(playerid, "{FF6347}Не меньше 1 и не больше 1.000.000");
   					if(fquan < input) return ErrorMessage(playerid, "{FF6347}В этой ячейке нет такого количества");
				}
				else
				{
					input = 1;
					if(thingType == 0) i_takehands(playerid, fpick);
				}
				new price = DP[1][playerid] * input;
				TakeInvent(playerid, fpick, input, thingType, inva);
				PlayerPlaySound(playerid,31200,0,0,0);

				new fees;
				new money_to_destroy;
				new to_pay = ComputeWithTwoShares(price,
					.first_out = fees,
					.second_out = money_to_destroy,
					.first_prop = PercentageToMultiplier(8), // 8% в казну
					.second_prop = PercentageToMultiplier(2) // 2% на уничтожение
				);
				new final_fees = fees + money_to_destroy;
				oGivePlayerMoney(playerid,to_pay);
				PutMoneyToTreasury(fees, "Налог за продажу скупщику");
				format(string,sizeof(string),"Продал предмет %s, в количестве %d",GetNameThing(0, fpick, thingType, thingPack),input);
				if(IsABackPack(fpick) && fqara != 0) DeleteBackPack(fqara);
				MoneyLog("skupshik", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", to_pay, string);
				return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я продал скупщику предмет %s, в количестве %d, за %d$ [Налог: -%d$]",GetNameThing(0, fpick, thingType, thingPack),input,to_pay,final_fees);
			}

            if(thingType == 0 && thingPack == 0)
			{
			    if(CheckThingQuan(fpick) == 1)
				{
				    new input = strval(inputtext);
   					if(sscanf(inputtext, "i", input)) return ErrorMessage(playerid, "{FF6347}Вы ничего не ввели");
   					if(input < 1 || input > 1000000) return ErrorMessage(playerid, "{FF6347}Не меньше 1 и не больше 1.000.000");
   					if(fquan < input) return ErrorMessage(playerid, "{FF6347}В этой ячейке нет такого количества");
   					
   					TakeInvent(playerid, fpick, input, thingType, inva);
   					if(fpick == 9) SetPlayerChatBubble(playerid,"выливает топливо из канистры",COLOR_PURPLE,20.0,7000);
					else if(fpick == 61) SetPlayerChatBubble(playerid,"выливает вещество из контейнера",COLOR_PURPLE,20.0,7000);
					else
					{
						format(string, sizeof(string), "выбрасывает [ %s ]",GetNameThing(0, fpick, thingType, thingPack)), SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,7000);
						Throw(playerid, fpick, input, fpara, fqara, thingType, thingPack);
					}
					PlayerPlaySound(playerid,31200,0,0,0);
   					return 1;
				}
			}
			
			mysql_tquery(pearsq, "START TRANSACTION;");
			format(string, sizeof(string), "выбрасывает [ %s ]",GetNameThing(0, fpick, thingType, thingPack)), SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,7000);
			PlayerPlaySound(playerid,31200,0,0,0);
			
			TakeInvent(playerid, fpick, fquan, thingType, inva); // Знаем ячейку (потому там может быть предмет в упаковке)
			if(!NotGiveThing(fpick, thingType, fquan, thingPack)) // Если выбрасывать нельзя, то предмет не создаём на земле
			{
				Throw(playerid, fpick, fquan, fpara, fqara, thingType, thingPack);
			}
			if(thingType == 0) i_takehands(playerid, fpick);

			// Пересчитываем выданный транспорт на руках
			if(thingPack == 0) TakeCalculateVehicleLimited(fpick, thingType);
			mysql_tquery(pearsq, "COMMIT;");
		}
		else Veshi[playerid] = 0, i_resetveshi(playerid);
	}
