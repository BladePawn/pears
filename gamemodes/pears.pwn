	case 650:
	{
		if(response)
		{
			if(!checkAccessMyVehicle(playerid)) return 1;
			new v = DP[2][playerid];
			SuccessMessage(playerid, "{99ff66}Вы отозвали ключи от личного транспорта");
			VehInfo[v][vKey] = 0;
			VehInfo[v][vKeyUnix] = 0;
			SaveCar(v);

			if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) // Если владелец не за рулём транспорт - глушим наш транспорт (Чтобы игрок не съебался с ним)
			{
				GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
				SetVehicleParamsEx(v, false, false, alarm, doors, bonnet, boot, objective);
				VehInfo[v][vEngine] = 0, VehInfo[v][vLights] = 0;
			}

			new vehicleid;
			foreach (Player, i)
			{
				if(OnlineInfo[i][oLogged] == 0) continue;
				if(PlayerInfo[i][pKeyVehID] == 0) continue;

				// Выгружаем транспорт с ключам
				if(v == PlayerInfo[i][pKeyVehID]) 
				{
					if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
					{
						vehicleid = GetPlayerVehicleID(i);
						if(vehicleid == v)
						{
							PPSetPlayerPos(i, Protect_X[i], Protect_Y[i], Protect_Z[i]+4);
							PlayerPlaySound(i, 4601, 0,0,0);
						}
					}
    	
					if(PlayerInfo[i][pKeyVeh][1] == PlayerInfo[playerid][pID])
					{
						PlayerInfo[i][pKeyVeh][0] = 0;
						PlayerInfo[i][pKeyVeh][1] = 0;
						PlayerInfo[i][pKeyVeh][2] = 0;
						PlayerInfo[i][pKeyVeh][3] = 0;
						SaveKeyVehicle(i);
					}
					PlayerInfo[i][pKeyVehID] = 0;
					format(string, sizeof(string), "[ Мысли ]: %s отозвал%s ключи от %s", rpplayername(playerid), gender(playerid), GetVehicleName(VehInfo[v][vModel]));
					SendClientMessage(i, COLOR_GREY, string);
					ShowDialog(i,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Владелец транспорта отозвал ключи","*","");
				}
			}
		}
		else slcar(playerid, DP[0][playerid]);
	}
	case 651:
	{
		if(response)
		{
			if(listitem < 0 || listitem > 9) return 0;
			if(!checkAccessMyVehicle(playerid)) return 1;

			new v = DP[2][playerid];
			new giveplayerid = ReturnUser(ListName[playerid]);
			if(!IsOnline(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Игрока нет в сети");
			if(!ProxDetectorS(3.0, playerid, giveplayerid) || GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы далеко от игрока");
	 		if(playerid == giveplayerid) return ErrorMessage(playerid, "{FF6347}Вы не можете передавать ключи себе");

			new unix = gettime();
			if(PlayerInfo[giveplayerid][pKeyVeh][0] > 0 && PlayerInfo[giveplayerid][pKeyVeh][3] > unix) return ErrorMessage(playerid, "{FF6347}У этого игрока уже есть ключи от транспорта");

			new time;
			if(listitem == 0) time = 600; // 10 min
			else if(listitem == 1) time = 1800; // 30 min
			else if(listitem == 2) time = 3600; // 1 hour
			else if(listitem == 3) time = 14400; // 4 hour
			else if(listitem == 4) time = 28800; // 8 hour
			else if(listitem == 5) time = 86400; // 1 day
			else if(listitem == 6) time = 259200; // 3 day
			else if(listitem == 7) time = 604800; // 7 day
			else if(listitem == 8) time = 1209600; // 14 day
			else if(listitem == 9) time = 2592000; // 30 day

			VehInfo[v][vKey] = PlayerInfo[giveplayerid][pID];
			VehInfo[v][vKeyUnix] = unix + time;
			SaveCar(v);

			new slotId = DP[0][playerid] - 1;
			PlayerInfo[giveplayerid][pKeyVeh][0] = VehInfo[v][vModel];
			PlayerInfo[giveplayerid][pKeyVeh][1] = PlayerInfo[playerid][pID];
			PlayerInfo[giveplayerid][pKeyVeh][2] = slotId + 1;
			PlayerInfo[giveplayerid][pKeyVeh][3] = unix + time;
			PlayerInfo[giveplayerid][pKeyVehID] = v;
			SaveKeyVehicle(giveplayerid);

			format(string, sizeof(string), "[ Мысли ]: Я передал%s %s ключи от {ff9000}%s", gender(playerid), rpplayername(giveplayerid), GetVehicleName(VehInfo[v][vModel]));
			SendClientMessage(playerid, COLOR_GREY, string);

			format(string, sizeof(string), "[ Мысли ]: %s передал%s мне ключи от {ff9000}%s {444444}[ Y >> Транспорт ]", rpplayername(playerid), gender(playerid), GetVehicleName(VehInfo[v][vModel]));
			SendClientMessage(giveplayerid, COLOR_GREY, string);

			PlayerPlaySound(giveplayerid,40405,0,0,0);
          	format(string, sizeof(string), "* %s передаёт %s ключи от личного транспорта", rpplayername(playerid), rpplayername(giveplayerid));
      		ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		}
		else slcar(playerid, DP[0][playerid]);
	}
