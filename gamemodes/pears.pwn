	// Mafia War
	case 805: // 2) Выбираем вариант ставки
	{
		if(response)
		{
			if(listitem == 0) ShowDialog(playerid,746,DIALOG_STYLE_INPUT,"{ff9000}Mafia","{cccccc}Введите номер бизнеса в качестве ставки на стрелу","Принять","Отмена");
			if(listitem == 1) showDialogBetMoneyMafia(playerid);
		}
		else CancelSelectMafWar(playerid);
	}
	case 746: // 3) Выбрали Бизнес
	{
		if(response)
		{
			if(strlen(inputtext))
			{
		    	new biz = strval(inputtext);
				SelectBizMafiaWar(playerid, Qwerty[2][playerid], biz);
			}
			else ShowDialog(playerid,746,DIALOG_STYLE_INPUT,"{ff9000}Mafia","{ff0000}Введите номер бизнеса в качестве ставки на стрелу","Принять","Отмена");
		}
	}
	case 806: // 3) Выбрали Деньги
	{
		if(response) // Деньги
		{
			if(strlen(inputtext))
			{
				new money = strval(inputtext);
				SelectMoneyMafiaWar(playerid, Qwerty[2][playerid], money);
			}
			else showDialogBetMoneyMafia(playerid);
		}
	}
	case 807: // 4) Подтверждение
	{
		if(response) // Начинаем Отсчёт до Битвы (Готовность 2 минуты)
		{
			new giveplayerid = Qwerty[2][playerid];
			if(CheckMafiaPermission(playerid, giveplayerid)) return 1;

			new g = fraction(playerid);
			new hg = fraction(giveplayerid);

			format(string, sizeof(string), "[ Мысли ]: Я принимаю условия %s",frakName[hg]);
			SendClientMessage(playerid,COLOR_GREY,string);
			format(string, sizeof(string), "принимает условия %s",frakName[hg]);
			SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,8000);
			format(string, sizeof(string), "* %s принимает условия %s.", playername(playerid),frakName[hg]);
			ProxDetector(25.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

			// Врубаем Территорию и Готовность
			PlayFrak(hg, 3201);
			PlayFrak(g, 3201);

			new time = 30;
			if(server == 0) time = 10; // Для тестового сервера время подготовки 10 сек

			// Оповещение  Защищающимся
			format(string, sizeof(string), "{0088ff}[ Mafia War ]: Внимание! {ffcc66}У вас есть %d секунд до начала битвы", time);
			SendRadioMessage(hg,COLOR_LIGHTRED,string);
			format(string,sizeof(string),"{0088ff}[ Mafia War ]: {ffcc66}%s vs %s",frakeasyName[g],frakeasyName[hg]);
			SendRadioMessage(hg,COLOR_LIGHTRED,string);

			// Оповещение Нападающим
			format(string, sizeof(string), "{0088ff}[ Mafia War ]: Внимание! {ffcc66}У вас есть %d секунд до начала битвы", time);
			SendRadioMessage(g,COLOR_LIGHTRED,string);
			format(string,sizeof(string),"{0088ff}[ Mafia War ]: {ffcc66}%s vs %s",frakeasyName[g],frakeasyName[hg]);
			SendRadioMessage(g,COLOR_LIGHTRED,string);
			
			OrgLog(g, "mafia", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], hg, "");
			OrgLog(hg, "mafia", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], g, "");

			// Создаём Зону
			new Float:X, Float:Y, Float:Z;
			GetPlayerPos(playerid, X, Y, Z);
			MafGz[0][mID] = GangZoneCreate(X-100.0,Y-100.0,X+100.0,Y+100.0);
			MafGz[0][mCoords][0] = X-100.0;
			MafGz[0][mCoords][1] = Y-100.0;
			MafGz[0][mCoords][2] = X+100.0;
			MafGz[0][mCoords][3] = Y+100.0;
			MafGz[0][mZ] = Z;
			CreateMafWarZone(0); // Создаём динамическую зону мафиозной стрелы

			MafGz[0][mTimer] = time; // 30 секунд подготовка
			MafGz[0][mNapad] = g; // ID Нападающей мафии
			MafGz[0][mZashita] = hg; // ID Защищающейся мафии
			GangZoneShowForAll(MafGz[0][mID],0xff0000AA);
			MafGz[0][mKoln] = Qwerty[3][playerid]; // Ставка нападающих
			MafGz[0][mKolz] = Qwerty[3][giveplayerid]; // Ставка защищающихся
			// Обнуляем Зону
			MafGz[0][mKilln] = 0;
			MafGz[0][mKillz] = 0;
			// Тип битвы ставим
			MafGz[0][mVidn] = Qwerty[4][playerid];
			MafGz[0][mVidz] = Qwerty[4][giveplayerid];
			// Показываем текстдравы игрокам
			
			MafGz[0][mStat] = 1; // Статус подготовки
			
			foreach(Player,i)
			{
				if(gMifga[i] == 9999 && OnlineInfo[i][oLogged] == 1)
				{
					if(fraction(i) == MafGz[0][mNapad]) GiveMaf(i, 0, MafGz[0][mZashita]);
					if(fraction(i) == MafGz[0][mZashita]) GiveMaf(i, 0, MafGz[0][mNapad]);
				}
			}
		}
		else CancelSelectMafWar(playerid);
	}

