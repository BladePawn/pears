			{
				const price = 1000;
 				if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо..");
				if(SkyPause > gettime()) return format(string,sizeof(string),"[ Мысли ]: Аэротруба сейчас занята [ Через %d сек ]", SkyPause-gettime()),SendClientMessage(playerid, COLOR_GREY, string);
				if(oGetPlayerMoney(playerid) < price) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает денег");
				oGivePlayerMoney(playerid, -price), PutMoneyToTreasury(price, "Оплата аэротрубы");
				MoneyLog("buy", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -price, "Оплата аэротрубы");
				Protect_GiveWeapons(playerid, 46, 1, 0, 0);
				SetPlayerArmedWeapon(playerid, WEAPON:0);
				PPSetPlayerPos(playerid, 877.5769,-1961.6753,4.3585), PPSetPlayerFacingAngle(playerid, 0.0);
				ClearAnimations(playerid);
				ApplyAnimation(playerid,"PED","FALL_skyDive",4.0,true,true,true,false,false,SYNC_ALL);
				SkyStat[playerid] = 1;
				SkyTimer[playerid] = SetTimerEx("skydive", 50, true, "d", playerid);
				SkyPause = gettime()+15;
				PlayerPlaySound(playerid, 40408, 0,0,0);
				if(PlayerInfo[playerid][pAchieve][104] == 0) AchievePlayer(playerid, 104, 1);
			}
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нет, я очкую..");
	}
