		format(str,sizeof(str),"{ff9000}Статистика {666666}| Война Банд № %d [ %02d.%02d.%d ]", ServerInfo[41], day, month, year);
		ShowDialog(playerid,1742,DIALOG_STYLE_TABLIST_HEADERS, str, sctring,"*","");
	}
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу посмотреть статистику банд");
