forward Call_unban(playerid, str_name[]);
public Call_unban(playerid, str_name[])
{
	new rows,datad1,datad2,f_str[164];
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid,string[144];
		cache_get_value_name_int(0, "user_id", datadid);
	    cache_get_value_name_int(0, "Banned", datad1);
	    cache_get_value_name_int(0, "BanMonzz", datad2);
	    if(datad1 >= 1) // Если аккаунт забанен, только тогда мы его можем разбанить.
        {
          mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Banned` = '0', `BanDayz` = '0', `BanMonzz` = '%d' WHERE `Name` = '%e'", datad2-=1, str_name);
          query_empty(pearsq, f_str);
          format(string, sizeof(string), " [ ADM ]: %s разбанил %s",PlayerInfo[playerid][pName], str_name);
          ABroadCast(COLOR_ADM,string,1);
          format(string,sizeof(string),"[ Мысли ]: Аккаунт {ff9000}%s {cccccc}разбанен",str_name);
          SendClientMessage(playerid,COLOR_GREY,string);
          AdminLog("unban", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
          // Разбаниваем IP
		  new datad3[24];
		  cache_get_value_name(0, "Plaip", datad3, 24);
		  mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_banip` WHERE `ip` = '%e'", datad3);
		  mysql_tquery(pearsq, string, "Call_unbanip", "dsd", playerid, datad3,1);
        }
        else
        {
			format(string,sizeof(string),"{cccccc}[ Мысли ]: Аккаунт [ {ff0000}%s {cccccc}] не забанен!",str_name);
			SendClientMessage(playerid,COLOR_GREY,string);
			return 1;
        }
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:unban(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "s[144]",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разбанить игрока [ /unban Nick_Name ]");
	if(CheckRP_Nickname(params[0]))
	{
	    new string[200];
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Banned, BanMonzz, Plaip FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
		mysql_tquery(pearsq, string, "Call_unban", "ds", playerid, params[0]);
		return 1;
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это явно не ник нейм игрока. Пример: Lol_Lolkin");
	return 1;
}
forward Call_undel(playerid, str_name[]);
public Call_undel(playerid, str_name[])
{
	new rows,datad1,datad2,f_str[164];
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid,string[144];
		cache_get_value_name_int(0, "user_id", datadid);
	    cache_get_value_name_int(0, "Banned", datad1);
	    cache_get_value_name_int(0, "BanDayz", datad2);
	    if(datad1 == 2) // Если аккаунт забанен, только тогда мы его можем разбанить.
        {
        	datad2 -= 1209600;
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Banned` = '1', `BanDayz` = '%d' WHERE `Name` = '%e'", datad2, str_name);
			query_empty(pearsq, f_str);
			format(string, sizeof(string), " [ ADM ]: %s отменил удаление аккаунта %s",PlayerInfo[playerid][pName], str_name);
			ABroadCast(COLOR_ADM,string,1);
			format(string,sizeof(string),"[ Мысли ]: Аккаунт {ff9000}%s {cccccc}отменено удаление",str_name);
			SendClientMessage(playerid,COLOR_GREY,string);
			AdminLog("undel", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
        }
        else format(string,sizeof(string),"{cccccc}[ Мысли ]: Аккаунт [ {ff0000}%s {cccccc}] не подлежит удалению",str_name), SendClientMessage(playerid,COLOR_GREY,string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:undel(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	if(sscanf(params, "s[144]",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отменить удаление аккаунта [ /undel Nick_Name ]");
	if(CheckRP_Nickname(params[0]))
	{
	    new string[144];
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Banned, BanDayz FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
		mysql_tquery(pearsq, string, "Call_undel", "ds", playerid, params[0]);
		return 1;
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это явно не ник нейм игрока. Пример: Lol_Lolkin");
	return 1;
}
CMD:wrong(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new string[120];
	if(!sscanf(params, "s[24]", params[0]))
	{
		if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отмена ошибочных наказаний других администраторов доступна только 2+ ADM");
		if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Длина никнейма не может быть больше 20-ти символов");
		new giveplayerid;
		giveplayerid = ReturnUser(params[0], 1);
		if(IsOnline(giveplayerid))
		{
			mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `pp_wrong` WHERE `admid` = '%d' ORDER BY `id` DESC LIMIT 50", PlayerInfo[giveplayerid][pID]);
			mysql_tquery(pearsq, string, "Call_wrong", "ds", playerid, PlayerInfo[giveplayerid][pName]);
		}
		else
		{
			if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");

   			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
	  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, params[0], params[0], 11, 0);
		}
	}
	else
	{
		mysql_format(pearsq, string, sizeof(string), "SELECT * FROM `pp_wrong` WHERE `admid` = '%d' ORDER BY `id` DESC LIMIT 50", PlayerInfo[playerid][pID]);
		mysql_tquery(pearsq, string, "Call_wrong", "ds", playerid, PlayerInfo[playerid][pName]);
	}
	return 1;
}
forward Call_offban(playerid, str_name[], srok, result[]);
public Call_offban(playerid, str_name[], srok, result[])
{
	new bool: is_silent_ban = GetPVarInt(playerid, "IsSilentBan") > 0; DeletePVar(playerid, "IsSilentBan");

	new rows, datad[5], f_str[356];
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid, string[244];
		cache_get_value_name_int(0, "user_id", datadid);
	    cache_get_value_name_int(0, "Soska", datad[0]);
	    cache_get_value_name_int(0, "Banned", datad[1]);
	    cache_get_value_name_int(0, "BanDayz", datad[2]);
	    cache_get_value_name_int(0, "BanMonzz", datad[3]);
	    cache_get_value_name_int(0, "ConnectTime", datad[4]);
	    new unixtime = gettime();
	    if(datad[1] >= 1)
	    {
	    	new datadm[24], datdate[24], datres[64];
	    	new ostalos = datad[2]-unixtime;
			new osday = ostalos/86400;
			new vrem = ostalos-osday*86400;
   			new oshour = vrem/3600;
   			new vrem2 = vrem-oshour*3600;
   			new osminute = vrem2/60;
	    	cache_get_value_name(0, "BanAdmin", datadm, 24);
	    	cache_get_value_name(0, "BanData", datdate, 24);
	    	cache_get_value_name(0, "BanResult", datres, 64);
	    	format(string,sizeof(string),"[ Мысли ADM ]: Аккаунт [ %s ] уже забанен админом %s %s.",str_name,datadm, datdate);
          	SendClientMessage(playerid,COLOR_GREY,string);
          	format(string,sizeof(string),"Причина: %s",datres);
          	SendClientMessage(playerid,COLOR_GREY,string);
	    	if(datad[1] == 1) format(string,sizeof(string),"{cccccc}Разбан через: {FF8282}%d дней, %d часов, %d минут",osday,oshour,osminute);
      		else format(string,sizeof(string),"{cccccc}Удаление аккаунта через: {FF8282}%d дней в 4:00",osday);
       		SendClientMessage(playerid,COLOR_GREY,string);
       		PlayerPlaySound(playerid,4203,0,0,0);
       		return 1;
	    }
		if(datad[0] >= PlayerInfo[playerid][pSoska]) return ErrorMessage(playerid, "{FF6347}Нельзя забанить администратора вашего уровня или выше");

		// Антипидор
		if(AntiPidor(playerid, 6)) return 1;

  		work_admin(playerid, 16);
  		new year, month,day,tmphour,tmpminute,tmpsecond;
		getdate(year, month, day);
    	gettime(tmphour, tmpminute, tmpsecond);

  		if(datad[3] >= 4) // NounBan
  		{
			if (!is_silent_ban) {
				format(string, sizeof(string), "[PP]: %s забанил%s NOUNBAN %s, причина: %s",PlayerInfo[playerid][pName], gender(playerid), str_name, result);
				AllMessage(COLOR_LIGHTRED, string);
			} else {
				format(string, sizeof(string), "* Вы забанили NOUNBAN %s, причина: %s", str_name, result);
				SendClientMessage(playerid, COLOR_LIGHTRED, string);
			}

			new vremya = 30*86400;
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Expert`='0',`Banned`='2',`BanDayz`='%d',`BanMonzz`='%d',`BanAdmin`='%e',`BanResult`='%e',`BanData`='%d.%d.%d %d:%d' WHERE `Name` = '%e'",
				unixtime+vremya, datad[3]+1, PlayerInfo[playerid][pName], result, day, month, year, tmphour, tmpminute, str_name);
			query_empty(pearsq, f_str);
			AdminLog((is_silent_ban ? "snounban" : "nounban"), PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 30, result);
			AddWrong(playerid, 0, str_name, 30);
			SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");

			// Уведомление на форум
			format(string, sizeof(string), "Ваш аккаунт {%s} забанил%s %s NOUNBAN. Причина: %s. Нажмите, чтобы оставить жалобу", str_name, gender(playerid),PlayerInfo[playerid][pName], result);
			SendAlertBridge(datadid, string, ALERT_COMPLAIT);
  		}
  		else // Обычный Бан Offline
  		{
			if (!is_silent_ban) {
				format(string, sizeof(string), "[PP]: %s забанил%s %s на %d %s, причина: %s", PlayerInfo[playerid][pName], gender(playerid), str_name, srok, PluralToText(srok, "день", "дня", "дней"), result);
				AllMessage(COLOR_LIGHTRED, string);
			} else {
				format(string, sizeof(string), "* Вы забанили %s на %d %s, причина: %s", str_name, srok, PluralToText(srok, "день", "дня", "дней"), result);
				SendClientMessage(playerid, COLOR_LIGHTRED, string);
			}

			new vremya = srok*86400;
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Expert`='0',`Banned`='1',`BanDayz`='%d',`BanMonzz`='%d',`BanAdmin`='%e',`BanResult`='%e',`BanData`='%d.%d.%d %d:%d' WHERE `Name` = '%e'",
				unixtime+vremya, datad[3]+1, PlayerInfo[playerid][pName], result, day, month, year, tmphour, tmpminute, str_name);
			query_empty(pearsq, f_str);
			AdminLog((is_silent_ban ? "sban" : "nban"), PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", srok, result);
			AddWrong(playerid, 0, str_name, srok);
			SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
			if(datad[4] <= 2)
			{
		  		SendClientMessage(playerid, COLOR_LIGHTRED, "{FF8282}Аккаунт был помещён в список на удаление. Причина: {ffffff}отыграл менее 3-ёх часов");
		  		new vremya2 = 30*86400;
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Banned`='2',`BanDayz`='%d' WHERE `Name` = '%e'", unixtime+vremya2, str_name);
				query_empty(pearsq, f_str);
			}
			else
			{
				// Уведомление на форум
				format(string, sizeof(string), "Ваш аккаунт {%s} забанил%s %s на %d дней. Причина: %s. Нажмите, чтобы оставить жалобу", str_name, gender(playerid),PlayerInfo[playerid][pName], srok, result);
				SendAlertBridge(datadid, string, ALERT_COMPLAIT);
			}
  		}
  		update_admpoint(playerid, ServerInfo[14]);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
stock BanPlayer(playerid, para1, srok, result[])
{
	new bool: is_silent_ban = GetPVarInt(playerid, "IsSilentBan") > 0;

 	if(PlayerInfo[para1][pBanned] >= 1) return ErrorMessage(playerid, "{FF6347}Поздно, он уже летит в бан..");
	if(PlayerInfo[para1][pSoska] >= PlayerInfo[playerid][pSoska]) return ErrorMessage(playerid, "{FF6347}Нельзя забанить администратора вашего уровня или выше");

	// Антипидор
	if(AntiPidor(playerid, 6)) return 1;

	work_admin(playerid, 16);
	foreach (Player, i)
	{
 		if(PlayerInfo[i][pSoska] >= 1 && GolosVB[i] == para1) GolosVB[i] = 9999;
	}
	if(PlayerInfo[para1][pBanMonzz] >= 4) return NounbanPlayer(playerid, para1, srok, result); // Nounban
	DeletePVar(playerid, "IsSilentBan");

	new year, month,day,tmphour,tmpminute,tmpsecond, string[144], f_str[256];
	getdate(year, month, day);
    gettime(tmphour, tmpminute, tmpsecond);

	if (!is_silent_ban) {
		if(GetPVarInt(para1,"VoteBan") >= 2)
		{
			format(string, sizeof(string), "[PP]: %s забанен голосованием на %d %s, причина: %s", PlayerInfo[para1][pName], srok, PluralToText(srok, "день", "дня", "дней"), result);
			AllMessage(COLOR_LIGHTRED, string);
		}
		else
		{
			if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "[PP]: %s забанил %s на %d дней, причина: %s",PlayerInfo[playerid][pName] ,PlayerInfo[para1][pName],srok, result);
			else format(string, sizeof(string), "[PP]: %s забанила %s на %d %s, причина: %s", PlayerInfo[playerid][pName], PlayerInfo[para1][pName], srok, PluralToText(srok, "день", "дня", "дней"), result);
			AllMessage(COLOR_LIGHTRED, string);
		}
	}
	format(string, sizeof(string), "{FF8282}Забаненный: {FFFFFF}%s {FF8282}| IP: {FFFFFF}%s",PlayerInfo[para1][pName],PlayerInfo[para1][pPlaIP]);
	if (!is_silent_ban) ABroadCast(COLOR_YELLOW, string, 1);
	else {
		SendClientMessage(playerid, COLOR_LIGHTRED, "* Вы забанили %s на %d %s, причина: %s", PlayerInfo[para1][pName], srok, PluralToText(srok, "день", "дня", "дней"), result);
		SendClientMessage(playerid, COLOR_YELLOW, string);
	}

	new unixtime = gettime();
	new vremya = srok*86400;
	PlayerInfo[para1][pBanned] = 1;
	//new Days = getdate();
	//PlayerInfo[para1][pBanDayz] = Days+srok;
	PlayerInfo[para1][pBanDayz] = unixtime+vremya; // Unix Ban
	PlayerInfo[para1][pBanMonzz] += 1;
	mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `BanAdmin`='%e',`BanResult`='%e',`BanData`='%d.%d.%d %d:%d' WHERE `Name` = '%e'",
		PlayerInfo[playerid][pName],result,day, month, year, tmphour, tmpminute,PlayerInfo[para1][pName]);
	query_empty(pearsq, f_str);
	if(PlayerInfo[para1][pExpert] >= 1) PlayerInfo[para1][pExpert] = 0, mysql_save(para1, 16);
	format(string, sizeof(string), "Ваш игровой аккаунт и IP забанены администратором %s {cccccc}[ %02d.%02d.%d %02d:%02d ]", PlayerInfo[playerid][pName], day, month, year, tmphour, tmpminute);
	SendClientMessage(para1,COLOR_LIGHTRED, string);
	format(string, sizeof(string), "Причина: {ff0000}%s {FF6347}| Срок бана: {ff0000}%d дней", result, srok);
	SendClientMessage(para1,COLOR_LIGHTRED, string);
	SendClientMessage(para1,COLOR_LIGHTRED, "");
	SendClientMessage(para1,COLOR_LIGHTRED, "Обязательно сделайте скриншот [ F8 ]");
	SendClientMessage(para1,COLOR_LIGHTRED, "{cccccc}Бан был ошибкой? {FF6347}Напишите жалобу на администратора, в течении семи суток с момента бана!");
	SendClientMessage(para1,COLOR_LIGHTRED, "Если администратор окажется не прав или не предоставит доказательства нарушения - вас моментально разбанят!");
	SendClientMessage(para1,COLOR_LIGHTRED, "{cccccc}Куда писать жалобу? {FF6347}На специальный раздел форума: forum.pears.fun >> Жалобы");
	GameTextForPlayer(para1, "~n~~n~~n~~n~~n~~r~BANNED", 13000, 3);
	PlayAudioStreamForPlayer(para1, "https://cdn.pears.fun/sound/banned.mp3");
	new str[140],sctring[900];
	format(str,sizeof(str),"\n\n{FF6347}Ваш игровой аккаунт и IP забанены администратором %s",PlayerInfo[playerid][pName]);
	strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Дата и время: {cccccc}%02d.%02d.%d %02d:%02d", day, month, year, tmphour, tmpminute);
	strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Причина: {ff0000}%s {FF6347}| Срок бана: {ff0000}%d дней", result, srok);
	strcat(sctring,str);
	format(str,sizeof(str),"\n\n{FF6347}Обязательно сделайте скриншот [ F8 ]");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Бан был ошибкой? {FF6347}Напишите жалобу на администратора, в течении семи суток с момента бана!");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Если администратор окажется не прав или не предоставит доказательства нарушения - вас моментально разбанят!");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Куда писать жалобу? {FF6347}На специальный раздел форума: forum.pears.fun >> Жалобы\n\n");
	strcat(sctring,str);
	ShowDialog(para1,1996,DIALOG_STYLE_MSGBOX,"{ff0000}BANNED",sctring,"*","");

	mysql_format(pearsq, f_str,sizeof(f_str),"SELECT * FROM `pp_banip` WHERE `ip` = '%e'", PlayerInfo[para1][pPlaIP]);
	mysql_tquery(pearsq, f_str, "Call_autobanip", "ddsds", para1,playerid,PlayerInfo[para1][pPlaIP],srok,result);

	AdminLog((is_silent_ban ? "sban" : "ban"), PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], srok, result);
	AddWrong(playerid, 0, PlayerInfo[para1][pName], srok);
	SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
	if(PlayerInfo[para1][pConnectTime] <= 2 && OnlineInfo[para1][oLogged] == 1 && PlayerInfo[para1][pLevel] <= 1)
	{
  		SendClientMessage(playerid, COLOR_LIGHTRED, "{FF8282}Аккаунт был помещён в список на удаление. Причина: {ffffff}отыграл менее 3-ёх часов");
  		new vremya2 = 30*86400;
		PlayerInfo[para1][pBanned] = 2;
		PlayerInfo[para1][pBanDayz] = unixtime+vremya2; // Unix Ban
	}
	Kickx(para1);
	update_admpoint(playerid, ServerInfo[14]);
	return 1;
}

stock NounbanPlayer(playerid, para1, srok, result[])
{
	new bool: is_silent_ban = GetPVarInt(playerid, "IsSilentBan") > 0; DeletePVar(playerid, "IsSilentBan");

	if(PlayerInfo[para1][pBanned] >= 1) return ErrorMessage(playerid, "{FF6347}Поздно, он уже летит в бан..");
	if(PlayerInfo[para1][pSoska] >= PlayerInfo[playerid][pSoska]) return ErrorMessage(playerid, "{FF6347}Нельзя забанить администратора вашего уровня или выше");

	// Антипидор
	if(AntiPidor(playerid, 6)) return 1;

	work_admin(playerid, 16);
	new year, month,day,tmphour,tmpminute,tmpsecond, string[144], f_str[356];
	getdate(year, month, day);
    gettime(tmphour, tmpminute, tmpsecond);

	if (!is_silent_ban) {
		if(GetPVarInt(para1,"VoteBan") >= 2)
		{
			format(string, sizeof(string), "[PP]: %s забанен NOUNBAN голосованием, причина: %s",PlayerInfo[para1][pName], result);
			AllMessage(COLOR_LIGHTRED, string);
		}
		else
		{
			if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "[PP]: %s забанил NOUNBAN %s, причина: %s",PlayerInfo[playerid][pName] ,PlayerInfo[para1][pName], result);
			else format(string, sizeof(string), "[PP]: %s забанила NOUNBAN %s, причина: %s", PlayerInfo[playerid][pName], PlayerInfo[para1][pName], result);
			AllMessage(COLOR_LIGHTRED, string);
		}
	}
	format(string, sizeof(string), "{FF8282}Забаненный: {FFFFFF}%s {FF8282}| IP: {FFFFFF}%s", PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP]);
	if (!is_silent_ban) ABroadCast(COLOR_YELLOW, string, 1);
	else {
		SendClientMessage(playerid, COLOR_LIGHTRED, "* Вы забанили NOUNBAN %s, причина: %s", PlayerInfo[para1][pName], result);
		SendClientMessage(playerid, COLOR_YELLOW, string);
	}

	new unixtime = gettime();
	new vremya = 30*86400;
	PlayerInfo[para1][pBanned] = 2;
	PlayerInfo[para1][pBanDayz] = unixtime+vremya; // Unix Ban
	PlayerInfo[para1][pBanMonzz] += 1;
	mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `BanAdmin`='%e',`BanResult`='%e',`BanData`='%d.%d.%d %d:%d' WHERE `Name` = '%e'",
		PlayerInfo[playerid][pName],result,day, month, year, tmphour, tmpminute,PlayerInfo[para1][pName]);
	query_empty(pearsq, f_str);
	if(PlayerInfo[para1][pExpert] >= 1) PlayerInfo[para1][pExpert] = 0, mysql_save(para1, 16);
	format(string, sizeof(string), "Ваш игровой аккаунт получает пятый бан и навсегда блокируется администратором %s {cccccc}[ %02d.%02d.%d %02d:%02d ]", PlayerInfo[playerid][pName], day, month, year, tmphour, tmpminute);
	SendClientMessage(para1,COLOR_LIGHTRED, string);
	format(string, sizeof(string), "Причина: {ff0000}%s {FF6347}| Срок бана: {ff0000}навсегда", result);
	SendClientMessage(para1,COLOR_LIGHTRED, string);
	SendClientMessage(para1,COLOR_LIGHTRED, "");
	SendClientMessage(para1,COLOR_LIGHTRED, "Обязательно сделайте скриншот [ F8 ]");
	SendClientMessage(para1,COLOR_LIGHTRED, "{cccccc}Бан был ошибкой? {FF6347}Напишите жалобу на администратора, в течении семи суток с момента бана!");
	SendClientMessage(para1,COLOR_LIGHTRED, "Если администратор окажется не прав или не предоставит доказательства нарушения - вас моментально разбанят!");
	SendClientMessage(para1,COLOR_LIGHTRED, "{cccccc}Куда писать жалобу? {FF6347}На специальный раздел форума: forum.pears.fun >> Жалобы");
	GameTextForPlayer(para1, "~n~~n~~n~~n~~n~~r~NOUNBAN", 13000, 3);
	PlayAudioStreamForPlayer(para1, "https://cdn.pears.fun/sound/banned.mp3");
	new str[140],sctring[900];
	format(str,sizeof(str),"\n\n{FF6347}Ваш игровой аккаунт получает пятый бан и навсегда блокируется администратором %s",PlayerInfo[playerid][pName]);
	strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Дата и время: {cccccc}%02d.%02d.%d %02d:%02d", day, month, year, tmphour, tmpminute);
	strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Причина: {ff0000}%s {FF6347}| Срок бана: {ff0000}навсегда", result);
	strcat(sctring,str);
	format(str,sizeof(str),"\n\n{FF6347}Обязательно сделайте скриншот [ F8 ]");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Бан был ошибкой? {FF6347}Напишите жалобу на администратора, в течении семи суток с момента бана!");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Если администратор окажется не прав или не предоставит доказательства нарушения - вас моментально разбанят!");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Куда писать жалобу? {FF6347}На специальный раздел форума: forum.pears.fun >> Жалобы\n\n");
	strcat(sctring,str);
	ShowDialog(para1,1996,DIALOG_STYLE_MSGBOX,"{ff0000}NOUNBAN",sctring,"*","");

	mysql_format(pearsq, f_str,sizeof(f_str),"SELECT * FROM `pp_banip` WHERE `ip` = '%e'", PlayerInfo[para1][pPlaIP]);
	mysql_tquery(pearsq, f_str, "Call_autobanip", "ddsds", para1,playerid,PlayerInfo[para1][pPlaIP],srok,result);

	AdminLog((is_silent_ban ? "snounban" : "nounban"), PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 30, result);
	AddWrong(playerid, 0, PlayerInfo[para1][pName], srok);
	SendClientMessage(playerid,COLOR_LIGHTRED,"{FF8282}Если вы случайно ошиблись, отмените своё действие {0088ff}[ /wrong ]");
	Kickx(para1);
	update_admpoint(playerid, ServerInfo[14]);
	return 1;
}

alias:sban("tban")
CMD:sban(playerid, const params[]) {
	if (PlayerInfo[playerid][pSoska] < 10 && PlayerInfo[playerid][pHidden] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	new tmp[24], time, reason[64];
	if (sscanf(params, "s[24]is[64]", tmp, time, reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Тихо заблокировать [ /sban ID Срок Причина ]");

	new giveplayerid = ReturnUser(tmp, 1), name[24];
	if (!IsOnline(giveplayerid)) {
		if (!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");

		strcat(name, tmp);
	} else format(name, sizeof(name), "%s[%d]", PlayerInfo[giveplayerid][pName], giveplayerid);

	new string[200];
	format(string, sizeof(string), "%s %d %s", tmp, time, reason);
	SetPVarString(playerid, "SilentBanInfo", string);
	format(string, sizeof(string), "{FF6347}Вы уверены, что хотите тихо заблокировать %s ?\n\nElon_Musk: подумай два раза. Надо ли оно тебе? Я не советую баловаться", name);
	ShowDialog(playerid, 1166, DIALOG_STYLE_MSGBOX, "{ff9000}Тихий Бан", string, "Да", "Нет");

	return 1;
}

CMD:ban(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new srok,tmp[24],result[64],string[300],giveplayerid;
	if(!sscanf(params, "s[24]is[64]",tmp,srok,result))
	{
		if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
		if(srok > 300 || srok < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Срок бана не меньше 1 дня и не больше 300 дней");
        giveplayerid = ReturnUser(tmp, 1);
     	if(IsOnline(giveplayerid))
	 	{
			if(IsARealNPC(giveplayerid)) return ErrorMessage(playerid, "{FF6347}Это NPC");
	 		if(PlayerInfo[playerid][pSoska] >= 2) BanPlayer(playerid, giveplayerid, srok, result);
	 		else
	 		{
	 			new kolvo = 0;
	 			foreach (Player, i)
				{
					if(OnlineInfo[i][oLogged] == 1 && PlayerInfo[i][pSoska] >= 1) kolvo ++;
				}
				if(kolvo == 1)
				{
					if(PlayerInfo[playerid][pAmmos6] < 500) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня мало опыта.. [ BAN без голосования: Рейтинг 500+ ]");
					BanPlayer(playerid, giveplayerid, srok, result);
					return 1;
				}
				else if(kolvo >= 2)
				{
		 			if(GolosVB[playerid] != 9999) return SendClientMessage(playerid, COLOR_GRAD2, "{FF0000}Вы уже голосовали за бан игрока. Нужен ещё один голос.");
		 			SetPVarInt(giveplayerid,"VoteBan" ,GetPVarInt(giveplayerid,"VoteBan") +1);
	 			    GolosVB[playerid] = giveplayerid;
				    format(string, sizeof(string), "{FF0000}Внимание! {FFFFFF}%s проголосовал за бан %s ,причина: %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName],result), ABroadCast(COLOR_YELLOW,string,1);
	      			if(GetPVarInt(giveplayerid,"VoteBan") <= 1) format(string, sizeof(string), "{FFFFFF}Если вы согласны с баном %s введите {FF0000}/ban %d %s",PlayerInfo[giveplayerid][pName],giveplayerid,result), ABroadCast(COLOR_YELLOW,string,1);
					if(GetPVarInt(giveplayerid,"VoteBan") >= 2) BanPlayer(playerid, giveplayerid, srok, result);
					return 1;
				}
	 		}
	 	}
	   	else
	   	{
	   		if(PlayerInfo[playerid][pSoska] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хелперы не могу банить игрока в Offline");
  			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
   			mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Banned, BanDayz, BanMonzz, ConnectTime, BanAdmin, BanData, BanResult FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
    		mysql_tquery(pearsq, string, "Call_offban", "dsds", playerid, tmp, srok, result);
     		return 1;
     	}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Забанить игрока [ /ban ID срок причина ]");
	return 1;
}
CMD:freeze(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Заморозить игрока [ /freeze ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(PlayerInfo[params[0]][pSoska] >= 10 && params[0] != playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу заморозить Главного Администратора");
	if(IsARealNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Это NPC");
	TogglePlayerControllable(params[0], false);
	new string[80];
	format(string, sizeof(string), " [ ADM ]: %s заморозил игрока %s",PlayerInfo[playerid][pName] ,PlayerInfo[params[0]][pName]);
 	ABroadCast(COLOR_ADM,string,1);
	AdminLog("freeze", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
	return 1;
}
CMD:unfreeze(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Разморозить игрока [ /unfreeze ID ]");
	if(PlayerInfo[params[0]][pSoska] >= 10 && params[0] != playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу заморозить Главного Администратора");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(IsARealNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Это NPC");
	TogglePlayerControllable(params[0], true);
	new string[80];
	format(string, sizeof(string), " [ ADM ]: %s разморозил игрока %s",PlayerInfo[playerid][pName] ,PlayerInfo[params[0]][pName]);
 	ABroadCast(COLOR_ADM,string,1);
	return 1;
}
alias:readw("readsms")
CMD:readw(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(GetPVarInt(playerid, "readw1") <= 7777) return SetPVarInt(playerid, "readw1", 9999), SendClientMessage(playerid, COLOR_GREY, "[ Мысли ADM ]: Просмотр личных сообщений: {ff0000}Отключён");
	if(!sscanf(params, "u", params[0]))
 	{
 		if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
 		new string[144];
 		SetPVarInt(playerid, "readw1", params[0]);
 		format(string,sizeof(string),"[ Мысли ADM ]: Просмотр личных сообщений {ff9000}%s {00cc00}Включен", PlayerInfo[params[0]][pName]), SendClientMessage(playerid, COLOR_GREY, string);
 	}
 	else SetPVarInt(playerid, "readw1", 7777), SendClientMessage(playerid, COLOR_GREY, "[ Мысли ADM ]: Общий просмотр личных сообщений: {00cc00}Включен");
	return 1;
}
CMD:readan(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 5 || PlayerInfo[playerid][pHidden] >= 1)
	{
		if(GetPVarInt(playerid, "adminreadan") == 0)//Если этот админ еще не включал команду чтения чужих ПМ
		{
	 		SetPVarInt(playerid, "adminreadan", 1);//Включаем ее для этого админа
	 		SendClientMessage(playerid, COLOR_GRAD2, "   Просмотр ответов на репорт Включен");//и информируем его об этом
		    AdminLog("readan", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
		}
		else //А если у этого админа эта команда уже включена...
		{
	 		SetPVarInt(playerid, "adminreadan", 0);//тогда  отключаем ее для этого админа
	 		SendClientMessage(playerid, COLOR_GRAD2, "Просмотр ответов на репорт Выключен ");//и информируем его об этом
		}
	}
	return 1;
}
CMD:readex(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 5 || PlayerInfo[playerid][pHidden] >= 1)
	{
		if(GetPVarInt(playerid, "exread") == 0)
		{
	 		SetPVarInt(playerid, "exread", 1);
	 		SendClientMessage(playerid, COLOR_GRAD2, "   Просмотр ответов на вопросы Экспертов включён");
		    AdminLog("readex", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
		}
		else
		{
	 		SetPVarInt(playerid, "exread", 0);
	 		SendClientMessage(playerid, COLOR_GRAD2, "Просмотр ответов на вопросы Экспертов отключён");
		}
	}
	return 1;
}

CMD:readr(playerid, const params[]) {
	SetPVarInt(playerid, "OpenChannelTransmitterByCMD", 1);
	return SettingChannelTransmitter(playerid, 0);
}

alias:readd("readu")
CMD:readd(playerid, const params[]) {
	SetPVarInt(playerid, "OpenChannelTransmitterByCMD", 1);
	return SettingChannelTransmitter(playerid, 1);
}

CMD:readi(playerid, const params[]) {
	SetPVarInt(playerid, "OpenChannelTransmitterByCMD", 1);
	return SettingChannelTransmitter(playerid, 2);
}

CMD:readfam(playerid, const params[]) {
	new famid; sscanf(params, "D(0)", famid);

	new readfamid = GetPVarInt(playerid, "adminreadfam");
	if (!readfamid || (famid && readfamid)) {
		if (!famid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Просмотр чата семьи [ /readfam ID ]");
		if (PlayerInfo[playerid][pSoska] < 6 && PlayerInfo[playerid][pHidden] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
		if (famid <= 0 || famid > 500) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер семьи от 1 до 500");
		if (FamilyInfo[famid][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этой семьи не существует");

		SetPVarInt(playerid, "adminreadfam", famid);
		SendClientMessage(playerid, COLOR_GRAD2, "   Просмотр чата Семьи №%d включён", famid);
		AdminLog("readfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", famid, "");
	} else {
		DeletePVar(playerid, "adminreadfam");
		SendClientMessage(playerid, COLOR_GRAD2, "Просмотр чата Семьи №%d отключён", readfamid);
	}

	return 1;
}

stock RestartServer()
{
    Restart = true;
    SendRconCommand("name Pears Project [ Restart ]");
	SendRconCommand("password 6yb65v45hdtrffergFFF");
    foreach (Player, i)
	{
		DisablePlayerCheckpoint(i);
		ShowDialog(i,2017,DIALOG_STYLE_MSGBOX,"{000000}.","{ff9000}Перезагрузка сервера Pears Project\n\n{ffffff}Перезагрузка займёт около 2-ух минут","Ок","");
        PlayAudioStreamForPlayer(i,"https://cdn.pears.fun/sound/offtwo.mp3");
        CancelSelectTextDraw(i);
		GameTextForPlayer(i, "~n~~n~~n~~n~~n~~n~PECTAPT HA ~b~Pears", 10000, 5);
		S_SetPlayerVirtualWorld(i,0,0);
		PPSetPlayerInterior(i,0);
		InterpolateCameraPos(i, 1460.0, -1324.0, 287.2, 297.6864,-2093.5444,60.4980, 38000,CAMERA_MOVE);
        InterpolateCameraLookAt(i, 1374.5, -1291.1, 239.0, 735.0622,-1804.6356,12.5819, 38000,CAMERA_MOVE);
		SendClientMessage(i, COLOR_GREY, "{ffcc66}Перезагрузка сервера {ff9000}Pears Project");
		SendClientMessage(i, COLOR_GREY, "{ffcc66}Перезагрузка займёт около 2-ух минут");
		OnlineInfo[i][oLogged] = 0;
	}
	SaveStuff();
	SetTimer("GameModeInitExitFunc", 15000, false);
	return 1;
}

//----------------------------------[GMX]-----------------------------------------------
CMD:restart(playerid)
{
	if(server == 0) return ErrorMessage(playerid, "{FF6347}Недоступно на тестовом сервере...");
 	if(PlayerInfo[playerid][pSoska] >= 20)
	{
	    if(Restart == true) return ErrorMessage(playerid, "{FF6347}Перезагрузка уже выполняется");
	    SaveAccounts();
		RestartServer();
		AdminLog("restart", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
CMD:unbanip(playerid, const params[])
{
	new tmp[32],string[144];
    if (!sscanf(params, "s[32]", tmp))
	{
    	if(PlayerInfo[playerid][pSoska] >= 8 || PlayerInfo[playerid][pHidden] > 0)
    	{
    	    UnBlockIpAddress(tmp);
    		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_banip` WHERE `ip` = '%e'", tmp);
   			mysql_tquery(pearsq, string, "Call_unbanip", "dsd", playerid, tmp,0);
   			format(string,sizeof(string),"unbanip %s",tmp);
    		SendRconCommand(string);
    		SendRconCommand("reloadbans");
    		SendClientMessage(playerid, -1, " %s ip очищен от всех блокировок", tmp);
    		AdminLog("unbanip", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, tmp);
  		}
  	}
  	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Разбанить IP [ /unbanip IP ]");
	return 1;
}
forward Call_unbanip(playerid, str_ip[], stat);
public Call_unbanip(playerid, str_ip[], stat)
{
	new rows,string[144];
	cache_get_row_count(rows);
	if(rows) mysql_format(pearsq, string,sizeof(string),"DELETE FROM `pp_banip` WHERE `ip` = '%e'", str_ip), query_empty(pearsq, string);
	return true;
}
CMD:banip(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 2 && PlayerInfo[playerid][pHidden] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new tmp[24],string[128],srok,result[64];
    if(!sscanf(params, "s[24]is[64]",tmp,srok,result))
    {
		if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	    if(srok > 300 || srok < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Срок бана не меньше 1 дня и не больше 300 дней");
		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_banip` WHERE `ip` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_banip", "dsds", playerid, tmp,srok,result);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Забанить IP [ /banip IP Срок Причина ]");
	return 1;
}
forward Call_banip(playerid, str_ip[], srok, result[]);
public Call_banip(playerid, str_ip[], srok, result[])
{
	new rows, string[144], f_str[256];
	cache_get_row_count(rows);
	if(rows)
	{
		format(string,sizeof(string),"{cccccc}[ Мысли ]: IP уже забанен [ {ff0000}%s {cccccc}]",str_ip);
		SendClientMessage(playerid,COLOR_GREY,string);
		return 1;
	}
	else
    {
		format(string, sizeof(string), "[ Мысли ]: IP %s забанен",str_ip);
    	SendClientMessage(playerid, COLOR_GREY, string);
    	if(PlayerInfo[playerid][pHidden] == 0) format(string, sizeof(string), " [ ADM ]: %s забанил IP [%s] на %d дней", PlayerInfo[playerid][pName], str_ip, srok), ABroadCast(COLOR_ADM,string,1);
		
		format(string, sizeof(string), "%s %s", str_ip, result);
		AdminLog("banip", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", srok, string);
		new unixtime = gettime();
		new vremya = srok*86400;
		mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_banip` SET `ip` = '%e', `ipname` = 'none', `admname` = '%e', `reason` = '%e', `razban` = '%d', `date` = NOW()", str_ip,PlayerInfo[playerid][pName],result,unixtime+vremya);
		query_empty(pearsq, f_str);
    }
	return true;
}
forward Call_autobanip(playerid, adimid, str_ip[], srok, reason[]);
public Call_autobanip(playerid, adimid, str_ip[], srok, reason[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows){ }
	else
    {
		new unixtime = gettime();
		new vremya = srok*86400, f_str[356];
		mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_banip` SET `ip` = '%e', `ipname` = '%e', `admname` = '%e', `reason` = '%e', `razban` = '%d', `date` = NOW()", str_ip,PlayerInfo[playerid][pName],PlayerInfo[adimid][pName],reason,unixtime+vremya);
		query_empty(pearsq, f_str);
    }
	return true;
}
CMD:getip(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] >= 2)
    {
      new pip[24];
      if(!sscanf(params, "s[24]", pip))
	  {
     	new str[256],sctring[2000];
        format(str,sizeof(str),"{FFFFFF}*   {0088ff}Совпадения {00FF00}IP [%s]                    {FFFFFF}*\n\n", pip);
        strcat(sctring,str);
     	foreach (Player, i)
     	{
            if(IsOnline(i))
            {
                new adminip[24];
                GetPlayerIp(i, adminip, sizeof(adminip));
				if((strfind(adminip,pip,true) == 0))
                {
				    format(str,sizeof(str),"{ffffff}* {00cc00} %s[%d]      \n",PlayerInfo[i][pName],i);
               		strcat(sctring,str);
				}

			}
		}
        ShowDialog(playerid,11435,DIALOG_STYLE_MSGBOX,"{FFFFFF}IP Совпадения",sctring,"Ок","");
      }
      else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Просмотр совпадающих IP [ /getip IP ]");
 	}
 	else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
 	return 1;
}
CMD:getip2(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Совпадающие IP игроков Online по ID [ /getip2 ID ]");
    if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
    new string[144], cout = 0;
    foreach (Player, i)
	{
 		if(strfind(PlayerInfo[i][pPlaIP], PlayerInfo[params[0]][pPlaIP], true) != -1)
   		{
   			cout++;
      		if(cout == 1) format(string, 80, "[ Мысли ADM ]: Поиск совпадение IP в Online {ff9000}[ %s ]", PlayerInfo[params[0]][pPlaIP]), SendClientMessage(playerid, COLOR_GREY, string);
      		format(string, 50, "%i. [ID: %i] {ffcc99}%s", cout, i, PlayerInfo[i][pName]), SendClientMessage(playerid, COLOR_GREY, string);
     	}
    }
    return 1;
}
CMD:autoser(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid, 20.0,945.7337,-1717.4540,13.5469) || IsPlayerInRangeOfPoint(playerid, 20.0,1213.2334,-901.5146,42.9802) || IsPlayerInRangeOfPoint(playerid, 20.0,1788.8337,-1776.0693,13.5968)
	|| IsPlayerInRangeOfPoint(playerid, 20.0,-2279.1833,-153.9966,35.3203) || IsPlayerInRangeOfPoint(playerid, 20.0,-2194.4968,984.2795,80.0000) || IsPlayerInRangeOfPoint(playerid, 20.0,-2569.4448,672.1213,27.8125)
	|| IsPlayerInRangeOfPoint(playerid, 20.0,1545.4950,1000.7360,10.8590) || IsPlayerInRangeOfPoint(playerid, 20.0,1644.4493,2194.5940,10.8692) || IsPlayerInRangeOfPoint(playerid, 20.0,2639.7471,1196.9347,10.8530) 
	|| IsPlayerInRangeOfPoint(playerid, 20.0,-1276.1239,2702.1877,50.0980))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) ErrorMessage(playerid, "{FF6347}Вы не за рулём транспортного средства");
		new vehicleid = GetPlayerVehicleID(playerid);

		if(CheckEnterVehicleInterior(playerid, vehicleid)) return true;

		new model = VehInfo[vehicleid][vModel];
		if(IsABoat(model) || IsAPlane(model) || IsAVello(vehicleid)) return ErrorMessage(playerid, "{FF6347}Этот транспорт не обслуживают в автосервисе");
		if(Passajir(vehicleid, 1)) return ErrorMessage(playerid, "{FF6347}Высадите пассажиров из транспорта");
		if(gAutosalon[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы находитесь в другом магазине или автосервисе");
		if(get_boot(vehicleid, 35) >= 0) return ErrorMessage(playerid, "{FF6347}В багажнике вашего транспортного средства находится человек\n{cccccc}Высадите игрока, прежде чем заехать в автосервис");
		if(IsPlayerHavePursuit(playerid)) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция, сейчас вы не можете заехать в автосервис");
		if(VehInfo[vehicleid][vTrailerID] > 0) return ErrorMessage(playerid, "{FF6347}Открепите трейлер, прежде чем заезжать в автосервис");

		// Останавливаем следование игрока за нами
    	StopPlayerFollowForMe(playerid);

		// Записываем ID тачки, которую тюним
		OnlineInfo[playerid][oAutoserviceVeh] = vehicleid;
		OnlineInfo[playerid][oAutoserviceVehNewid] = VehInfo[vehicleid][vNewid];

		if(IsPlayerInRangeOfPoint(playerid, 20.0,945.7337,-1717.4540,13.5469)) gAutosalon[playerid] = 183; // Автосервис LS
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,1213.2334,-901.5146,42.9802)) gAutosalon[playerid] = 184; // Автосервис LS
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,1788.8337,-1776.0693,13.5968)) gAutosalon[playerid] = 185; // Автосервис LS
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,-2279.1833,-153.9966,35.3203)) gAutosalon[playerid] = 186; // Автосервис  SF
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,-2194.4968,984.2795,80.0000)) gAutosalon[playerid] = 187; // Автосервис SF
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,-2569.4448,672.1213,27.8125)) gAutosalon[playerid] = 188; // Автосервис SF
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,1545.4950,1000.7360,10.8590)) gAutosalon[playerid] = 189; // Автосервис LV
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,1644.4493,2194.5940,10.8692)) gAutosalon[playerid] = 190; // Автосервис LV
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,2639.7471,1196.9347,10.8530)) gAutosalon[playerid] = 191; // Автосервис LV
		else if(IsPlayerInRangeOfPoint(playerid, 20.0,-1276.1239,2702.1877,50.0980)) gAutosalon[playerid] = 192; // Автосервис LV

		// Сохраняем последнюю позицию транспорта
		if(Cars[vehicleid] == 88) SaveMyVehiclePos(vehicleid);

		// Записываем позицию игрока
		savePositionPlayerForMenu(playerid);

		// Ставим транспорт на позицию в автосервисе
		vehiclePositionAutoservice(vehicleid, playerid);

		// Открываем меню автосервиса
		showPlayerAutoserviceMenu(playerid);
		return 1;
	}
	return 1;
}
stock oxygen_update(playerid, oxy)
{
	new Float:sized_x = PlayerInfo[playerid][pDrawSize_X][10], Float:sized_y = PlayerInfo[playerid][pDrawSize_Y][10];
	if(Device[playerid] == 1) sized_y += DrawSizeSmart_Y[10];
	new Float:maxi = -50.0-sized_y;
	new Float:plusik = (maxi/1000)*oxy, string[4];
	if(oxy >= 1000) PlayerTextDrawTextSize(playerid, OxygenDraw[1][playerid], 12.0+sized_x/2, -50.0-sized_y);
	else if(oxy <= 999 && oxy >= 1) PlayerTextDrawTextSize(playerid, OxygenDraw[1][playerid], 12.0+sized_x/2, plusik);
	if(oxy > 0) PlayerTextDrawShow(playerid, OxygenDraw[1][playerid]);
	else PlayerTextDrawHide(playerid, OxygenDraw[1][playerid]);
	format(string,sizeof(string),"%d",oxy/10), PlayerTextDrawSetString(playerid, OxygenDraw[2][playerid], string), PlayerTextDrawShow(playerid, OxygenDraw[2][playerid]);
	return 1;
}
stock PosOxygenDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 11 || setting_size_draw[playerid] == 11) positiond_x = oxygendraw_x+set_pos_x[playerid], positiond_y = oxygendraw_y+set_pos_y[playerid];
    else positiond_x = oxygendraw_x+PlayerInfo[playerid][pDrawPos_X][10], positiond_y = oxygendraw_y+PlayerInfo[playerid][pDrawPos_Y][10];

	if(setting_pos_draw[playerid] == 11 || setting_size_draw[playerid] == 11) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	else sized_x = PlayerInfo[playerid][pDrawSize_X][10], sized_y = PlayerInfo[playerid][pDrawSize_Y][10];
	
	if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[10], positiond_y += DrawPosSmart_Y[10], sized_y += DrawSizeSmart_Y[10];

    PlayerTextDrawSetPos(playerid, OxygenDraw[0][playerid], positiond_x, positiond_y); // Основной Фон
    PlayerTextDrawTextSize(playerid, OxygenDraw[0][playerid], 14.0+sized_x/2, -52.0-sized_y);
    PlayerTextDrawSetPos(playerid, OxygenDraw[1][playerid], positiond_x+1.0, positiond_y-1.0); // Вторая полоска
    PlayerTextDrawTextSize(playerid, OxygenDraw[1][playerid], 12.0+sized_x/2, -50.0-sized_y);
    
    // new Float:vrem_x, Float:vrem_y;

    PlayerTextDrawSetPos(playerid, OxygenDraw[2][playerid], positiond_x+(14.0+sized_x/2)/2, positiond_y-10.0-sized_y/8); // Текст кислорода
    PlayerTextDrawLetterSize(playerid, OxygenDraw[2][playerid], 0.189374+sized_x*(0.189374/50), 0.775555+sized_y*(0.775555/40));
	return 1;
}
stock CreateOxygenDraw(playerid)
{
    OxygenDraw[0][playerid] = CreatePlayerTextDraw(playerid, 618.0, 398.0, "LD_SPAC:white");
	PlayerTextDrawLetterSize(playerid, OxygenDraw[0][playerid], 0.000000, 0.000000);
	PlayerTextDrawTextSize(playerid, OxygenDraw[0][playerid], 14.0, -52.0);
	PlayerTextDrawAlignment(playerid, OxygenDraw[0][playerid], TEXT_DRAW_ALIGN:1);
	PlayerTextDrawColour(playerid, OxygenDraw[0][playerid], -1);
	PlayerTextDrawUseBox(playerid, OxygenDraw[0][playerid], true);
	PlayerTextDrawBoxColour(playerid, OxygenDraw[0][playerid], 0);
	PlayerTextDrawSetShadow(playerid, OxygenDraw[0][playerid], 0);
	PlayerTextDrawSetOutline(playerid, OxygenDraw[0][playerid], 0);
	PlayerTextDrawBackgroundColour(playerid, OxygenDraw[0][playerid], PlayerInfo[playerid][pStyle4]);
	PlayerTextDrawFont(playerid, OxygenDraw[0][playerid], TEXT_DRAW_FONT:5);
	PlayerTextDrawSetPreviewModel(playerid, OxygenDraw[0][playerid], 2709);
	PlayerTextDrawSetPreviewRot(playerid, OxygenDraw[0][playerid], 0.0, 0.0, 0.0, -1.0);

    OxygenDraw[1][playerid] = CreatePlayerTextDraw(playerid, 617.0, 397.0, "LD_SPAC:white");
	PlayerTextDrawLetterSize(playerid, OxygenDraw[1][playerid], 0.000000, 0.000000);
	PlayerTextDrawTextSize(playerid, OxygenDraw[1][playerid], 12.0, -50.0);
	PlayerTextDrawAlignment(playerid, OxygenDraw[1][playerid], TEXT_DRAW_ALIGN:1);
	PlayerTextDrawColour(playerid, OxygenDraw[1][playerid], PlayerInfo[playerid][pStyle1]);
	PlayerTextDrawSetShadow(playerid, OxygenDraw[1][playerid], 0);
	PlayerTextDrawSetOutline(playerid, OxygenDraw[1][playerid], 0);
	PlayerTextDrawFont(playerid, OxygenDraw[1][playerid], TEXT_DRAW_FONT:4);

	OxygenDraw[2][playerid] = CreatePlayerTextDraw(playerid, 624.062500, 390.055389, "100");
	PlayerTextDrawLetterSize(playerid, OxygenDraw[2][playerid], 0.189374, 0.775555);
	PlayerTextDrawAlignment(playerid, OxygenDraw[2][playerid], TEXT_DRAW_ALIGN:2);
	if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, OxygenDraw[2][playerid], 673720575);
	else PlayerTextDrawColour(playerid, OxygenDraw[2][playerid], -1);
	PlayerTextDrawUseBox(playerid, OxygenDraw[2][playerid], true);
	PlayerTextDrawBoxColour(playerid, OxygenDraw[2][playerid], 0);
	PlayerTextDrawSetShadow(playerid, OxygenDraw[2][playerid], 0);
	PlayerTextDrawSetOutline(playerid, OxygenDraw[2][playerid], 0);
	PlayerTextDrawBackgroundColour(playerid, OxygenDraw[2][playerid], 51);
	PlayerTextDrawFont(playerid, OxygenDraw[2][playerid], TEXT_DRAW_FONT:1);
	PlayerTextDrawSetProportional(playerid, OxygenDraw[2][playerid], true);
	
	DrawOxygen[playerid] = true;
	return 1;
}


// Проверка на наличие скафандра и лаунчера (для отключения отображения аттачей)
stock ShouldDisplayAttachedPlayerObj(playeridto, playeridon)
{
	if(gSkafandr[playeridon] > 0 && IsPlayerSyncModels(playeridto)) return false;
	return true;
}

stock odetskafandr(playerid, stat, system)
{
	if(stat == 1)
	{
	    if(PlayerInfo[playerid][pDrawVisible][10] == false && setting_pos_draw[playerid] != 11 && setting_size_draw[playerid] != 11)
		{
			if(DrawOxygen[playerid] == false) CreateOxygenDraw(playerid);
			PosOxygenDraw(playerid);
		}
		
	    ClearAnimations(playerid, SYNC_ALL);

		if(system == 1) gSkafandr[playerid] = 2;
		else gSkafandr[playerid] = 1;
		if(!IsPlayerSyncModels(playerid))
		{
	    	SetPlayerAttachedObject(playerid, 3, 18978, 2, 0.098000, -0.008999, 0.002000, 7.800002, 80.799987, 85.600028, 1.805999, 1.641999, 1.487000, 0, 0);
        	SetPlayerAttachedObject(playerid, 4, 1010, 1, 0.075000, -0.109999, 0.000000, 90.0, 0.000000, 179.700088, 0.817000, 1.000000, 0.901000, 0, 0);
		}
		m_custom_sync_SetPlayerSkin(playerid,428);
		RemovePlayerAttachedObject(playerid,5);
		RemovePlayerAttachedObject(playerid,6);
		RemovePlayerAttachedObject(playerid,7);
		RemovePlayerAttachedObject(playerid,8);
		RemovePlayerAttachedObject(playerid,9);
		gOxygen[playerid] = 1000;
		if(PlayerInfo[playerid][pDrawVisible][10] == false && setting_pos_draw[playerid] != 11 && setting_size_draw[playerid] != 11) PlayerTextDrawShow(playerid, OxygenDraw[0][playerid]), oxygen_update(playerid, 1000);
	}
	else
	{
		gSkafandr[playerid] = 0, gOxygen[playerid] = 0;
		m_custom_sync_SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);
		if(!IsPlayerSyncModels(playerid)) RemovePlayerAttachedObject(playerid,3), RemovePlayerAttachedObject(playerid,4);
		if(PlayerInfo[playerid][pDrawVisible][10] == false && setting_pos_draw[playerid] != 11 && setting_size_draw[playerid] != 11 && DrawOxygen[playerid] == true)
		{
			PlayerTextDrawHide(playerid, OxygenDraw[0][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[1][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[2][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[0][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[1][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[2][playerid]);
			DrawOxygen[playerid] = false;
		}
		if(PlayerInfo[playerid][pOdet][0] > 0) SetPlayerAttachedObject(playerid, 5, PlayerInfo[playerid][pOdet][0], PlayerInfo[playerid][pOdetBone][0], PlayerInfo[playerid][pOdet_X][0], PlayerInfo[playerid][pOdet_Y][0], PlayerInfo[playerid][pOdet_Z][0], PlayerInfo[playerid][pOdet_rX][0], PlayerInfo[playerid][pOdet_rY][0], PlayerInfo[playerid][pOdet_rZ][0], PlayerInfo[playerid][pOdet_sX][0], PlayerInfo[playerid][pOdet_sY][0], PlayerInfo[playerid][pOdet_sZ][0], 0, 0);
		if(PlayerInfo[playerid][pOdet][1] > 0) SetPlayerAttachedObject(playerid, 6, PlayerInfo[playerid][pOdet][1], PlayerInfo[playerid][pOdetBone][1], PlayerInfo[playerid][pOdet_X][1], PlayerInfo[playerid][pOdet_Y][1], PlayerInfo[playerid][pOdet_Z][1], PlayerInfo[playerid][pOdet_rX][1], PlayerInfo[playerid][pOdet_rY][1], PlayerInfo[playerid][pOdet_rZ][1], PlayerInfo[playerid][pOdet_sX][1], PlayerInfo[playerid][pOdet_sY][1], PlayerInfo[playerid][pOdet_sZ][1], 0, 0);
		if(PlayerInfo[playerid][pOdet][2] > 0) SetPlayerAttachedObject(playerid, 7, PlayerInfo[playerid][pOdet][2], PlayerInfo[playerid][pOdetBone][2], PlayerInfo[playerid][pOdet_X][2], PlayerInfo[playerid][pOdet_Y][2], PlayerInfo[playerid][pOdet_Z][2], PlayerInfo[playerid][pOdet_rX][2], PlayerInfo[playerid][pOdet_rY][2], PlayerInfo[playerid][pOdet_rZ][2], PlayerInfo[playerid][pOdet_sX][2], PlayerInfo[playerid][pOdet_sY][2], PlayerInfo[playerid][pOdet_sZ][2], 0, 0);
		if(PlayerInfo[playerid][pOdet][3] > 0) SetPlayerAttachedObject(playerid, 8, PlayerInfo[playerid][pOdet][3], PlayerInfo[playerid][pOdetBone][3], PlayerInfo[playerid][pOdet_X][3], PlayerInfo[playerid][pOdet_Y][3], PlayerInfo[playerid][pOdet_Z][3], PlayerInfo[playerid][pOdet_rX][3], PlayerInfo[playerid][pOdet_rY][3], PlayerInfo[playerid][pOdet_rZ][3], PlayerInfo[playerid][pOdet_sX][3], PlayerInfo[playerid][pOdet_sY][3], PlayerInfo[playerid][pOdet_sZ][3], 0, 0);
		if(PlayerInfo[playerid][pOdet][4] > 0) SetPlayerAttachedObject(playerid, 9, PlayerInfo[playerid][pOdet][4], PlayerInfo[playerid][pOdetBone][4], PlayerInfo[playerid][pOdet_X][4], PlayerInfo[playerid][pOdet_Y][4], PlayerInfo[playerid][pOdet_Z][4], PlayerInfo[playerid][pOdet_rX][4], PlayerInfo[playerid][pOdet_rY][4], PlayerInfo[playerid][pOdet_rZ][4], PlayerInfo[playerid][pOdet_sX][4], PlayerInfo[playerid][pOdet_sY][4], PlayerInfo[playerid][pOdet_sZ][4], 0, 0);
	}
}
CMD:skafandr(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid,2.0,1359.5681,1579.6823,10.8484) && GetPlayerInterior(playerid) == 230 && GetPlayerVirtualWorld(playerid) == 230
    || IsPlayerInRangeOfPoint(playerid,2.0,1372.2728, 1560.9222, 10.8584) && GetPlayerInterior(playerid) == 231 && GetPlayerVirtualWorld(playerid) == 231
    || IsPlayerInRangeOfPoint(playerid,2.0,1372.2728, 1560.9222, 10.8584) && GetPlayerInterior(playerid) == 232 && GetPlayerVirtualWorld(playerid) == 232
	|| PlayerInfo[playerid][pSoska] >= 1)
	{
		if(NoAnim[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
	    if(gSkafandr[playerid] == 0)
	    {
	    	if(IsPlayerInRangeOfPoint(playerid,2.0,1359.5681,1579.6823,10.8484) && GetPlayerInterior(playerid) == 230 && GetPlayerVirtualWorld(playerid) == 230)
	    	{
	    		if(GetPVarInt(playerid,"job_stat") != 10 && GetPVarInt(playerid,"job_stat") != 11) return ErrorMessage(playerid, "{FF6347}Выберите экспедицию на стойке информации");
	    		if(nasa_flystat == 0) ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Теперь отправляйтесь на взлётную площадку, чтобы занять место в Ракете","*","");
	    		else ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Внимание! Ракета не находится на стартовой площадке. Дождитесь её возвращения","*","");
	    	}
	    	odetskafandr(playerid, 1, 0), PlayerPlaySound(playerid,30801,0,0,0);
		}
		else if(gSkafandr[playerid] >= 1) odetskafandr(playerid, 0, 0), PlayerPlaySound(playerid,30803,0,0,0);
	}
	return 1;
}
CMD:hlift(playerid, const params[])
{
	if(IsPlayerInRangeOfPoint(playerid,6.0,-489.1872,-169.5221,10.4068) || IsPlayerInRangeOfPoint(playerid,9.0,-489.3636,-169.0216,78.2040))
	{
		if (GetPVarInt(playerid,"antiflood") == 0)
		{
			ShowDialog(playerid,998,DIALOG_STYLE_LIST,"{0088ff}**** Управление Незнакомым Лифтом ****:","{0088ff}* Опустить Лифт\n{0088ff}* Поднять Лифт","Ок","Отмена");
			PlayerPlaySound(playerid,40405,0,0,0);
		}
		else
		{
			new string[256];
			format(string, sizeof(string), "   Подождите %d секунд, после вызывайте лифт снова!",  GetPVarInt(playerid,"antiflood"));
			SendClientMessage(playerid, COLOR_GRAD2, string);
			return 1;
		}
	}
 	return 1;
}
CMD:shuttle2(playerid) // Moon
{
    if(IsPlayerInRangeOfPoint(playerid,2.0,58.8069,2955.1289,961.4515) && GetPlayerInterior(playerid) == 221 && GetPlayerVirtualWorld(playerid) == 221 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && nasa_flystat == 0)
	{
	    if(PlayerInfo[playerid][pBkyrenie] != 2 && PlayerInfo[playerid][pBkyrenie] != 3 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не участник экспедиции NASA");
		if(GetPVarInt(playerid,"LoadBack") > 0)
		{
			ErrorMessage(playerid, "{FF6347}У вас на спине боксы с ценным материалом\n{cccccc}Отнесите его на склад NASA");
			if(GetPVarInt(playerid,"GP") != 1) CreateGps(playerid, 32.1685,3022.9170,957.2476, 221, 221, 5.0);
			return 1;
		}
        AttachCameraToDynamicObject(playerid, raketa_moon[7]);
        PPSetPlayerPos(playerid,74.1097,2872.5972,906.2769);
	    SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Если передумаю и захочу выйти из ракеты {ff9000}[ ALT ]");
	    PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/moon1.mp3");
	    gVrakete[playerid] = 4;
	    raketa_tablo(playerid);

		if(Dei[playerid] == 4) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1); // Убираем кувалду
		if(Dei[playerid] == 2) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1); // Убираем швабру

		DestroyGps(playerid); // Выключаем все метки gps
	}
	else if(gVrakete[playerid] == 4)
	{
		if(nasa_flystat > 0) return ErrorMessage(playerid, "{FF6347}Нельзя после запуска или во время полёта ракеты");
  		PPSetPlayerPos(playerid,59.0187,2961.9556,957.3956), PPSetPlayerFacingAngle(playerid, 359.8317);
  		gVrakete[playerid] = 0, SetCameraBehindPlayer(playerid);
  		if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid);
    }
	return 1;
}
CMD:shuttle3(playerid) // Mars
{
    if(IsPlayerInRangeOfPoint(playerid,2.0,1448.3374,2508.4607,1461.7773) && GetPlayerInterior(playerid) == 222 && GetPlayerVirtualWorld(playerid) == 222 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && nasa_flystat == 0)
	{
	    if(PlayerInfo[playerid][pBkyrenie] != 4 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не участник экспедиции NASA");
		if(GetPVarInt(playerid,"LoadBack") > 0)
		{
			ErrorMessage(playerid, "{FF6347}У вас на спине боксы с ценным материалом\n{cccccc}Отнесите его на склад NASA");
			if(GetPVarInt(playerid,"GP") != 1) CreateGps(playerid, 1363.2443,2516.7244,1457.2476, 222, 222, 5.0);
			return 1;
		}

        AttachCameraToDynamicObject(playerid, raketa_mars[7]);
        PPSetPlayerPos(playerid,1515.8197,2462.6863,1466.3173);
	    SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Если передумаю и захочу выйти из ракеты {ff9000}[ ALT ]");
	    PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/moon1.mp3");
	    gVrakete[playerid] = 5;
	    raketa_tablo(playerid);

		if(Dei[playerid] == 4) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1); // Убираем кувалду
		if(Dei[playerid] == 2) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1); // Убираем швабру

		DestroyGps(playerid); // Выключаем все метки gps
	}
	else if(gVrakete[playerid] == 5)
	{
		if(nasa_flystat > 0) return ErrorMessage(playerid, "{FF6347}Нельзя после запуска или во время полёта ракеты");
  		PPSetPlayerPos(playerid,1440.1099,2508.6318,1457.5776), PPSetPlayerFacingAngle(playerid, 89.0525);
  		gVrakete[playerid] = 0, SetCameraBehindPlayer(playerid);
  		if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid);
    }
	return 1;
}
stock raketa_tablo(playerid)
{
	new str[124],sctring[600],tmphour,tmpminute,tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	if(tmpminute == 19 || tmpminute == 20 || tmpminute == 39 || tmpminute == 40 || tmpminute == 59 || tmpminute == 0)
	{
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Вы готовы к отправке, осталось дождаться запуска ракеты\n\n{444444}Если хотите покинуть ракету {cccccc}[ ALT ]","*","");
	    return 1;
	}
    format(str,sizeof(str),"{ff9000}Внимание!"), strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Отправление происходит каждые 20 минут"), strcat(sctring,str);
    if(tmpminute >= 1 && tmpminute <= 20) format(str,sizeof(str),"\n{ff9000}Следующий запуск состоится в: {0088ff}%02d:20",tmphour), strcat(sctring,str);
    else if(tmpminute >= 21 && tmpminute <= 40) format(str,sizeof(str),"\n{ff9000}Следующий запуск состоится в: {0088ff}%d:40",tmphour), strcat(sctring,str);
    else if(tmpminute >= 41 || tmpminute <= 0)
	{
		tmphour ++;
	    if(tmphour >= 24) tmphour = 0;
		format(str,sizeof(str),"\n{ff9000}Следующий запуск состоится в: {0088ff}%d:00",tmphour), strcat(sctring,str);
	}
    format(str,sizeof(str),"\n\n{444444}Вы можете дождаться автоматического запуска или покинуть ракету {cccccc}[ ALT ]"), strcat(sctring,str);
    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}NASA",sctring,"Oк","");
    return 1;
}
CMD:shuttle(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid,2.0,-962.4467,2543.1484,42.3709) && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    if(GetPVarInt(playerid,"job_stat") != 10 && GetPVarInt(playerid,"job_stat") != 11) return ErrorMessage(playerid, "{FF6347}Вы не зарегистрировались в здании NASA");
	    if(gSkafandr[playerid] == 0) return ErrorMessage(playerid, "{FF6347}У вас нет скафандра [ Наденьте его в здании NASA ]");
	    if(nasa_flystat > 0) return ErrorMessage(playerid, "{FF6347}Ракеты Falcon сейчас нет на взлётной площадке [ Она вернётся в течении двух минут ]");
	    AttachCameraToDynamicObject(playerid, falcon_object[18]);
        PPSetPlayerPos(playerid,-1053.8418,2556.3599,61.5978);
	    SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Если передумаю и захочу выйти из ракеты {ff9000}[ ALT ]");
	    PlayAudioStreamForPlayer(playerid,"https://cdn.pears.fun/sound/moon1.mp3");
	    gVrakete[playerid] = 1;
	    raketa_tablo(playerid);
	}
	else if(gVrakete[playerid] == 1)
	{
		if(nasa_flystat > 0) return ErrorMessage(playerid, "{FF6347}Нельзя после запуска или во время полёта ракеты");
  		PPSetPlayerPos(playerid,-964.4182,2545.6968,42.3709), PPSetPlayerFacingAngle(playerid, 37.5900);
  		gVrakete[playerid] = 0, SetCameraBehindPlayer(playerid);
  		if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid);
    }
	return 1;
}
CMD:raketa(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 10 && PlayerInfo[playerid][pMedia] == 0) return ErrorMessage(playerid, "{FF6347}Недоступно");
	if(nasa_flystat >= 1) return ErrorMessage(playerid, "{FF6347}Ракета уже запущена {cccccc}[ Дождитесь её автоматического возвращения ]");
	if(nasatime > 0) return ErrorMessage(playerid, "{FF6347}Старт запуска ракеты уже выполнен {cccccc}[ Дождитесь завершения сценария ]");
	
	new string[80];
	if(PlayerInfo[playerid][pMedia] > 0) format(string, sizeof(string), " [ ADM ]: Медиа %s запустил ракету NASA",PlayerInfo[playerid][pName]);
	else format(string, sizeof(string), " [ ADM ]: Админ %s запустил ракету NASA",PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
	SuccessMessage(playerid, "{99ff66}Вы произвели запуск ракет NASA {cccccc}[ Старт через 10 секунд ]");
	nasatime = 12;
	return 1;
}
stock start_falcon()
{
	DestroyDynamic3DTextLabel(excelsior_label[0]), DestroyDynamic3DTextLabel(excelsior_label[1]);
	DestroyDynamicPickup(excelsior_pick[0]), DestroyDynamicPickup(excelsior_pick[1]);
    SetDynamicObjectMaterialText(nasa_tablo[1], 0, " ", 130, "Impact", 150, 0, 0xFFFFFFFF, 0x00000000, 1);
    SetDynamicObjectMaterialText(nasa_tablo[3], 0, " ", 120, "Arial", 40, 1, 0xFF0088FF, 0x00000000, 0);
    SetDynamicObjectMaterialText(nasa_tablo[5], 0, " ", 120, "Arial", 40, 1, 0xFFFF9000, 0x00000000, 0);
    nasa_flystat = 1, fly_moon = 1, fly_mars = 1;
    falcon_timer = SetTimer("falcon_fly", 200, true);
	return 1;
}
stock update_tablo()
{
    new tmphour,tmpminute,tmpsecond,qwer[28];
	gettime(tmphour, tmpminute, tmpsecond);
	if(tmpminute >= 1 && tmpminute <= 20) format(qwer,sizeof(qwer),"ОТПРАВЛЕНИЕ\n%02d:20", tmphour);
	else if(tmpminute >= 21 && tmpminute <= 40) format(qwer,sizeof(qwer),"ОТПРАВЛЕНИЕ\n%02d:40", tmphour);
	else if(tmpminute >= 41 || tmpminute <= 0)
	{
	    tmphour ++;
	    if(tmphour >= 24) tmphour = 0;
		format(qwer,sizeof(qwer),"ОТПРАВЛЕНИЕ\n%02d:00", tmphour);
	}
	SetDynamicObjectMaterialText(nasa_tablo[1], 0, qwer, 130, "Impact", 70, 0, 0xFFFFFFFF, 0x00000000, 1);
 	SetDynamicObjectMaterialText(nasa_tablo[3], 0, qwer, 120, "Arial", 40, 1, 0xFF0088FF, 0x00000000, 0);
	SetDynamicObjectMaterialText(nasa_tablo[5], 0, qwer, 120, "Arial", 40, 1, 0xFFFF9000, 0x00000000, 0);
	return 1;
}
stock move_earth()
{
    new Float:posa[3];
    GetDynamicObjectPos(falcon_object[0], posa[0], posa[1], posa[2]);
    posa[2] -= 45.0;
	CreateExplosion(posa[0], posa[1], posa[2], 10, 10.0);
	if(nasa_flystat/2 > 3) r_speed[0] = nasa_flystat/2;
	for(new fo = 0; fo < 19; fo++) MoveDynamicObject(falcon_object[fo], RaketaEarth[fo][RaketaEarth_X], RaketaEarth[fo][RaketaEarth_Y], RaketaEarth[fo][RaketaEarth_Z]+1500.0, r_speed[0]);
	return 1;
}
stock move_moon()
{
	new wheremove;
	if(nasa_flystat <= 100) wheremove = 0;
	else wheremove = 1;
	if(nasa_flystat <= 215)
	{
	    new Float:posa[3];
    	GetDynamicObjectPos(raketa_moon[2], posa[0], posa[1], posa[2]);
		if(wheremove == 0) CreateExplosion(posa[0], posa[1], posa[2]-1.5, 10, 10.0);
		else CreateExplosion(posa[0], posa[1], posa[2]-20.0, 10, 10.0);
	}
	if(nasa_flystat <= 80) r_speed[1] += 0.5;
	else if(nasa_flystat >= 81 && nasa_flystat <= 130) r_speed[1] -= 0.5;
	else if(nasa_flystat >= 131 && nasa_flystat <= 165) r_speed[1] += 0.5;
	else if(nasa_flystat >= 166) r_speed[1] -= 0.5;
	for(new rmoon = 0; rmoon < 8; rmoon++)
	{
	    if(wheremove == 0) MoveDynamicObject(raketa_moon[rmoon], RaketaMoon[rmoon][RaketaMoon_X], RaketaMoon[rmoon][RaketaMoon_Y], RaketaMoon[rmoon][RaketaMoon_Z]+800.0, r_speed[1]);
	    else MoveDynamicObject(raketa_moon[rmoon], RaketaMoon[rmoon][RaketaMoon_X], RaketaMoon[rmoon][RaketaMoon_Y], RaketaMoon[rmoon][RaketaMoon_Z], r_speed[1]);
 	}
}
stock move_mars()
{
	new wheremove;
	if(nasa_flystat <= 100) wheremove = 0;
	else wheremove = 1;
	if(nasa_flystat <= 215)
	{
	    new Float:fposicia[3];
    	GetDynamicObjectPos(raketa_mars[2], fposicia[0], fposicia[1], fposicia[2]);
		if(wheremove == 0) CreateExplosion(fposicia[0], fposicia[1], fposicia[2]-1.5, 10, 10.0);
		else CreateExplosion(fposicia[0], fposicia[1], fposicia[2]-20.0, 10, 10.0);
	}
	if(nasa_flystat <= 80) r_speed[2] += 0.5;
	else if(nasa_flystat >= 81 && nasa_flystat <= 130) r_speed[2] -= 0.5;
	else if(nasa_flystat >= 131 && nasa_flystat <= 165) r_speed[2] += 0.5;
	else if(nasa_flystat >= 166) r_speed[2] -= 0.5;
	for(new rmars = 0; rmars < 8; rmars++)
	{
	    if(wheremove == 0) MoveDynamicObject(raketa_mars[rmars], RaketaMars[rmars][RaketaMars_X], RaketaMars[rmars][RaketaMars_Y], RaketaMars[rmars][RaketaMars_Z]+800.0, r_speed[2]);
	    else MoveDynamicObject(raketa_mars[rmars], RaketaMars[rmars][RaketaMars_X], RaketaMars[rmars][RaketaMars_Y], RaketaMars[rmars][RaketaMars_Z], r_speed[2]);
 	}
}
stock playerinplanet(playerid)
{
    if(PlayerInfo[playerid][pBeret] == 0) TempTake(playerid, 0);
   	PlayerInfo[playerid][pSim] = 1;
   	PlayerPlaySound(playerid,6401,0,0,0);
   	new str[100],sctring[600];
	if(gVrakete[playerid] == 2)
	{
	    if(planetpos[0] == 0) PPSetPlayerPos(playerid,53.7117,2964.6072,957.2399), PPSetPlayerFacingAngle(playerid, 73.6237), planetpos[0] = 1;
	    else if(planetpos[0] == 1) PPSetPlayerPos(playerid,54.1813,2967.5654,957.2399), PPSetPlayerFacingAngle(playerid, 79.2637), planetpos[0] = 2;
	    else if(planetpos[0] == 2) PPSetPlayerPos(playerid,54.6788,2971.1631,957.2476), PPSetPlayerFacingAngle(playerid, 79.2637), planetpos[0] = 0;
	    PlayerInfo[playerid][pBkyrenie] = 2;
	    format(str,sizeof(str),"{ffffff}Астронавт!"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{ffffff}С прибытием на станцию {0088ff}Moon Two (Кратер Кеплер)"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}Зайди в жилой модуль для того,"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}чтобы ознакомиться со своей работой на Луне."), strcat(sctring,str);
	    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}Moon Two",sctring,"Oк","");
	}
	else if(gVrakete[playerid] == 3)
	{
	    if(planetpos[1] == 0) PPSetPlayerPos(playerid,1430.3453,2506.0881,1457.5776), PPSetPlayerFacingAngle(playerid, 107.1274), planetpos[1] = 1;
	    else if(planetpos[1] == 1) PPSetPlayerPos(playerid,1429.0365,2508.9368,1457.5776), PPSetPlayerFacingAngle(playerid, 107.1274), planetpos[1] = 2;
	    else if(planetpos[1] == 2) PPSetPlayerPos(playerid,1430.0623,2502.7976,1457.5699), PPSetPlayerFacingAngle(playerid, 113.7075), planetpos[1] = 0;
	    PlayerInfo[playerid][pBkyrenie] = 4;
	    format(str,sizeof(str),"{ffffff}Астронавт!"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{ffffff}С прибытием на станцию {ff9000}Mars One (Долина Маринер)"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}Зайди в жилой модуль для того,"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}чтобы ознакомиться со своей работой на Марсе."), strcat(sctring,str);
	    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Mars One",sctring,"Oк","");
	}
	if(PlayerInfo[playerid][pAchieve][9] == 0) AchievePlayer(playerid, 9, 1);
	gVrakete[playerid] = 0;
	SetCameraBehindPlayer(playerid);
	return 1;
}
stock exitplanet(playerid)
{
	S_SetPlayerVirtualWorld(playerid, 0, 0), PPSetPlayerInterior(playerid, 0);
	PPSetPlayerPos(
		playerid,
		-995.9862 + (8.0 * float(random(5)) * (random(1) == 0 ? -1.0 : 1.0)),
		2503.0923 + (8.0 * float(random(5)) * (random(1) == 0 ? -1.0 : 1.0)),
		1000.0
	);
	gVrakete[playerid] = 0;
	SetCameraBehindPlayer(playerid);
	SetPlayerToTeamColor(playerid);
	PlayerInfo[playerid][pSim] = 0;
	PlayerInfo[playerid][pBkyrenie] = 0;
	TempGive(playerid);
	Protect_GiveWeapons(playerid, 46, 1, 0, 0);
    new str[100],sctring[500];
    format(str,sizeof(str),"{ff9000} До скорых встреч!");
    strcat(sctring,str);
    format(str,sizeof(str),"\n{ffffff}Вы воспользовались модулем для возвращения на землю.");
    strcat(sctring,str);
    format(str,sizeof(str),"\n\n{cccccc}Летательный аппарат Excelsior высадил вас на расстоянии 1000 метров");
    strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}над землёй.");
    strcat(sctring,str);
    format(str,sizeof(str),"\n{cccccc}Воспользуйтесь парашютом для безопасного приземления.");
    strcat(sctring,str);
    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}NASA",sctring,"Oк","");
	return 1;
}
function falcon_fly()
{
	// Запуск Ракет (Все Проверки) [Начало]
	if(nasa_flystat == 1)
	{
	    new gomoon, gomars;
		foreach (Player, i)
        {
			if(gVrakete[i] == 1 && OnlineInfo[i][oLogged] == 1)
			{
    			if(GetPVarInt(i,"job_stat") == 10) gomoon ++;
				if(GetPVarInt(i,"job_stat") == 11) gomars ++;
			}
		}
		if(gomoon > 0) fly_moon = 1;
		if(gomars > 0) fly_mars = 1;
		if(fly_moon == 1) platform_raketa(0, 1);
		if(fly_mars == 1) platform_raketa(1, 1);
		r_speed[0] = 3, r_speed[1] = 3, r_speed[2] = 3; // Установка Скорости
	}

	// Полёт Ракет (Корректировка Вверх/Вниз)
    nasa_flystat ++;
    if(nasa_flystat <= 100) move_earth(); // Ракета с Земли
    if(nasa_flystat >= 10 && nasa_flystat <= 215)
    {
		if(fly_moon == 1) move_moon(); // Ракета с Луны
		if(fly_mars == 1) move_mars(); // Ракета с Марса
	}

	// Распределение на Корабли
	if(nasa_flystat == 100)
	{
	    foreach (Player, i) // Челов распределяем на другие корабли (Луна/Марс)
        {
            if(OnlineInfo[i][oLogged] == 0) continue;
			if(gVrakete[i] == 1)
			{
			    if(GetPVarInt(i,"job_stat") == 10)
			    {
			        TextDrawShowForPlayer(i, Chernifon);
			        keep(i);
			        S_SetPlayerVirtualWorld(i, 221, 221), PPSetPlayerInterior(i, 221);
			    	PPSetPlayerPos(i,74.1097,2872.5972,906.2769);
			    	gVrakete[i] = 2;
		    	}
		    	if(GetPVarInt(i,"job_stat") == 11)
			    {
			        TextDrawShowForPlayer(i, Chernifon);
			        keep(i);
			        S_SetPlayerVirtualWorld(i, 222, 222), PPSetPlayerInterior(i, 222);
			    	PPSetPlayerPos(i,1515.8197,2462.6863,1466.3173);
			    	gVrakete[i] = 3;
		    	}
			}
			if(gVrakete[i] == 4 || gVrakete[i] == 5) exitplanet(i);
		}
	}
	if(nasa_flystat == 110)
	{
	    foreach (Player, i) // Челов распределяем на другие корабли (Луна/Марс)
        {
			if(OnlineInfo[i][oLogged] == 0) continue;
			if(gVrakete[i] == 2) AttachCameraToDynamicObject(i, raketa_moon[7]), TextDrawHideForPlayer(i, Chernifon);
			if(gVrakete[i] == 3) AttachCameraToDynamicObject(i, raketa_mars[7]), TextDrawHideForPlayer(i, Chernifon);
		}
	}
	
	// Остановка Двигателей
	if(nasa_flystat == 220)
	{
	    for(new r = 0; r < 8; r++)
		{
			SetDynamicObjectPos(raketa_moon[r], RaketaMoon[r][RaketaMoon_X], RaketaMoon[r][RaketaMoon_Y], RaketaMoon[r][RaketaMoon_Z]);
			SetDynamicObjectPos(raketa_mars[r], RaketaMars[r][RaketaMars_X], RaketaMars[r][RaketaMars_Y], RaketaMars[r][RaketaMars_Z]);
		}
		for(new fo = 0; fo < 19; fo++) SetDynamicObjectPos(falcon_object[fo], RaketaEarth[fo][RaketaEarth_X], RaketaEarth[fo][RaketaEarth_Y], RaketaEarth[fo][RaketaEarth_Z]);
	}
	
	// Высаживаем Пассажиров и Останавливаем Таймеры [Конец]
	if(nasa_flystat == 225)
	{
	    foreach (Player, i)
		{
			if((gVrakete[i] == 2 || gVrakete[i] == 3) && OnlineInfo[i][oLogged] == 1) playerinplanet(i);
		}
		if(fly_moon == 1) platform_raketa(0, 0);
		if(fly_mars == 1) platform_raketa(1, 0);
		for(new r = 0; r < 8; r++)
		{
			SetDynamicObjectPos(raketa_moon[r], RaketaMoon[r][RaketaMoon_X], RaketaMoon[r][RaketaMoon_Y], RaketaMoon[r][RaketaMoon_Z]);
			SetDynamicObjectPos(raketa_mars[r], RaketaMars[r][RaketaMars_X], RaketaMars[r][RaketaMars_Y], RaketaMars[r][RaketaMars_Z]);
		}
		for(new fo = 0; fo < 19; fo++) SetDynamicObjectPos(falcon_object[fo], RaketaEarth[fo][RaketaEarth_X], RaketaEarth[fo][RaketaEarth_Y], RaketaEarth[fo][RaketaEarth_Z]);
		fly_moon = 0;
		fly_mars = 0;
		nasatime = 0;
		
		excelsior_label[0] = CreateDynamic3DTextLabel("{cccccc}Занять место в Шаттле\n{ff9000}[ALT]",-1,58.8069,2955.1289,961.4515,5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,221,221);
		excelsior_pick[0] = CreateDynamicPickup(19281, 1, 58.8069,2955.1289,961.4515, 221, 221);
		excelsior_label[1] = CreateDynamic3DTextLabel("{cccccc}Занять место в Шаттле\n{ff9000}[ALT]",-1,1448.3374,2508.4607,1461.7773,5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,222,222);
		excelsior_pick[1] = CreateDynamicPickup(19281, 1, 1448.3374,2508.4607,1461.7773, 222, 222);
		update_tablo();
		KillTimer(falcon_timer), nasa_flystat = 0;
	}
	return 1;
}
stock DoneQwest(playerid)
{
    PlayerInfo[playerid][pQwest] = 21, mysql_save(playerid, 69);
    if(PlayerInfo[playerid][pAchieve][8] == 0) AchievePlayer(playerid, 8, 1);
    if(PlayerInfo[playerid][pDonateRank] >= 3) SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Pears ]: {ffcc66}У вас есть Platinum VIP [ Выдача временной випки невозможна ]");
    else
    {
        PlayerPlaySound(playerid,40405,0,0,0);
   		PlayerInfo[playerid][pDonateRank] = 1;
    	givevip(playerid, 7);
    	mysql_save(playerid, 4);
    	SendClientMessage(playerid, COLOR_GREY, "{0088ff}[ Pears ]: {ffcc66}Поздравляем! Вы прошли квест и получили VIP на +7 дней");
    }
	return 1;
}

stock ShowQwest(playerid, questId, time = 4)
{
	if(questId == 0) // Паспортный Контроль
	{
		if(PlayerInfo[playerid][pKomnataCity] == 3)
		{
			switch(random(3))
			{
				case 0: CreateGps(playerid,1582.8757,1423.6699,10.8726, 0, 0, 5.0);
				case 1: CreateGps(playerid,1578.5564,1423.7529,10.8726, 0, 0, 5.0);
				case 2: CreateGps(playerid,1574.1172,1423.6882,10.8726, 0, 0, 5.0);
			}
		}
		else 
		{
			switch(random(3))
			{
				case 0: CreateGps(playerid,1739.9813,-2421.0430,13.5767, 0, 0, 5.0);
				case 1: CreateGps(playerid,1739.9819,-2425.4553,13.5767, 0, 0, 5.0);
				case 2: CreateGps(playerid,1739.9834,-2429.8330,13.5767, 0, 0, 5.0);
			}
		}
		SendClientMessage(playerid, COLOR_GREY, "{0088ff}С приездом в штат! {ffcc66}Подойдите к паспортному контролю и предъявите ваши документы");
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{99ff66}*","{ffcc66}С приездом в штат!\nПодойдите к паспортному контролю и предъявите ваши документы","*","");
	}
	else if(questId == 1) // Заселитесь в Отеле
	{
		if(PlayerInfo[playerid][pKomnataCity] == 3) CreateGps(playerid,1751.3861,1399.7717,10.8791, 0, 0, 5.0); // lv
		else CreateGps(playerid,1636.1555,-2283.3462,13.5482, 0, 0, 5.0); // ls
		SendClientMessage(playerid, COLOR_GREY, "{0088ff}Заселитесь в Отель. {ffcc66}Отель отмечен красной GPS меткой");
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{99ff66}*","{ffcc66}Заселитесь в Отель\nОтель отмечен красной GPS меткой","*","");
	}
	else if(questId == 2) // Привести себя в порядок
	{
		PlayerInfo[playerid][pCap] = 50;
        PlayerInfo[playerid][pInfoload] = 500;
		SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Кажется от меня немного пахнет, надо сходить в душ");
        ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Ваш персонаж хочет помыться. В номере есть ванная комната","*","");
	}
	else if(questId == 3) // Взлом транспорта
	{
		if(PlayerInfo[playerid][pQuest][3] == 2) return 1; // Все звонки и предложения приехать уже прошли (Просто блокируем)
		if(QuanPlayerStartQuest >= MAX_PLAYERS_START_QUEST) return 1; // Игнорируем запуск приглашения на квест, если на нём уже много игроков
		if(get_invent4(playerid, 26, 0) == 0 
			|| get_invent2(playerid, 156, 0) <= 0) return 0; // Нет смартфона или водительских прав, облом
		if((IsPlayerInDynamicArea(playerid, ZoneQuest1) || IsPlayerInDynamicArea(playerid, ZoneQuest2)) && QuestInfo[playerid][QuestBot]) return 1; // Уже в зоне квеста

		if(PlayerInfo[playerid][pQuest][3] == 0) SetPVarInt(playerid,"qweststat",2), SetPVarInt(playerid,"qwesttime",time + random(8)); // Первый звонок от Джоне
		else if(PlayerInfo[playerid][pQuest][3] == 1) // Второй звонок от Джоне
		{
			if(QuestInfo[playerid][UnixCall] + 300 <= gettime()) // Можно звонить только спустя 5 минут после первого звонка
			{
				SetPVarInt(playerid,"qweststat",11), SetPVarInt(playerid,"qwesttime",time + random(8));
			}
		}
	}
	else if(questId == 4) // Ремонт транспорта
	{
		SetPVarInt(playerid,"qweststat",15), SetPVarInt(playerid,"qwesttime",time);
	}
	else if(questId == 5) // Археология
	{
		SetPVarInt(playerid,"qweststat", 44), SetPVarInt(playerid,"qwesttime",time + random(8));
	}
	else if(questId == 6) // Отдых в клубе
	{
		SetPVarInt(playerid,"qweststat",19), SetPVarInt(playerid,"qwesttime",time);
	}
	else if(questId == 7) // Последствия отдыха
	{
		SetPVarInt(playerid,"qweststat",22), SetPVarInt(playerid,"qwesttime",time);
	}
	else if(questId == 8) // Знакомство с едой
	{
		SetPVarInt(playerid,"qweststat",25), SetPVarInt(playerid,"qwesttime",time);
	}
	else if(questId == 9) // Знакомство с ноутбуком
	{
		if(get_invent4(playerid,42,0) > 0) SetPVarInt(playerid,"qweststat",38), SetPVarInt(playerid,"qwesttime",time); // Уже есть ноутбук
		else
		{
			if(oGetPlayerMoney(playerid) < friskPrice[42] * 2) SetPVarInt(playerid,"qweststat",30), SetPVarInt(playerid,"qwesttime",time); // Если денег мало, сначала заработать
			else SetPVarInt(playerid,"qweststat",35), SetPVarInt(playerid,"qwesttime",time); // Если деньги есть, сразу отправляем покупать ноут
		}
	}
	else if(questId == 10) // Хеллуин
	{
		SetPVarInt(playerid,"qweststat",72), SetPVarInt(playerid,"qwesttime",time);
	}
	return 1;
}
stock mister_ferm(playerid, stat)
{
    ApplyAnimation(playerid,"PED","endchat_03",4.0, false, true, true, false, false);
    new str[100],sctring[600];
    if(stat == 0)
    {
	    format(str,sizeof(str),"{ffffff}У меня много работы на ферме, но я предложу тебе всего две:"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{ffffff}1. Собирать фрукты в саду"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{ffffff}2. Доить коров в ангаре"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}Ты можешь попробовать обе, но сейчас выбери с чего начнёшь"), strcat(sctring,str);
	    ShowDialog(playerid,1231,DIALOG_STYLE_MSGBOX,"{000000}.",sctring,"Фрукты","Коровы");
	}
	else if(stat == 1)
    {
        if(fruitapp <= 0) return ErrorMessage(playerid, "{FF6347}Сорян! В саду сейчас нет работы. Фрукты ещё не созрели, топай лучше коров доить\n\n{cccccc}Фрукты созреют примерно через 10 минут, в принципе можешь подождать");
	    format(str,sizeof(str),"\n{ff9000}Здаров, будешь собирать фрукты? Всё просто"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}1. Возьми справа от меня пустую корзинку"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}2. Затем топай в сад и собирай яблоки"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}3. Наполненную корзинку с яблоками приноси сюда"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}4. Собирай яблоки пока не надоест или не захочешь уйти"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{ffffff}Зарплату сможешь забрать в здании"), strcat(sctring,str);
	    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.",sctring,"*","");
	}
	else if(stat == 2)
    {
	    format(str,sizeof(str),"{ff9000}Здаров, будешь доить коров? Всё просто"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{cccccc}1. Возьми пустое ведро, оно рядом со входом в сарай"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}2. Садись на свободный стул возле коровы [ ALT ] и начинай доить [ %s ]", buttonName[Device[playerid]]), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}3. Когда наполнится ведро, отнеси к столу"), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}4. Можешь повторять пока не надоест или не захочешь уйти"), strcat(sctring,str);
	    format(str,sizeof(str),"\n\n{ffffff}Зарплату сможешь забрать в здании"), strcat(sctring,str);
	    ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.",sctring,"*","");
	}
	return 1;
}
