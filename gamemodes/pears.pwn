CMD:skinsperm(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,597.2203,-1533.4521,15.3926))
	{
		if(get_ability(playerid, 2) < 5) return ErrorMessage(playerid, "{FF6347}Это подарок, который можно взять только с 5 уровня навыка сексуальности [ Y >> Меню >> Навыки ]");
		if(PlayerInfo[playerid][pHoning][0] == 1) return ErrorMessage(playerid, "{FF6347}Вы уже получали этот подарок");
		
		new skinId;
		if(PlayerInfo[playerid][pSex] == 1) skinId = 240;
		else skinId = 172;
		
  		new put_inva = GiveThingPlayer(playerid, skinId, 1, 0, 0, 3, 0, 9999);
    	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре");
		
		PlayerInfo[playerid][pHoning][0] = 1;
		mysql_save(playerid, 55);
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Вы взяли одежду в качестве подарка. {99ff66}Проверьте инвентарь!","*","");
		PlayerPlaySound(playerid,31205,0,0,0);
 	}
 	return 1;
}
CMD:spermobank(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,3.0,608.7850,-1538.1212,15.3926))
	{
		if(PlayerInfo[playerid][pSex] != 1 || PlayerInfo[playerid][pAge] < 18) return ErrorMessage(playerid, "{FF6347}Извините, но для нашего медицинского центра требуются только мужчины от 18 лет");
		if(get_invent2(playerid, 63, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет медицинской карты [ Y >> GPS >> Услуги >> Госпиталь ]");
		if(illnessnovampire(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж болен. Отправляйтесь в госпиталь,\nчтобы вам поставили диагноз и назначили лечение [ Y >> GPS >> Услуги >> Госпиталь ]");
		if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
		PlayerPlaySound(playerid,40405,0,0,0);
       	new str[100],sctring[400];
       	if(ServerInfo[53] == 1) format(str,sizeof(str),"{99ff66}Повышенная Оплата: Активна\n"), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Стандартная Оплата\n"), strcat(sctring,str);
       	if(GetPVarInt(playerid,"Stakandroch") <= 2) format(str,sizeof(str),"{99ff66}Начать Процедуру\n"), strcat(sctring,str);
       	else if(GetPVarInt(playerid,"Stakandroch") == 3) format(str,sizeof(str),"{99ff66}Получить Зарплату\n"), strcat(sctring,str);
    	format(str,sizeof(str),"{FFcc00}* {FFFFFF}Купить журнал Playboy {99ff66}[%d$]\n", friskPick[62]), strcat(sctring,str);
    	ShowDialog(playerid,1125,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Спермобанк",sctring,"Выбрать","Выход");
 	}
 	return 1;
}
stock PlayersInPos(Float:rad, Float:x, Float:y, Float:z)
{
	new quan;
	foreach(Player,i)
	{
		if(GetPVarInt(i,"afksystem") <= 2 && IsPlayerInRangeOfPoint(i,rad,x,y,z)) quan ++;
	}
	return quan;
}
CMD:med(playerid, const params[])
{
	if(get_invent2(playerid, 63, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет медицинской карты [ Y >> GPS >> Услуги >> Госпиталь ]");
	if(CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Вы смотрите телевизор");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	if(box[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы на ринге");
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать медицинскую карту [ /med ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Его вообще нет..");
	if(!ProxDetectorS(3.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я слишком далеко");
	if(params[0] == playerid)
	{
	    if(Dei[playerid] > 0 || Hold[playerid] > 0 || Hand[playerid] > 0) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки");
		Dei[playerid] = 6, DeiStat[playerid] = playerid, pc_cmd_showmed(playerid);
	}
	else
	{
		if(Dei[params[0]] > 0 || Hold[params[0]] > 0 || Hand[params[0]] > 0) return ErrorMessage(playerid, "{FF6347}У него заняты руки");
		if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"DEALER","shop_pay",4.0, false, false, false, false, false, SYNC_ALL), TurnPlayerFaceToPlayer(playerid, params[0]);
		Dei[params[0]] = 6, DeiStat[params[0]] = playerid;
		new string[124];
		format(string,sizeof(string),"[ Мысли ]: %s показывает свою медицинскую карту {ff6666}[ Y - посмотреть | N - убрать ]",playername(playerid));
		SendClientMessage(params[0], COLOR_GREY,string);
		SetPlayerAttachedObject(playerid, 1, 2894, 6, 0.075000, 0.135999, 0.029000, 10.299997, -59.899990, 100.999992, 0.325999, 0.391999, 0.285999, 0, 0);
	}
	PlayerPlaySound(params[0],40405,0,0,0);
	return 1;
}
CMD:showmed(playerid)
{
	if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	new net;
	if(DeiStat[playerid] == playerid)
	{
		if((PlayerInfo[playerid][pMember] == 4 || PlayerInfo[playerid][pLeader] == 4) && PlayerInfo[playerid][pSoska] >= 22) net = 1;
		else DP[0][playerid] = 1, pc_cmd_symptom(playerid);
	}
	else net = 1;
	if(net == 1)
	{
		if(Dei[playerid] != 6) return ErrorMessage(playerid, "{FF6347}Попросите пациента передать вам его медицинскую карту [ Инвентарь N или /med ]");
	    DP[0][playerid] = 0;
		new str[64],sctring[128];
		format(str,sizeof(str),"{cccccc}Посмотреть Симптомы"), strcat(sctring,str);
	   	format(str,sizeof(str),"\n{ff6666}Поставить Диагноз"), strcat(sctring,str);
		ShowDialog(playerid,1127,DIALOG_STYLE_LIST,"{ff6666}Медицинская Карта",sctring,"Выбор","Отмена");
	}
	return 1;
}

alias:remove("rem")
CMD:remove(playerid)
{
	if(Dei[playerid] != 6) return ErrorMessage(playerid, "{FF6347}У меня нет в руках медицинской карты");
	if(Dei[playerid] == 6) SetPlayerChatBubble(playerid,"убирает медицинскую карту",COLOR_PURPLE,20.0,3000);
	Dei[playerid] = 0, DeiStat[playerid] = 0;
	RemovePlayerAttachedObject(playerid,1);
	PlayerPlaySound(playerid,1085,0,0,0);
	return 1;
}

CMD:droch(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,1.0,602.2987,-1552.6893,15.3926) || IsPlayerInRangeOfPoint(playerid,1.0,599.2958,-1552.6514,15.3926) || IsPlayerInRangeOfPoint(playerid,1.0,595.9228,-1552.7107,15.3926))
	{
		if(GetPVarInt(playerid,"Stakandroch") != 1 && GetPVarInt(playerid,"Stakandroch") != 2) return ErrorMessage(playerid, "{FF6347}Вам нужно зарегистрироваться на процедуру в приёмной");
		if(Sex[playerid] != 4 && Sex[playerid] != 5)
		{
			if(NoAnim[playerid] == 1 || GetPlayerSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
			if(IsPlayerInRangeOfPoint(playerid,2.0,602.2987,-1552.6893,15.3926) && PlayersInPos(3.0, 602.2987,-1552.6893,15.3926) > 1) return ErrorMessage(playerid, "{FF6347}В этой кабинке кто-то есть, вам нужно уединиться!");
			else if(IsPlayerInRangeOfPoint(playerid,2.0,599.2958,-1552.6514,15.3926) && PlayersInPos(3.0, 599.2958,-1552.6514,15.3926) > 1) return ErrorMessage(playerid, "{FF6347}В этой кабинке кто-то есть, вам нужно уединиться!");
			else if(IsPlayerInRangeOfPoint(playerid,2.0,595.9228,-1552.7107,15.3926) && PlayersInPos(3.0, 595.9228,-1552.7107,15.3926) > 1) return ErrorMessage(playerid, "{FF6347}В этой кабинке кто-то есть, вам нужно уединиться!");
			new days, hour, minute, second, unix = gettime(), string[84];
			getunix(PlayerInfo[playerid][pSexBreak]-unix, days, hour, minute, second);
			if(PlayerInfo[playerid][pSexBreak] > unix) return format(string, sizeof(string), "{FF6347}Вы не можете так часто [ Через %02d мин. %02d сек. ]", minute, second), ErrorMessage(playerid, string);
    		CreateSex(playerid, 4);
		}
	}
	return 1;
}
CMD:nasahavka(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1398.5509,1562.0851,10.8584) && (GetPlayerVirtualWorld(playerid) == 231 && GetPlayerInterior(playerid) == 231 || GetPlayerVirtualWorld(playerid) == 232 && GetPlayerInterior(playerid) == 232))
	{
		if(gSkafandr[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Снимите скафандр");
		if(Hold[playerid] >= 1 || Hand[playerid] >= 1 || Dei[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46)) return ErrorMessage(playerid, "{FF6347}У вас заняты руки или выполняется действие [Предмет или оружие]");
		if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо и он не может сейчас это сделать");
		if(Eat[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Не спешите");
		if(PlayerInfo[playerid][pNeon] >= 1000) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не хочет кушать");
		EatPlayer(playerid, 500);
		Eat[playerid] = 1; EatTime[playerid] = 3;
   		RemovePlayerAttachedObject(playerid,1);
   		SetPlayerAttachedObject(playerid, 1, 1484, 6, 0.108999, 0.033000, 0.031000, 9.500002, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
   		PlayerPlaySound(playerid, 32200, 0.0, 0.0, 0.0);
   		ApplyAnimation(playerid,"BAR","dnk_stndM_loop",2.0, false, false, false, false, false);
		SetPlayerChatBubble(playerid,"ест питательный набор из тюбика",COLOR_PURPLE,20.0,4000);
		if(getillness(playerid, 18) >= 0) EatPlayer(playerid, -800), SetPVarInt(playerid, "qweststat", 64), SetPVarInt(playerid, "qwesttime", 8);
    }
	return 1;
}
