			new lol[50];
 			format(lol,sizeof(lol),"{ff9000}Ник Неймы %s",tmp);
			ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,lol,"{cccccc}Поиск аккаунта...","*","");
