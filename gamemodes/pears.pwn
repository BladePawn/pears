		MakeleaderPlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pLeader], PlayerInfo[para1][pRank]);
	}
	else if(chto == 5)
	{
	    new fpick, price;
	    if(DP[1][playerid] == 1)
	    {
            if(get_lic(playerid, 161) > 0) return ErrorMessage(playerid, "{FF6347}У вас уже есть лицензия на оружие 1-ой категории");
            if(get_lic(playerid, 162) > 0) return ErrorMessage(playerid, "{FF6347}У вас уже есть лицензия на оружие 2-ой категории {cccccc}[ Вам НЕ нужно иметь две лицензии на оружие одновременно ]");
            fpick = 161, price = friskPrice[161];
	    }
	    if(DP[1][playerid] == 2)
	    {
            if(get_lic(playerid, 162) > 0) return ErrorMessage(playerid, "{FF6347}У вас уже есть лицензия на оружие 2-ой категории");
            if(get_lic(playerid, 161) == 0) return ErrorMessage(playerid, "{FF6347}У вас нет лицензии на оружие 1-ой категории [ Сначала приобретите лицензию на оружие 1 ]");
            fpick = 162, price = friskPrice[162];
	    }
	    if(price <= 0) return ErrorMessage(playerid, "{FF6347}Ошибка! Стоимость лицензии не установлена правительством или администрацией");
	    if(oGetPlayerMoney(playerid) < price) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
	    if(CheckInvent(playerid)) return ErrorMessage(playerid, "{FF6347}В вашем инвентаре не хватает места");
	    if(fpick == 162) DelInvent3(playerid,161);
	    oGivePlayerMoney(playerid, -price);
	    GiveThingPlayer(playerid, fpick, 1, PlayerInfo[playerid][pID], 0, 0, 0, 9999);
	    format(string,sizeof(string),"{99ff66}Вы купили %s", friskName[fpick]), SuccessMessage(playerid, string);
	    payanim(playerid, 0);
	    PutMoneyToTreasury(price, "Покупка лицензий в ОЦ");

		format(string,sizeof(string),"Купил %s", friskName[fpick]);
		MoneyLog("buylic", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -price, string);
	}
	else if(chto == 6)
	{
		OrgLog(7, "invite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "");
		DP[1][playerid] = 7;
		format(string, sizeof(string), "Вы уверены что хотите взять мандат, вы займете место и будете принимать участие в жизни штата?\n\n{FFFFFF}Вы согласны?");
		ShowDialog(para1,116,DIALOG_STYLE_MSGBOX,"Приглашение",string,"Да","Нет");
	}
	return 1;
}
function is_a_bl(playerid, g, const tmp[], stat)
{
    new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datad;
	    cache_get_value_name_int(0, "term", datad);
	    if(datad > gettime()) info_bl(playerid, g, tmp, stat);
	}
	return 1;
}
function bank_org(playerid, g)
{
    new rows;
	cache_get_row_count(rows);
	new stro[114],sctringo[1300];
    format(stro,sizeof(stro),"{cccccc}Введите {99ff66}количество денег{cccccc}, чтобы выполнить перевод"), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Перевод на счет %s",frakName[DP[0][playerid]]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Мой счет: {99ff66}%d$ [%s]",PlayerInfo[playerid][pAccount],get_k(PlayerInfo[playerid][pAccount])), strcat(sctringo,stro);
	if(rows)
	{
	    new datad;
	    cache_get_value_name_int(0, "term", datad);
	    if(datad > gettime())
	    {
	    	new datad2[24], datad3[24], datad4;
    		cache_get_value_name(0, "reason", datad2, 24);
    		cache_get_value_name(0, "sender", datad3, 24);
    		cache_get_value_name_int(0, "term", datad4);
    		cache_get_value_name_int(0, "bailed", DP[1][playerid]);
    		new tyear, tmonth, tday, thour, tminute, tsecond;
			stamp2datetime(datad4, tyear, tmonth, tday, thour, tminute, tsecond, 3);

			format(stro,sizeof(stro),"\n\n{444444}Черный Список | %s", frakName[g]), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}Занес: %s | Залог: {FF6347}%d$", datad3, DP[1][playerid]), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}Причина: {FF6347}%s", datad2), strcat(sctringo,stro);
			format(stro,sizeof(stro),"\n{cccccc}До: %02d.%02d.%d %02d:%02d", tday, tmonth, tyear, thour, tminute), strcat(sctringo,stro);
			if(DP[1][playerid] <= 0) format(stro,sizeof(stro),"\n{FF6347}Досрочный выход невозможен!"), strcat(sctringo,stro);
			else format(stro,sizeof(stro),"\n{99ff66}Оплатите залог, чтобы выйти из черного списка досрочно"), strcat(sctringo,stro);
     	}
	}
	ShowDialog(playerid,1017,DIALOG_STYLE_INPUT,"{99ff66}Банк",sctringo,"Принять","Отмена");
	return 1;
}
function IsAPosCar(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,3.0, -2007.2343,1129.1823,53.2815) || IsPlayerInRangeOfPoint(playerid,3.0, 2499.4961,-1670.3929,13.3474)
 	|| IsPlayerInRangeOfPoint(playerid,3.0, 2478.5493,-2009.6857,13.3796) || IsPlayerInRangeOfPoint(playerid,3.0, 2255.0339,-1451.6729,23.8281)
  	|| IsPlayerInRangeOfPoint(playerid,3.0, 1685.5065,-2112.7607,13.3828) || IsPlayerInRangeOfPoint(playerid,3.0, 1928.4447,1796.4156,12.7144)

	// yakuza гараж
	|| IsPlayerInRangeOfPoint(playerid,3.0, 1393.5787,813.6584,-4.3763)

	// yakuza гараж склад
	|| IsPlayerInRangeOfPoint(playerid,3.0,897.5742,1397.6779,1029.3512) 
	 	&& GetPlayerVirtualWorld(playerid) == WORLD_YAKUZA_GARAGE && GetPlayerInterior(playerid) == INT_YAKUZA_GARAGE

	|| IsPlayerInRangeOfPoint(playerid,3.0, 1909.8519,1985.5721,7.5946)
   	|| IsPlayerInRangeOfPoint(playerid,3.0, 1433.5840,715.1978,10.8203)|| IsPlayerInRangeOfPoint(playerid,3.0, -1477.8391,925.4896,7.2403)
    || IsPlayerInRangeOfPoint(playerid,3.0, 1248.6566,-2055.3650,59.7468))
	{
	    return 1;
	}
	return 0;
}
