					mysql_SaveDivision(PlayerInfo[playerid][pID], 1, PlayerInfo[playerid][pDivision][1], PlayerInfo[playerid][pDivRank][0]);
				}

				resetPlayerTransmitter(playerid);
			    SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мне нужно переодеться в раздевалке");
			    new str[100],sctring[450];
		        format(str,sizeof(str),"{ff9000}Я получил%s статус гражданского", gender(playerid));
		        strcat(sctring,str);
		        format(str,sizeof(str),"\n{ffffff}Теперь я могу внедриться в любую банду или организацию");
		        strcat(sctring,str);
		        format(str,sizeof(str),"\n{ffffff}для выполнения задания.");
		        strcat(sctring,str);
		        format(str,sizeof(str),"\n{cccccc}Мне нужно переодеться в раздевалке");
		        strcat(sctring,str);
		        format(str,sizeof(str),"\n{ff9000}[ Y >> Меню >> Настройка Чата ] - переключение каналов рации");
		        strcat(sctring,str);
		        format(str,sizeof(str),"\n\n{0088ff}Моя статистика работоспособности была очищена перед заданием!");
		        strcat(sctring,str);
		        ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}F.B.I.",sctring,"Oк","");
			}
			if(listitem == 1)
			{
				if(PlayerInfo[playerid][pLeader] >= 1) return ErrorMessage(playerid, "{FF6347}Лидеру нельзя работать под прикрытием");
			    if(PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не агент под прикрытием");
			    DelUpdate(playerid);
			    new weapons[2];
    			GetPlayerWeaponData(playerid, WEAPON_SLOT:6, WEAPON:weapons[0], weapons[1]);
    			if(weapons[0] == 34 && weapons[1] >= 1) Protect_Remove(playerid, 34); // Отнимаем Снайперку на Руках
			    if(TempWeapon[playerid][6] == 34 && TempAmmo[playerid][6] >= 1) TempWeaponClear(playerid, 6); // Отнимаем снайперку временно лишённую
			    SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь мне нужно переодеться в раздевалке");
			    PlayerInfo[playerid][pMember] = 2;
			    PlayerInfo[playerid][pRank] = PlayerInfo[playerid][pFbi];
			    PlayerInfo[playerid][pFbi] = 0;
				PlayerInfo[playerid][pVig] = 0;

				// Возвращаем подфракцию у FBI
				if(PlayerInfo[playerid][pDivision][1] > 0) 
				{
					PlayerInfo[playerid][pDivision][0] = PlayerInfo[playerid][pDivision][1];
					PlayerInfo[playerid][pDivRank][0] = PlayerInfo[playerid][pDivRank][1];
					PlayerInfo[playerid][pDivision][1] = 0;
					PlayerInfo[playerid][pDivRank][1] = 0;
					mysql_SaveDivision(PlayerInfo[playerid][pID], 0, PlayerInfo[playerid][pDivision][0], PlayerInfo[playerid][pDivRank][0]);
					mysql_SaveDivision(PlayerInfo[playerid][pID], 1, PlayerInfo[playerid][pDivision][1], PlayerInfo[playerid][pDivRank][1]);
				}

				resetPlayerTransmitter(playerid);
		        ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{0088ff}F.B.I.","{ff9000}Вы получили статус Агента F.B.I.\n\n{cccccc}Можете взять форму в раздевалке","Oк","");
		    }
	    }
	}
