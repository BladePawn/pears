stock abuse(playerid,const string[])
{
	reklamshik[playerid] = 0;
	new sctr[144 + 1], text[144 + 1];
	BigToSmall(string, text); // Исправляем CAPS
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(strfind(string, ".ru" ,true) != -1 ||  strfind(string, "www." ,true) != -1 || strfind(string, "www ." ,true) != -1 ||  strfind(string, ". ru" ,true) != -1
		||  strfind(string, ". su" ,true) != -1 ||  strfind(string, "http:" ,true) != -1 ||  strfind(string, ".com" ,true) != -1 ||  strfind(string, ",ru" ,true) != -1
		||  strfind(string, ".su" ,true) != -1 ||  strfind(string, ".ру" ,true) != -1 ||  strfind(string, ".ком" ,true) != -1 ||  strfind(string, ",com" ,true) != -1
		||  strfind(string, ".ucoz" ,true) != -1 || strfind(string, " ip" ,true) != -1 ||  strfind(text, "наш сервер" ,true) != -1 ||  strfind(text, "нашего сервера" ,true) != -1
		||  strfind(text, "наш серв" ,true) != -1||  strfind(text, "нашего серва" ,true) != -1 ||  strfind(text, "продам деньги" ,true) != -1 ||  strfind(text, "продам акк" ,true) != -1
		||  strfind(text, "продам аккаунт" ,true) != -1 ||  strfind(string, "prodam akk" ,true) != -1 ||  strfind(text, "продаю аккаунты" ,true) != -1 ||  strfind(text, "продам акк" ,true) != -1
		||  strfind(text, "продаю акки" ,true) != -1 ||  strfind(text, "продаю аки" ,true) != -1 || strfind(string, "https:" ,true) != -1)
		{
		    format(sctr, sizeof(sctr), " [ ADM ]: Реклама %s[%i]: %s", PlayerInfo[playerid][pName],playerid,string);
		    ABroadCast(COLOR_ADM,sctr,1);
		    reklamshik[playerid] = 1;
		}
	}
	new send;
	if(strfind(text, "мама", true) != -1 || strfind(text, " мать", true) != -1 || strfind(text, "мамка", true) != -1 || strfind(text, "мамаша", true) != -1
	|| strfind(text, "мамашка", true) != -1 || strfind(text, "мамашку", true) != -1 || strfind(text, "мамашке", true) != -1 || strfind(text, "мамаше", true) != -1
 	|| strfind(text, "матери", true) != -1 || strfind(text, "мамы", true) != -1
 	|| strfind(text, "матb", true) != -1 || strfind(text, "мaть", true) != -1 || strfind(text, "mать", true) != -1
 	|| strfind(text, "maть", true) != -1 || strfind(text, "matb", true) != -1
	|| strfind(text, "маме", true) != -1 || strfind(text, "мамке", true) != -1 || strfind(text, "мамку", true) != -1 || strfind(text, "мамашу", true) != -1 || strfind(text, " маму", true) != -1
	|| strfind(text, "мамок", true) != -1 || strfind(text, "маман", true) != -1 || strfind(text, "маать", true) != -1 || strfind(text, "мааать", true) != -1 || strfind(text, "маааать", true) != -1
	|| strfind(text, "mama", true) != -1 || strfind(text, "mamka", true) != -1 || strfind(text, "mamky", true) != -1 || strfind(text, "mamke", true) != -1 || strfind(text, "mq", true) != -1
	|| strfind(text, "mamku", true) != -1 || strfind(text, "mamy", true) != -1 || strfind(text, "mamu", true) != -1 || strfind(text, "maman", true) != -1
	|| strfind(text, "сукин", true) != -1 || strfind(text, "сын ", true) != -1 || strfind(text, "дочь", true) != -1 || strfind(text, "sin ", true) != -1 || strfind(text, " sin", true) != -1
	|| strfind(text, "батя", true) != -1 || strfind(text, "бате", true) != -1 || strfind(text, "батю", true) != -1 || strfind(text, "бати", true) != -1)
	{
		new unixtime = gettime();
		if(unixtime > PlayerInfo[playerid][pInsult])
		{
			format(sctr, sizeof(sctr), "Слова: {cccccc}%s",string), SendClientMessage(playerid, COLOR_LIGHTRED, sctr);
			SendClientMessage(playerid, COLOR_LIGHTRED, "Не оскорбляйте родственников и родителей наших игроков. Подумайте над тем, что вы хотели сказать..");
			SendClientMessage(playerid, COLOR_LIGHTRED, "Это предупреждение! В следующий раз вы можете получить {ff0000}BAN на 7 дней"), PlayerPlaySound(playerid,4203,0,0,0);
			PlayerInfo[playerid][pInsult] = unixtime+86400;
			reklamshik[playerid] = 2;
		}
		if(reklamshik[playerid] == 0)
		{
			format(sctr, sizeof(sctr), " [ ADM ]: Нарушение %s[%i]: %s", PlayerInfo[playerid][pName],playerid, string);
			ABroadCast(COLOR_ADM, sctr, 1);
			if(unixtime > GetPVarInt(playerid,"afinsult"))
			{
				//new f_str[144];
				//format(f_str, 144, Symbol(string));
				SetPVarInt(playerid,"afinsult", unixtime+3), OffenseLog(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], string), send = 1;
			}
		}
	}
	if(strfind(text, "гандон", true) != -1 || strfind(text, "уёбок", true) != -1 || strfind(text, "уебок", true) != -1 || strfind(text, "чмо", true) != -1 || strfind(text, "пидорас", true) != -1
	|| strfind(text, "еблан", true) != -1 || strfind(text, "ебучий", true) != -1 || strfind(text, "ебучая", true) != -1 || strfind(text, "ебучие", true) != -1 || strfind(text, "ебаный", true) != -1
	|| strfind(text, "ебаная", true) != -1 || strfind(text, "ебаные", true) != -1 || strfind(text, "пидор", true) != -1 || strfind(text, "соси", true) != -1 || strfind(text, "мразь", true) != -1
	|| strfind(text, "gandon", true) != -1 || strfind(text, "yebok", true) != -1 || strfind(text, "uebok", true) != -1 || strfind(text, "sosi", true) != -1 || strfind(text, "pidoras", true) != -1
	|| strfind(text, "eblan", true) != -1 || strfind(text, "ebanie", true) != -1 || strfind(text, "pidor", true) != -1 || strfind(text, "тупой", true) != -1 || strfind(text, "тупая", true) != -1
 	|| strfind(text, "тупые", true) != -1 || strfind(text, "мрази", true) != -1 || strfind(text, "шлюха", true) != -1 || strfind(text, "шлюхи", true) != -1 || strfind(text, "шалавы", true) != -1
 	|| strfind(text, "шалава", true) != -1 || strfind(text, "шалаву", true) != -1)
	{
	    if(send == 0)
	    {
			new unixtime = gettime();
			if(unixtime > GetPVarInt(playerid,"afinsult"))
			{
			    //new f_str[144];
				//format(f_str, 144, Symbol(string));
				SetPVarInt(playerid,"afinsult", unixtime+3), OffenseLog(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], string);
			}
		}
	}

	// Психушка
	if(PlayerInfo[playerid][pSoska] == 0)
	{
		if(strfind(string, "хуй" , true ) != -1
		||  strfind(string, "хуй" , true ) != -1
		||  strfind(string, " блять" , true ) != -1
		||  strfind(string, " хуи" , true ) != -1
		||  strfind(string, "хуё" , true ) != -1
		||  strfind(string, " блядь" , true ) != -1
		||  strfind(string, " ебу" , true ) != -1
		||  strfind(string, "ебал" , true ) != -1
		||  strfind(string, "ебсти" , true ) != -1
		||  strfind(string, "хуи" , true ) != -1
		||  strfind(string, "гандон" , true ) != -1)
		{
			PlayerInfo[playerid][pAmmos2]++;
			if(PlayerInfo[playerid][pAmmos2] >= 50 && PlayerInfo[playerid][pJailed] == 0 && PlayerInfo[playerid][pMember] != 8 && PlayerInfo[playerid][pLeader] != 8)
			{
				format(sctr, sizeof(sctr), "[%s] Неадекватное поведение: [%s], Уровень опасности: [%d]",rpplayername(playerid),string,PlayerInfo[playerid][pAmmos2]);
				WaveMess(COLOR_LIGHTNEUTRALBLUE,sctr);
			}
		}
	}
	return 1;
}
