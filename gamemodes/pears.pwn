	   		else if(rultime[rt] == 0)
	   		{
	   			new mojno = 0;
				foreach(Player, pl)
				{
					if(OnlineInfo[pl][oLogged] == 1 && GetPVarInt(pl,"kas") == 6 && GetPVarInt(pl,"kstol") == rt)
					{
                        mojno = 1;
                        PlayerPlaySound(pl,33400,0,0,0);
					}
				}
				if(mojno == 1)
				{
	   				rulstol[rt] = 2;
	   				rultime[rt] = 2;
