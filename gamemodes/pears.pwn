	    	if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3025 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0;
			if(PlayerInfo[playerid][pFamrank] < FamilyInfo[f][fAccname]) return format(string,sizeof(string),"[ Мысли ]: Я не могу изменять название семьи [ %d+ Ранг ]",FamilyInfo[f][fAccname]), SendClientMessage(playerid, COLOR_GREY, string), pc_cmd_fam(playerid);
			if(!strlen(inputtext)) return pc_cmd_fam(playerid);
			if(checksimvolfam(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хм... я пытаюсь указать в названии какие-то каракули... [ Запрещённый Символ ]"), pc_cmd_fam(playerid);
			if(strlen(inputtext) < 3 || strlen(inputtext) > 64) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Название должно быть не больше 64 и не меньше 3 символов.."), pc_cmd_fam(playerid);
   			format(FamilyInfo[f][fName], MAX_NAME_FAMILY_LENGTH, "%s", inputtext); // Меняем название
	    	format(string, sizeof(string), "{66ffff}Family {ffcc00}%s изменил название семьи {cccccc}[ %s {cccccc}]", PlayerInfo[playerid][pName], inputtext);
      		SendFamilyMessage(f, COLOR_YELLOW, string);
         	FamilyLog(f, "fname", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, inputtext);
          	SaveFamily(f);
          	foreach (Player, i)
			{
				if(PlayerInfo[i][pFamily] == f && OnlineInfo[i][oLogged] == 1 && Fame[i] == true)
				{
					DestroyDynamic3DTextLabel(FamLabel[i]);
					CreateFamlLabel(i, f);
     			}
			}
			return 1;
		}
		else pc_cmd_fam(playerid);
	}



