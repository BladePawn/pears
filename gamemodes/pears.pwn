			else if(A >= 45.1 && A <= 135.0) posstoika = 90.0, postext = -180.0, SetVehicleZAngle(v, 90.0),   plus_x[0] = -0.108643, plus_x[1] = -0.245606, plus_y[0] = 0.020141, plus_y[1] = 0.020141; // 90.0
