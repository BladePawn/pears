CMD:vishe(playerid)
{
	if (PlayerInfo[playerid][pSoska] >= 2)
	{
		new Float:slx, Float:sly, Float:slz;
		GetPlayerPos(playerid, slx, sly, slz);
		PPSetPlayerPos(playerid, slx, sly, slz+0.1000);
		return 1;
	}
	return 1;
}
