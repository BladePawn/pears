		if(listitem == 2) // Редактировать позицию
		{
			if(!TrailerInfo[tid][tActive]) return ErrorMessage(playerid, "{ff6347}Трейлер не установлен чтобы его редактировать");
			if(!IsPlayerInRangeOfPoint(playerid, 10.0, TrailerInfo[tid][tPos][0], TrailerInfo[tid][tPos][1], TrailerInfo[tid][tPos][2])) return ErrorMessage(playerid,"{ff6347}Трейлер далеко от вас, подойдите ближе чтобы его редактировать");
			GoEditDynamicObject(playerid, REDAKT_TYPE_TRAILER, 1, tid, 0, TrailerInfo[tid][tObject], 0);
			open_again = false;
		}
		if (open_again) ShowTrailerMenu(playerid);
	}
