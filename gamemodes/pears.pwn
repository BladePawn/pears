UINT8 tireDamageStatus, 
UINT8 addSiren, 
UINT8 modslot0, 
UINT8 modslot1, 
UINT8 modslot2, 
UINT8 modslot3, 
UINT8 modslot4, 
UINT8 modslot5, 
UINT8 modslot6, 
UINT8 modslot7, 
UINT8 modslot8, 
UINT8 modslot9, 
UINT8 modslot10, 
UINT8 modslot11, 
UINT8 modslot12, 
UINT8 modslot13, 
UINT8 PaintJob, 
UINT32 BodyColor1, 
UINT32 BodyColor2
*/

// Появление транспорта в зоне стрима для игрока
const RPC_WorldVehicleAdd = 164;
ORPC:RPC_WorldVehicleAdd(playerid, BitStream:bs) 
{
    if (playerid == -1) return true;
	new wVehicleID, 
	ModelID,
	Float:X, 
	Float:Y, 
	Float:Z, 
	Float:Angle, 
	InteriorColor1, 
	InteriorColor2, 
	Float:Health, 
	interior, 
	DoorDamageStatus, 
	PanelDamageStatus, 
	LightDamageStatus, 
	tireDamageStatus, 
	addSiren, 
	modslot0, 
	modslot1, 
	modslot2, 
	modslot3, 
	modslot4, 
	modslot5, 
	modslot6, 
	modslot7, 
	modslot8, 
	modslot9, 
	modslot10, 
	modslot11, 
	modslot12, 
	modslot13, 
	PaintJob, 
	BodyColor1, 
	BodyColor2;

	BS_ReadUint16(bs, wVehicleID);
	BS_ReadInt32(bs, ModelID);
	BS_ReadFloat(bs, X);
	BS_ReadFloat(bs, Y);
	BS_ReadFloat(bs, Z); 
	BS_ReadFloat(bs, Angle);
	BS_ReadInt8(bs, InteriorColor1);
	BS_ReadInt8(bs, InteriorColor2);
	BS_ReadFloat(bs, Health); 
	BS_ReadInt8(bs, interior); 
	BS_ReadInt32(bs, DoorDamageStatus); 
	BS_ReadInt32(bs, PanelDamageStatus); 
	BS_ReadInt8(bs, LightDamageStatus); 
	BS_ReadInt8(bs, tireDamageStatus); 
	BS_ReadInt8(bs, addSiren);
	BS_ReadInt8(bs, modslot0);
	BS_ReadInt8(bs, modslot1);
	BS_ReadInt8(bs, modslot2);
	BS_ReadInt8(bs, modslot3);
	BS_ReadInt8(bs, modslot4);
	BS_ReadInt8(bs, modslot5);
	BS_ReadInt8(bs, modslot6);
	BS_ReadInt8(bs, modslot7);
	BS_ReadInt8(bs, modslot8); 
	BS_ReadInt8(bs, modslot9);
	BS_ReadInt8(bs, modslot10);
	BS_ReadInt8(bs, modslot11);
	BS_ReadInt8(bs, modslot12); 
	BS_ReadInt8(bs, modslot13); 
	BS_ReadInt8(bs, PaintJob); 
	BS_ReadInt32(bs, BodyColor1); 
	BS_ReadInt32(bs, BodyColor2);

	//SendClientMessageToAll(-1, "PaintJob %d", PaintJob);

	// Фикс Азота
	if(RakNetVehicleComponent(modslot5) == 1010)
	{
		new size = 16 + 32 + 32 + 32 + 32 + 32 + 8 + 8 + 32 + 8 + 32 + 32 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8;
		ClearBS(bs, size);

		SetTimerEx("SendVehicleNitro", 500, false, "ii", playerid, wVehicleID);
	}

	// Игрок без лаунчера
	if(!IsPlayerSyncModels(playerid))
	{
		// Диски на транспорте (перехватываем)
		if(!IsAWheelsForVehicleDefault(RakNetVehicleComponent(modslot7)))
		{
			new size_wheels = 16 + 32 + 32 + 32 + 32 + 32 + 8 + 8 + 32 + 8 + 32 + 32 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8;
			ClearBS(bs, size_wheels);
		}

		// Покрасочные работы (перехватываем)
		if(VehInfo[wVehicleID][vModel] >= 2000) 
		{
			new size_paintjob = 16 + 32 + 32 + 32 + 32 + 32 + 8 + 8 + 32 + 8 + 32 + 32 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8 + 8;
			ClearBS(bs, size_paintjob);
		}
	}

	/*
	SendClientMessageToAll(-1, "modslot0 %d, modslot1 %d, modslot2 %d, modslot3 %d, modslot4 %d, modslot5 %d, modslot6 %d, modslot7 %d", 
		modslot0, modslot1, modslot2, modslot3, modslot4, modslot5, modslot6, modslot7);

	SendClientMessageToAll(-1, "modslot8 %d, modslot9 %d, modslot10 %d, modslot11 %d, modslot12 %d, modslot13 %d", 
		modslot8, modslot9, modslot10, modslot11, modslot12, modslot13);
	*/
    return true;
}

// Перезаписываем че-то там в pawn rak net
stock ClearBS(BitStream:bs, size)
{
	new writeOffset;
	BS_GetWriteOffset(bs, writeOffset);
	BS_SetWriteOffset(bs, size);
	BS_WriteUint8(bs, 0);
	BS_SetWriteOffset(bs, writeOffset);
	return true;
}

// Фикс азота
forward SendVehicleNitro(const playerid, const vehicleid);
public SendVehicleNitro(const playerid, const vehicleid) 
{
	if(!IsOnline(playerid)) return true;

	new BitStream:bs = BS_New();

	BS_WriteUint16(bs, INVALID_PLAYER_ID);
	BS_WriteUint32(bs, 2);
	BS_WriteUint32(bs, vehicleid);
	BS_WriteUint32(bs, 1010);

	PR_SendRPC(bs, playerid, RPC_SCMEvent);
    BS_Delete(bs);
    return true;
}


// Исправляем отображение компонента по id
stock RakNetVehicleComponent(componentid)
{
	if(componentid == 0) return 0;
	return componentid + 999;
}


