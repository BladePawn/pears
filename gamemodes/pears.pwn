		cache_get_value_name_float(f, "SpaY", DomInfo[idx][dSpaY]);
		cache_get_value_name_float(f, "SpaZ", DomInfo[idx][dSpaZ]);
		cache_get_value_name_float(f, "SpaA", DomInfo[idx][dSpaA]);
		cache_get_value_name_int(f, "Intoi", DomInfo[idx][dIntoi]);
		cache_get_value_name_float(f, "ToiX", DomInfo[idx][dToiX]);
		cache_get_value_name_float(f, "ToiY", DomInfo[idx][dToiY]);
		cache_get_value_name_float(f, "ToiZ", DomInfo[idx][dToiZ]);
		cache_get_value_name_float(f, "ToiA", DomInfo[idx][dToiA]);
		cache_get_value_name_int(f, "Insin", DomInfo[idx][dInsin]);
		cache_get_value_name_float(f, "SinX", DomInfo[idx][dSinX]);
		cache_get_value_name_float(f, "SinY", DomInfo[idx][dSinY]);
		cache_get_value_name_float(f, "SinZ", DomInfo[idx][dSinZ]);
		cache_get_value_name_float(f, "SinA", DomInfo[idx][dSinA]);
		cache_get_value_name_int(f, "Insou", DomInfo[idx][dInsou]);
		cache_get_value_name_float(f, "SouX", DomInfo[idx][dSouX]);
		cache_get_value_name_float(f, "SouY", DomInfo[idx][dSouY]);
		cache_get_value_name_float(f, "SouZ", DomInfo[idx][dSouZ]);
		cache_get_value_name_int(f, "InbedL", DomInfo[idx][dInbedL]);
		cache_get_value_name_float(f, "InbedLX", DomInfo[idx][dInbedLX]);
		cache_get_value_name_float(f, "InbedLY", DomInfo[idx][dInbedLY]);
		cache_get_value_name_float(f, "InbedLZ", DomInfo[idx][dInbedLZ]);
		cache_get_value_name_float(f, "InbedLA", DomInfo[idx][dInbedLA]);
