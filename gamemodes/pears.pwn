function Call_getidcam(idx) {
    CamInfo[idx][cID] = cache_insert_id();
    return 1;
}
stock InsertCam(idx)
{
	new Float:pos[3], Float:rot[3];
	GetDynamicObjectPos(CamInfo[idx][cObject], pos[0], pos[1], pos[2]);
	GetDynamicObjectRot(CamInfo[idx][cObject], rot[0], rot[1], rot[2]);
	
	new string_mysql[360];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"INSERT INTO `pp_camera` SET `Stat`='%d',`Account`='%d',`Vlad`='%e',`Name`='%e',`Date`='%d',`cX`='%f',`cY`='%f',`cZ`='%f',\
	`cRX`='%f',`cRY`='%f',`cRZ`='%f',`World`='%d',`Interior`='%d'",
		CamInfo[idx][cStat],CamInfo[idx][cAccount],CamInfo[idx][cVlad],CamInfo[idx][cName],CamInfo[idx][cDate],pos[0],pos[1],pos[2],rot[0],rot[1],rot[2],CamInfo[idx][cWorld],CamInfo[idx][cInterior]);
	mysql_tquery(pearsq, string_mysql, "Call_getidcam", "d", idx);
	return 1;
}
stock UpdateCam(idx)
{
	new string_mysql[120];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT * FROM `pp_camera` WHERE `newid` = '%d'", CamInfo[idx][cID]);
	mysql_tquery(pearsq, string_mysql, "Call_UpdateCam", "d", idx);
	return 1;
}
function Call_UpdateCam(idx)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new Float:pos[3], Float:rot[3];
		GetDynamicObjectPos(CamInfo[idx][cObject], pos[0], pos[1], pos[2]);
		GetDynamicObjectRot(CamInfo[idx][cObject], rot[0], rot[1], rot[2]);

		new string_mysql[400];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_camera` SET `Stat`='%d',`Account`='%d',`Vlad`='%e',`Name`='%e',`Date`='%d',`cX`='%f',`cY`='%f',`cZ`='%f',\
		`cRX`='%f',`cRY`='%f',`cRZ`='%f',`World`='%d',`Interior`='%d' WHERE `newid` = '%d'",
		CamInfo[idx][cStat],CamInfo[idx][cAccount],CamInfo[idx][cVlad],CamInfo[idx][cName],CamInfo[idx][cDate],pos[0],pos[1],pos[2],rot[0],rot[1],rot[2],CamInfo[idx][cWorld],CamInfo[idx][cInterior],CamInfo[idx][cID]);
		query_empty(pearsq, string_mysql);
	}
	return 1;
}
function Call_DelCam(idx)
{
	new rows;
	cache_get_row_count(rows);
	if(rows) 
	{
		new string_mysql[140];
		mysql_format(pearsq, string_mysql,sizeof(string_mysql),"DELETE FROM `pp_camera` WHERE `newid` = '%d'",CamInfo[idx][cID]);
		query_empty(pearsq, string_mysql);
	}
	return 1;
}

