//===========================
function unfine(playerid, slot)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		SetPVarInt(playerid,"stopload",0);
		new p = DP[1][playerid],finelien;
		if(p == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
		if(!IsOnline(p)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
		if(OnlineInfo[p][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
		if(GetPlayerState(p) == PLAYER_STATE_SPECTATING || !ProxDetectorS(5.0, playerid,p)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от человека..");
		cache_get_value_name_int(0, "finelien", finelien);
		if(finelien <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот транспорт не арестован");
		new f_str[144], string[144];
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_cars` SET `finelien` = '0' WHERE `sost` = '%d' AND `slot` = '%d'",PlayerInfo[p][pID], slot);
		query_empty(pearsq, f_str);
		format(string,sizeof(string),"[ Мысли ]: Арест личного транспорта %s[%d] в слоте %d: {99ff66}Отменён!",PlayerInfo[p][pName], p, slot), SendClientMessage(playerid, COLOR_GREY, string);
		format(string,sizeof(string),"[ Мысли ]: {99ff66}%s {cccccc}отменил арест моего транспорта в слоте {99ff66}%d",PlayerInfo[playerid][pName], slot), SendClientMessage(p, COLOR_GREY, string);
		SendClientMessage(p, COLOR_GREY, "[ Мысли ]: Теперь я могу забрать свой транспорт {ff9000}[ Y >> Транспорт ]");
		PlayerPlaySound(playerid,6401,0,0,0);
		PlayerPlaySound(p,6401,0,0,0);
	}
	else
	{
		SetPVarInt(playerid,"stopload",0);
		ShowDialog(playerid,1995,DIALOG_STYLE_MSGBOX,"{000000}*","\n{cccccc}Транспорт не найден\n\n{ffffff}Статус: {ff0000}Не выполнено","*","");
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом слоте нет транспорта {ff0000}[ Обратитесь к Старшей Администрации ]");
		return 1;
	}
	return 1;
}
function payfine(playerid, slot)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		if(oGetPlayerMoney(playerid) < DP[2][playerid]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне не хватает денег"), pc_cmd_finecar(playerid);
		oGivePlayerMoney(playerid, -DP[2][playerid]);
		MoneyLog("payfine", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -DP[2][playerid], "Оплатил Штраф (Арест Транспорта)");
		new f_str[144], string[144];
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_cars` SET `finelien` = '0' WHERE `sost` = '%d' AND `slot` = '%d'",PlayerInfo[playerid][pID], slot);
		query_empty(pearsq, f_str);
		if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"[ Мысли ]: Я оплатил штраф в размере {99ff66}%d$",DP[2][playerid]), SendClientMessage(playerid, COLOR_GREY, string);
		else format(string,sizeof(string),"[ Мысли ]: Я оплатила штраф в размере {99ff66}%d$",DP[2][playerid]), SendClientMessage(playerid, COLOR_GREY, string);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Теперь я могу забрать свой транспорт {ff9000}[ Y >> Транспорт ]");
		PlayerPlaySound(playerid,6401,0,0,0);
		SetPVarInt(playerid,"stopload",0);
		HidePlayerDialog(playerid);
	}
	else
	{
		SetPVarInt(playerid,"stopload",0);
		ShowDialog(playerid,1995,DIALOG_STYLE_MSGBOX,"{000000}*","\n{cccccc}Транспорт не найден\n\n{ffffff}Статус: {ff0000}Не выполнено","*","");
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом слоте нет транспорта {ff0000}[ Обратитесь к Администрации ]");
		return 1;
	}
	return 1;
}
function getfinecar(playerid, slot)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		SetPVarInt(playerid,"stopload",0);
		new paramet[4], unixtime = gettime();
		cache_get_value_name_int(0, "fine", paramet[0]);
		cache_get_value_name_int(0, "model", paramet[1]);
		cache_get_value_name_int(0, "finelien", paramet[3]);
		new str[100], sctring[700];
		new year, month,day;
		getdate(year, month, day);
		new lol[64];
		format(lol,sizeof(lol),"{ff9000}Штраф Стоянка {ffffff}[%d.%d.%d]",day,month,year);
		if(paramet[3] >= 1)
		{
		    new fname[24],freason[64];
			cache_get_value_name_int(0, "finetime", paramet[2]);
			cache_get_value_name(0, "finename", fname, 24);
			cache_get_value_name(0, "finereason", freason, 64);
			new tyear, tmonth, tday, thour, tminute, tsecond, tyear2, tmonth2, tday2, thour2, tminute2, tsecond2;
			stamp2datetime(paramet[0], tyear, tmonth, tday, thour, tminute, tsecond, 3);
			stamp2datetime(paramet[2], tyear2, tmonth2, tday2, thour2, tminute2, tsecond2, 3);
			format(str,sizeof(str),"\n\n{444444}Личный Транспорт [ {ff9000}%s {444444}]",GetVehicleName(paramet[1])), strcat(sctring,str);
		 	format(str,sizeof(str),"\n\n{FF6347}Арестован"), strcat(sctring,str);
		 	format(str,sizeof(str),"\n{cccccc}Арестован До: {FF6347}[ %02d.%02d.%d %02d:%02d ]", tday, tmonth, tyear, thour, tminute), strcat(sctring,str);
		 	format(str,sizeof(str),"\n{cccccc}Дата и время ареста: {444444}[ %02d.%02d.%d %02d:%02d ]", tday2, tmonth2, tyear2, thour2, tminute2), strcat(sctring,str);
		 	format(str,sizeof(str),"\n{cccccc}Полицейский: %s", fname), strcat(sctring,str);
		 	format(str,sizeof(str),"\n{cccccc}Причина: {ffffff}%s", freason), strcat(sctring,str);
		 	format(str,sizeof(str),"\n{cccccc}Залог: {99ff66}%d$\n\n", paramet[3]), strcat(sctring,str);
			if(paramet[0] > unixtime)
			{
		 		format(str,sizeof(str),"\n{FF6347}Вы не можете забрать транспорт, пока не закончится время ареста!\n\n"), strcat(sctring,str);
				ShowDialog(playerid,965,DIALOG_STYLE_MSGBOX,lol,sctring,"*","");
			}
			else
		 	{
		 		DP[1][playerid] = slot;
		 		DP[2][playerid] = paramet[3];
		 		format(str,sizeof(str),"\n{FF6347}Готовы оплатить залог, чтобы забрать свой транспорт?\n\n"), strcat(sctring,str);
				ShowDialog(playerid,966,DIALOG_STYLE_MSGBOX,lol,sctring,"Да","Нет");
			}
		}
		else
		{
			format(str,sizeof(str),"\n\n{444444}Личный Транспорт [ {ff9000}%s {444444}]",GetVehicleName(paramet[1])), strcat(sctring,str);
	 		format(str,sizeof(str),"\n\n{cccccc}Арест: {99ff66}Отсутствует\n\n"), strcat(sctring,str);
			ShowDialog(playerid,965,DIALOG_STYLE_MSGBOX,lol,sctring,"*","");
		}
	}
	else
	{
		SetPVarInt(playerid,"stopload",0);
		ShowDialog(playerid,1995,DIALOG_STYLE_MSGBOX,"{000000}*","\n{cccccc}Транспорт не найден\n\n{ffffff}Статус: {ff0000}Не выполнено","*","");
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В этом слоте нет транспорта {ff0000}[ Обратитесь к Администрации ]");
		return 1;
	}
	return 1;
}
stock SavePromo(idx, pf)
{
	new string_mysql[200];
	switch(idx)
    {
    	case 0: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `par0` = '%d',`stat0` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roPar][0], PromoInfo[pf][roStat][0], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 1: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `par1` = '%d',`stat1` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roPar][1], PromoInfo[pf][roStat][1], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 2: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `par2` = '%d',`stat2` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roPar][2], PromoInfo[pf][roStat][2], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 3: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `par3` = '%d',`stat3` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roPar][3], PromoInfo[pf][roStat][3], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 4: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `par4` = '%d',`stat4` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roPar][4], PromoInfo[pf][roStat][4], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 5: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `name` = '%e' WHERE `newid` = '%d'", PromoInfo[pf][roName], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 6: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `activ` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roActiv], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 7: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `unixcreate`='%d',`unixbegin`='%d',`unixend`='%d',`unixstart`='%d' WHERE `newid` = '%d'", PromoInfo[pf][roUnixcreate], PromoInfo[pf][roUnixbegin], PromoInfo[pf][roUnixend], PromoInfo[pf][roUnixstart], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 8: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `level` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roLevel], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 9: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `text` = '%e' WHERE `newid` = '%d'", PromoInfo[pf][roText], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 10: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `number` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roNumber], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 11: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `roinsert` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roInsert], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		case 12: mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_promo` SET `voice` = '%d' WHERE `newid` = '%d'", PromoInfo[pf][roVoice], PromoInfo[pf][roNewid]), query_empty(pearsq, string_mysql);
		default: {}
	}
  	return 1;
}
