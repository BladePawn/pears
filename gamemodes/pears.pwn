				rultime[rt] = 0;
				UpdateDynamic3DTextLabelText(RuletText[rt],0xA9C4E4FF,"{ff9000}Рулетка\n{cccccc}ALT - Играть\n{cccccc}ENTER - выйти");
	   		}
    	}
    }
	GlobalTickTimer = GetTickCount() - tickTimer;

	OrganInfo[0][gstat2] = RealPlayersOnline;
	CheckMaxdayOnline(); // Записываем максимальный онлайн

	// Старый мониторинг
	if(RealPlayersOnline > monitoring_online[0]) monitoring_online[0] = RealPlayersOnline;
    return 1;
}

stock SaveCapt(idx)
{
	new string_mysql[400];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_organization` SET \
    capt0 = %d, capt1 = %d, capt2 = %d, capt3 = %d, capt4 = %d, capt5 = %d, capt6 = %d, capt7 = %d, capt8 = %d, capt9 = %d, capt10 = %d, capt11 = %d, capt12 = %d \
	WHERE `frakid` = %d",
	OrganInfo[idx][gCapture][0],OrganInfo[idx][gCapture][1], OrganInfo[idx][gCapture][2],OrganInfo[idx][gCapture][3],OrganInfo[idx][gCapture][4],
	OrganInfo[idx][gCapture][5],OrganInfo[idx][gCapture][6],OrganInfo[idx][gCapture][7],OrganInfo[idx][gCapture][8],OrganInfo[idx][gCapture][9],
	OrganInfo[idx][gCapture][10],OrganInfo[idx][gCapture][11],OrganInfo[idx][gCapture][12],
	idx);
	query_empty(pearsq, string_mysql);
	return true;
}
stock capt_win(g)
{
	if(CaptInfo[cCbug] == 0) OrganInfo[g][gCapture][1] ++, OrganInfo[g][gCapture][2] ++;
	else if(CaptInfo[cCbug] == 1) OrganInfo[g][gCapture][3] ++, OrganInfo[g][gCapture][4] ++;
	SaveCapt(g);
	UpdateHonor(0);
	UpdateHonor(1);
	return 1;
}
stock capt_loose(g)
{
	if(CaptInfo[cCbug] == 0) OrganInfo[g][gCapture][5] ++, OrganInfo[g][gCapture][6] ++;
	else if(CaptInfo[cCbug] == 1) OrganInfo[g][gCapture][7] ++, OrganInfo[g][gCapture][8] ++;
	SaveCapt(g);
	UpdateHonor(0);
	UpdateHonor(2);
	return 1;
}
stock UpdatePlayerHonor(stat)
{
	new string[36];
	if(stat == 1)
	{
		for(new i = 0; i < 5; i++)
		{
			if(TopInfo[i][tWar][0] == 0) format(string,sizeof(string),"...");
			else format(string,sizeof(string),"%s: %d",TopInfo[i][tWarNameK], TopInfo[i][tWar][0]);
			SetDynamicObjectMaterialText(bandobj[i + 1], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		}
	}
	else if(stat == 2)
	{
		for(new i = 0; i < 5; i++)
		{
			if(TopInfo[i][tWar][0] == 0) format(string,sizeof(string),"...");
			else format(string,sizeof(string),"%s: %d",TopInfo[i][tWarNameB], TopInfo[i][tWar][1]);
			SetDynamicObjectMaterialText(bandobj[i + 7], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		}
	}
	else if(stat == 3)
	{
		for(new i = 0; i < 5; i++)
		{
			if(TopInfo[i][tWar][0] == 0) format(string,sizeof(string),"...");
			else format(string,sizeof(string),"%s: %d",TopInfo[i][tWarNameS], TopInfo[i][tWar][2]);
			SetDynamicObjectMaterialText(bandobj[i + 13], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		}
	}
	return 1;
}
stock UpdateHonor(stat)
{
	new string[34];
    if(stat == 0)
    {
    	new zgang[4];
		for(new z = 0; z < GZONES; z++)
		{
			if(GZInfo[z][gFrakVlad] == 13) zgang[0] ++;
			if(GZInfo[z][gFrakVlad] == 14) zgang[1] ++;
			if(GZInfo[z][gFrakVlad] == 15) zgang[2] ++;
			if(GZInfo[z][gFrakVlad] == 16) zgang[3] ++;
		}
		format(string,sizeof(string),"Война №: %d\nТерритории: %d", ServerInfo[41], zgang[0]);
		SetDynamicObjectMaterialText(gangobj[1], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"Война №: %d\nТерритории: %d", ServerInfo[41], zgang[1]);
		SetDynamicObjectMaterialText(gangobj[5], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"Война №: %d\nТерритории: %d", ServerInfo[41], zgang[2]);
		SetDynamicObjectMaterialText(gangobj[9], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"Война №: %d\nТерритории: %d", ServerInfo[41], zgang[3]);
		SetDynamicObjectMaterialText(gangobj[13], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
	}
	else if(stat == 1)
    {
		format(string,sizeof(string),"\nПобеды: %d",OrganInfo[13][gCapture][1]+OrganInfo[13][gCapture][3]);
		SetDynamicObjectMaterialText(gangobj[2], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"\nПобеды: %d",OrganInfo[14][gCapture][1]+OrganInfo[14][gCapture][3]);
		SetDynamicObjectMaterialText(gangobj[6], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"\nПобеды: %d",OrganInfo[15][gCapture][1]+OrganInfo[15][gCapture][3]);
		SetDynamicObjectMaterialText(gangobj[10], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"\nПобеды: %d",OrganInfo[16][gCapture][1]+OrganInfo[16][gCapture][3]);
		SetDynamicObjectMaterialText(gangobj[14], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
	}
	else if(stat == 2)
    {
		format(string,sizeof(string),"\nПоражения: %d",OrganInfo[13][gCapture][5]+OrganInfo[13][gCapture][7]);
		SetDynamicObjectMaterialText(gangobj[3], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"\nПоражения: %d",OrganInfo[14][gCapture][5]+OrganInfo[14][gCapture][7]);
		SetDynamicObjectMaterialText(gangobj[7], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"\nПоражения: %d",OrganInfo[15][gCapture][5]+OrganInfo[15][gCapture][7]);
		SetDynamicObjectMaterialText(gangobj[11], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
		format(string,sizeof(string),"\nПоражения: %d",OrganInfo[16][gCapture][5]+OrganInfo[16][gCapture][7]);
		SetDynamicObjectMaterialText(gangobj[15], 0, string, 120, "Lucida Sans Unicode", 35, 1, 0xFFFFFFFF, 0x00000000, 0);
	}
	return 1;
}
stock SavePlayerCapt(playerid) // Сохраняем все капты в Online
{
	new string_mysql[500 + 40 * 2 * MAX_GANG_CAPT_STATA];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki` SET `MyWar`='%d',", PlayerInfo[playerid][pMyWar]);

	new part[40];
	for(new idx = 0; idx < MAX_GANG_CAPT_STATA; idx++)
	{
		format(part, sizeof(part), "`GangCapt%d`='%d',", idx, PlayerInfo[playerid][pGangCapt][idx]);
		strcat(string_mysql, part);

		format(part, sizeof(part), "`GangAll%d`='%d'%s", idx, PlayerInfo[playerid][pGangAll][idx], (idx < MAX_GANG_CAPT_STATA - 1) ? "," : "");
		strcat(string_mysql, part);
	}

	format(part, sizeof(part), " WHERE `user_id`='%d'", PlayerInfo[playerid][pID]);
	strcat(string_mysql, part);

	query_empty(pearsq, string_mysql);
	return 1;
}
stock SavePlayerTemp(playerid) // Сохраняем временный капт
{
	new string_mysql[300 + 64 * MAX_GANG_CAPT_STATA];

	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki` SET `MyCapt`='%d',", ServerInfo[42]);

	new part[64];
	for(new idx = 0; idx < MAX_GANG_CAPT_STATA; idx++) 
	{
		format(part, sizeof(part), "`GangTemp%d`='%d'%s", idx, PlayerInfo[playerid][pGangTemp][idx], (idx < MAX_GANG_CAPT_STATA - 1) ? "," : "");
		strcat(string_mysql, part);
	}

	format(part, sizeof(part), " WHERE `user_id`='%d'", PlayerInfo[playerid][pID]);
	strcat(string_mysql, part);
	query_empty(pearsq, string_mysql);
	return 1;
}
function call_topcapt(stat)
{
	new rows;
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		if(stat == 1) cache_get_value_name(i, "Name", TopInfo[i][tWarNameK], 20), cache_get_value_name_int(i, "GangCapt0", TopInfo[i][tWar][0]);
		else if(stat == 2) cache_get_value_name(i, "Name", TopInfo[i][tWarNameB], 20), cache_get_value_name_int(i, "GangCapt4", TopInfo[i][tWar][1]);
		else if(stat == 3) cache_get_value_name(i, "Name", TopInfo[i][tWarNameS], 20), cache_get_value_name_int(i, "GangCapt1", TopInfo[i][tWar][2]);

		else if(stat == 4) cache_get_value_name(i, "Name", TopInfo[i][tAWarNameK], 20), cache_get_value_name_int(i, "GangAll0", TopInfo[i][tAWar][0]);
		else if(stat == 5) cache_get_value_name(i, "Name", TopInfo[i][tAWarNameB], 20), cache_get_value_name_int(i, "GangAll4", TopInfo[i][tAWar][1]);
		else if(stat == 6) cache_get_value_name(i, "Name", TopInfo[i][tAWarNameS], 20), cache_get_value_name_int(i, "GangAll1", TopInfo[i][tAWar][2]);
	}
	if(stat == 1) UpdatePlayerHonor(1);
	else if(stat == 2) UpdatePlayerHonor(2);
	else if(stat == 3) UpdatePlayerHonor(3);
	return 1;
}
stock TopKiller()
{
	new string[220];
	mysql_format(pearsq, string,sizeof(string),"SELECT Name, GangCapt0, GangCapt1, GangCapt4, GangAll0, GangAll1, GangAll4 \
		FROM `pp_igroki` WHERE `GangCapt0`>'0' AND `MyWar`='%d' ORDER BY `GangCapt0` DESC LIMIT 5", ServerInfo[41]);
	mysql_tquery(pearsq, string, "call_topcapt", "d", 1);

	mysql_format(pearsq, string,sizeof(string),"SELECT Name, GangCapt0, GangCapt1, GangCapt4, GangAll0, GangAll1, GangAll4 \
		FROM `pp_igroki` WHERE `GangCapt4`>'0' AND `MyWar`='%d' ORDER BY `GangCapt4` DESC LIMIT 5", ServerInfo[41]);
	mysql_tquery(pearsq, string, "call_topcapt", "d", 2);

	mysql_format(pearsq, string,sizeof(string),"SELECT Name, GangCapt0, GangCapt1, GangCapt4, GangAll0, GangAll1, GangAll4 \
		FROM `pp_igroki` WHERE `GangCapt1`>'0' AND `MyWar`='%d' ORDER BY `GangCapt1` DESC LIMIT 5", ServerInfo[41]);
	mysql_tquery(pearsq, string, "call_topcapt", "d", 3);



	mysql_tquery(pearsq, "SELECT Name, GangCapt0, GangCapt1, GangCapt4, GangAll0, GangAll1, GangAll4 \
		FROM `pp_igroki` WHERE `GangAll0`>'0' ORDER BY `GangAll0` DESC LIMIT 5", "call_topcapt", "d", 4);
	mysql_tquery(pearsq, "SELECT Name, GangCapt0, GangCapt1, GangCapt4, GangAll0, GangAll1, GangAll4 \
		FROM `pp_igroki` WHERE `GangAll4`>'0' ORDER BY `GangAll4` DESC LIMIT 5", "call_topcapt", "d", 5);
	mysql_tquery(pearsq, "SELECT Name, GangCapt0, GangCapt1, GangCapt4, GangAll0, GangAll1, GangAll4 \
		FROM `pp_igroki` WHERE `GangAll1`>'0' ORDER BY `GangAll1` DESC LIMIT 5", "call_topcapt", "d", 6);
	return 1;
}
stock IsATopName(const str_name[])
{
	new yes = 0;
	for(new i = 0; i < 5; i++)
	{
		if(strfind(str_name,TopInfo[i][tWarNameK],true) || strfind(str_name,TopInfo[i][tWarNameB],true)
		|| strfind(str_name,TopInfo[i][tWarNameS],true)
		|| strfind(str_name,TopInfo[i][tAWarNameK],true) || strfind(str_name,TopInfo[i][tAWarNameB],true)
		|| strfind(str_name,TopInfo[i][tAWarNameS],true))
		{
			yes = 1;
		}
	}
	if(yes == 1) TopKiller();
	return 1;
}

stock CheckMafKill(playerid, killerid, g) // Стрела
{
	YjeSdoh[playerid] = 1;
	if(MafGz[g][mStat] >= 2) // Если на каких-то идёт битва
	{
		if(IsPlayerInSquare(playerid,MafGz[g][mCoords][0],MafGz[g][mCoords][1],MafGz[g][mCoords][2],MafGz[g][mCoords][3])
		&& IsPlayerInSquare(killerid,MafGz[g][mCoords][0],MafGz[g][mCoords][1],MafGz[g][mCoords][2],MafGz[g][mCoords][3])) // Игрок и убийца на терре
		{
			if((PlayerInfo[playerid][pMember] == MafGz[g][mNapad] || PlayerInfo[playerid][pLeader] == MafGz[g][mNapad]) && (PlayerInfo[killerid][pMember] == MafGz[g][mZashita] || PlayerInfo[killerid][pLeader] == MafGz[g][mZashita])) { MafGz[g][mKillz]++; }// Если тот, кто умер был нападающим, даём плюс защищающимся
			else if((PlayerInfo[playerid][pMember] == MafGz[g][mZashita] || PlayerInfo[playerid][pLeader] == MafGz[g][mZashita]) && (PlayerInfo[killerid][pMember] == MafGz[g][mNapad] || PlayerInfo[killerid][pLeader] == MafGz[g][mNapad])) { MafGz[g][mKilln]++; }// Если тот, кто умер был защищающимся, даём плюс нападающим
		}
	}
 	CheckMafWar(0, 0);
	return 1;
}

stock PeoplePlayerMafWar(g, &knap, &kzas)
{
	foreach(Player,i)
	{
		if(gMifga[i] == g) // Все кто участвует в битве - все у кого чекер вкл
		{
			if(IsPlayerInSquare(i,MafGz[g][mCoords][0],MafGz[g][mCoords][1],MafGz[g][mCoords][2],MafGz[g][mCoords][3]) 
				&& YjeSdoh[i] == 0) // Все кто на территории зоны
			{
				if(PlayerInfo[i][pLeader] == MafGz[g][mNapad] || PlayerInfo[i][pMember] == MafGz[g][mNapad]) knap++; // Подсчёт нападающих на зоне
				if(PlayerInfo[i][pLeader] == MafGz[g][mZashita] || PlayerInfo[i][pMember] == MafGz[g][mZashita]) kzas++; // Подсчёт нападающих на зоне
			}
		}
	}
	return 1;
}

stock WinMoneyMafWar(g, money)
{
	bigint_add(OrganInfo[g][glave], money);
	OrganInfo[g][gUpdate] = 1;

	new string[160];
	format(string,sizeof(string),"{0088ff}[ Mafia War ]: Вы выиграли! {ffcc66}Деньги в размере {99ff66}%d$ {ffcc66}начислены в ваш общак", money);
	SendRadioMessage(g,COLOR_LIGHTRED,string);

	return 1;
}

stock LooseMoneyMafWar(g, money)
{
	bigint_sub(OrganInfo[g][glave], money);
	OrganInfo[g][gUpdate] = 1;

	new string[160];
	format(string,sizeof(string),"{0088ff}[ Mafia War ]: Вы проиграли! {ffcc66}Деньги в размере {FF6347}%d$ {ffcc66}списаны со счёта мафии", money);
	SendRadioMessage(g,COLOR_LIGHTRED,string);
	return 1;
}

stock WinBizMafWar(g, b)
{
	BizzInfo[b][bMafia] = g;
	BizzInfo[b][bZahv] --;
	BizzInfo[b][bMafunix] = gettime();
	if(BizzInfo[b][bLab] == 1) UpdateBizLabel(b, BizzInfo[b][bLab]);
	SaveBizz(b);
	new string[160];
	format(string,sizeof(string),"{0088ff}[ Mafia War ]: Вы выиграли! {ffcc66}Бизнес {99ff66}%s {ffcc66}теперь принадлежит вашей мафии",bizname(b));
	SendRadioMessage(g,COLOR_LIGHTRED,string);
	return 1;
}

stock LooseBizMafWar(g, b, newg)
{
	new string[160];
	format(string,sizeof(string),"{0088ff}[ Mafia War ]: Вы проиграли! {ffcc66}Бизнес {FF6347}%s {ffcc66}теперь принадлежит %s", bizname(b), frakeasyName[newg]);
	SendRadioMessage(g,COLOR_LIGHTRED,string);
	return 1;
}

stock ClearMafWar(m) // Очищаем переменные мафиозной стрелы, удаляем зону и удаляем чекер
{
	MafGz[m][mStat] = 0;
	Strel[MafGz[m][mZashita]] = 0, Strel[MafGz[m][mNapad]] = 0;
	GangZoneHideForAll(MafGz[m][mID]);
	GangZoneDestroy(MafGz[m][mID]);

	foreach(Player,i)
	{
		if(gMifga[i] == m) GiveUnit(i,19), DelMaf(i), ClearDeathBox(i, 5);
	}

	if(MafGz[m][mZone]) 
	{
		DestroyDynamicArea(MafGz[m][mZone]);
		MafGz[m][mZone] = 0;
	}
	return 1;
}

stock CreateMafWarZone(g) // Создаём динамическую зону мафиозной стрелы
{
	if(MafGz[g][mZone]) DestroyDynamicArea(MafGz[g][mZone]);
    MafGz[g][mZone] = CreateDynamicCube(MafGz[g][mCoords][0],MafGz[g][mCoords][1], MafGz[g][mZ] - 200.0, MafGz[g][mCoords][2],MafGz[g][mCoords][3], MafGz[g][mZ] + 200.0, 0, 0);
    return 1;
}

stock CheckMafWar(g, stat) // Проверка, кто в итоге выиграл
{
	if(MafGz[g][mStat] >= 2) // Если на каких-то идёт битва
	{
		new knap, kzas;
		PeoplePlayerMafWar(g, knap, kzas);

		if(stat == 1) // Админский Stop
		{
		    if(MafGz[g][mZashita] >= 1) SendRadioMessage(MafGz[g][mZashita],COLOR_LIGHTRED,"{0088ff}[ Mafia War ]: Отмена! {ffcc66}Администратор отменил стрелу");
			if(MafGz[g][mNapad] >= 1) SendRadioMessage(MafGz[g][mNapad],COLOR_LIGHTRED,"{0088ff}[ Mafia War ]: Отмена! {ffcc66}Администратор отменил стрелу");
			ClearMafWar(g);
		    return 1;
		}
		if(knap == 0 && kzas == 0) // Ничья
		{
			if(MafGz[g][mZashita] >= 1) SendRadioMessage(MafGz[g][mZashita],COLOR_LIGHTRED,"{0088ff}[ Mafia War ]: Ничья! {ffcc66}Ставки каждой мафии аннулировались");
			if(MafGz[g][mNapad] >= 1) SendRadioMessage(MafGz[g][mNapad],COLOR_LIGHTRED,"{0088ff}[ Mafia War ]: Ничья! {ffcc66}Ставки каждой мафии аннулировались");
			ClearMafWar(g);
			return 1;
		}
		if(knap == 0) // Проебали нападающие
		{
			if(MafGz[g][mVidn] == 2) // Нападающие играли на деньги
			{
				LooseMoneyMafWar(MafGz[g][mNapad], MafGz[g][mKoln]); // Забираем бабки у нападающих
				WinMoneyMafWar(MafGz[g][mZashita], MafGz[g][mKoln]); // Даём бабки защищающимся
			}
			else if(MafGz[g][mVidn] <= 1) // Нападающие играли на бизнес
			{
				LooseBizMafWar(MafGz[g][mNapad], MafGz[g][mKoln], MafGz[g][mZashita]); // Забираем бизнес у нападающих
				WinBizMafWar(MafGz[g][mZashita], MafGz[g][mKoln]); // Даём бизнес защищающимся
			}
			
			GiveFractionContinentalCoins(MafGz[g][mNapad], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_LOSE]);
			OrgLog(MafGz[g][mNapad], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_LOSE], "Проигрыш в стреле");
			GiveFractionContinentalCoins(MafGz[g][mZashita], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_WIN]);
			OrgLog(MafGz[g][mZashita], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_WIN], "Победа в стреле");

			foreach (new targetid : Player)
			{
				if (!IsPlayerInDynamicArea(targetid, MafGz[g][mZone])) continue;
				if (fraction(targetid) == MafGz[g][mZashita])
				{
					new amount = OrganInfo[MafGz[g][mZashita]][gcontinentalrewards][_:CONTINENTAL_PLAYER_ACTION_SHOOT_WIN];
					GivePlayerContinentalCoins(targetid, amount);
					OrgLog(MafGz[g][mZashita], "paycontinental", 0, "", "", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], amount, "Награда за победу в стреле");
				}
			}

			ClearMafWar(g);
			return 1;
		}
		else if(kzas == 0) // Проебали защищающиеся
		{
			if(MafGz[g][mVidz] == 2) // защищающиеся играли на деньги
			{
				LooseMoneyMafWar(MafGz[g][mZashita], MafGz[g][mKolz]); // Забираем бабки у защищающихся
				WinMoneyMafWar(MafGz[g][mNapad], MafGz[g][mKolz]); // Даём бабки нападающим
			}
			else if(MafGz[g][mVidz] <= 1) // защищающиеся играли на бизнес
			{
				LooseBizMafWar(MafGz[g][mZashita], MafGz[g][mKolz], MafGz[g][mNapad]); // Забираем бизнес у защищающихся
				WinBizMafWar(MafGz[g][mNapad], MafGz[g][mKolz]); // Даём бизнес нападающим
			}

			GiveFractionContinentalCoins(MafGz[g][mZashita], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_LOSE]);
			OrgLog(MafGz[g][mZashita], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_LOSE], "Проигрыш в стреле");
			GiveFractionContinentalCoins(MafGz[g][mNapad], ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_WIN]);
			OrgLog(MafGz[g][mNapad], "giveorgcontinental", 0, "", "", 0, "", "", ContinentalCoinInfo[cciRewards][_:CONTINENTAL_ACTION_SHOOT_WIN], "Победа в стреле");

			foreach (new targetid : Player)
			{
				if (!IsPlayerInDynamicArea(targetid, MafGz[g][mZone])) continue;
				if (fraction(targetid) == MafGz[g][mNapad])
				{
					new amount = OrganInfo[MafGz[g][mNapad]][gcontinentalrewards][_:CONTINENTAL_PLAYER_ACTION_SHOOT_WIN];
					GivePlayerContinentalCoins(targetid, amount);
					OrgLog(MafGz[g][mNapad], "paycontinental", 0, "", "", PlayerInfo[targetid][pID], PlayerInfo[targetid][pName], PlayerInfo[targetid][pPlaIP], amount, "Награда за победу в стреле");
				}
			}

			ClearMafWar(g);
			return 1;
		}
	}
	return 1;
}

stock UpdateMafWar(playerid) //+
{
	if(OnlineInfo[playerid][oLogged] >= 1)
    {
		new g = gMifga[playerid];
		if(MafGz[g][mStat] == 1) // Подготовка к Битве
		{
	  		new sotring[24];
		 	if(MafGz[g][mTimer] >= 61)
		 	{
		 		new mina = MafGz[g][mTimer]/60;
		 		new ostatok = MafGz[g][mTimer]-mina*60;
		 		format(sotring, sizeof(sotring), "%02d:%02d", MafGz[g][mTimer]/60, ostatok);
 		 	}
 		 	else format(sotring, sizeof(sotring), "00:%02d", MafGz[g][mTimer]);
         	PlayerTextDrawSetString(playerid, PlayerGangDraw[9][playerid], sotring);
         	PlayerTextDrawShow(playerid, PlayerGangDraw[9][playerid]);
		}
	    else if(MafGz[g][mStat] >= 2)
		{
	         if(PlayerInfo[playerid][pMember] == MafGz[g][mNapad] || PlayerInfo[playerid][pLeader] == MafGz[g][mNapad]) // Если обновляем тому, кто нападает
	         {
	            new string[24];
			    format(string, sizeof(string), "%02d", MafGz[g][mKilln]);
			    PlayerTextDrawSetString(playerid, PlayerGangDraw[7][playerid], string);

	            new sctring[24];
	            format(sctring, sizeof(sctring), "%02d", MafGz[g][mKillz]);
			    PlayerTextDrawSetString(playerid, PlayerGangDraw[8][playerid], sctring);
	         }
	         if(PlayerInfo[playerid][pMember] == MafGz[g][mZashita] || PlayerInfo[playerid][pLeader] == MafGz[g][mZashita]) // Если обновляем тому, кто защищается
	         {
	            new string[24];
			    format(string, sizeof(string), "%02d", MafGz[g][mKillz]);
			    PlayerTextDrawSetString(playerid, PlayerGangDraw[7][playerid], string);

	            new sctring[24];
	            format(sctring, sizeof(sctring), "%02d", MafGz[g][mKilln]);
			    PlayerTextDrawSetString(playerid, PlayerGangDraw[8][playerid], sctring);
	         }
	         PlayerTextDrawShow(playerid, PlayerGangDraw[7][playerid]);
             PlayerTextDrawShow(playerid, PlayerGangDraw[8][playerid]);
		}
	}
	return 1;
}
stock procesbar(playerid, stat, draw) //+
{
	if(stat == 0)
	{
		if(draw == 0) PlayerTextDrawHide(playerid, PlayerGangDraw[5][playerid]);
		else PlayerTextDrawHide(playerid, PlayerGangDraw[6][playerid]);
		return 1;
	}
	new Float:plusik = stat*((29.866666+PlayerInfo[playerid][pDrawSize_Y][0]/2)/300); // - для максимального показателя 300: 29.866666+PlayerInfo[playerid][pDrawSize_Y][0]/2;
	if(draw == 0)
	{
		if(stat <= 299) PlayerTextDrawTextSize(playerid, PlayerGangDraw[5][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, plusik);
		else PlayerTextDrawTextSize(playerid, PlayerGangDraw[5][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, 29.866666+PlayerInfo[playerid][pDrawSize_Y][0]/2);
		PlayerTextDrawShow(playerid, PlayerGangDraw[5][playerid]);
	}
	else
	{
		if(stat <= 299) PlayerTextDrawTextSize(playerid, PlayerGangDraw[6][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, plusik);
		else PlayerTextDrawTextSize(playerid, PlayerGangDraw[6][playerid], 33.743377+PlayerInfo[playerid][pDrawSize_X][0]/2, 29.866666+PlayerInfo[playerid][pDrawSize_Y][0]/2);
		PlayerTextDrawShow(playerid, PlayerGangDraw[6][playerid]);
	}
	return 1;
}
stock UpdateGangZone(playerid) //+
{
	if(OnlineInfo[playerid][oLogged] >= 1)
	{
		if(CaptInfo[cCaptStat] == true)
		{
			if(PlayerInfo[playerid][pMember] == CaptInfo[cAttack] || PlayerInfo[playerid][pLeader] == CaptInfo[cAttack]) // Если обновляем тому, кто нападает
			{
				new string[24];
				format(string, sizeof(string), "%02d", CaptInfo[cKillA]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[7][playerid], string);

				new sctring[24];
				format(sctring, sizeof(sctring), "%02d", CaptInfo[cKillD]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[8][playerid], sctring);
				// procesbar(playerid, CaptInfo[cPresenceA], 0);
				// procesbar(playerid, CaptInfo[cPresenceD], 1);
				procesbar(playerid, 0, 0);
				procesbar(playerid, 0, 1);

				format(sctring, sizeof(sctring), "%d", CaptInfo[cQuanityA]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[10][playerid], sctring);
				format(sctring, sizeof(sctring), "%d", CaptInfo[cQuanityD]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[11][playerid], sctring);
			}
			if(PlayerInfo[playerid][pMember] == CaptInfo[cDefend] || PlayerInfo[playerid][pLeader] == CaptInfo[cDefend]) // Если обновляем тому, кто защищается
			{
				new string[24];
				format(string, sizeof(string), "%02d", CaptInfo[cKillD]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[7][playerid], string);

				new sctring[24];
				format(sctring, sizeof(sctring), "%02d", CaptInfo[cKillA]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[8][playerid], sctring);
				// procesbar(playerid, CaptInfo[cPresenceD], 0);
				// procesbar(playerid, CaptInfo[cPresenceA], 1);
				procesbar(playerid, 0, 0);
				procesbar(playerid, 0, 1);

				format(sctring, sizeof(sctring), "%d", CaptInfo[cQuanityD]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[10][playerid], sctring);
				format(sctring, sizeof(sctring), "%d", CaptInfo[cQuanityA]);
				PlayerTextDrawSetString(playerid, PlayerGangDraw[11][playerid], sctring);
			}
			new sotring[24];
			format(sotring, sizeof(sotring), "%d", PlayerInfo[playerid][pGangTemp][0]+PlayerInfo[playerid][pGangTemp][1]);
			PlayerTextDrawSetString(playerid, PlayerGangDraw[13][playerid], sotring);
			format(sotring, sizeof(sotring), "%d", PlayerInfo[playerid][pGangTemp][4]);
			PlayerTextDrawSetString(playerid, PlayerGangDraw[14][playerid], sotring);
			if(CaptInfo[cTime] >= 61)
			{
				new mina = CaptInfo[cTime]/60;
				new ostatok = CaptInfo[cTime]-mina*60;
				format(sotring, sizeof(sotring), "%02d:%02d", CaptInfo[cTime]/60, ostatok);
			}
			else format(sotring, sizeof(sotring), "00:%02d", CaptInfo[cTime]);
			PlayerTextDrawSetString(playerid, PlayerGangDraw[9][playerid], sotring);
			PlayerTextDrawShow(playerid, PlayerGangDraw[7][playerid]);
			PlayerTextDrawShow(playerid, PlayerGangDraw[8][playerid]);
			PlayerTextDrawShow(playerid, PlayerGangDraw[9][playerid]);
			PlayerTextDrawShow(playerid, PlayerGangDraw[10][playerid]);
			PlayerTextDrawShow(playerid, PlayerGangDraw[11][playerid]);
			PlayerTextDrawShow(playerid, PlayerGangDraw[13][playerid]);
			PlayerTextDrawShow(playerid, PlayerGangDraw[14][playerid]);
		}
	}
	return 1;
}
function CloseVehSpeed(playerid)
{
	for(new s = 0; s < 11; s++) PlayerTextDrawHide(playerid, PlayerSpeedDraw[playerid][s]), PlayerTextDrawDestroy(playerid, PlayerSpeedDraw[playerid][s]);
	DrawSpeed[playerid] = false;
	return 1;
}
stock ShowVehSpeed(playerid)
{
    if(DrawSpeed[playerid] == false) LoadSpeedDraw(playerid);
    if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][8], 673720575);
	else PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][8], -1);
    PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][6], PlayerInfo[playerid][pStyle1]);
    PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][7], PlayerInfo[playerid][pStyle2]);
	PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][1]);
	PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][2]);
	PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][3]);
	UpdateVehEngine(playerid);
	CheckBenz(playerid);
	UpdateVehLock(playerid);
	CheckVehHealth(playerid);
}
stock UpdateVehEngine(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(PlayerInfo[playerid][pDrawVisible][7] == false && Cars[vehicleid] != 52 && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8 && DrawSpeed[playerid] == true)
		{
			if(VehInfo[vehicleid][vEngine] >= 1)
			{
			    if(PlayerInfo[playerid][pSLimit] >= 1) PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][5], -1523963137);
  				else PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][5], -1);
				PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][5]), PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][0]);
			}
   			else PlayerTextDrawHide(playerid, PlayerSpeedDraw[playerid][5]), PlayerTextDrawHide(playerid, PlayerSpeedDraw[playerid][0]);
		}
		if(PlayerInfo[playerid][pDrawVisible][9] == false && setting_pos_draw[playerid] != 10 && setting_size_draw[playerid] != 10)
		{
			if(VehInfo[vehicleid][vEngine] >= 1) HideVehiclePopup(playerid);
			else show_hint_player(playerid, vehicleid);
	    }
	    SpecInfo(playerid, 0, 0);
	}
	return 1;
}
stock UpdateVehLock(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && DrawSpeed[playerid] == true)
	{
		new v = GetPlayerVehicleID(playerid);
		if(VehInfo[v][vCarLock] >= 1) PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][4]);
		else PlayerTextDrawHide(playerid, PlayerSpeedDraw[playerid][4]);
	}
	return 1;
}
stock PosSpeedDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(PlayerInfo[playerid][pTypeSpeed] == 0)
    {
	    if(setting_pos_draw[playerid] == 8 || setting_size_draw[playerid] == 8) positiond_x = speeddraw_x+set_pos_x[playerid], positiond_y = speeddraw_y+set_pos_y[playerid];
	    else positiond_x = speeddraw_x+PlayerInfo[playerid][pDrawPos_X][7], positiond_y = speeddraw_y+PlayerInfo[playerid][pDrawPos_Y][7];

	    if(setting_pos_draw[playerid] == 8 || setting_size_draw[playerid] == 8) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	    else sized_x = PlayerInfo[playerid][pDrawSize_X][7], sized_y = PlayerInfo[playerid][pDrawSize_Y][7];

		new Float:vrem_x, Float:vrem_y;
	    PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][0], positiond_x+sized_x/4, positiond_y+16.762847+sized_y/2.4); // Текст: KM/H
	    PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][1], positiond_x-0.821185+sized_x/4, positiond_y+25.077783+sized_y/1.6); // Фон хп транспорта
	    PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][4], positiond_x+41.317187+sized_x, positiond_y+20.444458+sized_y/3.15); // Замочек (открыт или закрты транспорт)
	    PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][5], positiond_x+sized_x/4, positiond_y); // Спидометр
	    PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][6], positiond_x+0.178815+sized_x/4, positiond_y+26.077783+sized_y/1.6); // Полоска хп транспорта
	    
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][0], 0.156333+sized_x*(0.156333/50), 0.807704+sized_y*(0.807704/40));  // Текст: KM/H
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][1], 43.317187+sized_x, 13.199962+sized_y/2); // Фон хп транспорта
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][2], 6.38+sized_x/4, -33.266716-sized_y); // Фон топливо транспорта
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][3], 19.121261+sized_x, 22.033319+sized_y); // Канистра (логотип топлива)
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][4], 19.121261+sized_x, 21.933319+sized_y); // Замочек (открыт или закрты транспорт)
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][5], 0.405333+sized_x*(0.405333/50), 2.122667+sized_y*(2.122667/40)); // Спидометр
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][6], 41.317187+sized_x, 11.199962+sized_y/2); // Полоска хп транспорта
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][7], 4.38+sized_x/4, -31.266716-sized_y); // Полоска топливо транспорта
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][8], 0.094194+sized_x*(0.094194/20), 0.577999+sized_y*(0.577999/20)); // Хп транспорта

		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][1], vrem_x, vrem_y);
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][2], positiond_x-8.821185, vrem_y+13.199962+sized_y/2); // Фон топливо транспорта
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][7], positiond_x-7.821185, (vrem_y+13.199962+sized_y/2)-1.0); // Полоска топливо транспорта
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][2], vrem_x, vrem_y);
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][3], vrem_x-15.952054-sized_x/1.3, positiond_y+19.911132+sized_y/3.15); // Канистра (логотип топлива)
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][3], vrem_x, vrem_y);
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][9], vrem_x+((19.121261+sized_x)/100)*52, vrem_y+((21.933319+sized_y)/100)*41); // Топливо в транспорте
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][9], 0.094194+sized_x*(0.094194/20), 0.577999+sized_y*(0.577999/20)); // Топливо в транспорте
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][9], vrem_x, vrem_y);
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][8], positiond_x+2.846573+sized_x/4, vrem_y); // Хп транспорта
		
		// Картинка, которая показывает что у тачки мало хп и тачке пизда
		new Float:razm_left_x, Float:razm_left_y;
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][7], vrem_x, vrem_y);
		PlayerTextDrawGetTextSize(playerid, PlayerSpeedDraw[playerid][7], razm_left_x, razm_left_y);
		new Float:size_death_X = -37.117706-sized_x, Float:size_death_Y = 33.600013+sized_y;
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][10], vrem_x-size_death_X, vrem_y+razm_left_y-1.0);
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][10], size_death_X, size_death_Y);
	}
	else if(PlayerInfo[playerid][pTypeSpeed] == 1)
    {
        if(setting_pos_draw[playerid] == 8 || setting_size_draw[playerid] == 8) positiond_x = speeddraw2_x+set_pos_x[playerid], positiond_y = speeddraw2_y+set_pos_y[playerid];
	    else positiond_x = speeddraw2_x+PlayerInfo[playerid][pDrawPos_X][7], positiond_y = speeddraw2_y+PlayerInfo[playerid][pDrawPos_Y][7];

	    if(setting_pos_draw[playerid] == 8 || setting_size_draw[playerid] == 8) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
	    else sized_x = PlayerInfo[playerid][pDrawSize_X][7], sized_y = PlayerInfo[playerid][pDrawSize_Y][7];
	    
	    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[7], positiond_y += DrawPosSmart_Y[7], sized_y += DrawSizeSmart_Y[7];
	    
	    new Float:vrem_x, Float:vrem_y;
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][0], positiond_x, positiond_y+30.0+sized_y/2.4); // Текст: KM/H
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][1], positiond_x+30.0+sized_x/2, positiond_y+9.3); // Фон хп транспорта
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][2], positiond_x-30.0-sized_x/2, positiond_y+9.3); // Фон топливо транспорта
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][2], vrem_x, vrem_y);
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][3], vrem_x-80.0-sized_x/2-(29.751058+sized_x/2), vrem_y-3.0); // Канистра (логотип топлива)
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][1], vrem_x, vrem_y);
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][4], vrem_x+80.0+sized_x/2, vrem_y-5.5); // Замочек (открыт или закрты транспорт)
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][5], positiond_x, positiond_y-sized_y/12); // Спидометр
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][6], positiond_x+31.0+sized_x/2, positiond_y+10.3); // Полоска хп транспорта
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][7], positiond_x-31.0-sized_x/2, positiond_y+10.3); // Полоска топливо транспорта
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][8], positiond_x+34.0+sized_x/2+sized_x/12, positiond_y+9.3+4.4+sized_y/16); // Хп транспорта
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][9], positiond_x-34.0-sized_x/2-sized_x/12, positiond_y+9.3+4.4+sized_y/16); // Топливо в транспорте
		
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][0], 0.319666+sized_x*(0.319666/50), 1.259852+sized_y*(1.259852/40)); // Текст: KM/H
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][1], 80.0+sized_x/2, 22.0+sized_y/2); // Фон хп транспорта
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][2], -80.0-sized_x/2, 22.0+sized_y/2); // Фон топливо транспорта
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][3], 25.751058+sized_x/2, 27.585174+sized_y/2); // Канистра (логотип топлива)
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][4], 31.000036+sized_x/2, 33.185180+sized_y/2); // Замочек (открыт или закрты транспорт)
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][5], 0.661125+sized_x*(0.661125/50), 3.712963+sized_y*(3.712963/70)); // Спидометр
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][6], 78.0+sized_x/2, 20.0+sized_y/2); // Полоска хп транспорта
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][7], -78.0-sized_x/2, 20.0+sized_y/2); // Полоска топливо транспорта
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][8], 0.209666+sized_x*(0.209666/50), 1.219999+sized_y*(1.519999/40)); // Хп транспорта
		PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][9], 0.209666+sized_x*(0.209666/50), 1.219999+sized_y*(1.519999/40)); // Топливо в транспорте
		
		// Картинка, которая показывает что у тачки мало хп и тачке пизда
		new Float:razm_left_x, Float:razm_left_y;
		PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][6], vrem_x, vrem_y);
		PlayerTextDrawGetTextSize(playerid, PlayerSpeedDraw[playerid][6], razm_left_x, razm_left_y);
		new Float:size_death_X = razm_left_y-razm_left_y-razm_left_y, Float:size_death_Y = razm_left_y;
		PlayerTextDrawSetPos(playerid, PlayerSpeedDraw[playerid][10], vrem_x-size_death_X, vrem_y);
		PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][10], size_death_X, size_death_Y);
		
    }
	return 1;
}
stock LoadSpeedDraw(playerid)
{
	PlayerSpeedDraw[playerid][0] = CreatePlayerTextDraw(playerid, 163.496170, 380.918334, "KM/H");
	PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][0], 0.156333, 0.807704);
	if(PlayerInfo[playerid][pTypeSpeed] == 0) PlayerTextDrawAlignment(playerid, PlayerSpeedDraw[playerid][0], TEXT_DRAW_ALIGN:1);
	else if(PlayerInfo[playerid][pTypeSpeed] == 1) PlayerTextDrawAlignment(playerid, PlayerSpeedDraw[playerid][0], TEXT_DRAW_ALIGN:2);
	PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][0], -1);
	PlayerTextDrawUseBox(playerid, PlayerSpeedDraw[playerid][0], true);
	PlayerTextDrawBoxColour(playerid, PlayerSpeedDraw[playerid][0], 0);
	PlayerTextDrawSetShadow(playerid, PlayerSpeedDraw[playerid][0], 0);
	PlayerTextDrawSetOutline(playerid, PlayerSpeedDraw[playerid][0], 0);
	PlayerTextDrawBackgroundColour(playerid, PlayerSpeedDraw[playerid][0], 51);
	PlayerTextDrawFont(playerid, PlayerSpeedDraw[playerid][0], TEXT_DRAW_FONT:2);
	PlayerTextDrawSetProportional(playerid, PlayerSpeedDraw[playerid][0], true);

	PlayerSpeedDraw[playerid][1] = CreatePlayerTextDraw(playerid, 162.3, 389.233270, "srp0"); // Фон хп транспорта
