//----------------------------------[Emote]-----------------------------------------------
CMD:todo(playerid, const params[])
{
	if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	new string[350];
   	if(isamute(playerid) == 1) return 1;
	new arrCoords[2][250];
 	if(sscanf(params,"p<*>s[250]s[250]",arrCoords[0],arrCoords[1])) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Текст и одновременное действие [ /todo текст * действие ]");
 	if(NameTag[playerid] == true)
 	{
  		if(PlayerInfo[playerid][pSex]==1)format(string, sizeof(string), "%s -сказал Незнакомец, {C2A2DA}%s", arrCoords[0], arrCoords[1]);
  		else if(PlayerInfo[playerid][pSex]==2)format(string, sizeof(string), "%s -сказала Незнакомка, {C2A2DA}%s", arrCoords[0], arrCoords[1]);
	}
 	else
 	{
  		if(PlayerInfo[playerid][pSex]==1)format(string, sizeof(string), "%s -сказал %s[%d], {C2A2DA}%s", arrCoords[0], playername(playerid), playerid, arrCoords[1]);
  		else if(PlayerInfo[playerid][pSex]==2)format(string, sizeof(string), "%s -сказала %s[%d], {C2A2DA}%s", arrCoords[0], playername(playerid), playerid, arrCoords[1]);
	}
    ProxDetectorScream(30.0, playerid, string, COLOR_FADE1, COLOR_FADE2, COLOR_FADE3, COLOR_FADE4, COLOR_FADE5, COLOR_FADE5, true);
    SetPlayerChatBubble(playerid,arrCoords[0],COLOR_TALK_PLAYER,35.0,10000);
    new kolko;
    foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && playerid != i && ProxDetectorS(30.0, playerid, i) && GetPlayerState(i) != PLAYER_STATE_SPECTATING) kolko ++;
	}
    return 1;
}
CMD:do(playerid, const params[])
{
	if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
 	if(sscanf(params, "s[350]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выполненное действие [ /do действие ]");
 	new string[350];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	format(string, sizeof(string), "%s (%s)", params[0], playername(playerid));
	ProxDetectorScream(30.0, playerid, string, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, true);
	new kolko;
    foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 && playerid != i && ProxDetectorS(30.0, playerid, i) && GetPlayerState(i) != PLAYER_STATE_SPECTATING) kolko ++;
	}
	return 1;
}
CMD:me(playerid, const params[])
{
	if(sscanf(params, "s[350]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Текущее действие [ /me действие ]");
	new string[350];
	if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
	{
		if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
		if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
		if(isamute(playerid) == 1) return 1;
		if(AntiFloodText(playerid, params[0])) return 1;

		format(string, sizeof(string), "%s", params[0]);
		SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
		format(string, sizeof(string), "* %s %s", playername(playerid), params[0]);
		ProxDetectorScream(30.0, playerid, string, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, true);
		new kolko;
	    foreach (Player, i)
		{
			if(OnlineInfo[i][oLogged] == 1 && playerid != i && ProxDetectorS(30.0, playerid, i) && GetPlayerState(i) != PLAYER_STATE_SPECTATING) kolko ++;
		}
	}
	return 1;
}

alias:rme("ame")
CMD:rme(playerid, const params[])
{
	if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
