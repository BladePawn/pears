stock CheckResetPassowrd(playerid)
{
	if(OnlineInfo[playerid][oProcessPassword] == true) return ShowDialog(playerid,219,DIALOG_STYLE_MSGBOX,"{ff9000}Pears Project","{ff9000}Смена пароля...","*","");
	return 1;
}

// Отображаем главный логотип сервера при входе в игру
stock ShowMainLogoServer(playerid)
{
	if(IsPlayerSyncModels(playerid)) TextDrawShowForPlayer(playerid, NameServerDraw[2]); // С лаунчером, кастомный логотип
	else TextDrawShowForPlayer(playerid, NameServerDraw[0]), TextDrawShowForPlayer(playerid, NameServerDraw[1]); // Без лаунчера, дефолтный
	return 1;
}

// Закрываем главный логотип сервера
stock HideMainLogoServer(playerid)
{
	if(IsPlayerSyncModels(playerid)) TextDrawHideForPlayer(playerid, NameServerDraw[2]); // С лаунчером, кастомный логотип
	else TextDrawHideForPlayer(playerid, NameServerDraw[0]), TextDrawHideForPlayer(playerid, NameServerDraw[1]); // Без лаунчера, дефолтный
	return 1;
}

stock ClearList(playerid)
{
	for(new i = 0; i < 200; i++) List[i][playerid] = 0, ListParam[i][playerid] = 0; // Очищаем List
	return 1;
}

stock HideVehiclePopup(playerid)
{
	if(PlayerInfo[playerid][pDrawVisible][9] == false)
	{
		if(IsPlayerSyncModels(playerid))
		{
			HidePlayerHudPopup(playerid);
		}
		else
		{
			if(setting_pos_draw[playerid] != 10 && setting_size_draw[playerid] != 10) HideOldHint(playerid);
		}
	}
	return 1;
}

stock HideOldHint(playerid)
{
	PlayerTextDrawHide(playerid, PlayerHintDraw[0][playerid]), PlayerTextDrawHide(playerid, PlayerHintDraw[1][playerid]);
	return 1;
}

// Анимация анти ДМ
stock AnimationAntiDM(playerid)
{
	if((!IsPlayerInAnyVehicle(playerid) && Iamzz[playerid] || Stun[4][playerid] >= 1 && MPGO[playerid] == 0) && NoAnim[playerid] == 0)
	{
		new animname[32], animlib[32];
		GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
		if(strcmp(animlib, "PARACHUTE", true) == 0 && strcmp(animname, "FALL_skyDive", true) == 0
		|| strcmp(animlib, "PARACHUTE", true) == 0 && strcmp(animname, "FALL_SkyDive_Accel", true) == 0
		|| strcmp(animlib, "PARACHUTE", true) == 0 && strcmp(animname, "FALL_SkyDive_L", true) == 0
		|| strcmp(animlib, "PARACHUTE", true) == 0 && strcmp(animname, "FALL_SkyDive_R", true) == 0
		|| strcmp(animlib, "SWIM", true) == 0
		|| GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DRINK_BEER || GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_SMOKE_CIGGY 
		|| GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DRINK_WINE || Hold[playerid] == 3) { }
		else
		{
			ApplyAnimation(playerid,"PED","fucku",4.0, false, false, false, false, false);
			return true;
		}
	}
	if(PoliceStick[1][playerid] >= 1 && !howstun(playerid))
	{
		ApplyAnimation(playerid,"COLT45","COLT45_RELOAD",4.0, false, false, false, false, false, SYNC_ALL);
		PlayerPlaySound(playerid, 36401, 0.0, 0.0, 0.0);
		return true;
	}
	return false;
}

stock CheckEnterVehicleInterior(playerid, vehicleid)
{
	if(VehInfo[vehicleid][vSittingPassenger] > 0)
	{
		ErrorMessage(playerid, "{FF6347}Вы не можете выполнить это действие, когда в транспорт садится пассажир\n{ffcc66}Если в транспорт никто не садится, подождите 5 сек и повторите попытку");
		return true;
	}

	if(VehInfo[vehicleid][vExitSeat] > 0)
	{
		ErrorMessage(playerid, "{FF6347}Вы не можете выполнить это действие, когда из транспорта выходит пассажир\n{ffcc66}Если из транспорта никто не выходит, подождите 5 сек и повторите попытку");
		return true;
	}
	return false;
}

// Записываем максимальный онлайн за сегодня
stock CheckMaxdayOnline()
{
	// Наступил другой день, тогда сбрасываем подсчёт
	new Days = getdate();
	if(Days != ServerInfo[67])
	{
		ServerInfo[67] = Days;
		ServerInfo[45] = OrganInfo[0][gstat2];

		SaveServer(67);
		SaveServer(45);
	}
	else // День тот же, тогда смотрит стал ли онлик выше
	{
		if(OrganInfo[0][gstat2] > ServerInfo[45])
		{
			ServerInfo[45] = OrganInfo[0][gstat2];
			SaveServer(45);
		}
	}
	return true;
}

stock Wupak(playerid)
{
	if(ServerInfo[68] > 0 && PlayerInfo[playerid][pID] == ServerInfo[68])
	{
		SetPlayerAttachedObject(playerid, 3, 19137, 2, 0.105000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 1.078000, 1.051999, 1.131999, 0, 0);
	}
	return true;
}


stock PlayAudioStreamAround(const url[], Float:x, Float:y, Float:z, worldid, interiorid, Float:radius)
{
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1 
			&& OnlineInfo[i][oListenRadioPears] == 0 
			&& !IsPlayerAfk(i)
			&& GetPlayerVirtualWorld(i) == worldid
			&& GetPlayerInterior(i) == interiorid)
		{
			if(GetPlayerDistanceFromPoint(i, x, y, z) <= radius) PlayAudioStreamForPlayer(i, url, x, y, z, radius,true);
		}
	}
	return true;
}

stock WupakSound(playerid)
{
	if(ServerInfo[68] > 0 && PlayerInfo[playerid][pID] == ServerInfo[68])
	{
		new Float:pla_pos[3];
    	GetPlayerPos(playerid, pla_pos[0],pla_pos[1],pla_pos[2]);
		PlayAudioStreamAround("https://cdn.pears.fun/sound/koko.mp3", 
			pla_pos[0],pla_pos[1],pla_pos[2], GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), 30.0);
	}
	return true;
}

CMD:wupak(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 19) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Гребешок для лучшего на сервере [ /wupak Номер Аккаунта ]");

	if(params[0] == 0) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Лучший на сервере {FF6347}Выключен");
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Лучший на сервере, аккаунт № {99ff66}%d", params[0]);
	ServerInfo[68] = params[0];
	SaveServer(68);
	return true;
}

// Игрок внутри одного из домов
stock PlayerInHouse(playerid)
{
	if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 3000 && GetPlayerInterior(playerid) == 90)
	{
		return GetPlayerVirtualWorld(playerid) - 1000; // Передаём ID дома
	}
	return 0;
}

// Игрок внутри одного из бизнесов
stock PlayerInBusiness(playerid)
{
	if(GetPlayerVirtualWorld(playerid) >= 3001 && GetPlayerVirtualWorld(playerid) <= 4000 && GetPlayerInterior(playerid) == 90)
	{
		return GetPlayerVirtualWorld(playerid) - 3000; // Передаём ID бизнеса
	}
	return 0;
}

// В каком интерьере находится игрок (в доме или в бизе)
stock WherePlayerInInterior(playerid, &typeInterior, &ownerID)
{
	ownerID = PlayerInHouse(playerid);
	if(ownerID == 0)
	{
		ownerID = PlayerInBusiness(playerid);
		typeInterior = 1;
	}
	return true;
}

// Завершаем работу в городской клининговой службе
stock CloseJobCleaningCity(playerid)
{
	SetPVarInt(playerid,"job_stat",0), RemovePlayerAttachedObject(playerid,0), PlayerPlaySound(playerid,5601,0,0,0);
	if(GpsStat[playerid] > 0) DestroyGps(playerid);
	SpawnRentVehicleJob(playerid, 408, 574);
	return true;
}

// Возвращаем визуально скрытые аксы
stock BackAccessory(i)
{
	if(PlayerInfo[i][pOdet][0] > 0) SetPlayerAttachedObject(i, 5, PlayerInfo[i][pOdet][0], PlayerInfo[i][pOdetBone][0], PlayerInfo[i][pOdet_X][0], PlayerInfo[i][pOdet_Y][0], PlayerInfo[i][pOdet_Z][0], PlayerInfo[i][pOdet_rX][0], PlayerInfo[i][pOdet_rY][0], PlayerInfo[i][pOdet_rZ][0], PlayerInfo[i][pOdet_sX][0], PlayerInfo[i][pOdet_sY][0], PlayerInfo[i][pOdet_sZ][0], 0, 0);
	if(PlayerInfo[i][pOdet][1] > 0) SetPlayerAttachedObject(i, 6, PlayerInfo[i][pOdet][1], PlayerInfo[i][pOdetBone][1], PlayerInfo[i][pOdet_X][1], PlayerInfo[i][pOdet_Y][1], PlayerInfo[i][pOdet_Z][1], PlayerInfo[i][pOdet_rX][1], PlayerInfo[i][pOdet_rY][1], PlayerInfo[i][pOdet_rZ][1], PlayerInfo[i][pOdet_sX][1], PlayerInfo[i][pOdet_sY][1], PlayerInfo[i][pOdet_sZ][1], 0, 0);
	if(PlayerInfo[i][pOdet][2] > 0) SetPlayerAttachedObject(i, 7, PlayerInfo[i][pOdet][2], PlayerInfo[i][pOdetBone][2], PlayerInfo[i][pOdet_X][2], PlayerInfo[i][pOdet_Y][2], PlayerInfo[i][pOdet_Z][2], PlayerInfo[i][pOdet_rX][2], PlayerInfo[i][pOdet_rY][2], PlayerInfo[i][pOdet_rZ][2], PlayerInfo[i][pOdet_sX][2], PlayerInfo[i][pOdet_sY][2], PlayerInfo[i][pOdet_sZ][2], 0, 0);
	if(PlayerInfo[i][pOdet][3] > 0) SetPlayerAttachedObject(i, 8, PlayerInfo[i][pOdet][3], PlayerInfo[i][pOdetBone][3], PlayerInfo[i][pOdet_X][3], PlayerInfo[i][pOdet_Y][3], PlayerInfo[i][pOdet_Z][3], PlayerInfo[i][pOdet_rX][3], PlayerInfo[i][pOdet_rY][3], PlayerInfo[i][pOdet_rZ][3], PlayerInfo[i][pOdet_sX][3], PlayerInfo[i][pOdet_sY][3], PlayerInfo[i][pOdet_sZ][3], 0, 0);
	if(PlayerInfo[i][pOdet][4] > 0) SetPlayerAttachedObject(i, 9, PlayerInfo[i][pOdet][4], PlayerInfo[i][pOdetBone][4], PlayerInfo[i][pOdet_X][4], PlayerInfo[i][pOdet_Y][4], PlayerInfo[i][pOdet_Z][4], PlayerInfo[i][pOdet_rX][4], PlayerInfo[i][pOdet_rY][4], PlayerInfo[i][pOdet_rZ][4], PlayerInfo[i][pOdet_sX][4], PlayerInfo[i][pOdet_sY][4], PlayerInfo[i][pOdet_sZ][4], 0, 0);
	return true;
}

// Визуально офаем аксы
stock OffAccessory(playerid)
{
	if(PlayerInfo[playerid][pOdet][0] > 0) RemovePlayerAttachedObject(playerid, 5);
	if(PlayerInfo[playerid][pOdet][1] > 0) RemovePlayerAttachedObject(playerid, 6);
	if(PlayerInfo[playerid][pOdet][2] > 0) RemovePlayerAttachedObject(playerid, 7);
	if(PlayerInfo[playerid][pOdet][3] > 0) RemovePlayerAttachedObject(playerid, 8);
	if(PlayerInfo[playerid][pOdet][4] > 0) RemovePlayerAttachedObject(playerid, 9);
	return true;
}

stock Float:frandom(Float:max) {
    return float(random(floatround(max * 1000.0))) / 1000.0;
}
