	if(PlayerInfo[playerid][pJailed] == 4 || PlayerInfo[playerid][pJailed] == 7 || PlayerInfo[playerid][pJailed] == 8) // Госпиталь
	{
		// Стартовый квест
		StartFirstCallQuest(playerid);

		keep(playerid);
		SetPlayerHealthInHospital(playerid);
