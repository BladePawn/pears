			{
			   RingInfo[rg][rTimer]--;
			   format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~w~Ready?~n~~n~ ~r~%d",RingInfo[rg][rTimer]+1);
	           GameTextForPlayer(RingInfo[rg][rIdr],string,2000,3);
	           format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~w~Ready?~n~~n~ ~r~%d",RingInfo[rg][rTimer]+1);
	           GameTextForPlayer(RingInfo[rg][rIdb],string,2000,3);
