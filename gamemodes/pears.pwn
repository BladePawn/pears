		format(str,sizeof(str),"\n{cccccc}Поражения [+C]: \t {FF6347}%d {cccccc}/ %d   {FF6347}%d {cccccc}/ %d \t {FF6347}%d {cccccc}/ %d   {FF6347}%d {cccccc}/ %d",OrganInfo[13][gCapture][7],OrganInfo[13][gCapture][8],OrganInfo[14][gCapture][7],OrganInfo[14][gCapture][8],OrganInfo[15][gCapture][7],OrganInfo[15][gCapture][8],OrganInfo[16][gCapture][7],OrganInfo[16][gCapture][8]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Продано территорий: \t {FF6347}%d {cccccc}/ %d   {FF6347}%d {cccccc}/ %d \t {FF6347}%d {cccccc}/ %d   {FF6347}%d {cccccc}/ %d",OrganInfo[13][gCapture][9],OrganInfo[13][gCapture][10],OrganInfo[14][gCapture][9],OrganInfo[14][gCapture][10],OrganInfo[15][gCapture][9],OrganInfo[15][gCapture][10],OrganInfo[16][gCapture][9],OrganInfo[16][gCapture][10]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Куплено территорий: \t {FF6347}%d {cccccc}/ %d   {FF6347}%d {cccccc}/ %d \t {FF6347}%d {cccccc}/ %d   {FF6347}%d {cccccc}/ %d",OrganInfo[13][gCapture][11],OrganInfo[13][gCapture][12],OrganInfo[14][gCapture][11],OrganInfo[14][gCapture][12],OrganInfo[15][gCapture][11],OrganInfo[15][gCapture][12],OrganInfo[16][gCapture][11],OrganInfo[16][gCapture][12]), strcat(sctring,str);

		new year, month, day;
