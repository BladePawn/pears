	format(str,sizeof(str),"\n{ff9000}Управление катерами \t {444444}Навык управления водным т.с."), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Основы мототранспорта \t {444444}Навык управления мототранспортом"), strcat(sctring,str);
