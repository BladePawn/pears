		    else if(PlayerInfo[playerid][pIspan] >= 2 && PlayerInfo[playerid][pIspan] <= 9) PlayerInfo[playerid][pIspan] ++, end = 2;
		    else if(PlayerInfo[playerid][pIspan] >= 10) PlayerInfo[playerid][pIspan] = 1, end = 3;
		    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Ispan`='%d' WHERE `user_id` = '%d'", PlayerInfo[playerid][pIspan] ,PlayerInfo[playerid][pID]);
