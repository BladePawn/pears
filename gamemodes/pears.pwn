		format(string, sizeof(string), "   %s[%d] сбросил мою статистику каптов за всё время",PlayerInfo[playerid][pName], playerid), SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		PlayerPlaySound(giveplayerid,4203,0,0,0);
		format(string, sizeof(string), " [ ADM ]: %s[%d] сбросил статистику каптов %s[%d] за всё время", PlayerInfo[playerid][pName],playerid,PlayerInfo[giveplayerid][pName],giveplayerid);
		ABroadCast(COLOR_ADM,string,2);
		PlayerInfo[giveplayerid][pMyWar] = 0;
		for(new gp = 0; gp < MAX_GANG_CAPT_STATA; gp++) PlayerInfo[giveplayerid][pGangCapt][gp] = 0, PlayerInfo[giveplayerid][pGangAll][gp] = 0;
		SavePlayerCapt(giveplayerid);
		IsATopName(PlayerInfo[giveplayerid][pName]);
