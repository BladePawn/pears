CMD:mop(playerid)
{
	if((IsPlayerInRangeOfPoint(playerid,2.0, 236.0400,1972.1516,17.6506)
	|| IsPlayerInRangeOfPoint(playerid,1.3, 1378.187255, 1566.508911, 11.078440) && (GetPlayerInterior(playerid) == 231 && GetPlayerVirtualWorld(playerid) == 231
	|| GetPlayerInterior(playerid) == 232 && GetPlayerVirtualWorld(playerid) == 232))
		|| ((IsPlayerInRangeOfPoint(playerid,1.3, 1059.9658,2442.1836,10.6129) || IsPlayerInRangeOfPoint(playerid,1.3,1032.0497,2454.5862,10.6129)) && GetPlayerVirtualWorld(playerid) == WORLD_PRISON_CELLS && GetPlayerInterior(playerid) == INT_PRISON_CELLS))
	{
		if(Dei[playerid] == 0)
		{
			if(OnlineInfo[playerid][oInHandThing][0] > 0 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [ Предмет или оружие ]");
			if(IsPlayerInRangeOfPoint(playerid,2.0, 236.0400,1972.1516,17.6506))
			{
				new dirt = 0;
				for(new d = 0; d < sizeof(DirtPos); d++)
				{
					if(DirtStat[d] >= 1) dirt ++;
				}
				if(dirt == 0) return ErrorMessage(playerid, "{FF6347}Территория чистая [ Грязь появляется со временем, возвращайтесь немного позже ]");
				if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {99ff66}взял {cccccc}в руки швабру, чтобы отмыть грязь {ff9000}[ %s - Рядом с пятном ]", buttonName[Device[playerid]]);
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я {99ff66}взяла {cccccc}в руки швабру, чтобы отмыть грязь {ff9000}[ %s - Рядом с пятном ]", buttonName[Device[playerid]]);
				SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: [ Мыть Пятно - {ff9000}%s {cccccc}]", buttonName[Device[playerid]]);
			}
			ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
			Dei[playerid] = 2, DeiStat[playerid] = 0;
			SetPlayerAttachedObject(playerid, 1, 2712, 5, 0.432999, 0.217000, 0.110999, -8.000007, -141.499923, -75.400016, 1.000000, 1.000000, 1.000000, 0, 0);
			PlayerPlaySound(playerid,5600,0,0,0);
		}
		else if(Dei[playerid] == 2) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		else ErrorMessage(playerid, "{FF6347}У вас заняты руки [ Предмет или оружие ]");
	}
	return 1;
}
CMD:wash_dirt(playerid, const params[])
{
	if(Dei[playerid] == 2)
	{
		new yes = 0;
		for(new d = 0; d < sizeof(DirtPos); d++)
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0, DirtPos[d][DirtPos_X], DirtPos[d][DirtPos_Y], DirtPos[d][DirtPos_Z]) && DirtStat[d] >= 1)
			{
				yes = d+1;
				break;
			}
		}
		if(yes >= 1)
		{
		    if(DirtWash[yes-1] >= 0 && DirtWash[yes-1]!= playerid) return ErrorMessage(playerid, "{FF6347}Это пятно грязи уже кто-то моет [ Не мешайте работать другим ]");
		    if(DirtWash[yes-1] == -1)
		    {
			    GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
				DeiStat[playerid] = yes;
				DirtWash[yes-1] = playerid;
				SetPVarInt(playerid,"oryjtemp",0);
				PlayerPlaySound(playerid,20800,0,0,0);
				GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Wash Dirt: ~w~0/100",2000,3);
			}
		}
	}
	return 1;
}
CMD:wash_toilet(playerid)
{
	if(Dei[playerid] == 0)
	{
		if(Piss[playerid] >= 1 || Hold[playerid] >= 1 || Hand[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [ Предмет или оружие ]");
		new yes = 0, mw = GetPlayerVirtualWorld(playerid), mi = GetPlayerInterior(playerid);
		for(new p = 0; p < sizeof(WashtoPos); p++)
		{
			if(IsPlayerInRangeOfPoint(playerid,0.7, WashtoPos[p][WashtoPos_X], WashtoPos[p][WashtoPos_Y], WashtoPos[p][WashtoPos_Z])
			&& (WashtoPos[p][WashtoWorld] >= 1 && mw == WashtoPos[p][WashtoWorld] || WashtoPos[p][WashtoWorld] <= 0)
			&& (WashtoPos[p][WashtoInt] >= 1 && mi == WashtoPos[p][WashtoInt] || WashtoPos[p][WashtoInt] <= 0))
			{
				yes = p+1;
				break;
			}
		}
		if(yes >= 1)
		{
			new unixtime = gettime();
			if(PissWash[yes-1] > unixtime) return ErrorMessage(playerid, "{FF6347}Этот унитаз чистый");
			PPSetPlayerPos(playerid, WashtoPos[yes-1][WashtoPos_X], WashtoPos[yes-1][WashtoPos_Y], WashtoPos[yes-1][WashtoPos_Z]), PPSetPlayerFacingAngle(playerid, WashtoPos[yes-1][WashtoPos_A]);
			ApplyAnimation(playerid,"COP_AMBIENT","Copbrowse_loop",4.0, false, true, false, false, false);
			GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
			Dei[playerid] = 1;
			DeiStat[playerid] = yes;
			SetPVarInt(playerid,"oryjtemp",0);
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: [ Мыть Туалет - {ff9000}%s {cccccc}]", buttonName[Device[playerid]]);
			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~Wash Toilet: ~w~0/100",2000,3);
		}
	}
	return 1;
}

stock CreateToilet()
{
    for(new i = 0; i < sizeof(PissPos); i++)
	{
		new Float:correct_position[2];
		frontpos(0.6, PissPos[i][PissPos_X], PissPos[i][PissPos_Y], PissPos[i][PissPos_A], correct_position[0], correct_position[1]);

        CreateDynamic3DTextLabel("{ff9000}Туалет\n{ffffff}[ ALT ]", 0xFFFFFFFF, 
            correct_position[0], correct_position[1], PissPos[i][PissPos_Z] - 0.4, 2.0,
            INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0 ,PissPos[i][PissWorld],PissPos[i][PissInt]);

		// \n\n{cccccc}[ {FF6347}/wash_toilet - Мыть Туалет {cccccc}]
    }
    return true;
}

stock piss_alt(playerid)
{
	if(!howstun(playerid) && NoAnim[playerid] == 0 && GetPlayerSpeed(playerid) <= 2 && Sleep[playerid] == 0 && SleepRP[playerid] == 0 && Piss[playerid] == 0
	&& GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && Dei[playerid] == 0)
    {
        new yes = 0, mw = GetPlayerVirtualWorld(playerid), mi = GetPlayerInterior(playerid);
 		if(mw == 0) yes = 9999; // На улице
 		if(mw >= 1001) // В доме или прочих интах
 		{
			if(PlayerInfo[playerid][pCap] >= 90) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не хочет в туалет");
			yes = 9999;
			createpiss(playerid);
 		}
 		if(yes == 0) // В интерьере
 		{
	 		for(new p = 0; p < sizeof(PissPos); p++)
			{
				if(IsPlayerInRangeOfPoint(playerid,0.7, PissPos[p][PissPos_X], PissPos[p][PissPos_Y], PissPos[p][PissPos_Z])
				&& (PissPos[p][PissWorld] >= 1 && mw == PissPos[p][PissWorld] || PissPos[p][PissWorld] <= 0)
				&& (PissPos[p][PissInt] >= 1 && mi == PissPos[p][PissInt] || PissPos[p][PissInt] <= 0))
				{
					yes = p+1;
					break;
				}
			}
			if(GetPlayerVirtualWorld(playerid) == 239 && GetPlayerInterior(playerid) == 239) PPSetPlayerFacingAngle(playerid, 270.0);
		}
		if(yes >= 1 && yes <= 9998)
		{
		    if(PlayerInfo[playerid][pCap] >= 90) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не хочет в туалет");
			if(PissPos[yes-1][PissSex] >= 1)
			{
				if(PissPos[yes-1][PissSex] == 1 && PlayerInfo[playerid][pSex] != 1) return ErrorMessage(playerid, "{FF6347}Это мужской туалет");
				if(PissPos[yes-1][PissSex] == 2 && PlayerInfo[playerid][pSex] != 2) return ErrorMessage(playerid, "{FF6347}Это женский туалет");
			}

			// Квест в отелях
			if((yes == 1 || yes == 2) && PlayerInfo[playerid][pQuest][2] == 0) return ErrorMessage(playerid, "{FF6347}Неверный порядок квеста\n{ffcc66}Ваш персонаж хочет в душ");
			
			PPSetPlayerPos(playerid, PissPos[yes-1][PissPos_X], PissPos[yes-1][PissPos_Y], PissPos[yes-1][PissPos_Z]);
			if(PissPos[yes-1][PissPos_A] != 0.0) PPSetPlayerFacingAngle(playerid, PissPos[yes-1][PissPos_A]);
			createpiss(playerid);
		}
	}
	return 1;
}
stock createpiss(playerid)
{
    NoAnim[playerid] = 1;
 	if(PlayerInfo[playerid][pCap]<=10) PissTime[playerid] = 30;
  	else if(PlayerInfo[playerid][pCap]>=11 && PlayerInfo[playerid][pCap]<=30) PissTime[playerid] = 20;
   	else if(PlayerInfo[playerid][pCap]>=31 && PlayerInfo[playerid][pCap]<=50) PissTime[playerid] = 15;
   	else if(PlayerInfo[playerid][pCap]>=51 && PlayerInfo[playerid][pCap]<=70) PissTime[playerid] = 10;
    else if(PlayerInfo[playerid][pCap]>=71 && PlayerInfo[playerid][pCap]<=100) PissTime[playerid] = 5;
    GetPlayerPos(playerid, Job_X[playerid], Job_Y[playerid], Job_Z[playerid]);
    PlayerPlaySound(playerid,14200,0,0,0);
    // Влияние болезни
	new yes;
    if(HealthAC[playerid] > 10.0 && getillness(playerid, 1) >= 0) ACSetPlayerHealth(playerid, HealthAC[playerid]-10.0), yes = 1;
    if(HealthAC[playerid] > 20.0 && (getillness(playerid, 2) >= 0 || getillness(playerid, 3) >= 0)) ACSetPlayerHealth(playerid, HealthAC[playerid]-20.0), yes = 1;
    if(yes == 1)
    {
        if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) SendMindMessage(playerid, RusToGame("Мне больно ходить в туалет"),RusToGame("[Персонаж болен]"));
        else SendMindMessage(playerid, "Me it hurts pee","[Character is sick]");
    }

	if(PlayerInfo[playerid][pSex] == 1) TogglePlayerControllable(playerid, false), Piss[playerid] = 1, SetPlayerSpecialAction(playerid, SPECIAL_ACTION_PISSING);
	else
	{
		new Float:A;
		GetPlayerFacingAngle(playerid,A);
		PPSetPlayerFacingAngle(playerid,A+180.0), Piss[playerid] = 8, ApplyAnimation(playerid,"PED","SEAT_down",4.0, false, false, false, true, false, SYNC_ALL), SetTimerEx("sitload", 1500, false, "d", playerid);
	}
	return 1;
}
CMD:piss(playerid)
{
    if(NoAnim[playerid] == 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент, чтобы пойти пописать {ff9000}[ Enter или Л.К.М. ]");
    if(PlayerInfo[playerid][pCap] >= 90) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не хочет в туалет");
    if(IsPlayerInAnyVehicle(playerid) || Dei[playerid] >= 1 || Hand[playerid] >= 1 || Hold[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) <= WEAPON:40) || GetPlayerSpeed(playerid) > 3
	|| Sleep[playerid] >= 1 || Piss[playerid] >= 1 || GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1 || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не может сейчас справить нужду [ Заняты руки, выполняется действие или иная причина ]");
    if(!howstun(playerid))
    {
        if(GetPlayerVirtualWorld(playerid) > 0 || GetPlayerInterior(playerid) > 0) return ErrorMessage(playerid, "{FF6347}Справлять нужду с помощью команды можно только на улице\n[ В помещении возле туалета: ALT ]");
 		createpiss(playerid);
    }
	return 1;
}

stock ClosePiss(playerid)
{
	if(Piss[playerid] == 1 || Piss[playerid] == 8)
	{
		if(Piss[playerid] == 1) TogglePlayerControllable(playerid, true), SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		if(Piss[playerid] == 8) ApplyAnimation(playerid,"PED","SEAT_up",4.0, false, false, false, false, false, SYNC_ALL);

		TogglePlayerControllable(playerid, true);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		Piss[playerid] = 0;
		PissTime[playerid] = 0;
		NoAnim[playerid] = 0;
		PlayerPlaySound(playerid,4203,0,0,0);
		if(PlayerInfo[playerid][pInfoload] >= 50) PlayerInfo[playerid][pInfoload] -= 50;
		else PlayerInfo[playerid][pInfoload] = 0;
		if(PlayerInfo[playerid][pCap] > 30) TextDrawHideForPlayer(playerid, PissDraw), TextDrawHideForPlayer(playerid, PissDraw2);
		return true;
	}
	return false;
}

CMD:dance(playerid, const params[])
{
    if(NoAnim[playerid] == 1 || GetPlayerSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в транспорте");
    if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
    if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
    if(!howstun(playerid))
    {
		if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Потанцевать, чтоли [ /dance 1-17 ]");
		if(params[0] > 17 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не особо умею танцевать [ /dance 1-17 ]");
		switch(params[0])
		{
			case 1: SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE1);
			case 2: SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE2);
			case 3: SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE3);
			case 4: SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE4);
			case 5: ApplyAnimation(playerid,"DANCING","dnce_M_e",4.1, true, true, true, true, true, SYNC_ALL);
			case 6: ApplyAnimation(playerid,"DANCING","dnce_M_d",4.1, true, true, true, true, true, SYNC_ALL);
			case 7: ApplyAnimation(playerid,"DANCING","dnce_M_c",4.1, true, true, true, true, true, SYNC_ALL);
			case 8: ApplyAnimation(playerid,"DANCING","dnce_M_b",4.1, true, true, true, true, true, SYNC_ALL);
			case 9: ApplyAnimation(playerid,"DANCING","dnce_M_a",4.1, true, true, true, true, true, SYNC_ALL);
			case 10: ApplyAnimation(playerid,"DANCING","DAN_Loop_A",4.1, true, true, true, true, true, SYNC_ALL);
			case 11: ApplyAnimation(playerid,"DANCING","DAN_Left_A",4.1, true, true, true, true, true, SYNC_ALL);
			case 12: ApplyAnimation(playerid,"DANCING","DAN_Right_A",4.1, true, true, true, true, true, SYNC_ALL);
			case 13: ApplyAnimation(playerid,"DANCING","DAN_Up_A",4.1, true, true, true, true, true, SYNC_ALL);
			case 14: ApplyAnimation(playerid,"DANCING","DAN_Down_A",4.1, true, true, true, true, true, SYNC_ALL);
			case 15: ApplyAnimation(playerid,"DANCING","dance_loop",4.1, true, true, true, true, true, SYNC_ALL);
			case 16: ApplyAnimation(playerid,"DANCING","bd_clap1",4.1, true, true, true, true, true, SYNC_ALL);
			case 17: ApplyAnimation(playerid,"DANCING","bd_clap",4.1, true, true, true, true, true, SYNC_ALL);
		}
	}
	return 1;
}
CMD:sex(playerid)
{
	if(NoAnim[playerid] == 1 || GetPlayerSpeed(playerid) > 3) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Сейчас не момент для этого действия {ff9000}[ Enter или Л.К.М. ]");
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в транспорте");
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
    if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
    if(!howstun(playerid))
    {
		if(Sex[playerid] >= 1 && Sex[playerid] <= 10) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я уже занимаюсь сексом");
		PlayerPlaySound(playerid,40405,0,0,0);
		ShowDialog(playerid,836,DIALOG_STYLE_LIST,"{ff33ff}Секс","{cccccc}Стандартный Секс\n{cccccc}Анальный Секс\n{cccccc}Оральный Секс\n{cccccc}Онанизм","Выбор","Отмена");
	}
 	return 1;
}
