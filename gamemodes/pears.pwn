		|| IsPlayerInRangeOfPoint(playerid,3.0,-2022.05347, -2344.28735, 29.69550) || IsPlayerInRangeOfPoint(playerid,3.0,-2034.62366, -2335.44434, 29.69550)
		|| IsPlayerInRangeOfPoint(playerid,3.0,-2044.30017, -2325.68579, 29.69550))
		{
	   		new setles;
	   		if(IsPlayerInRangeOfPoint(playerid,3.0,-2047.36475, -2339.28516, 29.69550)) setles = 0;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2023.03748, -2331.50952, 29.69550)) setles = 1;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2046.00720, -2357.65869, 29.69550)) setles = 2;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2046.29822, -2364.84863, 29.69550)) setles = 3;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2041.91833, -2373.80835, 29.69550)) setles = 4;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2038.00586, -2377.48364, 29.69550)) setles = 5;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2030.81506, -2382.64819, 29.69550)) setles = 6;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2045.53687, -2385.40771, 29.60150)) setles = 7;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2023.83789, -2371.53149, 29.69550)) setles = 8;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2031.24585, -2367.04370, 29.69550)) setles = 9;
			else if(IsPlayerInRangeOfPoint(playerid,3.0,-2037.87634, -2362.96533, 29.69550)) setles = 10;
