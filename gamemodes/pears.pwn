          			VehInfo[v][vLights] = 1;
          			if(OnlineInfo[playerid][oListenRadioPears] == 0) PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/auto2.mp3");
          			GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
					SetVehicleParamsEx(v, engine, true, alarm, doors, bonnet, boot, objective);
	        	}
	        	slcar(playerid, DP[0][playerid]);
	        }
			if(listitem == 5)
	        {
	        	ShowDialog(playerid,809,DIALOG_STYLE_INPUT,"{ff9000}Транспорт","{cccccc}Введите ID игрока,\n которому хотите показать {ff9000}П.Т.С.","Принять","Отмена");
	        }

			if(DP[1][playerid] == 2) // Ключи
			{
				if(listitem == 6)
				{
					ShowDialog(playerid,649,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт","{cccccc}Вы уверены, что хотите {FF6347}отдать ключи {cccccc}от этого транспорта?\n\nВ таком случае вы потеряете доступ к транспорту","Да","Нет");
				}
			}
			else if(DP[1][playerid] == 1) // Личный
			{
				if(listitem == 6) 
				{
					if(VehInfo[v][vKey] != 0 && VehInfo[v][vKeyUnix] > gettime())
					{
						ShowDialog(playerid,650,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт","{cccccc}В данный момент у одного игрока есть доступ к транспорту\n\n{FF6347}Вы хотите отозвать ключи?","Да","Нет");
					}
					else ShowDialog(playerid,814,DIALOG_STYLE_INPUT,"{ff9000}Транспорт","{cccccc}Введите ID или Никнейм игрока,\nкоторому хотите {ff9000}передать ключи","Принять","Отмена");
				}
				if(listitem == 7)
				{
					if(!IsABoot(v)) return ErrorMessage(playerid, "{FF6347}В транспорте нет багажника..");
					if(VehInfo[v][vEnhancedBoot]) return ErrorMessage(playerid, "{FF6347}В транспорте уже установлен увеличенный багажник");
					if(IsA_Gen5(v) || IsA_Gen10(v) || IsA_Gen15(v)) ShowDialog(playerid,901,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт","{cccccc}Вы уверены что хотите открыть все слоты в багажнике?\n{cccccc}Стоимость: {ffcc00}490 G","Да","Нет");
					else ErrorMessage(playerid, "{FF6347}В этом транспорте багажник максимальный, он не требует улучшения");
				}
				if(listitem == 8)
				{
					if(IsACar(model) || IsAMoto(model))
					{
						if(VehInfo[v][vNosell] == 1) return ErrorMessage(playerid, "{FF6347}Это транспорт медиа и он не может быть продан");
						if(VehInfo[v][vSellcar] == 0)
						{
							if(SellVeh[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Нельзя продавать одновременно несколько транспортных средств");
							if(!IsVehicleInSquare(v,1020.9719,1748.7014,1116.8024,1799.6742)) return ErrorMessage(playerid, "{FF6347}Транспорт должен быть на парковке центра обмена [ Y >> GPS >> Услуги >> Центр Обмена ]");
							format(string, sizeof(string), "\n{cccccc}Введите стоимость транспорта {ff9000}%s{cccccc}, чтобы выставить его на продажу\n{FF6347}Транспорт должен находиться на разметке парковки центра обмена!",GetVehicleName(model));
							ShowDialog(playerid,1091,DIALOG_STYLE_INPUT,"{ff9000}Продажа Транспорта",string,"Принять","Отмена");
						}
						else
						{
							format(string, sizeof(string), "\n{cccccc}Вы уверены, что хотите {FF6347}отменить продажу {ff9000}%s{cccccc}?\n",GetVehicleName(model));
							ShowDialog(playerid,1092,DIALOG_STYLE_MSGBOX,"{ff9000}Продажа Транспорта",string,"Да","Нет");
						}
					}
					else ErrorMessage(playerid, "{FF6347}На парковке центра обмена можно выставить на продажу только автомобиль или мотоцикл");
				}
				if(listitem == 9)
				{
					new line[130],lines[1040];
					format(line,sizeof(line),"{ff9000}Избавиться от личного транспорта можно двумя способами:"), strcat(lines,line);
					format(line,sizeof(line),"\n\n{0088ff}1. {cccccc}Сдать на металлолом [ {0088ff}Y >> GPS >> Транспорт >> Утиль {cccccc}]"), strcat(lines,line);
					format(line,sizeof(line),"\n{cccccc}Вы получите 20 проц. от стоимости автомобиля."), strcat(lines,line);
					format(line,sizeof(line),"\n\n{0088ff}2. {cccccc}Продать  [ {0088ff}Y >> GPS >> Услуги >> Центр Обмена {cccccc}]"), strcat(lines,line);
					format(line,sizeof(line),"\n{cccccc}Продажа полностью самостоятельна  [ {0088ff}/trade {cccccc}]"), strcat(lines,line);
					format(line,sizeof(line),"\n{cccccc}Найдите покупателя и продайте ему ваш транспорт. Подать объявление о продаже [ {0088ff}/ad {cccccc}]"), strcat(lines,line);
					format(line,sizeof(line),"\n\n{0088ff}3. {cccccc}Выставить на продажу  [ {0088ff}Y >> GPS >> Услуги >> Центр Обмена {cccccc}]"), strcat(lines,line);
					format(line,sizeof(line),"\n{cccccc}На парковке центра вы можете выставить транспорт на продажу"), strcat(lines,line);
					ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Транспорт",lines,"*","");
