	AdminLog("givevoen", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
	return 1;
}
CMD:giveprava(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 19) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать водительские права /giveprava ID");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(get_invent2(params[0], 156, 0) >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже есть водительские права");
	if(CheckInvent(params[0])) return ErrorMessage(playerid, "{FF6347}У игрока нет места в инвентаре");
	new string[144];
	GiveThingPlayer(params[0], 156, 1, PlayerInfo[params[0]][pID], 0, 0, 0, 9999);
	if(PlayerInfo[params[0]][pCarLic] <= 99) PlayerInfo[params[0]][pCarLic] = 100;
	format(string, sizeof(string), " %s выдал вам водительские права", PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "Я выдал водительские права игроку %s", PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), " [ ADM ]: Админ %s выдал %s водительские права",PlayerInfo[playerid][pName],PlayerInfo[params[0]][pName]);
	ABroadCast(COLOR_ADM,string,1);
	AdminLog("giveprava", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
	return 1;
}
//----------------------------------[cnn]-----------------------------------------------
CMD:cnn(playerid, const params[])
{
	new result[64],string[256];
    if (!sscanf(params, "s[64]", result))
 	{
		if (PlayerInfo[playerid][pSoska] >= 6)
		{
		  if(strfind(result, "~n~" , true ) != -1
		  || strfind(result, "~r~" , true ) != -1
		  || strfind(result, "~g~" , true ) != -1
		  || strfind(result, "~b~" , true ) != -1
		  || strfind(result, "~w~" , true ) != -1
		  || strfind(result, "~y~" , true ) != -1)
		  {
			format(string, sizeof(string), "~b~%s: ~w~%s",PlayerInfo[playerid][pName],result);
			foreach (Player, i)
			{
				if(IsOnline(i)) GameTextForPlayer(i, RusToGame(string), 5000, 6);
			}
			return 1;
		  }
		  else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверный символ");
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	}
	else SendClientMessage(playerid, COLOR_GRAD2, "*Используйте: /cnn [cnn textformat ~n~=Newline ~r~=Red ~g~=Green ~b~=Blue ~w~=White ~y~=Yellow]");
	return 1;
}
CMD:cnnn(playerid, const params[])
{
	new result[64],string[256],txtid;
    if (!sscanf(params, "is[64]",txtid, result))
 	{
		if (PlayerInfo[playerid][pSoska] >= 6)
		{
		  if(strfind(result, "~n~" , true ) != -1
		  || strfind(result, "~r~" , true ) != -1
		  || strfind(result, "~g~" , true ) != -1
		  || strfind(result, "~b~" , true ) != -1
		  || strfind(result, "~w~" , true ) != -1
		  || strfind(result, "~y~" , true ) != -1)
		  {
			if(txtid == 2) return SendClientMessage(playerid, COLOR_GRAD2, "* Вы не можете выбрать 2");
			format(string, sizeof(string), "~w~%s",result);
			foreach (Player, i)
			{
				GameTextForPlayer(i, RusToGame(string), 5000, txtid);
			}
			return 1;
		  }
		  else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Неверный символ");
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	}
	else SendClientMessage(playerid, COLOR_GRAD2, "*Используйте: /cnnn <введите> [cnnc textformat ~n~=Newline ~r~=Red ~g~=Green ~b~=Blue ~w~=White ~y~=Yellow]");
	return 1;
}
//-----------------------------------[JAIL]-------------------------------------------------------------------------
forward Call_prison(playerid, const str_name[], const reason[], min);
public Call_prison(playerid, const str_name[], const reason[], min)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		  new datadid,string[286],f_str[256],datad1,datad2;
		  cache_get_value_name_int(0, "user_id", datadid);
	      cache_get_value_name_int(0, "Jailed", datad1);
	      cache_get_value_name_int(0, "Soska", datad2);
	      if(datad1 == 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок уже сидит в психушке");
          mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Jailed` = '2',`JailTime` = '%d' WHERE `Name` = '%e'", min*60, str_name);
          query_empty(pearsq, f_str);
          if(PlayerInfo[playerid][pSex] == 1)format(string, sizeof(string), "[PP]: %s посадил %s в PRISON на %d мин, причина: %s", PlayerInfo[playerid][pName], str_name, min, reason);
	      else format(string, sizeof(string), "[PP]: %s посадила %s в PRISON на %d мин, причина: %s", PlayerInfo[playerid][pName], str_name, min, reason);
 		  AllMessage(COLOR_LIGHTRED, string);
          format(string, sizeof(string), "Вы посадили в психушку offline %s на %d мин, причина: %s", str_name,min,reason);
	      SendClientMessage(playerid, COLOR_LIGHTRED, string);
          AdminLog("prison", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", min, reason);
          AddWrong(playerid, 3, str_name, min);
          work_admin(playerid, 11);
          update_admpoint(playerid, ServerInfo[16]);
          format(string, sizeof(string), "Вас посадили в психушку на %d мин. Причина: %s",min,reason);
 	      notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
CMD:kam(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(72, g, playerid) && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(!GetAccessRankOrg(playerid, g, 72, NO_FBI) && PlayerInfo[playerid][pSoska] == 0) return 1;

    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Пересадить заключённого в другую камеру [ /kam ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
 	if(PlayerInfo[params[0]][pJailed] == 1)
	{
		if(!ProxDetectorS(2.0, playerid, params[0])) return ErrorMessage(playerid, "{FF6347}Вы далеко от заключённого");
		if(PlayerInfo[params[0]][pPrisonRank] >= 9) return ErrorMessage(playerid, "{FF6347}Вы не можете пересадить в другую камеру авторитета");
		new string[144];
		PlayerInfo[params[0]][pJailCell] = 1 + random(8);
  		format(string, sizeof(string), "Тюремный надзиратель %s пересаживает заключённого %s в другую камеру.", playername(playerid),playername(params[0]));
  		ProxDetector(50.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
    	PPSpawnPlayer(params[0]);
	}
	else ErrorMessage(playerid, "{FF6347}Это не заключённый областной тюрьмы или он находится в изоляторе");
   	return 1;
}
CMD:unizol(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(72, g, playerid) && PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(!GetAccessRankOrg(playerid, g, 72, NO_FBI) && PlayerInfo[playerid][pSoska] == 0) return 1;

    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Освободить заключённого из изолятора [ /unizol ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
 	if(PlayerInfo[params[0]][pJailed] == 5)
	{
		if(!ProxDetectorS(2.0, playerid, params[0]) && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от заключённого");
		new string[144];
		if(PlayerInfo[playerid][pSoska] <= 1)
		{
  			format(string, sizeof(string), "Тюремный надзиратель %s освобождает %s из изолятора.", playername(playerid),playername(params[0]));
  			ProxDetector(50.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		}
		else
		{
			format(string, sizeof(string), " [ ADM ]: %s освободил %s из изолятора",PlayerInfo[playerid][pName] ,PlayerInfo[params[0]][pName]);
			ABroadCast(COLOR_ADM,string,1);
		}
  		PlayerInfo[params[0]][pJailed] = 1;
    	PPSpawnPlayer(params[0]);
	}
	else ErrorMessage(playerid, "{FF6347}Это не заключённый областной тюрьмы или он не находится в изоляторе");
   	return 1;
}
CMD:izol(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(72, g, playerid) && PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(!GetAccessRankOrg(playerid, g, 72, NO_FBI) && PlayerInfo[playerid][pSoska] == 0) return 1;

    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отправить заключённого в изолятор [ /izol ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Этого игрока нет в сети");
 	if(PlayerInfo[params[0]][pJailed] == 1)
	{
		if(PlayerInfo[params[0]][pPrisonRank] >= 9 && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете отправить в изолятор авторитета");
		if(!ProxDetectorS(2.0, playerid, params[0]) && PlayerInfo[playerid][pSoska] == 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от заключённого");
		new string[144];
		if(PlayerInfo[playerid][pSoska] == 0)
		{
  			format(string, sizeof(string), "Тюремный надзиратель %s отправляет заключённого %s в изолятор.", playername(playerid),playername(params[0]));
  			ProxDetector(50.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		}
		else format(string, sizeof(string), " [ ADM ]: %s пересадил %s в изолятор",PlayerInfo[playerid][pName] ,PlayerInfo[params[0]][pName]), ABroadCast(COLOR_ADM,string,1);
  		PlayerInfo[params[0]][pJailed] = 5;
    	PPSpawnPlayer(params[0]);
	}
	else ErrorMessage(playerid, "{FF6347}Это не заключённый областной тюрьмы или он уже находится в изоляторе");
   	return 1;
}
CMD:jail(playerid, const params[])
{
	new tmp[24],giveplayerid,money,result[64],string[256];
    if(!sscanf(params, "s[24]is[64]", tmp,money,result))
 	{
  		if(PlayerInfo[playerid][pSoska] < 2) return SendClientMessage(playerid, COLOR_GREY, "   Нет прав на использование команды !");
		if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
        giveplayerid = ReturnUser(tmp, 1);
	    if(IsOnline(giveplayerid))
	    {
     		if(giveplayerid != INVALID_PLAYER_ID)
     		{
     			if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "   Игрок не залогинился!!!");
     			if(PlayerInfo[giveplayerid][pSoska] >= 10 && PlayerInfo[playerid][pSoska] <= 11) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу посадить в психушку главного админа");
	            if(PlayerInfo[giveplayerid][pJailed] == 1 || PlayerInfo[giveplayerid][pJailed] == 5) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок уже сидит в тюрьме [ /jailed ]");
				if(PlayerInfo[playerid][pSex] == 1)
				{
				  format(string, sizeof(string), "[PP]: %s посадил %s в тюрьму на %d минут, причина: %s",PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName],money, result);
				  AllMessage(COLOR_LIGHTRED, string);
		        }
		        else if(PlayerInfo[playerid][pSex] == 2)
				{
				  format(string, sizeof(string), "[PP]: %s посадила %s в тюрьму на %d минут, причина: %s",PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName],money, result);
				  AllMessage(COLOR_LIGHTRED, string);
		        }
				format(string, sizeof(string),"{FF0000}Вы посажены в тюрьму на %d минут администратором %s\n{0088ff}Причина: {FF0000}%s",money, PlayerInfo[playerid][pName],result);
  				ShowDialog(giveplayerid,1700, 0, "******* {FF0000}*Вы посажены в тюрьму* {FFFFFF}*******", string, "Ок", "");
				GameTextForPlayer(giveplayerid, RusToGame("~r~Вы посажены в тюрьму"), 5000, 3);
				TempTake(giveplayerid, 0);
				PlayerInfo[giveplayerid][pJailed] = 1;
				PlayerInfo[playerid][pWorked4] ++;
				PlayerInfo[giveplayerid][pJailTime] = money*60;
				PPSpawnPlayer(giveplayerid);
				AdminLog("jail", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], money, result);
				work_admin(playerid, 10);
				update_admpoint(playerid, ServerInfo[16]);
    		}
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посадить в тюрьму [ /jail ID Время Причина ]");
   	return 1;
}
CMD:unmir(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. Я не могу это сделать..");
	new tmp[24],string[144],giveplayerid;
    if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Освободить из личного мира заключённого в психушке [ /unmir ID ]");
    giveplayerid = ReturnUser(tmp, 1);
    if(!IsOnline(giveplayerid)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[giveplayerid][pJailed] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не заключённый психушки");
	if(PlayerInfo[giveplayerid][pRab] < 6000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он не находится в личном вирт мире");
	S_SetPlayerVirtualWorld(giveplayerid,1);
	PlayerInfo[giveplayerid][pRab] = 0; // Появление в общем мире
	PlayerPlaySound(giveplayerid, 4601, 0,0,0);
	format(string, sizeof(string), " [ ADM ]: %s освободил %s из личного мира",PlayerInfo[playerid][pName] ,PlayerInfo[giveplayerid][pName]), ABroadCast(COLOR_ADM,string,1);
	ShowDialog(giveplayerid, 1742, 0, "{FF9000}Личный Виртуальный Мир", "{FF9000}Вас освободили из личного виртуального мира", "Ок", "");
   	return 1;
}
CMD:mir(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. Я не могу это сделать..");
	new tmp[24],string[144],giveplayerid;
    if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посадить в личный мир заключённого психушки [ /mir ID ]");
    giveplayerid = ReturnUser(tmp, 1);
    if(!IsOnline(giveplayerid)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(PlayerInfo[giveplayerid][pJailed] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не заключённый психушки");
	if(PlayerInfo[giveplayerid][pRab] >= 6000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он уже находится под запретом в личном мире");
	S_SetPlayerVirtualWorld(giveplayerid,giveplayerid+2);
	PlayerInfo[giveplayerid][pRab] = 6000; // Сохраняем появление в личном мире
	PlayerPlaySound(giveplayerid, 4601, 0,0,0);
	format(string, sizeof(string), " [ ADM ]: %s поместил %s в личный мир",PlayerInfo[playerid][pName] ,PlayerInfo[giveplayerid][pName]), ABroadCast(COLOR_ADM,string,1);
	ShowDialog(giveplayerid, 1742, 0, "{FF9000}Личный Виртуальный Мир", "{FF9000}Вас принудительно посадили в личный мир. Не мешайте другим игрокам!", "Ок", "");
   	return 1;
}
CMD:prison(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new tmp[24],giveplayerid,result[64],string[256], minuute;
    if(sscanf(params, "s[24]is[64]", tmp, minuute,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посадить в психушку [ /prison ID Время Причина ]");
    if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(minuute <= 0 || minuute >= 300) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 300 минут");
    giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "   Игрок не залогинился!!!");
  		if(PlayerInfo[giveplayerid][pJailed] == 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок уже сидит в психушке [ /jailed ]");

		if(PlayerInfo[playerid][pSex] == 1)format(string, sizeof(string), "[PP]: %s посадил %s в PRISON на %d мин, причина: %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName], minuute, result);
		else format(string, sizeof(string), "[PP]: %s посадила %s в PRISON на %d мин, причина: %s", PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pName], minuute, result);
	 	AllMessage(COLOR_LIGHTRED, string);
		format(string, sizeof(string),"{FF0000}Вы посажены в психиатрическое отделение на %d мин администратором %s\n{0088ff}Причина: {FF0000}%s", minuute, PlayerInfo[playerid][pName], result);
		ShowDialog(giveplayerid,1700, 0, "{FF0000}Вы посажены в психушку", string, "Ок", "");
		GameTextForPlayer(giveplayerid, RusToGame("~r~Вы посажены в психушку"), 5000, 3);

		// Отрубаем преследование
		DestroyPursuit(giveplayerid);

		TempTake(giveplayerid, 0);
		PlayerInfo[giveplayerid][pJailed] = 2;
		S_SetPlayerVirtualWorld(giveplayerid,1,1);
		PPSetPlayerInterior(giveplayerid,1);
		PlayerInfo[giveplayerid][pJailTime] = minuute*60;
		PPSpawnPlayer(giveplayerid);
		AdminLog("prison", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], minuute, result);
		AddWrong(playerid, 3, PlayerInfo[giveplayerid][pName], minuute);
		work_admin(playerid, 11);
		//SendClientMessage(giveplayerid, COLOR_GREY, "{0088ff}[ Server ]: {cccccc}Не хотите сидеть в психушке? Вы всегда можете выйти досрочно {ff9000};)");
		update_admpoint(playerid, ServerInfo[16]);
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Jailed FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_prison", "dssd", playerid,tmp,result,minuute);
	}
   	return 1;
}
forward Call_unprison(playerid, const str_name[]);
public Call_unprison(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		  new datad1, datadid,string[160];
		  cache_get_value_name_int(0, "user_id", datadid);
	      cache_get_value_name_int(0, "Jailed", datad1);
	      if(datad1 == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок нигде не заключён");
          mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Jailed` = '0',`JailTime` = '0' WHERE `Name` = '%e'",str_name);
          query_empty(pearsq, string);
          format(string, sizeof(string), "[PP]: %s был освобожден из заключения администратором %s.",str_name, PlayerInfo[playerid][pName]);
	      AllMessage(COLOR_LIGHTRED,string);
          format(string, sizeof(string), "Вы освободили из заключения offline %s", str_name);
	      SendClientMessage(playerid, COLOR_LIGHTRED, string);
          AdminLog("unprison", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
          notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, "Вас освободили из заключения");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:unprison(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 6) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Освободить игрока из заключения [ /unprison ID ]");
    if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Длина никнейма не может быть больше 20-ти символов");
    new giveplayerid;
	giveplayerid = ReturnUser(params[0], 1);
    new string[144];
	if(IsOnline(giveplayerid))
	{
 		if(PlayerInfo[giveplayerid][pJailed] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок нигде не заключён");
 		if(PlayerInfo[playerid][pJailed] == 7)
		{
			if(HospBed[playerid] != 9999) ClearBedMed(playerid);
		}
		format(string, sizeof(string), "* Вы освободили из заключения %s.", PlayerInfo[giveplayerid][pName]);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string, sizeof(string), "* Вы были освобождены из заключения администратором %s.", PlayerInfo[playerid][pName]);
		SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
		PlayerInfo[giveplayerid][pJailTime] = 0;
		PlayerInfo[giveplayerid][pJailed] = 0;
		SetPlayerWorldBounds(giveplayerid, 20000.0000,-20000.0000,20000.0000,-20000.0000);
		TempGive(giveplayerid);
		PPSpawnPlayer(giveplayerid);
		ClearAllWantedPlayer(giveplayerid);
		format(string, sizeof(string), "[PP]: %s был освобожден из заключения администратором %s.", PlayerInfo[giveplayerid][pName], PlayerInfo[playerid][pName]);
		AllMessage(COLOR_LIGHTRED,string);
		AdminLog("unprison", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "");
		PlayerInfo[giveplayerid][pRab] = 0;
	}
	else
	{
 		if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	  	mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Jailed FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
    	mysql_tquery(pearsq, string, "Call_unprison", "ds", playerid,params[0]);
	}
   	return 1;
}
//----------------------------------[servtime]-----------------------------------------------

CMD:servtime(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установите время на сервере [ /servtime 0 - 23 ]");
 	if(params[0] > 23 || params[0] < 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 23");
	SetWorldTime(params[0]);
	FixHour(params[0]);
	return 1;
}
CMD:ptime(playerid, const params[])
{
	new pla,hours;
    if (!sscanf(params, "ii",pla,hours))
 	{
 	    if(!IsOnline(pla)) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
		if(PlayerInfo[playerid][pSoska] >= 19)
		{
		    if(hours > 23 || hours < -1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Часы не меньше 0 и не больше 23 [ -1 выключить личное время ]");
			
			new string[114];
			if(hours == -1)
			{
				OnlineInfo[playerid][oTempTime] = 0;
				PearsTime(playerid);
				format(string, sizeof(string), "[ Мысли ]: Игроку %s выключено личное время суток",PlayerInfo[pla][pName], hours);
				SendClientMessage(playerid,COLOR_GREY, string);
			}
			else
			{
				OnlineInfo[playerid][oTempTime] = hours + 1;
  				SetPlayerTime(pla, hours, 0);
				format(string, sizeof(string), "[ Мысли ]: Игроку %s установлено %d часов на сервере",PlayerInfo[pla][pName], hours);
				SendClientMessage(playerid,COLOR_GREY, string);
			}
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить игроку время [ /ptime ID Часы ]");
	return 1;
}
CMD:weathergro(playerid, const params[])
{
	new hour,string[144];
	if (!sscanf(params, "i", hour))
 	{
  		if (PlayerInfo[playerid][pSoska] < 4) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
		if(hour < 1 || hour > 500) return SendClientMessage(playerid, COLOR_GREY, "   ID погоды от 1 до 500 !");
		foreach (Player, i)
		{
			if(GetDistanceBetweenPlayers(playerid,i) < 50 && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
			{
				SendClientMessage(i,COLOR_GRAD1, " Администратор изменил вам погоду");
				SetPlayerWeather(i,hour);
			}
		}
		format(string, sizeof(string), " [ ADM ]: Админ %s изменил погоду всем игрокам в радиусе 50 метров",PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
		SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Игрокам в радиусе 50 метров установлена погода {00cc00}%d",hour);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить погоду игрокам в радиусе 150 метров");
	return 1;
}
forward Call_settopa(playerid, str_name[]);
public Call_settopa(playerid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid, datad1;
	    cache_get_value_name_int(0, "Soska", datad1);
	    cache_get_value_name_int(0, "user_id", datadid);
	    if(datad1 >= 1 && PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Админу нельзя сменить пароль");

		new numer[128];
		format(numer, sizeof(numer), "%s", CreatePassword());
		bcrypt_hash(playerid, "OnPasswordHashSetpasOffline", numer, BCRYPT_COST, "ssd", numer, str_name, datadid);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
forward Call_settopa2(playerid, str_name[], result[]);
public Call_settopa2(playerid, str_name[], result[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid,string[256],f_str[256];
		cache_get_value_name_int(0, "user_id", datadid);
   		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Mail`='%e',`MailStat`='0' WHERE `user_id`='%d'", result,datadid);
    	query_empty(pearsq, f_str);
	    format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку %s изменён Email: {0088ff}%s",str_name, result);
	    SendClientMessage(playerid, COLOR_WHITE, string);
	    AdminLog("setmail", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, result);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:setpas(playerid, const params[])
{
	new para1,string[256],tmp[24];
    if (!sscanf(params, "s[24]",tmp))
	{
        para1 = ReturnUser(tmp, 1);
		if(PlayerInfo[playerid][pSoska] >= 20)
		{
			if(IsOnline(para1))
   			{
   				if(PlayerInfo[para1][pSoska] >= 1 && PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Админу нельзя сменить пароль");

				new numer[128];
				format(numer, sizeof(numer), "%s", CreatePassword());
				bcrypt_hash(playerid, "OnPasswordHashSetpas", numer, BCRYPT_COST, "sd", numer, para1);
    	    }
    	    else
			{
			   if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: /setpas Lol_Lolkin");
			   mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
               mysql_tquery(pearsq, string, "Call_settopa", "ds", playerid, tmp);
               return 1;
			}
  	    }
   	    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
    }
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить пароль [ /setpas ID или НикНейм]");
    return 1;
}
CMD:setmail(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new para1,milo[64],string[128],tmp[24];
    if (!sscanf(params, "s[24]s[64]",tmp,milo))
 	{
		if(checksimvol(milo)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
 		para1 = ReturnUser(tmp, 1);
		if(IsOnline(para1))
		{
			if(strlen(milo) > 120) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Максимальный размер Email: 120 символов");
			if(strlen(milo) > 5 && strfind(milo, "@", true) != -1 && strfind(milo, ".", true) != -1)
			{
				strmid(PlayerInfo[para1][pMail], milo, 0, strlen(milo));
				PlayerInfo[para1][pMailStat] = 0;
	   			new f_str[128];
	      		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Mail`='%e',`MailStat`='0' WHERE `user_id`='%d'",PlayerInfo[para1][pMail],PlayerInfo[para1][pID]);
	        	query_empty(pearsq, f_str);
	    	    Pochtacode[para1] = 0;
	    	    new loginmsg[256];
	   		    format(loginmsg,256,"{0088ff}*{FFFFFF}Почта Активирована!\n{0088ff}Ваш Email: {ffffff}%s\n\nТеперь вам доступна смена пароля и установка защитного кода.",PlayerInfo[para1][pMail]);
	    	    ShowDialog(para1,1600,DIALOG_STYLE_MSGBOX,"{FF9000}Email",loginmsg,"Ок","");
	    	    format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку %s установлен Email {0088ff}%s",PlayerInfo[para1][pName], milo);
	    	    SendClientMessage(playerid, COLOR_WHITE, string);
	    	    PlayerPlaySound(playerid,6401,0,0,0);
	    	    AdminLog("setmail", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, milo);
    	    }
    	    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Email введён не верно");
    	}
    	else
		{
		   if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: /setmail Lol_Lolkin");
		   mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
           mysql_tquery(pearsq, string, "Call_settopa2", "dss", playerid, tmp, milo);
           return 1;
		}
    }
    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить или установить Email [ /setmail ID Email ]");
    return 1;
}
forward Call_setstat(playerid, setka, amount, str_name[]);
public Call_setstat(playerid, setka, amount, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid, string[144], f_str[144];
		cache_get_value_name_int(0, "user_id", datadid);
		switch (setka)
		{
			case 1: // Уровень
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Level` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				update_power(playerid,1);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline {0088ff}%d {ffffff}уровень", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Уровень");
			}
			case 2: // Exp
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Exp` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено Offline {0088ff}%d {ffffff} Exp", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Exp");
			}
			case 3: // Сила
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `BoxSkill` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено Offline {0088ff}%d {ffffff}силы", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Сила");
			}
			case 4: // Сменить Пол
			{
	            mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Sex` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline {0088ff}%d {ffffff}пол", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Пол");
			}
			case 5: // Изменить Скилл Вождения Вертолётов
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `HeliLic` = '%f' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline скилл вождения вертолётов {0088ff}%d КМ", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Вождение Вертов");
			}
			case 6: // Изменить Скилл Вождения Авто
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `CarLic` = '%f' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline скилл вождения автомобилей {0088ff}%d КМ", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Вождение Авто");
			}
			case 7: // Изменить Скилл Вождения Авиатранспорта
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `FlyLic` = '%f' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline скилл вождения авиатранспорта {0088ff}%d КМ", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Вождение Самолетов");
			}
			case 8: // Изменить Скилл Вождения Катеров
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `BoatLic` = '%f' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline скилл вождения катеров {0088ff}%d КМ", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Вождение Катеров");
			}
			case 9: // Изменить Скилл Вождения Мотоциклов
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `MotoLic` = '%f' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline скилл вождения мотоциклов {0088ff}%d КМ", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Вождение Мото");
			}
			case 10: // Изменить Скилл Владения Оружием
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `GunLic` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline скилл владения оружием {0088ff}%d", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Владение Оружием");
			}
			case 11: // Изменить Репутация
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Repaa` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлена Offline репутация {0088ff}%d", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Репутация");
			}
			case 12: // Изменить Номер Телефона
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `DrugPerk` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен Offline номер телефона {0088ff}%d", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Номер Телефона");
			}
			case 13: // Часов в игре
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `ConnectTime` = '%d' WHERE `Name` = '%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено Offline часов в игре {0088ff}%d", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Часы в Игре");
			}
			case 14: // Убийства
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Kills`='%d' WHERE `Name`='%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено Offline количество убийства {0088ff}%d", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Убийства");
			}
			case 15: // Смерти
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Deaths`='%d' WHERE `Name`='%e'", amount, str_name);
				query_empty(pearsq, f_str);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено Offline количество смертей {0088ff}%d", amount);
				AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", amount, "Смерти");
			}
			default: format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Изменения по данной цифре отсутствуют");
		}
		SendClientMessage(playerid, COLOR_GREY, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:setstat(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    new tmp[24],giveplayerid,stat,amount;
    if (!sscanf(params, "s[24]ii", tmp,stat,amount))
 	{
 	    new string[144];
 		giveplayerid = ReturnUser(tmp, 1);
  		if(IsOnline(giveplayerid))
   		{
			switch (stat)
			{
				case 1: // Уровень
				{
					PlayerInfo[giveplayerid][pLevel] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен {0088ff}%d {ffffff}уровень", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Уровень");
				}
				case 2: // Респекты
				{
					PlayerInfo[giveplayerid][pExp] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено {0088ff}%d {ffffff}Exp", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Exp");
				}
				case 3: // Сила
				{
					PlayerInfo[giveplayerid][pBoxSkill] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено {0088ff}%d {ffffff}силы", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Сила");
				}
				case 4: // Сменить Пол
				{
	                PlayerInfo[giveplayerid][pSex] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен {0088ff}%d {ffffff}пол", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Пол");
				}
				case 5: // Изменить Скилл Вождения вертолётов
				{
					PlayerInfo[giveplayerid][pHeliLic] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен скилл вождения вертолётов {0088ff}%d КМ", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Вождение Вертов");
				}
				case 6: // Изменить Скилл Вождения Авто
				{
					PlayerInfo[giveplayerid][pCarLic] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен опыт вождения автомобилей {0088ff}%d КМ", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Вождение Авто");
				}
				case 7: // Изменить Скилл Вождения Авиатранспорта
				{
					PlayerInfo[giveplayerid][pFlyLic] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен скилл вождения самолётов {0088ff}%d КМ", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Вождение Самолетов");
				}
				case 8: // Изменить Скилл Вождения Катеров
				{
					PlayerInfo[giveplayerid][pBoatLic] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен скилл вождения катеров {0088ff}%d КМ", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Вождение Катеров");
				}
				case 9: // Изменить Скилл Вождения Мотоциклов
				{
					PlayerInfo[giveplayerid][pMotoLic] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен скилл вождения мотоциклов {0088ff}%d КМ", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Вождение Мото");
				}
				case 10: // Изменить Скилл Владения Оружием
				{
					PlayerInfo[giveplayerid][pGunLic] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен скилл владения оружием {0088ff}%d", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Владение Оружием");
				}
				case 11: // Изменить Репутация
				{
					PlayerInfo[giveplayerid][pRepaa] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлена репутация {0088ff}%d", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Репутация");
				}
				case 12: // Изменить Номер Телефона
				{
					PlayerInfo[giveplayerid][pDrugPerk] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлен номер телефона {0088ff}%d", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Номер Телефона");
				}
				case 13: // Часов в игре
				{
					PlayerInfo[giveplayerid][pConnectTime] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено часов в игре {0088ff}%d", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Часов в Игре");
				}
				case 14: // Убийства
				{
					PlayerInfo[giveplayerid][pKills] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено убийств {0088ff}%d", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Убийства");
				}
				case 15: // Смерти
				{
					PlayerInfo[giveplayerid][pDeaths] = amount;
					format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Игроку установлено количество смертей {0088ff}%d", amount);
					AdminLog("setstat", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], amount, "Смерти");
				}
				default: format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Изменения по данной цифре отсутствуют");
			}
			SendClientMessage(playerid, COLOR_GREY, string);
		}
		else
  		{
			if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
			mysql_tquery(pearsq, string, "Call_setstat", "ddds", playerid, stat, amount, tmp);
			return 1;
    	}
	}
	else
	{
	    SendClientMessage(playerid, COLOR_GREY, "Изменение статистики игрока: /setstat ID [номер улучшения] [уровень]");
		SendClientMessage(playerid, COLOR_GREY, "| 1 Левел | 2 Exp | 3 Сила | 4 Пол ");
		SendClientMessage(playerid, COLOR_GREY, "| 5 Вождение Вертолётов | 6 Вождение Авто | 7 Вождение Самолётов | 8 Вождение Катеров ");
		SendClientMessage(playerid, COLOR_GREY, "| 9 Вождение Мото | 10 Владение Оружием | 11 Репутация | 12 Номер Телефона");
		SendClientMessage(playerid, COLOR_GREY, "| 13 Часов в игре | 14 Убийства | 15 Смерти");
	}
	return 1;
}
//----------------------------------[SETINT]-----------------------------------------------

alias:si("setint")
CMD:si(playerid, const params[])
{
	new intid,string[256];
    if (!sscanf(params, "i", intid))
 	{
		if (PlayerInfo[playerid][pSoska] >= 2)
		{
			PPSetPlayerInterior(playerid,intid);
			format(string, sizeof(string), "[ ADM ]: установлен номер Интерьера {99ff66}%d", intid);
			SendClientMessage(playerid, COLOR_GRAD1, string);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить интерьер /setint [номер интерьера]");
	return 1;
}

alias:vi("vehint")
CMD:vi(playerid, const params[])
{
	new intid,string[256];
    if (!sscanf(params, "i", intid))
	{
		if(PlayerInfo[playerid][pSoska] >= 2)
		{
			new carid = GetPlayerVehicleID(playerid);
			LinkVehicleToInterior(carid, intid);
			format(string, sizeof(string), "[ ADM ]: Транспорт, в котором я нахожусь теперь в Интерьере № {99ff66}%d", intid);
			SendClientMessage(playerid, COLOR_GRAD1, string);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить интерьер транспорта /vehint [номер интерьера]");
	return 1;
}

alias:vw("vehworld")
CMD:vw(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. Я не могу это сделать");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить вирт. мир транспорта /vehworld [номер мира]");
	new string[144];
	new carid = GetPlayerVehicleID(playerid);
	SetVehicleVirtualWorld(carid, params[0]);
	format(string, sizeof(string), "[ ADM ]: Транспорт, в котором я нахожусь теперь в виртуальном мире № {99ff66}%d", params[0]);
	SendClientMessage(playerid, COLOR_GRAD1, string);
	return 1;
}

stock UninvitePlayer(playerid, para1, const result[])
{
	if(PlayerInfo[para1][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя уволить лидера");

	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 9, NO_FBI)) return 1;
	new string[144];
	if(PlayerInfo[para1][pFbi] >= 1 && PlayerInfo[playerid][pLeader] == 2)
 	{
		format(string, sizeof(string),"{FF0000}[!!!] Вас уволил из F.B.I. %s. {ffffff}Причина: %s", PlayerInfo[playerid][pName],result);
  		ShowDialog(para1, 191, 0, "{FF0000}**** {0088ff}Вы были Уволены! {FF0000}****", string, "Ок", "");
  		format(string, sizeof(string), "[ Мысли ]: {ffcc00}%s{cccccc} уволил меня из FBI. Причина: {ffcc00}%s", PlayerInfo[playerid][pName],result);
		SendClientMessage(para1, COLOR_GREY, string);

		Protect_Remove(playerid, 34);
		if(TempWeapon[playerid][6] == 34 && TempAmmo[playerid][6] >= 1) TempWeaponClear(playerid, 6);
		PlayerInfo[para1][pFbi] = 0;
		mysql_save(para1, 9);
		format(string, sizeof(string), " {ffffff}Игрок {0088ff}%s {ffffff}уволен из FBI. Причина: %s", PlayerInfo[para1][pName],result);
		SendClientMessage(playerid, COLOR_GREY, string);
		if(Fractia[playerid] >= 1 && Fractia[playerid] <= 100 || Fractia[playerid] == 300) CloseShmot(playerid), ExitShmot(playerid);
		if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1) work_leader(playerid, 6);
		OrgLog(frakid, "uninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, result);
		LaborLog(frakid, "uninvite", PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pRank], result);

		uninviteDivision(playerid, 2);

		if(PlayerInfo[para1][pHidden] == 0) UninvitePlayerBridge(PlayerInfo[para1][pID], 2);
		return 1;
	}
	if(PlayerInfo[para1][pMember] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Поздно, он уже уволен..");
	if(PlayerInfo[playerid][pLeader] == PlayerInfo[para1][pMember] || PlayerInfo[playerid][pLeader] == PlayerInfo[para1][pLeader])
	{
		if(PlayerInfo[playerid][pLeader] == 4 || PlayerInfo[playerid][pMember] == 4) CloseMed(playerid);	
		format(string, sizeof(string),"{FF0000}[!!!] Вас уволил из организации %s. {ffffff}Причина: %s\n\n{0088ff}** Вы снова гражданский. Можете вступить в другую организацию.", PlayerInfo[playerid][pName],result);
  		ShowDialog(para1, 191, 0, "{FF0000}**** {0088ff}Вы были Уволены! {FF0000}****", string, "Ок", "");
  		format(string, sizeof(string), "[ Мысли ]: Меня уволил {ffcc00}%s{cccccc}. Причина: {ffcc00}%s", PlayerInfo[playerid][pName],result);
		SendClientMessage(para1, COLOR_GREY, string);
		format(string, sizeof(string), " {ffffff}Игрок {0088ff}%s {ffffff}уволен из моей организации. Причина: %s", PlayerInfo[para1][pName],result);
		SendClientMessage(playerid, COLOR_WHITE, string);
		LaborLog(frakid, "uninvite", PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pRank], result);
		Uninvite(para1,0);
		if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 6);
		OrgLog(frakid, "uninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, result);
		return 1;
	}
	if(PlayerInfo[para1][pFbi] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не агент под прикрытием");
	return 1;
}
stock CloseMed(playerid)
{
	if(Heal[playerid] == 7777)
	{
		Heal[playerid] = 9999;
		RemovePlayerAttachedObject(playerid,0);
		DestroyDynamic3DTextLabel(TradeLabel[playerid]);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зона медицинской помощи: {ff0000}[ Свёрнута ]");
		SetPlayerChatBubble(playerid,"сворачивает зону медицинской помощи",COLOR_PURPLE,20.0,3000);
	}
	return 1;
}
CMD:uninvite(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 9, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	new string[200],tmp[24], para1, result[34];
	if(sscanf(params, "s[24]s[64]",tmp,result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Уволить участника организации [ /uninvite ID Причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	
	// Антипидор
	if(AntiPidor(playerid, 5)) return 1;

	para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
 	{
 		if(playerid == para1) return SendClientMessage(playerid, COLOR_GRAD2, "[ Мысли ]: Я не могу исключить себя из организации [ /leave ]");
 		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
   		if(PlayerInfo[para1][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя уволить лидера");
   		if(frakid == 2)
   		{
   		    if(PlayerInfo[para1][pFbi] >= 1 && PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Увольнять сотрудников под прикрытием может только лидер");
   		    if(PlayerInfo[para1][pFbi] == 0 && frakid != PlayerInfo[para1][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
   		}
   		else
   		{
   			if(frakid != PlayerInfo[para1][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
  		}
		if(PlayerInfo[para1][pRank] >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу увольнять только младших по рангу");
		UninvitePlayer(playerid, para1, result);
		SetRaitingSektaInFrak(para1,0,0);
   	}
	else // Если игрок Offline
   	{
		if(PlayerInfo[playerid][pLeader] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только лидер может уволить участника Offline");
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Member, Leader, Rank, Fbi, Family, Ammo5 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_uninvite", "dss", playerid, tmp, result);
		return 1;
    }
	return 1;
}
CMD:invite(playerid, const params[])
{
    new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 8, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Пригласить игрока [ /invite ID ]");
	if(Kapt[fraction(playerid)] >= 1 && fraction(playerid) >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне сейчас некогда! [ Запрещено приглашать участников во время Капта ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
    if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко от него");
	/*if(frakid == 13 || frakid == 14 || frakid == 15 || frakid == 16)
	{
		if(PlayerInfo[params[0]][pLevel] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он только что приехал в этот штат [ Level 2+ ]");
	}
	else
	{
		if(PlayerInfo[params[0]][pLevel] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он только что приехал в этот штат [ Level 2+ ]");
	}*/
    /*if(frakid == 3 || frakid == 1 || frakid == 2 || frakid == 11 || frakid == 21 || frakid == 22)
	{
		if(PlayerInfo[params[0]][pBilet] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Гражданин должен быть призывником или иметь военный билет");
	}*/
	if(PlayerInfo[params[0]][pMember] >= 1 || PlayerInfo[params[0]][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он уже где-то состоит");
	if(frakid == 2 && PlayerInfo[params[0]][pFbi] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он уже состоит в FBI");
	if(frakid == 1 || frakid == 2 || frakid == 3 || frakid == 4 || frakid == 7 || frakid == 9 || frakid == 11 || frakid == 21 || frakid == 22)
	{
		if(PlayerInfo[params[0]][pCrimes] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Гражданин находится в розыске");
	}
	if(frakid == 2)
	{
		if(!strcmp(PlayerInfo[params[0]][pMail],"\0",true)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него проблемы с документами [Не привязан Email] [ Y >> Меню >> Аккаунт >> Email ]");
		else
		{
			if(PlayerInfo[params[0]][pMailStat] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него проблемы с документами [Не подтверждён Email] [ Y >> Меню >> Аккаунт >> Email ]");
		}
	}
	if(PlayerInfo[params[0]][pWarns] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него проблемы с документами [2+ Warns]");
	
	new string_mysql[120];
	mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", PlayerInfo[params[0]][pID], frakid);
   	mysql_tquery(pearsq, string_mysql, "get_a_bl", "ddsddd", playerid, frakid, PlayerInfo[params[0]][pName], 1, params[0], 0);
	return 1;
}

CMD:respcars(playerid)
{
	new g = fraction(playerid);
	if (g <= 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if (!IsLeader(playerid) && !IsSubLeader(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не являетесь лидером или заместителем");
	if (GetPVarInt(playerid, "antiflood") > 0) return ErrorMessage(playerid, "{ff6347}Подождите некоторое время перед использованием команды");
	
	new count = 0;
	foreach (new vehicleid : Vehicle)
	{
		if (!IsValidVehicle(vehicleid)) continue;
		
		if (g == 1) {
			if ( (vehicleid < LSPDcar[0] || vehicleid > LSPDcar[1]) && (vehicleid < NonLSCar[0] || vehicleid > NonLSCar[1]) ) continue;
		} else if (g == 2) {
			if (vehicleid < fbicar[0] || vehicleid > fbicar[1]) continue;
		} else if (g == 3) {
			if (vehicleid < armcar[0] || vehicleid > armcar[1]) continue;
		} else if (g == 4) {
			if (vehicleid < Medcar[0] || vehicleid > Medcar[1]) continue;
		} else if (g == 7) {
			if (vehicleid < govcar[0] || vehicleid > govcar[1]) continue;
		} else if (g == 9) {
			if (vehicleid < cnncar[0] || vehicleid > cnncar[1]) continue;
		} else if (g == 11) {
			if ( (vehicleid < SFPDcar[0] || vehicleid > SFPDcar[1]) && (vehicleid < NonSFCar[0] || vehicleid > NonSFCar[1]) ) continue;
		} else if (g == 22) {
			if ( (vehicleid < swatcar[0] || vehicleid > swatcar[1]) && (vehicleid < janswat[0] || vehicleid > janswat[3]) ) continue;
		}

		if (IsVehicleOccupied(vehicleid)) continue;
		
		ACRepairVehicle(vehicleid);
		PP_SetVehicleToRespawn(vehicleid);

		count++;
	}
	if (count == 0) return ErrorMessage(playerid, "{FF6347}Нет доступных автомобилей для возвращения на парковку");
	
	new string[144];
	format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s отправил на спавн весь незанятый транспорт организации **", getNameRank(playerid), PlayerInfo[playerid][pName]);
    SendRadioMessage(g, COLOR_ALLDEPT, string);

	bigint_sub(OrganInfo[g][glave], 30000);
	OrganInfo[g][gUpdate] = 1;
	SetPVarInt(playerid, "antiflood", 2);
	OrgLog(g, "respcars", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -30000, "Отправил транспорт на спавн");

	return 1;
}

stock max_rank_diplom(g)
{
	new get_rank;
	switch(g)
	{
	    case 1, 7, 11, 21, 22: get_rank = 7;
	    case 2, 9: get_rank = 8;
	    case 3, 4: get_rank = 10;
		default: get_rank = 228;
	}
	return get_rank;
}

CMD:giverank(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 10, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	new string[200], tmp[24], giveplayerid;
	if(sscanf(params, "s[24]i",tmp,params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить должность подчинённого [ /giverank ID Ранг ]");
	if(params[0] > get_maxrank(frakid) || params[0] < 1) return format(string,sizeof(string),"[ Мысли ]: Ранг не меньше 1 и не больше %d",get_maxrank(frakid)), SendClientMessage(playerid, COLOR_GREY, string);
	if(params[0] >= PlayerInfo[playerid][pRank] && PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдавать ранг своего уровня или больше");
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
 	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Не залогинился ]");
		if(PlayerInfo[giveplayerid][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя изменять ранг лидера");
		if(frakid != PlayerInfo[giveplayerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
		if(playerid == giveplayerid && PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GRAD2, "[ Мысли ]: Я не могу изменять свой ранг");
		if(PlayerInfo[giveplayerid][pRank] >= PlayerInfo[playerid][pRank] && PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу изменять ранг только подчинённым");
		//if(params[0] >= 9 && PlayerInfo[giveplayerid][pConnectTime] <= 49) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя выдать неопытному человеку 9+ ранг [ 50+ часов ]");
		/*if(params[0] >= max_rank_diplom(frakid) && params[0] >= PlayerInfo[giveplayerid][pRank])
		{
		    if(get_invent2(giveplayerid, 160, 0) == 0)
		    {
				format(string, sizeof(string), "{FF6347}У него нет высшего образования [ В %s с %d ранга требуется наличие высшего образования ]", frakeasyName[frakid], max_rank_diplom(frakid));
				ErrorMessage(playerid, string);
				return 1;
			}
		}*/ // VREMENNO

		PlayerInfo[giveplayerid][pRank] = params[0];
		format(string, sizeof(string), "{00cc00}[ {cccccc}Мысли {00cc00}] %s{cccccc} выдал мне ранг № {00cc00}%d", PlayerInfo[playerid][pName],params[0]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		format(string, sizeof(string), "{ffffff} Игрок {0088ff}%s {ffffff}получил ранг № %d", PlayerInfo[giveplayerid][pName],params[0]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		OrgLog(frakid, "giverank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], params[0], "");
		new f_str[128];
 		mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Rank`='%d' WHERE `Name`='%e'",params[0], PlayerInfo[giveplayerid][pName]);
 		query_empty(pearsq, f_str);
  		if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 10);

		if(PlayerInfo[giveplayerid][pHidden] == 0) GiverankPlayerBridge(PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pMember], PlayerInfo[giveplayerid][pRank]);

		SetRaitingSektaInFrak(giveplayerid,frakid,params[0]);
	}
	else
 	{
  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT user_id, ConnectTime, Member, Leader, Rank, LastRank, Family, Ammo5 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_giverank", "dsd", playerid, tmp,params[0]);
      	return 1;
	}
	return 1;
}
forward Call_giverank(playerid, str_name[], level);
public Call_giverank(playerid, str_name[], level)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	      new datad1, datad2, datad3, datad4, datad12,fam,lastrank,string[180],f_str[140], Ammo5;
	      cache_get_value_name_int(0, "Member", datad1);
	      cache_get_value_name_int(0, "Leader", datad2);
	      cache_get_value_name_int(0, "ConnectTime", datad3);
	      cache_get_value_name_int(0, "Rank", datad4);
	      cache_get_value_name_int(0, "user_id", datad12);
		  cache_get_value_name_int(0, "LastRank", lastrank);
		  cache_get_value_name_int(0, "Family", fam);
		  cache_get_value_name_int(0, "Ammo5", Ammo5);
	      if(PlayerInfo[playerid][pLeader] == datad1 || PlayerInfo[playerid][pLeader] == datad2)
          {
				if(datad4 >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу изменять ранг только подчинённым");
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Rank` = '%d',`LastRank` = '%d' WHERE `Name` = '%e'", level, datad4, str_name);
				query_empty(pearsq, f_str);
				if(PlayerInfo[playerid][pSoska]==0)PlayerInfo[playerid][pWorked5] ++;
				format(string, sizeof(string), "{ffffff}[ {0088ff}LEADER {ffffff}] Игрок {0088ff}%s {ffffff}Offline получил ранг № %d", str_name,level);
				SendClientMessage(playerid, COLOR_WHITE, string);

				OrgLog(fraction(playerid), "giverank", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad12, str_name, "", level, "");
				
				if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 10);
				
				if(level > datad4) FamilyInfo[fam][fInfluence] += level*CallBackRankPoint(datad1) - datad4*CallBackRankPoint(datad1);
				else if(level > datad4) FamilyInfo[fam][fInfluence] -= datad4*CallBackRankPoint(datad1) - level*CallBackRankPoint(datad1);

				format(string, sizeof(string), "Ваш ранг в %s изменён с %d на %d",orgName[datad1],datad4,level);
				notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad12, str_name, string);

				// Ammo5 == 0 значит не скрытый акк
				if(Ammo5 == 0) GiverankPlayerBridge(datad12, datad1, level);
          }
          else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
forward Call_vigovor(playerid, str_name[], reason[]);
public Call_vigovor(playerid, str_name[], reason[])
{
	new rows,string[144],f_str[256];
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datad3, datad6, datad12, Ammo5;
		cache_get_value_name_int(0, "Vig", datad3);
		cache_get_value_name_int(0, "Leader", datad2);
		cache_get_value_name_int(0, "Member", datad1);
		cache_get_value_name_int(0, "Rank", datad6);
		cache_get_value_name_int(0, "user_id", datad12);
		cache_get_value_name_int(0, "Ammo5", datad12);
		if(datad2>=1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не мой подчинённый");
		new frakid;
		if(PlayerInfo[playerid][pLeader] >= 1) frakid = PlayerInfo[playerid][pLeader];
		else if(PlayerInfo[playerid][pLeader] == 0) frakid = PlayerInfo[playerid][pMember];
		if(frakid == datad1)
		{
			if(PlayerInfo[playerid][pLeader] == 0 && PlayerInfo[playerid][pRank] < datad6) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать выговор старшему по рангу");

			// Антипидор
			if(AntiPidor(playerid, 11)) return 1;

	 		if(datad3 >= 4)
  			{
  				if(PlayerInfo[playerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Увольнять Offline имеет право только лидер [ 4/5 выговоров ]");

				LaborLog(frakid, "uninvite", datad12, str_name, datad6, reason);

  				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Member`='0',`Rank`='0',`Vig`='0',`Division0`='0' WHERE `Name` = '%e'",str_name);
      			query_empty(pearsq, f_str);
         		format(string, sizeof(string), "{ffffff}[ {ff0000}LEADER {ffffff}] Подчинённый {0088ff}%s {ffffff}получил пятый выговор и был уволен. Причина: %s", str_name,reason);
				SendClientMessage(playerid, COLOR_GREY, string);
				OrgLog(frakid, "uninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad12, str_name, "", 0, reason);
				format(string, sizeof(string), "Вы получили выговор и были уволены. Причина: %s",reason);
		  		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad12, str_name, string);

				if(Ammo5 == 0) UninvitePlayerBridge(datad12, datad1);
  			}
  			else
  			{
  				format(string, sizeof(string), "{ffffff} Подчинённый {0088ff}%s {ffffff}получил выговор. Причина: %s", str_name,reason);
		  		SendClientMessage(playerid, COLOR_GREY, string);
		  		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Vig` = '%d' WHERE `Name` = '%e'",datad3+1,str_name);
      			query_empty(pearsq, f_str);
		  		OrgLog(frakid, "vig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad12, str_name, "", datad3+1, reason);
		  		format(string, sizeof(string), "Вы получили выговор. Причина: %s",reason);
		  		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad12, str_name, string);
  			}
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не мой подчинённый");
	}
	else
    {
	  format(string,sizeof(string),"{cccccc}[ Мысли ]: Я не могу найти этого подчинённого [ {ff0000}%s {cccccc}]",str_name);
      SendClientMessage(playerid,COLOR_GREY,string);
    }
	return true;
}
CMD:vig(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 11, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	new string[194], tmp[121], reason[121], giveplayerid;
	if(sscanf(params, "s[121]s[121]", tmp,reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выговор подчинённому [ /vig ID Причина ]");
	if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	if(strlen(reason) > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинная причина.. [ Лимит 30 символов ]");
	giveplayerid = ReturnUser(tmp, 1);
	if(IsOnline(giveplayerid))
	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Не залогинился ]");
		if(PlayerInfo[giveplayerid][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя выдать выговор лидеру");
		if(frakid != PlayerInfo[giveplayerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
		if(playerid == giveplayerid) return SendClientMessage(playerid, COLOR_GRAD2, "[ Мысли ]: Я не могу выдать выговор себе");
		if(PlayerInfo[giveplayerid][pRank] >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу предупредить только подчинённого");
		
		// Антипидор
		if(AntiPidor(playerid, 11)) return 1;

 		if(PlayerInfo[giveplayerid][pVig] >= 4) return format(string, sizeof(string), "%s [5/5 Выговоров]", reason), UninvitePlayer(playerid, giveplayerid, string);
		else
		{
			PlayerInfo[giveplayerid][pVig] ++;
			format(string, sizeof(string), "{ffffff} Подчинённый {0088ff}%s {ffffff}получил выговор. Причина: %s", PlayerInfo[giveplayerid][pName],reason);
	  		SendClientMessage(playerid, COLOR_GREY, string);
	  		format(string, sizeof(string), "{ffcc00}[ {cccccc}Мысли {ffcc00}] %s{cccccc} выдал мне выговор по причине: {ffcc00}%s", PlayerInfo[playerid][pName],reason);
	  		SendClientMessage(giveplayerid, COLOR_WHITE, string);
	  		format(string, sizeof(string),"{FF0000}[!!!] %s выдал мне выговор по причине: %s\n\n{cccccc}Будьте осторожны! Пятый выговор автоматически уволит вас из организации", PlayerInfo[playerid][pName],reason);
			ShowDialog(giveplayerid, 191, 0, "{ff9000}Выговор", string, "Ок", "");
			OrgLog(frakid, "vig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pVig], reason);
	  		mysql_save(giveplayerid, 9);
	  		if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 7);
		}
	}
	else
   	{
 		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
   		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Member, Leader, Rank, Vig, Ammo5 FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
     	mysql_tquery(pearsq, string, "Call_vigovor", "dss", playerid, tmp, reason);
     	return 1;
   	}
	return 1;
}
forward Call_unvigovor(playerid, str_name[]);
public Call_unvigovor(playerid, str_name[])
{
	new rows,string[144],f_str[256];
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datad3, datad4, datad5;
		cache_get_value_name_int(0, "Vig", datad1);
		cache_get_value_name_int(0, "Leader", datad2);
		cache_get_value_name_int(0, "Member", datad3);
		cache_get_value_name_int(0, "Rank", datad4);
		cache_get_value_name_int(0, "user_id", datad5);
		new frakid;
		if(PlayerInfo[playerid][pLeader] >= 1) frakid = PlayerInfo[playerid][pLeader];
		else if(PlayerInfo[playerid][pLeader] == 0) frakid = PlayerInfo[playerid][pMember];
		if(datad2>=1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя снять выговор с лидера");
		if(frakid != datad3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
		if(datad4 >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу снять выговор только с подчинённого");
		if(datad1 <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет выговоров");
		new vigi;
 		if(datad1 >= 6) vigi = 0;
 		else vigi = datad1-1;
		format(string, sizeof(string), "{ffffff} Подчинённому {0088ff}%s {ffffff} снят выговор", str_name);
		SendClientMessage(playerid, COLOR_WHITE, string);
		OrgLog(frakid, "unvig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad5, str_name, "", vigi, "");
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Vig` = '%d' WHERE `Name` = '%e'",vigi,str_name);
  		query_empty(pearsq, f_str);

    	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 8);
 		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad5, str_name, "У вас снят выговор");
	}
	else format(string,sizeof(string),"{cccccc}[ Мысли ]: Я не могу найти этого подчинённого [ {ff0000}%s {cccccc}]",str_name), SendClientMessage(playerid,COLOR_GREY,string);
	return 1;
}
CMD:unvig(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 12, NO_FBI)) return 1;
	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять выговор [ /unvig ID ]");
	if(strlen(params[0]) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	new string[194], giveplayerid;
	giveplayerid = ReturnUser(params[0], 1);
	if(IsOnline(giveplayerid))
	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Не залогинился ]");
		if(PlayerInfo[giveplayerid][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя снять выговор с лидера");
		if(frakid != PlayerInfo[giveplayerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
		if(playerid == giveplayerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кажется нельзя снимать самому себе выговор");
		if(PlayerInfo[giveplayerid][pRank] >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу снять выговор только с подчинённого");
		if(PlayerInfo[giveplayerid][pVig] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет выговоров");
		format(string, sizeof(string), "{ffcc00}[ {cccccc}Мысли {ffcc00}] %s {cccccc}снял с меня выговор", PlayerInfo[playerid][pName]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		format(string, sizeof(string), "{ffffff} Подчинённому {0088ff}%s {ffffff} снят выговор", PlayerInfo[giveplayerid][pName]);
	    SendClientMessage(playerid, COLOR_WHITE, string);
		if(PlayerInfo[giveplayerid][pVig] >= 6) PlayerInfo[giveplayerid][pVig] = 0;
		else PlayerInfo[giveplayerid][pVig] --;

		mysql_save(giveplayerid, 9);
		OrgLog(frakid, "unvig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[giveplayerid][pVig], "");
		if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 8);
	}
	else
	{
		if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Member, Leader, Rank, Vig FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
	 	mysql_tquery(pearsq, string, "Call_unvigovor", "ds", playerid, params[0]);
	 	return 1;
	}
	return 1;
}

alias:rmute("dmute")
CMD:rmute(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 13, NO_FBI)) return 1;
	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");

	new string[194], tmp[120],minut,reason[120],para1;
	if(sscanf(params, "s[120]is[120]", tmp, minut,reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мут на рацию организации [ /rmute ID Время Причина ]");
	if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя.. [ Лимит 20 символов ]");
	if(strlen(reason) > 30) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинная причина [ Лимит 30 символов ]");
	if(minut > 30 || minut < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 30 минут");
	para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
	{
		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет.. [ Не залогинился ]");
		if(PlayerInfo[para1][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя выдать мут лидеру");
		if(playerid == para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кажется нельзя выдать мут самому себе");
		if(frakid == PlayerInfo[para1][pMember])
		{
			if(frakid == 8)format(string, sizeof(string), "{FF0000}%s заставляет замолчать Агента №%d на %d минут, причина: %s",PlayerInfo[playerid][pName],PlayerInfo[para1][pID],minut,reason);
       		else format(string, sizeof(string), "{FF0000}%s заставляет замолчать %s на %d минут, причина: %s",PlayerInfo[playerid][pName],PlayerInfo[para1][pName],minut,reason);
          	SendRadioMessage(frakid, COLOR_GREY, string);
           	PlayerInfo[para1][pFmuteTime] = minut*60;
            format(string, sizeof(string), "{0088ff}Вас заставил замолчать %s, на %d минут,  причина: %s", PlayerInfo[playerid][pName], minut,reason);
			SendClientMessage(para1, COLOR_LIGHTRED, string);
			OrgLog(frakid, "fmute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], minut, reason);
			if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 9);

		}
		else
		{
			if(IsADepart(playerid) && IsADepart(para1))
			{
				format(string, sizeof(string), "{FF0000}%s заставляет замолчать %s на %d минут, причина: %s",PlayerInfo[playerid][pName],PlayerInfo[para1][pName],minut,reason);
      			SendDepartMessage(COLOR_ALLDEPT, string);
     			PlayerInfo[para1][pFmuteTime] = minut*60;
        		format(string, sizeof(string), "{0088ff}Вас заставил замолчать %s, на %d минут,  причина: %s", PlayerInfo[playerid][pName],minut,reason);
		      	SendClientMessage(para1, COLOR_LIGHTRED, string);
   				OrgLog(frakid, "dmute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], minut, reason);
   				if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 9);
			}
			else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Только для сотрудников департамента");
		}
 	}
 	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет...");
	return 1;
}
CMD:payment(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 20, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	if(sscanf(params, "ii",params[0], params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать разрешение на разовую выплату юнитов [ /payment ID Сумма ]");
	if(params[1] < 1 || params[1] > 10000000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сумма юнитов не меньше 1$ и не больше 10.000.000$");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко..");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко..");
	if(PlayerInfo[params[0]][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя выдать разрешение на выплату лидеров");
	if(frakid != PlayerInfo[params[0]][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
	if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать разрешение себе..");
	if(PlayerInfo[params[0]][pRank] >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу выдать разрешение на выплату только подчинённому");
	if(Payment[params[0]] > gettime()) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него имеется активное разрешение на выплату");
	
	new string[144];
	Payment[params[0]] = gettime()+600;
	PayCash[params[0]] = params[1];
 	format(string, sizeof(string), "Разрешение на разовую выплату в размере {99ff66}%d$ {ffffff}от %s [ Время Действия: 10 минут ]", params[1],PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "[ Мысли ]: %s выдал мне разрешение на разовую выплату в размере {99ff66}%d$ {ff0000}[ Время Действия: 10 минут ]",PlayerInfo[playerid][pName], params[1]);
	SendClientMessage(params[0], COLOR_GREY, string);
	PlayerPlaySound(params[0],6400,0,0,0);
	format(string, sizeof(string), "* %s передаёт разрешение на разовую выплату %s в размере %d$", PlayerInfo[playerid][pName], PlayerInfo[params[0]][pName], params[1]);
	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	OrgLog(frakid, "payment", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], params[1], "");
 	return 1;
}
CMD:dismiss(playerid, const params[])
{
	new frakid = fraction(playerid);
	if(frakid == 0) return ErrorMessage(playerid, "{FF6347}Вы не состоите в организации");
	if(!GetAccessRankOrg(playerid, frakid, 15, NO_FBI)) return 1;

	new string[144];
	if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня не привязан Google Authenticator [ /mm >> Аккаунт ]");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать разрешение на самостоятельное увольнение [ /dismiss ID ]");
	if(!IsOnline(params[0])) return ErrorText(playerid, "[ Мысли ]: Игрока нет в сети");
	if(!ProxDetectorS(3.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко..");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко..");
	if(PlayerInfo[params[0]][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя выдать разрешение на увольнение лидеру");
	if(frakid != PlayerInfo[params[0]][pMember]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне кажется, это не участник моей организации");
	if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать разрешение себе..");
	if(PlayerInfo[params[0]][pRank] >= PlayerInfo[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу выдать разрешение на увольнение только подчинённому");
	if(Dismiss[params[0]] > gettime()) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него имеется активное разрешение на увольнение");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Вы находитесь в слежке");
	Dismiss[params[0]] = gettime()+600;
 	format(string, sizeof(string), "Разрешение на самостоятельное увольнение выдано для %s [ Время Действия: 10 минут ]",PlayerInfo[params[0]][pName]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "[ Мысли ]: %s выдал мне разрешение на увольнение {ff9000}[ /leave ]{ff0000}[ Время Действия: 10 минут ]",PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_GREY, string);
	PlayerPlaySound(params[0],6400,0,0,0);
	format(string, sizeof(string), "* %s передаёт разрешение на увольнение %s", PlayerInfo[playerid][pName], PlayerInfo[params[0]][pName]);
	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	OrgLog(frakid, "dismiss", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], 0, "");
 	return 1;
}

alias:leave("vipuninvite")
CMD:leave(playerid)
{
	if(PlayerInfo[playerid][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком большая ответственность, я не могу снять с себя лидерку");
	if(PlayerInfo[playerid][pMember] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не состою в организации");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(GetPlayerVip(playerid) >= 3 || Dismiss[playerid] >= gettime())
	{
		new string[144];
   		PlayerPlaySound(playerid,40405,0,0,0);
   		DP[0][playerid] = 0;
   		format(string, sizeof(string), "\n\n{ffcc00}Вы уверены, что хотите покинуть %s{cccccc}?\n\n",frakName[fraction(playerid)]);
		ShowDialog(playerid,618,DIALOG_STYLE_MSGBOX,"{cccccc}Menu {ff9000}Организации",string,"Да","Нет");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Для самостоятельного увольнения мне требуется Premuim VIP или разрешение");
	return 1;
}
