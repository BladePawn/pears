				 		|| EffectTime[i] == 550 || EffectTime[i] == 600 || EffectTime[i] == 650 || EffectTime[i] == 700 || EffectTime[i] == 750 || EffectTime[i] == 800 || EffectTime[i] == 850 || EffectTime[i] == 900
