CMD:messoff(playerid)
{
      if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pHidden] >= 1)
      {
        if(GetPVarInt(playerid,"Admessage") == 0)
        {
    		SetPVarInt(playerid,"Admessage",1);
    		SendClientMessage(playerid, COLOR_WHITE, "{00cc00}[ {ffffff}Мысли ADM {00cc00}]{ffffff}: Просмотр сообщений [ /sp ] {00cc00}включён");
        }
        else if(GetPVarInt(playerid,"Admessage") == 1)
        {
    		SetPVarInt(playerid,"Admessage",0);
    		SendClientMessage(playerid, COLOR_WHITE, "{00cc00}[ {ffffff}Мысли ADM {00cc00}]{ffffff}: Просмотр сообщений [ /sp ] {ff0000}отключён");
        }
 	  }
	  return 1;
}

CMD:mytv(playerid, const params[])
{
	if(PlayerInfo[playerid][pLeader] == 8)
	{
		if(gSpectateID[playerid] != INVALID_PLAYER_ID) return StopSpectate(playerid);
		if(!IsPlayerInRangeOfPoint(playerid, 2.0,-533.4505,-93.7811,969.1866)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я далеко от мониторов для наблюдения");
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слежка за подчинённым [ /mytv ID ]");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		if(PlayerInfo[params[0]][pMember] != 8) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не мой подчинённый");
		if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу следить за собой");
		if(PlayerInfo[params[0]][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу следить за администратором");
		if(OverHear[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Невозможно во время использования камер слежения");
		if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
		new string[64];
		if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID)
		{
			format(string,sizeof(string),"[ Мысли ]: Он наблюдает за: {ff9000}%s",PlayerInfo[gSpectateID[params[0]]][pName]);
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
		if(GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT && GetPlayerState(params[0]) != PLAYER_STATE_DRIVER && GetPlayerState(params[0]) != PLAYER_STATE_PASSENGER) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Подчинённый ещё не зареспавнился");
		if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
		{
 			GetPlayerPos(playerid, SpX[playerid], SpY[playerid], SpZ[playerid]); GetPlayerFacingAngle(playerid, SpA[playerid]);
			SpInt[playerid] = GetPlayerInterior(playerid);
			SpWorld[playerid] = GetPlayerVirtualWorld(playerid);
			S_SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0]), GetPlayerInterior(params[0]));
			PPSetPlayerInterior(playerid, GetPlayerInterior(params[0]));
  		}
		StartSpectate(playerid, params[0], 1);
		if(PlayerInfo[playerid][pLeader] == 8 || PlayerInfo[playerid][pMember] == 8)
		{
			if(LoadIcaSP[playerid] == false) LoadIcaSpec(playerid);
			UpdateIcaDraw(playerid, params[0]);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не лидер агенства");
	return 1;
}

alias:gm("godmode")
CMD:gm(playerid)
{
	if (PlayerInfo[playerid][pSoska] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");

	OnlineInfo[playerid][oAdminGM] ^= true;

	SendClientMessage(playerid, COLOR_GREY, "[ Мысли ADM ]: Режим бессмертия %s",
		OnlineInfo[playerid][oAdminGM] ? "{99ff66}ON" : "{ff6347}OFF"
	);

	return 1;
}

CMD:sp(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pMedia] != 3) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слежка за игроком [ /sp ID ]");
	if(!IsOnline(params[0])) return ErrorMessage(playerid, "{FF6347}Игрока под этим id нет в сети");
	if(params[0] == playerid) return ErrorMessage(playerid, "{FF6347}Нельзя следить за собой");
	if(CnnVed[playerid] >= 11) return ErrorMessage(playerid, "{FF6347}Вы смотрите CNN Channel");
	if(PlayerInfo[params[0]][pSoska] > PlayerInfo[playerid][pSoska] && OnlineInfo[params[0]][oLogged] == 1 && PlayerInfo[playerid][pHidden] == 0 && PlayerInfo[playerid][pSoska] < 21) return ErrorMessage(playerid, "{FF6347}Вы не можете следить за администратором выше своего уровня");
	if(IsPlayerEditObject(playerid) || MenuInfo[playerid][zStat] == 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят редактированием объекта");
	if(OverHear[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вы используете камеры слежения");
	if(DeskStatus[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Выйдите из-за стола, после чего отправляйтесь в слежку");
	if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
	new string[64];
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID)
	{
	    if(PlayerInfo[params[0]][pHidden] == 0) format(string,sizeof(string),"[ Мысли ]: Он наблюдает за: %s[%d]",PlayerInfo[gSpectateID[params[0]]][pName], gSpectateID[params[0]]), SendClientMessage(playerid, COLOR_GREY, string);
	    else ErrorMessage(playerid, "{FF6347}Игрок ещё не зареспавнился");
		return 1;
	}
	if(GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT && GetPlayerState(params[0]) != PLAYER_STATE_DRIVER && GetPlayerState(params[0]) != PLAYER_STATE_PASSENGER) return ErrorMessage(playerid, "{FF6347}Игрок ещё не зареспавнился");
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid); // Закрываем Инвентарь
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid); // Закрываем смартфон

	if(OnlineInfo[playerid][oShowInterface] > 0) return ErrorMessage(playerid, "{FF6347}Закройте открытый интерфейс или меню");

	if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING) // Сохраняем позицию
	{
		new Float:X, Float:Y, Float:Z, Float:A;
 		GetPlayerPos(playerid, X, Y, Z); GetPlayerFacingAngle(playerid, A);
		SpA[playerid]=A;SpX[playerid]=X;SpY[playerid]=Y;SpZ[playerid]=Z;
		SpInt[playerid]=GetPlayerInterior(playerid);
		SpWorld[playerid]=GetPlayerVirtualWorld(playerid);
		S_SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(params[0]),GetPlayerInterior(params[0]));
		PPSetPlayerInterior(playerid,GetPlayerInterior(params[0]));
	}
	if(Moiplayer[playerid] != 9999) close_interaction(playerid); // Закрываем интерактирование

	if(LoadSP[playerid] == false) LoadSpecDraw(playerid);
	StartSpectate(playerid, params[0], 1);
	return 1;
}
CMD:spoff(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pHidden] >= 1 || PlayerInfo[playerid][pMedia] == 3)
	{
		if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY) return ErrorMessage(playerid, "{FF6347}Для выхода из летающей камеры используйте повторно [ /flycam ]");
		if(OverHear[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Невозможно во время использования камер слежения");
		StopSpectate(playerid);
	}
	return 1;
}
forward Call_setfam(playerid, str_name[],fam);
public Call_setfam(playerid, str_name[],fam)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
    {
    	new datadid,string[144],f_str[256];
       	cache_get_value_name_int(0, "user_id", datadid);
		AdminLog("setfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", fam, "");
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Family` = '%d',`Famrank` = '1' WHERE `Name` = '%e'",fam,str_name);
		query_empty(pearsq, f_str);
		format(string, sizeof(string), "{FFFFFF}Игроку %s установлен номер семьи {0088ff}%d {ff0000}Offline",str_name,fam);
		SendClientMessage(playerid, COLOR_GREY, string);
  		return 1;
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
function Call_hiddenadmin(playerid, race_check)
{
	new rows;
	cache_get_row_count(rows);
	if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);
	if(rows)
    {
		new adm;
		cache_get_value_name_int(0, "Soska", adm);
		if(adm < 10) PlayerInfo[playerid][pHidden] = 0, SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Скрытая ADM отключена");
	}
	else PlayerInfo[playerid][pHidden] = 0, SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Скрытая ADM отключена");
	return 1;
}
function Call_hidden(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
    {
		new datad[3], names[21], datad23[64];
		cache_get_value_name_int(0, "user_id", DP[3][playerid]);
	 	cache_get_value_name(0, "Name", names, 21);
		if (!GetPVarString(playerid, "Keyhidden", datad23, 64))
		{
			cache_get_value_name(0, "Keyhidden", datad23, 64);
		}
		else DeletePVar(playerid, "Keyhidden");
	 	cache_get_value_name_int(0, "Level", datad[0]);
	 	cache_get_value_name_int(0, "Exp", datad[1]);
	 	cache_get_value_name_int(0, "ConnectTime", datad[2]);
	 	new str[100],sctring[400];
       	format(str,sizeof(str),"{ff9000}%s \t ", names), strcat(sctring,str);
		format(str,sizeof(str),"\n{99ff66}%s \t ", datad23), strcat(sctring,str);
    	format(str,sizeof(str),"\n{cccccc}Уровень: \t%d", datad[0]), strcat(sctring,str);
    	format(str,sizeof(str),"\n{cccccc}Опыт: \t%d", datad[1]), strcat(sctring,str);
    	format(str,sizeof(str),"\n{cccccc}Часы в Игре: \t%d", datad[2]), strcat(sctring,str);
    	format(str,sizeof(str),"\n{ff6347}Удалить Аккаунт \t "), strcat(sctring,str);
    	ShowDialog(playerid,1122,DIALOG_STYLE_TABLIST,"{ff9000}Скрытый Аккаунт",sctring,"Выбрать","Отмена");
	}
	else ShowDialog(playerid,1121,DIALOG_STYLE_LIST,"{ff9000}Скрытый Аккаунт","{99ff66}Создать Аккаунт\n","Выбрать","Отмена");
	return 1;
}
CMD:hidden(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	new string[160];
	mysql_format(pearsq, string, sizeof(string),"SELECT user_id, Name, Keyhidden, Level, Exp, ConnectTime \
		FROM `pp_igroki` WHERE `Ammo5` = '%d'", PlayerInfo[playerid][pID]);
 	mysql_tquery(pearsq, string, "Call_hidden", "d", playerid);
	return 1;
}
CMD:setfam(playerid, const params[])
{
    new fam,playa,string[144],tmp[24];
    if(PlayerInfo[playerid][pSoska] >= 19)
    {
      if(!sscanf(params, "s[24]i",tmp,fam))
	  {
	     playa = ReturnUser(tmp, 1);
	     if(IsOnline(playa))
         {
	          PlayerInfo[playa][pFamily]=fam;
			  if(playa == playerid) PlayerInfo[playa][pFamrank] = FamilyInfo[fam][fRanks];
			  else PlayerInfo[playa][pFamrank] = 1;
	          format(string, sizeof(string), "{FFFFFF}Игроку %s установлен номер семьи {0088ff}%d", PlayerInfo[playa][pName],fam);
              SendClientMessage(playerid, COLOR_GREY, string);
              format(string, sizeof(string), "{FFFFFF}Администрация установила вам номер семьи %d",fam);
              SendClientMessage(playa, COLOR_GREY, string);
              AdminLog("setfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], fam, "");
         }
         else
         {
	          if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	          mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
              mysql_tquery(pearsq, string, "Call_setfam", "dsd", playerid, tmp, fam);
              return 1;
         }
      }
      else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить номер семьи игроку [ /setfam ID Номер ]");
    }
	return 1;
}
forward Call_agiverankfam(playerid, str_name[],fam);
public Call_agiverankfam(playerid, str_name[],fam)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
    {
		new datadid,datadfr,string[144],f_str[256];
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Famrank", datadfr);
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Famrank` = '%d' WHERE `Name` = '%e'",fam,str_name);
		query_empty(pearsq, f_str);
		format(string, sizeof(string), "{FFFFFF}Игроку %s установлен семьи ранг {0088ff}%d {ff0000}Offline",str_name,fam);
		SendClientMessage(playerid, COLOR_GREY, string);
	 	AdminLog("agiverankfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", fam, "Семейный Ранг");
	 	format(string, sizeof(string), "Ваш семейный ранг изменён с %d на %d", datadfr ,fam);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
		return 1;
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
alias:agiverankfam("agrf")
CMD:agiverankfam(playerid, const params[])
{
    new fam,playa,string[160],tmp[24];
    if(PlayerInfo[playerid][pSoska] >= 20)
    {
      if(!sscanf(params, "s[24]i",tmp,fam))
	  {
	     playa = ReturnUser(tmp, 1);
	     if(IsOnline(playa)) // Если игрок Online
         {
	       if(PlayerInfo[playa][pFamily]==0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У игрока нет семьи");
	       PlayerInfo[playa][pFamrank]=fam;
	       format(string, sizeof(string), "{FFFFFF}Игроку %s установлен семейный ранг {0088ff}%d", PlayerInfo[playa][pName],fam);
           SendClientMessage(playerid, COLOR_GREY, string);
           format(string, sizeof(string), "{FFFFFF}Администрация установила вам семейный ранг %d",fam);
           SendClientMessage(playa, COLOR_GREY, string);
           AdminLog("agiverankfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], fam, "");
         }
         else
         {
	          if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
	          mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Famrank FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
              mysql_tquery(pearsq, string, "Call_agiverankfam", "dsd", playerid, tmp, fam);
              return 1;
         }
      }
	  else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить семейный ранг [ /agiverankfam ID ранг ]");
    }
	return 1;
}
