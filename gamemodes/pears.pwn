}
stock SetPosAfterSpawnHotel(playerid)
{
	if(PlayerInfo[playerid][pKomnata] != 9999 && PlayerInfo[playerid][pKomnata] >= 1) // Снимает номер в отеле
	{
		keep(playerid);
		S_SetPlayerVirtualWorld(playerid,playerid+1,0), PPSetPlayerInterior(playerid,0);
		if(PlayerInfo[playerid][pKomnataCity] <= 1) 
		{
			PPSetPlayerPos(playerid, 1659.3291,-2273.7668,30.3279), PPSetPlayerFacingAngle(playerid, 180.0);
			WhiteFindPlayerPos(playerid,1636.1555,-2283.3462,13.5482);
		}
		else
		{
			PPSetPlayerPos(playerid, 1759.1321,1381.7913,28.0187), PPSetPlayerFacingAngle(playerid, 132.5543);
			WhiteFindPlayerPos(playerid,1751.3861,1399.7717,10.8791);
		}

		if(NoCompleteQuest(playerid, 2)) ShowQwest(playerid, 2);
	}
	else // не снимает номер в отеле
	{
		S_SetPlayerVirtualWorld(playerid,0,0), PPSetPlayerInterior(playerid,0);
		TogglePlayerControllable(playerid, true);
		if(PlayerInfo[playerid][pKomnataCity] <= 1) // Los Santos
		{
			switch(Protect_Spawn[playerid])
			{
				case 0: PPSetPlayerPos(playerid, 1604.0627,-2276.5786,13.5228), PPSetPlayerFacingAngle(playerid, 182.1165);
				case 1: PPSetPlayerPos(playerid, 1600.1864,-2276.7048,13.5256), PPSetPlayerFacingAngle(playerid, 179.9231);
				case 2: PPSetPlayerPos(playerid, 1595.5018,-2276.1111,13.5291), PPSetPlayerFacingAngle(playerid, 182.7432);
				case 3: PPSetPlayerPos(playerid, 1598.8920,-2299.5447,13.5430), PPSetPlayerFacingAngle(playerid, 0.7182);
				default: PPSetPlayerPos(playerid, 1621.7104,-2297.5889,13.5402), PPSetPlayerFacingAngle(playerid, 70.5923);
			}
		}
		else // Las Venturas
		{
			switch(Protect_Spawn[playerid])
			{
				case 0: PPSetPlayerPos(playerid, 1724.6954,1419.8087,10.8467), PPSetPlayerFacingAngle(playerid, 285.4941);
				case 1: PPSetPlayerPos(playerid, 1730.2910,1407.5309,10.8467), PPSetPlayerFacingAngle(playerid, 346.5947);
				case 2: PPSetPlayerPos(playerid, 1749.1842,1421.8966,10.8767), PPSetPlayerFacingAngle(playerid, 66.4954);
				case 3: PPSetPlayerPos(playerid, 1754.4534,1427.4142,10.8767), PPSetPlayerFacingAngle(playerid, 79.9688);
				default: PPSetPlayerPos(playerid, 1753.0085,1436.7079,10.8767), PPSetPlayerFacingAngle(playerid, 106.2891);
			}
		}
		ACSetPlayerHealth(playerid, 50.0), SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нужно снять номер в отеле {FF6347}[ Спавн на улице -50 HP ]");
		ApplyAnimation(playerid,"SUNBATHE","ParkSit_M_out",4.0, false, false, false, false, false);
	}
	return 1;
}

stock ResetInCar(playerid)
{
	new v = Protect_Veh[playerid];
	if(VehInfo[v][vEngine] == 0) HideVehiclePopup(playerid);
	if(VehInfo[v][vTimerSpawn] >= 0) VehInfo[v][vTimerSpawn] = 20; // Сбрасываем таймер автоспавна
	VehInfo[v][vSeat] = 0;
	Protect_Veh[playerid] = 9999;
	return 1;
}

function PlayerDeathSystems(playerid)
{
	if(debugDeath) SendClientMessage(playerid, COLOR_GREY,"{ff0000}[debug] PlayerDeathSystems %s", PlayerInfo[playerid][pName]);

	// Выключаем участие в игре зомби
	ExitPlayerZombie(playerid, true);

	// Отключаем подсказку текстдравом
	TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);

	Raceonn[playerid] = 0, Raceon[playerid] = 0, Stopeee2[playerid] = 0, Stopeee[playerid] = 0, Stopee[playerid] = 0, PPP15[playerid] = 0; // Обнуляем Переменные
	DisablePlayerCheckpoint(playerid); // Отключаем Checkpoint

	for(new a = 0; a < 4; a++) RemovePlayerAttachedObject(playerid, a); // Снимаем все нацепленные предметы до 4 слота (5 - 9 аксессуары)

	// Отключаем Сделку
	if(PlayerInfo[playerid][pTstat] >= 1) CloseTrade(playerid);

	// Сбрасываем Супермаркет
	if(GetPVarInt(playerid,"svzyal") >= 1) Svalilizsm(playerid);

	// Отключаем Камеры Слежения
	if(OverHear[playerid] >= 1)
	{
		if(OverHear[playerid] <= 999) DestroyPlayerObject(playerid, CamObjectPlayer[playerid]);
		OverHear[playerid] = 0;
		TextDrawHideForPlayer(playerid, TvCam[0]), TextDrawHideForPlayer(playerid, TvCam[1]), TextDrawHideForPlayer(playerid, TvCam[2]), TextDrawHideForPlayer(playerid, TvCam[3]);
	}

	// Отменяем инкассацию денег
	if(GetPVarInt(playerid,"job_collector") >= 1) CloseCollectorToBiz(playerid);

	// Освобождаем койку в госпитале
	if(HospBed[playerid] != 9999) ClearBedMed(playerid);

	// Завершаем Намаз
	if(Namaz[playerid] >= 0) CloseNamaz(playerid);

	// Отменяем церемонию бракосочетания
	if(MarriageOffer[playerid] > 0) exit_propose(playerid);

	// Закрываем Инвентарь
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);

	// Закрываем смартфон
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);

	// Закрываем Карту Автобусов
	if(OnlineInfo[playerid][oShowInterface] == 10) CloseMapBus(playerid);

	// Отключаем Водителя Автобуса
	if(driverid[playerid] > 0) ExitBusDriver(playerid);

	// Сбрасываем Занятость Авто
	if(Protect_Veh[playerid] != 9999) ResetInCar(playerid);

	// Отключаем работу Мусоровоза
	if(TrashBakHand[playerid] > 0) reset_trash(playerid, TrashBakHand[playerid] - 1, 0);

	// Отключаем метку в GPS
	if(GpsStat[playerid] > 0) DestroyGps(playerid);
	
	// Закрываем лавку
	if(Goods[playerid] > 0) stopshop(playerid);

	// Отменяем Доставку Товара
	if(GetPVarInt(playerid,"delivery_biz") >= 1)
	{
		new b = GetPVarInt(playerid,"delivery_biz");
		BizzInfo[b][bDeliveryOrder] = -1;
		SetPVarInt(playerid,"delivery_biz",0);
	}

	// Вырубаем карту моряка
	if(Dei[playerid] == 3) Close_Seamap(playerid);
	if(Dei[playerid] == 203) Close_Huntmap(playerid);

	// Вырубаем SkyDive
	if(SkyStat[playerid] > 0) stopsky(playerid);

	// Вырубаем спусп по верёвке
	if(RopeQuan[playerid] >= 2) ropedown(playerid, RopeVeh[playerid], RopeID[playerid], 0);

	// Вырубаем вести за собой игрока
	StopFollow(playerid);

	// Выключаем ноутбук
	if(Komputer[playerid] == 2) exitkomp(playerid, 1);

	// Отключаем Стул
	if(SitPlayer[playerid] >= 1 || playerSeat[playerid]) exitsit(playerid, 0);

	// Вырубаем интерактив
	if(Moiplayer[playerid] != 9999) close_interaction(playerid);

	// Вырубаем Казино
	if(GetPVarInt(playerid,"kas") == 5 || GetPVarInt(playerid,"kas") == 6) ExitKasino3(playerid);

	// Вырубаем зону помощи
	if(Heal[playerid] == 7777) DestroyDynamic3DTextLabel(TradeLabel[playerid]), Heal[playerid] = 9999;

	// Вырубаем Секс
	if(Sex[playerid] >= 1 && Sex[playerid] <= 4) StopSex(playerid, 0);
	if(OnlineInfo[playerid][oSexBot] > 0) StopSexWhore(playerid);

	// Роняем Ящик
	if(OnlineInfo[playerid][oInHandThing][0] > 0 
		&& (OnlineInfo[playerid][oInHandThing][5] == 2 || OnlineInfo[playerid][oInHandThing][5] == 4)) Throw(playerid, OnlineInfo[playerid][oInHandThing][0], OnlineInfo[playerid][oInHandThing][1], OnlineInfo[playerid][oInHandThing][2], OnlineInfo[playerid][oInHandThing][3], OnlineInfo[playerid][oInHandThing][4], OnlineInfo[playerid][oInHandThing][5]);

	// Покидаем Пост
	if(Guard[playerid] >= 1) ExitGuard(playerid);

	// Арест во время зачистки
	if(Yaderstat == 3 && IsPlayerInRangeOfPoint(playerid,150.0,PizdaX,PizdaY,PizdaZ)) ArestPlayer(playerid, -1, AREST_TYPE_RAID);

	// Отмена редактирования объекта
	CloseEditObject(playerid);

	// Бросаем Трубку
	if(GetPVarInt(playerid, "Mobile") != 9999 && GetPVarInt(playerid,"MobileStat") >= 1) hangup(playerid, 1);

	// Удаляем личного маньяка для игрока
    if(PlayerManiac[playerid] != -1) DestroyManiac(PlayerManiac[playerid]), PlayerManiac[playerid] = -1;

	// Выключаем дуэль на катанах
	if(KatanaBot[playerid] != INVALID_NPC) DestroyKatanaDuel(playerid);
	return 1;
}

CMD:explo(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 19) return ErrorMessage(playerid, "Вы не можете использовать эту команду");
	new Float:posic[3];
	GetPlayerPos(playerid, posic[0], posic[1], posic[2]);
	CreateExplosion(posic[0], posic[1], posic[2], 7, 300.0);
	return true;
}

CMD:debugdeath(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 19) return ErrorMessage(playerid, "Вы не можете использовать эту команду");
	if(debugDeath) 
	{
		debugDeath = false;
		SendClientMessage(playerid, COLOR_GREY,"{ff0000}[debug] debugDeath Off");
	}
	else 
	{
		debugDeath = true;
		SendClientMessage(playerid, COLOR_GREY,"{ff0000}[debug] debugDeath {99ff66}On");
	}
	return true;
}

public OnPlayerDeath(playerid, killerid, WEAPON: reason)
{
	if(IsPlayerNPC(playerid)) return true;

	printf("[OnPlayerDeath]: %s[%d]", PlayerInfo[playerid][pName], playerid);

	// Офаем разговор в voice
	#if defined SAMPVOICE_COMPILE_3
    SampvoiceStopTalking(playerid);
    #endif

	// Сбрасываем переменную выдачи оружия после спавна
	GiveWeaponAfterSpawn[playerid] = 0;

	// Блокируем смерть в Test Drive
	if(VehShopInfo[playerid][vsTest])
	{
		PPSetSpawnInfo(playerid);
		return 0;
	}
	
	if(computerClubPlayerInfo[playerid][ccpiInGame] == true) return ComputerClubOnPlayerDeath(playerid, killerid);
	if(MineWar_IsPlayerInGame(playerid)) return MineWar_OnPlayerDeath(playerid);
	if(Tomb_IsPlayerInGame(playerid)) return Tomb_OnPlayerDeath(playerid);

	if(OnlineInfo[playerid][oLogged] == 1)
	{
		if(debugDeath) SendClientMessage(playerid, COLOR_GREY,"{ff0000}[debug] OnPlayerDeath %s", PlayerInfo[playerid][pName]);

		HidePlayerDialog(playerid);

		if(PlayerDeath[playerid] == 0) PlayerPersonalDeath(playerid, killerid, reason);

		// Записываем смерть
		if(!SetPlayerDeath(playerid, reason)) // запускаем процесс отключения систем, только если игрок по какой то причине не упал в стадию
		{
			// Отключаем процесс разных систем после смерти
			PlayerDeathSystems(playerid);
		}
	}
	
	// Отнимаем всё оружие в руках (вузально) после спавна оно вернётся
	Protect_DeathTakeWeapon(playerid);

	SetPlayerColor(playerid,COLOR_GRAD2);
	PPSetSpawnInfo(playerid);
	return 1;
}

public OnPlayerSpawn(playerid)
{
	printf("[OnPlayerSpawn]: %s[%d]", PlayerInfo[playerid][pName], playerid);

	if(debugDeath) SendClientMessage(playerid, COLOR_GREY,"{CD0E0E}[debug] OnPlayerSpawn %s", PlayerInfo[playerid][pName]);

	PlayerDeath[playerid] = 0;
	DeathInfo[playerid][deathKiller] = INVALID_PLAYER_ID;
	SetPlayerTeam(playerid, DEFAULT_PLAYER_TEAM);

	// Защита от игнора спавна
	OnlineInfo[playerid][oSpawnDo] = false;
	OnlineInfo[playerid][oSpawnUnix] = 0;

	// Если игрок NPC
	if(IsPlayerNPC(playerid)) return OnNpcSpawn(playerid);

	// Забираем оружие у ганварнутых
	GunWarnTakeWeapon(playerid, true);

	// Спавн в комп клубе
	if(computerClubPlayerInfo[playerid][ccpiInGame] == true) return ComputerClubOnPlayerSpawn(playerid);

	// Возвращаем из Test Drive
	if(VehShopInfo[playerid][vsTest])
	{
		WeReturnToPosition(playerid);
		closeTestDrive(playerid); // Завершаем Test Drive в Автосалоне
		return 1;
	}

	// AntiFlood Spawn
	pSpawn[playerid] ++;
	if(pSpawn[playerid] >= 10) 
	{
		printf("[SProtect Kick]: Flood Spawn %s",PlayerInfo[playerid][pName]);
		SendClientMessage(playerid, COLOR_GREY,"{ff0000}Античит: {FF6347}Вы были кикнуты по причине: Flood Spawn");
		ErrorMessage(playerid, "{ff0000}Античит\n\n{FF6347}Вы были кикнуты по причине: Flood Spawn");
		Kickx(playerid);
		return 1;
	}

	if(DeathInfo[playerid][deathStatus] == true) ACSetPlayerHealth(playerid, 90.0); // Если игрок дохлый, ставим ему 90 хп
	else SetPlayerHealthInHospital(playerid);

	if(gZaregal[playerid] >= 1) return 1;
	Enterveh[playerid] = 9999;
	MedHeal[playerid] = 0;
	Hand[playerid] = 0, SetPVarInt(playerid,"GP",0);
	if(OverHear[playerid] >= 1) return exitcam(playerid);
	PursuitArest[playerid] = 300, WatchSpeed[playerid] = 0;//, Zone[playerid] = -1;
	SetPVarInt(playerid, "kmesto", 0);SetPVarInt(playerid, "kstol", 0);AntiC[playerid] = 0;AntiC2[playerid] = 0, Sdelka[playerid] = 0, HP_Tick[playerid] = 0, HA_Tick[playerid] = 0, CBug[playerid] = 0;
	Stopeee228[playerid] = 0; Follow[playerid] = 9999; FollowTime[playerid] = 0;
	SetPVarInt(playerid,"LoadBack",0);
	incold[playerid] = 0;
	AntiBenz[playerid] = 0; Protect_Veh[playerid] = 9999;
	NoAnim[playerid] = 0;ADMS[playerid] = 0; Tank[playerid] = 0; Dismiss[playerid] = 0; SetPVarInt(playerid, "kas", 0); Payment[playerid] = 0; PayCash[playerid] = 0;
	SetPVarInt(playerid, "SelectCharPlace",0); gTimeDeath[playerid] = 0;
	Taxi[playerid] = 0, healcar[playerid] = 9999, Riches[playerid] = 0;
	if(Komputer[playerid] > 0) Komputer[playerid] = 0;
	SetPVarInt(playerid, "qwesttime", 0);SetPVarInt(playerid, "qweststat", 0);
	if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;
	if(AeroTimer[playerid]) KillTimer(AeroTimer[playerid]), AeroTimer[playerid] = 0;
	if(Piss[playerid] == 6) Piss[playerid] = 0; PissTime[playerid] = 0;
	Stun[0][playerid] = 0, Stun[1][playerid] = 0, Stun[2][playerid] = 0, Stun[3][playerid] = 0, Stun[4][playerid] = 0, Stun[5][playerid] = 0;
	StunTime[0][playerid] = 0, StunTime[1][playerid] = 0, StunTime[2][playerid] = 0, StunTime[3][playerid] = 0, StunTime[4][playerid] = 0, StunTime[5][playerid] = 0;
	RopeQuan[playerid] = 0, UsePlot[playerid] = 0, ProtectSpeedSeat[playerid] = 0;
	Dei[playerid] = 0, DeiStat[playerid] = 0;
	TextDrawHideForPlayer(playerid, MindDraw[0]);
	TextDrawHideForPlayer(playerid, MindDraw[1]);
	TextDrawHideForPlayer(playerid, MindDraw[2]);
	PlayerTextDrawHide(playerid, MindDraw1), PlayerTextDrawHide(playerid, MindDraw2);

	if(OnlineInfo[playerid][oLogged] == 1)
	{
		S_SetPlayerVirtualWorld(playerid, playerid+1, playerid+1);
		PPSetPlayerInterior(playerid, playerid+1);

		// Отмена редактирования объекта
		CloseEditObject(playerid);

		// Вырубаем 3DMenu
		if(MenuInfo[playerid][zStat] == 1) Destroy3DMenu(playerid);

		// Убираем текстурируемый объект
		if(Texture[playerid] == 1) RemoveObjectToTexture(playerid);

		if(Moiplayer[playerid] != 9999) close_interaction(playerid);
		if(Heal[playerid] == 7777) DestroyDynamic3DTextLabel(TradeLabel[playerid]);
		Heal[playerid] = 9999;

		if(PlayerInfo[playerid][pInfoload] <= 50) SetPlayerAttachedObject(playerid,0,18698,1,0.388000,0.000000,-1.475000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000); // Мухи
		// SetPlayerAttachedObject(playerid, 0, 18748, 1, -1.985000, -0.176000, -0.236000, 0.000000, 85.100021, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0); зелёный дым

		CnnVed[playerid] = 0;SetPVarInt(playerid, "AnimSet", 0);

		// Выдаём оружие через 4 секунды после спавна
		GiveWeaponAfterSpawn[playerid] = 4;

		if(GetPVarInt(playerid,"Roll") >= 1)SetPVarInt(playerid, "Roll", 1);
		
		// Вытаскиваем игрока из багажника, если он в нем был
		new boot_vehicleid = GetPVarInt(playerid, "Boot");
		if(boot_vehicleid > 0)
		{
			if(IsValidVehicle(boot_vehicleid))
			{
				if(VehInfo[boot_vehicleid][vPeople] > 0 && VehInfo[boot_vehicleid][vPeople] - 1 == playerid) {
					EjectBoot(playerid, boot_vehicleid);
				}
			}
			DeletePVar(playerid, "Boot");
		}

		// Выходим из спортзала
		if(GetPVarInt(playerid,"tips") > 0) CloseSport(playerid);

		// Если броня была, возвращаем
		if(PlayerInfo[playerid][pArmor] >= 1) ACSetPlayerArmour(playerid, PlayerInfo[playerid][pArmor]);

		if(SetPosa[playerid] > 0 && DeathInfo[playerid][deathStatus] == false)
		{
			PPSetPlayerPos(playerid, SpX[playerid], SpY[playerid], SpZ[playerid]);
			PPSetPlayerFacingAngle(playerid, SpA[playerid]);
			S_SetPlayerVirtualWorld(playerid, SpWorld[playerid], SpInt[playerid]);
			PPSetPlayerInterior(playerid, SpInt[playerid]);
			keep(playerid);
			SetCameraBehindPlayer(playerid);
			SetPlayerToTeamColor(playerid);
			if(SetPosa[playerid] == 2) 
			{
				playerSeat[playerid] = true;
				sit_Active(playerid, SpX[playerid], SpY[playerid], SpZ[playerid], SpA[playerid]);
				OnlineInfo[playerid][oKeepSit] = 1;
			}
			// SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);
			if(PlayerInfo[playerid][pOdet][0] > 0) Odet(playerid, 5);
			if(PlayerInfo[playerid][pOdet][1] > 0) Odet(playerid, 6);
			if(PlayerInfo[playerid][pOdet][2] > 0) Odet(playerid, 7);
			if(PlayerInfo[playerid][pOdet][3] > 0) Odet(playerid, 8);
			if(PlayerInfo[playerid][pOdet][4] > 0) Odet(playerid, 9);
			TempGive(playerid);
			if(gSkafandr[playerid] == 2) odetskafandr(playerid, 1, 1);
			else if(gSkafandr[playerid] == 1) odetskafandr(playerid, 1, 0);
			SetPosa[playerid] = 0;

			Wupak(playerid);
			AdminAks(playerid);
			return 1;
		}
		// Выходим из редактора
		if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) exit_textdraw(playerid, 0);

		// Снимаем Скафандр
		if(gSkafandr[playerid] > 0)
		{
			gSkafandr[playerid] = 0, gOxygen[playerid] = 0;
			if(PlayerInfo[playerid][pDrawVisible][10] == false && setting_pos_draw[playerid] != 11 && setting_size_draw[playerid] != 11 && DrawOxygen[playerid] == true)
			{
				PlayerTextDrawHide(playerid, OxygenDraw[0][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[1][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[2][playerid]);
				PlayerTextDrawDestroy(playerid, OxygenDraw[0][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[1][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[2][playerid]);
				DrawOxygen[playerid] = false;
			}
		}

		// Отключаем Водителя Автобуса
		if(driverid[playerid] > 0) ExitBusDriver(playerid);

		// Отменяем церемонию бракосочетания
		if(MarriageOffer[playerid] > 0) exit_propose(playerid);

		// Прописываем отключение разных систем
		PlayerDeathSystems(playerid);

		SelectMenu[playerid][Shop] = 0;
		DicePlayer[playerid] = 0, DicePrice[playerid] = 0;
		SetPVarInt(playerid,"job_stat",0), bus[playerid] = 0, busstation[playerid] = 0, busrout[playerid] = -1;
		if(Nolet[playerid] == 1) DestroyPlayerObject(playerid, NoletObj[playerid]), Nolet[playerid] = 0;
		SetPVarInt(playerid,"Stakandroch",0), SetPVarInt(playerid,"PlayBoy",0), SetPVarInt(playerid,"Infect",0);
		boxid[playerid]=9999;SetPVarInt(playerid, "Fotik",0);Qwerty[4][playerid] = 0;
		TogglePlayerControllable(playerid, false);SetPVarInt(playerid, "getgun", 0);
		//if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid);
		PearsWeather(playerid);
		PearsTime(playerid);
		gFormavvs[playerid] = 0;NoAnim[playerid] = 0; gShlem[playerid] = 0;
		SetPVarInt(playerid,"taks",0);EatTime[playerid] = 0; Eat[playerid] = 0;
		Piss[playerid] = 0; PissTime[playerid] = 0; Sleep[playerid] = 0; SleepTime[playerid] = 0;SleepRP[playerid] = 0;
		DisablePlayerCheckpoint(playerid), SetPVarInt(playerid,"gantel",0), SetPVarInt(playerid,"ganteltime",0), SetPVarInt(playerid,"sport",0);
		SetPVarInt(playerid,"Arobsklad",0);
		SetPVarInt(playerid,"komp",-1);SetPVarInt(playerid,"komp2",-1);
		SetPVarInt(playerid,"Poyas", 0);
		Lesson[playerid] = 0, Exam[playerid] = 0;
		SetPVarInt(playerid, "oryjlave",0);
		SetPVarInt(playerid,"Laveska",0); SetPVarInt(playerid,"svzyal",0);
		SetPVarInt(playerid,"tunone",0);SetPVarInt(playerid,"tuntwo",0);SetPVarInt(playerid,"tunstat",0);
		PPP15[playerid] = 0; SetPVarInt(playerid,"tir",0);
		zaprcar[playerid] = 9999; zaprkol[playerid] = 0;
		SetPlayerDrunkLevel(playerid, 0);CuffedId[playerid] = 9999; gYda[playerid]=0;
		OnlineInfo[playerid][oShowInterface] = 0;
		TalkingLive[playerid] = 9999;
		CancelSelectTextDraw(playerid);
		SetCameraBehindPlayer(playerid);
		PlayerInfo[playerid][pRanentors] = 0; Hold[playerid] = 0;
		//SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);
		PlayerFixRadio(playerid);
		SetPlayerSpecialAction(playerid,SPECIAL_ACTION_NONE);
		DisablePlayerRaceCheckpoint(playerid);
		TextDrawHideForPlayer(playerid, Chernifon);
		TextDrawHideForPlayer(playerid,PearsDraw[0]);
		TextDrawHideForPlayer(playerid,PearsDraw[1]);
		CancelSelectTextDraw(playerid);

		if(animloading[playerid] == false) PreloadAllAnimLibs(playerid);
		switch (PlayerInfo[playerid][pStyle])
		{
				case 0: SetPlayerFightingStyle(playerid,FIGHT_STYLE_NORMAL);
				case 1: SetPlayerFightingStyle(playerid,FIGHT_STYLE_KNEEHEAD);
				case 2: SetPlayerFightingStyle(playerid,FIGHT_STYLE_KUNGFU);
				case 3: SetPlayerFightingStyle(playerid,FIGHT_STYLE_BOXING);
				case 4: SetPlayerFightingStyle(playerid,FIGHT_STYLE_GRABKICK);
				default:  SetPlayerFightingStyle(playerid,FIGHT_STYLE_NORMAL);
		}
		SetPlayerToTeamColor(playerid);
		YjeSdoh[playerid] = 0;
		if(PlayerInfo[playerid][pOdet][0] > 0) Odet(playerid, 5);
		if(PlayerInfo[playerid][pOdet][1] > 0) Odet(playerid, 6);
		if(PlayerInfo[playerid][pOdet][2] > 0) Odet(playerid, 7);
		if(PlayerInfo[playerid][pOdet][3] > 0) Odet(playerid, 8);
		if(PlayerInfo[playerid][pOdet][4] > 0) Odet(playerid, 9);
		if(PlayerInfo[playerid][pInfoload] <= 50) SetPlayerAttachedObject(playerid,0,18698,1,0.388000,0.000000,-1.475000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);

		// Прописываем навыки
		SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL, 0);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL_SILENCED, 0);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_DESERT_EAGLE, 999);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_SHOTGUN, 999);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_SAWNOFF_SHOTGUN, 0);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_SPAS12_SHOTGUN, 0);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_MICRO_UZI, 0);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_MP5, 999);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_AK47, 999);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, 999);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_SNIPERRIFLE, 999);
		//if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid);
		SetCameraBehindPlayer(playerid);
		PlayerFixRadio(playerid);
		ASK[playerid] = 10;

		// Ставим скин
		//m_custom_sync_SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);

		// Death Player
		if(DeathInfo[playerid][deathStatus])
		{ 
			WeReturnToDeathPosition(playerid);
			ShowInterfaceDeath(playerid);
			UpdateDeathDrawProcess(playerid);
		} 
		else if (GetPVarInt(playerid, "MineWarSpawn")) // Спавн после завершения игры в заброшенной шахте
		{
			DeletePVar(playerid, "MineWarSpawn");
			MineWar_GetOutPlayer(playerid);
		}
		else if(GetPVarInt(playerid, "TombSpawn")) // Спавн после завершения игры в гробнице фараона
		{
			DeletePVar(playerid, "TombSpawn");
			Tomb_GetOutPlayer(playerid);
		}
		else SetPlayerSpawn(playerid); // Обычный, нормальный спавн

		// Меняем последнюю точку (чтобы в последствии мы спавнились в нормальном месте)
		if(PlayerInfo[playerid][pSelectspawn] == 1) PlayerInfo[playerid][pSelectspawn] = PlayerInfo[playerid][pSpawnchange];

		Wupak(playerid);
		AdminAks(playerid);
	}
	else
	{
	    SelectTextDraw(playerid,0x666666AA);
	    
		PPTogglePlayerSpectating(playerid, true);
		S_SetPlayerVirtualWorld(playerid, playerid+1, 0);
		ACSetPlayerHealth(playerid,90);
		
		// Полёт камеры в нужну позицию
		new tmphour,tmpminute,tmpsecond;
		gettime(tmphour, tmpminute, tmpsecond);
		if(tmphour >= 22 || tmphour >= 0 && tmphour <= 5)
		{
			switch(random(2))
			{
				case 0:
				{
					InterpolateCameraPos(playerid, 680.828002, -633.350097, 16.866300, 680.310913, -679.162658, 16.304922, 20000);
					InterpolateCameraLookAt(playerid, 681.447082, -638.310485, 16.971761, 681.357360, -684.032714, 16.737972, 18000);
				}
				case 1:
				{
					InterpolateCameraPos(playerid, 2315.062011, -1668.343994, 14.854090, 2263.433593, -1661.635620, 16.738149, 20000);
					InterpolateCameraLookAt(playerid, 2310.092773, -1667.796508, 14.768157, 2259.774902, -1658.230224, 16.870946, 18000);
				}
			}
		}
		else
		{
			InterpolateCameraPos(playerid, 527.640136, -1819.301513, 15.123130, 565.083679, -1802.416870, 6.692841, 15000);
			InterpolateCameraLookAt(playerid, 527.550537, -1824.271240, 15.665032, 563.858337, -1807.261718, 6.852970, 12000);
		}

		//InterpolateCameraPos(playerid, 1092.789306, -2043.082763, 90.107772, 564.572692, -1804.235595, 6.305634, 3000);
		//InterpolateCameraLookAt(playerid, 1088.708129, -2040.220581, 89.717864, 564.680175, -1809.234375, 6.325490, 3000);
	}
	return 1;
}
forward Call_rentdom(playerid, dom);
public Call_rentdom(playerid, dom)
{
	new rows, str[80], sctring[1300], kolvo = 0;
	PlayerPlaySound(playerid,40405,0,0,0);
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24],giveplayerid,datad5;
		cache_get_value_name(i, "Name", datad2, 24);
		cache_get_value_name_int(i, "Online", datad5);
		if(datad5 == 1)
		{
			giveplayerid = ReturnUser(datad2);
			if(IsOnline(giveplayerid))
			{
				if(OnlineInfo[giveplayerid][oLogged] == 1)
 				{
					format(str,sizeof(str),"{99ff66}[Online] {cccccc}%s[%d]\n",PlayerInfo[giveplayerid][pName],giveplayerid), strcat(sctring,str);
					cache_get_value_name_int(i, "user_id", List[i][playerid]);
				}
			}
		}
		if(datad5 == 0)
		{
			format(str,sizeof(str),"{FF6347}[Offline] {ffffff}%s\n",datad2);
			strcat(sctring,str);
			cache_get_value_name_int(i, "user_id", List[i][playerid]);
		}
		kolvo ++;
	}
	DomInfo[dom][dLodger] = kolvo;
	if(kolvo == 0) ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{cccccc}По запросу ничего не найдено","Ок","");
	if(kolvo >= 1) ShowDialog(playerid,565,DIALOG_STYLE_TABLIST,"{ff9000}Дом",sctring,"Выселить","Отмена");
	return 1;
}
forward Call_dj(playerid);
public Call_dj(playerid)
{
	new rows, str[120], sctring[1500],ofl,onl,qwer[44];
	PlayerPlaySound(playerid,40405,0,0,0);
	new year, month,day;
	getdate(year, month, day);
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24],giveplayerid,datad5, DJ;
		cache_get_value_name(i, "Name", datad2, 24);
		cache_get_value_name_int(i, "Online", datad5);
		cache_get_value_name_int(i, "Djpears", DJ);
		if(datad5 == 1)
		{
			giveplayerid = ReturnUser(datad2);
			if(IsOnline(giveplayerid))
			{
				format(str,sizeof(str),"{99ff66}[Online]   {ff9000}[%d] {ffffff}%s[%d]\n",PlayerInfo[giveplayerid][pDjpears],PlayerInfo[giveplayerid][pName],giveplayerid);
				strcat(sctring,str);
				onl ++;
			}
		}
		if(datad5 == 0)
		{
			format(str,sizeof(str),"{FF6347}[Offline]   {ff9000}[%d] {ffffff}%s\n",DJ,datad2);
			strcat(sctring,str);
			ofl ++;
		}
	}
	format(str,sizeof(str),"\n{cccccc}     Online: %d     Offline: %d                                                            {000000}*",onl,ofl);
	strcat(sctring,str);
	format(qwer,sizeof(qwer),"{ff9000}Dj {FFFFFF}[%d.%d.%d]",day,month,year);
	ShowDialog(playerid,1700,DIALOG_STYLE_TABLIST,qwer,sctring,"Ок","");
	return true;
}
