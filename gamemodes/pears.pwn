CMD:flip(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 2 || PlayerInfo[playerid][pMedia] >= 1)
	{
   		if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,COLOR_GREY,"Ты не за рулём.");
		FlipVehicle(GetPlayerVehicleID(playerid));
        SendClientMessage(playerid,COLOR_RED,"{FFFFFF}  Авто {0088ff}перевёрнуто");
	}
	return 1;
}
CMD:flipcar(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Перевернуть транспорт [ /flipcar ID ]");
    if(params[0] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кхм.. нет такого транспорта");
	new Float:vePos[4];
	GetVehiclePos(params[0], vePos[0], vePos[1], vePos[2]);
	if(PlayerInfo[playerid][pSoska] <= 2)
	{
		if(!IsPlayerInRangeOfPoint(playerid,20.0,vePos[0], vePos[1], vePos[2])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я далеко от транспорта [ не больше 20 метров ]");
	}
	GetVehicleZAngle(params[0],vePos[3]);
	SetVehicleZAngle(params[0],vePos[3]);
	SendClientMessage(playerid,COLOR_RED,"{FFFFFF}  Транспорт {0088ff}перевёрнут");
	return 1;
}

CMD:agetboat(playerid, const params[])
{
	if(GetPVarInt(playerid,"antiflood") > 0) return SendClientMessage(playerid, COLOR_RED, "{0088ff}Использование команды: {FFFFFF}раз в 10 сек.");
	if(GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу арендовать транспорт в здании");
	if(Stun[4][playerid] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в наручниках");
	if(IsPlayerInRangeOfPoint(playerid,15.0,-1442.7094,501.3561,3.0414))
	{
		if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно выйти из транспорта..");
		if(PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pMember] == 3 && GetAccessRankOrgMay(playerid, PlayerInfo[playerid][pMember], 73, NO_FBI))
		{
			ShowDialog(playerid,755,2,"{336633}Национальная Гвардия", "Predator\nVortex","Выбрать","Выход");
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот транспорт доступен только ВМС");
	}
	return 1;
}
stock get_reloadrentveh(playerid, &Float:X, &Float:Y, &Float:Z, &Float:A, term, biz)
{
    new sl = DP[1][playerid];
	new item = PlayerInfo[playerid][pRentItem][sl], b = PlayerInfo[playerid][pRentBiz][sl];
	if(b > 0)
	{
		if(BizzInfo[b][bItem][item]-BizzInfo[b][bUseItem][item] <= 0) return ErrorMessage(playerid, "{FF6347}Этого транспорта нет в наличии\n{cccccc}[ Вы можете подождать, арендовать другой или отменить аренду ]");
	}
	if(term >= 0) getcreateterm(biz, term, X, Y, Z, A);
	else
	{
		if(b >= 53 && b <= 61) getcreaterent(b, X, Y, Z, A);
		else
		{
			if(PlayerInfo[playerid][pRent_X][sl] == 0.0 && PlayerInfo[playerid][pRent_Y][sl] == 0.0) getcreateterm(biz, term, X, Y, Z, A);
			else
			{
				X = PlayerInfo[playerid][pRent_X][sl];
				Y = PlayerInfo[playerid][pRent_Y][sl];
				Z = PlayerInfo[playerid][pRent_Z][sl];
				A = PlayerInfo[playerid][pRent_A][sl];
			}
		}
	}
	return 1;
}
stock find_reloadrentveh(playerid, term, biz)
{
	HidePlayerDialog(playerid);
	new Float:pos[4], mnogacar, Float:CPOS[3];
	get_reloadrentveh(playerid, pos[0], pos[1], pos[2], pos[3], term, biz);
	for(new v = 0; v < MAX_CARS; v++)
	{
	    if(VehInfo[v][vModel] > 0)
	    {
	        GetVehiclePos(v, CPOS[0], CPOS[1], CPOS[2]);
	        new Float:radius = GetDistanceBetweenPoints3D(CPOS[0], CPOS[1], CPOS[2], pos[0], pos[1], pos[2]);
			if(radius <= 4.0)
			{
				mnogacar ++;
			}
		}
	}
	if(mnogacar >= 2)
	{
	    CreateGps(playerid, pos[0], pos[1], pos[2], 0, 0, 10.0);
       	new str[100],sctring[400];
       	format(str,sizeof(str),"{FF6347}Внимание! Там где восстановится ваш транспорт, стоят {ff0000}%d {FF6347}других", mnogacar), strcat(sctring,str);
    	format(str,sizeof(str),"\n{FF6347}Есть вероятность, что он застрянет или повредится"), strcat(sctring,str);
        format(str,sizeof(str),"\n\n{cccccc}Рекомендуем отодвинуть чужие транспортные средства или попросить их отъехать"), strcat(sctring,str);
        format(str,sizeof(str),"\n{cccccc}Место где появится ваш транспорт - {0088ff}отмечено на карте"), strcat(sctring,str);
        format(str,sizeof(str),"\n\n{ff9000}Вы уверены, что хотите восстановить транспорт прямо сейчас?"), strcat(sctring,str);
    	ShowDialog(playerid,699,DIALOG_STYLE_MSGBOX,"{ff9000}Арендованный Транспорт",sctring,"Да","Нет");
	}
	else reloadrentveh(playerid, PlayerInfo[playerid][pRentItem][DP[1][playerid]], DP[1][playerid], PlayerInfo[playerid][pRentBiz][DP[1][playerid]], pos[0], pos[1], pos[2], pos[3]);
	return 1;
}
stock reloadrentveh(playerid, item, sl, b, Float:x, Float:y, Float:z, Float:a) // АРЕНДОЧКА
{
	new newcar, string[120];
	newcar = PP_CreateVehicle(PlayerInfo[playerid][pRentModel][sl],x,y,z,a,PlayerInfo[playerid][pRentCol][sl],1,600,0, -1, 0.0);
	if(b >= 53 && b <= 56)
	{
		if(planepos <= 4) planepos ++;
		else planepos = 0;
	}
	else if(b >= 57 && b <= 61)
	{
		if(katerpos <= 2) katerpos ++;
		else katerpos = 0;
	}
	VehInfo[newcar][vGas] = PlayerInfo[playerid][pRentBenz][sl];
	VehInfo[newcar][vAgetid] = playerid;
	VehInfo[newcar][vRent] = PlayerInfo[playerid][pRent][sl];
	VehInfo[newcar][vBiz] = b;
	VehInfo[newcar][vBizItem] = item;
	VehInfo[newcar][vRentSlot] = sl;
	Cars[newcar] = 53;
	new tyear, tmonth, tday, thour, tminute, tsecond;
	stamp2datetime(VehInfo[newcar][vRent], tyear, tmonth, tday, thour, tminute, tsecond, 3);

	ReloadVehicleLabel(newcar); // Перезагружаем лейбл на тс

	VehInfo[newcar][v3dstat] = 4000;
	format(string,sizeof(string),"{cccccc}Аренда до {0088ff}%02d:%02d\n{444444}%s", thour, tminute, PlayerInfo[playerid][pName]);
	VehLabel[newcar] = CreateDynamic3DTextLabel(string,0xfaf75c99,x,y,z,15.0,INVALID_PLAYER_ID, newcar,0,0,0);

	new Float:dist = GetPlayerDistanceFromPoint(playerid, x, y, z);
	if(dist >= 20.0)
	{
		CreateGps(playerid, x, y, z, 0, 0, 10.0);
		format(string,sizeof(string),"{99ff66}Арендованный транспорт {ff9000}%s [%d] {99ff66}отмечен на карте", GetVehicleName(PlayerInfo[playerid][pRentModel][sl]), newcar);
		SuccessMessage(playerid, string);
	}
	else
	{
		format(string,sizeof(string),"{99ff66}Арендованный транспорт {ff9000}%s [%d] {99ff66}извлечён и стоит рядом с вами", GetVehicleName(PlayerInfo[playerid][pRentModel][sl]), newcar);
		SuccessMessage(playerid, string);
	}
	PlayerInfo[playerid][pRentVeh][sl] = newcar;
	if(b > 0) BizzInfo[b][bUseItem][item] ++;

	NoCollisionForAll(playerid, 0); // Отключаем коллизию на 20 сек
	return 1;
}

stock ReloadVehicleLabel(vehicleid)
{
	if(VehInfo[vehicleid][v3dstat] > 0) DestroyDynamic3DTextLabel(VehLabel[vehicleid]), VehInfo[vehicleid][v3dstat] = 0;
}

stock AgetPlane2(playerid)
{
	new b;
    if(IsPlayerInRangeOfPoint(playerid,3.0,1970.070190, -2182.471191, 13.976880)) b = 53, DP[0][playerid] = 53;
    else if(IsPlayerInRangeOfPoint(playerid,3.0,-1557.035766, -430.098663, 6.470238)) b = 54, DP[0][playerid] = 54;
    else if(IsPlayerInRangeOfPoint(playerid,3.0,1709.038208, 1597.577270, 10.575634)) b = 55, DP[0][playerid] = 55;
    else if(IsPlayerInRangeOfPoint(playerid,3.0,418.809112, 2531.697021, 17.087944)) b = 56, DP[0][playerid] = 56;
    else return 1;
    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
    if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	PlayerPlaySound(playerid,40405,0,0,0);
	new unix = gettime();
	if(PlayerInfo[playerid][pRent][0] > unix && PlayerInfo[playerid][pRent][1] > unix) return ErrorMessage(playerid, "{FF6347}У вас уже два арендованных транспорта [ Y >> Транспорт или /car ]");
   	new str[86],sctring[774];
   	format(str,sizeof(str),"Транспорт\tВ наличии\tСтоимость Аренды\tВремя Аренды"), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Sparrow\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][0]-BizzInfo[b][bUseItem][0],BizzInfo[b][bPrice][0]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Maverick\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][1]-BizzInfo[b][bUseItem][1],BizzInfo[b][bPrice][1]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Dodo\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][2]-BizzInfo[b][bUseItem][2],BizzInfo[b][bPrice][2]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Beagle\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][3]-BizzInfo[b][bUseItem][3],BizzInfo[b][bPrice][3]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Cropduster\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][4]-BizzInfo[b][bUseItem][4],BizzInfo[b][bPrice][4]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Stuntplane\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][5]-BizzInfo[b][bUseItem][5],BizzInfo[b][bPrice][5]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Shamal\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][6]-BizzInfo[b][bUseItem][6],BizzInfo[b][bPrice][6]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Nevada\t{cccccc}%d\t{99ff66}%d$\t{cccccc}1 Час",BizzInfo[b][bItem][7]-BizzInfo[b][bUseItem][7],BizzInfo[b][bPrice][7]), strcat(sctring,str);
	ShowDialog(playerid,1157,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Аренда Авиатранспорта",sctring,"Выбрать","Выход");
	return 1;
}
