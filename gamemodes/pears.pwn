alias:kickmp("km")
CMD:kickmp(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pMedia] == 3)
	{
		if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Прогнать с мероприятия [ /kickmp ID ]");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	    if(OnlineInfo[params[0]][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		if(MPGO[params[0]] == 1)
		{
			MPGO[params[0]] = 0;
			if(GameInfo[gamGangzone])
			{
				showGangZones(playerid);
			}
			PPSpawnPlayer(params[0]);
			SendClientMessage(params[0], COLOR_GRAD1, " Администратор прогнал вас с мероприятия");
			SendClientMessage(playerid, COLOR_GRAD1, " Вы прогнали игрока с мероприятия");
		}
		else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он не участвует в мероприятии");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}
CMD:offmp(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pMedia] == 3)
	{
	    if(Pognalinamp == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Для завершения мероприятия его нужно начать [ /gomp ]");
	    new string[256];
	    GameInfo[gamInt] = 0;
		GameInfo[gamWorld] = 0;
		GameInfo[gamSpawn] = 0;
		GameInfo[gamSinfo1] = 0;
		GameInfo[gamSinfo2] = 0;
		GameInfo[gamType] = 0;
		GameInfo[gamOffClist] = 0;
		GameInfo[gamOffNick] = 0;
		GameInfo[gamDamage] = 0;
		GameInfo[gamTeamKill] = 0;
		GameInfo[gamEnterTime] = 60;
		for(new i = 0; i < 2; i++) GameInfo[gamZoneX][i] = 0;
		for(new i = 0; i < 2; i++) GameInfo[gamZoneY][i] = 0;
		for(new i = 0; i < 2; i++) GameInfo[gamZoneZ][i] = 0;
		for(new i = 0; i < 2; i++) GameInfo[gamSkin][i] = 0;
		for(new i = 0; i < sizeof(GameInfo[gamGun]); i++) GameInfo[gamGun][i] = 0;
		GameInfo[gamType] = 0;
		Pognalinamp = 0, GameInfo[gamEnterTime] = 60, Vremyamp = 0, Ogranmp = 0, Stopmp = 0;
		foreach (Player, i)
    	{
			if(MPGO[i] == 1)
			{
		   		gYda[i] = 2;
           		ACSetPlayerHealth(i, 0);
        	}
    	}
		GameInfo[gamGangzone] = 0;
		if(MPGO[playerid] >= 1){MPGO[playerid] = 0;}
		// OOCOff(COLOR_BLUE,"————————————————————————————————————");
		// OOCOff(COLOR_BLUE,"  ");
		// format(string, sizeof(string), "{0088ff}*** (( %s[%d] {FF6347}завершил {ffcc66}мероприятие {0088ff})) ***", PlayerInfo[playerid][pName], playerid), OOCOff(COLOR_BLUE,string);
		// OOCOff(COLOR_BLUE,"  ");
		// OOCOff(COLOR_BLUE,"————————————————————————————————————");
		// format(string, sizeof(string), "[ ADM ]: %s[%d] завершил мероприятие", PlayerInfo[playerid][pName], playerid)
		// ABroadCast(COLOR_ADM, string, 1)
		format(string, sizeof(string), "{0088ff}[ Мероприятие ] {cccccc}%s[%d] завершил мероприятие", PlayerInfo[playerid][pName], playerid);
		SendMpMessage(string);
    	AdminLog("offmp", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Завершил мп");
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	return 1;
}

alias:mp("tpmp")
CMD:mp(playerid, const params[])
{
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно выйти из транспорта");
    if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
    if(PlayerInfo[playerid][pJailed] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я сижу в тюрьме и не могу присоединиться к мероприятию");
    if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже на мероприятии");
    if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
    if(PlayerInfo[playerid][pSoska] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Администраторы не могут участвовать в мероприятиях");
    if(gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я тюнингую транспорт");
    if(PursuitTime[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Меня преследует полиция...");
    if(GameInfo[gamType] == 1 && OnlineInfo[playerid][oListenRadioPears] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это мероприятие проводит радиоведущий {0088ff}[ /radio >> Включить ]");
	if(GameInfo[gamType] == 2 && !IsPlayerSyncModels(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: На это мероприятие можно зайти только с Pears Project Launcher");
    if(IsPlayerEditObject(playerid) || MenuInfo[playerid][zStat] == 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят редактированием объекта");
    if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
	if(IsPlayerHavePursuit(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете отправиться на мероприятие [ Вас преследует полиция ]");
	if(howstun(playerid)) return ErrorMessage(playerid, "{ff6347}Вы не можете отправиться на мероприятие [ Связаны или оглушены ]");
	if(PlayerInfo[playerid][pWarns] >= 2) return ErrorMessage(playerid, "{ff6347}Вы не можете отправиться на мероприятие [ 2+ Warns ]");

    new str[64], string[512], gun[128], ogran[64];
    if(Ogranmp != 0 && Stopmp >= Ogranmp) return format(string, sizeof(string), "[ Мысли ]: На это мероприятие допустили всего: %d человек",Ogranmp),SendClientMessage(playerid, COLOR_GREY, string);
	if(Pognalinamp >= 1)
	{
		if(Vremyamp >= 1 || Vremyamp == -1) 
		{	
			if(Ogranmp > 0) format(ogran, sizeof(ogran), "{ff9000}%d чел.", Ogranmp);
			else format(ogran, sizeof(ogran), "{444444}нет");
			new bool:first = true;
			for (new gamid = 0; gamid < sizeof(GameInfo[gamGun]); gamid++)
			{
				if (GameInfo[gamGun][gamid]) {
					if (!first) strcat(gun, ", ");
					format(str, sizeof(str), "%s", gunName[GameInfo[gamGun][gamid]]);
					strcat(gun, str);
					first = false;
				}
				if(gun[0] == 0) format(gun, sizeof(gun), "{444444}нет");
			}
			format(string, sizeof(string), "{cccccc}Тип спавна: %s\n{cccccc}Оружие: {ff9000}%s\n{cccccc}Лимит участников: %s\n{cccccc}Отображение игроков на мини-карте %s\n{cccccc}Отображение никнеймов %s\n{cccccc}Ванильный урон %s\n{cccccc}Урон по союзникам %s\n\n{ff9000}Вы точно хотите присоединиться к мероприятию?", GameInfo[gamSpawn] ? "{444444}многоразовый" : "{444444}одноразовый", gun, ogran, GameInfo[gamOffClist] ? "{ff6347}выключено" : "{99ff66}включено", GameInfo[gamOffNick] ?  "{ff6347}выключено" : "{99ff66}включено", GameInfo[gamDamage] ?  "{99ff66}включено" : "{ff6347}выключено", GameInfo[gamTeamKill] ?  "{99ff66}включено" : "{ff6347}выключено");
			ShowDialog(playerid,304,DIALOG_STYLE_MSGBOX,"{ff9000}Мероприятие",string,"Да","Нет");
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Время для присоединения к мероприятию вышло");
	}
   	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Администрация не приглашала меня на мероприятие");
	return 1;
}
CMD:freezeall(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	foreach (Player, i)
	{
		if(GetDistanceBetweenPlayers(playerid, i) <= 100.0 && playerid != i && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
		{
		    TogglePlayerControllable(i, false);
		    SendClientMessage(i, COLOR_GRAD1, " Администратор заморозил вас.");
		}
	}
	SendClientMessage(playerid, COLOR_GRAD1, " Ты заморозил игроков, которые были рядом [В радиусе 100 метров]");
    return 1;
}
CMD:unfreezeall(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 4 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	foreach (Player, i)
	{
		if(GetDistanceBetweenPlayers(playerid, i) <= 100.0 && playerid != i && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
		{
		    TogglePlayerControllable(i, true);
		    SendClientMessage(i, COLOR_GRAD1, " Администратор разморозил вас.");
		}
	}
	SendClientMessage(playerid, COLOR_GRAD1, " Ты разморозил игроков, которые были рядом [В радиусе 100 метров]");
    return 1;
}
CMD:opendoor(playerid)
{
	new vorot;
	vorot = IsADoor(playerid);
	if(vorot < 0) return 1;

	if(Statvorota[vorot] == 0)
	{
		if(vorot == 1)
		{
			if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1
			|| PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 && PlayerInfo[playerid][pRank] >= 7) MoveDynamicObject(Vorota[85], 2758.6968, 934.1884, 1501.2300, 1.0), PlayerPlaySound(playerid, 6400, 0.0, 0.0, 0.0), Statvorota[vorot] = 5;
		}
		else if(vorot == 2) MoveDynamicObject(Vorota[116], 1374.690063, 1564.148315, 7.3884, 1.5), Statvorota[vorot] = 7, PlayerPlaySound(playerid,6400,0,0,0);
		else if(vorot == 3)
		{
			if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1)
			{
				if(DoorAccess[2] == 0) MoveDynamicObject(Vorota[86], 2709.5586, 927.5541, 1501.2495, 1.5), PlayerPlaySound(playerid, 6400, 0,0,0), Statvorota[vorot] = 3, DoorAccess[2] = 1;
				else MoveDynamicObject(Vorota[86], 2709.5586, 929.1051, 1501.2495, 1.5), PlayerPlaySound(playerid, 6400, 0,0,0), Statvorota[vorot] = 3, DoorAccess[2] = 0;
			}
		}
		else if(vorot == 4)
		{
			if(PlayerInfo[playerid][pLeader] == 2 || PlayerInfo[playerid][pMember] == 2 || PlayerInfo[playerid][pFbi] >= 1)
			{
				if(DoorAccess[3] == 0) MoveDynamicObject(Vorota[87], 2709.5586, 932.5445, 1501.2495, 1.5), PlayerPlaySound(playerid, 6400, 0,0,0), Statvorota[vorot] = 3, DoorAccess[3] = 1;
				else MoveDynamicObject(Vorota[87], 2709.5586, 934.0955, 1501.2495, 1.5), PlayerPlaySound(playerid, 6400, 0,0,0), Statvorota[vorot] = 3, DoorAccess[3] = 0;
			}
		}
		else if(vorot == 10)
		{
			if(IsADepart(playerid) || PlayerInfo[playerid][pFbi] >= 1 || GetPVarInt(playerid,"endorse") == 1) { Statvorota[vorot] = 5, MoveDynamicObject(Lvdver1, 1557.1495, -1669.5543, 15.1908, 1.5), SetDynamicObjectMaterial(LvdverKeypad[6], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), SetDynamicObjectMaterial(LvdverKeypad[7], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), PlayerPlaySound(playerid,6400,0,0,0); }
			else { Statvorota[vorot] = 5, SetDynamicObjectMaterial(LvdverKeypad[6], 1, 18646, "MatColours", "red-4", 0x00000000); SetDynamicObjectMaterial(LvdverKeypad[7], 1, 18646, "MatColours", "red-4", 0x00000000), PlayerPlaySound(playerid, 21001); }
		}
		else if(vorot == 29)
		{
			if(IsADepart(playerid) || PlayerInfo[playerid][pFbi] >= 1 || GetPVarInt(playerid,"endorse") == 1) { Statvorota[vorot] = 5, MoveDynamicObject(Lvdver2, 1557.1395, -1681.6670, 15.1908, 1.5), SetDynamicObjectMaterial(LvdverKeypad[8], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), SetDynamicObjectMaterial(LvdverKeypad[9], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), PlayerPlaySound(playerid,6400,0,0,0); }
			else { Statvorota[vorot] = 5, SetDynamicObjectMaterial(LvdverKeypad[8], 1, 18646, "MatColours", "red-4", 0x00000000); SetDynamicObjectMaterial(LvdverKeypad[9], 1, 18646, "MatColours", "red-4", 0x00000000), PlayerPlaySound(playerid, 21001); }
		}
		else if(vorot == 34)
		{
			if(PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 1 || GetPVarInt(playerid,"endorse") == 1) { Statvorota[vorot] = 5, MoveDynamicObject(Lvdver3, 1563.1331, -1654.1071, 15.1908, 1.5), SetDynamicObjectMaterial(LvdverKeypad[4], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), SetDynamicObjectMaterial(LvdverKeypad[5], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), PlayerPlaySound(playerid,6400,0,0,0); }
			else { Statvorota[vorot] = 5, SetDynamicObjectMaterial(LvdverKeypad[4], 1, 18646, "MatColours", "red-4", 0x00000000), SetDynamicObjectMaterial(LvdverKeypad[5], 1, 18646, "MatColours", "red-4", 0x00000000), PlayerPlaySound(playerid,21001,0,0,0); }
		}
		else if(vorot == 120)
		{
			if(PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 1 || GetPVarInt(playerid,"endorse") == 1) { if(Statvorota[13] == 0) Statvorota[vorot] = 5, MoveDynamicObject(Lvdver4, 1545.518066, -1636.145751, 12.543057, 1.5), SetDynamicObjectMaterial(LvdverKeypad[0], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), SetDynamicObjectMaterial(LvdverKeypad[1], 1, 7650, "vgnusedcar", "lightblue2_32", 0x00000000), PlayerPlaySound(playerid,6400,0,0,0); }
			else { SetDynamicObjectMaterial(LvdverKeypad[0], 1, 18646, "MatColours", "red-4", 0x00000000), SetDynamicObjectMaterial(LvdverKeypad[1], 1, 18646, "MatColours", "red-4", 0x00000000), PlayerPlaySound(playerid, 21001), Statvorota[vorot] = 5; }
		}
		else if(vorot == 101) {
			if(PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 1 || GetPVarInt(playerid,"endorse") == 1) { if(Statvorota[13] == 0) Statvorota[vorot] = 5, MoveDynamicObject(Lvdver5, 1574.264404, -1687.420166, 5.235195, 1.5), PlayerPlaySound(playerid,6400,0,0,0); }
		}
		else if(vorot == 38)
		{
			if(IsPoliceMember(playerid) && PlayerInfo[playerid][pJailed] == 0) MoveDynamicObject(Vorota[4], 995.423828, 2460.763916, 11.103613, 1.5), Statvorota[vorot] = 10, PlayerPlaySound(playerid,6400,0,0,0);
		}
		else if(vorot == 39)
		{
			if(IsPoliceMember(playerid) && PlayerInfo[playerid][pJailed] == 0) MoveDynamicObject(Vorota[6], 1034.857543, 2428.060546, 11.103613, 1.5), Statvorota[vorot] = 7, PlayerPlaySound(playerid,6400,0,0,0);
		}
		else if(vorot == 40)
		{
			if(IsPoliceMember(playerid) && PlayerInfo[playerid][pJailed] == 0 || PlayerInfo[playerid][pMember] == 7 || PlayerInfo[playerid][pLeader] == 7) MoveDynamicObject(Vorota[7], 965.005920, 2419.344970, 9.840311, 1.5), Statvorota[vorot] = 7, PlayerPlaySound(playerid,6400,0,0,0);
		}
