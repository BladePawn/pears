stock ExitKasino3(playerid)
{
	SetPVarInt(playerid, "kas", 0);
	SetPVarInt(playerid, "kstol", 0);
	if(AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;
	TogglePlayerControllable(playerid, true);
	SetCameraBehindPlayer(playerid);
	ApplyAnimation(playerid,"CASINO","Roulette_out", 4.0, false, false, false, false, false, SYNC_ALL);
	PlayerTextDrawHide(playerid, FishkiDraw[0]), PlayerTextDrawHide(playerid, FishkiDraw[1]);
	return 1;
}
stock CheckRuletka(playerid, num)
{
	if(GetPVarInt(playerid,"kas") == 6)
	{
		new myst = GetPVarInt(playerid,"kmesto");
		new summ = GetPVarInt(playerid,"oryjtemp");
		new pobeda = 0;
		if(PlayerInfo[playerid][pAmmos1] < summ) return ErrorMessage(playerid, "{FF6347}Вам не хватает фишек для ставки"), ExitKasino3(playerid);
		PlayerPlaySound(playerid, 5348 + num);
		switch(num)
    	{
	        case 0: PlayerPlaySound(playerid,5438,0,0,0);
	        case 1: PlayerPlaySound(playerid,5439,0,0,0);
	        case 2: PlayerPlaySound(playerid,5440,0,0,0);
	        case 3: PlayerPlaySound(playerid,5441,0,0,0);
	        case 4: PlayerPlaySound(playerid,5442,0,0,0);
	        case 5: PlayerPlaySound(playerid,5443,0,0,0);
	        case 6: PlayerPlaySound(playerid,5444,0,0,0);
	        case 7: PlayerPlaySound(playerid,5445,0,0,0);
	        case 8: PlayerPlaySound(playerid,5446,0,0,0);
	        case 9: PlayerPlaySound(playerid,5447,0,0,0);
	        case 10: PlayerPlaySound(playerid,5411,0,0,0);
	        case 11: PlayerPlaySound(playerid,5412,0,0,0);
	        case 12: PlayerPlaySound(playerid,5413,0,0,0);
	        case 13: PlayerPlaySound(playerid,5414,0,0,0);
	        case 14: PlayerPlaySound(playerid,5415,0,0,0);
	        case 15: PlayerPlaySound(playerid,5416,0,0,0);
	        case 16: PlayerPlaySound(playerid,5417,0,0,0);
	        case 17: PlayerPlaySound(playerid,5418,0,0,0);
	        case 18: PlayerPlaySound(playerid,5419,0,0,0);
	        case 19: PlayerPlaySound(playerid,5420,0,0,0);
	        case 20: PlayerPlaySound(playerid,5421,0,0,0);
	        case 21: PlayerPlaySound(playerid,5422,0,0,0);
	        case 22: PlayerPlaySound(playerid,5423,0,0,0);
	        case 23: PlayerPlaySound(playerid,5424,0,0,0);
	        case 24: PlayerPlaySound(playerid,5425,0,0,0);
	        case 25: PlayerPlaySound(playerid,5426,0,0,0);
	        case 26: PlayerPlaySound(playerid,5427,0,0,0);
	        case 27: PlayerPlaySound(playerid,5428,0,0,0);
	        case 28: PlayerPlaySound(playerid,5429,0,0,0);
	        case 29: PlayerPlaySound(playerid,5430,0,0,0);
	        case 30: PlayerPlaySound(playerid,5431,0,0,0);
	        case 31: PlayerPlaySound(playerid,5432,0,0,0);
	        case 32: PlayerPlaySound(playerid,5433,0,0,0);
	        case 33: PlayerPlaySound(playerid,5434,0,0,0);
	        case 34: PlayerPlaySound(playerid,5435,0,0,0);
	        case 35: PlayerPlaySound(playerid,5436,0,0,0);
	        case 36: PlayerPlaySound(playerid,5437,0,0,0);
	        default: PlayerPlaySound(playerid,5438,0,0,0);
     	}
		if(myst == num) pobeda = summ*rulWin[myst]; // Точное Число
		else if(myst == 37) // Первый Столб
		{
			if(num == 1 || num == 4 || num == 7 || num == 10 || num == 13 || num == 16 || num == 19
		 	|| num == 22 || num == 25 || num == 28 || num == 31 || num == 34) pobeda = summ*rulWin[myst];
		}
		else if(myst == 38) // Второй Столб
		{
			if(num == 2 || num == 5 || num == 8 || num == 11 || num == 14 || num == 17 || num == 20
		 	|| num == 23 || num == 26 || num == 29 || num == 32 || num == 35) pobeda = summ*rulWin[myst];
		}
		else if(myst == 39) // Третий Столб
		{
			if(num == 3 || num == 6 || num == 9 || num == 12 || num == 15 || num == 18 || num == 21
		 	|| num == 24 || num == 27 || num == 30 || num == 33 || num == 36) pobeda = summ*rulWin[myst];
		}
		else if(myst == 40) // Первая Группа 1 - 12
		{
			if(num >= 1 && num <= 12) pobeda = summ*rulWin[myst];
		}
		else if(myst == 41) // Вторая Группа 13 - 24
		{
			if(num >= 13 && num <= 24) pobeda = summ*rulWin[myst];
		}
		else if(myst == 42) // Третья Группа 25 - 36
		{
			if(num >= 25 && num <= 36) pobeda = summ*rulWin[myst];
		}
		else if(myst == 43) // Первый Диапазон 1 - 18 (1.1)
		{
			if(num >= 1 && num <= 18) pobeda = summ*rulWin[myst];
		}
		else if(myst == 44) // Чётное Even (1.1)
		{
			if(num == 2 || num == 4 || num == 6 || num == 8 || num == 10 || num == 12 || num == 14 || num == 16 || num == 18 || num == 20
		 	|| num == 22 || num == 24 || num == 26 || num == 28 || num == 30 || num == 32 || num == 34 || num == 36) pobeda = summ*rulWin[myst];
		}
		else if(myst == 45) // Красное (1.1)
		{
			if(num == 1 || num == 3 || num == 5 || num == 7 || num == 9 || num == 12 || num == 14 || num == 16 || num == 18 || num == 19
		 	|| num == 21 || num == 23 || num == 25 || num == 27 || num == 30 || num == 32 || num == 34 || num == 36) pobeda = summ*rulWin[myst];
		}
		else if(myst == 46) // Чёрное (1.1)
		{
			if(num == 2 || num == 4 || num == 6 || num == 8 || num == 10 || num == 11 || num == 13 || num == 15 || num == 17 || num == 20
		 	|| num == 22 || num == 24 || num == 26 || num == 28 || num == 29 || num == 31 || num == 33 || num == 35) pobeda = summ*rulWin[myst];
		}
		else if(myst == 47) // Нечётное Odd (1.1)
		{
			if(num == 1 || num == 3 || num == 5 || num == 7 || num == 9 || num == 11 || num == 13 || num == 15 || num == 17 || num == 19
		 	|| num == 21 || num == 23 || num == 25 || num == 27 || num == 29 || num == 31 || num == 33 || num == 35) pobeda = summ*rulWin[myst];
		}
		else if(myst == 48) // Второй Диапазон 19 - 36 (1.1)
		{
			if(num >= 19 && num <= 36) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 49)
  		{
  		    if(num == 0 || num == 1 || num == 2 || num == 3) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 50)
  		{
  		    if(num == 1 || num == 2 || num == 3) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 51)
  		{
  		    if(num == 1 || num == 2 || num == 3 || num == 4 || num == 5 || num == 6) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 52)
  		{
  		    if(num == 4 || num == 5 || num == 6) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 53)
  		{
  		    if(num == 4 || num == 5 || num == 6 || num == 7 || num == 8 || num == 9) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 54)
  		{
  		    if(num == 7 || num == 8 || num == 9) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 55)
  		{
  		    if(num == 7 || num == 8 || num == 9 || num == 10 || num == 11 || num == 12) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 56)
  		{
  		    if(num == 10 || num == 11 || num == 12) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 57)
  		{
  		    if(num == 10 || num == 11 || num == 12 || num == 13 || num == 14 || num == 15) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 58)
  		{
  		    if(num == 13 || num == 14 || num == 15) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 59)
  		{
  		    if(num == 13 || num == 14 || num == 15 || num == 16 || num == 17 || num == 18) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 60)
  		{
  		    if(num == 16 || num == 17 || num == 18) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 61)
  		{
  		    if(num == 16 || num == 17 || num == 18 || num == 19 || num == 20 || num == 21) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 62)
  		{
  		    if(num == 19 || num == 20 || num == 21) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 63)
  		{
  		    if(num == 19 || num == 20 || num == 21 || num == 22 || num == 23 || num == 24) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 64)
  		{
  		    if(num == 22 || num == 23 || num == 24) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 65)
  		{
  		    if(num == 22 || num == 23 || num == 24 || num == 25 || num == 26 || num == 27) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 66)
  		{
  		    if(num == 25 || num == 26 || num == 27) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 67)
  		{
  		    if(num == 25 || num == 26 || num == 27 || num == 28 || num == 29 || num == 30) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 68)
  		{
  		    if(num == 28 || num == 29 || num == 30) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 69)
  		{
  		    if(num == 28 || num == 29 || num == 30 || num == 31 || num == 32 || num == 33) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 70)
  		{
  		    if(num == 31 || num == 32 || num == 33) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 71)
  		{
  		    if(num == 31 || num == 32 || num == 33 || num == 34 || num == 35 || num == 36) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 72)
  		{
  		    if(num == 34 || num == 35 || num == 36) pobeda = summ*rulWin[myst];
  		}
  		else if(myst == 73)
