stock WeaponAmmoType(weaponid) // Патроны для пистолетов и пистолетов - пулёметов
{
	if(weaponid == 25 || weaponid == 26 || weaponid == 27) return 1; // Дробовики
	else if(weaponid == 22 || weaponid == 24) return 2; // Пистолеты
	else if(weaponid == 28 || weaponid == 29 || weaponid == 32) return 3; // Пистолет- Пулемёт
	else if(weaponid == 30 || weaponid == 31) return 4; // Автомат
	else if(weaponid == 33 || weaponid == 34) return 5; // Винтовки
	return 0;
}

IPacket:BULLET_SYNC(playerid, BitStream:bs)
{
	if(OnlineInfo[playerid][oLogged] == 0 || OnlineInfo[playerid][oKickTimer] > 0) return false;
	if(IsPlayerAfk(playerid)) return false;

    new bulletData[PR_BulletSync], weaponid, Float:hitpos[3];
    BS_IgnoreBits(bs, 8);
    BS_ReadBulletSync(bs, bulletData);
    
	// Защита от тупейшего aim (если посылаются пакеты точно в центр)
    if(BULLET_HIT_TYPE:bulletData[PR_hitType] == BULLET_HIT_TYPE_PLAYER)
    {
        new Float:getPlayerX, Float:getPlayerY, Float:getPlayerZ, Float:getLastPlayerZ;
        GetPlayerPos(playerid, getPlayerX, getPlayerY, getPlayerZ);
        GetPlayerPos(bulletData[PR_hitId], getLastPlayerZ, getLastPlayerZ, getLastPlayerZ);
        new Float:betweenDistance = floatabs(bulletData[PR_origin][0] - getPlayerX) + floatabs(bulletData[PR_origin][1] - getPlayerY);

		if(bulletData[PR_offsets][0] == 0.0 && bulletData[PR_offsets][1] == 0.0 && bulletData[PR_offsets][2] == 0.0 || betweenDistance < 0.15
		|| floatabs(bulletData[PR_origin][2] - getPlayerZ) < 0.01 || floatabs(getLastPlayerZ - bulletData[PR_hitPos][2]) < 0.01)
        {
            return 0;
        }
  	}
    
    weaponid = bulletData[PR_weaponId];
    hitpos[0] = bulletData[PR_hitPos][0];
    hitpos[1] = bulletData[PR_hitPos][1];
    hitpos[2] = bulletData[PR_hitPos][2];
    switch(weaponid)
	{
 		case 0..15,40,44..46: return 1;
 	}
  	new sl = Protect_Slot(weaponid);

	if(BULLET_HIT_TYPE:bulletData[PR_hitType] == BULLET_HIT_TYPE_PLAYER 
		|| BULLET_HIT_TYPE:bulletData[PR_hitType] == BULLET_HIT_TYPE_VEHICLE) BulletDamagePlayer[playerid] = weaponid;

	// Кикаем сразу, если игрок стреляет из читерского оружия
	AnticheatGunKick(playerid, bulletData[PR_weaponId]);

  	ProtectInfo[playerid][prAmmo][sl] --;
  	ProtectInfo[playerid][prDet][sl] --;
  	if(ProtectInfo[playerid][prAmmo][sl] > GetPlayerAmmo(playerid)) ProtectInfo[playerid][prAmmo][sl] = GetPlayerAmmo(playerid);

	MineWar_OnShoot(playerid, WEAPON: weaponid);
	Tomb_OnShoot(playerid, WEAPON: weaponid);
  	
  	// Взрывные патроны
  	if(PlayerInfo[playerid][pBeret] == 0 && MPGO[playerid] == 0 && ProtectInfo[playerid][prExplosive][sl] >= 1) 
	{
		ProtectInfo[playerid][prExplosive][sl] -= 1/*, CreateExplosion(hitpos[0], hitpos[1], hitpos[2],12,0.5)*/; // Временное выключение Взрывных

		// Наносим дамаг по самолёту
		if(BULLET_HIT_TYPE:bulletData[PR_hitType] == BULLET_HIT_TYPE_VEHICLE 
			&& bulletData[PR_hitId] == flyveh && NPCInfo[4][npcStart] == true && plane_health > 0) 
		{
			PlaneDamage(playerid, true);
		}
	}
	else
	{
		// Наносим дамаг по самолёту
		if(BULLET_HIT_TYPE:bulletData[PR_hitType] == BULLET_HIT_TYPE_VEHICLE 
			&& bulletData[PR_hitId] == flyveh && NPCInfo[4][npcStart] == true && plane_health > 0) 
		{
			PlaneDamage(playerid, false);
		}
	}
  	
  	// Изношенное оружие
  	if(PlayerInfo[playerid][pBeret] == 0 && MPGO[playerid] == 0 && ProtectInfo[playerid][prDet][sl] <= 0 && weaponid != 23 && ProtectInfo[playerid][prWeapon][sl] >= 1 && ProtectInfo[playerid][prAmmo][sl] >= 1)
  	{
    	new put_inva = GiveThingPlayer(playerid, ProtectInfo[playerid][prWeapon][sl], 1, ProtectInfo[playerid][prDet][sl], ProtectInfo[playerid][prQet][sl], 1, 0, 9999); // Кладём оружие
		if(put_inva == -1) Throw(playerid, ProtectInfo[playerid][prWeapon][sl], 1, ProtectInfo[playerid][prDet][sl], ProtectInfo[playerid][prQet][sl], 1, 0);
		
		PlayerPlaySound(playerid,1052,0,0,0);
  		new fitem, flim, pow = get_power(playerid), myammo;
		new weaponType = WeaponAmmoType(weaponid);
		if(weaponType == 1) fitem = 27; // Дробовик (Ammo 20,8mm)
		else if(weaponType == 2 || weaponType == 3) fitem = 28; // Пистолет (Ammo 11,43mm)
		else if(weaponType == 4) fitem = 29; // Автомат (Ammo 5,45mm)
		else if(weaponType == 5) fitem = 30; // Винтовка (Ammo 45mm)
  		flim = 100*pow;
  		myammo = get_invent(playerid, fitem, 0);
  		if(fitem >= 27)
  		{
	  		if(myammo+ProtectInfo[playerid][prAmmo][sl] <= flim) GiveThingPlayer(playerid, fitem, ProtectInfo[playerid][prAmmo][sl], 0, ProtectInfo[playerid][prQet][sl], 0, 0, 9999);
	  		else // Все патроны не поместились - делим на землю и в руки
	  		{
	  		    new votskok = flim-myammo; // Вычисляем сводобное место для патронов на руках
	  			if(votskok > 0)
			  	{
			  		GiveThingPlayer(playerid, fitem, votskok, 0, 0, 0, 0, 9999); // Даём эти патроны, которые влезают под лимит
			  		if(ProtectInfo[playerid][prAmmo][sl]-votskok > 0) Throw(playerid, fitem, ProtectInfo[playerid][prAmmo][sl]-votskok, 0, 0, 0, 0); // Если ещё остались патроны, которые не влезли в инвент - роняем на землю
		  		}
	    	}
			
			Protect_Remove(playerid, ProtectInfo[playerid][prWeapon][sl], true); // Забираем оружие из рук
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Ваше оружие полностью изношено!","*",""), PlayerPlaySound(playerid,14406,0,0,0);
		}
  	}
  	
  	// Патроны закончились
  	if(ProtectInfo[playerid][prAmmo][sl] == 0 && ProtectInfo[playerid][prWeapon][sl] >= 1)
  	{
		if(PlayerInfo[playerid][pBeret] == 0 && MPGO[playerid] == 0 && WeaponAmmoType(ProtectInfo[playerid][prWeapon][sl]))
		{
        	new put_inva = GiveThingPlayer(playerid, ProtectInfo[playerid][prWeapon][sl], 1, ProtectInfo[playerid][prDet][sl], ProtectInfo[playerid][prQet][sl], 1, 0, 9999); // Кладём оружие
			if(put_inva == -1) Throw(playerid, ProtectInfo[playerid][prWeapon][sl], 1, ProtectInfo[playerid][prDet][sl], ProtectInfo[playerid][prQet][sl], 1, 0), ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Патроны закончились [ В инвентаре нет места, оружие упало на землю ]","*","");
			PlayerPlaySound(playerid,1052,0,0,0);
		}
		Protect_Remove(playerid, ProtectInfo[playerid][prWeapon][sl], true);
  	}
	return 1;
}
IPacket:PLAYER_SYNC(playerid, BitStream:bs)
{
	if(IsARealNPC(playerid)) return true;

	if(OnlineInfo[playerid][oLogged] == 0 && gZaregal[playerid] != 1
		|| OnlineInfo[playerid][oKickTimer] > 0) return false;

	new onFootData[PR_OnFootSync];
 	BS_IgnoreBits(bs, 8);
  	BS_ReadOnFootSync(bs, onFootData);

	if(!IsValidFloat(onFootData[PR_surfingOffsets][0])
		|| !IsValidFloat(onFootData[PR_surfingOffsets][1]) || !IsValidFloat(onFootData[PR_surfingOffsets][2])) return false;

	// Античит на оружие, считаем варнинги
	AnticheatGunTrigger(playerid, onFootData[PR_weaponId]);

	// Защита от инвиза на транспорте
	if(onFootData[PR_surfingVehicleId] > 0 && onFootData[PR_surfingVehicleId] <= 2000)
	{
		if(VehInfo[onFootData[PR_surfingVehicleId]][vSeat] > 0)
		{
			new Float:pos[3];
			GetVehiclePos(onFootData[PR_surfingVehicleId], pos[0],pos[1],pos[2]);
			new Float:dist = GetPlayerDistanceFromPoint(playerid, pos[0],pos[1],pos[2]);
			if(dist > 60.0) return false;
		}
	}
	else if(onFootData[PR_surfingVehicleId] > 2000) // Защита от инвиза
	{
		new objectid = onFootData[PR_surfingVehicleId] - 2000;
		new Float:pos[3];
		new dynamicObjectid = Streamer_GetItemStreamerID(playerid, STREAMER_TYPE_OBJECT, objectid);
		if(dynamicObjectid == INVALID_STREAMER_ID)
		{
			PPGetObjectPos(objectid, pos[0],pos[1],pos[2]);
			if(objectid == train_object1 || objectid == train_object2 || objectid == train_object3)
			{
				if(GetPlayerDistanceFromPoint(playerid, pos[0],pos[1],pos[2]) > 80.0) return false;
			}
			else
			{
				if(GetPlayerDistanceFromPoint(playerid, pos[0],pos[1],pos[2]) > 20.0) return false;
			}
		}
		else
		{
			GetDynamicObjectPos(dynamicObjectid, pos[0],pos[1],pos[2]);
			if(GetPlayerDistanceFromPoint(playerid, pos[0],pos[1],pos[2]) > 20.0) return false;
		}
	}

	Incoming_X[playerid] = onFootData[PR_position][0], Incoming_Y[playerid] = onFootData[PR_position][1], Incoming_Z[playerid] = onFootData[PR_position][2];
	return 1;
}

// Фикс получаем положение объекта
stock PPGetObjectPos(objectid, &Float:x, &Float:y, &Float:z)
{
	new parentVehicle = INVALID_VEHICLE_ID, parentObject = INVALID_OBJECT_ID, parentPlayer = INVALID_PLAYER_ID;
	new Float:offset[6];

	if(!GetObjectAttachedData(objectid, parentVehicle, parentObject, parentPlayer)) return false;

	if(parentVehicle != INVALID_VEHICLE_ID) GetVehiclePos(parentVehicle, x, y, z);
	else if(parentObject != INVALID_OBJECT_ID) GetObjectPos(parentObject, x, y, z);
	else if(parentPlayer != INVALID_PLAYER_ID) GetPlayerPos(parentPlayer, x, y, z);
	else 
	{
		GetObjectPos(objectid, x, y, z);
		return true;
	}

	GetObjectAttachedOffset(objectid, offset[0], offset[1], offset[2], offset[3], offset[4], offset[5]);
	x += offset[0];
	y += offset[1];
	z += offset[2];
	return true;
}

stock SendSetVehiclePosRpc(const playerid, const vehicleid, Float:x, Float:y, Float:z)
{
    new BitStream:bs = BS_New();
    BS_WriteUint16(bs, vehicleid);
    BS_WriteFloat(bs, x);
    BS_WriteFloat(bs, y);
    BS_WriteFloat(bs, z);
    PR_SendRPC(bs, playerid, 159);
    BS_Delete(bs);
    return 1;
}

IPacket:PASSENGER_SYNC(playerid, BitStream:bs)
{
	if(IsARealNPC(playerid)) return true;
	if(OnlineInfo[playerid][oLogged] == 0 || OnlineInfo[playerid][oKickTimer] > 0) return false;

	new passengerData[PR_PassengerSync];
	BS_IgnoreBits(bs, 8);
	BS_ReadPassengerSync(bs, passengerData);

	if(!IsValidFloat(passengerData[PR_position][0]) || !IsValidFloat(passengerData[PR_position][1]) || !IsValidFloat(passengerData[PR_position][2])) return false;

	// Сидим на пассажирском месте
	if(Protect_Seat[playerid] != 9999)
	{
		if(Protect_Seat[playerid] != passengerData[PR_vehicleId]) return false;
		new Float:vehicle_pos[3];
		GetVehiclePos(passengerData[PR_vehicleId], vehicle_pos[0], vehicle_pos[1], vehicle_pos[2]);
		new Float:dist = GetDistanceBetweenPoints3D(passengerData[PR_position][0], passengerData[PR_position][1], passengerData[PR_position][2], vehicle_pos[0], vehicle_pos[1], vehicle_pos[2]);
		if(dist > 10.0)
		{
			passengerData[PR_position][0] = vehicle_pos[0];
			passengerData[PR_position][1] = vehicle_pos[1];
			passengerData[PR_position][2] = vehicle_pos[2];
			BS_SetWriteOffset(bs, 8);
			BS_WritePassengerSync(bs, passengerData);
		}
	}

	// Античит на оружие, считаем варнинги
	AnticheatGunTrigger(playerid, passengerData[PR_weaponId]);
	return 1;
}

IPacket:TRAILER_SYNC(playerid, BitStream:bs)
{
	if(IsARealNPC(playerid)) return true;

	if(OnlineInfo[playerid][oLogged] == 0 || OnlineInfo[playerid][oKickTimer] > 0) return false;

	new trailerSync[PR_TrailerSync];
 	BS_IgnoreBits(bs, 8);
  	BS_ReadTrailerSync(bs, trailerSync);

	if(!IsValidFloat(trailerSync[PR_position][0]) || !IsValidFloat(trailerSync[PR_position][1]) || !IsValidFloat(trailerSync[PR_position][2])) return false;
	if(!IsValidFloat(trailerSync[PR_quaternion][0]) || !IsValidFloat(trailerSync[PR_quaternion][1]) || !IsValidFloat(trailerSync[PR_quaternion][2])) return false;
	if(!IsValidFloat(trailerSync[PR_velocity][0]) || !IsValidFloat(trailerSync[PR_velocity][1]) || !IsValidFloat(trailerSync[PR_velocity][2])) return false;
	if(!IsValidFloat(trailerSync[PR_angularVelocity][0]) || !IsValidFloat(trailerSync[PR_angularVelocity][1]) || !IsValidFloat(trailerSync[PR_angularVelocity][2])) return false;
	
	// Игрок сидит за рулём транспорта
	if(Protect_Veh[playerid] != 9999)
	{
		if(trailerSync[PR_trailerId] > 0)
		{
			if(VehInfo[Protect_Veh[playerid]][vAttachTrailer] != trailerSync[PR_trailerId]) return false;
		}
	}
	else return false;

	return true;
}

IPacket:VEHICLE_SYNC(playerid, BitStream:bs)
{
	// NPC пропускаем пакеты
	if(IsARealNPC(playerid)) return true;

	if(OnlineInfo[playerid][oLogged] == 0 || OnlineInfo[playerid][oKickTimer] > 0) return false;

	new inCarData[PR_InCarSync];
	BS_IgnoreBits(bs, 8);
	BS_ReadInCarSync(bs, inCarData);

	if(!IsValidFloat(inCarData[PR_quaternion][0]) || !IsValidFloat(inCarData[PR_quaternion][1]) || !IsValidFloat(inCarData[PR_quaternion][2])) return false;
	if(!IsValidFloat(inCarData[PR_trainSpeed])) return false;

	// Античит на оружие, считаем варнинги
	AnticheatGunTrigger(playerid, inCarData[PR_weaponId]);

	new veh = inCarData[PR_vehicleId];
	if(veh < 2000)
	{
		new Float:dist_incoming = GetPlayerDistanceFromPoint(playerid, Incoming_X[playerid], Incoming_Y[playerid], Incoming_Z[playerid]); // Текущая
		new Float:dist = GetVehicleDistanceFromPoint(veh, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]); // Текущая
		new Float:dist_before = GetVehicleDistanceFromPoint(veh, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // До
		new Float:dist_after = GetVehicleDistanceFromPoint(veh, AfterProtect_X[playerid], AfterProtect_Y[playerid], AfterProtect_Z[playerid]); // После
		new Float:skora = floatsqroot(inCarData[PR_velocity][0] * inCarData[PR_velocity][0] + inCarData[PR_velocity][1] * inCarData[PR_velocity][1] + inCarData[PR_velocity][2] * inCarData[PR_velocity][2]) * 100.0;
		/*new Float:raznica = skora-VehicleSpeed[veh];
		if(dist_incoming >= 1.0 && raznica >= 80.0 && (protect[0] == 0 || protect[0] == 1)) // Air Slap Vehicle
		{
			VehicleSpeed[veh] = 0.0;
			prote[1][playerid] ++;
			if(prote[1][playerid] >= 2)
			{
				new string[144];
				printf("[SProtect Kick]: Air Slap Vehicle RakNet %s",PlayerInfo[playerid][pName]);
				if(prote[0][playerid] == 0) format(string, sizeof(string), " [ PP ]: %s[%d] Air Slap Vehicle RakNet", PlayerInfo[playerid][pName], playerid), ABroadCast(COLOR_ADM,string,2), prote[0][playerid]++;
				if(protect[0] == 0) Kickx(playerid);
			}
			return false;
		}*/
		if(dist_incoming >= 1.6 && dist >= 1.6 && dist_before >= 1.6 && dist_after >= 1.6 && (protect[1] == 0 || protect[1] == 1)) // Trolling Vehicle
		{
			prote[2][playerid] ++;
			if(prote[2][playerid] >= 4)
			{
				new string[144];
				printf("[SProtect Kick]: Trolling Vehicle %s",PlayerInfo[playerid][pName]);
				if(prote[0][playerid] == 0) 
				{
					format(string, sizeof(string), " [ PP ]: %s[%d] Trolling Vehicle", PlayerInfo[playerid][pName], playerid);
					ABroadCast(COLOR_ADM,string,2);
					prote[0][playerid]++;
				}
				if(protect[1] == 0) 
				{
					SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Trolling Vehicle]");
					ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Trolling Vehicle]","*","");
					Kickx(playerid);
				}
			}
	  		Protect_X[playerid] = inCarData[PR_position][0], Protect_Y[playerid] = inCarData[PR_position][1], Protect_Z[playerid] = inCarData[PR_position][2];
			return false;
		}
		VehicleSpeed[veh] = skora;
		Incoming_X[playerid] = inCarData[PR_position][0], Incoming_Y[playerid] = inCarData[PR_position][1], Incoming_Z[playerid] = inCarData[PR_position][2];
	}
	return 1;
}

