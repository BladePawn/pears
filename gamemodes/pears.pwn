        {
	    	if(!GetAccessBiz(playerid, b, 2)) return 0;

			if(!strlen(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Хм.. поле для ввода значения осталось пустым"), pricebiz(playerid, b);
			new fr = strval(inputtext);
			if(fr > DP[3][playerid] || fr < DP[2][playerid]) return format(string,sizeof(string),"[ Мысли ]: Стоимость товара не меньше %d$ и не больше %d$",DP[2][playerid],DP[3][playerid]), SendClientMessage(playerid, COLOR_GREY, string), PlayerPlaySound(playerid,4203,0,0,0), pricebiz(playerid, b);
			if(fr > 500000000 || fr < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Стоимость любого товара может быть не меньше 1$ и не больше 500.000.000$"), PlayerPlaySound(playerid,4203,0,0,0), pricebiz(playerid, b);
			
			new i = DP[1][playerid];
			if(isPlayersWatchProductBiz(b, i)) return ErrorText(playerid, "[ Мысли ]: Я не могу изменить стоимость товара, когда его кто-то просматривает"), pricebiz(playerid, b);

			BizzInfo[b][bPrice][i] = fr;

			format(string,sizeof(string),"[ Мысли ]: Прайс Бизнеса [ {0088ff}%s {cccccc}] установлена цена {ff9000}%d$", GetNameThing(0, BizzInfo[b][bProduct][i], BizzInfo[b][bTypeProduct][i], 0), fr);
			SendClientMessage(playerid, COLOR_GREY, string);
			PlayerPlaySound(playerid,6401,0,0,0);
			BizzInfo[b][bUpdate] = 1;
			pricebiz(playerid, b);
			if(b >= 1 && b <= 12) UpdateFillLabel(b);
			if(b >= 13 && b <= 26) UpdateSupermarketLabel_S(b);
			if(b >= 143 && b <= 152)
			{
				new br = numnrent(b);
				for(new term; term < 5; term++)
				{
					if(RentStat[br][term] > 0)	UpdateLabelTerm(b, br, term);
				}
			}
			format(string,sizeof(string),"%s %d$", GetNameThing(0, BizzInfo[b][bProduct][i], BizzInfo[b][bTypeProduct][i], 0), fr);
			BizLog("bizprice", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, 0, string);
		}
		else pricebiz(playerid, b);
	}
