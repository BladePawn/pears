	    if(response)
	    {
			if (!is_still_cop) return ErrorMessage(playerid, "{FF6347}Произошла ошибка при попытке оформления автомобильных номеров");

			if(checksimvol(ListName[playerid])) return ErrorMessage(playerid, "{FF6347}В номере используется запрещённый символ [ Необходимо использовать буквы и цифры ]");
			if(strlen(ListName[playerid]) < 2 || strlen(ListName[playerid]) > 8) return ErrorMessage(playerid, "{FF6347}Количество символов в номере не больше 8-ми и не меньше 2-ух..");
			if(oGetPlayerMoney(playerid) < DP[0][playerid]) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");

			if(listitem < 0 || listitem >= MAX_MYVEHICLE) return 0;

			new slotId = List[listitem][playerid];
			new vehicleid = PlayerInfo[playerid][pMyVehID][slotId];

			if(VehInfo[vehicleid][vSost] != PlayerInfo[playerid][pID]) return ErrorMessage(playerid, "{FF6347}Ошибка! Транспорт был заспавнен или передан другому человеку");

			oGivePlayerMoney(playerid, -DP[0][playerid]);
			format(VehInfo[vehicleid][vNumer], 20, "%s",ListName[playerid]);
			format(string, sizeof(string), "{222222}%s",ListName[playerid]);
			SetVehicleNumberPlate(vehicleid, string);

			bigint_add(OrganInfo[g][glave], DP[0][playerid]);
			OrganInfo[g][gUpdate] = 1;

			GivePlayerUnit(copid, OrganInfo[g][gUnit][23] * (DP[0][playerid] / 1000));

			new line[80],lines[400];
			format(line,sizeof(line),"{ff9000}На ваш транспорт установлены новые номерные знаки"), strcat(lines,line);
			format(line,sizeof(line),"\n\n{cccccc}Стоимость: {99ff66}%d$", DP[0][playerid]), strcat(lines,line);
			format(line,sizeof(line),"\n{cccccc}Транспорт: {ff9000}%s",GetVehicleName(VehInfo[vehicleid][vModel])), strcat(lines,line);
			format(line,sizeof(line),"\n{cccccc}Новые номерные знаки: {444444}%s",ListName[playerid]), strcat(lines,line);
			format(line,sizeof(line),"\n\n{0088ff}Удачи на дорогах!"), strcat(lines,line);
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"Номерные Знаки",lines,"*","");
			PlayerPlaySound(playerid,6401,0,0,0);
			SaveCar(vehicleid);

			format(lines, sizeof(lines), "{99FF66}%s[%d] согласился установить автомобильные номера: {cccccc}[ %s ]", rpplayername(playerid), playerid, ListName[playerid]);
			SuccessMessage(copid, lines);

			{
				new log_str[64];

				format(log_str, sizeof(log_str), "Продал номера на авто: %s", VehInfo[vehicleid][vNumer]);
				OrgLog(PlayerInfo[copid][pMember], "numbercar",
					PlayerInfo[copid][pID], PlayerInfo[copid][pName], PlayerInfo[copid][pPlaIP],
					PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP],
					DP[0][playerid], log_str);

				format(log_str, sizeof(log_str), "Установил номера на авто: %s", VehInfo[vehicleid][vNumer]);
				CarLog("numbercar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], VehInfo[vehicleid][vModel], DP[0][playerid], log_str);
			
				MoneyLog("numbercar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -DP[0][playerid], log_str);
			}
		} else {
			SetNumberOfferDecline(playerid);
		}
	}
