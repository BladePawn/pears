stock PP_SetVehicleToRespawn(vehicleid)
{
    SetVehicleToRespawn(vehicleid);

	// Сбрасываем ограбление инкассатора
	if(vehicleid == collectorveh) UpdateCollectorLabel();
	
	// Скрываем самолёт
	if(vehicleid == flyveh) HidePlane();
    return 1;
}
public OnVehicleSpawn(vehicleid)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 1; // Проверка на правильность ID транспорта
	if(vehicleid == train) return 1;

	VehInfo[vehicleid][vRepairFix] = false;
	VehInfo[vehicleid][vTug] = 0;
	VehInfo[vehicleid][vSeat] = 0;
	VehInfo[vehicleid][vTestDrive] = 0;

	// Удаляем Объект с Транспорта
	if(VehInfo[vehicleid][vObjstat] >= 1) DestroyDynamicObject(VehInfo[vehicleid][vObject]), VehInfo[vehicleid][vObjstat] = 0;
	if(VehInfo[vehicleid][vRopeStat][0] > 0) DestroyDynamicObject(VehInfo[vehicleid][vRopeObj][0]), VehInfo[vehicleid][vRopeStat][0] = 0, VehInfo[vehicleid][vRope] = 0;
	if(VehInfo[vehicleid][vRopeStat][1] > 0) DestroyDynamicObject(VehInfo[vehicleid][vRopeObj][1]), VehInfo[vehicleid][vRopeStat][1] = 0;
	//============================
	// Удаляем 3D Text с Транспорта
	if(VehInfo[vehicleid][v3dstat] >= 1 && VehInfo[vehicleid][v3dstat] < 2000) DestroyDynamic3DTextLabel(VehLabel[vehicleid]), VehInfo[vehicleid][v3dstat] = 0;
	VehInfo[vehicleid][vVodila] = 9999;
	VehInfo[vehicleid][vPassajir] = 9999;
	//=============================

	// Сбрасываем Мусорку
	if(VehInfo[vehicleid][vJob] == 8) reset_trash(trash_player[VehInfo[vehicleid][vJobID]], VehInfo[vehicleid][vJobID], 1), VehInfo[vehicleid][vJob] = 0;

	// Личный Транспорт (Удаляем при спавне)
	if(Cars[vehicleid] == 88)
	{
		if(VehInfo[vehicleid][vExplosion]) VehInfo[vehicleid][vDeath] = true; // Если взорвался - значит уничтожаем
		SaveCar(vehicleid);
		SaveBoot(vehicleid);
		ACDestroyVehicle(vehicleid);
		return 1;
	}

	// Удаляем старую Аренду
	if(IsAAgetcar(vehicleid) || Cars[vehicleid] == 309 || Cars[vehicleid] == 52) return ACDestroyVehicle(vehicleid);

	// Удаляем новую Аренду
	if(Cars[vehicleid] == 53)
	{
		if(VehInfo[vehicleid][vAgetid] != 9999 && VehInfo[vehicleid][vRent] > 0) return ACDestroyVehicle(vehicleid);
	}

	// Удаляем надутую Лодку
	if(Cars[vehicleid] == 54)
	{
		new p = VehInfo[vehicleid][vAgetid];
		if(IsOnline(p))
		{
			if(OnlineInfo[p][oInflatableBoat] != NON && OnlineInfo[p][oInflatableBoat] == vehicleid) OnlineInfo[p][oInflatableBoat] = NON, set_para(p, 48, VehInfo[vehicleid][vGas]), PlayerPlaySound(p, 25801, 0,0,0);
		}
		ACDestroyVehicle(vehicleid);
		return 1;
	}

	// К транспорту прикреплён трейлер (Открепляем и удаляем его нахрен)
	if(VehInfo[vehicleid][vTrailerID] > 0) UnloadAttachedTrailer(VehInfo[vehicleid][vTrailerID] - 1);

	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective); // Берём параметры дверей движка и прочено
	SetVehicleParamsEx(vehicleid, false, false, false, false, false, false, false); // Ставим параметры дверей движка и прочено
	VehInfo[vehicleid][vEngine] = 0; // Показываем, что двигатель заглушен
	VehInfo[vehicleid][vLights] = 0; // Показываем, что фары вырублены
	VehInfo[vehicleid][vPanels] = 0;
	VehInfo[vehicleid][vDoors] = 0;
	VehInfo[vehicleid][vFara] = 0;
	VehInfo[vehicleid][vTires] = 0;
	if(VehInfo[vehicleid][vNospawn] != 2) VehInfo[vehicleid][vNospawn] = 0;

	if(vehicleid >= LSPDcar[0] && vehicleid <= LSPDcar[1] || vehicleid >= NonLSCar[0] && vehicleid <= NonLSCar[1]) SetVehicleNumberPlate(vehicleid, "{222222}SAPD"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= SFPDcar[0] && vehicleid <= SFPDcar[1] || vehicleid >= NonSFCar[0] && vehicleid <= NonSFCar[1]) SetVehicleNumberPlate(vehicleid, "{222222}SAPD"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= fbicar[0] && vehicleid <= fbicar[1]) VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= swatcar[0] && vehicleid <= swatcar[1]) SetVehicleNumberPlate(vehicleid, "{222222}SWAT"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= armcar[0] && vehicleid <= armcar[1]) SetVehicleNumberPlate(vehicleid, "{222222}NGSA"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid == janswat[0]) SetVehicleNumberPlate(vehicleid, "{222222}SWAT"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid == janswat[1]) SetVehicleNumberPlate(vehicleid, "{222222}SWAT"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid == janswat[2]) SetVehicleNumberPlate(vehicleid, "{222222}SWAT"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= cnncar[0] && vehicleid <= cnncar[1])SetVehicleNumberPlate(vehicleid, "{222222}CNN"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= Medcar[0] && vehicleid <= Medcar[1]) SetVehicleNumberPlate(vehicleid, "{222222}ASGH"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= govcar[0] && vehicleid <= govcar[1]) SetVehicleNumberPlate(vehicleid, "{222222}GOV"), VehInfo[vehicleid][vAlarmSystem] = 2;
	if(vehicleid >= Hvert[0] && vehicleid <= Hvert[7]) VehInfo[vehicleid][vAlarmSystem] = 2;

	new Float:health_veh = MaxVehicleHealth(VehInfo[vehicleid][vModel], vehicleid);
	ACSetVehicleHealth(vehicleid, health_veh);

	VehInfo[vehicleid][vExplosion] = false;
	return 1;
}

stock BigInt_Init()
{
	return 1;
}

//------------------------------------------------------------------------------------------------------
public OnGameModeInit()
{
	// Загружаем HANDLING.CFG
	ReadHandlingCFG();

	// Загружаем vehicle.ide
	ReadVehicleIDE();

	GetConsoleVarAsString("name", hostname, sizeof(hostname));
	
	if(!strcmp(hostname, "My Pears", true))
	{
		SendRconCommand("name Pears Local [ Loading ]");
 		server = 0;
		serverType = 0;
	}
	else if(!strcmp(hostname, "Test Pears", true))
	{
		SendRconCommand("name Pears Test [ Loading ]");
 		server = 0;
		serverType = 1;

		LIMITED_LOADING_SERVER = 0; // На Pears Test всегда запускаем полную загрузку
	}
	else if(!strcmp(hostname, "Pears 1", true))
	{
		SendRconCommand("name Pears Project [ Loading ]");
 		server = 1;
		serverType = 1;
		LIMITED_LOADING_SERVER = 0;
	}

	// Определяем слоты для кастомных компонентов транспорта
	VehicleCustomComponentsLoad();

	// Грузим кастомные модельки (Скины)
	AddCustomSkins();

	// Грузим кастомные модельки (Транспорт)
	AddCustomVehicle();

    new times = GetTickCount();
    ManualVehicleEngineAndLights();
    DisableInteriorEnterExits();
    EnableStuntBonusForAll(false);
    ShowPlayerMarkers(PLAYER_MARKERS_MODE:2);
    //EnableVehicleFriendlyFire();
    AntiDeAMX();
   	SetNameTagDrawDistance(50); //расстояние на котором будет виден ник игрока
   	DisableNameTagLOS(); // Нехуй видеть никнеймы сквозь стены
   	Streamer_SetVisibleItems(STREAMER_TYPE_OBJECT, 800, -1); // Ставим на лимит отображаемых объектов: 800 штук

	#if defined SAMPVOICE_COMPILE_3 
	Sampvoice3InitializationMode();
	#endif

	// Инициализация BigInt чисел
	BigInt_Init();

	protect[0] = 0; protect[1] = 0; protect[2] = 0; protect[3] = 0; protect[4] = 0; protect[5] = 0; protect[6] = 0; protect[7] = 1; protect[8] = 0; protect[9] = 0; protect[10] = 0;
	RegMaleSkin[0] = 321;
	RegMaleSkin[1] = 322;
	RegMaleSkin[2] = 326;
	RegMaleSkin[3] = 335;
	RegMaleSkin[4] = 352;
	RegMaleSkin[5] = 367;
	RegMaleSkin[6] = 403;

	RegFemaleSkin[0] = 339;
	RegFemaleSkin[1] = 344;
	RegFemaleSkin[2] = 345;
	RegFemaleSkin[3] = 366;
	RegFemaleSkin[4] = 370;
	RegFemaleSkin[5] = 371;
	RegFemaleSkin[6] = 393;
	
	DrawPosSmart_X[0] = 140.0, DrawPosSmart_Y[0] = 88.0, DrawSizeSmart_Y[0] = 10.0; // Чекер ганг зон
	DrawPosSmart_X[1] = 140.0, DrawPosSmart_Y[1] = 88.0, DrawSizeSmart_Y[1] = 10.0; // Взаимодействие
	DrawPosSmart_X[2] = -48.0, DrawPosSmart_Y[2] = -1.0, DrawSizeSmart_Y[2] = 5.0; // Название сервера
	DrawPosSmart_X[3] = -48.0, DrawPosSmart_Y[3] = 0.0, DrawSizeSmart_Y[3] = 5.0; // Время
	DrawPosSmart_X[4] = 0.0, DrawPosSmart_Y[4] = 80.0, DrawSizeSmart_Y[4] = 10.0; // Ноут и пк
	DrawPosSmart_X[5] = -40.0, DrawPosSmart_Y[5] = -20.0, DrawSizeSmart_X[5] = 10.0, DrawSizeSmart_Y[5] = 25.0; // Смартфон
	DrawPosSmart_X[6] = -76.0, DrawPosSmart_Y[6] = 48.0, DrawSizeSmart_Y[6] = 5.0; // Инвентарь 			(+)
	DrawPosSmart_X[7] = 0.0, DrawPosSmart_Y[7] = 0.0, DrawSizeSmart_Y[7] = 15.0; // Спидометр Type2
	DrawPosSmart_X[8] = 20.0, DrawPosSmart_Y[8] = 40.0, DrawSizeSmart_Y[8] = 10.0; // Buymenu
	DrawPosSmart_X[9] = 0.0, DrawPosSmart_Y[9] = 0.0, DrawSizeSmart_Y[9] = 10.0; // Подсказка двигателя
	DrawPosSmart_X[10] = 12.0, DrawPosSmart_Y[10] = 0.0, DrawSizeSmart_Y[10] = 10.0; // Скафандр кислород
	DrawPosSmart_X[13] = 56.0, DrawPosSmart_Y[13] = 0.0, DrawSizeSmart_Y[13] = 10.0; // Админский Spec

	// Police Database
	PDatabase_Initialize();

	// Раскопка могил
	Graves_Init();

	// Зелёные Зоны
	zones_zz[0] = CreateDynamicSphere(-1832.7725,11.6092,1061.1436, 5.0, 0, 0); // Временная Зона, для теста

	zones_zz[1] = CreateDynamicSphere(608.7850,-1538.1212,15.3926, 50.0, 220, 0); // Спермобанк
