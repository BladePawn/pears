alias:audio("sound")
CMD:audio(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 22) return 1;
	if(!sscanf(params, "i",params[0]))
	{
		PlayerPlaySound(playerid, params[0], 0.0, 0.0, 0.0);
		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Музло выполнено");
	}
	return 1;
}

alias:acbiz("accbiz")
CMD:acbiz(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(60, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 60, NO_FBI)) return 1;

	new b;
	if(sscanf(params, "i",b)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Одобрить установку бизнеса [ /acbiz ID ]");
	if(b < 1 || b > 200) return ErrorMessage(playerid, "{FF6347}Номер бизнеса не меньше 1 и не больше 200");
	if(BizzInfo[b][bArest] >= 1) return ErrorMessage(playerid, "{FF6347}Бизнес арестован [ Откажите в установке ]");
	if(IsBizTerminal(b))
	{
		new yesb = -1, yest = -1;
		new br = numnrent(b);
		for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
			if(RentStat[br][i] > 0 && IsPlayerInRangeOfPoint(playerid, 5.0, RentPos_X[br][i], RentPos_Y[br][i], RentPos_Z[br][i])) 
			{
				yesb = br, yest = i;
				break;
			}
		}
		if(yesb == -1 || yest == -1) return ErrorMessage(playerid, "{FF6347}Вы далеко от терминала или тележки этого бизнеса");
		if(RentStat[yesb][yest] == 1) return ErrorMessage(playerid, "{FF6347}Этот терминал или тележка не требует одобрения установки");

		RentStat[yesb][yest] = 1;
		SaveBizzTerm(yesb, yest);

		new string[160];
		format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s одобрил терминал/тележку Бизнеса № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName], b);
		SendRadioMessage(7, COLOR_ALLDEPT, string);
		OrgLog(7, "acbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", b, "Одобрил терминал/тележка");
		BizLog("acbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, yest+1, "Одобрил терминал/тележка");
		format(string, sizeof(string), "{0088ff}[ %s ]: {cccccc}%s одобрил позицию терминала/тележку № %d {99ff66}%s [%d]", getNameRank(playerid), PlayerInfo[playerid][pName], yest+1, bizname(b), b);
		SendBizzMessage(b, string);

		PlayerPlaySound(playerid,6401,0,0,0);
		GiveUnit(playerid, 9);
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Терминал/тележка одобрена");
		return 1;
	}
	else
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]))
		{
			new bcity = getbiz_city(b);
			if(bcity == 0
				&& (IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -3000, -3000.0, -1236, 1623) // SF - city
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -1236, -3000, 39, -369) // SF - village
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -3000, 1623, 3000, 3000) // LV - 1
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -1236, 597, 3000, 1623)) // LV - 2
					) return ErrorMessage(playerid, "{FF6347}Бизнес привязан к LS и не может располагаться в другом городе [ Откажите в установке ]");
			if(bcity == 1
				&& (IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -1236, -370, 3000, 598) // LS 2
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], 40, -3000, 3000, -369) // LS 1
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -3000, 1623, 3000, 3000) 
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -1236, 597, 3000, 1623))) return ErrorMessage(playerid, "{FF6347}Бизнес привязан к SF и не может располагаться в другом городе [ Откажите в установке ]");
			if(bcity == 2
				&& (IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -1236, -370, 3000, 598) || IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], 40, -3000, 3000, -369)
					|| IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -3000, -3000.0, -1236, 1623) || IsPosInSquare(BizzInfo[b][bEnterX],BizzInfo[b][bEnterY], -1236, -3000, 39, -369))) return ErrorMessage(playerid, "{FF6347}Бизнес привязан к LV и не может располагаться в другом городе [ Откажите в установке ]");

			if(BizzInfo[b][bStat] != 1) return ErrorMessage(playerid, "{FF6347}Этот бизнес не требует одобрения установки");
			if(BizzInfo[b][bLab] == 0) return ErrorMessage(playerid, "{FF6347}В бизнесе не установлена физическая точка [ Откажите в установке ]");

			BizzInfo[b][bStat] = 0;
			SaveBizz(b);

			new string[160];
			format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s одобрил Бизнес № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName],b);
			SendRadioMessage(7, COLOR_ALLDEPT, string);
			OrgLog(7, "acbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", b, "Одобрил Перенос");
			BizLog("acbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, 0, "Одобрил Перенос");
			format(string, sizeof(string), "{0088ff}[ %s ]: {cccccc}%s одобрил открытие бизнеса {99ff66}%s [%d]", getNameRank(playerid), PlayerInfo[playerid][pName], bizname(b), b);
			SendBizzMessage(b, string);

			PlayerPlaySound(playerid,6401,0,0,0);
			GiveUnit(playerid, 9);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Бизнес одобрен");
			return 1;
		}
		else ErrorMessage(playerid, "{FF6347}Вы далеко от бизнеса");
	}
 	return 1;
}

CMD:denybiz(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(60, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник Правительства");
	if(!GetAccessRankOrg(playerid, g, 60, NO_FBI)) return 1;

	new b, reason[64];
	if(sscanf(params, "is[64]",b,reason)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Отказать в установке бизнеса [ /denybiz ID Причина ]");
	if(b < 1 || b > 200) return ErrorMessage(playerid, "{FF6347}Номер бизнеса не меньше 1 и не больше 200");
	if(BizzInfo[b][bArest] >= 1) return ErrorMessage(playerid, "{FF6347}Бизнес арестован [ Откажите в установке ]");
	if(checksimvol(reason)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");

	if(IsBizTerminal(b))
	{
		new yesb = -1, yest = -1;
		new br = numnrent(b);
		for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
			if(RentStat[br][i] > 0 && IsPlayerInRangeOfPoint(playerid, 5.0, RentPos_X[br][i], RentPos_Y[br][i], RentPos_Z[br][i])) yesb = br, yest = i;
		}
		if(yesb == -1 || yest == -1) return ErrorMessage(playerid, "{FF6347}Вы далеко от терминала или тележки этого бизнеса");
		
		// 0 нет биза
		// 1 одобрен
		// 2 на проверке
		// 3 отказан

		new string[200];
		if(RentStat[yesb][yest] == 2)
		{
			format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s отказал в установке терминала/тележки Бизнеса № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName],b);
			SendRadioMessage(7, COLOR_ALLDEPT, string);
			OrgLog(7, "denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", b, "Отказал Терминал");
			BizLog("denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, yest+1, "Отказал Терминал");
			format(string, sizeof(string), "{0088ff}[ %s ]: {cccccc}%s отказал в установке терминала/тележки № %d {FF6347}%s [%d], {cccccc}Причина: %s", getNameRank(playerid), PlayerInfo[playerid][pName], yest+1, bizname(b), b, reason);
			SendBizzMessage(b, string);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Отказано в установке терминала");
		}
		else if(RentStat[yesb][yest] == 1)
		{
			format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s отозвал одобрение терминала/тележки Бизнеса № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName],b);
			SendRadioMessage(7, COLOR_ALLDEPT, string);
			OrgLog(7, "denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", b, "Отозван Терминал");
			BizLog("denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, yest+1, "Отозван Терминал");
			format(string, sizeof(string), "{0088ff}[ %s ]: {cccccc}%s отозвал одобрение терминала/тележки № %d {FF6347}%s [%d], {cccccc}Причина: %s", getNameRank(playerid), PlayerInfo[playerid][pName], yest+1, bizname(b), b, reason);
			SendBizzMessage(b, string);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Отозвано одобрение терминала/тележки");
		}
		PlayerPlaySound(playerid,6401,0,0,0);
		GiveUnit(playerid, 9);
		
		RentStat[yesb][yest] = -1;
		DestroyDynamicObject(RentObject[yesb][yest]);
		RentObject[yesb][yest] = 0;
		DestroyDynamic3DTextLabel(RentLabel[yesb][yest]);
		format(BizzInfo[b][bStatReason], 64, reason);
		SaveBizz(b);
		SaveBizzTerm(yesb, yest);
		return 1;
	}
	else
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]))
		{
			if(BizzInfo[b][bStat] == 2) return ErrorMessage(playerid, "{FF6347}Этот бизнес не требует одобрения установки");

			new string[200];
			if(BizzInfo[b][bStat] == 1)
			{
				format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s отказал в установке Бизнеса № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName],b);
				SendRadioMessage(7, COLOR_ALLDEPT, string);
				OrgLog(7, "denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", b, "Отказал Перенос");
				BizLog("denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, 0, "Отказал Перенос");
				format(string, sizeof(string), "{0088ff}[ %s ]: {cccccc}%s отказал в открытии бизнеса {FF6347}%s [%d], {cccccc}Причина: %s", getNameRank(playerid), PlayerInfo[playerid][pName], bizname(b), b, reason);
				SendBizzMessage(b, string);
				notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Отказано в установке бизнеса");
			}
			else if(BizzInfo[b][bStat] == 0)
			{
				format(string, sizeof(string), "{FFFFFF}** [%s] {00C6FF}%s отозвал одобрение Бизнеса № {ffffff}%d **", getNameRank(playerid), PlayerInfo[playerid][pName],b);
				SendRadioMessage(7, COLOR_ALLDEPT, string);
				OrgLog(7, "denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", b, "Отозвал Бизнес");
				BizLog("denybiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, 0, "Отозвал Бизнес");
				format(string, sizeof(string), "{0088ff}[ %s ]: {cccccc}%s отозвал одобрение бизнеса {FF6347}%s [%d], {cccccc}Причина: %s", getNameRank(playerid), PlayerInfo[playerid][pName], bizname(b), b, reason);
				SendBizzMessage(b, string);
				notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Отозвано одобрение бизнеса");
			}
			PlayerPlaySound(playerid,6401,0,0,0);
			GiveUnit(playerid, 9);
			
			BizzInfo[b][bStat] = 2;
			format(BizzInfo[b][bStatReason], 64, reason);
			SaveBizz(b);
			return 1;
		}
		else ErrorMessage(playerid, "{FF6347}Вы далеко от бизнеса");
	}
 	return 1;
}
CMD:mz(playerid)
{
	if(PlayerInfo[playerid][pLeader] == 4 || PlayerInfo[playerid][pMember] == 4 || PlayerInfo[playerid][pSoska] >= 10)
	{
    	ShowDialog(playerid,1486,DIALOG_STYLE_LIST,"{ff9000}Мин.Здрав","{cccccc}Психически больные\n{cccccc}Список вызовов","Выбор","Отмена");
	}
	return 1;
}

alias:goverment("government")
CMD:goverment(playerid)
{
	if(PlayerInfo[playerid][pLeader] == 7 || PlayerInfo[playerid][pMember] == 7 || PlayerInfo[playerid][pSoska] >= 10)
	{
    	new line[40],lines[160];
    	format(line,sizeof(line),"{ff9000}Бизнесы Штата"), strcat(lines,line);
    	format(line,sizeof(line),"\n{99ff66}Министерство Финансов"), strcat(lines,line);
		format(line,sizeof(line),"\n{cccccc}Автобусные Остановки"), strcat(lines,line);
		format(line,sizeof(line),"\n{cccccc}Автобусные Маршруты"), strcat(lines,line);
		format(line,sizeof(line),"\n{cccccc}Судебные Дела"), strcat(lines,line);
    	ShowDialog(playerid,1147,DIALOG_STYLE_LIST,"{ff9000}Правительство",lines,"Выбор","Отмена");
	}
	return 1;
}
CMD:boom(playerid)
{
	new g = fraction(playerid);
	if(PlayerInfo[playerid][pLeader] == 3 || PlayerInfo[playerid][pMember] == 3)
	{
		if(!IsAFunctionOrganization(74, g, playerid)) return ErrorMessage(playerid, "{FF6347}Управление Атомной бомбой недоступно для вашей организации");
		if(!GetAccessRankOrg(playerid, g, 74, NO_FBI)) return 1;
    	new str[100],sctring[400];
    	if(Yaderstat == 0) format(str,sizeof(str),"{FF6347}Ядерный Удар\n"), strcat(sctring,str);
    	else if(Yaderstat == 1) format(str,sizeof(str),"{99ff66}Ядерный Удар\n"), strcat(sctring,str);
    	else if(Yaderstat == 2) format(str,sizeof(str),"{444444}Ядерный Удар {FF6347}[Отменить Запуск]\n"), strcat(sctring,str);
    	else if(Yaderstat >= 3) format(str,sizeof(str),"{444444}Ядерный Удар\n"), strcat(sctring,str);
    	if(Yaderstat == 2) format(str,sizeof(str),"{cccccc}Точка Удара {99ff66}[ Установлена ]\n"), strcat(sctring,str);
    	else if(Yaderstat <= 1 || Yaderstat >= 3) format(str,sizeof(str),"{cccccc}Точка Удара\n"), strcat(sctring,str);
    	if(Yaderstat == 2) format(str,sizeof(str),"{cccccc}Поиск Точки Удара\n"), strcat(sctring,str);
    	ShowDialog(playerid,570,DIALOG_STYLE_LIST,"{444444}Ядерное Оружие {ff9000}[ /boom ]",sctring,"Выбор","Отмена");
	}
	return 1;
}
CMD:loc(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] > 0 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] > 0)
	{
	    if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепортироваться в локацию [ /loc 1 - 157 ]");
		if(params[0] > 157 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер локации не меньше 1 и не больше 157");
