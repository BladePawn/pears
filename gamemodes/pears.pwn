			if(GZInfo[z][gFrakVlad] == 14) zgang[1] ++;
			if(GZInfo[z][gFrakVlad] == 15) zgang[2] ++;
			if(GZInfo[z][gFrakVlad] == 16) zgang[3] ++;
		}

		format(str,sizeof(str)," \t{00cc00}Grove Street {9900cc}Ballas Gang\t{ffcc33}Vagos Gang {00ffff}Los Aztecas"), strcat(sctring,str);

