stock ShowAnimation(playerid, stat,infa)
{
		if(Kapt[fraction(playerid)] >= 1 && fraction(playerid) >= 1) return 1;
		if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в транспорте");
		if(GetPlayerState(playerid) == PLAYER_STATE_ENTER_VEHICLE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я сажусь в транспорт");
		if(GetPlayerState(playerid) == PLAYER_STATE_ENTER_VEHICLE_PASSENGER) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я сажусь в транспорт");
		if(InputID[playerid] >= 1) return 1;
		if(NoAnim[playerid] != 0) return 1;
		if(infa == 1){} //NoAnim[playerid] = 1;
		switch(stat)
	    {
	        case 1:{ SetPlayerSpecialAction(playerid,SPECIAL_ACTION_HANDSUP); }
	        case 2:{ ApplyAnimation(playerid,"PED", "WALK_DRUNK",4.1, false, true, false, false, false, SYNC_ALL); }
