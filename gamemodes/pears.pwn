alias:pursuit("p", "pt", "pr")
CMD:pursuit(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(32, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник правоохранительных органов");
	if(!GetAccessRankOrg(playerid, 2, 32, PlayerInfo[playerid][pFbi])) return 1;

	if(howstun(playerid)) return ErrorMessage(playerid,"{FF6347}Вашему персонажу плохо");
	new playa;
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Начать преследование преступника [ /pursuit ID ]");
	if(strlen(params[0]) > 20) return ErrorMessage(playerid,"{FF6347}Слишком длинное имя.. [ Лимит 20 символов ]");
	playa = ReturnUser(params[0]);
	if(!IsOnline(playa)) return ErrorMessage(playerid,"{FF6347}Игрока нет на сервере");
	if(PlayerInfo[playa][pCrimes] == 0) return ErrorMessage(playerid,"{FF6347}Подозреваемый не находится в розыске");
	if(IsACapt(playa)) return ErrorMessage(playerid,"{FF6347}Подозреваемый находится в гетто\n{ffcc66}Работа на капте запрещена");
	
	if(!ProxDetectorS(80.0, playerid, playa)) return ErrorMessage(playerid,"{FF6347}Подозреваемый находится далеко от вас [ Минимум 80 метров ]");
	if(GetPVarInt(playa,"afksystem") >= 5) return ErrorMessage(playerid,"{FF6347}Игрок AFK");
	if(PlayerInfo[playa][pJailed] >= 1) return ErrorMessage(playerid,"{FF6347}Преступник находится под заключением");

	CreatePlayerPursuit(playa, playerid);

	// Сообщение по радиоперехватчику
	{
		new string[144];
		new findraiontolist = FindRaionPos(Protect_X[playa], Protect_Y[playa], Protect_Z[playa]);
		format(string, sizeof(string), "Сообщение о начале преследования: %s [Район: %s]", rpplayername(playa), gSAZones[findraiontolist][zName]);
		RadioInterceptor_SendMessage(RADIO_INTERCEPTOR_STATE_CUFF, 0xFFDEADFF, string, .excludeid = playa);
	}

	return 1;
}
CMD:mute(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    new playa,tmp[24],string[144], mtime;
	if(sscanf(params, "s[24]is[64]",tmp,mtime,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать бан чата [ /mute ID Минуты причина ]");
	if(checksimvol(params[1])) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	playa = ReturnUser(tmp, 1);
	if(IsOnline(playa))
	{
		if(PlayerInfo[playa][pMuteTime] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже мут [ /unmute Снять Мут ]");
		if(PlayerInfo[playerid][pSex] == 1) format(string, sizeof(string), "[PP]: %s выдал мут %s на %d минут, причина: %s",PlayerInfo[playerid][pName], PlayerInfo[playa][pName], mtime, params[1]);
		else format(string, sizeof(string), "[PP]: %s выдала мут %s на %d минут, причина: %s",PlayerInfo[playerid][pName], PlayerInfo[playa][pName], mtime, params[1]);
		AllMessage(COLOR_LIGHTRED,string);
		format(string, sizeof(string), "Вы получили мут от %s, на %d минут, причина: %s", PlayerInfo[playerid][pName], mtime, params[1]);
		SendClientMessage(playa, COLOR_LIGHTRED, string);

		PlayerInfo[playa][pMuteTime] = mtime*60;

		#if defined SAMPVOICE_COMPILE_3
		SampvoiceStopTalking(playa);
		#endif

		AdminLog("mute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], mtime, params[1]);
		AddWrong(playerid, 2, PlayerInfo[playa][pName],params[1]);
		work_admin(playerid, 14);
		SendClientMessage(playa, COLOR_GREY, "{0088ff}[ Server ]: {cccccc}Не хотите молчать? Вы всегда можете отменить все баны чата досрочно {ffcc00}[ Y >> Донат или /donate ]");
		update_admpoint(playerid, ServerInfo[17]);
	}
	else
 	{
 		if(PlayerInfo[playerid][pSoska] <= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне запрещено выдавать мут Offline [ Только для администраторов ]");
  		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, params[1],9,mtime);
    	return 1;
	}
	return 1;
}
CMD:unmute(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 6) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить действие");
	new playa,string[144];
	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять мут [ /unmute ID ]");
	playa = ReturnUser(params[0], 1);
	if(IsOnline(playa))
	{
		if(PlayerInfo[playa][pMuteTime] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него нет мута");
		PlayerInfo[playa][pMuteTime] = 0;
		PlayerInfo[playa][pFmuteTime] = 0;
		format(string, sizeof(string), " [ ADM ]: %s снял мут с %s",PlayerInfo[playerid][pName], PlayerInfo[playa][pName]);
		ABroadCast(COLOR_ADM,string,1);
		format(string, sizeof(string), "  Администратор %s снял ваш мут", PlayerInfo[playerid][pName]);
		SendClientMessage(playa, COLOR_GREY, string);
		AdminLog("unmute", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], 0, "");
	}
	else
 	{
  		if(!CheckRP_Nickname(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
    	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", params[0]);
  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, params[0], params[0],34,0);
    	return 1;
	}
	return 1;
}

alias:skick("tkick")
CMD:skick(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 10 && PlayerInfo[playerid][pHidden] == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Тихо кикнуть [ /skick ID ]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(IsARealNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Это NPC");
	if(PlayerInfo[params[0]][pSoska] >= PlayerInfo[playerid][pSoska] && OnlineInfo[params[0]][oLogged] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя кикать руководство");
	DP[0][playerid] = params[0];
	new string[154];
	format(string, sizeof(string), "{FF6347}Вы уверены, что хотите тихо кикнуть %s [%d] ?\n\nElon_Musk: подумай два раза. Надо ли оно тебе? Я не советую баловаться",PlayerInfo[params[0]][pName], params[0]);
	ShowDialog(playerid,1166,DIALOG_STYLE_MSGBOX,"{ff9000}Тихий Кик",string,"Да","Нет");
	return 1;
}

CMD:kick(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить действие");
    new para1,string[144],tmp[24],result[64];
	if(sscanf(params, "s[24]s[64]", tmp, result)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кикнуть игрока [ /kick ID причина ]");
	if(checksimvol(result)) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
	para1 = ReturnUser(tmp, 1);
	if(!IsPlayerConnected(para1)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(IsARealNPC(para1)) return ErrorMessage(playerid, "{FF6347}Это NPC");
	if(PlayerInfo[para1][pSoska] >= PlayerInfo[playerid][pSoska] && OnlineInfo[para1][oLogged] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя кикнуть администратора вашего уровня или выше");

	// Антипидор
	if(AntiPidor(playerid, 11)) return 1;

	format(string, sizeof(string), "[PP]: %s кикнул %s, причина: %s", PlayerInfo[playerid][pName], PlayerInfo[para1][pName], result);
	AllMessage(COLOR_LIGHTRED, string);
	format(string, sizeof(string), "{ffcc00}Вы были кикнуты администратором %s по причине: %s", PlayerInfo[playerid][pName], result);
	SendClientMessage(para1, COLOR_LIGHTRED, string);
	format(string, sizeof(string),"{FFcc00}Вы были кикнуты администратором %s \n{0088ff}Причина: {FFcc00}%s",PlayerInfo[playerid][pName], result);
 	ShowDialog(para1,1700, 0, "******* {FFcc00}*Вы были Кикнуты* {FFFFFF}*******", string, "Ок", "");
  	PlayerInfo[playerid][pWorked3] ++;
	AdminLog("kick", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, result);
	Kickx(para1);
	work_admin(playerid, 15);
	update_admpoint(playerid, ServerInfo[18]);
	return 1;
}
CMD:name(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить действие");
    new para1,string[254],tmp[24];
	if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кикнуть игрока с NonRP Nick Name [ /name ID ]");
	para1 = ReturnUser(tmp, 1);
	if(!IsOnline(para1)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(IsARealNPC(para1)) return ErrorMessage(playerid, "{FF6347}Это NPC");
	if(PlayerInfo[para1][pSoska] >= PlayerInfo[playerid][pSoska] && OnlineInfo[para1][oLogged] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя кикнуть администратора вашего уровня или выше");
	if(PlayerInfo[para1][pLevel] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он уже давно играет [ Кураторы обязаны сменить никнейм игроку /rename ]");
	if(PlayerInfo[para1][pNewname] == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок уже отправил заявку на смену никнейма");
	
	// Антипидор
	if(AntiPidor(playerid, 11)) return 1;
	
	format(string, sizeof(string), "{ffcc00}Вы были кикнуты администратором %s по причине: NonRP Nick Name", PlayerInfo[playerid][pName]);
	SendClientMessage(para1, COLOR_LIGHTRED, string);
	SendClientMessage(para1, COLOR_LIGHTRED, "{ffcc00}Вы можете сменить свой никнейм бесплатно {ff9000}[ /donate >> Услуги Аккаунта >> Сменить Ник-Нейм ]");
	format(string, sizeof(string),"{FFcc00}Вы были кикнуты администратором %s \n{0088ff}Причина: {FFcc00}NonRP Nick Name\n\n{ffcc00}Вы можете сменить свой никнейм бесплатно {ff9000}[ /donate >> Услуги Аккаунта >> Сменить Ник-Нейм ]",PlayerInfo[playerid][pName]);
 	ShowDialog(para1,1700, 0, "******* {FFcc00}*Вы были Кикнуты* {FFFFFF}*******", string, "Ок", "");
 	if(PlayerInfo[playerid][pSoska] == 1)
    {
  		format(string, sizeof(string), " [ ADM ]: Хелпер %s кикнул %s [ NonRP NickName ]",PlayerInfo[playerid][pName] ,PlayerInfo[para1][pName]);
  		ABroadCast(COLOR_ADM,string,1);
	}
	else if (PlayerInfo[playerid][pSoska] >= 2)
 	{
  		format(string, sizeof(string), " [ ADM ]: Администратор %s кикнул %s [ NonRP NickName ]",PlayerInfo[playerid][pName] ,PlayerInfo[para1][pName]);
  		ABroadCast(COLOR_ADM,string,1);
	}
  	PlayerInfo[playerid][pWorked3] ++;
	AdminLog("name", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "NonRP NickName");
	Kickx(para1);
	work_admin(playerid, 15);
	update_admpoint(playerid, ServerInfo[18]);
	return 1;
}
CMD:reloadbans(playerid, const params[])
{
 	if(PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить команду");
 	new string[84];
	format(string, sizeof(string), " [ ADM ]: %s перезагружает SAMP.BAN",PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
	SendRconCommand("reloadbans");
	return 1;
}
CMD:reloadlog(playerid)
{
 	if(PlayerInfo[playerid][pSoska] >= 20)
	{
		new string[144];
        format(string, sizeof(string), " [ ADM ]: %s перезагружает SERVER_LOG",PlayerInfo[playerid][pName]);
   		ABroadCast(COLOR_ADM,string,1);
   	    SendRconCommand("reloadlog");
	    AdminLog("reloadlog", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "");
