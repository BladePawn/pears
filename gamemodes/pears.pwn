	case 116:
	{
	    if(response)
        {
        	if(DP[1][playerid] == 0) return 0;

            PlayerInfo[playerid][pMember] = DP[1][playerid];
			PlayerInfo[playerid][pRank] = 1;
			ResetPlayerContinentalCoins(playerid);
			PlayerInfo[playerid][pUnit] = 0;
			PlayerInfo[playerid][pVig] = 0;
			resetPlayerTransmitter(playerid); // Сбрасываем чтение раций
			mysql_save(playerid, 41);
			DelUpdate(playerid);
        	Onli[DP[1][playerid]] ++;

			if(PlayerInfo[playerid][pHidden] == 0) InvitePlayerBridge(PlayerInfo[playerid][pID], PlayerInfo[playerid][pMember]);

			// Загружаем личные сохранения капта
			if(IsAGangCapt(playerid)) OnLoadPlayerCapt(playerid);

			// Отображение капта
        	if(Kapt[fraction(playerid)] >= 1) GiveUpdate(playerid, Kapt[fraction(playerid)]);

			// Ачкивки
			if(DP[1][playerid] == 1 || DP[1][playerid] == 11 || DP[1][playerid] == 21) // Вступил в Полицию
			{
			    if(PlayerInfo[playerid][pAchieve][47] == 0) AchievePlayer(playerid, 47, 1);
			}
			else if(DP[1][playerid] == 2) // Вступил в FBI
			{
				if(PlayerInfo[playerid][pAchieve][63] == 0) AchievePlayer(playerid, 63, 1);
			}
			else if(DP[1][playerid] == 3) // Вступил в Army
			{
				if(PlayerInfo[playerid][pAchieve][64] == 0) AchievePlayer(playerid, 64, 1);
			}
			else if(DP[1][playerid] == 4) // Стал доктором
			{
				if(PlayerInfo[playerid][pAchieve][52] == 0) AchievePlayer(playerid, 52, 1);
			}
			else if(DP[1][playerid] == 7) // Вступил в правительство
   			{
				if(PlayerInfo[playerid][pAchieve][67] == 0) AchievePlayer(playerid, 67, 1);
				if(DP[4][playerid] >= 0 && PartieInfo[0][partieSlots][DP[4][playerid]] > 0)
				{
					PlayerInfo[playerid][pDivision][0] = 1;
					PlayerInfo[playerid][pDivRank][0] = 1;
					mysql_SaveDivision(PlayerInfo[playerid][pID], 0, PlayerInfo[playerid][pDivision][0], PlayerInfo[playerid][pDivRank][0]);
					PartieInfo[0][partieSlots][DP[4][playerid]] -= 1;
					SaveParties();
				}
			}
			else if(DP[1][playerid] == 8) // Вступил в Hitman Agency
			{
				if(PlayerInfo[playerid][pAchieve][5] == 0) AchievePlayer(playerid, 5, 1);
			}
			else if(DP[1][playerid] == 9) // Вступил в CNN
   			{
				if(PlayerInfo[playerid][pAchieve][68] == 0) AchievePlayer(playerid, 68, 1);
			}
			else if(DP[1][playerid] == 13 || DP[1][playerid] == 14 || DP[1][playerid] == 15 || DP[1][playerid] == 16 || DP[1][playerid] == 17) // Вступил в Банду
			{
				if(PlayerInfo[playerid][pAchieve][50] == 0) AchievePlayer(playerid, 50, 1);
			}
			else if(DP[1][playerid] == 5 || DP[1][playerid] == 6 || DP[1][playerid] == 10 || DP[1][playerid] == 12 || DP[1][playerid] == 18) // Вступил в Мафию
			{
				if(PlayerInfo[playerid][pAchieve][51] == 0) AchievePlayer(playerid, 51, 1);
			}

			LaborLog(DP[1][playerid], "invite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pRank], "");
		}
		return true;
	}
