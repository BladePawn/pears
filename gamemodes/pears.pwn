// Создаём описание игрока
stock CreatePame(playerid)
{
	new Float:X,Float:Y,Float:Z;
	GetPlayerPos(playerid, X,Y,Z);
	PameLabel[playerid] = CreateDynamic3DTextLabel(" ",0xfaf75c99,X,Y,Z, 5.0, playerid, INVALID_VEHICLE_ID, 1);
	UpdatePameLabel(playerid);
	return true;
}

// Обновляем текст описание игрока
stock UpdatePameLabel(playerid)
{
    new numtext1 = strlen(PameText[playerid]), numtext2 = strlen(PameText2[playerid]), string[184];
    if(numtext1 > 0 && numtext2 > 0) format(string,sizeof(string),"\n\n\n\n\n%s\n%s", PameText[playerid], PameText2[playerid]);
	else if(numtext1 > 0 && numtext2 <= 0) format(string,sizeof(string),"\n\n\n\n\n%s", PameText[playerid]);
	else if(numtext2 > 0 && numtext1 <= 0) format(string,sizeof(string),"\n\n\n\n\n%s", PameText2[playerid]);
	UpdateDynamic3DTextLabelText(PameLabel[playerid],0xfaf75c99,string);
	return 1;
}

stock reset_textdraw(playerid, stat)
{
	new yes;
	if(stat == 0 && (set_pos_x[playerid] != 0.0 || set_pos_y[playerid] != 0.0)) set_pos_x[playerid] = 0.0, set_pos_y[playerid] = 0.0, yes = 1; // Pos
	else if(stat == 1 && (set_size_x[playerid] != 0.0 || set_size_y[playerid] != 0.0)) set_size_x[playerid] = 0.0, set_size_y[playerid] = 0.0, yes = 1; // Size
	if(yes == 1)
	{
		PlayerPlaySound(playerid,6801,0,0,0);
	    if(setting_pos_draw[playerid] > 0) reset_draw(playerid, setting_pos_draw[playerid]-1);
	    else if(setting_size_draw[playerid] > 0)  reset_draw(playerid, setting_size_draw[playerid]-1);
	}
	return 1;
}
stock exit_textdraw(playerid, stat)
{
    setting_pos_draw[playerid] = 0, setting_size_draw[playerid] = 0;
    if(stat == 1)
    {
    	PlayerInfo[playerid][pDrawPos_X][DP[0][playerid]] = set_pos_x[playerid];
    	PlayerInfo[playerid][pDrawPos_Y][DP[0][playerid]] = set_pos_y[playerid];
    	PlayerInfo[playerid][pDrawSize_X][DP[0][playerid]] = set_size_x[playerid];
    	PlayerInfo[playerid][pDrawSize_Y][DP[0][playerid]] = set_size_y[playerid];
    	PlayerPlaySound(playerid,6401,0,0,0);
    	PlayerInfo[playerid][pDrawUpdate][DP[0][playerid]] = true;
   	}
   	else PlayerPlaySound(playerid,17000,0,0,0);
    TogglePlayerControllable(playerid,true);
    if(DP[0][playerid] == 0) // Чекер битв
    {
	    PosGangDraw(playerid);
		for(new i = 0; i < 17; i++) PlayerTextDrawHide(playerid, PlayerGangDraw[i][playerid]);
        
        // Если сейчас капт
        if(Kapt[fraction(playerid)] >= 1) GiveUpdate(playerid, Kapt[fraction(playerid)]);
        
        // Если сейчас порт
        if(PortInfo[wStat] >= 1)
    	{
			if(IsMafiaMember(playerid) && PortInfo[wTwo] >= 1 && PortInfo[wTwo] == fraction(playerid)) show_mafiabattle(playerid);
    	}
    	
    	// Если сейчас стрела
    	if(MafGz[0][mStat] > 0)
    	{
			if(fraction(playerid) == MafGz[0][mNapad]) GiveMaf(playerid, 0, MafGz[0][mZashita]);
			if(fraction(playerid) == MafGz[0][mZashita]) GiveMaf(playerid, 0, MafGz[0][mNapad]);
		}
    }
    else if(DP[0][playerid] == 1) // Меню взаимодействия
    {
        PosInterDraw(playerid);
		for(new i = 0; i < 5; i++) PlayerTextDrawHide(playerid, PlaInter[i][playerid]);
	}
	else if(DP[0][playerid] == 2) // Название сервера
    {
        PosSiteDraw(playerid);
        PlayerTextDrawHide(playerid, PlayerSiteDraw[2][playerid]);
        PlayerTextDrawHide(playerid, PlayerSiteDraw[3][playerid]);
        if(PlayerInfo[playerid][pDrawVisible][2] == false) showsiteserver(playerid);
        else PlayerTextDrawHide(playerid, PlayerSiteDraw[0][playerid]), PlayerTextDrawHide(playerid, PlayerSiteDraw[1][playerid]);
    }
    else if(DP[0][playerid] == 3) // Время
    {
        PosTimeDraw(playerid);
        if(PlayerInfo[playerid][pDrawVisible][3] == false) showtimeserver(playerid);
        else PlayerTextDrawHide(playerid, PlayerSiteDraw[4][playerid]);
    }
    else if(DP[0][playerid] == 4) // Ноутбук
    {
        PosPcDraw(playerid);
		for(new i = 0; i < 26; i++) PlayerTextDrawHide(playerid, PlayerPcDraw[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerPcDraw[i][playerid]);
	}
	else if(DP[0][playerid] == 5) // Смартфон
    {
        PosSmartDraw(playerid);
        for(new mob = 0; mob < MAX_SMARTFON_DRAW; mob++) PlayerTextDrawHide(playerid, PlayerSmartDraw[mob][playerid]), PlayerTextDrawDestroy(playerid, PlayerSmartDraw[mob][playerid]);
	}
	else if(DP[0][playerid] == 6) // Инвентарь
    {
        if(DrawInvent[playerid] == true) CloseFrisk(playerid);
	}
	else if(DP[0][playerid] == 7) // Спидометр
    {
        PosSpeedDraw(playerid);
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            if(DrawSpeed[playerid] == true)
			{
				CloseVehSpeed(playerid);
				ShowVehSpeed(playerid);
			}
        }
        else
		{
		    if(DrawSpeed[playerid] == true) CloseVehSpeed(playerid);
  		}
    }
    else if(DP[0][playerid] == 8) // Меню покупок
    {
        PosBuymenuDraw(playerid);
        closeshop(playerid);
	}
	else if(DP[0][playerid] == 9) // Подсказка двигателя
    {
     	PosHintDraw(playerid);
   		if(PlayerInfo[playerid][pDrawVisible][9] == false && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && VehInfo[GetPlayerVehicleID(playerid)][vEngine] == 0) show_hint_player(playerid, GetPlayerVehicleID(playerid));
    	else HideOldHint(playerid);
    }
    else if(DP[0][playerid] == 10) // Кислород в скафандре
    {
        if(PlayerInfo[playerid][pDrawVisible][10] == false && gSkafandr[playerid] > 0) oxygen_update(playerid, gOxygen[playerid]);
        else
        {
            if(DrawOxygen[playerid] == true)
            {
            	PlayerTextDrawHide(playerid, OxygenDraw[0][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[1][playerid]), PlayerTextDrawHide(playerid, OxygenDraw[2][playerid]);
				PlayerTextDrawDestroy(playerid, OxygenDraw[0][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[1][playerid]), PlayerTextDrawDestroy(playerid, OxygenDraw[2][playerid]);
				DrawOxygen[playerid] = false;
			}
    	}
    }
    else if(DP[0][playerid] == 13) // Админ слежка
    {
        if(LoadSP[playerid] == true)
        {
    		PosSpecDraw(playerid);
    		for(new i = 0; i < 31; i ++) PlayerTextDrawHide(playerid, PlayerSpecDraw[i][playerid]), PlayerTextDrawDestroy(playerid, PlayerSpecDraw[i][playerid]);
    		LoadSP[playerid] = false;
  		}
    }
    
    
    
    if(OnlineInfo[playerid][oShowInterface] == 0) ShowSmartfon(playerid);
    pc_cmd_textdraw(playerid);
    TextDrawHideForPlayer(playerid, WasdDraw[0]);
    TextDrawHideForPlayer(playerid, WasdDraw[1]);
    TextDrawHideForPlayer(playerid, WasdDraw[2]);
    TextDrawHideForPlayer(playerid, WasdDraw[3]);
    TextDrawHideForPlayer(playerid, WasdDraw[4]);
    return 1;
}
