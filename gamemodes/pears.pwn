		{
			noooc2 = 0; SendClientMessageToAll(COLOR_GRAD2, "   Общий чат (/oo) отключён админом  !");
			new string[128];
    		format(string, sizeof(string), " [ ADM ]: Админ %s отключил общий чат /oo", PlayerInfo[playerid][pName]);
    		ABroadCast(COLOR_ADM,string,1);
		}
		else
		{
			noooc2 = 1; SendClientMessageToAll(COLOR_GRAD2, "   Общий чат (/oo) включен админом  !");
			new string[128];
			format(string, sizeof(string), " [ ADM ]: Админ %s включил общий чат /oo", PlayerInfo[playerid][pName]);
    		ABroadCast(COLOR_ADM,string,1);
		}
	}
	return 1;
}
CMD:noooc(playerid, const params[])
{
	if (PlayerInfo[playerid][pSoska] >= 3 && (!noooc))
	{
		noooc = 1; SendClientMessageToAll(COLOR_GRAD2, "   Общий чат включён админом  !");
		new string[128];
    	format(string, sizeof(string), " [ ADM ]: Админ %s включил общий чат /o", PlayerInfo[playerid][pName]);
    	ABroadCast(COLOR_ADM,string,1);
	}
	else if(PlayerInfo[playerid][pSoska] >= 3 && (noooc))
	{
		noooc = 0; SendClientMessageToAll(COLOR_GRAD2, "   Общий чат отключён админом  !");
		new string[128];
    	format(string, sizeof(string), " [ ADM ]: Админ %s отключил общий чат /o", PlayerInfo[playerid][pName]);
    	ABroadCast(COLOR_ADM,string,1);
	}
	return 1;
}
CMD:animinfo(playerid)
{
	if(NoAnim[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя использовать во время анимации [ Л.К.М. или Завершите действие ]");
    PlayerPlaySound(playerid,40405,0,0,0);
    new str[100],sctring[1200];
    // Исправление
    if(AnimInfo[0][playerid] >= 207) AnimInfo[0][playerid] = 0;
    if(AnimInfo[1][playerid] >= 207) AnimInfo[1][playerid] = 0;
    if(AnimInfo[2][playerid] >= 207) AnimInfo[2][playerid] = 0;
    if(AnimInfo[3][playerid] >= 207) AnimInfo[3][playerid] = 0;
    if(AnimInfo[4][playerid] >= 207) AnimInfo[4][playerid] = 0;
    if(AnimInfo[5][playerid] >= 207) AnimInfo[5][playerid] = 0;
    //////
   	if(AnimInfo[0][playerid] >= 1)format(str,sizeof(str),"{cccccc}[ Space + Alt ] {99ff66}%s\n",animName[AnimInfo[0][playerid]]);
   	else if(AnimInfo[0][playerid] == 0)format(str,sizeof(str),"{cccccc}[ Space + Alt ] {cc9999}нет\n");
   	strcat(sctring,str);
   	if(AnimInfo[1][playerid] >= 1)format(str,sizeof(str),"{cccccc}[ Space + П.К.М. ] {99ff66}%s\n",animName[AnimInfo[1][playerid]]);
   	else if(AnimInfo[1][playerid] == 0)format(str,sizeof(str),"{cccccc}[ Space + П.К.М. ] {cc9999}нет\n");
   	strcat(sctring,str);
   	if(AnimInfo[2][playerid] >= 1)format(str,sizeof(str),"{cccccc}[ Space + C ] {99ff66}%s\n",animName[AnimInfo[2][playerid]]);
   	else if(AnimInfo[2][playerid] == 0)format(str,sizeof(str),"{cccccc}[ Space + C ] {cc9999}нет\n");
   	strcat(sctring,str);
   	if(AnimInfo[3][playerid] >= 1)format(str,sizeof(str),"{cccccc}[ Space + N ] {99ff66}%s\n",animName[AnimInfo[3][playerid]]);
   	else if(AnimInfo[3][playerid] == 0)format(str,sizeof(str),"{cccccc}[ Space + N ] {cc9999}нет\n");
   	strcat(sctring,str);
   	if(AnimInfo[4][playerid] >= 1)format(str,sizeof(str),"{cccccc}[ Space + / ] {99ff66}%s\n",animName[AnimInfo[4][playerid]]);
   	else if(AnimInfo[4][playerid] == 0)format(str,sizeof(str),"{cccccc}[ Space + / ] {cc9999}нет\n");
   	strcat(sctring,str);
   	if(AnimInfo[5][playerid] >= 1)format(str,sizeof(str),"{cccccc}[ Space + H ] {99ff66}%s\n",animName[AnimInfo[5][playerid]]);
   	else if(AnimInfo[5][playerid] == 0)format(str,sizeof(str),"{cccccc}[ Space + H ] {cc9999}нет\n");
   	strcat(sctring,str);

   	format(str,sizeof(str),"{0088ff}* {ffffff}Установить Анимацию [ 1 - 99 ]\n");
   	strcat(sctring,str);
   	format(str,sizeof(str),"{0088ff}* {ffffff}Установить Анимацию [ 100 - 205 ]\n");
   	strcat(sctring,str);
    ShowDialog(playerid,698,DIALOG_STYLE_LIST,"{0088ff}Анимации",sctring,"Выбор","Отмена");
	return 1;
}
stock refiel(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 5.0, 2526.6321,2831.6479,10.8203) || IsPlayerInRangeOfPoint(playerid, 5.0, 2510.9128,2831.6675,10.8203))
	{
		new veh = GetPlayerVehicleID(playerid);
		new model = VehInfo[veh][vModel];
		if(model != 403 && model != 514 && model != 515) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не на тягаче");
		if(!IsTrailerAttachedToVehicle(veh))
		{
			new string[84];
			if(GetPVarInt(playerid,"antiflood") > 0) return format(string, sizeof(string), "[ Мысли ]: Не так быстро.. {ffcc00}[ Подождите %d сек. ]", GetPVarInt(playerid,"antiflood")), SendClientMessage(playerid, COLOR_GREY, string);
			SetPVarInt(playerid,"antiflood",5);
			SetVehicleVelocity(veh,0.0,0.0,0.0);
			if(Cars[aget2[playerid]] == 309) AgetDestroy2(playerid); // Удаляем Созданный Прицеп
			new Float:X,Float:Y,Float:Z,Float:A;
			GetVehiclePos(veh, X,Y,Z);
			GetVehicleZAngle(veh, A);
			X=X-9.0*floatsin(-A,degrees);
        	Y=Y-9.0*floatcos(-A,degrees);
			aget2[playerid] = PP_CreateVehicle(584,X,Y,Z,A,3,3,600,0, -1, 0.0);
 			GetVehicleParamsEx(aget2[playerid],engine,lights,alarm,doors,bonnet,boot,objective);
  			SetVehicleParamsEx(aget2[playerid],false,false,alarm,doors,bonnet,boot,objective); // Глушим
   			VehInfo[aget2[playerid]][vEngine] = 0;
    		VehInfo[aget2[playerid]][vLights] = 0;
			VehInfo[aget2[playerid]][vAgetid] = playerid; // Арендовали Мы
  			Cars[aget2[playerid]] = 309;
  			AttachTrailerToVehicle(aget2[playerid], veh);
			ReloadVehicleLabel(aget2[playerid]); // Перезагружаем лейбл на тс
  			VehInfo[aget2[playerid]][v3dstat] = 1033;
			new Float:Xo,Float:Yo,Float:Zo;
	  		GetVehiclePos(aget2[playerid], Xo,Yo,Zo);
			format(string,sizeof(string),"{444444}.::[ {ff9000}Толпиво для Заправки {444444}]::.\n{cccccc}10т.");
    		VehLabel[aget2[playerid]] = CreateDynamic3DTextLabel(string,0xA9C4E4FF,Xo,Yo,Zo, 15.0, INVALID_PLAYER_ID, aget2[playerid]);
    		SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я могу заработать, доставляя топливо на заправки {ff9000}[/gryz >> Доставка Товаров]");
    		where_delivery(playerid);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не выполняю заказ [ /gryz ]");
	return 1;
}
stock fillstation(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
	new b;
	if(IsPlayerInRangeOfPoint(playerid, 5.0, 1911.1780,-1789.6757,13.3828)) b = 1;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, -87.2395,-1194.7644,2.6294)) b = 2;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, -1709.1683,392.7825,7.1797)) b = 3;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, -2115.0493,-38.1074,35.3203)) b = 4;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, 2115.8149,908.1592,10.8374)) b = 5;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, 2271.0813,2384.7393,10.8203)) b = 6;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, 2790.4558,1984.1487,10.8203)) b = 7;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, 1513.70, -2170.418, 13.573)) b = 8;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, 882.7999,1880.6128,10.8708)) b = 9;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, -2636.4387,1337.8279,7.1845)) b = 10;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, -1570.6510,-2724.7256,48.5591)) b = 11;
	else if(IsPlayerInRangeOfPoint(playerid, 5.0, 42.5942,-180.1398,1.6310)) b = 12;

	if(BizzInfo[b][bOrderStatus] == 0) return ErrorMessage(playerid, "{FF6347}В этот бизнес не оформлен заказ товаров");
	new be = GetPVarInt(playerid,"delivery_biz");
	if(b != be) return ErrorMessage(playerid, "{FF6347}У вас не оформлена доставка топлива для этой заправки");

	new veh = GetPlayerVehicleID(playerid);
	new model = VehInfo[veh][vModel];
	if(model != 403 && model != 514 && model != 515) return 0;
	if(!IsTrailerAttachedToVehicle(veh)) return 0;

	new pricep = GetVehicleTrailer(veh);
	if(VehInfo[pricep][v3dstat] != 1033) return ErrorMessage(playerid, "{FF6347}В трейлере нет топлива [ Y >> GPS >> Прочее >> Нефтеперерабатывающий Завод ]");
	if(BizzInfo[b][bItem][0] >= 50000) return ErrorMessage(playerid, "{FF6347}Цистерны этой заправки полные, доставка не требуется");

	VehInfo[veh][vOrderBizz] = 0;
	VehInfo[pricep][vOrderBizz] = 0;

	new skok = 10000;
	if(BizzInfo[b][bItem][0]+10000 > 50000) skok = 50000-BizzInfo[b][bItem][0];

	new cenbenz = skok*friskPrice[178];
	if(BizzInfo[b][bDeliveryPay]+cenbenz > BizzInfo[b][bDeposit]) return ErrorMessage(playerid, "{FF6347}Ошибка! На депозите бизнеса недостаточно средств для оплаты доставки топлива");
	if(Cars[pricep] == 309)
	{
		if(VehInfo[pricep][vAgetid] != 9999) ACDestroyVehicle(pricep);
	}
	BizzInfo[b][bDeposit] -= BizzInfo[b][bDeliveryPay]+cenbenz;
	paysalary(playerid, BizzInfo[b][bDeliveryPay], 1);
	
	// 24000 delivery pay
	// 10000*price = 24000
	BizLog("order", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, -(BizzInfo[b][bDeliveryPay]+cenbenz), "Доставил товары");
	MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", BizzInfo[b][bDeliveryPay], "Зарплата Дальнобойщик");

	notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Выполнил доставку товаров в ваш бизнес", true);

	mysql_tquery(pearsq, "START TRANSACTION;");
	new oldthing;
	for(new i = 0; i < 50; i++)
	{
		oldthing = BizzInfo[b][bOrder][i];
		BizzInfo[b][bOrder][i] = 0;
		BizzInfo[b][bOrderQuan][i] = 0;
		BizzInfo[b][bOrderType][i] = 0;

		if(oldthing != BizzInfo[b][bOrder][i]) SaveBizzOrder(b, i);
	}
	mysql_tquery(pearsq, "COMMIT;");

	BizzInfo[b][bDeliveryOrder] = -1;
	BizzInfo[b][bOrderStatus] = 0;
    BizzInfo[b][bOrders] --;
    Orders --;

	SetPVarInt(playerid,"delivery_biz",0);
	if(BizzInfo[b][bItem][0]+10000 < 50000) BizzInfo[b][bItem][0] += 10000;
	else BizzInfo[b][bItem][0] = 50000;

	BizzInfo[b][bUpdate] = 1;

	PutMoneyToTreasury(cenbenz, "Оплата доставки топлива");
	UpdateFillLabel(b);
	if(PlayerInfo[playerid][pAchieve][119] == 0) AchievePlayer(playerid, 119, 1);

	// Доставить грузы
	CompletingDaily(playerid, 18, 1);
	return 1;
}
stock regos(playerid) // Загружаем транспорт товарами
{
	new veh = GetPlayerVehicleID(playerid);
	new model = VehInfo[veh][vModel];

	new b = GetPVarInt(playerid,"delivery_biz");
	if(b == 0) return ErrorMessage(playerid, "{FF6347}У вас нет активного заказа доставки [ /gryz ]");
	if(b <= 12) return ErrorMessage(playerid, "{FF6347}Загрузка для вашего заказа происходит на нефтеперерабатывающем заводе");
	if(b >= 77 && b <= 92) // Автосалоны, Мотосалоны, Авиасалоны, Салоны Катеров
	{
		if(model != 443) return ErrorMessage(playerid, "{FF6347}Вам требуется грузовик [ Packer ]\n\nВы можете арендовать его на парковке государственного склада");
	}
	else
	{
		if(model != 499 && model != 414 && model != 456) return ErrorMessage(playerid, "{FF6347}Вам требуется грузовик [ Benson, Mule, Yankee ]\n\nВы можете арендовать его на парковке государственного склада");
	}
	if(VehInfo[veh][vOrderBizz] > 0) return ErrorMessage(playerid, "{FF6347}Этот транспорт уже загружен");

	if(GetPVarInt(playerid,"antiflood") > 0) return ErrorMessage(playerid, "{FF6347}Пожалуйста, не флудите");
	SetPVarInt(playerid,"antiflood",5);

	SetVehicleVelocity(veh,0.0,0.0,0.0);
	new Float:Xo,Float:Yo,Float:Zo;
	GetVehiclePos(veh, Xo,Yo,Zo);

	// Крепим объекты к транспорту (При доставке в shop_vehicle)
	if(b >= 77 && b <= 81) // Автосалон
	{
		VehInfo[veh][vObjstat] = 1;
		VehInfo[veh][vObject] = CreateDynamicObject(14826, Xo,Yo,Zo, 0.000000, 0.000000, 270.000000, 0, 0, -1, 100.00, 100.00); 
		SetDynamicObjectMaterial(VehInfo[veh][vObject], 0, 19962, "samproadsigns", "materialtext1", 0x00000000);
		SetDynamicObjectMaterial(VehInfo[veh][vObject], 2, 19962, "samproadsigns", "materialtext1", 0x00000000);
		SetDynamicObjectMaterial(VehInfo[veh][vObject], 3, 19962, "samproadsigns", "materialtext1", 0x00000000);
		AttachDynamicObjectToVehicle(VehInfo[veh][vObject], veh, 0.704999, -0.474999, 1.594998, 0.0, 14.0, -90.0); //Object Model: 14826 | 
	}
	else if(b >= 82 && b <= 86) // Мотосалон
	{
		VehInfo[veh][vObjstat] = 1;
		VehInfo[veh][vObject] = CreateDynamicObject(2935, Xo,Yo,Zo, 0.000000, 0.000000, 270.000000, 0, 0, -1, 100.00, 100.00); 
		AttachDynamicObjectToVehicle(VehInfo[veh][vObject], veh, 0.0, -1.464998, 2.375006, 15.0, 0.0, 0.0); //Object Model: 2935 | Yellow
	}
	else if(b >= 87 && b <= 89) // Авиасалон
	{
		VehInfo[veh][vObjstat] = 1;
		VehInfo[veh][vObject] = CreateDynamicObject(2934, Xo,Yo,Zo, 0.000000, 0.000000, 270.000000, 0, 0, -1, 100.00, 100.00); 
		AttachDynamicObjectToVehicle(VehInfo[veh][vObject], veh, 0.0, -1.464998, 2.375006, 15.0, 0.0, 0.0); //Object Model: 2934 | Red
	}
	else if(b >= 90 && b <= 92) // Салон Катеров
	{
		VehInfo[veh][vObjstat] = 1;
		VehInfo[veh][vObject] = CreateDynamicObject(2932, Xo,Yo,Zo, 0.000000, 0.000000, 270.000000, 0, 0, -1, 100.00, 100.00); 
		AttachDynamicObjectToVehicle(VehInfo[veh][vObject], veh, 0.0, -1.464998, 2.375006, 15.0, 0.0, 0.0); //Object Model: 2932 | Blue
	}

	ReloadVehicleLabel(veh); // Перезагружаем лейбл на тс
	VehLabel[veh] = CreateDynamic3DTextLabel("{444444}.::[ {ff9000}Товары {444444}]::.\n{cccccc}3т.",0xA9C4E4FF,Xo,Yo,Zo, 10.0, INVALID_PLAYER_ID, veh);
	VehInfo[veh][v3dstat] = 1001;
	VehInfo[veh][vOrderBizz] = b;
	where_delivery(playerid);
	return 1;
}
stock shoppos(playerid, b, veh) // Разгружаем товары в бизнес
{
	if(BizzInfo[b][bOrderStatus] == 0) return ErrorMessage(playerid, "{FF6347}В этот бизнес не оформлен заказ товаров");
	new be = GetPVarInt(playerid,"delivery_biz");
	if(b != be) return ErrorMessage(playerid, "{FF6347}Вы не оформляли доставку для этого бизнеса");

	mysql_tquery(pearsq, "START TRANSACTION;");
	new oldthing;
	new payOrders;
	// Распределяем товары из заказа в биз
	for(new i = 0; i < 50; i++)
	{
		if(BizzInfo[b][bOrder][i] > 0)
		{
			oldthing = BizzInfo[b][bOrder][i];
			if(b >= 173 && b <= 182) // Магазины с Одеждой (У них свои переменные хранения одежды и аксессуаров)
			{
				putshop(b-173, BizzInfo[b][bOrder][i], BizzInfo[b][bOrderType][i], BizzInfo[b][bOrderQuan][i]);
			}
			else // Прочие бизнесы
			{
				putThingBizzProduct(b, BizzInfo[b][bOrder][i], BizzInfo[b][bOrderType][i], BizzInfo[b][bOrderQuan][i]);
			}
			payOrders += getThingPriceGos(BizzInfo[b][bOrder][i], BizzInfo[b][bOrderType][i]) * BizzInfo[b][bOrderQuan][i];
			BizzInfo[b][bOrder][i] = 0;
			BizzInfo[b][bOrderQuan][i] = 0;

			if(oldthing != BizzInfo[b][bOrder][i]) SaveBizzOrder(b, i);
		}
	}
	mysql_tquery(pearsq, "COMMIT;");

	// Изменяем переменные игрока
	SetPVarInt(playerid,"delivery_biz",0);
	paysalary(playerid, BizzInfo[b][bDeliveryPay], 0);
	MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", BizzInfo[b][bDeliveryPay], "Зарплата Дальнобойщик");

	// Изменяем переменные биза
	BizzInfo[b][bOrders] --;
	Orders --;
	BizzInfo[b][bDeposit] -= BizzInfo[b][bDeliveryPay] + payOrders;
	BizzInfo[b][bDeliveryOrder] = -1;
	BizzInfo[b][bOrderStatus] = 0;
	BizzInfo[b][bUpdate] = 1;
	SaveBizzProduct(b);
	BizLog("order", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], b, 0, "Доставил товары");
	notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], BizzInfo[b][bSost], BizzInfo[b][bVlad], "Выполнил доставку товаров в ваш бизнес", true);

	// Обновляем 3d Label Супермаркета
	if(b >= 13 && b <= 26) UpdateSupermarketLabel_S(b);

	// Кладём лаве в казну
	PutMoneyToTreasury(payOrders, "Оплата разгрузки товаров в бизнес");

	// Снимаем инфу о доставке в бизнес
	VehInfo[veh][vOrderBizz] = 0;

	// Удаляем label с транспорта
	if(VehInfo[veh][v3dstat] > 0) DestroyDynamic3DTextLabel(VehLabel[veh]), VehInfo[veh][v3dstat] = 0;

	// Удаляем объект с транспорта
	if(VehInfo[veh][vObjstat] >= 1) DestroyDynamicObject(VehInfo[veh][vObject]), VehInfo[veh][vObjstat] = 0;
	
	// Ачивка
	if(PlayerInfo[playerid][pAchieve][119] == 0) AchievePlayer(playerid, 119, 1);

	// Доставить грузы
	CompletingDaily(playerid, 18, 1);
	return 1;
}
stock where_delivery(playerid)
{
	if(GetPVarInt(playerid,"delivery_biz") >= 1)
	{
		new b = GetPVarInt(playerid,"delivery_biz");
		new veh = GetPlayerVehicleID(playerid);
		if(VehInfo[veh][v3dstat] != 1001 && VehInfo[aget2[playerid]][v3dstat] != 1033)
		{
			if(b <= 12) CreateGps(playerid, 2532.3538, 2797.8665, 10.8203, 0, 0, 10.0);
			else
			{
				switch(random(4))
				{
					case 0: CreateGps(playerid, 2260.6726,2779.9727,10.8203, 0, 0, 10.0);
					case 1: CreateGps(playerid, 2260.1448,2770.3477,10.8203, 0, 0, 10.0);
					case 2: CreateGps(playerid, 2260.1538,2763.7407,10.8203, 0, 0, 10.0);
					case 3: CreateGps(playerid, 2260.1968,2754.3882,10.8203, 0, 0, 10.0);
				}
			}
		}
		else
		{
			if(b <= 12)
			{
				SendClientMessage(playerid, COLOR_YELLOW, " SMS от Оператора Транспортной Компании: {99ff33}Заправка отмечена в вашем GPS навигаторе [Красная метка на радаре]");
				ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{FFFF00}SMS от Оператора Транспортной Компании:\n\n{99ff33}Заправка отмечена в вашем GPS навигаторе [Красная метка на радаре]","Oк","");
				if(b == 1) CreateGps(playerid,1911.1780,-1789.6757,13.3828, 0, 0, 10.0);
				else if(b == 2) CreateGps(playerid,-87.2395,-1194.7644,2.6294, 0, 0, 10.0);
				else if(b == 3) CreateGps(playerid,-1709.1683,392.7825,7.1797, 0, 0, 10.0);
				else if(b == 4) CreateGps(playerid,-2115.0493,-38.1074,35.3203, 0, 0, 10.0);
				else if(b == 5) CreateGps(playerid,2115.8149,908.1592,10.8374, 0, 0, 10.0);
				else if(b == 6) CreateGps(playerid,2271.0813,2384.7393,10.8203, 0, 0, 10.0);
				else if(b == 7) CreateGps(playerid,2790.4558,1984.1487,10.8203, 0, 0, 10.0);
				else if(b == 8) CreateGps(playerid,1513.70, -2170.418, 13.573, 0, 0, 10.0);
				else if(b == 9) CreateGps(playerid,882.7999,1880.6128,10.8708, 0, 0, 10.0);
				else if(b == 10) CreateGps(playerid,-2636.4387,1337.8279,7.1845, 0, 0, 10.0);
				else if(b == 11) CreateGps(playerid,-1570.6510,-2724.7256,48.5591, 0, 0, 10.0);
				else if(b == 12) CreateGps(playerid,42.5942,-180.1398,1.6310, 0, 0, 10.0);
			}
			else if(b >= 153 && b <= 162)
			{
				if(BizzInfo[b][bCity] == 0)
				{
					switch(random(2))
					{
						case 0: CreateGps(playerid,979.7935,-1256.2632,16.9523,0,0,10.0);
						case 1: CreateGps(playerid,973.1881,-1256.1870,16.9520,0,0,10.0);
					}
				}
				else if(BizzInfo[b][bCity] == 1)
				{
					switch(random(2))
					{
						case 0: CreateGps(playerid,-2531.1018,-15.1876,16.4219,0,0,10.0);
						case 1: CreateGps(playerid,-2531.3118,-23.5520,16.4219,0,0,10.0);
					}
				}
				else if(BizzInfo[b][bCity] == 2)
				{
					switch(random(2))
					{
						case 0: CreateGps(playerid,2394.4548,990.9169,10.8203,0,0,10.0);
						case 1: CreateGps(playerid,2393.6160,1000.1471,10.8203,0,0,10.0);
					}
				}
				SendClientMessage(playerid, COLOR_YELLOW, " SMS от Оператора Транспортной Компании: {99ff33}Точка разгрузки отмечена в вашем GPS навигаторе [Красная метка на радаре]");
				ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{FFFF00}SMS от Оператора Транспортной Компании:\n\n{99ff33}Точка разгрузки отмечена в вашем GPS навигаторе [Красная метка на радаре]","Oк","");
			}
			else
			{
				SendClientMessage(playerid, COLOR_YELLOW, " SMS от Оператора Транспортной Компании: {99ff33}Точка разгрузки отмечена в вашем GPS навигаторе [Красная метка на радаре]");
				ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{FFFF00}SMS от Оператора Транспортной Компании:\n\n{99ff33}Точка разгрузки отмечена в вашем GPS навигаторе [Красная метка на радаре]","Oк","");
				CreateGps(playerid,BizzInfo[b][bX],BizzInfo[b][bY],BizzInfo[b][bZ], 0, 0, 10.0);
			}
		}
	}
	return 1;
}

CMD:clearorder(playerid) // Команда очистки всех заказов в бизнесы
{
	if(PlayerInfo[playerid][pSoska] < 20) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду [ Adm 20+ ]");

	mysql_transaction(pearsq);
	for(new b = 0; b < sizeof(BizzInfo); b++)
	{
		for(new i = 0; i < 50; i++)
		{
			BizzInfo[b][bOrder][i] = 0;
			BizzInfo[b][bOrderQuan][i] = 0;
			BizzInfo[b][bOrderType][i] = 0;
		}
		SaveBizzOrderAll(b);
		BizzInfo[b][bOrderStatus] = 0;
		BizzInfo[b][bDeliveryOrder] = -1;
		BizzInfo[b][bOrders] = 0;
		SaveBizz(b);
	}
	mysql_commit(pearsq);

	Orders = 0;
	new string[80];
	format(string, sizeof(string), " [ ADM ]: %s очистил все заказы бизнесов",PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
	return 1;
}
CMD:clearfill(playerid) // Команда очистки топлива на заправках
{
	if(PlayerInfo[playerid][pSoska] < 20) return ErrorMessage(playerid, "{FF6347}Вы не можете использовать эту команду [ Adm 20+ ]");
	for(new b = 0; b < 12; b++)
	{
		BizzInfo[b][bItem][0] = 0;
		BizzInfo[b][bUpdate] = 1;
		UpdateFillLabel(b);
	}
	new string[90];
	format(string, sizeof(string), " [ ADM ]: %s очистил топливо на всех заправках",PlayerInfo[playerid][pName]);
	ABroadCast(COLOR_ADM,string,1);
	return 1;
}
CMD:gryz(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	orderbiz(playerid);
	return 1;
}
stock orderbiz(playerid)
{
	new quan;
	new line[214],lines[4096];
	format(line,sizeof(line),"{cccccc}Бизнес\t{cccccc}Оплата доставки\t{cccccc}Расстояние\n"), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Как доставлять товары в бизнесы? \t \t "), strcat(lines,line);
	format(line,sizeof(line),"\n{cccccc}Куда мне ехать? \t \t "), strcat(lines,line);
	format(line,sizeof(line),"\n{FF6347}Отменить Доставку \t \t "), strcat(lines,line);
	for(new b = 0; b < sizeof(BizzInfo); b++)
	{
		if(b >= 163 && b <= 172) continue;
		if(BizzInfo[b][bOrderStatus] == 1 && BizzInfo[b][bDeliveryOrder] == -1)
		{
			List[quan][playerid] = b;
			quan ++;
			format(line,sizeof(line),"\n{ff9000}[№ %d] %s \t {99ff66}%d$\t%d м.", b, bizname(b), BizzInfo[b][bDeliveryPay],(getPayOrderDelivery(b)/ServerInfo[11])*100), strcat(lines,line);
		}
	}

	new header[60];
	format(header,sizeof(header),"{cccccc}Активные Заказы: %d | Доставляются: %d", quan, Orders - quan);
	ShowDialog(playerid,1062,DIALOG_STYLE_TABLIST_HEADERS,header,lines,"Выбрать","Отмена");
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}

function DeliveryOrderAutoCancel(playerid, b) {
	if (BizzInfo[b][bDeliveryOrder] != playerid) return 0;
	BizzInfo[b][bDeliveryOrder] = -1;
	DeletePVar(playerid, "delivery_biz");
	OnlineInfo[playerid][oDeliveryOrderAutoCancelTimer] = 0;
	ErrorMessage(playerid, "{ff6347}Доставка груза была отменена [ Вы не успели завершить доставку в указанное время ]");
	return 1;
}

CMD:dalno(playerid, const params[])
{
   if(IsPlayerInRangeOfPoint(playerid,2.0,1380.9899,-21.2936,1001.0793))
   {
		if(GetPlayerInterior(playerid) == 11 && GetPlayerVirtualWorld(playerid) == 11)
   		{
   			if(PlayerInfo[playerid][pPlacement] >= 1 && PlayerInfo[playerid][pPlacement] != 7) return StopJob(playerid);
			PlayerPlaySound(playerid,40405,0,0,0);
			ShowDialog(playerid,770,DIALOG_STYLE_LIST,"{ff9000}Транспортная Компания","{cccccc}Информация\n{cccccc}Получить Зарплату","Выбор","Отмена");
		}
   }
   return 1;
}
//----------------------------------[government]-----------------------------------------------
CMD:gov(playerid, const params[])
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(27, g, playerid) && PlayerInfo[playerid][pFbi] == 0) return ErrorMessage(playerid, "{FF6347}Вы не сотрудник департамента");
	if(!GetAccessRankOrg(playerid, g, 27, NO_FBI)) return 1;

	if(PlayerInfo[playerid][pTransmitterOff][8] == true) return ErrorMessage(playerid, "{FF6347}У вас выключен этот чат\n{cccccc}Y >> Меню >> Настройки Чата");
	if(GetPVarInt(playerid,"antiflood") > 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Мне нужно настроить необходимую частоту [ Раз в 5 секунд ]");
	if(Sleep[playerid]>=1 || SleepRP[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я сплю");
	if(!IsAGov(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я далеко от передатчика");
	if(IsPlayerInSquare(playerid, 1564.659545, -1681.572143, 1566.940429, -1670.921264)) return 1; // Защита от срабатывания в холле LSPD
 	if(sscanf(params, "s[144]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Новости департамента [ /gov текст ]");
 	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(PlayerInfo[playerid][pFmuteTime] >= 1)
	{
		format(string, sizeof(string), "[ Мысли ]: Лидер запретил мне пользоваться громкоговорителем {ff0000}[ Mute: %d минут ]", PlayerInfo[playerid][pFmuteTime]/60);
		SendClientMessage(playerid, COLOR_GREY, string);
		return 1;
	}

	if(AntiFloodText(playerid, params[0])) return 1;

	if(g == 1)
	{
		OOCOff(COLOR_GREY, "{ffffff}**______________Новости San Andreas Police Department______________**");
		format(string, sizeof(string), "{0066ff}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 2)
	{
		OOCOff(COLOR_GREY, "{ffffff}**______________Federal Bureau of Investigation______________**");
		format(string, sizeof(string), "{6666ff}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 3)
	{
		OOCOff(COLOR_GREY, "{ffffff}**___________Новости Министерства Обороны___________**");
		format(string, sizeof(string), "{336633}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 4)
	{
		OOCOff(COLOR_GREY, "{ffffff}**______________Новости Министерства Здравоохранения______________**");
		format(string, sizeof(string), "{ff6666}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 7)
	{
		OOCOff(COLOR_WHITE, "{ffffff}**___________Новости Правительства___________**");
		format(string, sizeof(string), "{ffffff}** %s: %s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 9)
	{
		OOCOff(COLOR_GREY, "{ffffff}**___________Cable News Network___________**");
		format(string, sizeof(string), "{ffcc66}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 11) 
	{
		OOCOff(COLOR_GREY, "{ffffff}**______________Новости San Fierro Police Department______________**");
		format(string, sizeof(string), "{122faa}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 21)
	{
		OOCOff(COLOR_GREY, "{ffffff}**______________Новости Las Venturas Police Department______________**");
		format(string, sizeof(string), "{2b6cc4}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	else if(g == 22)
	{
		OOCOff(COLOR_GREY, "{ffffff}**______________Новости Special Weapons And Tactics______________**");
		format(string, sizeof(string), "{191970}** %s: {FFFFFF}%s", PlayerInfo[playerid][pName], params[0]);
	}
	OOCOff(COLOR_GREY, string);
	SetPVarInt(playerid,"antiflood",5);
	return 1;
}

#if defined SAMPVOICE_COMPILE_3 
