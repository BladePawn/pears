	{
		new world = GetPlayerVirtualWorld(playerid);
		S_SetPlayerVirtualWorld(playerid, 0), PPSetPlayerInterior(playerid, 0);
		if(world == 1) PPSetPlayerPos(playerid,215.7876,1987.0959,17.6406), PPSetPlayerFacingAngle(playerid,91.5487);
