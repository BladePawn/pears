	PlayerSpeedDraw[playerid][5] = CreatePlayerTextDraw(playerid, 163.121185, 364.155487, "0"); // Спидометр
	PlayerTextDrawLetterSize(playerid, PlayerSpeedDraw[playerid][5], 0.405333, 2.122667);
	if(PlayerInfo[playerid][pTypeSpeed] == 0) PlayerTextDrawAlignment(playerid, PlayerSpeedDraw[playerid][5], TEXT_DRAW_ALIGN:1);
	else if(PlayerInfo[playerid][pTypeSpeed] == 1) PlayerTextDrawAlignment(playerid, PlayerSpeedDraw[playerid][5], TEXT_DRAW_ALIGN:2);
	PlayerTextDrawColour(playerid, PlayerSpeedDraw[playerid][5], -1);
