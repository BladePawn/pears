stock FindKlub(playerid, bool:findforQuest = false)
{
	new Float:dist, Float:findpos, kakoi = 93, quan;
	new Float:x,Float:y,Float:z;
    GetPlayerRealPos(playerid, x, y, z);

	dist = GetDistancePoint(x, y, z, BizzInfo[93][bEnterX],BizzInfo[93][bEnterY],BizzInfo[93][bEnterZ]);
	for(new b = 93; b < 103; b++)
	{
		if(findforQuest == true) // Распределяем игроков во время квеста
		{
			if(NextFindBiz(b)) continue; // В этот клуб отправили уже максимальное количество игроков, значит ищем следующий
			if (BizzInfo[b][bItem][0] < 4 && BizzInfo[b][bItem][1] < 4 && BizzInfo[b][bItem][2] < 4) continue; // В клубе нет товаров, незачем отправлять игроков сюда
		}

		if(BizzInfo[b][bBizOStat][0] == 1 && BizzInfo[b][bArest] == 0 && BizzInfo[b][bStat] == 0)
		{
			quan ++;
			findpos = GetDistancePoint(x, y, z, BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ]);
			if(findpos <= dist) dist = findpos, kakoi = b;
		}
	}
	if(quan == 0) return ErrorMessage(playerid, "{FF6347}Все клубы закрыты {ff9000}[ Обратитесь к администрации /report ]");
	new string[160];
	format(string,sizeof(string),"{ff9000}Ближайший Клуб: %s {99ff66}отмечен на карте\n{cccccc}Бизнес № %d", BizzInfo[kakoi][bName], kakoi);
	SuccessMessage(playerid, string);
	CreateGps(playerid, BizzInfo[kakoi][bEnterX],BizzInfo[kakoi][bEnterY],BizzInfo[kakoi][bEnterZ], 0, 0, 5.0);

	// Записываем, что мы нашли клуб для игрока
	if(findforQuest == true) WriteFindBiz(kakoi);
	return 1;
}
