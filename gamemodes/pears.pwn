forward babaxx();
public babaxx()
{
	KillTimer(YadeTimer);
	if(Yaderbabah <= 70)
	{
		new rand = 0 + random(25);
		switch(random(4))
    	{
        	case 0: CreateExplosion(PizdaX+rand, PizdaY+rand, PizdaZ, 7, 300.0);
        	case 1: CreateExplosion(PizdaX-rand, PizdaY-rand, PizdaZ, 7, 300.0);
        	case 2: CreateExplosion(PizdaX-rand, PizdaY+rand, PizdaZ, 7, 300.0);
        	case 3: CreateExplosion(PizdaX+rand, PizdaY-rand, PizdaZ, 7, 300.0);
		}
		Yaderbabah ++;
		YadeTimer = SetTimer("babaxx", 200, false);
	}
	if(Yaderbabah >= 60) Yaderstat = 4;
	return 1;
}
function EveryFiveSecond()
{
	if(server > 0 || serverType == 1) // Только для основного сервера или для тестового
	{
		// Отправляем инфу о сервере
		UpdateSqlProperties();

		// Отправляем инфу об игроках
		UpdateSqlPlayer();
	}

	// Облако погоды движется
	if(WeatherID != -1) 
	{
		if(Weather[WeatherID][weatherStatus] == 1) WeatherMoving();
	}

	for(new i; i < MAX_WEATHER; i++)
	{
		if(Weather[i][weatherStatus] != 0) continue;
		if(Weather[i][weatherUnix] < gettime()) WeatherStart(i);
	}
	// Семейный чат грузим из базы
	// CheckMessageFamilyChat();
	return 1;
}

function EveryThrityMinute()
{
	// Запускаем самолёт с баблом
	PlaneStart();

	// Кладём отмычку в ящик в тюрмье
	for(new i; i < 8; i++)
	{
		if(get_prisontable(i,19, 0) > 0) continue;
		else PutThingPrisonTable(i,-1,19,2,0,0,0,0,999);
	}

	return 1;
}

public IzTuryagi()
{
	new tickTimer = GetTickCount();

	new string[256], animname[32], animlib[32];
	new Days = getdate();
	new tmphour,tmpminute,tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	new unixtime = gettime();
	if(hitReklama >= 1) { hitReklama --; }
    if(Vremyamp >= 1) { Vremyamp --; }
    for(new fa = 0; fa < 21; fa++ )
    {
    	if(frakad[fa] >= 1) frakad[fa]--;
    }
    for(new seastar = 0; seastar < 21; seastar++)
	{
	    if(SeaStarStat[seastar] != 2) continue;
        if(SeaStarTime[seastar] > 0) SeaStarTime[seastar] --;
        else LoadSeaStar(seastar);
 	}
 	for(new seashell = 0; seashell < 5; seashell++)
	{
	    if(SeaShellStat[seashell] != 2) continue;
        if(SeaShellTime[seashell] > 0) SeaShellTime[seashell] --;
        else LoadSeaShell(seashell);
 	}
   	if(VmfDoor == 0 && VmfTime == 0) load_ammovmf(); // Грузим боеприпасы в первый раз
   	if(VmfDoor == 4) // Грузим боеприпасы после неудачной попытки
    {
    	if(VmfTime >= 1) VmfTime --;
    	if(VmfTime == 0) load_ammovmf();
   	}
   	if(VmfDoor == 5 || VmfDoor == 6 || VmfDoor == 7)
    {
    	if(VmfTime >= 1) VmfTime --;
    	if(VmfTime == 0) load_ammovmf();
    }
    if(unixtime >= dirtunix && dirtkol <= 21) load_dirt();

	// Отправка объявлений CNN в порядке очереди
	SendAdInZero();

	// Таймер для отключения режима тревоги в тюрьме
	if(PrisonAlarmTime > 0) TimePrisonAlarm();

	// Остановка поезда
	if(TrainStoppedTime > 0) ProcessTrainRob();
    
	if(nasatime > 0)
	{
	    nasatime --;
	    new qwer[12];
	    if(nasatime > 1) format(qwer,sizeof(qwer),"{00cc00}%d", nasatime-1);
	    else if(nasatime == 1)
		{
			format(qwer,sizeof(qwer),"{00cc00}GO!");
			if(nasa_flystat <= 0) start_falcon();
		}
	    else if(nasatime == 0) format(qwer,sizeof(qwer)," ");
	    SetDynamicObjectMaterialText(nasa_tablo[0], 0, qwer, 130, "Impact", 150, 0, 0xFFFFFFFF, 0x00000000, 1);
	    SetDynamicObjectMaterialText(nasa_tablo[2], 0, qwer, 120, "Arial", 90, 1, 0xFF00CC00, 0x00000000, 1);
	    SetDynamicObjectMaterialText(nasa_tablo[4], 0, qwer, 120, "Arial", 90, 1, 0xFF00CC00, 0x00000000, 1);
	}

	{	
		foreach (new playerid : Player) {
			// Таймер при прохождении тренировочного маршрута
			Obstacle_UpdateTimer(playerid);

			// Таймер до наступления новой волны (Заброшенная шахта)
			MineWar_UpdateTimer(playerid);

			// Таймер до наступления новой волны (Гробница фараона)
			Tomb_UpdateTimer(playerid);

			// Обработка попаданий на радар
			Radar_ViolationHandler(playerid);

			// Таймер до полной зарядки транспорта
			if(zaprcarElectroTimer[playerid] > 0) 
			{
				ElectroFillUpdateTimer(playerid);
			}
		}
	}

	// Кормление рыбок в аквариуме
	FeedTheFish(0);

	// Доминик ожидает гонки с игроком
	if(DominicStatusVehicle == 1 && DominicWaitTimer > 0) Dominic_WaitRace();

	// Village Bot
	ProcessVillageNpc();

	for(new i; i < MAX_HALLOWEEN_NPC_COUNT; i++)
	{
		WalkingHalloweenNpc(i);
	}

	for(new a; a < MAX_WILD_ANIMALS_NPS; a++)
	{
		LifeWildAnimals(a);
	}

	for(new pet; pet < MAX_PETS; pet++)
	{
		LifePet(pet);
	}

	// Боты на нарко ферме.
	LifeNarkoFermNpc();

	for(new wildpet = 0; wildpet < MAX_WILDPET; wildpet++)
	{
		LifeWildPet(wildpet);
	}

	// Процесс жизни Джейсона
	LifeJason();

	// Процесс жизни маньяков
	LifeManiacs();

	// Процесс жизни пенниваза
	LifePennivize();
	
    // Ядерная Бомба
    if(Yadertimer >= 1)
	{
		Yadertimer --;
		if(Yaderstat >= 3 && Yadertimer <= 1) Yaderstat = 0;
	}
	for(new i; i < MAX_RACERS_POINT;i++)
	{
		if(StreetRacers[i][raceUnix] >= 1)
		{
			StreetRacers[i][raceUnix]--;
			if(StreetRacers[i][raceUnix] == 0) ClosePartyStreet(i);
		}
	}
    if(Yaderstat == 2)
    {
		if(Yadertimer == 0)
		{
			foreach (Player, i)
			{
	  			if(OnlineInfo[i][oLogged] == 1 && OnlineInfo[i][oListenRadioPears] == 0 && GetPVarInt(i,"afksystem") <= 3)
	  			{
	     			StopAudioStreamForPlayer(i);
	        		PlayAudioStreamForPlayer(i, "https://cdn.pears.fun/sound/boom.mp3");
	     		}
    		}
    		SetDynamicObjectPos(pizobj, 0.0000, 0.0000, -300.0000);
     		Yaderbabah = 0;
       		YadeTimer = SetTimer("babaxx", 200, false);
		    Yaderstat = 3;
		    Yadertimer = 3600; //только через 1 час
		}
    }
    
    // Плот на лаве
    if(plot_player >= 0)
    {
        plot_time ++;
        if(plot_time >= 30) plothome(plot_route);
    }
    
    for(new v = 1; v < MAX_CARS; v++)
	{
		if(VehInfo[v][vModel] == 0) continue;

		new Float:vX, Float:vY, Float:vZ;
    	// Получаем позицию динамического актёра
    	GetVehiclePos(v, vX, vY, vZ);

		// Чек расположения транспорта
	    if(VehInfo[v][vJob] == 8 && VehInfo[v][vJobStat] > 0)
		{
			if(!IsVehicleInRangeOfPoint(v, 2.0, VehInfo[v][VehJob_X], VehInfo[v][VehJob_Y], VehInfo[v][VehJob_Z])) reset_trash(trash_player[VehInfo[v][vJobID]], VehInfo[v][vJobID], 3), VehInfo[v][vJob] = 0;
		}

		// Личные тачки, ручной спавн
		if(Cars[v] == 88)
		{
			// Доставка транспорта
			if(VehInfo[v][vCallParking] > 0)
			{
				if(VehInfo[v][vCallTimer] > 0) VehInfo[v][vCallTimer] --;
				else CallVehicleProgress(v);
			}
		}

		// Сбрасываем таймер присаживания в транспорт на пассажирское сидение
		if(VehInfo[v][vSittingPassenger] > 0) VehInfo[v][vSittingPassenger] --;

		// Сбрасываем таймер выхода из транспорта
		if(VehInfo[v][vExitSeat] > 0) VehInfo[v][vExitSeat] --;

		// Транспорт на центральном рынке оказался, спавним резко нахуй
		if(IsVehicleInSquare(v, 1083.5, -1536.5, 1177.5, -1418.5) && !(IsAPlane(VehInfo[v][vModel]) && vZ > 31.45)) 
		{
			if(VehInfo[v][vSeat] > 0)
			{
				new dryaver = VehInfo[v][vSeat]-1;
				if(IsOnline(dryaver))
	    		{
					SendClientMessage(dryaver, COLOR_GREY, "[ Мысли ]: Ой.. кажется по рынку нельзя ездить на транспорте");
					PlayerPlaySound(dryaver,45400,0,0,0);
					ShowDialog(dryaver,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{FF6347}Внимание! Транспорт отправлен на спавн\n{ffcc66}Вы заехали на территорию, на которой нельзя ездить на транспорте","*","");
				}
			}
			PP_SetVehicleToRespawn(v);
		}
	}
	
	// Таймер участников в казино
	new yeahkas, place_walk;
	for(new desk; desk < MAX_DESK; desk++)
	{
		// Работа со столами
		if(DeskInfo[desk][Status] == 1) // 1 - начинаем игру (проверка готовности всех участников)
		{
		    DeskInfo[desk][Timer] --;
		    if(DeskInfo[desk][Timer] == 0)
			{
				if(DeskInfo[desk][QuanPlayer] > 1 && DeskInfo[desk][QuanPlayer] == DeskInfo[desk][QuanGame])
				{
				    if(DeskInfo[desk][Game] == 3) DeskInfo[desk][Timer] = 5;
				    else DeskInfo[desk][Timer] = 3;
				    DeskInfo[desk][Status] = 2;
					go_game_card(desk, DeskInfo[desk][Game]);
				}
				else DeskInfo[desk][Timer] = 3;
			}
		}
		// Работа со столами
		if(DeskInfo[desk][Status] == 2) // 2 - показываем кто первый ходит 
		{
		    if(DeskInfo[desk][Timer] > 0) DeskInfo[desk][Timer] --;
		    if(DeskInfo[desk][Game] == 3)
		    {
		    	if(DeskInfo[desk][Timer] == 3) desk_card_poke(desk, 0);
		    	if(DeskInfo[desk][Timer] == 2) desk_card_poke(desk, 1);
		    	if(DeskInfo[desk][Timer] == 1) desk_card_poke(desk, 2);
		    	update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
		    }
		    if(DeskInfo[desk][Timer] == 0) DeskInfo[desk][Status] = 3, whose_turn(desk);
  		}
		if(DeskInfo[desk][Status] >= 3)
		{
			if(DeskInfo[desk][Lastor] == 1) // БИТО
			{
   				if(DeskInfo[desk][Timer] > 0) DeskInfo[desk][Timer] --;
   				else if(DeskInfo[desk][Timer] == 0)
   				{
   				    DeskInfo[desk][Lastor] = 0;
   				    yeahkas = reset_walk(desk, 1, 1);
   				    
   				    if(yeahkas == 1)
   				    {
	   				    // Передаём ход тому, кто крылся
	   					place_walk = get_member_next(desk, DeskInfo[desk][Goes]-1);
	    				go_walk(desk, place_walk, 0, 0);
   					}
   				}
			}
			if(DeskInfo[desk][Lastor] == 2) // БЕРУ
			{
   				if(DeskInfo[desk][Timer] > 0) DeskInfo[desk][Timer] --;
   				else if(DeskInfo[desk][Timer] == 0)
   				{
   				    give_takedesk_card(desk, DeskInfo[desk][Underwalk]-1);
   				    DeskInfo[desk][Lastor] = 0;
   				    yeahkas = reset_walk(desk, 0, 2);
   				    
   				    if(yeahkas == 1)
   				    {
	   				    // Передаём ход, чел взял карты
	   					place_walk = get_member_next(desk, DeskInfo[desk][Underwalk]-1);
	    				go_walk(desk, place_walk, 0, 0);
   					}
   				}
			}
			if(DeskInfo[desk][Lastor] == 3) // НИЧЬЯ
			{
   				if(DeskInfo[desk][Timer] > 0) DeskInfo[desk][Timer] --;
   				else if(DeskInfo[desk][Timer] == 0) DeskInfo[desk][Lastor] = 0, reset_walk(desk, 1, 3);
			}
			
			if(DeskInfo[desk][WalkTimer] > 0 && DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Push] == 0)
			{
			    DeskInfo[desk][WalkTimer] --;
			    for(new p = 0; p < MAX_PLAYER_DESK; p++)
				{
				    if(DeskInfo[desk][Playerstatus][p] > 0)
					{
					    new memberid = DeskInfo[desk][Playerid][p];
				    	if(IsOnline(memberid) && DeskStatus[memberid] == 1 && OnlineInfo[memberid][oShowInterface] == 11) upd_walk_timer(desk, memberid, DeskInfo[desk][Walk]-1);
					}
				}
				if(DeskInfo[desk][WalkTimer] == 0)
				{
				    new memberid = DeskInfo[desk][Playerid][DeskInfo[desk][Walk]-1];
					DeskEnterPause[memberid] = unixtime;
					exitsit(memberid, 2);
					S_SetPlayerVirtualWorld(memberid,2001,55), PPSetPlayerInterior(memberid,55);
					PPSetPlayerPos(memberid,DeskOutPos[desk][0],DeskOutPos[desk][1],DeskOutPos[desk][2]), PPSetPlayerFacingAngle(memberid,DeskOutPos[desk][3]);
					SetCameraBehindPlayer(memberid);
					ShowDialog(memberid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Время вышло, вы не сделали ход","*","");
				}
			}
		}
	}

	for(new i;i < MAX_RACERS_POINT;i++)
	{	
		if(StreetRacers[i][raceTimer] > 0) TimerToStart(i); // Таймер для старта гонки
	}

	new RealPlayersOnline = 0; // Количество игроков
	// Таймер на всех игроков
	foreach (Player, i)
	{
		  RealPlayersOnline ++;
		  if(OnlineInfo[i][oLogged] == 0)
		  {
		  		if(Unlogged[i] >= 1) Unlogged[i] --;
		  		if(Unlogged[i] == 1)
		  		{
              		ShowDialog(i,1995,DIALOG_STYLE_MSGBOX,"{ff9000}Kick","{FF6347}Вы не авторизовались в течении 3-ёх минут и были {ff9000}кикнуты!","*","");
		  			Kickx(i);
	  			}
		  }
	      if(OnlineInfo[i][oLogged] >= 1)
		  {
		  	if(CoordMaster_Warn[i] > 0) CoordMaster_Warn[i] --;
		  	if(Fly_Warn[i] > 0) Fly_Warn[i] --;
		    // Возвращаем аксессуары после снайперки
		  	if(Sniper[i] == 1 && GetPlayerCameraMode(i) != CAM_MODE_SNIPER && GetPlayerCameraMode(i) != CAM_MODE_CAMERA)
			{
				Sniper[i] = 0;
				BackAccessory(i);
			}

			// Возвращаем оружие после зелёной зоны
			if(LeaveZZ[i] > 0)
			{
			    LeaveZZ[i] --;
			    if(LeaveZZ[i] == 1) TempGive(i);
			}

			// Возвращаем оружие после спавна
			if(GiveWeaponAfterSpawn[i] > 0)
			{
				GiveWeaponAfterSpawn[i] --;
				if(GiveWeaponAfterSpawn[i] == 0) 
				{
					Protect_MyWeapon(i); // Возвращаем личное оружие
					TempGive(i); // Возвращаем временно лишённое
				}
			}

			// Забираем всё-равно оружие, если чел в зелёной зоне
			if(PozjeZZ[i] == true && Iamzz[i])
			{
				if(GetPlayerWeapon(i) == WEAPON:23 && OnDuty[i] >= 1 || GetPlayerWeapon(i) == WEAPON:41 || GetPlayerWeapon(i) == WEAPON:42 || GetPlayerWeapon(i) == WEAPON:43 || GetPlayerWeapon(i) == WEAPON:46) {}
				else TempTake(i, 1), PozjeZZ[i] = false;
			}
			
			// Butler Bot
			//ProcessButlerNpc(i);
			
			// Готовим Заказ
			if(SelectMenu[i][Time] > 0 && SelectMenu[i][Shop] > 0)
			{
			    SelectMenu[i][Time] --;
				if(OnlineInfo[i][oShowInterface] == 12) updatetimeshop(i);
			    if(SelectMenu[i][Time] == 0)
			    {
			        if(ADUTY[i] == 0)
			        {
				    	SendClientMessage(i, COLOR_GREY, "{0088ff}[ Закусочная ]: {ffcc66}Ваш заказ готов");
						if(OnlineInfo[i][oShowInterface] != 12) SuccessMessage(i, "{99ff66}Ваш заказ готов\n{cccccc}Подойдите на кассу и заберите его");
					}
					PlayerPlaySound(i, 6401, 0.0, 0.0, 0.0);
					SelectMenu[i][Unix] = unixtime+3600;
			        SelectMenu[i][Done] = 1;
			        if(OnlineInfo[i][oShowInterface] == 12)
					{
						PlayerTextDrawHide(i, PlayerBuyDraw[4][i]), PlayerTextDrawHide(i, PlayerBuyDraw[5][i]), PlayerTextDrawHide(i, PlayerBuyDraw[6][i]);
						if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) PlayerTextDrawSetString(i, PlayerBuyDraw[2][i], "3AЂPAЏ’");
						else PlayerTextDrawSetString(i, PlayerBuyDraw[2][i], "TAKE");
						PlayerTextDrawShow(i, PlayerBuyDraw[2][i]);
						PlayerTextDrawSetSelectable(i, PlayerBuyDraw[3][i], true);
						PlayerTextDrawShow(i, PlayerBuyDraw[3][i]);
					}
			    }
			}
			if(RallyInfo[0][rallyStatus] != 0)
			{
				if(IsPlayerInDynamicArea(i,dyn_zone_zzGov) && OnlineInfo[i][oRally] > 0 && GetPVarInt(i,"afksystem") <= 1) SetRallyPoint(i);
			}
			if(ZoneTimer[i] > 0) // Таймер find
			{
				ZoneTimer[i] --;
				if(ZoneTimer[i] == 0) DestroyFindZone(i);
			}

			if(OnlineInfo[i][oRadioInterceptorZoneTimer] > 0) // Таймер поиска радиоперехватчика
			{
				OnlineInfo[i][oRadioInterceptorZoneTimer]--;
				if(OnlineInfo[i][oRadioInterceptorZoneTimer] == 0) DestroyFindZone(i);
			}

			// Возвращение коллизии транспорта
			if(OnlineInfo[i][oCollisionTime] > 0)
			{
				OnlineInfo[i][oCollisionTime] --;
				if(OnlineInfo[i][oCollisionTime] == 0) DisableRemoteVehicleCollisions(i, false);
			}

			// Мысли в облаке рядом с головой
			if(MindStatObject[i] == true && MindTime[i] > 0)
			{
				MindTime[i] --;
				if(MindTime[i] == 0) close_mind_object(i);
			}

			// Система гонки (личная)
			if(OnlineInfo[i][oStatusRace] > 0) 
			{
				if(OnlineInfo[i][oTimerStartRace] > 0) ProcessStartRacePlayer(i);
				else if(OnlineInfo[i][oTimerStartRace] == -1) ProcessCheckRacePlayer(i);
			}

			// Намаз
			if(NamazTimer[i] > 0)
			{
				NamazTimer[i] --;
				if(NamazTimer[i] == 0) NamazEnd(i, 0);
				else NamazProcess(i);
			}

			if(DeathInfo[i][deathStatus]) // Death Player
			{
				if(DeathInfo[i][deathTime] > 0) DeathInfo[i][deathTime] --;
				UpdateDeathProcess(i);
			}

			// UseRevival
			if(OnlineInfo[i][oTimerAnimationRevival] > 0)
			{
				OnlineInfo[i][oTimerAnimationRevival]--;
				if(OnlineInfo[i][oTimerAnimationRevival] == 4) around_player_audio(i, 5204, 0, 10.0, 1);
				else if(OnlineInfo[i][oTimerAnimationRevival] == 0)
				{
					CloseRevival(Moiplayer[i],i);
				}
			}
			// Игра в кости (Далеко отошел)
			if(DicePlayer[i] > 0)
			{
			    new seller = DicePlayer[i]-1;
			    if(IsOnline(seller))
				{
				    if(!IsPlayerInRangeOfPoint(i,5.0,Protect_X[seller],Protect_Y[seller],Protect_Z[seller]))
				    {
				        ErrorMessage(seller, "{FF6347}Игра в кости отменена [ Вы далеко друг от друга ]");
				        ErrorMessage(i, "{FF6347}Игра в кости отменена [ Вы далеко друг от друга ]");
				        DicePlayer[seller] = 0, DiceStat[seller] = 0;
				        DicePlayer[i] = 0, DiceStat[i] = 0;
				    }
				}
			}
			
			if(OnlineInfo[i][oUnixAcceptWanted] > 0)
			{
				OnlineInfo[i][oUnixAcceptWanted]--;
				if(OnlineInfo[i][oUnixAcceptWanted] == 0) return TogglePlayerControllable(i, true);
			}
			// Едет за рулём (качаем навык)
			if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
			{
				new Float:dist = GetDistancePoint(Move_X[i],Move_Y[i],Move_Z[i],Protect_X[i],Protect_Y[i],Protect_Z[i]);
				Move_X[i] = Protect_X[i], Move_Y[i] = Protect_Y[i], Move_Z[i] = Protect_Z[i];
				new quan = floatround(dist/500,floatround_round);
				if(gTypeVehicle[i] == 1) PlayerInfo[i][pCarLic] += dist/500, CompleteBattlePassTask(i,21,1,quan);
				else if(gTypeVehicle[i] == 2) PlayerInfo[i][pHeliLic] += dist/500, CompleteBattlePassTask(i,24,1,quan);
				else if(gTypeVehicle[i] == 3) PlayerInfo[i][pFlyLic] += dist/500, CompleteBattlePassTask(i,23,1,quan);
				else if(gTypeVehicle[i] == 4) PlayerInfo[i][pBoatLic] += dist/500, CompleteBattlePassTask(i,25,1,quan);
				else if(gTypeVehicle[i] == 5) PlayerInfo[i][pMotoLic] += dist/500, CompleteBattlePassTask(i,22,1,quan);
			}

			// Плавное пополнение хп
			if(OnlineInfo[i][oHealthTime] > 0) ProcessHealthPlayer(i);
			
			if(GetPVarInt(i,"antipodbor") >= 1) SetPVarInt(i,"antipodbor",GetPVarInt(i,"antipodbor")-1);
            if(GetPVarInt(i,"temptime") > 0)
			{
				SetPVarInt(i,"temptime",GetPVarInt(i,"temptime")-1);
				if(GetPVarInt(i,"temptime") == 0) SetPVarInt(i,"oryjtemp",0);
			}
            if(Login[6][i] >= 1) Login[6][i] --;
			// Система Подсчёта Online
			if(PlayerInfo[i][pGameDay] == Days)
		 	{
				if(GetPVarInt(i,"afksystem") <= 1)
				{
					if(SleepRP[i] <= 0) PlayerInfo[i][pGameTime] ++;
					else if(SleepRP[i] >= 1) PlayerInfo[i][pGameAfk] ++;
				}
		 		else if(GetPVarInt(i,"afksystem") >= 2) PlayerInfo[i][pGameAfk] ++;
		 		if(PlayerInfo[i][pSoska] >= 1)
			 	{
			 	    new minonl;
			 		if(ServerInfo[26] <= 0) minonl = 3600+10800;
			 		else minonl = 3600+ServerInfo[26]*3600;
					if(HasABustAks(i,4) != -1) minonl /= 2;
			 		if(PlayerInfo[i][pGameTime] == minonl+3600*PlayerInfo[i][pAdmNorm])
				 	{
				 		PlayerInfo[i][pAdmNorm] ++;
						if(HasABustAks(i,4) != -1) PlayerInfo[i][pAdmScore] += (1+ServerInfo[13])*2;
						else PlayerInfo[i][pAdmScore] += 1+ServerInfo[13];
						mysql_save(i, 30);
			 		}
			 	}
			 	else if(PlayerInfo[i][pLeader] >= 1 && PlayerInfo[i][pSoska] == 0)
			 	{
			 		new minonl;
			 		if(ServerInfo[27] <= 0) minonl = 3600+10800;
			 		else minonl = 3600+ServerInfo[27]*3600;
			 		if(PlayerInfo[i][pGameTime] == minonl+3600*PlayerInfo[i][pAdmNorm])
				 	{
				 		PlayerInfo[i][pAdmNorm] ++;
						PlayerInfo[i][pAdmScore] += 1+ServerInfo[31];
						mysql_save(i, 30);
			 		}
			 	}
			}
			else if(PlayerInfo[i][pGameDay] != Days)
		 	{
	 			PlayerInfo[i][pGameTime] = 0;
	 			PlayerInfo[i][pGameAfk] = 0;
	 			PlayerInfo[i][pGameDay] = Days;
	 			if(PlayerInfo[i][pSoska] >= 1 || PlayerInfo[i][pLeader] >= 1) PlayerInfo[i][pAdmNorm] = 0, mysql_save(i, 30);
		 	}
			// if(PlayerInfo[i][pSoska] >= 1 || PlayerInfo[i][pLeader] >= 1) mysql_save(i, 31);
			//==========
			// Антипидор
			if(NoteBanTime[i] >= 1)
			{
				NoteBanTime[i] --;
				if(NoteBanTime[i] == 1)NoteBan[i] = 0;
			}
			if(ASK[i] >= 1) ASK[i] --; // Anti Spawn Kill
			//==========
			
			// Триггер охоты
			new areahunt = IsPlayerInWildZone(i);
			if(areahunt != -1) EventHandlerHuntWildAnimalsWalking(i, areahunt);

			// Спутниковая Антенна
			if(Sate[i] == 1 && PlayerInfo[i][pBkyrenie] >= 2)
			{
				if(SateTime[i] > 0) SateTime[i] --, Update_Sate(i);
				else SendClientMessage(i, COLOR_GREY, "{0088ff}[ NASA ]: Спутниковая Антенна {ffcc66}получила данные"), Sate[i] = 2, Update_Sate(i), pc_cmd_findsate(i);
			}
 			
 			// Слежка за игроком
 			if(PlayerInfo[i][pSoska] >= 1 && LoadSP[i] == true && gSpectateID[i] != INVALID_PLAYER_ID && noclipdata[i][cameramode] == CAMERA_MODE_NONE)
		 	{
		 	    if(IsOnline(gSpectateID[i]))
    			{
    			    UpdateSpecBlock0(i, gSpectateID[i]);
    			    if(GetPlayerState(gSpectateID[i]) == PLAYER_STATE_DRIVER) UpdateSpecBlock1(i, gSpectateID[i]);
    			}
		 	}

			// Отключаем звук
			if(StopAudioTime[i] > 0) StopAudioProcess(i);
 			
            SetPVarInt(i,"afksystem",GetPVarInt(i,"afksystem")+1);
            if(Afenterveh[i] > 0) Afenterveh[i] --;
            if(GetPVarInt(i,"afksystem") >= 3)
            {
            	new tmin = GetPVarInt(i,"afksystem")/60;
				new avrem = tmin*60;
				new avremmin = GetPVarInt(i,"afksystem")-avrem;
                new awer[64];
                if(PursuitTime[i] >= 1 && PlayerInfo[i][pCrimes] >= 1 
					|| (Stun[4][i] >= 1 || Stun[4][i] >= 1) && CuffedId[i] != 9999 && PlayerInfo[i][pCrimes] >= 1)
                {
                	if(PursuitArest[i] > 0) PursuitArest[i] --;
                	new copid, onlcop;
                	if(PursuitTime[i] >= 1) copid = Pursuit[i];
			    	else copid = CuffedId[i];
                	if(IsOnline(copid))
				    {
				        if(OnlineInfo[copid][oLogged] == 1 && ProxDetectorS(30.0, i, copid)) onlcop = 1;
        			}
                	if(onlcop == 1)
                	{
                		new tmin2 = PursuitArest[i]/60;
						new avrem2 = tmin2*60;
						new avremmin2 = PursuitArest[i]-avrem2;
						if(PursuitArest[i] <= 0) ArestPlayer(i, copid, AREST_TYPE_AFK);
                		else format(awer, sizeof(awer), "{444444}На паузе %02d:%02d   {FF6347}Арест через %02d:%02d",tmin,avremmin,tmin2,avremmin2), SetPlayerChatBubble(i,awer,COLOR_WHITE,20.0,1200);
                	}
                	else 
					{
						if(GetPVarInt(i,"afksystem") >= 5) format(awer, sizeof(awer), "{444444}На паузе %02d:%02d",tmin,avremmin), SetPlayerChatBubble(i,awer,COLOR_WHITE,20.0,1200);
					}
				}
                else
				{
					if(GetPVarInt(i,"afksystem") >= 5) format(awer, sizeof(awer), "{444444}На паузе %02d:%02d",tmin,avremmin), SetPlayerChatBubble(i,awer,COLOR_WHITE,20.0,1200);
				}
			}
            if(GetPVarInt(i,"ganteltime") > 0) SetPVarInt(i,"ganteltime",GetPVarInt(i,"ganteltime")-1);
            if(Dei[i] == 2 && DeiStat[i] >= 1)
   			{
   				if(!IsPlayerInRangeOfPoint(i,2.0,Job_X[i], Job_Y[i], Job_Z[i]))
   				{
   					SetPVarInt(i,"oryjtemp", 0), PlayerPlaySound(i,4203,0,0,0);
            		DirtWash[DeiStat[i]-1] = -1;
            		DeiStat[i] = 0;
            	}
            }

			// Гантели
            if(GetPVarInt(i,"gantel") >= 1) CheckDumbbellsPosistion(i);

			// Штанга
            if(GetPVarInt(i,"tips") == 1) CheckWeightsPosistion(i);

			// Беговая дорожка и Велотренажер
            if(GetPVarInt(i,"tips") == 2 || GetPVarInt(i,"tips") == 3) ProcessTrainer(i);


            if(CnnVed[i] == 1) // Чувак за столом в студии
			{
				if(cnnchan == 1) GameTextForPlayer(i, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Прямой Эфир: ~r~Студия"), 1100, 3);
				else if(cnnchan == 2) GameTextForPlayer(i, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Прямой Эфир: ~y~Оператор"), 1100, 3);
			}
			if(CnnVed[i] == 2) // Чувак с камерой
			{
				if(cnnchan == 1) GameTextForPlayer(i, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Прямой Эфир: ~y~Студия"), 1100, 3);
				else if(cnnchan == 2)
				{
			 		GameTextForPlayer(i, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Прямой Эфир: ~r~Оператор"), 1100, 3);
			 		SetPlayerChatBubble(i,"Прямой Эфир: Rec", COLOR_LIGHTRED,20.0,1500);
	 			}
			}
			if(bespilot[i] >= 1)
			{
		 		new Float:health, Float: xPos[3];
 				GetVehicleHealth(GetPlayerVehicleID(i), health);
 				GetVehiclePos(GetPlayerVehicleID(i), xPos[0], xPos[1], xPos[2]);
				if(xPos[2] <= -2.0)
				{
 					EjectBespilot(i);
 					SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Беспилотник упал в воду и был и эвакуирован на базу..."), PlayerPlaySound(i,45400,0,0,0);
 				}
 				if(health <= 450.0)
 				{
 					EjectBespilot(i);
 					SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Беспилотник был сильно повреждён и эвакуирован на базу..."), PlayerPlaySound(i,45400,0,0,0);
 				}
 			}
 			if(Tabs_Load[i] == 1 && OnlineInfo[i][oShowTabs] != 9999)
			{
			    if(!IsOnline(OnlineInfo[i][oShowTabs])) return closetab(i, 1), ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Торговля","\n{cccccc}Продавец куда-то пропал..\n","Ок","");
			    if(!IsPlayerInRangeOfPoint(i,3.0,Protect_X[OnlineInfo[i][oShowTabs]], Protect_Y[OnlineInfo[i][oShowTabs]], Protect_Z[OnlineInfo[i][oShowTabs]])) return closetab(i, 1), ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Торговля","\n{cccccc}Вы оказались далеко от продавца\n","Ок","");
			}
 			if(Goods[i] == 1)
 			{
 				new Float:xxx[3];
    			GetDynamicObjectPos(GoodsObject[i], xxx[0], xxx[1], xxx[2]);
    			if(!IsPlayerInRangeOfPoint(i,3.0,xxx[0], xxx[1], xxx[2]))
				{
					ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Торговля","\n{cccccc}Вы далеко отошли от своей лавки\n{FF6347}Торговля завершена\n","Ок","");
					stopshop(i);
				}
 			}
 			if(Goods[i] >= 2)
 			{
 				new Float:xxx[3], m = Goods[i]-2;
    			GetDynamicObjectPos(MarketObject[m], xxx[0], xxx[1], xxx[2]);
    			if(!IsPlayerInRangeOfPoint(i,3.0,xxx[0], xxx[1], xxx[2]))
				{
					ShowDialog(i,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Торговля","\n{cccccc}Вы далеко отошли от арендованной лавки\n{FF6347}Торговля завершена\n","Ок","");
					stopshop(i);
				}
 			}

			// Игрок продаёт личный транспорт на парковке центре обмена
			if(SellVeh[i])
			{
				if(VehInfo[SellVeh[i]][vSellcar] > 0 // Транспорт имеет статус продажи
					&& GetPlayerVip(i) == 0) // У игрока нет випки
 			    {
					new Float:Pos[3], Float:PosBon[3];
 			    	GetDynamicObjectPos(SellCarObj[0][SellVeh[i]], Pos[0], Pos[1], Pos[2]);
 			    	GetCoordSellCarVehicle(SellVeh[i], PosBon[0], PosBon[1], PosBon[2]);
 			    	new Float:dist = GetDistancePoint(PosBon[0], PosBon[1], PosBon[2], Pos[0], Pos[1], Pos[2]);
 			    	if(!IsPlayerInRangeOfPoint(i,50.0,Pos[0], Pos[1], Pos[2])) stopsellcar(i, SellVeh[i], 1);
 			    	if(dist >= 3.0) stopsellcar(i, SellVeh[i], 2);
				}
			}

			if(Komputer[i] == 1)
			{
				if(!IsPlayerInRangeOfPoint(i,1.5,Job_X[i], Job_Y[i], Job_Z[i])) exitkomp(i, 1);
				SetPlayerChatBubble(i,"использует компьютер", COLOR_PURPLE,20.0,1500);
			}
			if(Komputer[i] == 2) SetPlayerChatBubble(i,"использует ноутбук", COLOR_PURPLE,20.0,1500);
			if(Dei[i] == 1)
			{
				if(!IsPlayerInRangeOfPoint(i,1.5,Job_X[i], Job_Y[i], Job_Z[i])) Dei[i] = 0, SetPVarInt(i,"oryjtemp",0), PlayerPlaySound(i,4203,0,0,0), ClearAnimations(i), ClearAnim(i);
				SetPlayerChatBubble(i,"моет туалет", COLOR_PURPLE,20.0,1500);
			}
			if(Guard[i] >= 1 && GetPVarInt(i,"afksystem") <= 2)
			{
			    if(IsPlayerInRangeOfPoint(i, 30.0, OrganInfo[GuardOrg[i]][gGu_X][Guard[i]-1],OrganInfo[GuardOrg[i]][gGu_Y][Guard[i]-1],OrganInfo[GuardOrg[i]][gGu_Z][Guard[i]-1]) && OrganInfo[GuardOrg[i]][gGuardStat][Guard[i]-1] >= 1
				&& OrganInfo[GuardOrg[i]][gGuInt][Guard[i]-1] == GetPlayerInterior(i) && OrganInfo[GuardOrg[i]][gGuWorld][Guard[i]-1] == GetPlayerVirtualWorld(i))
			    {
				    GuardTime[i] ++;
					new stringa[14];
					new minf = GuardTime[i]/60;
			        new sekf = GuardTime[i]-minf*60;
					format(stringa, sizeof(stringa), "%02d:%02d",minf,sekf);
					PlayerTextDrawSetString(i, MindDraw3, stringa);
					PlayerTextDrawShow(i, MindDraw3);
			    }
			    else
				{
					new atext[2];
					if(PlayerInfo[i][pSex] == 1) atext = "";
					else atext = "а";
					SetPlayerChatBubble(i,"покидает пост",COLOR_PURPLE,20.0,3000);
					format(string,sizeof(string),"[ Мысли ]: Я {FF6347}покинул%s {cccccc}пост для наблюдения [ Моё время: {ff9000}%d мин {cccccc}]",atext,GuardTime[i]/60);
					SendClientMessage(i, COLOR_GREY, string);
					ExitGuard(i), PlayerPlaySound(i,4203,0,0,0);
				}
			}

			// Прорубь
			if(IceHoleUnix[i] > 0)
			{
				IceHoleUnix[i]--;
				if(IceHoleUnix[i] <= 0) DestroyIceHole(i);
			}
			
			// Новогодний квест
			if(OnlineInfo[i][oNewYearQuest] == 1) LifeNewYearQuestOne(i);
			if(OnlineInfo[i][oNewYearQuest] == 2 || OnlineInfo[i][oNewYearQuest] >= 4 && OnlineInfo[i][oNewYearQuest] <= 6) HandlerNewYearQuestTwo(i);
			if(OnlineInfo[i][oNewYearQuest] == 10)
			{
				if(IsAWindowNewYear(i) && OnlineInfo[i][oNewYearQuestDop] < 120)
				{
					OnlineInfo[i][oNewYearQuestDop]++;
					format(string,sizeof(string),"Мне нужно подглядывать в окна Йольских Парней. Осталось подглядывать %d секунд",120-OnlineInfo[i][oNewYearQuestDop]);
					SetPlayerHudTask(i, "Новогодний Квест", string);
				}
				if(OnlineInfo[i][oNewYearQuestDop] >= 120) SetPlayerHudTask(i, "Новогодний Квест", "Я отстоял нужное время, теперь мне нужно придти к Йольскому парню за наградой");
			}

			// Слушает ли радио
			if(OnlineInfo[i][oListenRadioPears]) CompleteBattlePassTask(i, 6, 1);

			// Офаем колор от скина
			if(IsANotMoney(i))
			{
				if(ResultCountBustSkin(PlayerInfo[i][pModel],1,PlayerInfo[i][pModel2]) == 1) SetPlayerColor(i, NONE_COLOR);
			}
			else
			{
				if(GetPlayerColor(i) == NONE_COLOR) SetPlayerColor(i, INV_COLOR);
			}
			/*
			new Stun[6][MAX_REALPLAYERS];
			new StunTime[6][MAX_REALPLAYERS];
			0 - связан
			1 - мешок
			2 - багажник
			3 - бита или дубинка 3 удара
			4 - наручники
			5 - смирительная рубашка
			*/
			if(StunTime[0][i] >= 1) StunTime[0][i] --;
			//if(StunTime[1][i] >= 1) StunTime[1][i] --;
			if(StunTime[2][i] >= 1) StunTime[2][i] --;
			if(StunTime[3][i] >= 1) StunTime[3][i] --;
			if(StunTime[4][i] >= 1 && !IsPlayerInVehicle(i, prisonbus_LS) && !IsPlayerInVehicle(i, prisonbus_SF)) StunTime[4][i] --;
			if(StunTime[5][i] >= 1) StunTime[5][i] --;
			if(howstun(i))
			{
				if(Stun[0][i] >= 1)
				{
					if(PlayerInfo[i][pSex] == 1) format(string, sizeof(string), "связан [%d]", StunTime[0][i]);
					else format(string, sizeof(string), "связана [%d]", StunTime[0][i]);
					SetPlayerChatBubble(i,string, COLOR_LIGHTRED,20.0,1500);
					if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) format(string, sizeof(string), RusToGame("Развяжусь: %d сек"), StunTime[0][i]);
					else format(string, sizeof(string), "Untied: %d sec", StunTime[0][i]);
					PlayerTextDrawSetString(i, MindDraw1, string);
					PlayerTextDrawShow(i, MindDraw1);
					if(StunTime[0][i] == 0)
					{
					    SuccessMessage(i, "{99ff66}Вы развязались");
						if(PlayerInfo[i][pSex] == 1)
						{
							format(string, sizeof(string), "* %s вытащил руку из верёвок и развязался", playername(i)), ProxDetector(20.0, i, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
							SetPlayerChatBubble(i,"вытащил руку из верёвок и развязался",COLOR_PURPLE,30.0,7000);
						}
						else
						{
							format(string, sizeof(string), "* %s вытащила руку из верёвок и развязалась", playername(i)), ProxDetector(20.0, i, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
							SetPlayerChatBubble(i,"вытащила руку из верёвок и развязалась",COLOR_PURPLE,30.0,7000);
						}
						TextDrawHideForPlayer(i, MindDraw[0]), TextDrawHideForPlayer(i, MindDraw[1]), TextDrawHideForPlayer(i, MindDraw[2]);
						PlayerTextDrawHide(i, MindDraw1), PlayerTextDrawHide(i, MindDraw2);
						GameTextForPlayer(i, "~g~Untied", 5000, 3);
						if(IsPlayerInAnyVehicle(i)) TogglePlayerControllable(i, true);
						Stun[0][i] = 0, StunTime[0][i] = 30;
						SetPlayerSpecialAction(i,SPECIAL_ACTION_NONE);
					}
				}
				if(Stun[2][i] >= 1)
				{
					if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) format(string, sizeof(string), RusToGame("Освобожусь: %d сек"), StunTime[2][i]);
					else format(string, sizeof(string), "Free: %d sec", StunTime[2][i]);
					PlayerTextDrawSetString(i, MindDraw1, string);
					PlayerTextDrawShow(i, MindDraw1);
					if(StunTime[2][i] == 0)
					{
						new boot_vehicleid = GetPVarInt(i, "Boot");
					    if(boot_vehicleid > 0)
						{
							if(IsValidVehicle(boot_vehicleid)) {
								if(VehInfo[boot_vehicleid][vPeople] > 0 && VehInfo[boot_vehicleid][vPeople] - 1 == i) {
									EjectBoot(i, boot_vehicleid);
								}
							}
						}
						SuccessMessage(i, "{99ff66}Вы сломали замок и выбрались из багажника");
						if(PlayerInfo[i][pSex] == 1)
						{
							format(string, sizeof(string), "* %s сломал замок и выбрался из багажника", playername(i)), ProxDetector(20.0, i, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
							SetPlayerChatBubble(i,"сломал замок и выбрался из багажника",COLOR_PURPLE,30.0,7000);
						}
						else
						{
							format(string, sizeof(string), "* %s сломала замок и выбралась из багажника", playername(i)), ProxDetector(20.0, i, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
							SetPlayerChatBubble(i,"сломала замок и выбралась из багажника",COLOR_PURPLE,30.0,7000);
						}
					}
				}
				if(Stun[3][i] >= 1)
				{
					if(PlayerInfo[i][pSex] == 1) format(string, sizeof(string), "оглушён [%d]", StunTime[3][i]);
					else format(string, sizeof(string), "оглушена [%d]", StunTime[3][i]);
					SetPlayerChatBubble(i,string, COLOR_LIGHTRED,20.0,1500);
					TogglePlayerControllable(i, false);
					if(!IsPlayerInAnyVehicle(i)) ApplyAnimation(i,"CRACK","crckdeth2",4.0, false, true, true, true, true, SYNC_ALL);
					if(StunTime[3][i] == 0)
					{
						Stun[3][i] = 0;
						StunTime[3][i] = 30;
						NoAnim[i] = 0;
						if(Stun[2][i] == 0 && Stun[4][i] == 0 && Stun[5][i] == 0)
						{
							TogglePlayerControllable(i, true);
							if(!IsPlayerInAnyVehicle(i)) ClearAnimations(i), ClearAnim(i);
							CuffedId[i] = 9999;
						}
						RemovePlayerAttachedObject(i,0);
					}
				}
				if(Stun[4][i] >= 1)
				{
					// if(IsPlayerInAnyVehicle(i)) TogglePlayerControllable(i, false);
					/*if(!IsPlayerInAnyVehicle(i))
					{
						if(Stun[0][i] == 0 && Stun[3][i] == 0) TogglePlayerControllable(i, true);
					}*/
					if(GetPlayerSpecialAction(i) != SPECIAL_ACTION_CUFFED) SetPlayerSpecialAction(i,SPECIAL_ACTION_CUFFED);
					if(StunTime[4][i] == 0)
					{
						// Система ломания наручников (Вырезана)
						/*format(string, sizeof(string), "* %s ломает наручники и освобождается.", playername(i));
					  	ProxDetector(30.0, i, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
						if(PlayerInfo[i][pSex] == 1) SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Я сломал наручники!");
						else SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Я сломала наручники!");
						SetPlayerChatBubble(i,"ломает наручники и освобождается",COLOR_PURPLE,20.0,3000);
						if(Stun[1][i] == 0 && Stun[3][i] == 0) TogglePlayerControllable(i, true);
						if(Follow[i] != 9999 && FollowTime[i] == 0)
						{
							new copid = Follow[i];
							if(IsOnline(copid))
							{
								if(OnlineInfo[copid][oLogged] == 1)
								{
									format(string, sizeof(string), "[ Мысли ]: Подозреваемый {ffcc00}%s {cccccc}сломал наручники", playername(i)), SendClientMessage(copid, COLOR_GREY, string);
									Follow[copid] = 9999, FollowTime[copid] = 0;
								}
							}
							Follow[i] = 9999, FollowTime[i] = 0;
						}
			          	SetPlayerSpecialAction(i,SPECIAL_ACTION_NONE);
			          	RemovePlayerAttachedObject(i,0);
			          	NoAnim[i] = 0;
			          	Stun[4][i] = 0;
						StunTime[4][i] = 0;
						if(Stun[3][i] == 0 && Stun[5][i] == 0) CuffedId[i] = 9999;*/
					}
				}
				if(Stun[5][i] >= 1)
				{
					// if(IsPlayerInAnyVehicle(i)) TogglePlayerControllable(i, false);
					if(!IsPlayerInAnyVehicle(i))
					{
						if(Stun[0][i] == 0 && Stun[3][i] == 0) TogglePlayerControllable(i, true);
					}
					if(GetPlayerSpecialAction(i) != SPECIAL_ACTION_CUFFED) SetPlayerSpecialAction(i,SPECIAL_ACTION_CUFFED);
					if(StunTime[5][i] == 0)
					{
						format(string, sizeof(string), "* %s ломает застёжку и высвобождается из смирительной рубашки.", playername(i));
					  	ProxDetector(30.0, i, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
						if(PlayerInfo[i][pSex] == 1) SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Я сломал застёжку и освободился!");
						else SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Я сломала застёжку и освободился!");
						SetPlayerChatBubble(i,"ломает застёжку и высвобождается из смирительной рубашки",COLOR_PURPLE,20.0,3000);
						if(Stun[1][i] == 0 && Stun[3][i] == 0) TogglePlayerControllable(i, true);
			          	SetPlayerSpecialAction(i,SPECIAL_ACTION_NONE);
			          	RemovePlayerAttachedObject(i,0);
			          	NoAnim[i] = 0;
			          	Stun[5][i] = 0;
						StunTime[5][i] = 0;
						if(Stun[3][i] == 0 && Stun[4][i] == 0) CuffedId[i] = 9999;
					}
				}
				if(Stun[1][i] >= 1 && Stun[0][i] == 0 && Stun[3][i] == 0 && Stun[4][i] == 0 && Stun[5][i] == 0) SetPlayerChatBubble(i,"мешок на голове", COLOR_LIGHTRED,20.0,1500);
			}
			if(gRedakt[i] == REDAKT_TYPE_FURNITURE_SET) SetPlayerChatBubble(i,"расставляет мебель", COLOR_PURPLE,20.0,1500);
			if(gRedakt[i] == REDAKT_TYPE_FURNITURE_MOVE) SetPlayerChatBubble(i,"переставляет мебель", COLOR_PURPLE,20.0,1500);
			if(SleepRP[i] == 1)
			{
				if(!IsPlayerInRangeOfPoint(i, 1.5, Job_X[i], Job_Y[i], Job_Z[i]))
		  		{
		  			TogglePlayerControllable(i, true);
		    		ClearAnim(i);
		    		NoAnim[i] = 0;
		    		Sleep[i] = 0, SleepTime[i] = 0, SleepRP[i] = 0;
		    		SetCameraBehindPlayer(i);
		    		PlayerPlaySound(i, 4203, 0, 0, 0);
		    		HidePlayerDialog(i);
		  		}
				SetPlayerChatBubble(i,"спит ((Role Play))", COLOR_PURPLE,20.0,1500);
			}
			if(PoliceStick[1][i] >= 1) PoliceStick[1][i] --;
			
			// Образовательный Центр
			if(Ash[i] > 0)
    	    {
				AshTime[i] --;
				format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~%d cek",AshTime[i]), GameTextForPlayer(i,string, 1500, 3);
				switch(Ash[i])
 				{
     				case 1: format(string, sizeof(string), "Вождение автомобилей: %d",AshTime[i]);
     				case 2: format(string, sizeof(string), "Пилотирование самолетов: %d",AshTime[i]);
     				case 3: format(string, sizeof(string), "Пилотирование вертолетов: %d",AshTime[i]);
     				case 4: format(string, sizeof(string), "Вождение катеров: %d",AshTime[i]);
     				case 5: format(string, sizeof(string), "Вождение мототранспорта: %d",AshTime[i]);
     				case 6: format(string, sizeof(string), "Русский язык: %d",AshTime[i]);
     				case 7: format(string, sizeof(string), "Японский язык: %d",AshTime[i]);
     				case 8: format(string, sizeof(string), "Итальянский язык: %d",AshTime[i]);
     				case 9: format(string, sizeof(string), "Китайский язык: %d",AshTime[i]);
     				case 10: format(string, sizeof(string), "Испанский язык: %d",AshTime[i]);
     				case 11: format(string, sizeof(string), "Арабский язык: %d",AshTime[i]);
 				}
 				if(AshTime[i] == 0) end_lesson(i, Ash[i]);
    	    }

    	    if(Exam[i] > 0)
    	    {
    	        if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
    	        {
	    	        new neewmodel, v = GetPlayerVehicleID(i);
	    	        if(Exam[i] == 1) neewmodel = 426;
	    	        else if(Exam[i] == 2) neewmodel = 593;
	    	        else if(Exam[i] == 3) neewmodel = 452;
	    	        else if(Exam[i] == 4) neewmodel = 586;
	    	        if(VehInfo[v][vModel] == neewmodel)
	    	        {
	    	        	AshTime[i] ++;
	    	        	if(AshTime[i] >= 360)
	    	        	{
	    	        	    DisablePlayerRaceCheckpoint(i);
	    	        	    ErrorMessage(i, "{FF6347}Вы проходите экзамен более 6-ти минут {cccccc}[ Система вернула вас в образовательный центр ]");
	    	        	    if(IsAAgetcar(agetvelo[i])) AgetDestroy(i);
	    	        	    reset_pos_lesson(i);
	    	        	    Exam[i] = 0, Lesson[i] = 0;
	    	        	}
    	        	}
    	        }
    	    }
    	    
            if(prote[0][i] >= 1) prote[0][i] --;
            if(prote[1][i] >= 1) prote[1][i] --;
            if(prote[2][i] >= 1) prote[2][i] --;
            if(prote[3][i] >= 1) prote[3][i] --;
            if(prote[4][i] > 0) prote[4][i] --;

            if(TempMolotov[i] > 0)
			{
				TempMolotov[i] --;
				if(TempMolotov[i] == 0) Protect_Remove(i, 18);
			}
            if(ProteStat[i] >= 1)
            {
            	ProteStat[i] --;
            	if(ProteStat[i] == 1)
            	{
					if (!IsPlayerAfk(i)) {
						BeforeProtect_X[i] = 5000.0; BeforeProtect_Y[i] = 5000.0; BeforeProtect_Z[i] = 5000.0;
            			AfterProtect_X[i] = 5000.0; AfterProtect_Y[i] = 5000.0; AfterProtect_Z[i] = 5000.0;
					}
            	}
            }
            if(ProteWarn[i] >= 1) ProteWarn[i] --;
			if(PlayerRadarInfo[i][priCooldown] >= 1) PlayerRadarInfo[i][priCooldown] --;

            if(GetPVarInt(i,"antifsit") > 0) SetPVarInt(i,"antifsit",GetPVarInt(i,"antifsit")-1);
            if(GetPVarInt(i,"antiflood") > 0) SetPVarInt(i,"antiflood",GetPVarInt(i,"antiflood")-1);
            if(GetPVarInt(i,"afmysql") > 0) SetPVarInt(i,"afmysql",GetPVarInt(i,"afmysql")-1);
            if(GetPVarInt(i,"aflist") > 0) SetPVarInt(i,"aflist",GetPVarInt(i,"aflist")-1);
            if(GetPVarInt(i,"afdonate") > 0) SetPVarInt(i,"afdonate",GetPVarInt(i,"afdonate")-1);

			// КД наркотиков
			if(DrugsCooldown[i] > 0) DrugsCooldown[i]--;	
            
            // Проверяем Водителя Автобуса
			if(GetPVarInt(i,"job_stat") == 12 && GetPVarInt(i,"qweststat") == 0)
			{
			    if(bustime[i] >= 1000 && unixtime > bustime[i])
			    {
			        if(unixtime-bustime[i] > 600)
					{
					    ShowDialog(i,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Дежурство в автобусном депо отменено!\nВы слишком долго ехали на автобусную остановку","*","");
					    if(driverid[i] > 0) ExitBusDriver(i);
					}
			    }
			}
            
            // Только если чел не AFK | Игрок не AFK
            if(GetPVarInt(i,"afksystem") <= 1)
			{

			if(OnlineInfo[i][oInteriorTime] > 0) OnlineInfo[i][oInteriorTime] --; // Считаем время для смены инта, пока игрок не AFK

			// Действие солнцезащитного крема
			if(PlayerInfo[i][pSunScreen] > 0) ProcessSunScreen(i);

			// Установка хп от повреждений
			ReloadHealth(i);

			// Защита от игнора спавна
			if(OnlineInfo[i][oSpawnDo] == true) AntiIgnoreSpawn(i);
			
			// Вампир Горит на Солнце
			if(vampire[i] == 1 && !DeathInfo[i][deathStatus])
			{
				if(HealthAC[i] > 1.0) ACSetPlayerHealth(i, HealthAC[i]-1.0);
			    if(tmphour <= 5 || tmphour >= 22
					|| Pogoda == 4 || Pogoda == 8 || Pogoda == 9
					|| MPGO[i] > 0 || gSkafandr[i] > 0 || gFormavvs[i] > 0) RemovePlayerAttachedObject(i, 0), vampire[i] = 0;
			}

			// Автопереворот транспорта
			if(GetPlayerState(i) == PLAYER_STATE_DRIVER && PlayerInfo[i][pAutoFlipOff] == false) CheckFlipVehicle(i);
			
			// Простуда
			if(IsAWinter())
			{
				if(GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0 && MPGO[i] == 0 && GetPlayerState(i) == PLAYER_STATE_ONFOOT && Effect[i] != 5)
				{
					GetAnimationName(GetPlayerAnimationIndex(i),animlib,32,animname,32);
					if(strcmp(animlib, "SWIM", true) == 0 
						&& getillness(i, 14) == -1
						&& getillness(i, 15) == -1
						&& getillness(i, 16) == -1
						&& getillness(i, 17) == -1
						&& Sex[i] == 0)
						//CA_IsPlayerNearWater(i, 1.0, 1.0)
					{
						InfectInfo(i);
						infect(i, 14, 4);
					}
				}
			}
			
			// Заразная Болезнь
			if(incold[i] > 0)
			{
				if(PlayerInfo[i][pColdCD] < unixtime)
				{
					new zc = incold[i] - 1, bool:yesInfect;
					if(ContagiousInfect(zones_coldstat[zc]) && getillness(i, zones_coldstat[zc]) == -1) // Точно заразная и у меня такой болезни нет
					{
						if(IsPlayerInAnyVehicle(zc) && IsPlayerInAnyVehicle(i) && GetPlayerVehicleID(zc) == GetPlayerVehicleID(i)) yesInfect = true; // Сидим в одном тс
						else if(GetPlayerState(zc) == PLAYER_STATE_ONFOOT && GetPlayerState(i) == PLAYER_STATE_ONFOOT) yesInfect = true; // Стоим рядом
						if(yesInfect == true)
						{
							infect(i, zones_coldstat[zc], 4);
							if(server == 0)
							{
								format(string,sizeof(string),"{ff0000}Заразная болезнь id %d {cccccc(Отображается только на тестовом)", zones_coldstat[zc]);
								SendClientMessage(i, COLOR_GREY, string);
							}
						}
					}
				}
			}
			
			afk_cam(i); // Проверка на AFK болтание камерой
			if(GetPlayerState(i) == PLAYER_STATE_DRIVER && WatchSpeed[i] >= 30 && Follow[i] != 9999 && FollowTime[i] == 1)
			{
				if(IsOnline(Follow[i]))
				{
					if(OnlineInfo[Follow[i]][oLogged] == 1 && !IsPlayerInAnyVehicle(Follow[i]) && GetPlayerVehicleID(Follow[i]) != GetPlayerVehicleID(i)) StopFollow(Follow[i]);
