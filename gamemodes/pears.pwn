	{
		if(Blockas[3] == 1) return ErrorMessage(playerid, "{FF6347}Извините.. Центр обмена временно закрыт администрацией\n\n{cccccc}Возможно был обнаружен баг, который уже исправляют разработчики");
		if(response)
		{
			if(PlayerInfo[playerid][pTid] >= 0) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас редактировать свою сделку");
			new perv = PlayerInfo[playerid][pTslot][0];
			new vtor = PlayerInfo[playerid][pTslot][1];
			new tret = PlayerInfo[playerid][pTslot][2];
			if(listitem < 0 || listitem >= MAX_MYVEHICLE) return 0;

			new sla = DP[0][playerid];
			new slotid = List[listitem][playerid];
			new vehicleid = PlayerInfo[playerid][pMyVehID][slotid];

			if(VehInfo[vehicleid][vSost] != PlayerInfo[playerid][pID]) return ErrorMessage(playerid, "{FF6347}Ошибка! Это не ваш личный транспорт\n\n{cccccc}Обратитесь к администрации, для решения этой проблемы");
			if(VehInfo[vehicleid][vNosell] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя продать транспорт, созданный для медиа");
			if(PlayerInfo[playerid][pVehTax][slotid] > 0) return ErrorMessage(playerid, "{FF6347}Вам необходимо оплатить налоги на транспорт");

			if(perv == 4 && PlayerInfo[playerid][pTamount][0] == slotid + 1 
			|| vtor == 4 && PlayerInfo[playerid][pTamount][1] == slotid + 1  
			|| tret == 4 && PlayerInfo[playerid][pTamount][2] == slotid + 1 ) return ErrorMessage(playerid, "{FF6347}Транспорт из этого слота уже добавлен в сделку");
			
			PlayerInfo[playerid][pTslot][sla] = 4; // 4 - Транспорт
			PlayerInfo[playerid][pTmodel][sla] = vehicleid; // id транспорта на сервере
			PlayerInfo[playerid][pTamount][sla] = slotid + 1; // Номер слота (+1, чтобы не было ноля)

			for(new i = 0; i < MAX_MYVEHICLE; i++) PlayerInfo[playerid][pTnoveh][i] = 0;
			PlayerInfo[playerid][pTstope][sla] = slotid + 1;

			new skoko = rate(PlayerInfo[playerid][pTslot][sla], PlayerInfo[playerid][pTmodel][sla]);
			PlayerInfo[playerid][pTlave] += skoko;

   			PlayerPlaySound(playerid,6401,0,0,0);
		    pc_cmd_trade(playerid, "");
			UpdateTrade(playerid);
		}
		else pc_cmd_trade(playerid, "");
	}
