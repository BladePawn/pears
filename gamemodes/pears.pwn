stock stop_dialog(playerid)
{
    Login[5][playerid] = GetTickCount();
    return 1;
}

stock IsDialogOpened(playerid)
{
	return !OnlineInfo[playerid][oDialogClosed];
}

stock PosGangDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 1 || setting_size_draw[playerid] == 1) positiond_x = gangdraw_x+set_pos_x[playerid], positiond_y = gangdraw_y+set_pos_y[playerid];
    else positiond_x = gangdraw_x+PlayerInfo[playerid][pDrawPos_X][0], positiond_y = gangdraw_y+PlayerInfo[playerid][pDrawPos_Y][0];
    if(setting_pos_draw[playerid] == 1 || setting_size_draw[playerid] == 1) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][0], sized_y = PlayerInfo[playerid][pDrawSize_Y][0];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[0], positiond_y += DrawPosSmart_Y[0], sized_y += DrawSizeSmart_Y[0];

    new Float:koef;
	koef = (45.888893+sized_y)/100;
    
    PlayerTextDrawSetPos(playerid, PlayerGangDraw[0][playerid], positiond_x, positiond_y); // Фон Чекера
    PlayerTextDrawSetPos(playerid, PlayerGangDraw[1][playerid], positiond_x+16.8716885+sized_x/4, positiond_y+koef*4.0); // Название первой команды
    PlayerTextDrawSetPos(playerid, PlayerGangDraw[2][playerid], positiond_x+50.6150655+sized_x-sized_x/4, positiond_y+koef*4.0); // Название второй команды
    PlayerTextDrawSetPos(playerid, PlayerGangDraw[3][playerid], positiond_x, positiond_y+8.244415+sized_y/4); // Фон подсвечивания первой команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[4][playerid], positiond_x+33.743377+sized_x/2, positiond_y+8.244415+sized_y/4); // Фон подсвечивания второй команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[5][playerid], positiond_x, positiond_y+8.244415+sized_y/4); // Полоска заполнения первой команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[6][playerid], positiond_x+33.743377+sized_x/2, positiond_y+8.244415+sized_y/4); // Полоска заполнения второй команды
	
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[7][playerid], positiond_x+16.8716885+sized_x/4, positiond_y+koef*30.0); // Счётчик первой команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[8][playerid], positiond_x+50.6150655+sized_x-sized_x/4, positiond_y+koef*30.0); // Счетчик второй команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[9][playerid], positiond_x+33.743377+sized_x/2, positiond_y+koef*83.0); // Время капта или битвы
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[10][playerid], positiond_x+1.0, positiond_y+koef*85.0); // Участники первой команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[11][playerid], positiond_x+66.486754+sized_x, positiond_y+koef*85.0); // Участники второй команды
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[12][playerid], positiond_x-26.619781-sized_x, positiond_y+10.111061); // Черепушка мои килы
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[13][playerid], positiond_x-12.9349515-sized_x/2, positiond_y+koef*37.0); // Количество моих килов
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[14][playerid], positiond_x-12.9349515-sized_x/2, positiond_y+koef*73.0); // Нанесённый мною дамаг
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[15][playerid], positiond_x+59.11435+sized_x-sized_x/4, positiond_y+koef*103.0); // Режим хедшотов
	PlayerTextDrawSetPos(playerid, PlayerGangDraw[16][playerid], positiond_x+67.486754+sized_x, positiond_y+koef*103.0); // Режим +C
	
	PlayerTextDrawTextSize(playerid, PlayerGangDraw[0][playerid], 67.486754+sized_x, 45.888893+sized_y); // Фон Чекера +
	PlayerTextDrawTextSize(playerid, PlayerGangDraw[3][playerid], 33.743377+sized_x/2, 29.866666+sized_y/2); // Фон подсвечивания первой команды +
	PlayerTextDrawTextSize(playerid, PlayerGangDraw[4][playerid], 33.743377+sized_x/2, 29.866668+sized_y/2); // Фон подсвечивания второй команды +
	PlayerTextDrawTextSize(playerid, PlayerGangDraw[5][playerid], 33.743377+sized_x/2, 20.066658+sized_y/2); // Полоска заполнения первой команды +
	PlayerTextDrawTextSize(playerid, PlayerGangDraw[6][playerid], 33.743377+sized_x/2, 10.733325+sized_y/2); // Полоска заполнения второй команды +
	PlayerTextDrawTextSize(playerid, PlayerGangDraw[12][playerid], 27.369659+sized_x, 27.533344+sized_y); // Черепушка мои килы
	
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[1][playerid], 0.106941+sized_x*(0.106941/50), 0.507999+sized_y*(0.507999/40)); // Название первой команды
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[2][playerid], 0.106941+sized_x*(0.106941/50), 0.507999+sized_y*(0.507999/40)); // Название второй команды
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[7][playerid], 0.407633+sized_x*(0.407633/50), 1.660666+sized_y*(1.660666/40)); // Счётчик первой команды
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[8][playerid], 0.407633+sized_x*(0.407633/50), 1.660666+sized_y*(1.660666/40)); // Счетчик второй команды
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[9][playerid], 0.151183+sized_x*(0.151183/50), 0.759999+sized_y*(0.759999/40)); // Время капта или битвы
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[10][playerid], 0.123813+sized_x*(0.123813/50), 0.643332+sized_y*(0.643332/40)); // Участники первой команды
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[11][playerid], 0.123813+sized_x*(0.123813/50), 0.643332+sized_y*(0.643332/40));  // Участники второй команды
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[13][playerid], 0.244541+sized_x*(0.244541/40), 1.067998+sized_y*(1.067998/30)); // Количество моих килов
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[14][playerid], 0.123813+sized_x*(0.123813/50), 0.64333+sized_y*(0.64333/40)); // Нанесённый мною дамаг
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[15][playerid], 0.145934+sized_x*(0.145934/50), 0.722665+sized_y*(0.722665/40)); // Режим хедшотов
	PlayerTextDrawLetterSize(playerid, PlayerGangDraw[16][playerid], 0.145934+sized_x*(0.145934/50), 0.72266+sized_y*(0.72266/40)); // Режим +C
	return 1;
}
