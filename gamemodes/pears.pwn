    {
    	if(teta == ana || tetb == ana || tetc == ana || tetd == ana || tete == ana || tetf == ana)format(str,sizeof(str),"{99ff66}%s\n",animName[ana]); // Включена такая анимка
    	else format(str,sizeof(str),"{cccccc}%s\n",animName[ana]); // Нет такой анимки
     	strcat(sctring,str);
