	mysql_tquery(pearsq, "SELECT * FROM `pp_tradecrypto`", "LoadTradeCrypto", ""); // Загрузка трейлеров
	mysql_tquery(pearsq, "SELECT * FROM `fund_raisers`", "LoadFundRaisers", ""); // Загрузка сборов пожертвований
	mysql_tquery(pearsq, "SELECT * FROM `pp_crime`", "LoadCrime", ""); // Загрузка списка преступлений 
