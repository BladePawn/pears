 		mysql_tquery(pearsq, string, "Call_rname", "ds", playerid, PlayerInfo[playerid][pName]);
	}
	else
	{
	    new tmp[24], playa;
		if(sscanf(params, "s[24]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Посмотреть зарезервированные ник неймы [ /rname ID ]");
		playa = ReturnUser(tmp, 1);
