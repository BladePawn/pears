				}
	   		}
	  	}
   		else if(rulstol[rt] == 2)
    	{
    		if(rultime[rt] >= 1) rultime[rt] --, update_label_rul(rt);
	   		else if(rultime[rt] == 0)
	   		{
	   			new chisl = random(36 + 1);
	   			foreach(Player, pl)
				{
					if(OnlineInfo[pl][oLogged] == 1 && GetPVarInt(pl,"kas") == 6 && GetPVarInt(pl,"kstol") == rt) CheckRuletka(pl,chisl);
				}
				//StopDynamicObject(RuletObject[rt]);
				//SetDynamicObjectPos(RuletObject[rt], RuletPos[rt][0], RuletPos[rt][1], RuletPos[rt][2]);
				//SetDynamicObjectRot(RuletObject[rt], 0.0, 0.0, 0.0);
