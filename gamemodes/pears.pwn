	case 918:
	{
		new d = DP[4][playerid];
		new page = GetPVarInt(playerid, "DomObjectPage");
		new i = List[listitem][playerid];
		if(!IsANearWardrobeDom(playerid, d)) return ErrorMessage(playerid, "{FF6347}Вы не в интерьере или далеко от дома");
	
		if(response)
	    {
			if (i == MAX_OBJECT_INT + 1) { // Далее
               return ShowAllObject(playerid, d, DP[1][playerid], page + 1);
            } else if (i == MAX_OBJECT_INT + 2) { // Назад
               return ShowAllObject(playerid, d, DP[1][playerid], page - 1);
            }
            if(DomInfo[d][dSell] >= 1) return ErrorMessage(playerid, "{FF6347}Нельзя ремонтировать дом во время продажи");
			if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
			if(howstun(playerid)) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
  			if(DP[1][playerid] == 2) // Перемещение Предмета
  			{
				if(ElectricianConnect[d] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя ремонтировать дом во время ожидания электриков");
  			    if(i == 0) return ErrorText(playerid, "[ Мысли ]: Нельзя перемещать планировку"), ShowAllObject(playerid, d, DP[1][playerid]);
				if(IsAFrameObject(DomInfo[d][dOmodel][i])) return ErrorText(playerid, "[ Мысли ]: В этом доме нельзя перемещать объекты планировки"), ShowAllObject(playerid, d, DP[1][playerid]);
				if(DomInfo[d][dOmodel][i] == 0) return ShowAllObject(playerid, d, DP[1][playerid], page);
				EditObjectDom(playerid, d, i);
			}
			else if(DP[1][playerid] == 3) // Убираем Предмет
  			{
				if(ElectricianConnect[d] == 1) return ErrorMessage(playerid, "{FF6347}Нельзя ремонтировать дом во время ожидания электриков");
                if(i == 0) return ErrorText(playerid, "[ Мысли ]: Нельзя убрать планировку"), ShowAllObject(playerid, d, DP[1][playerid]);
				if(IsAFrameObject(DomInfo[d][dOmodel][i])) return ErrorText(playerid, "[ Мысли ]: В этом доме нельзя убирать объекты планировки"), ShowAllObject(playerid, d, DP[1][playerid]);
  				if(DomInfo[d][dOmodel][i] == 0) return ShowAllObject(playerid, d, DP[1][playerid], page);
  				DeleteObjectDom(playerid, d, i);
				ShowAllObject(playerid, d, DP[1][playerid]);
			}
  			else if(DP[1][playerid] == 4) // Ретекстур предмета
  			{
  				if(DomInfo[d][dOmodel][i] == 0) return ShowAllObject(playerid, d, DP[1][playerid], page);
				EditTextureDom(playerid, d, i);
  			}
		}
		else 
		{
			if(MenuInfo[playerid][zStat] == 0) format(string, sizeof(string), "%d", d), pc_cmd_dedit(playerid, string);
		}
	}
