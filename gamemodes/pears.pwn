						else format(str,sizeof(str),"{99ff66}[Online]   {cccccc}%s[%d]  Рейтинг: %d  AFK: %d сек.\n",PlayerInfo[giveplayerid][pName],giveplayerid,PlayerInfo[giveplayerid][pAmmos6],GetPVarInt(giveplayerid,"afksystem")), strcat(sctring,str);
					}
					else
					{
						if(PlayerInfo[giveplayerid][pExchat] >= 1) format(str,sizeof(str),"{99ff66}[Online]   {66ffcc}%s[%d]  {cccccc}Рейтинг: %d\n",PlayerInfo[giveplayerid][pName],giveplayerid,PlayerInfo[giveplayerid][pAmmos6]), strcat(sctring,str);
						else format(str,sizeof(str),"{99ff66}[Online]   {cccccc}%s[%d]  Рейтинг: %d\n",PlayerInfo[giveplayerid][pName],giveplayerid,PlayerInfo[giveplayerid][pAmmos6]), strcat(sctring,str);
					}
					onl ++;
