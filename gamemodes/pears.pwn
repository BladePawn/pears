	else if(b >= 57 && b <= 61) LoadBusinessProduct(b, force); // Сбрасываем Аренду Катеров
	else if(b >= 62 && b <= 66) LoadBusinessProduct(b, force); // Сбрасываем Аренду Мотоциклов
    else if(b >= 67 && b <= 76) LoadBusinessProduct(b, force); // Сбрасываем Аренду Скутеров
	else if(b >= 77 && b <= 81) LoadBusinessProduct(b, force); // Автосалон
	else if(b >= 82 && b <= 86) LoadBusinessProduct(b, force); // Мотосалон
	else if(b >= 87 && b <= 89) LoadBusinessProduct(b, force); // Авиасалон
