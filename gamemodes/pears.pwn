	case 1384:
	{	
		new g = DP[4][playerid];
		if(response)
		{
			new thingId, thingType, thingPrice;
			if(OrganInfo[g][gDeliveryOrder] >= 0) return ErrorText(playerid, "{FF6347}Нельзя добавить товар, доставку выполняет NGSA"), OrderEscort(playerid, g);

			thingId = List[listitem][playerid];
			thingType = ListParam[listitem][playerid];

			if(thingId == 34 && thingType == 1) // Если заказывают Снайперку
			{
				if(!IsOrderDepartWeapon(g, 34)) return ErrorText(playerid, "{FF6347}Снайперская винтовка недоступна для заказа в вашей организации"), OrderEscort(playerid, g);
			}

			new ordId = getFreeOrderSlotEscort(g);
			if(ordId == -1) return ErrorText(playerid, "{FF6347}Нет свободных слотов для заказа товаров [ Лимит: 10 ]"), OrderEscort(playerid, g);

			new orderQuan = getThingHaveQuanOrderEscort(g, thingId, thingType);
			if(orderQuan > 0) return ErrorText(playerid, "{FF6347}Этот товар уже добавлен для доставки"), OrderEscort(playerid, g);

			// Проверка на лимиты
			new maxQuan = sklad_limit(thingId, thingType);
			new realQuan = get_sklad(g, thingId,thingType); 
			if(realQuan+1 > maxQuan) return format(string, sizeof(string), "{FF6347}Нет места для этого товара. Лимит: %d", maxQuan), ErrorText(playerid, string), OrderEscort(playerid, g);

			thingPrice = getThingPriceGos(thingId, thingType);
			CreateOrderEscort(playerid, g, ordId, thingId, thingType, thingPrice);
		}
		else OrderEscort(playerid, g);
	}
