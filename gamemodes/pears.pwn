			cache_get_value_name_int(0, "user_id", nyepta);
			cache_get_value_name_int(0, "Rank", randat);
			cache_get_value_name_int(0, "Family", fam);
			if(datad2 >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это лидер..");
			if(skablya == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он нигде не состоит");
			if(!zapas)
			{
				format(string, sizeof(string), " Игрок %s уволен из организации.", str_name);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
				format(string, sizeof(string), " [ ADM ]: Админ %s уволил из организации %s",PlayerInfo[playerid][pName], str_name);
				ABroadCast(COLOR_ADM,string,1);
			}
			AdminLog("auninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", skablya, "");
			OrgLog(skablya, "auninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], nyepta, str_name, "", 0, "");
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Member`='0',`Rank`='0',`Vig`='0',`Division0`='0',`Division1`='0',`LastRank`='%d',`LastFrak`='%d' WHERE `Name` = '%e'",randat,skablya,str_name);
			query_empty(pearsq, f_str);
			FamilyInfo[fam][fInfluence] -= randat*CallBackRankPoint(skablya);
			FamilyInfo[fam][fUpdate] = 1; 
			format(string, sizeof(string), "Вы уволены из %s администратором", orgName[skablya]);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);

			// Удаляем радары при Offline увольнении администратором
			Radar_DeleteAllByOwner(nyepta);

			if(datad6 == 0) UninvitePlayerBridge(nyepta, skablya);
		}
		else if(paramsi == 37)
		{
			new achieveid = zapas, pid;
			cache_get_value_name_int(0, "user_id", pid);

			mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_achieve` SET `a%d` = NULL WHERE `user_id` = %d", achieveid, pid);
			query_empty(pearsq, f_str);

			SendClientMessage(playerid, COLOR_LIGHTBLUE, "** Вы очистили прогресс достижения №%d для игрока %s **", achieveid + 1, str_name);
		}
		else if(paramsi == 38)
		{
			new mail[128], mailconfirm, acc, str[512];
			cache_get_value_name_int(0, "user_id", acc);
			cache_get_value_name(0, "Mail", mail, 128);
			cache_get_value_name_int(0, "MailStat", mailconfirm);
			if(!strcmp(mail,"\0",true)) return ErrorMessage(playerid, "{FF6437}У игрока не привязан Email к аккаунту.");
			if(mailconfirm > 0) return ErrorMessage(playerid, "{FF6437}У игрока не подтверждён Email.");

			mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Name` = '%e' WHERE `user_id` = '%d'", result, acc);
			query_empty(pearsq, f_str);

			MynameLog(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], acc, str_name, "", result, gettime());
			
			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `blacklist` WHERE `playerid`='%d' LIMIT 60", acc);
			mysql_tquery(pearsq, string, "Call_renamebl", "ds", acc, result);
			
			IsATopName(result);

			SetnamePlayerBridge(acc, result);

			format(string, sizeof(string), " [ ADM ]: %s сменил Offline никнейм игроку %s (новый %s)", PlayerInfo[playerid][pName], str_name, result);
			ABroadCast(COLOR_ADM,string,1);

			format(str, sizeof(str), "Администратор %s сменил ваш никнейм с %s на %s.\n\nЕсли вы считаете, что произошла какая-то ошибка, обратитесь на форум в тех. раздел.", PlayerInfo[playerid][pName], str_name, result);
			SendMail(mail, "Принудительная смена никнейма", str, str_name);
			
			new log_str[80];
			format(log_str, sizeof(log_str), "Принудительно Offline сменил никнейм игроку (было: %s)", str_name);
			AdminLog(
				"rename",
				PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP],
				acc, result, "",
				0,
				log_str
			);
		}
		return 1;
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}

alias:leadvig("leadvigovor")
CMD:leadvig(playerid, const params[])
{
	if(admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER) || admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_ADMIN))
	{
		new para1,tmp[144],string[144];
    	if(sscanf(params, "s[144]s[144]",tmp,params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Лидерский выговор [ /leadvig ID Причина ]");
		if(checksimvol(params[1])) return ErrorMessage(playerid, "{FF6347}Вы используете запрещённый символ\n{cccccc}Используйте, буквы и цифры");
    	if(strlen(tmp) > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинное имя [ Лимит 20 символов ]");
    	if(strlen(params[1]) > 60) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Слишком длинная причина [ Лимит 60 символов ]");
		para1 = ReturnUser(tmp, 1);
  		if(IsOnline(para1))
		{
  			if(PlayerInfo[para1][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не лидер");
	    	if(PlayerInfo[para1][pVig] >= 4)
		    {
		    	AdminLog("leadvig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], PlayerInfo[para1][pVig]+1, params[1]);
				AdminLog("makeleader", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "Снят: 5 Lead Vig");
    			format(string, sizeof(string),"{ffffff}Администратор {ff6600}%s {ffffff}снял вас с поста лидера по причине пяти выговоров *",PlayerInfo[playerid][pName]);
    			ShowDialog(para1, 2018, 0, "{000000}.", string, "Ок", "");

				UnmakeleaderPlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pLeader], PlayerInfo[para1][pRank] - 1);

              	PlayerInfo[para1][pRank] = PlayerInfo[para1][pRank]-1;
                PlayerInfo[para1][pMember] = PlayerInfo[para1][pLeader];
                PlayerInfo[para1][pLeader] = 0;
                PlayerInfo[para1][pVig] = 0;
                format(string, sizeof(string), " [ ADM ]: Админ %s выдал лидерский выговор %s [ Снят с Лидерки ]",PlayerInfo[playerid][pName],PlayerInfo[para1][pName]);
				ABroadCast(COLOR_ADM,string,1);
				format(string, sizeof(string), "{ffffff}[ {ff0000}ADM {ffffff}] Игрок {0088ff}%s {ffffff}снят с поста лидера. Причина: 5 выговоров", PlayerInfo[para1][pName]);
				SendClientMessage(playerid, COLOR_WHITE, string);
				mysql_save(para1, 9);
			}
			else
			{
				format(string, sizeof(string), " [ ADM ]: Админ %s выдал лидерский выговор %s",PlayerInfo[playerid][pName],PlayerInfo[para1][pName]);
				ABroadCast(COLOR_ADM,string,1);
	  			format(string, sizeof(string), "[ Мысли ]: Меня предупредил администратор {ffcc00}%s{cccccc} Причина: %s.", PlayerInfo[playerid][pName], params[1]);
	  			SendClientMessage(para1, COLOR_GREY, string);
	  			format(string, sizeof(string),"{FF0000}[!!!] Вам выдал выговор администратор: %s. Причина: %s.\n\n{ffcc66}** Не нарушайте правила!", PlayerInfo[playerid][pName], params[1]);
      			ShowDialog(para1, 2018, 0, "{FF0000}**** {ffcc66}Выговор! {FF0000}****", string, "Ок", "");

	  			format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Лидер {0088ff}%s {ffffff}получил 1 выговор. Причина: %s", PlayerInfo[para1][pName], params[1]);
	  			SendClientMessage(playerid, COLOR_WHITE, string);
	  			PlayerInfo[para1][pVig] = PlayerInfo[para1][pVig] + 1;
	  			mysql_save(para1, 9);
	  			AdminLog("leadvig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], PlayerInfo[para1][pVig], params[1]);
       		}
		}
		else
  		{
    		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
      		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
        	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, params[1],1,0);
         	return 1;
  		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	return 1;
}

alias:unleadvigovor("unleadvig")
CMD:unleadvigovor(playerid, const params[])
{
	if(admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER) || admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_ADMIN))
	{
		new tmp[24],para1,string[144];
    	if(sscanf(params, "s[24]",tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Снять лидерский выговор[ /unleadvig ID ]");
    	para1 = ReturnUser(tmp, 1);
    	if(IsOnline(para1))
		{
			if(PlayerInfo[para1][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок не лидер");
  			if(PlayerInfo[para1][pVig] > 0)
	    	{
	    		format(string, sizeof(string), " [ ADM ]: Админ %s снял лидерский выговор %s",PlayerInfo[playerid][pName],PlayerInfo[para1][pName]);
				ABroadCast(COLOR_ADM,string,1);
				format(string, sizeof(string), "[ Мысли ]: Администратор {ffcc00}%s{cccccc} удалил один выговор из моего личного дела",PlayerInfo[playerid][pName]);
    			SendClientMessage(para1, COLOR_GREY, string);
				format(string, sizeof(string), "{ffffff}[ {0088ff}ADM {ffffff}] Лидеру {0088ff}%s {ffffff} снят 1 выговор.", PlayerInfo[para1][pName]);
    			SendClientMessage(playerid, COLOR_WHITE, string);
				PlayerInfo[para1][pVig] --;
				AdminLog("unleadvig", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], PlayerInfo[para1][pVig], "");
			}
	    }
		else
  		{
    		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
      		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
        	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, "None",2,0);
         	return 1;
    	}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	return 1;
}
forward Call_uninvite(playerid, str_name[],reason[]);
public Call_uninvite(playerid, str_name[],reason[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1, datad2, datad3, datad4, datad12, datad13, fam, string[144], f_str[256], Ammo5;
		cache_get_value_name_int(0, "Member", datad1);
		cache_get_value_name_int(0, "Leader", datad2);
		cache_get_value_name_int(0, "Soska", datad3);
		cache_get_value_name_int(0, "Fbi", datad4);
		cache_get_value_name_int(0, "user_id", datad12);
		cache_get_value_name_int(0, "Rank", datad13);
		cache_get_value_name_int(0, "Family", fam);
		cache_get_value_name_int(0, "Ammo5", Ammo5);
		if(datad2 >= 1 && playerid >= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Нельзя уволить лидера");
		if(datad4 >= 1 && PlayerInfo[playerid][pLeader] == 2)
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Fbi`='0',`Division1`='0' WHERE `Name` = '%e'",str_name);
			query_empty(pearsq, f_str);

			if(PlayerInfo[playerid][pSoska] == 0)PlayerInfo[playerid][pWorked2] ++;
			format(string, sizeof(string), "{ffffff}[ {ff0000}LEADER {ffffff}] Игрок {0088ff}%s {ffffff}уволен offline из FBI. Причина: %s", str_name,reason);
			SendClientMessage(playerid, COLOR_WHITE, string);
			if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)work_leader(playerid, 6);

			OrgLog(2, "uninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad12, str_name, "", 0, reason);
			format(string, sizeof(string), "Вы были уволены из FBI. Причина: %s",reason);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad12, str_name, string);

			if(Ammo5 == 0) UninvitePlayerBridge(datad12, datad1);
			return 1;
		}
		else
		{
			if(PlayerInfo[playerid][pLeader] == datad1)
			{
				mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Leader` = '0',`Member`='0',`Rank`='0',`Vig`='0',`Division0`='0',`LastRank`='%d',`LastFrak`='%d' WHERE `Name` = '%e'",datad1,datad13,str_name);
				query_empty(pearsq, f_str);
				FamilyInfo[fam][fInfluence] -= datad13*CallBackRankPoint(datad1);
				FamilyInfo[fam][fUpdate] = 1;
			
				// Удаляем радары при Offline увольнении
				Radar_DeleteAllByOwner(datad12);

				if(Ammo5 == 0) UninvitePlayerBridge(datad12, datad1);

				if(playerid >= 0)
				{
					format(string, sizeof(string), "{ffffff}[ {ff0000}LEADER {ffffff}] Игрок {0088ff}%s {ffffff}уволен offline из моей организации. Причина: %s", str_name,reason);
					SendClientMessage(playerid, COLOR_WHITE, string);
					if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pLeader] >= 1)	work_leader(playerid, 6);
					OrgLog(PlayerInfo[playerid][pLeader], "uninvite", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad12, str_name, "", 0, reason);
					format(string, sizeof(string), "Вы были уволены. Причина: %s",reason);
					notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad12, str_name, string);
				}
				return 1;
			}
			else
			{
				if(playerid >= 0) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Он не в моей организации");
			}
		}
	}
	else if(playerid >= 0) ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
forward Call_makeexpert(playerid, str_name[]);
public Call_makeexpert(playerid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1,datad3,datadid,warns,string[144],f_str[256];
		cache_get_value_name_int(0, "user_id", datadid);
 		cache_get_value_name_int(0, "Google", datad1);
 		cache_get_value_name_int(0, "Expert", datad3);
		cache_get_value_name_int(0, "Warns", warns);
		if(datad3 == 0)
		{
			if(datad1 == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
			if(warns >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот игрок не может быть экспертом [2+ Warns]");
			format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы назначили игрока {ffcc66}%s {0088ff}экспертом", str_name);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Expert` = '1' WHERE `Name` = '%e'", str_name);
			query_empty(pearsq, f_str);
		    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, "Вы назначены экспертом");
		}
		else
		{
			format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы отстранили игрока {ffcc66}%s {0088ff}от должности эксперта", str_name);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Expert` = '0' WHERE `Name` = '%e'", str_name);
			query_empty(pearsq, f_str);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, "Вы сняты с должности эксперта");
		}
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
CMD:makeexpert(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    new para1,tmp[24],string[144];
    if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Назначение или снятие статуса Эксперта [ /makeexpert ID ]");
    para1 = ReturnUser(tmp, 1);
    if(IsOnline(para1))
    {
   		if(OnlineInfo[para1][oLogged] == 0) return SendClientMessage(playerid, COLOR_GREY, "   Игрок не залогинился!");
		if(PlayerInfo[para1][pWarns] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот игрок не может быть экспертом [2+ Warns]");
   		if(PlayerInfo[para1][pExpert] == 0)
   		{
    		if(PlayerInfo[para1][pGoogle] == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
			format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Администратор {ffcc66}%s {ffffff}назначил вас {0088ff}экспертом", PlayerInfo[playerid][pName]);
			SendClientMessage(para1, COLOR_LIGHTBLUE, string);
			SendClientMessage(para1, COLOR_LIGHTBLUE, "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Прежде чем приступить к помощи игрокам, ознакомьтесь с правилами на форуме");
			SendClientMessage(para1, COLOR_LIGHTBLUE, "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Команда настроек и информации [ /exp ]");
			format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы назначили игрока {ffcc66}%s {0088ff}экспертом", PlayerInfo[para1][pName]);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			PlayerInfo[para1][pExpert] = 1;
			AdminLog("makeexpert", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "Назначил эксперта");
			mysql_save(para1, 16);
			if(PlayerInfo[para1][pAchieve][66] == 0) AchievePlayer(para1, 66, 1);
		}
		else
   		{
			format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Администратор {ffcc66}%s {ffffff}отстранил вас от должности эксперта", PlayerInfo[playerid][pName]);
			SendClientMessage(para1, COLOR_LIGHTBLUE, string);
			format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы отстранили игрока {ffcc66}%s {0088ff}от должности эксперта", PlayerInfo[para1][pName]);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			PlayerInfo[para1][pExpert] = 0;
			AdminLog("makeexpert", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], 0, "Снял эксперта");
			mysql_save(para1, 16);
		}
	}
	else
	{
 		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
 		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Warns, Google, Expert FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
 		mysql_tquery(pearsq, string, "Call_makeexpert", "ds", playerid, tmp);
	}
	return 1;
}

forward Call_makeadmin(playerid, str_name[], f_money);
public Call_makeadmin(playerid, str_name[], f_money)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datadid, datadm, warns, string[144],f_str[256];
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "Soska", datadm);
		cache_get_value_name_int(0, "Warns", warns);
		if(datadm >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изменять админку старшего админа");
		if(f_money == 0)
		{
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Soska` = '0' WHERE `Name` = '%e'", str_name);
			query_empty(pearsq, f_str);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, "Вы сняты с должности администратора");
		}
		else
		{
			new datad1;
			cache_get_value_name_int(0, "Google", datad1);
			if(datad1 == 0 && server > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
			if(f_money == 1 && warns >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот игрок не может быть хелпером [2+ Warns]");
			mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Soska` = '%d' WHERE `Name` = '%e'",f_money, str_name);
			query_empty(pearsq, f_str);
			format(string, sizeof(string), "Ваш ранг администратора изменён с %d на %d", datadm,f_money);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
		}
		format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы изменили уровень админки Offline {ffcc66}%s {0088ff}%d", str_name,f_money);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		AdminLog("makeadmin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", f_money, "");

		MakeadminPlayerBridge(datadid, f_money);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:makeadmin(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 12 && PlayerInfo[playerid][pSoska] != 14)
	{
	    new para1, tmp[24], level, string[256];
	    if(!sscanf(params, "s[24]i", tmp, level))
		{
		    para1 = ReturnUser(tmp, 1);
		    if(level >= PlayerInfo[playerid][pSoska]) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу выдать админку своего уровня или выше");
		    if(PlayerInfo[playerid][pSoska] >= 20 && (level > 20 || level < 0)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 20");
		    else if(PlayerInfo[playerid][pSoska] == 19 && (level < 0 || level > 9 && level < 14 || level > 14)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 9, или 14 - зам");
		    else if(PlayerInfo[playerid][pSoska] == 18 && (level < 0 || level > 14)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 14");
		    else if(PlayerInfo[playerid][pSoska] == 17 && (level < 0 || level > 9 && level < 12 || level > 12)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 9, или 12 - зам");
		    else if(PlayerInfo[playerid][pSoska] == 16 && (level < 0 || level > 9 && level < 11 || level > 11)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 9, или 11 - зам");
		    else if(PlayerInfo[playerid][pSoska] == 15 && (level < 0 || level > 9 && level < 10 || level > 10)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 9, или 10 - зам");
		    else if(PlayerInfo[playerid][pSoska] == 13 && (level < 0 || level > 9)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 9");
			else if(PlayerInfo[playerid][pSoska] == 12 && (level < 0 || level > 2)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 2"); // Для ЗКХ
		    if(IsOnline(para1))
		    {
		    	if(level >= 1)
				{
					if(server > 0 && PlayerInfo[para1][pGoogle] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
					if(level == 1 && PlayerInfo[para1][pWarns] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот игрок не может быть хелпером [2+ Warns]");
				}
		        if(PlayerInfo[para1][pSoska] >= PlayerInfo[playerid][pSoska] && playerid != para1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу изменять админку старшего админа");
			    if(PlayerInfo[para1][pAdmWarns] <= 5)
				{
					if(level > 0 && PlayerInfo[para1][pHidden] > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это скрытый аккаунт");

					#if defined SAMPVOICE_COMPILE_3
					if(PlayerInfo[para1][pSoska] > 0 && level <= 0) SampvoiceStopTalking(para1), SampvoiceDetachAdmin(para1);
					else if(PlayerInfo[para1][pSoska] == 0 && level > 0) Sampvoice3AttachAdmin(para1);
					#endif

					format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Администратор {ffcc66}%s {ffffff}изменил ваш уровень администрирования: {0088ff}%d", PlayerInfo[playerid][pName], level);
					SendClientMessage(para1, COLOR_LIGHTBLUE, string);
					format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {ffffff}Вы изменили уровень администрирования Online {ffcc66}%s {0088ff}%d", PlayerInfo[para1][pName],level);
					SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
					format(string, sizeof(string), "{0088ff}[ {ffcc66}Server {0088ff}] {cc6666}Текущее IP этого администратора: {ffcc66}%s",PlayerInfo[para1][pPlaIP]);
					SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
					PlayerInfo[para1][pSoska] = level; ADUTY[para1] = 0;
					mysql_save(para1, 10);
					AdminLog("makeadmin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], level, "");
					if(PlayerInfo[para1][pAchieve][49] == 0 && level >= 2) AchievePlayer(para1, 49, 1);

					MakeadminPlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pSoska]);
				}
				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него 5 адм варнов");
			}
			else
			{
	          if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			  mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Soska, Warns, Google FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
	          mysql_tquery(pearsq, string, "Call_makeadmin", "dsd", playerid, tmp,level);
			}
		}
		else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменение уровня администрирования /makeadmin ID 0 - 10");
	}
	else SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	return 1;
}
function Call_makemedia(playerid, str_name[], level)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[140];
		new dat[5];
		cache_get_value_name_int(0, "user_id", dat[0]);
		cache_get_value_name_int(0, "Media", dat[1]);
		if(level > 0)
 	    {
 	        if(dat[1] == level) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже этот уровень медиа");
 	        cache_get_value_name_int(0, "Google", dat[2]);
 	        if(server == 1 && dat[2] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
 	        cache_get_value_name_int(0, "Level", dat[3]);
 	        cache_get_value_name_int(0, "ConnectTime", dat[4]);


			format(string, sizeof(string), "{0088ff}[ Server ] {cccccc}Вы назначили %s медиа {ffcc66}%d", str_name, level);
			SendClientMessage(playerid, COLOR_GREY, string);
			new yesup;
			if(dat[3] < 2) dat[3] += 1, yesup = 1;
 	    	if(dat[4] < 3) dat[4] += 3, yesup = 1;
 	    	if(yesup == 1) 
			{
				mysql_format(pearsq, string, sizeof(string),"UPDATE `pp_igroki` SET `Level`='%d',`ConnectTime`='%d' WHERE `user_id`='%d'",dat[3],dat[4], dat[0]);
				query_empty(pearsq, string);
			}
 	      	if(level == 1) notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], dat[0], str_name, "Вас назначили медиа партнёром [ /media ]");
 	      	else notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], dat[0], str_name, "Ваш уровень медиа партнёра повышен [ /media ]");
 	    }
 	    else
 	    {
 	        if(dat[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот игрок не является медиа");
			format(string, sizeof(string), "{0088ff}[ Server ] {FF6347}Вы сняли %s с медиа", str_name);
			SendClientMessage(playerid, COLOR_GREY, string);
			notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], dat[0], str_name, "Вы были сняты с должности медиа");
 	    }
 	    mysql_format(pearsq, string, sizeof(string),"UPDATE `pp_igroki` SET `Media`='%d' WHERE `user_id`='%d'",level, dat[0]);
		query_empty(pearsq, string);
 	    AdminLog("makemedia", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], dat[0], str_name, "", level, "");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:makemedia(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_MANAGER)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	new tmp[24],level;
 	if(sscanf(params, "s[24]i", tmp, level)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Назначить или снять медиа /makemedia ID 0 - 3");
 	if(level < 0 || level > 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Назначить или снять медиа /makemedia ID 0 - 3");
	new para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
 	{
		new string[140];
 	    if(level > 0)
 	    {
 	        if(PlayerInfo[para1][pMedia] == level) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него уже этот уровень медиа");
 	        if(server == 1 && PlayerInfo[para1][pGoogle] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
 	        format(string, sizeof(string), "{0088ff}[ Server ] {cccccc}Админ {ffcc66}%s {cccccc}назначил вас медиа {ffcc66}%d", PlayerInfo[playerid][pName], level);
			SendClientMessage(para1, COLOR_GREY, string);
			SendClientMessage(para1, COLOR_GREY, "{0088ff}[ Server ] {cccccc}Управление и список команд {ff9000}[ /media ]");
			format(string, sizeof(string), "{0088ff}[ Server ] {cccccc}Вы назначили %s медиа {ffcc66}%d", PlayerInfo[para1][pName], level);
			SendClientMessage(playerid, COLOR_GREY, string);
			new yesup;
			if(PlayerInfo[para1][pLevel] < 2) PlayerInfo[para1][pLevel] += 1, yesup = 1;
 	    	if(PlayerInfo[para1][pConnectTime] < 3) PlayerInfo[para1][pConnectTime] += 3, yesup = 1;
 	    	if(yesup == 1) mysql_format(pearsq, string, sizeof(string),"UPDATE `pp_igroki` SET `Level`='%d',`ConnectTime`='%d' WHERE `user_id`='%d'",PlayerInfo[para1][pLevel],PlayerInfo[para1][pConnectTime], PlayerInfo[para1][pID]), query_empty(pearsq, string);
 	    }
 	    else
 	    {
 	        if(PlayerInfo[para1][pMedia] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот игрок не является медиа");
 	        format(string, sizeof(string), "{0088ff}[ Server ] {cccccc}Админ {ffcc66}%s {FF6347}снял вас с должности медиа", PlayerInfo[playerid][pName]), SendClientMessage(para1, COLOR_GREY, string);
			format(string, sizeof(string), "{0088ff}[ Server ] {FF6347}Вы сняли %s с медиа", PlayerInfo[para1][pName]), SendClientMessage(playerid, COLOR_GREY, string);
 	    }
 	    PlayerInfo[para1][pMedia] = level;
 	    mysql_save(para1, 66);
 	    AdminLog("makemedia", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], level, "");
 	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		
		new string_mysql[200];
		mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT user_id, Level, ConnectTime, Google, Media FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string_mysql, "Call_makemedia", "dsd", playerid, tmp,level);
	}
	return 1;
}

CMD:makedj(playerid, const params[])
{
    new level,playa,string[144],tmp[24];
    if(PlayerInfo[playerid][pSoska] >= 14 || PlayerInfo[playerid][pDjpears] >= 4)
  	{
      if(!sscanf(params, "s[24]i",tmp,level))
	  {
	  	 if(level > 5 || level < 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 0 и не больше 5");
		 if(PlayerInfo[playerid][pDjpears] <= level && PlayerInfo[playerid][pSoska] < 14) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу назначить человека на такую должность");
	     playa = ReturnUser(tmp, 1);
	     if(IsOnline(playa)) // Если игрок Online
         {
				if(PlayerInfo[playa][pDjpears] >= PlayerInfo[playerid][pDjpears] && !(PlayerInfo[playerid][pSoska] >= 14)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его ранг DJ выше моего или равен моему");
				if(server > 0 && PlayerInfo[playa][pGoogle] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У него не привязан Google Authenticator");
	            PlayerInfo[playa][pDjpears] = level;
	            format(string, sizeof(string), "{ffffff}* [ {0088ff}Server {ffffff}] {0088ff}%s {ffffff}выдал вам {0088ff}%d {ffffff}Dj Ранг.", PlayerInfo[playerid][pName], level);
				SendClientMessage(playa, COLOR_LIGHTBLUE, string);
				format(string, sizeof(string), "{00cc00}[ {ffffff}Мысли {00cc00}]{ffffff}: Я выдал {00cc00}%d {ffffff}Dj Ранг игроку: {00cc00}%s.",level, PlayerInfo[playa][pName]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
				AdminLog("makedj", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[playa][pID], PlayerInfo[playa][pName], PlayerInfo[playa][pPlaIP], level, "Dj Studio");
				MakeDjPlayerBridge(PlayerInfo[playa][pID], PlayerInfo[playa][pDjpears]);
         }
         else
         {
         	if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
          	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		  	mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,6,level);
         	return 1;
         }
      }
      else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать Dj ранг /makedj ID 0 - 5");
    } else return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	return 1;
}
CMD:hmenu(playerid)
{
	new g = fraction(playerid);
	if(!IsAFunctionOrganization(67, g, playerid)) return ErrorMessage(playerid, "{FF6347}Вы не агент ICA");
	if(!GetAccessRankOrg(playerid, g, 67, NO_FBI)) return 1;

	PlayerPlaySound(playerid,40405,0,0,0);
	ShowDialog(playerid,586,DIALOG_STYLE_LIST,"{ff9000}Агентство","{cccccc}Список Заказов\n{cccccc}Реклама Агенства","Выбор","Отмена");
	return 1;
}
CMD:rmakeadmin(playerid, const params[])
{
	if(IsPlayerAdmin(playerid))
	{
    	if(!sscanf(params, "ii", params[0],params[1]))
		{
		    if(IsOnline(params[0]))
		    {
				PlayerInfo[params[0]][pSoska] = params[1];
				new string[144];
				format(string, sizeof(string), "Выдана админка № %d игроку: %s.",params[1], PlayerInfo[params[0]][pName]);
				SendClientMessage(playerid, COLOR_GREY, string);
				mysql_save(params[0], 10);
				AdminLog("Rmakeadmin", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[params[0]][pID], PlayerInfo[params[0]][pName], PlayerInfo[params[0]][pPlaIP], params[1], "");
			}
		}
	}
	return 1;
}
forward Call_givegold(playerid, str_name[], f_money);
public Call_givegold(playerid, str_name[], f_money)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad1,string[256],f_str[128], datadid;
		cache_get_value_name_int(0, "user_id", datadid);
		cache_get_value_name_int(0, "DonateMoney", datad1);
		mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `DonateMoney` = '%d' WHERE `user_id` = '%d'",datad1+f_money, datadid);
		query_empty(pearsq, f_str);
		format(string, sizeof(string), "{0088ff}Вы выдали игроку {FFFFFF}%s {ffcc00}%d {0088ff}грамм золота.",str_name,f_money);
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "{0088ff}Теперь у этого игрока {ffcc00}%d {0088ff}грамм золота.",datad1+f_money);
		SendClientMessage(playerid, COLOR_GREY, string);
		DonateLog("givegold",  datadid, str_name, "", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], f_money, "Получил");
		format(string, sizeof(string), "Вам выдали %d Gold",f_money);  
		notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
CMD:givepayday(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] >= 21)
    {
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Врубить payday игроку [ /payday ID ]");
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
		PlayerInfo[params[0]][pPayDay] = 60;
		PayDay(params[0]);
		SendClientMessage(playerid, COLOR_GREY, "PayDay выдан");
	}
	return 1;
}
CMD:givegold(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 23) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
	new akk[24],money,string[256],giveplayerid;
	if (sscanf(params, "s[24]i", akk,money)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Выдать золото игроку [ /givegold ID количество ]");
	giveplayerid = ReturnUser(akk, 1);
	if(IsOnline(giveplayerid))
	{
		format(string, sizeof(string), "{0088ff}Вы выдали игроку {FFFFFF}%s {ffcc00}%d {0088ff}грамм золота.",PlayerInfo[giveplayerid][pName],money);
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "{0088ff}Теперь у этого игрока {ffcc00}%d {0088ff}грамм золота.",PlayerInfo[giveplayerid][pDonateMoney] + money);
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "{0088ff}Администратор выдал вам: {FFcc00}%d {0088ff}грамм золота",money);
		SendClientMessage(giveplayerid, COLOR_GREY, string);
		format(string, sizeof(string), "{0088ff}Посмотреть свой баланс,а также выбрать нужную услугу вы можете в меню: {FFFFFF}Y >> Донат или /donate");
		SendClientMessage(giveplayerid, COLOR_GREY, string);
		PlayerPlaySound(giveplayerid,40405,0,0,0);
		new str[256],sctring[500];
		format(str,sizeof(str),"{0088ff}* {FFFFFF}Ваш Donate баланс пополнен\n");
		strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}* {FFFFFF}Администратор выдал вам {ffcc00}%d {FFFFFF}грамм золота\n",money);
		strcat(sctring,str);
		format(str,sizeof(str),"{0088ff}* {FFFFFF}[ {0088ff}/donate {FFFFFF}- посмотреть баланс ]\n\n");
		strcat(sctring,str);
		ShowDialog(giveplayerid,1992,DIALOG_STYLE_MSGBOX,"{0088ff}[Donate] {FFFFFF}Баланс",sctring,"Назад","");
		PlayerInfo[giveplayerid][pDonateMoney] = PlayerInfo[giveplayerid][pDonateMoney] + money;

		DonateLog("givegold",  PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], money, "Получил");
		new f_str[128];
		mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `DonateMoney`='%d' WHERE `Name`='%e'",PlayerInfo[giveplayerid][pDonateMoney], PlayerInfo[giveplayerid][pName]);
		query_empty(pearsq, f_str);
		if(PlayerInfo[giveplayerid][pAchieve][26] == 0 && PlayerInfo[giveplayerid][pDonateMoney] >= 10000) AchievePlayer(giveplayerid, 26, 1);
	}
	else
	{
		if(!CheckRP_Nickname(akk)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, DonateMoney FROM `pp_igroki` WHERE `Name` = '%e'", akk);
		mysql_tquery(pearsq, string, "Call_givegold", "dsd", playerid, akk, money);
	}
	return 1;
}
forward Call_takegold(playerid, str_name[], f_money);
public Call_takegold(playerid, str_name[], f_money)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		  new datadid, datad1, string[144], f_str[128];
		  cache_get_value_name_int(0, "user_id", datadid);
	      cache_get_value_name_int(0, "DonateMoney", datad1);
          mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `DonateMoney` = '%d' WHERE `Name` = '%e'",datad1-f_money, str_name);
          query_empty(pearsq, f_str);
          format(string, sizeof(string), "{0088ff}Вы забрали у игрока Offline {FFFFFF}%s {ff0000}%d Gold",str_name,f_money);
	      SendClientMessage(playerid, COLOR_GREY, string);
	      format(string, sizeof(string), "{0088ff}Теперь у этого игрока Offline {ff0000}%d Gold",datad1-f_money);
	      SendClientMessage(playerid, COLOR_GREY, string);
	      DonateLog("takegold",  datadid, str_name, "", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -f_money, "Отняли");
          format(string, sizeof(string), "У вас забрали %d Gold", f_money);
		  notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, str_name, string);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return true;
}
CMD:takegold(playerid, const params[])
{
    new akk[24],money,string[256],giveplayerid;
	if (!sscanf(params, "s[24]i", akk,money))
	{
		if(money <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Невозможно отнять отрицательное количество золота");
	    giveplayerid = ReturnUser(akk, 1);
		if(PlayerInfo[playerid][pSoska] >= 14)
        {
           if(IsOnline(giveplayerid))
           {
              format(string, sizeof(string), "{0088ff}Вы забрали у игрока {FFFFFF}%s {ff0000}%d {0088ff}грамм золота.",PlayerInfo[giveplayerid][pName],money);
	          SendClientMessage(playerid, COLOR_GREY, string);
	          format(string, sizeof(string), "{0088ff}Теперь у этого игрока {ff0000}%d {0088ff}грамм золота.",PlayerInfo[giveplayerid][pDonateMoney] - money);
	          SendClientMessage(playerid, COLOR_GREY, string);
	          SendClientMessage(playerid, COLOR_GREY, "{0088ff}Статус игрока: {00cc00}Online");
	          SendClientMessage(playerid, COLOR_GREY, "{0088ff}Аккаунт автоматически сохранён.");
              format(string, sizeof(string), "{0088ff}Администратор забрал у вас: {FF0000}%d {0088ff}грамм золота",money);
      		  SendClientMessage(giveplayerid, COLOR_GREY, string);
         	  new str[256],sctring[500];
           	  format(str,sizeof(str),"{0088ff}* {FFFFFF}Ваш Donate баланс изменён\n");
           	  strcat(sctring,str);
           	  format(str,sizeof(str),"{0088ff}* {FFFFFF}Администратор забрал у вас {ff0000}%d {FFFFFF}грамм золота\n",money);
           	  strcat(sctring,str);
           	  format(str,sizeof(str),"{0088ff}* {FFFFFF}[ {0088ff}/donate {FFFFFF}- посмотреть баланс ]\n\n");
           	  strcat(sctring,str);
           	  ShowDialog(giveplayerid,1992,DIALOG_STYLE_MSGBOX,"{0088ff}[Donate] {FFFFFF}Баланс",sctring,"Назад","");
      		  PlayerInfo[giveplayerid][pDonateMoney] -= money;
      		  
      		  DonateLog("takegold",  PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -money, "Отняли");
			  new f_str[128];
	  		  mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `DonateMoney`='%d' WHERE `Name`='%e'",PlayerInfo[giveplayerid][pDonateMoney], PlayerInfo[giveplayerid][pName]);
      		  query_empty(pearsq, f_str);
	       }
	       else
		   {
              if(!CheckRP_Nickname(akk)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
			  mysql_format(pearsq, string,sizeof(string),"SELECT user_id, DonateMoney FROM `pp_igroki` WHERE `Name` = '%e'", akk);
              mysql_tquery(pearsq, string, "Call_takegold", "dsd", playerid, akk, money);
		   }
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Забрать золото у игрока [ /takegold ID количество ]");
	return 1;
}
function Call_makeleader(playerid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[200];
		new sex, datad2, datad3, datad4, datad5, datad6, datad7, datad8;
		cache_get_value_name_int(0, "Sex", sex);
		cache_get_value_name_int(0, "Google", datad2);
		cache_get_value_name_int(0, "Fbi", datad3);
		cache_get_value_name_int(0, "Leader", datad4);
		cache_get_value_name_int(0, "user_id", datad5);
		cache_get_value_name_int(0, "Member", datad6);
		cache_get_value_name_int(0, "Rank", datad7);
		cache_get_value_name_int(0, "Warns", datad8);
		if(datad4 == 0) // Назначаем
		{
		    if(datad6 == 0) return ErrorMessage(playerid, "{FF6347}Игрок должен находиться в организации {cccccc}[ /ainvite ]");
			if(server == 1 && datad2 == 0) return ErrorMessage(playerid, "{FF6347}У игрока не привязан Google Authenticator");
			if(datad3 >= 1) return ErrorMessage(playerid, "{FF6347}Игрок под прикрытием FBI {cccccc}[ Необходимо вернуться в FBI ]");
			if(datad8 >= 2) return ErrorMessage(playerid, "{FF6347}Этот игрок не может быть лидером {cccccc}[2+ Warns]");
			mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", datad5, 30);
			mysql_tquery(pearsq, string, "get_a_bl", "ddsddd", playerid, datad6, str_name, 2, datad5, datad7);
		}
		else // Снимаем
		{

			format(string, sizeof(string), "[ Server ]: %s Offline снят с лидерского поста", str_name);
			SendClientMessage(playerid, COLOR_WHITE, string);
			AdminLog("makeleader", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datad5, str_name, "", datad4, "Снят с Лидерки");
			mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Leader` = '0',`Member` = '%d',`Vig` = '0',`Rank` = '%d' WHERE `Name` = '%e'",datad4, datad7-1, str_name);
			query_empty(pearsq, string);
			format(string, sizeof(string), "Вы были сняты с должности лидера %s", orgName[datad4]);
		    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datad5, str_name, string);

			UnmakeleaderPlayerBridge(datad5, datad4, datad7-1);
		}
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}

alias:makeleader("ml")
CMD:makeleader(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 10) return ErrorMessage(playerid, "{FF6347}Команда недоступна");
    new tmp[24],string[200], para1;
    if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Назначить лидером [ /makeleader ID ]");
    para1 = ReturnUser(tmp, 1);
	if(IsOnline(para1))
	{
		if(OnlineInfo[para1][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок не залогинился");
    	if(PlayerInfo[para1][pLeader] == 0)
    	{
    	    if(PlayerInfo[playerid][pSoska] >= 15 || PlayerInfo[playerid][pSoska] == 10)
    	    {
	    		if(PlayerInfo[para1][pMember] == 0) return ErrorMessage(playerid, "{FF6347}Игрок должен находиться в организации {cccccc}[ /ainvite ]");
	    		if(server == 1 && PlayerInfo[para1][pGoogle] == 0) return ErrorMessage(playerid, "{FF6347}У игрока не привязан Google Authenticator");
				if(PlayerInfo[para1][pWarns] >= 2) return ErrorMessage(playerid, "{FF6347}Этот игрок не может быть лидером {cccccc}[2+ Warns]");
	    		if(PlayerInfo[para1][pFbi] >= 1) return ErrorMessage(playerid, "{FF6347}Игрок под прикрытием FBI {cccccc}[ Необходимо вернуться в FBI ]");
				if(PlayerInfo[para1][pHidden] > 0) return ErrorMessage(playerid, "{FF6347}Это скрытый аккаунт");
				mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `blacklist` WHERE `playerid`='%d' AND `org`='%d'", PlayerInfo[para1][pID], 30);
   				mysql_tquery(pearsq, string, "get_a_bl", "ddsddd", playerid, 30, PlayerInfo[para1][pName], 3, para1, 0);
			}
			else ErrorMessage(playerid, "{FF6347}Вы не можете назначать лидеров {cccccc}[ Только Снять ]");
		}
		else
		{

			format(string, sizeof(string), "[ Server ]: %s снят с лидерского поста", PlayerInfo[para1][pName]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			format(string, sizeof(string),"{ffffff}Администратор {ff6600}%s {ffffff}снял вас с лидерского поста",PlayerInfo[playerid][pName]);
   			ShowDialog(para1, 191, 0, "{000000}.", string, "Ок", "");
			if(playerid != para1) AdminLog("makeleader", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[para1][pID], PlayerInfo[para1][pName], PlayerInfo[para1][pPlaIP], PlayerInfo[para1][pLeader], "Снят с Лидерки");
			
			UnmakeleaderPlayerBridge(PlayerInfo[para1][pID], PlayerInfo[para1][pLeader], PlayerInfo[para1][pRank] - 1);
			
			PlayerInfo[para1][pRank] = PlayerInfo[para1][pRank]-1;
			PlayerInfo[para1][pMember] = PlayerInfo[para1][pLeader];
			PlayerPlaySound(para1, 30801,0,0,0);
			PlayerInfo[para1][pLeader] = 0;
			PlayerInfo[para1][pVig] = 0;
			mysql_save(para1, 9);
		}
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
		mysql_format(pearsq, string,sizeof(string),"SELECT user_id, Sex, Member, Leader, Rank, Fbi, Warns, Google FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, string, "Call_makeleader", "ds", playerid, tmp);
	}
	return 1;
}
CMD:gototo(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] >= 4 || PlayerInfo[playerid][pHidden] > 0 || PlayerInfo[playerid][pMedia] > 0)
    {
	    new Float:f_pos[4];
		if (sscanf(params,"p<,>fffF(9999)",f_pos[0], f_pos[1], f_pos[2], f_pos[3])) {
			if(sscanf(params, "fffF(9999)", f_pos[0], f_pos[1], f_pos[2], f_pos[3])) {
				return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Телепорт на указанные координаты [ /gototo X Y Z ] или [ /gototo X,Y,Z ]");
			}
		}
		SaveReturnCoord(playerid);

		if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			PPSetVehiclePos(playerid, f_pos[0], f_pos[1], f_pos[2] + 3);
			if(f_pos[3] != 9999) SetVehicleZAngle(GetPlayerVehicleID(playerid), f_pos[3]);
		} else {
			PPSetPlayerPos(playerid, f_pos[0],f_pos[1],f_pos[2] + 3);
			if(f_pos[3] != 9999) SetPlayerFacingAngle(playerid, f_pos[3]);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	return 1;
}
