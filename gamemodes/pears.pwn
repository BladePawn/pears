			OrganInfo[3][gbenz] = 10000, OrganInfo[3][gUpdate] = 1, UpdateBenz(3), OrgLog(3, "fill", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Наполнил Цистерну");
