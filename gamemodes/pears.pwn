}
stock govote(playerid)
{
	if(ViborInfo[vstat] == 0) return ErrorMessage(playerid, "{FF6347}На данный момент в штате не проходят выборы");
	PlayerPlaySound(playerid,40405,0,0,0);
	new str[120],sctring[1200];
