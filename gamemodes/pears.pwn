							MoneyLog("CourtsDeposit", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", PlayerInfo[playerid][pSalary], "Зарплата Клининг Служба(Исправительные работы суда)");
						} else {
