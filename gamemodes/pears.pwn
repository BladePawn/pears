// Корректировка объектов при положении на поверхности (по оси Z)
// Некоторые объекты не имеют коллизии и их приходится корректировать вручную
stock Float:object_correct_z(m)
{
	if(m == 1486) return 0.16;
	else if(m == 1668) return 0.18;
	else if(m == 19818 || m == 19819 || m == 19835) return 0.11;
	else if(m == 2601) return 0.10; // Sprunk Банка
	else if(m == 1546) return 0.09; // Sprunk Стакан
	else if(m == 2768) return 0.07; // Бургер в коробке
	else if(m == 2769) return 0.03; // Ролл
	else if(m >= 2212 && m <= 2217 || m == 2353 || m == 2354) return 0.07;
	else if(m == 2221 || m == 2222 || m == 2223) return 0.085;
	else if(m == 19874) return 0.0376113;
	else if(m == 18849) return 7.2; // Сумка с парашютом из самолета
	else return 0.0;
}


