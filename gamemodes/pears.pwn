CMD:usedrugs2(playerid)
{
	return UseDrugs(playerid, DRUGS_TYPE_WEED);
}
CMD:usedrugs3(playerid)
{
	return UseDrugs(playerid, DRUGS_TYPE_MUSHROOMS);
}

CMD:usedrugs4(playerid, const params[])
{
	return UseDrugs(playerid, DRUGS_TYPE_COCAINE);
}
CMD:drugs(playerid)
{
	new str[100],sctring[1800];
	format(str,sizeof(str),"{ff9000}- {ffffff}Купить у какого-нибудь продавца"), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}- {ffffff}Добыть самостоятельно:"), strcat(sctring,str);
	
	format(str,sizeof(str),"\n\n{ff9000}      Трава"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- Купить семена [ Y >> GPS >> Услуги >> Супермаркет ]"), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}- Внимание! Траву временно невозможно вырастить!"), strcat(sctring,str);
	
	format(str,sizeof(str),"\n\n{ff9000}      Порошок"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- Стать участником мафии"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- Дождаться прибытия корабля в порт San Fierro или Los Santos"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- Забрать товар из грузового отсека корабля"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- Отвезти товар на базу, чтобы безопасно распаковать"), strcat(sctring,str);
	
	format(str,sizeof(str),"\n\n{ff9000}      Грибы"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- Отправиться в любой лес, найти грибы и собрать их"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}- После чего их можно употребить из инвентаря - N"), strcat(sctring,str);
	ShowDialog(playerid,2004,DIALOG_STYLE_MSGBOX,"{0088ff}Где Добыть Вещества?",sctring,"Oк","");
   	return 1;
}
stock nasaload(playerid)
{
	if(GetPVarInt(playerid,"LoadBack") <= 0) return ErrorMessage(playerid, "{FF6347}У вас на спине нет боксов с ценным материалом");
	ApplyAnimation(playerid,"CARRY","putdwn",4.0, false, true, true, false, false);
	PlayerInfo[playerid][pHataCena] += GetPVarInt(playerid,"LoadBack"), PlayerPlaySound(playerid,6401,0,0,0);
	update_ability(playerid, 1, GetPVarInt(playerid,"LoadBack"));
	new string[84];
	format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d~n~~w~NASA JOB: ~b~%d", GetPVarInt(playerid,"LoadBack"), PlayerInfo[playerid][pHataCena]);
	GameTextForPlayer(playerid,string,5000,3);
	SetPVarInt(playerid,"LoadBack",0);
	RemovePlayerAttachedObject(playerid,5), RemovePlayerAttachedObject(playerid,6), RemovePlayerAttachedObject(playerid,7), RemovePlayerAttachedObject(playerid,8), RemovePlayerAttachedObject(playerid,9);
	RemovePlayerAttachedObject(playerid,4);
	SetPlayerAttachedObject(playerid, 4, 1010, 1, 0.075000, -0.109999, 0.000000, 90.0, 0.000000, 179.700088, 0.817000, 1.000000, 0.901000, 0, 0);
	mysql_save(playerid, 52);
	return 1;
}
stock plantpotato(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] != 4 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не участвуете в экспедиции NASA");
	for(new k = 0; k < 44; k++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 1.2,PotatoMars[k][0], PotatoMars[k][1], PotatoMars[k][2]))
		{
		 	if(PlayerInfo[playerid][pMechSkill] <= 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж устал и хочет спать");
			if(kmarssaj[k] == 0) // Садим картофан
			{
				if(Hold[playerid] != 6) return ErrorMessage(playerid, "{FF6347}Возьмите лопату\n{cccccc}На стойке у входа");
				if(Hand[playerid] != 3) return ErrorMessage(playerid, "{FF6347}Чтобы посадить картошку - возьмите мешок с саженцам\n{cccccc}Мешки с картошкой у входа");
				PlayerPlaySound(playerid,1138,0,0,0);
				SetPlayerChatBubble(playerid,"кладёт картошку в лунку и присыпает землёй",COLOR_PURPLE,15.0,5000);
				ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 3.0, false, true, true, false, false);
				SetPVarInt(playerid,"oryjtemp",GetPVarInt(playerid,"oryjtemp")-1);
				if(GetPVarInt(playerid,"oryjtemp") <= 0) RemovePlayerAttachedObject(playerid,2), Hand[playerid] = 0;
				kmarssajtim[k] = 600;
				kmarssaj[k] = 1;
				new string[84], unix = gettime();
				new tyear, tmonth, tday, thour, tminute, tsecond;
				stamp2datetime(unix+600, tyear, tmonth, tday, thour, tminute, tsecond, 3);
				format(string, sizeof(string), "{ff9000}Картофель {ffcc00}[ Созреет в %02d:%02d ]", thour, tminute), UpdateDynamic3DTextLabelText(kmarssajlab[k],-1, string);
				PlayerInfo[playerid][pHataCena] += 5;
				format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d~n~~w~NASA JOB: ~b~%d", 5, PlayerInfo[playerid][pHataCena]), GameTextForPlayer(playerid,string,5000,3);
				mysql_save(playerid, 52);
				if(getillness(playerid, 18) == -1) PlayerInfo[playerid][pMechSkill] --;
				update_ability(playerid, 1, 1);
			}
			else if(kmarssaj[k] == 2) // Собираем картофан
			{
				if(Hold[playerid] != 6) return ErrorMessage(playerid, "{FF6347}Чтобы посадить картошку - возьмите лопату\n{cccccc}На стойке у входа");
				if(Hand[playerid] == 4) return ErrorMessage(playerid, "{FF6347}У вас в руках уже есть клубни с картошкой\n{cccccc}Положите её в корзинку");
				if(Hand[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас выкопать картошку\n{cccccc}Используется другой предмет");
				if(kmarsobjstat2[0] <= 0 && kmarsobjstat2[1] <= 0) return ErrorMessage(playerid, "{FF6347}На грядках нет корзинки для сбора картошки\n{cccccc}Возьмите корзинку на столе и положите на грядку");
				kmarssaj[k] = 0;
				PlayerPlaySound(playerid,1138,0,0,0);
				Hand[playerid] = 4;
				RemovePlayerAttachedObject(playerid, 2);
				SetPlayerAttachedObject(playerid, 2, 682, 5, 0.090999, 0.019000, -0.086999, 149.799942, 163.899902, 0.000000, 0.510000, 0.553000, 0.290000, 0, 0);
				SetPlayerChatBubble(playerid,"выкапывает клубни с картофелем",COLOR_PURPLE,20.0,5000);
				ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 3.0, false, true, true, false, false);
				UpdateDynamic3DTextLabelText(kmarssajlab[k],-1,"{cccccc}Клумба\n[ ALT + Лопата в руках + Мешок на спине ]");
				SetDynamicObjectPos(kmarssajobj[k], PotatoMars[k][0], PotatoMars[k][1], PotatoMars[k][2]-1.211181);
				PlayerInfo[playerid][pHataCena] += 5;
				new string[84];
				format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d~n~~w~NASA JOB: ~b~%d", 5, PlayerInfo[playerid][pHataCena]), GameTextForPlayer(playerid,string,5000,3);
				mysql_save(playerid, 52);
				if(getillness(playerid, 18) == -1) PlayerInfo[playerid][pMechSkill] --;
				update_ability(playerid, 1, 1);
			}
		    break;
		}
	}
	return 1;
}
stock plantbasket(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] != 4 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не участвуете в экспедиции NASA");
	new plant;
	if(IsPlayerInSquare(playerid,1310.209716,2451.890136,1313.240478,2484.865234)) plant = 0;
	else if(IsPlayerInSquare(playerid,1303.556152,2451.890136,1306.586914,2484.865234)) plant = 1;
	if(kmarsobjstat2[0] >= 1 || kmarsobjstat2[1] >= 1)
	{
		new Float:Pos[3];
		GetDynamicObjectPos(kmarsobj2[plant], Pos[0],Pos[1],Pos[2]);
		if(IsPlayerInRangeOfPoint(playerid, 1.5,Pos[0],Pos[1],Pos[2]))
		{
			if(kmarsobjstat2[plant] < 30)
		 	{
				if(Hand[playerid] != 4) return ErrorMessage(playerid, "{FF6347}У вас в руках нет клубней с картошкой");
				PlayerPlaySound(playerid,1053,0,0,0);
				SetPlayerChatBubble(playerid,"кладёт урожай картофельных клубней в корзинку",COLOR_PURPLE,20.0,5000);
				Hand[playerid] = 0, RemovePlayerAttachedObject(playerid,2);
				PlayerPlaySound(playerid,5601,0,0,0), Hand[playerid] = 0, ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 3.0, false, true, true, false, false);
			 	kmarsobjstat2[plant] += 5;
			 	if(kmarsobjstat2[plant] >= 31) kmarsobjstat2[plant] = 31;
			 	new string[94];
			 	format(string,sizeof(string),"{cccccc}Корзинка для сбора урожая {444444}[ %d/30 шт. ]\n{cccccc}[ ALT + Картошка в руке ]",kmarsobjstat2[plant]-1), UpdateDynamic3DTextLabelText(kmarslab2[plant],-1,string);
		 	
				// Выращивать картошку
				CompletingDaily(playerid, 11, 5);
			}
		 	if(kmarsobjstat2[plant] >= 30)
		 	{
		 		Hold[playerid] = 0, RemovePlayerAttachedObject(playerid,1);
		 		DestroyDynamicObject(kmarsobj2[plant]);
		 		kmarsobjstat2[plant] = 0;
		 		DestroyDynamic3DTextLabel(kmarslab2[plant]);
		 		SetPlayerChatBubble(playerid,"собирает урожай в мешок",COLOR_PURPLE,20.0,5000);
		 		gethold(playerid, 10, 0);
		 		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Отнесите мешок с картошкой к остальным мешкам","*","");
		 		if(get_invent2(playerid, 89, 0)+1 < 10) GiveThingPlayer(playerid, 89, 1, 0, 0, 0, 0, 9999);
		 	}
	 	}
 	}
	return 1;
}
stock basketpotato(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] != 4 && PlayerInfo[playerid][pSoska] < 22) return ErrorMessage(playerid, "{FF6347}Вы не участвуете в экспедиции NASA");
	new plant;
	if(IsPlayerInSquare(playerid,1310.209716,2451.890136,1313.240478,2484.865234)) plant = 0;
	else if(IsPlayerInSquare(playerid,1303.556152,2451.890136,1306.586914,2484.865234)) plant = 1;
	if(kmarsobjstat2[plant] >= 1) return ErrorMessage(playerid, "{FF6347}На этой грядке уже лежит корзинка");
	SetPlayerChatBubble(playerid,"кладёт пустую корзинку на клумбу",COLOR_PURPLE,20.0,5000);
	RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), Hold[playerid] = 0, PPP15[playerid] = 0, ApplyAnimation(playerid,"CARRY","putdwn",4.0, false, false, false, false, false);
	kmarsobjstat2[plant] = 1;
	new Float:pos[3];
	GetPlayerFacingAngle(playerid,pos[2]);
	pos[0]=Protect_X[playerid]+1.0*floatsin(-pos[2],degrees);
	pos[1]=Protect_Y[playerid]+1.0*floatcos(-pos[2],degrees);
	kmarsobj2[plant] = CreateDynamicObject(19639,pos[0],pos[1],1456.349365,0.0,0.0,0.0, 223, 222, -1, 50.00, 50.00);
	kmarslab2[plant] = CreateDynamic3DTextLabel("{cccccc}Корзинка для сбора урожая {444444}[ 0/30 шт. ]\n{cccccc}[ ALT + Картошка в руке ]",-1,pos[0],pos[1],1456.349365,7.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,223,222);
	Streamer_Update(playerid);
	return 1;
}
CMD:korma(playerid)
{
	if(mafstat == 0) return 1;
	new gryzid = 0;
	for(new gr = 0; gr < 24; gr++)
	{
		if(mafstat == 1 && IsPlayerInRangeOfPoint(playerid, 2.0, Sf_Gryz[gr][pos_x], Sf_Gryz[gr][pos_y], Sf_Gryz[gr][pos_z])) gryzid = gr+1;
		else if(mafstat == 2 && IsPlayerInRangeOfPoint(playerid, 2.0, Ls_Gryz[gr][pos_x], Ls_Gryz[gr][pos_y], Ls_Gryz[gr][pos_z])) gryzid = gr+1;
	}
	if(gryzid == 0) return 1;
	if(gryzinsert[gryzid-1] == 0) return 1;
	if(!IsMafiaMember(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не состоите в мафии");
	if(PortOwner[mafstat-1] != fraction(playerid)) return ErrorMessage(playerid, "{FF6347}Этот порт находится под контролем другой мафии");
	if(OnlineInfo[playerid][oInHandThing][0] > 0 && OnlineInfo[playerid][oInHandThing][5] == 2) return ErrorMessage(playerid, "{FF6347}У вас в руках уже есть ящик\n\n{cccccc}Отвезите его на склад вашей организации");
	if(OnlineInfo[playerid][oInHandThing][0] > 0 || Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки\n\n{cccccc}Предмет, оружие или какое-то действие");

	new fpick = cargo[0][gryzid-1], fquan = cargo[1][gryzid-1], fpara, thingType = cargo[2][gryzid-1];
	
	if(IsArmor(fpick) && thingType == 2) fpara = 100; // Броня 100 хп

	GiveThingHand(playerid, fpick, fquan, fpara, 0, thingType, 2);
	ApplyAnimation(playerid,"CARRY","liftup",4.0, false, true, true, false, 0, SYNC_ALL); // Анимация поднять предмет
	PPP15[playerid] = 3, RemovePlayerAttachedObject(playerid,1);
	SetPlayerAttachedObject(playerid, 1 , 3014, 6, 0.120000, 0.199448, -0.120000, 254.000000, 0.900000, 70.000000);
    SetPlayerChatBubble(playerid,"поднимает ящик",COLOR_PURPLE,20.0,5000);
    
	DestroyDynamic3DTextLabel(mafgryzlabel[gryzid-1]), DestroyDynamicObject(mafgryz[gryzid-1]), gryzinsert[gryzid-1] = 0;
	return 1;
}
stock rentterminal(playerid, b, term)
{	
	new checkname[34];
	if(b >= 42 && b <= 52 || b >= 62 && b <= 66 || b >= 67 && b <= 76 || b >= 163 && b <= 172) checkname = "Терминал";
	else if (b >= 153 && b <= 162) checkname = "Тележка";
	else if (b >= 143 && b <= 152) checkname = "Зарядная станция";

    if(IsBizTerminal(b))
	{
	    new lol[84], br = numnrent(b);
		new line[80],lines[240];
		if(BizzInfo[b][bArest] == 0)
		{
		    if(RentStat[br][term] == 0) format(line,sizeof(line),"{cccccc}Статус: {FF6347}Не установлен"), strcat(lines,line);
			else if(RentStat[br][term] == 1) format(line,sizeof(line),"{cccccc}Статус: {99ff66}Установлен"), strcat(lines,line);
			else if(RentStat[br][term] == 2) format(line,sizeof(line),"{cccccc}Статус: {ffcc00}Ожидает одобрения"), strcat(lines,line);
			else if(RentStat[br][term] == -1) format(line,sizeof(line),"{cccccc}Статус: {FF6347}Отказано [ %s ]", BizzInfo[b][bStatReason]), strcat(lines,line);
		}
		else format(line,sizeof(line),"{cccccc}Статус: {FF6347}Бизнес арестован"), strcat(lines,line);

		if(RentStat[br][term] > 0) format(line,sizeof(line),"\n{cccccc}%s {99ff66}Переместить", checkname), strcat(lines,line);
		else format(line,sizeof(line),"\n{cccccc}%s {FF6347}Установить", checkname), strcat(lines,line);
		
		if(RentStat[br][term] > 0) format(line,sizeof(line),"\n{444444}Найти"), strcat(lines,line);
		
		format(lol,sizeof(lol),"{cccccc}%d %s Бизнеса {ff9000}%s [%d]",term+1, checkname, bizname(b), b);
		ShowDialog(playerid,1170,DIALOG_STYLE_TABLIST_HEADERS,lol,lines,"Выбрать","Отмена");
	}
	return 1;
}
stock numnrent(b)
{
	if(b >= 42 && b <= 52) b -= 42; // 0 - 10 Аренда Автомобилей
	else if(b >= 62 && b <= 66) b -= 51; // 11 - 15 Аренда Мотоциклов
	else if(b >= 67 && b <= 76) b -= 51; // 16 - 25 Аренда Скутеров
	else if(b >= 163 && b <= 172) b -= 137; // 26 - 35 Банкоматы
	else if(b >= 153 && b <= 162) b -= 117; // 36 - 45 Ларьки с хавкой
	else if(b >= 143 && b <= 152) b -= 97; // 46 - 55 Электростанции
	return b;
}
stock rentnumn(b)
{
	if(b >= 0 && b <= 10) b += 42; // 0 - 10 Аренда Автомобилей
	else if(b >= 11 && b <= 15) b += 51; // 11 - 15 Аренда Мотоциклов
	else if(b >= 16 && b <= 25) b += 51; // 16 - 25 Аренда Скутеров
	else if(b >= 26 && b <= 35) b += 137; // 26 - 35 Банкоматы
	else if(b >= 36 && b <= 45) b += 117; // 36 - 45 Ларьки с хавкой
	else if(b >= 46 && b <= 55) b += 97; // 46 - 55 Электростанции
	return b;
}


CMD:bedit(playerid, const params[])
{
	new b;
	if(!sscanf(params, "i",params[0])) 
	{
		b = params[0];
		if(!IsANearWardrobeBiz(playerid, b)) return ErrorMessage(playerid, "{FF6347}Вы далеко от интерьера или входа в бизнес");
	}
	else
	{
		new findBiz = IsAWardrobeBiz(playerid);
		if(findBiz < 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от интерьера или входа в бизнес");
	    b = findBiz;
	    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
	    if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	    DP[5][playerid] = 1;
	}

	// Проверка на права доступа
	if(!GetAccessBiz(playerid, b, 7) && PlayerInfo[playerid][pSoska] < 9) return 0;

	if(!IsABizInteriorFrame(b)) return ErrorMessage(playerid, "{FF6347}В этом бизнесе нельзя изменять интерьер");

	DP[4][playerid] = b;
    if(Device[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы не можете заниматься ремонтом\n{cccccc}Недоступно со смартфона");
    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
    if(Piss[playerid] == 6) return ErrorMessage(playerid, "{FF6347}Ваш персонаж принимает душ");
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж спит");
	if(BizzInfo[b][bSell] >= 1 && PlayerInfo[playerid][pSoska] < 9) return ErrorMessage(playerid, "{FF6347}Вы не можете заниматься ремонтом во время продажи бизнеса");
	if(PlayerInfo[playerid][pTstat] >= 1) return ErrorMessage(playerid, "{FF6347}Вы не можете заниматься ремонтом во время сделки [ /trade ]");

	new str[80],sctring[520];
	format(str,sizeof(str),"{ff9000}Бизнес № %d \t \t ", b), strcat(sctring,str);
	format(str,sizeof(str),"\n{666666}О редакторе.. \t \t "), strcat(sctring,str);
	if(LabelsInfo[playerid][labelCreate] != 0) format(str,sizeof(str),"\n{cccccc}3D Лейблы \t {99ff66}[ On ]\t {666666}%s", LabelsInfoTypeName[LabelsInfo[playerid][labelType]]), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}3D Лейблы \t {FF6347}[ Off ]\t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Выбрать планировку {99ff66}>> \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Переместить предмет \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Изменить текстуры \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Убрать предмет \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Убрать все объекты в бизнес \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Удалить все объекты \t \t "), strcat(sctring,str);
	ShowDialog(playerid,1263,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Редактор Объектов",sctring,"Выбрать","Отмена");
	return 1;
}

stock bizpos(playerid, b)
{
 	if(b >= 13 && b <= 26 || b >= 27 && b <= 41 ||b >= 93 && b <= 102|| b >= 123 && b <= 132 || b >= 133 && b <= 142 || IsABizInteriorFrame(b)) // Супермаркет, Оружейный Магазин, Аптека, Магазин с Техникой,  Клубы, Закусочные
	{
		new str[164],sctring[1260],lol[84];
		if(BizzInfo[b][bArest] == 0)
		{
			if(BizzInfo[b][bStat] == 0) format(str,sizeof(str),"{cccccc}Статус: {99ff66}Открыт\t \n"), strcat(sctring,str);
			else if(BizzInfo[b][bStat] == 1) format(str,sizeof(str),"{cccccc}Статус: {ffcc00}Ожидает Одобрения\t \n"), strcat(sctring,str);
			else if(BizzInfo[b][bStat] == 2) format(str,sizeof(str),"{cccccc}Статус: {ffcc00}Отказано\t {cccccc}[%s] \n", BizzInfo[b][bStatReason]), strcat(sctring,str);
		}
		else format(str,sizeof(str),"{cccccc}Статус: {FF0000}Арестован\t {cccccc}[%s] \n", BizzInfo[b][bArReason]), strcat(sctring,str);
		format(str,sizeof(str),"{cccccc}Сбросить Позицию Бизнеса \t \n"), strcat(sctring,str);
		if(BizzInfo[b][bBizOStat][0] == 1) format(str,sizeof(str),"{cccccc}Дверь \t{99ff66}[Переместить]\n"), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Дверь \t{FF6347}[Установить]\n"), strcat(sctring,str);
		if(BizzInfo[b][bLab] == 1) format(str,sizeof(str),"{cccccc}Физическая Точка Бизнеса \t{99ff66}[Переместить]\n"), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Физическая Точка Бизнеса \t{FF6347}[Установить]\n"), strcat(sctring,str);
		if(BizzInfo[b][bBizOStat][1] == 1) format(str,sizeof(str),"{cccccc}Вывеска \t{99ff66}[Переместить]\n"), strcat(sctring,str);
		else format(str,sizeof(str),"{cccccc}Вывеска \t{FF6347}[Установить]\n"), strcat(sctring,str);
		if(b >= 93 && b <= 122)
		{
			if(BizzInfo[b][bZZ] == 1) format(str,sizeof(str),"{cccccc}Зеленая зона \t{FF6347}[Выключить]\n"), strcat(sctring,str);
			else format(str,sizeof(str),"{cccccc}Зеленая зона \t{99ff66}[Включить]\n"), strcat(sctring,str);
		}
		if(b >= 93 && b <= 102) // Клубы
		{
			if(BizzInfo[b][bBar] == 1) format(str,sizeof(str),"{cccccc}Бар \t{99ff66}[Переместить]\n"), strcat(sctring,str);
			else format(str,sizeof(str),"{cccccc}Бар \t{FF6347}[Установить]\n"), strcat(sctring,str);
			if(BizzInfo[b][bShluha] == 1) format(str,sizeof(str),"{cccccc}Проститутка \t{99ff66}[Переместить]\n"), strcat(sctring,str);
			else format(str,sizeof(str),"{cccccc}Проститутка \t{FF6347}[Установить]\n"), strcat(sctring,str);
		}
		if(b >= 103 && b <= 122) // Закусочные и Рестораны
		{
			if(BizzInfo[b][bBar] == 1) format(str,sizeof(str),"{cccccc}Заказ еды \t{99ff66}[Переместить]\n"), strcat(sctring,str);
			else format(str,sizeof(str),"{cccccc}Заказ еды \t{FF6347}[Установить]\n"), strcat(sctring,str);
		}
		format(lol,sizeof(lol),"{cccccc}Перенести Бизнес {ff9000}%s [%d]",bizname(b), b);
		ShowDialog(playerid,1002,DIALOG_STYLE_TABLIST_HEADERS,lol,sctring,"Выбрать","Отмена");
	}
	else if(b >= 42 && b <= 52 || b >= 62 && b <= 66 || b >= 67 && b <= 76 || b >= 163 && b <= 172 || b >= 143 && b <= 152 || b >= 153 && b <= 162) // Аренда: Автомобилей, Мотоциклов, Скутеров, Банки с Банкоматами
	{
	    new br = numnrent(b);
    	new line[70],lines[700];
    	for(new i = 0; i < MAX_TERMINAL_BIZ; i++)
		{
		    if(b >= 153 && b <= 162)
			{
		    	if(RentStat[br][i] >= 1) format(line,sizeof(line),"{cccccc}%d. {ff9000}Тележка с едой\n", i+1), strcat(lines,line);
				else format(line,sizeof(line),"{cccccc}%d. {444444}не установлена\n", i+1), strcat(lines,line);
  			}
			else if(b >= 143 && b <= 152)
			{
		    	if(RentStat[br][i] >= 1) format(line,sizeof(line),"{cccccc}%d. {ff9000}Электрозарядная станция\n", i+1), strcat(lines,line);
				else format(line,sizeof(line),"{cccccc}%d. {444444}не установлена\n", i+1), strcat(lines,line);
  			}
			else
			{
				if(RentStat[br][i] >= 1) format(line,sizeof(line),"{cccccc}%d. {ff9000}Терминал\n", i+1), strcat(lines,line);
				else format(line,sizeof(line),"{cccccc}%d. {444444}не установлен\n", i+1), strcat(lines,line);
			}
  		}
		ShowDialog(playerid,1169,DIALOG_STYLE_TABLIST,"{cccccc}Раставляемые объекты",lines,"Выбрать","Отмена");
	}
	else ErrorText(playerid, "[ Мысли ]: Этот бизнес нельзя редактировать или переносить"), mybiz(playerid, b);
	return 1;
}

stock statbiz(playerid, b, stat)
{
	new stro[54],sctringo[1674],tyear, tmonth, tday, thour, tminute, tsecond, unixtime = gettime(),dat;
	format(stro,sizeof(stro),"{cccccc}Дата\t{99ff66}Доход"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"\n{ff9000}Сегодня\t{99ff66}%d$", BizzInfo[b][bIncome]), strcat(sctringo,stro);
	for(new h = 0; h < 30; h++)
	{
		dat ++;
		stamp2datetime(unixtime-86400*dat, tyear, tmonth, tday, thour, tminute, tsecond, 3);
		format(stro,sizeof(stro),"\n{cccccc}%02d.%02d.%d\t{99ff66}%d$", tday, tmonth, tyear, BizzInfo[b][bHiscome][h]), strcat(sctringo,stro);
	}

	new string[100];
	format(string,sizeof(string),"{cccccc}Бизнес {ff9000}%s [%d]",bizname(b), b);
	if(stat == 1) ShowDialog(playerid,1742,DIALOG_STYLE_TABLIST_HEADERS,string,sctringo,"Ок","");
	else if(stat == 2) ShowDialog(playerid,922,DIALOG_STYLE_TABLIST_HEADERS,string,sctringo,"Ок","");
	else ShowDialog(playerid,679,DIALOG_STYLE_TABLIST_HEADERS,string,sctringo,"Ок","");
	return 1;
}
stock mybiz(playerid, b)
{
	if(!GetAccessBiz(playerid, b, 5)) return 0;

	DP[4][playerid] = b;
	new str[124],sctring[700],lol[124];
	format(str,sizeof(str),"{cccccc}Статистика Дохода {99ff66}[%d$]\n", BizzInfo[b][bSchet]), strcat(sctring,str);
	format(str,sizeof(str),"{ff9000}Товар и Обслуживание\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Название Бизнеса\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Расположение Бизнеса\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Редактор Объектов\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Лог Бизнеса\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Прайс Бизнеса\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Права Доступа\n"), strcat(sctring,str);
	if(BizzInfo[b][bFam] >= 1) format(str,sizeof(str),"{cccccc}Семья {ff9000}[№ %d]\n", BizzInfo[b][bFam]), strcat(sctring,str);
	else format(str,sizeof(str),"{cccccc}Синхронизация с Семьей\n"), strcat(sctring,str);
	format(str,sizeof(str),"{cccccc}Партнерские семьи\n"), strcat(sctring,str);
	format(str,sizeof(str),"{444444}О продаже..\n"), strcat(sctring,str);
	format(str,sizeof(str),"{444444}О бизнесе..\n"), strcat(sctring,str);
	format(lol,sizeof(lol),"{cccccc}Бизнес {ff9000}%s [%d]",bizname(b), b);
	ShowDialog(playerid,694,DIALOG_STYLE_LIST,lol,sctring,"Выбрать","Отмена");
	return 1;
}

alias:mybiz("biz")
CMD:mybiz(playerid)
{
	if(Komputer[playerid] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно работать за ноутбуком");
	new stro[124],sctringo[1240], b = PlayerInfo[playerid][pBusiness], f = PlayerInfo[playerid][pFamily],kol = 1;
	if(b > 0) format(stro,sizeof(stro),"{ff9000}[№ %d] %s\t\n", b, bizname(b)), strcat(sctringo,stro);
	else format(stro,sizeof(stro),"{444444}нет\t\n"), strcat(sctringo,stro);
	if(f > 0)
	{
		if(FamilyInfo[f][fSost] == 0) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3051 ]"), PlayerPlaySound(playerid,4203,0,0,0), PlayerInfo[playerid][pFamily] = 0, format(stro,sizeof(stro),"{444444}нет семьи\t"), strcat(sctringo,stro);
		for(new fb = 0; fb < 10; fb++)
		{
			if(FamilyInfo[f][fBiz][fb] >= 1 && FamilyInfo[f][fBiz][fb] != b)
			{
				List[kol][playerid] = FamilyInfo[f][fBiz][fb];
				kol++;
				format(stro,sizeof(stro),"{cccccc}[№ %d] %s\t{cccccc}%s\n",FamilyInfo[f][fBiz][fb],bizname(FamilyInfo[f][fBiz][fb]),BizzInfo[FamilyInfo[f][fBiz][fb]][bVlad]), strcat(sctringo,stro);
			}
		}
	}
	else format(stro,sizeof(stro),"{444444}нет семьи\t"), strcat(sctringo,stro);
	ShowDialog(playerid,1046,DIALOG_STYLE_TABLIST,"{cccccc}Бизнесы",sctringo,"Выбрать","Отмена");
	return 1;
}
CMD:showbiz(playerid, const params[])
{
	if(PlayerInfo[playerid][pBusiness] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет бизнеса");
	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
	if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	if(box[playerid] >= 1) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я на ринге");
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
	if(!sscanf(params, "u",params[0]))
 	{
		if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
  		if(!ProxDetectorS(2.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
    	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Зачем я буду показывать статистику своего бизнеса себе?");
	    if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я слишком далеко");
		statbiz(params[0], PlayerInfo[playerid][pBusiness], 1);
  		PlayerPlaySound(params[0],40405,0,0,0);
  		new string[104];
    	format(string, sizeof(string), "* %s демонстрирует статистику бизнеса %s", playername(playerid), playername(params[0]));
    	ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Показать статистику бизнеса [ /showbiz ID ]");
    return 1;
}
CMD:sellbiz(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(PlayerInfo[playerid][pBusiness] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет бизнеса");
	if(Komputer[playerid] != 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно работать за ноутбуком");
	PlayerPlaySound(playerid,40405,0,0,0);
	new b = PlayerInfo[playerid][pBusiness];
	new qwer[84];
	format(qwer,sizeof(qwer),"{cccccc}Бизнес {ff9000}%s [%d]",bizname(b),b);
	if(BizzInfo[b][bSell] == 0) ShowDialog(playerid,991,DIALOG_STYLE_LIST,qwer,"{cccccc}Информация\n{ccffcc}Выставить {cccccc}на продажу\n{ccffcc}Слить {cccccc}по гос. цене","Выбрать","Отмена");
	else ShowDialog(playerid,991,DIALOG_STYLE_LIST,qwer,"{cccccc}Информация\n{FF6347}Снять {cccccc}с продажи\n{ccffcc}Слить {cccccc}по гос. цене","Выбрать","Отмена");
   	return 1;
}
CMD:dlock(playerid)
{
	new nd;
	if(PlayerInfo[playerid][pHouserent] >= 1 && PlayerInfo[playerid][pDom] == 0) nd = PlayerInfo[playerid][pHouserent];
	else if(PlayerInfo[playerid][pHouserent] == 0 && PlayerInfo[playerid][pDom] >= 1) nd = PlayerInfo[playerid][pDom];
	if(nd == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет дома и я нигде не проживаю");
	if(!IsPlayerInRangeOfPoint(playerid,3.0,DomInfo[nd][dKoordinatX], DomInfo[nd][dKoordinatY], DomInfo[nd][dKoordinatZ]) && !IsPlayerInRangeOfPoint(playerid,50.0,DomInfo[nd][dEnterX], DomInfo[nd][dEnterY], DomInfo[nd][dEnterZ])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно быть в доме или возле входной двери"), pc_cmd_mydom(playerid);
	if(PlayerInfo[playerid][pDom] != nd)
	{
		if(DomInfo[nd][dAccdoo] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ключи от двери есть только у владельца"), pc_cmd_mydom(playerid);
		if(DomInfo[nd][dAccdoo] == 1 && PlayerInfo[playerid][pHouserent] != nd) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ключи от двери есть только у владельца и проживающих"), pc_cmd_mydom(playerid);
		if(DomInfo[nd][dAccdoo] == 2 && (DomInfo[nd][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[nd][dFam])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ключи от двери есть только у владельца и семьи, которая здесь живёт"), pc_cmd_mydom(playerid);
		if(DomInfo[nd][dAccdoo] == 3 && (DomInfo[nd][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[nd][dFam]) && PlayerInfo[playerid][pHouserent] != nd) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Ключи от двери есть только у владельца, проживающих и у семьи, которая здесь живёт"), pc_cmd_mydom(playerid);
	}
	if(DomInfo[nd][dSell] >= 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу запереть дверь, когда мой дом выставлен на продажу!"), pc_cmd_mydom(playerid);
 	if(DomInfo[nd][dLock] == 1) DomInfo[nd][dLock] = 0, PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
	else if(DomInfo[nd][dLock] == 0) DomInfo[nd][dLock] = 1, PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
	if(AntiFloodMysqlRequest(playerid, 30)) return 1;
	SaveDom(nd);
	return 1;
}
CMD:selldom(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(PlayerInfo[playerid][pDom] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет дома");
	PlayerPlaySound(playerid,40405,0,0,0);
	new qwer[30];
	format(qwer,sizeof(qwer),"{ff9000}Мой Дом № %d",PlayerInfo[playerid][pDom]);
	if(DomInfo[PlayerInfo[playerid][pDom]][dSell] == 0) ShowDialog(playerid,410,DIALOG_STYLE_LIST,qwer,"{cccccc}Информация\n{ccffcc}Выставить {cccccc}на продажу\n{ccffcc}Слить {cccccc}по гос. цене","Выбрать","Отмена");
	else ShowDialog(playerid,410,DIALOG_STYLE_LIST,qwer,"{cccccc}Информация\n{FF6347}Снять {cccccc}с продажи\n{ccffcc}Слить {cccccc}по гос. цене","Выбрать","Отмена");
   	return 1;
}
CMD:dedit(playerid, const params[])
{
	new d;
	if(!sscanf(params, "i",params[0])) 
	{
		d = params[0];
		if(!IsANearWardrobeDom(playerid, d)) return ErrorMessage(playerid, "{FF6347}Вы далеко от интерьера или входа в дом");
	}
	else
	{
		new findDom = IsAWardrobeDom(playerid);
		if(findDom < 0) return ErrorMessage(playerid, "{FF6347}Вы далеко от интерьера или входа в дом");
	    d = findDom;
	    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
	    if(howstun(playerid) || HealthAC[playerid] <= 0) return ErrorMessage(playerid, "{FF6347}Вашему персонажу плохо");
	    DP[5][playerid] = 1;
	}

	if(PlayerInfo[playerid][pSoska] < 9)
	{
		if(AccessRightDomInterior(playerid, d)) return true;
	}

	DP[4][playerid] = d;
    if(Device[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы не можете заниматься ремонтом\n{cccccc}Недоступно со смартфона");
    if(PursuitTime[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Вас преследует полиция");
    if(Piss[playerid] == 6) return ErrorMessage(playerid, "{FF6347}Ваш персонаж принимает душ");
	if(Sleep[playerid] >= 1 || SleepRP[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж спит");
	if(DomInfo[d][dSell] >= 1 && PlayerInfo[playerid][pSoska] < 9) return ErrorMessage(playerid, "{FF6347}Вы не можете заниматься ремонтом во время продажи дома");
	if(PlayerInfo[playerid][pTstat] >= 1) return ErrorMessage(playerid, "{FF6347}Вы не можете заниматься ремонтом во время сделки [ /trade ]");

	new str[80],sctring[520];
	format(str,sizeof(str),"{ff9000}Дом № %d \t \t ", d), strcat(sctring,str);
	format(str,sizeof(str),"\n{666666}О редакторе.. \t \t "), strcat(sctring,str);
	if(LabelsInfo[playerid][labelCreate] != 0) format(str,sizeof(str),"\n{cccccc}3D Лейблы \t {99ff66}[ On ] \t {666666}%s", LabelsInfoTypeName[LabelsInfo[playerid][labelType]]), strcat(sctring,str);
	else format(str,sizeof(str),"\n{cccccc}3D Лейблы \t {FF6347}[ Off ] \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Выбрать планировку {99ff66}>> \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Переместить предмет \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Изменить текстуры \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Убрать предмет \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Убрать все объекты в дом \t \t "), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Удалить все объекты \t \t "), strcat(sctring,str);
	ShowDialog(playerid,888,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Редактор Объектов",sctring,"Выбрать","Отмена");
	return 1;
}

alias:mydom("home", "myhome")
CMD:mydom(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return ErrorMessage(playerid, "{FF6347}Вы участник экспедиции NASA [ Нельзя управлять домом ]");
	if(MenuInfo[playerid][zStat] == 1) return ErrorMessage(playerid, "{FF6347}Вы занимаетесь ремонтом");
	new nd, gde;
	if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000) nd = GetPlayerVirtualWorld(playerid)-1000, gde = 0;
	else nd = PlayerInfo[playerid][pDom], gde = 1;
	if(PlayerInfo[playerid][pDom] == 0 && gde == 1) return ErrorMessage(playerid, "{FF6347}У вас нет дома");
	PlayerPlaySound(playerid,1150,0,0,0);
	new stro[40],sctringo[440],qwer[30];
	if(DomInfo[nd][dLock] == 0) format(stro,sizeof(stro),"{cccccc}Дверь {99ff66}[ Открыта ]\n"), strcat(sctringo,stro);
	else format(stro,sizeof(stro),"{cccccc}Дверь {FF6347}[ Закрыта ]\n"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"{cccccc}Редактор Взаимодействия\n"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"{cccccc}Редактор Объектов\n"), strcat(sctringo,stro);
	if(PlayerInfo[playerid][pDom] == nd)
	{
		format(stro,sizeof(stro),"{cccccc}Пригласить Проживать\n"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{cccccc}Проживающие {ffffff}[ %d ]\n",DomInfo[nd][dLodger]), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{cccccc}Права Доступа\n"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{cccccc}Синхронизация с Семьей\n"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{cccccc}Лог Дома\n"), strcat(sctringo,stro);
		if(DomInfo[nd][dDescrip] == 0) format(stro,sizeof(stro),"{cccccc}Описание Дома {ffcc00}[100G]\n"), strcat(sctringo,stro);
		else if(DomInfo[nd][dDescrip] == 1) format(stro,sizeof(stro),"{cccccc}Отключить Описание\n"), strcat(sctringo,stro);
		else if(DomInfo[nd][dDescrip] == 2) format(stro,sizeof(stro),"{cccccc}Отменить Запрос\n"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{ffcc00}Donate\n"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{999999}О продаже..\n"), strcat(sctringo,stro);
		format(stro,sizeof(stro),"{999999}О доме..\n"), strcat(sctringo,stro);
	}
	if(PlayerInfo[playerid][pDom] == nd) format(qwer,sizeof(qwer),"{ff9000}Мой Дом № %d",nd);
	else format(qwer,sizeof(qwer),"{0088ff}Дом № %d",nd);
	ShowDialog(playerid,408,DIALOG_STYLE_LIST,qwer,sctringo,"Выбрать","Отмена");
   	return 1;
}

alias:dominteraction("domin")
CMD:dominteraction(playerid)
{
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	new nd, gde;
	if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 2000) nd = GetPlayerVirtualWorld(playerid)-1000, gde = 0;
	else nd = PlayerInfo[playerid][pDom], gde = 1;
	if(PlayerInfo[playerid][pDom] == 0 && gde == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет дома");
	if(PlayerInfo[playerid][pDom] != nd)
	{
		if(DomInfo[nd][dAccint] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие может только владелец"), pc_cmd_mydom(playerid);
		if(DomInfo[nd][dAccint] == 1 && PlayerInfo[playerid][pHouserent] != nd) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие может только владелец и проживающие"), pc_cmd_mydom(playerid);
		if(DomInfo[nd][dAccint] == 2 && (DomInfo[nd][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[nd][dFam])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие могут только владелец и семья, которая здесь живёт"), pc_cmd_mydom(playerid);
		if(DomInfo[nd][dAccint] == 3 && (DomInfo[nd][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[nd][dFam]) && PlayerInfo[playerid][pHouserent] != nd) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Редактировать взаимодействие могут только владелец, проживающие и семья, которая здесь живёт"), pc_cmd_mydom(playerid);
	}
	new stro[60],sctringo[360];
	if(DomInfo[nd][dInspa] >= 1) format(stro,sizeof(stro),"{cccccc}Спавн \t{99ff66}[ Установлен ]\n"), strcat(sctringo,stro);
	else if(DomInfo[nd][dInspa] == 0) format(stro,sizeof(stro),"{cccccc}Спавн \t \n"), strcat(sctringo,stro);
	if(DomInfo[nd][dIngar] >= 1) format(stro,sizeof(stro),"{cccccc}Гараж \t{99ff66}[ Установлен ]\n"), strcat(sctringo,stro);
	else if(DomInfo[nd][dIngar] == 0) format(stro,sizeof(stro),"{cccccc}Гараж \t \n"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"{cccccc}Кровать \t \n"), strcat(sctringo,stro);
	if(DomInfo[nd][dIntoi] >= 1) format(stro,sizeof(stro),"{cccccc}Туалет \t{99ff66}[ Установлен ]\n"), strcat(sctringo,stro);
	else if(DomInfo[nd][dIntoi] == 0) format(stro,sizeof(stro),"{cccccc}Туалет \t \n"), strcat(sctringo,stro);
	if(DomInfo[nd][dInsin] >= 1) format(stro,sizeof(stro),"{cccccc}Раковина \t{99ff66}[ Установлена ]\n"), strcat(sctringo,stro);
	else if(DomInfo[nd][dInsin] == 0) format(stro,sizeof(stro),"{cccccc}Раковина \t \n"), strcat(sctringo,stro);
	if(DomInfo[nd][dInsou] >= 1) format(stro,sizeof(stro),"{cccccc}Душ \t{99ff66}[ Установлен ]\n"), strcat(sctringo,stro);
	else if(DomInfo[nd][dInsou] == 0) format(stro,sizeof(stro),"{cccccc}Душ \t \n"), strcat(sctringo,stro);
	format(stro,sizeof(stro),"{cccccc}Электростанция \t \n"), strcat(sctringo,stro);


	if(DomInfo[nd][dClass] == 5)
	{
		if(DomInfo[nd][dDoor][0] >= 1) format(stro,sizeof(stro),"{cccccc}Дверь 1 \t{99ff66}[ Установлена ]\n"), strcat(sctringo,stro);
		else if(DomInfo[nd][dDoor][0] == 0) format(stro,sizeof(stro),"{cccccc}Дверь 1 \t \n"), strcat(sctringo,stro);
		if(DomInfo[nd][dDoorInt][0] >= 1) format(stro,sizeof(stro),"{cccccc}Дверь 1 Интерьер\t{99ff66}[ Установлена ]\n"), strcat(sctringo,stro);
		else if(DomInfo[nd][dDoorInt][0] == 0) format(stro,sizeof(stro),"{cccccc}Дверь 1 Интерьер \t \n"), strcat(sctringo,stro);
		if(DomInfo[nd][dDoor][1] >= 1) format(stro,sizeof(stro),"{cccccc}Дверь 2 \t{99ff66}[ Установлена ]\n"), strcat(sctringo,stro);
		else if(DomInfo[nd][dDoor][1]  == 0) format(stro,sizeof(stro),"{cccccc}Дверь 2 \t \n"), strcat(sctringo,stro);
		if(DomInfo[nd][dDoorInt][1] >= 1) format(stro,sizeof(stro),"{cccccc}Дверь 2 Интерьер\t{99ff66}[ Установлена ]\n"), strcat(sctringo,stro);
		else if(DomInfo[nd][dDoorInt][1] == 0) format(stro,sizeof(stro),"{cccccc}Дверь 2 Интерьер \t \n"), strcat(sctringo,stro);
	}

	if(PlayerInfo[playerid][pDom] == nd) format(stro,sizeof(stro),"{ff9000}Мой Дом № %d [Взаимодействия]",nd);
	else format(stro,sizeof(stro),"{0088ff}Дом № %d [Взаимодействия]",nd);
	ShowDialog(playerid,508,DIALOG_STYLE_TABLIST,stro,sctringo,"Выбрать","Отмена");
	return 1;
}

alias:domaccess("domac")
CMD:domaccess(playerid)
{
    if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
    if(PlayerInfo[playerid][pDom] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет дома");
   	new nd = PlayerInfo[playerid][pDom];
