	}
	return 1;
}
function Call_reservname(playerid, str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new str[124],sctring[648];
		format(str,sizeof(str),"\n{ff9000}Введите ник нейм{cccccc}, чтобы занять его {FF6347}[ {ff0000}%s {FF6347}используется ]", str_name);
		strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ffffff}Что значит занять ник нейм?");
		strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}- Услуга позволяет записывать никнеймы, чтобы никто кроме вас не мог их использовать");
		strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}- Стоимость одного никнейма: {ffcc00}%dG", donatePrice[4]);
		strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}- Вы можете занимать неограниченное количество ник неймов\n");
		strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Важно: {FF6347}Все никнеймы потеряют привязку в случае удаления этого аккаунта!\n");
		strcat(sctring,str);
		ShowDialog(playerid,1004,DIALOG_STYLE_INPUT,"{cccccc}Меню {ff9000}Donate",sctring,"Принять","Отмена");
		PlayerPlaySound(playerid,4203,0,0,0);
	}
	else
	{
	    new string[144];
		if(PlayerInfo[playerid][pDonateMoney] < donatePrice[4]) return format(string,sizeof(string),"[ Мысли ]: Мне не хватает %dG [ Занять Ник Нейм: %dG ]", donatePrice[4]-PlayerInfo[playerid][pDonateMoney], donatePrice[4]), SendClientMessage(playerid, COLOR_GREY, string), pc_cmd_donate(playerid);
		format(string, sizeof(string), "{ff9000}[Server] {cccccc}Ник нейм {ffffff}%s {cccccc}зарезервирован на ваш аккаунт {0088ff}[ /rname ]", str_name);
		SendClientMessage(playerid, COLOR_GREY, string);
		format(string, sizeof(string), "{ff9000}[Server] {cccccc}Стоимость резерва никнейма: {ffcc00}%dG",donatePrice[4]);
		SendClientMessage(playerid, COLOR_GREY, string);
    	PlayerInfo[playerid][pDonateMoney] -= donatePrice[4];
		tclArifmetikAllGold -= donatePrice[4];
    	mysql_save(playerid, 4);
    	PlayerPlaySound(playerid,6401,0,0,0);
		new f_str[184];
		mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_name` SET `name`='%e',`acc`='%d',`unix`='%d'",str_name,PlayerInfo[playerid][pID],gettime());
		query_empty(pearsq, f_str);
		HidePlayerDialog(playerid);

		format(string, sizeof(string), "Зарезервировал ник %s", str_name);
		DonateLog("rname",  PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -donatePrice[4], string);
	}
	return 1;
}
forward Call_goname(playerid, str_name[]);
public Call_goname(playerid, str_name[])
{
	new rows,string[256];
	cache_get_row_count(rows);
	if(rows)
	{
		new str[124],sctring[648];
		format(str,sizeof(str),"\n{ff9000}Введите ник нейм{cccccc}, чтобы занять его {FF6347}[ {ff0000}%s {FF6347}используется ]", str_name);
		strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ffffff}Как происходит смена никнейма?");
		strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}- Введите никнейм и ожидайте одобрения от администрации");
		strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}- Администрация может одобрить смену только когда вы в игре\n");
		strcat(sctring,str);
		ShowDialog(playerid,461,DIALOG_STYLE_INPUT,"{cccccc}Меню {ff9000}Donate",sctring,"Принять","Отмена");
		PlayerPlaySound(playerid,4203,0,0,0);
	}
    else
    {
	   PlayerInfo[playerid][pNewname] = 1;
       strmid(PlayerInfo[playerid][pSetName], str_name, 0, strlen(str_name));
       if(PlayerInfo[playerid][pLevel] <= 2)
       {
       		format(string, sizeof(string), "{0088ff}* [Name Free] {FFFFFF}%s[%d] меняет Ник-Нейм >> %s", PlayerInfo[playerid][pName], playerid, str_name);
       		ABroadCast(COLOR_GREY,string,5);
	   }
	   else
       {
       		format(string, sizeof(string), "{0088ff}* [Name] {FFFFFF}%s[%d] меняет Ник-Нейм >> %s", PlayerInfo[playerid][pName], playerid, str_name);
       		ABroadCast(COLOR_GREY,string,5);
	   }
       format(string, sizeof(string), "{FF0000}[!] {0088ff}Запрос смены Ник-Нейма на >> {ffcc66}%s {0088ff}отправлен администрации",str_name);
       SendClientMessage(playerid, COLOR_GREY, string);
       SendClientMessage(playerid, COLOR_GREY, "{FF0000}[!] {0088ff}Даже если ваш никнейм не изменят сегодня по каким-либо причинам, не переживайте");
       SendClientMessage(playerid, COLOR_GREY, "{FF0000}[!] {0088ff}Ваш запрос внесён в базу данных и будет рассмотрен как только администраторы его увидят");
       SendClientMessage(playerid, COLOR_GREY, "{FF0000}[!] {0088ff}Если вы передумали, вы можете отменить заявку {444444}[ /donate >> Услуги >> Отменить смену Nick_Name ]");
	}
	return 1;
}

function Call_setname(playerid, adm_player, const str_name[], snimaem, offline, const tmp[])
{
	new rows,string[256],f_str[256];
	cache_get_row_count(rows);
	if(rows) return SendClientMessage(adm_player, COLOR_GREY, "[ Мысли ]: Это имя уже занято [ /offname ]");
	if(offline)
	{
		mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
		mysql_tquery(pearsq, f_str, "Call_Offline", "dssdd", adm_player, tmp, str_name, 38, 0);
		return 1;
	}
	new cennik;
	if(PlayerInfo[playerid][pLevel] >= 3) cennik = donatePrice[3];
	else if(PlayerInfo[playerid][pLevel] <= 2) cennik = 0;
    format(string, sizeof(string), "{0088ff}* {ffffff}[ {ff0000}Server {ffffff}]{0088ff} Администратор {00ffff}%s {0088ff}изменил ваш никнейм на {00ffff}%s", PlayerInfo[adm_player][pName], str_name);
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "{0088ff}* {ffffff}[ {ff0000}Server {ffffff}]{0088ff} Обязательно измените свой никнейм на новый в окне клиента SAMP");
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "{0088ff}* {ffffff}[ {ff0000}Server {ffffff}]{0088ff} На всякий случай сделайте скриншот [ F8 ], чтобы не забыть свой никнейм");
	SendClientMessage(playerid, COLOR_WHITE, string);
	if(snimaem == 1)
	{
		format(string, sizeof(string), "{0088ff}* {ffffff}[ {ff0000}Server {ffffff}]{0088ff} С вашего счёта снято %dG. Вы были кикнуты, для сохранения аккаунта!",cennik);
		SendClientMessage(playerid, COLOR_WHITE, string);
		format(string, sizeof(string), " [ ADM ]: Админ %s одобрил смену никнейма игроку %s",PlayerInfo[adm_player][pName],PlayerInfo[playerid][pName]);
    	ABroadCast(COLOR_ADM,string,1);
    	PlayerInfo[playerid][pDonateMoney] -= cennik;
	}
	if(snimaem == 0)
	{
		format(string, sizeof(string), " [ ADM ]: %s сменил никнейм игроку %s", PlayerInfo[adm_player][pName], PlayerInfo[playerid][pName]);
		ABroadCast(COLOR_ADM,string,1);
	}
	//format(string, sizeof(string), "Теперь %s известен как %s.", GetName(playerid), str_name);
	//OOCOff(COLOR_LIGHTRED,string);
    new str[120],sctring[500];
    format(str,sizeof(str),"\n\n{0088ff} Администратор {00ffff}%s {0088ff}изменил ваш никнейм на {00ffff}%s", PlayerInfo[adm_player][pName], str_name);
    strcat(sctring,str);
    format(str,sizeof(str),"\n{0088ff} Обязательно измените свой никнейм на новый в окне клиента SAMP");
    strcat(sctring,str);
    format(str,sizeof(str),"\n{0088ff} На всякий случай сделайте скриншот [ F8 ], чтобы не забыть свой никнейм");
    strcat(sctring,str);
    if(snimaem == 1)
	{
    	format(str,sizeof(str),"\n{0088ff} С вашего счёта снято %d грамм золота. Вы были кикнуты, для сохранения аккаунта!",cennik);
    	strcat(sctring,str);
	}

    ShowDialog(playerid,1995,DIALOG_STYLE_MSGBOX," {ff0000}Новый Никнейм!            {000000}*",sctring,"*","");
    if(PlayerInfo[playerid][pAchieve][116] == 0) AchievePlayer(playerid, 116, 1);
    
	if(snimaem == 1)
	{
		{
			new log_str[80];
			format(log_str, sizeof(log_str), "Одобрил смену никнейма игроку (было: %s)", PlayerInfo[playerid][pName]);
			AdminLog(
				"setname",
				PlayerInfo[adm_player][pID], PlayerInfo[adm_player][pName], PlayerInfo[adm_player][pPlaIP],
				PlayerInfo[playerid][pID], str_name, PlayerInfo[playerid][pPlaIP],
				0,
				log_str
			);
		}
		DonateLog("setname", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -cennik, "");
	}
	else
	{
		new log_str[80];
		format(log_str, sizeof(log_str), "Принудительно сменил никнейм игроку (было: %s)", PlayerInfo[playerid][pName]);
		AdminLog(
			"rename",
			PlayerInfo[adm_player][pID], PlayerInfo[adm_player][pName], PlayerInfo[adm_player][pPlaIP],
			PlayerInfo[playerid][pID], str_name, PlayerInfo[playerid][pPlaIP],
			0,
			log_str
		);
	}
	MynameLog(PlayerInfo[adm_player][pID],PlayerInfo[adm_player][pName],PlayerInfo[adm_player][pPlaIP],PlayerInfo[playerid][pID],PlayerInfo[playerid][pName],PlayerInfo[playerid][pPlaIP], str_name, gettime());
	PlayerPlaySound(playerid,40405,0,0,0);

	new husband = -1;
	foreach(Player, i)
	{
	    if(OnlineInfo[i][oLogged] == 0) continue;
		if(PlayerInfo[i][pMarried] == PlayerInfo[playerid][pID])
		{
			husband = i;
			break;
		}
	}
	if(husband >= 0)
	{
		format(PlayerInfo[husband][pMarriedTo], 24, "%s", str_name);
		if(PlayerInfo[husband][pDrawVisible][2] == false) PlayerTextDrawShow(husband, PlayerSiteDraw[2][husband]);
	}
	mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `user_id`='%d'", PlayerInfo[playerid][pMarried]);
	mysql_tquery(pearsq, string, "Call_renamemarried", "ddss", playerid, PlayerInfo[playerid][pMarried], PlayerInfo[playerid][pMarriedTo], str_name);
	
	mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `blacklist` WHERE `playerid`='%d' LIMIT 60", PlayerInfo[playerid][pID]);
	mysql_tquery(pearsq, string, "Call_renamebl", "ds", PlayerInfo[playerid][pID], str_name);
	
	UpdateLabelApartmentsName(playerid, str_name);
    if(PlayerInfo[playerid][pDom] != 0)
	{
        new douse = PlayerInfo[playerid][pDom];
        strmid(DomInfo[douse][dVlad], str_name, 0, strlen(str_name), 24);
        SaveDom(douse);
        UpdateDom(douse);
    }
    if(PlayerInfo[playerid][pBusiness] != 0)
    {
       new bouse = PlayerInfo[playerid][pBusiness];
       strmid(BizzInfo[bouse][bVlad], str_name, 0, strlen(str_name), 24);
	   UpdateBizLabel(bouse,1);
       SaveBizz(bouse);
    }
    if(PlayerInfo[playerid][pFamily] >= 1 && FamilyInfo[PlayerInfo[playerid][pFamily]][fOwner] == PlayerInfo[playerid][pID])
	{
        new fouse = PlayerInfo[playerid][pFamily];
		format(FamilyInfo[fouse][fOsn], 24, "%s", str_name);
        SaveFamily(fouse);
    }
	PlayerInfo[playerid][pNewname] = 0;
	mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `pp_igroki` SET `Name` = '%e' WHERE `user_id` = '%d'", str_name, PlayerInfo[playerid][pID]);
	query_empty(pearsq, f_str);
	
	IsATopName(PlayerInfo[playerid][pName]);
	SetPlayerName(playerid, str_name);

	SetnamePlayerBridge(PlayerInfo[playerid][pID], str_name);

	Kickx(playerid);
	return 1;
}
function Call_renamebl(playerid, str_name[])
{
	new rows, f_str[124];
	cache_get_row_count(rows);
    for(new i = 0; i < rows; i++)
	{
	    mysql_format(pearsq, f_str, sizeof(f_str), "UPDATE `blacklist` SET `player`='%e' WHERE `playerid`='%d'", str_name, playerid);
		query_empty(pearsq, f_str);
	}
	return 1;
}
function Call_rname(playerid, str_name[])
{
	new rows, kol, qwer[84];
	new str[26],sctring[964];
	cache_get_row_count(rows);
	for(new i = 0; i < rows; i++)
	{
		new datad2[24];
		cache_get_value_name(i, "name", datad2, 24);
		format(str,sizeof(str),"%s\n",datad2), strcat(sctring,str);
		kol ++;
	}
	if(kol > 0)
	{
		format(qwer,sizeof(qwer),"{ff9000}Ник Неймы %s [%d]",str_name,kol);
		ShowDialog(playerid,1700,DIALOG_STYLE_LIST,qwer,sctring,"Ок","");
		PlayerPlaySound(playerid,40405,0,0,0);
	}
	else
	{
	    new string[144];
		format(string,sizeof(string),"[ Мысли ]: У %s нет зарезервированных никнеймов",str_name);
		SendClientMessage(playerid, COLOR_GREY, string);
		HidePlayerDialog(playerid);
	}
	return 1;
}
