	CreateVillageNpc();

	// Запускаем систему маньяка
	CreateManiacInterior();

	CreateHalloweenPickUP();

	CreateNewYearPickup();

	// Собираем обычные предметы для шкатулки
	CreateThingGiftCase();

	// Собираем топовые обычные предметы для шкатулки
	CreateThingTopGiftCase();

	// Создаём гантели
	CreateDumbbells();

	// Создаём штанги
	CreateWeights();

	// Создаём беговые дорожки и велотренажеры
	CreateTrainer();

	// Создаём душевые
	CreateWash();

	// Создаём толканы
	CreateToilet();

	// Раковины
	CreateSink();

	// Катана Дуэль
	InitializationKatanaDuel();

	// Перекручиваем переменные лобби
	LobbyLoad();

	// Создаем зоны с животными
	LoadAnimalsArea();

	// Формируем список способностей питомца для рандома
	LoadPetFeaturesQuan();

	// Создаём грабителей самолета
	CreateRobPlane();

	return 1;
}
// OnGameModeInit End

stock SetGreenZoneForPlayer(playerid, bool: status = true)
{
	if (Iamzz[playerid] == status) return 0;

	if (status) {
		if(PlayerInfo[playerid][pBeret] == 0)
		{
			if(GetPlayerWeapon(playerid) == WEAPON:23 && OnDuty[playerid] >= 1 || GetPlayerWeapon(playerid) == WEAPON:41 || GetPlayerWeapon(playerid) == WEAPON:42 || GetPlayerWeapon(playerid) == WEAPON:43 || GetPlayerWeapon(playerid) == WEAPON:46) PozjeZZ[playerid] = true;
			else TempTake(playerid, 1);
		}
		TextDrawShowForPlayer(playerid, GreenDraw), TextDrawShowForPlayer(playerid, GreenDraw2), TextDrawShowForPlayer(playerid, GreenDraw3);
		Iamzz[playerid] = true, LeaveZZ[playerid] = 0;
	} else {
		TextDrawHideForPlayer(playerid, GreenDraw), TextDrawHideForPlayer(playerid, GreenDraw2), TextDrawHideForPlayer(playerid, GreenDraw3);
		Iamzz[playerid] = false, LeaveZZ[playerid] = 4, PozjeZZ[playerid] = false;
	}

	return 1;	
}

stock GunWarnTakeWeapon(playerid, bool: status = true)
{
	if (status) {
		if (!IsPlayerGunWarned(playerid)) return 0;
		if(PlayerInfo[playerid][pBeret] == 0)
		{
			if(GetPlayerWeapon(playerid) == WEAPON:23 && OnDuty[playerid] >= 1 || GetPlayerWeapon(playerid) == WEAPON:41 || GetPlayerWeapon(playerid) == WEAPON:42 || GetPlayerWeapon(playerid) == WEAPON:43 || GetPlayerWeapon(playerid) == WEAPON:46) {}
			else TempTake(playerid, 1);
		}
	} else {
		if (Iamzz[playerid]) return 0;
		TempGive(playerid);	
	}

	return 1;
}

stock IsPlayerGunWarned(playerid)
{
	if (PlayerInfo[playerid][pGunWarnsZZTime] > gettime())
	{
		return 1;
	}
	
	return 0;
}

stock update_desk_label(desk)
{
    new str[84],sctring[840];
   	format(str,sizeof(str),"{ff9000}Комната № %d", desk+1), strcat(sctring,str);
   	if(DeskInfo[desk][QuanPlayer] > 0)
	{
		format(str,sizeof(str),"\n{cccccc}Участники: {ff9000}%d/%d", DeskInfo[desk][QuanPlayer], MAX_PLAYER_DESK), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Игра: {ff9000}%s", gamekasName[DeskInfo[desk][Game]]), strcat(sctring,str);
		if(DeskInfo[desk][Typebid] == 0)
		{
		    format(str,sizeof(str),"\n{cccccc}Ставка Стола: {0088ff}%d F [%s]", DeskInfo[desk][Bet], get_k(DeskInfo[desk][Bet])), strcat(sctring,str);
		    format(str,sizeof(str),"\n{cccccc}Тип Ставок: {99ff66}Фишки [$]"), strcat(sctring,str);
		    if(DeskInfo[desk][Betsize] == 0) format(str,sizeof(str),"\n{cccccc}Размер Фишек: {0088ff}10 - 5000 (маленькие фишки)"), strcat(sctring,str);
		    else if(DeskInfo[desk][Betsize] == 1) format(str,sizeof(str),"\n{cccccc}Размер Фишек: {0088ff}1000 - 500.000 (крупные фишки)"), strcat(sctring,str);
		}
		else if(DeskInfo[desk][Typebid] == 1)
		{
		    format(str,sizeof(str),"\n{cccccc}Ставка Стола: {ffcc00}%d GF [%s]", DeskInfo[desk][Bet], get_k(DeskInfo[desk][Bet])), strcat(sctring,str);
		    format(str,sizeof(str),"\n{cccccc}Тип Ставок: {ffcc00}Gold Фишки [G]"), strcat(sctring,str);
		    format(str,sizeof(str),"\n{cccccc}Размер Фишек: {ffcc00}1 - 500"), strcat(sctring,str);
		}
	}
   	else format(str,sizeof(str),"\n{cccccc}Участники: {99ff66}%d/%d", DeskInfo[desk][QuanPlayer], MAX_PLAYER_DESK), strcat(sctring,str);
   	
   	if(DeskInfo[desk][Room] == 0) format(str,sizeof(str),"\n\n{cccccc}Дверь: {99ff66}Открыта"), strcat(sctring,str);
   	else format(str,sizeof(str),"\n\n{cccccc}Дверь: {FF6347}Закрыта"), strcat(sctring,str);
   	if(DeskInfo[desk][Table] == 0) format(str,sizeof(str),"\n{cccccc}Стол: {99ff66}Открыт"), strcat(sctring,str);
   	else format(str,sizeof(str),"\n{cccccc}Стол: {FF6347}Закрыт"), strcat(sctring,str);
    format(str,sizeof(str),"\n\n{cccccc}Войти: {ff9000}ALT"), strcat(sctring,str);
	UpdateDynamic3DTextLabelText(DeskLabel[desk],-1,sctring);
	return 1;
}
public OnGameModeExit()
{
    print("Мод Project Выключен");

    monitoring_save();
	AdminLog("GameModeExit", 0, "", "", 0, "", "", 0, "Exit Mode");

    mysql_close(pearsq);
    mysql_close(pearsq_2);
	if(server > 0) mysql_close(pearsq_3);
    return 1;
}
public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	if(VehShopInfo[playerid][vsTest]) return 0;
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 0;

	for(new b = 0; b < sizeof(BizzInfo); b++)
	{
		if(pickupid == BizPickup2[b]) GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~w~Войти: ~y~ALT"), 2000, 5);
	}
	return 1;
}
public OnPlayerEnterDynamicArea(playerid, areaid)
{
	// Территория наркоферм
	for (new i = 0; i < MAX_NARCO_FARMS; i++)
	{
		if (!NarcoFarmIsExists(i)) continue;
		if (areaid == NarcoFarmInfo[i][dfiArea])
		{
			NarcoFarmEnterDynamicArea(playerid, i);
			break;
		}
	}

	// Нарколаборатория
	if (areaid == NarcoLaboratoryZone)
	{
		NarcoSpotPlayer_ShowInfectLevel(playerid, true);	
	}

	// Заброшенная шахта
	if (areaid == MineWarZone) {
		MineWar_SetPlayerTime(playerid);

		if (GetPlayerState(playerid) != PLAYER_STATE_SPECTATING && !MineWar_IsPlayerInGame(playerid)) {
			SetPlayerVirtualWorld(playerid, 1);
		}
	}

	// Гробница фараона
	if (areaid == TombZone)
	{
		Tomb_SetPlayerTime(playerid);

		if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING && !Tomb_IsPlayerInGame(playerid)) {
			SetPlayerVirtualWorld(playerid, 1);
		}
	}

	// Гетто
	if (areaid == GhettoZone && GetPlayerVirtualWorld(playerid) == 0) {
		// Выдаем 160HP участникам капта
		new g = fraction(playerid);
		if (CaptInfo[cCaptStat] && (g == CaptInfo[cAttack] || g == CaptInfo[cDefend]))
		{
			SetMaxPlayerHealth(playerid, 160.0);
		}
	}

	// Квест новичка
	if(areaid == ZoneQuest1) OpenStartQuest(playerid, 0);
	else if(areaid == ZoneQuest2) OpenStartQuest(playerid, 1);

	// Зелёная зона
	// if(MafGz[0][mZone] > 0 && areaid == MafGz[0][mZone]) return true;

	// Лава
	if(areaid == zone_lava || areaid == zone_lava2) 
	{
		if(areaid == zone_lava && PlayerInfo[playerid][pLevel] == 1 && OnlineInfo[playerid][FirstLava] == false)
		{
			OnlineInfo[playerid][FirstLava] = true;
			PPSetPlayerPos(playerid, 1567.5029,1411.2350,1825.0344);
			PPSetPlayerFacingAngle(playerid, 231.3872);
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{FF6347}Вы упали в лаву!\n{ffcc66}Если вы зайдёте в лаву ещё раз, то сразу умрёте!","*","");
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Кажется, я только что представил%s, как упал в лаву", gender(playerid));
			PlayerPlaySound(playerid, 17000);
		}
		else
		{
			if(!DeathInfo[playerid][deathStatus]) 
			{
				ACSetPlayerHealth(playerid,0);
			}
		}
	}

	// Склад с ящиками NGSA
	if (areaid == ngsa_boxes_zone)
	{
		new bool: is_robber = false, robbers_in_zone = 0;
		foreach (new id : Player)
		{
			if (GetPlayerVirtualWorld(id) != 0) continue;
			if (PlayerInfo[playerid][pSoska] > 0) continue;
			if (IsPlayerHaveAccessArea51(id)) continue;
			if (!IsPlayerInDynamicArea(id, ngsa_boxes_zone)) continue;

			if (id == playerid) is_robber = true;

			robbers_in_zone++;
		}

		if (is_robber && robbers_in_zone >= 2)
		{
			// Уведомление о проникновении сотрудникам департамента
			static alertCD = 0;
			if (alertCD == 0 || gettime() > alertCD)
			{
				SendDepartMessage(COLOR_ALLDEPT, "[DEP]: Подозрительная активность на военной базе NGSA [ Необходима срочная проверка безопасности ]");
				alertCD = gettime() + 1200; // КД 20 минут
			}
		}
	}
	
	// Зелёная Зона
	if(areaid >= zones_zz[1] && areaid <= zones_zz[MAX_ZONES_ZZ - 1] 
		|| areaid == dyn_zone_zz && dyn_zone_zz > 0 
		|| GetRaceArea(areaid) || GetBizArea(areaid))
	{
		if(!Iamzz[playerid])
		{
			SetGreenZoneForPlayer(playerid, true);
		}
		if(GetPlayerWeapon(playerid) >= WEAPON:16 && GetPlayerWeapon(playerid) <= WEAPON:40 && GetPlayerWeapon(playerid) != WEAPON:23 && OnDuty[playerid] == 0) SetPlayerArmedWeapon(playerid, WEAPON:0); // АНТИОРУЖИЕ В ЗЕЛЁНОЙ ЗОНЕ
	}
	
	// Простуда
	if(GetPVarInt(playerid,"afksystem") <= 2 && GetPlayerState(playerid) != PLAYER_STATE_SPECTATING && MPGO[playerid] == 0)
	{
		foreach(Player,zc)
		{
			if(zc == playerid || zones_coldstat[zc] == 0 || GetPlayerState(zc) == PLAYER_STATE_SPECTATING) continue;
			if(areaid == zones_cold[zc])
			{
				incold[playerid] = zc + 1;
				if(server == 0)
				{
					new string[120];
					format(string,sizeof(string),"{ff0000}[ Musk ]: Детка, ты в зоне заражения простудой | {ffcc66}От чела: %s[%d] ",PlayerInfo[zc][pName], zc);
					SendClientMessage(playerid, COLOR_GREY, string);
				}
				break;
			}
		}
	}

	// Облако погоды
	if(IsAreaWeather(areaid)) PearsWeather(playerid);

	// Метка GPS
	if(areaid == zones_gps[playerid])
	{
		if(zones_gpsstat[playerid] == true) DestroyGps(playerid);
	}
	
	// Рыба
	if(Dei[playerid] == 3)
	{
	    // Мелкая Рыба
		if(areaid >= zones[4] && areaid <= zones[23]) TextDrawShowForPlayer(playerid, MapDraw[1]);
		// Крупная Рыба
		if(areaid >= zones[0] && areaid <= zones[3]) TextDrawShowForPlayer(playerid, MapDraw[5]), TextDrawShowForPlayer(playerid, MapDraw[2]);
	}
	
	// Зависимости
	if(GetPVarInt(playerid,"svzyal") >= 1) // Если тележка в руках
	{
		if(areaid == zAddiction[0])  // Взять сигареты
		{
		    if(getillness(playerid, 10) >= 0) addiction(playerid, 11); // Если есть заболевание, выдаём предмет
		}
		if(areaid == zAddiction[1])  // Взять зажигалку
		{
		    if(getillness(playerid, 10) >= 0) addiction(playerid, 18); // Если есть заболевание, выдаём предмет
		}
		if(areaid == zAddiction[2])  // Взять пиво
		{
		    if(getillness(playerid, 11) >= 0) addiction(playerid, 16); // Если есть заболевание, выдаём предмет
		}
		if(areaid == zAddiction[3])  // Взять шампанское
		{
		    if(getillness(playerid, 11) >= 0) addiction(playerid, 15); // Если есть заболевание, выдаём предмет
		}
	}

	// Зона митинга
	if(areaid == dyn_zone_zzGov)
	{
		TextDrawShowForPlayer(playerid, RallyDraw), TextDrawShowForPlayer(playerid, RallyDraw2), TextDrawShowForPlayer(playerid, RallyDraw3);
	}

	// Village
	if(areaid == VillageInfo[villZone]) PlayerEnterVillage(playerid);

	if(areaid == ScreamerArea && PlayerInfo[playerid][pManiacQwest] == 1) CreateScreamerManiac(playerid);

	if(areaid == PennivizeWalkArea)
	{
		if(LobbyInfo[playerid][lobbyLeader] != -1) 
		{
			if(!HalloweenNpcInfoToPlayerID[LobbyInfo[playerid][lobbyParam]][HalloweenCutscene]) CreatePennivizeWalk(playerid);
		}
		else if(OnlineInfo[playerid][oLobby] != 0) 
		{
			if(!HalloweenNpcInfoToPlayerID[LobbyInfo[OnlineInfo[playerid][oLobby]-1][lobbyParam]][HalloweenCutscene]) CreatePennivizeWalk(LobbyInfo[OnlineInfo[playerid][oLobby]-1][lobbyLeader]);
		}
	}

	//Зона животных
	if(IsAreaWildAnimals(areaid) != -1)
	{
		if(HitPlayer[playerid][3] == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) WildAnimalsCuteScene(playerid);
		new areawildhund = IsAreaWildAnimals(areaid);
		TextDrawShowForPlayer(playerid, WildAnimalsDraw), TextDrawShowForPlayer(playerid, WildAnimalsDraw2), TextDrawShowForPlayer(playerid, WildAnimalsDraw3), TextDrawShowForPlayer(playerid, WildAnimalsDraw4);
		if(!WildAnimalsArea[areawildhund][1]) LoadWildAnimals(areawildhund);
		new tmphour;
		gettime(tmphour);
		if(tmphour >= 19 || tmphour <= 6) GoCreateJason(playerid, IsPlayerInWildZone(playerid));
	}

	//Лапландия
	if(IsANewYear())
	{
		if(areaid == LaplandiaCube)
		{
			if(HitPlayer[playerid][4] == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) LaplandiaCuteScene(playerid);
		}
	}

	//Zone[playerid] = areaid;
	if(PlayerInfo[playerid][pSoska] >= 22) printf("EnterDynamicArea %d",areaid);
	return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	// Зелёная Зона
	if(areaid >= zones_zz[1] && areaid <= zones_zz[MAX_ZONES_ZZ - 1] 
		|| areaid == dyn_zone_zz && dyn_zone_zz > 0 
		|| GetRaceArea(areaid) || GetBizArea(areaid))
	{
		if(Iamzz[playerid])
		{
		    SetGreenZoneForPlayer(playerid, false);
		}
	}

	// Территория наркоферм
	for (new i = 0; i < MAX_NARCO_FARMS; i++)
	{
		if (!NarcoFarmIsExists(i)) continue;
		if (areaid == NarcoFarmInfo[i][dfiArea])
		{
			NarcoFarmLeaveDynamicArea(playerid, i);
			break;
		}
	}

	// Кладбище
	if (areaid == GravesArea) {
		if (IsValidNpc(GravePlayerInfo[playerid][gpiNPC])) {
			PlayerPlaySound(playerid, 4203);
			Graves_DestroyNpc(playerid);
		}
		PearsWeather(playerid);
	}

	// Заброшенная шахта
	if (areaid == MineWarZone) {
		PearsTime(playerid);

		// Удаляем игрока из игры через 10 секунд
		SetTimerEx("MineWar_LeaveExitTimer", 10 * 1000, false, "d", playerid);
	}

	if (areaid == TombZone) {
		PearsTime(playerid);

		// Удаляем игрока из игры через 10 секунд
		SetTimerEx("Tomb_LeaveExitTimer", 10 * 1000, false, "d", playerid);
	}

	// Гетто
	if(areaid == GhettoZone && GetPlayerVirtualWorld(playerid) == 0)
	{
		// Возвращаем максимальное HP
		SetMaxPlayerHealth(playerid, 100.0);
	}
	
	// Простуда
	if(incold[playerid] > 0)
	{
		new zc = incold[playerid] - 1;
		if(areaid == zones_cold[zc])
		{
			incold[playerid] = 0;
			if(server == 0)
			{
				new string[120];
				format(string,sizeof(string),"{ff0000}[ Musk ]: Ты покинул зону заражения | {ffcc66}От чела: %s[%d] ",PlayerInfo[zc][pName], zc);
				SendClientMessage(playerid, COLOR_GREY, string);
			}
		}
	}
	
	// Рыба
	if(Dei[playerid] == 3)
	{
		// Мелкая Рыба
		if(areaid >= zones[4] && areaid <= zones[23]) TextDrawHideForPlayer(playerid, MapDraw[1]), PlayerTextDrawHide(playerid, MapDraw2);
		// Крупная Рыба
		if(areaid >= zones[0] && areaid <= zones[3]) TextDrawHideForPlayer(playerid, MapDraw[5]), TextDrawHideForPlayer(playerid, MapDraw[2]), PlayerTextDrawHide(playerid, MapDraw2);
	}

	// Квест новичка
	if(areaid == ZoneQuest1 || areaid == ZoneQuest2) ExitQuestJone(playerid);

	// Зона митинга
	if(areaid == dyn_zone_zzGov)
	{
		TextDrawHideForPlayer(playerid, RallyDraw), TextDrawHideForPlayer(playerid, RallyDraw2), TextDrawHideForPlayer(playerid, RallyDraw3);
		if(OnlineInfo[playerid][oRally] > 0)
		{
			RemovePlayerAttachedObject(playerid,2);
			OnlineInfo[playerid][oRally] = 0;
			ErrorText(playerid, "[ Мысли ]: Я покинул территорию Митинга, флажок лучше оставить тут.");
		}
	}

	// Конвой
	if(areaid == konvoi_zone[0] || areaid == konvoi_zone[1])
	{
		if(PlayerInfo[playerid][pJailed] > 0 
			&& !IsPlayerInAnyVehicle(playerid)
			&& MPGO[playerid] == 0)
		{
			PPSpawnPlayer(playerid);
			ErrorMessage(playerid, "{FF6347}Вы покинули зону конвоя\n{cccccc}Сервер отправил вас на спавн");
		}
	}

	// Облако погоды
	PearsWeather(playerid);
	PearsTime(playerid);

	// Тюрьма
	if(areaid == prison_zone)
	{
		PlayerPlaySound(playerid, 42799, 0, 0, 0); // Off Alarm Prison

		if(PlayerInfo[playerid][pJailed] > 0 
			&& PlayerInfo[playerid][pSoska] == 0 
			&& GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0
			&& MPGO[playerid] == 0) // Не на мероприятии
		{
			PPSpawnPlayer(playerid);
			ErrorMessage(playerid, "{FF6347}Вы покинули тюрьму\n{cccccc}Сервер отправил вас на спавн");
		}
	}

	// Вышли из зоны мафиозной стрелы
	if(IsMafiaMember(playerid) && MafGz[0][mStat] >= 2 && MafGz[0][mZone] > 0)
	{
		if(areaid == MafGz[0][mZone]) CheckMafWar(0, 0);
	}

	if(IsAreaWildAnimals(areaid) != -1)
	{
		TextDrawHideForPlayer(playerid, WildAnimalsDraw), TextDrawHideForPlayer(playerid, WildAnimalsDraw2), TextDrawHideForPlayer(playerid, WildAnimalsDraw3), TextDrawHideForPlayer(playerid, WildAnimalsDraw4);
		HidePlayerHudTask(playerid);
	}

	// Village
	if(areaid == VillageInfo[villZone]) PlayerExitVillage(playerid);

	//Zone[playerid] = -1;
	if(PlayerInfo[playerid][pSoska] >= 22) printf("LeaveDynamicArea %d",areaid);
	return 1;
}

stock UpdateSaveOrganization()
{
	for(new org = 1; org < 34; org++)
	{
		if(OrganInfo[org][gUpdate] > 0) OrganInfo[org][gUpdate] = 0, SaveOrgan(org); // Сохраняем организации по Update
		if(OrganInfo[org][gUpdateSklad] > 0) OrganInfo[org][gUpdateSklad] = 0, SaveSklad(org, false); // Сохраняем склады организаций по Update
		if(OrganInfo[org][gUpdRank] > 0) OrganInfo[org][gUpdRank] = 0, SaveAllRanks(org); // Сохраняем названия рангов
		if(OrganInfo[org][gMedMoneyUpdate] == true) OrganInfo[org][gMedMoneyUpdate] = false, UpdateMedMoneyOrg(org); // Сохраняем депозит для мед закупа
	}
	return true;
}

public UpdateSave()
{
	// Начало транзакции
	mysql_tquery(pearsq, "START TRANSACTION;");

	if(RallyInfo[0][rallyStatus] > 0) UpdateRallyTableObject(); // Обновление таблицы митинга

	// Завершение транзакции
	mysql_tquery(pearsq, "COMMIT;");

 	if(openserv == 0)
	{
		// Сбрасываем парковки
		for(new i = 0; i < MAX_PARKING_POS; i++)
		{
			if(ParkingBusy[i])
			{
				if(ParkingBusyTemp[i] > 0) ParkingBusyTemp[i] --;
				else ParkingBusy[i] = false;
			}
		}
		for(new i = 0; i < MAX_PARKING_POS_AVIA; i++)
		{
			if(ParkingBusy_Avia[i])
			{
				if(ParkingBusyTemp_Avia[i] > 0) ParkingBusyTemp_Avia[i] --;
				else ParkingBusy_Avia[i] = false;
			}
		}
		for(new i = 0; i < MAX_PARKING_POS_BOAT; i++)
		{
			if(ParkingBusy_Boat[i])
			{
				if(ParkingBusyTemp_Boat[i] > 0) ParkingBusyTemp_Boat[i] --;
				else ParkingBusy_Boat[i] = false;
			}
		}

		// Начало транзакции
		mysql_tquery(pearsq, "START TRANSACTION;");

	 	monitoring_save();
	 	new tmphour, tmpminute, tmpsecond;
		gettime(tmphour, tmpminute, tmpsecond);
		new unixtime = gettime();
		for(new wh = 0; wh < sizeof(WhInfo); wh++)
		{
			if(WhInfo[wh][wUpdate] >= 1) WhInfo[wh][wUpdate] = 0, SaveRent(wh, false); // Сохраняем арендованные склады по Update
		}
		for(new b = 0; b < sizeof(BizzInfo); b++)
		{
			if(BizzInfo[b][bArest] >= 1) // Снимаем арест с бизнеса
			{
				if(BizzInfo[b][bArest] < unixtime)
				{
					BizzInfo[b][bArest] = 0;
					if(BizzInfo[b][bLab] == 1) UpdateBizLabel(b, BizzInfo[b][bLab]);
				}
			}
			if(BizzInfo[b][bUpdate] >= 1) BizzInfo[b][bUpdate] = 0, SaveBizz(b), SaveBizzProduct(b, false); // Сохраняем бизнесы по Update
		}
		for(new f = 0; f < sizeof(FamilyInfo); f++)
		{
			if(FamilyInfo[f][fSost] >= 1 && FamilyInfo[f][fUpdate] >= 1) FamilyInfo[f][fUpdate] = 0, SaveFamily(f);
		}
		for(new z = 0; z < 100; z++)
		{
			if(fish_stat[z] == 1 && fish_quan[z] < 1000) fish_quan[z] ++;
		}
		for(new i = 0; i < MAX_ACCESSORY; i++)
		{
		    if(AccessoryInfo[i][acUpdate] && AccessoryInfo[i][acMysqlCheck] == false)
			{
				AccessoryInfo[i][acUpdate] = false;
				if(AccessoryInfo[i][acID] > 0)
				{
				    AccessoryInfo[i][acMysqlCheck] = true;
					SaveAccessory(i, 1);
				}
			}
		}

		// Сохраняем организации
		UpdateSaveOrganization();

		// Завершение транзакции
		mysql_tquery(pearsq, "COMMIT;");

		if(tmpminute == 00) // Каждые 00 минут
		{
			// Спавним подарочки
			CreateNewYearGifts();

			load_ammosv();
			for(new wh = 0; wh < sizeof(WhInfo); wh++)
			{
				if(WhInfo[wh][wStat] >= 1) bigint_sub(OrganInfo[WhInfo[wh][wStat]][glave], 2000), OrganInfo[WhInfo[wh][wStat]][gUpdate] = 1;
			}

			// Отправляем текущий онлайн
			SendHourlyOnline();
		}
		if(tmphour == 00 && tmpminute == 00 && ServerInfo[34] >= 1)
		{
			ServerInfo[34] ++;
		    new string[124];
	 		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `server_status` WHERE `newid` > '%d'", ServerInfo[34]);
			mysql_tquery(pearsq, string, "monitoring_insert", "d", unixtime);
			SaveServer(34);
			if(ServerInfo[53] == 6) ServerInfo[53] = 7;
			else if(ServerInfo[53] == 10) ServerInfo[53] = 0;
			else ServerInfo[53] ++;
			SaveServer(53);
	 	}
	 	if(tmphour == 10 && tmpminute == 00)
		{
			if(SeaChestStat == 0) LoadSeaChest();
		}
	 	if(tmphour == 15 && tmpminute == 00)
		{
			if(SeaChestStat == 0) LoadSeaChest();
		}
		if(tmphour == 20 && tmpminute == 00)
		{
			if(SeaChestStat == 0) LoadSeaChest();
		}

		// Отправляем максимальный онлайн за сегодня
		if(tmphour == 23 && tmpminute == 59) SendMaxdayOnline();

		/*if(tmphour >= 12)
		{
			if(unixtime > autospawn) autospawn = unixtime+1800, RespawnRadius(947.336486, -1998.535766, 2.004178);
		}*/
		new cops1, cops2;
		foreach (Player, i)
		{
			if(OnlineInfo[i][oLogged] >= 1)
			{
				for(new inva = 0; inva < 40; inva++)
				{
					if(PlayerInfo[i][pI_Update][inva]) PlayerInfo[i][pI_Update][inva] = false, SaveInvent(i, inva);
				}
				for(new mk = 0; mk < 20; mk++)
				{
					if(PlayerInfo[i][pM_Update][mk]) PlayerInfo[i][pM_Update][mk] = false, SaveMark(i, mk);
				}
				PearsTime(i);
				PlayerInfo[i][pPayDay] += 1; // +1 минута
				if(PlayerInfo[i][pPayDay] >= 60)
				{
					PayDay(i);
					gMysqlSaveCheck[i] = 1;
					GF_OnPlayerUpdate(i);
				}
			 	if(IsPoliceMember(i) && IsPlayerInRangeOfPoint(i,300.0,69.9686, -1526.3273, -0.8447)) cops1 ++;
			 	if(IsPoliceMember(i) && IsPlayerInRangeOfPoint(i,300.0,-1692.8809, -761.3823, 43.8648)) cops2 ++;
			 	
			 	// Костёр
			 	if(KosterInfo[i][kStat] == 1)
				{
					if(KosterInfo[i][kTime] >= 1) KosterInfo[i][kTime] --;
					UpdateKoster(i);
				}
				
				// Проявление болезней передающихся по воздуху
				if(GetPVarInt(i,"afksystem") <= 2)
				{
					if(getillness(i, 14) >= 0 || getillness(i, 15) >= 0 || getillness(i, 16) >= 0 || getillness(i, 17) >= 0)
					{
						switch(random(2))
		        		{
							case 0: SetPlayerChatBubble(i,"чихает",COLOR_PURPLE,20.0,3000);
							case 1: SetPlayerChatBubble(i,"кашляет",COLOR_PURPLE,20.0,3000);
						}
					}
				}
				
				// Голод / Жажда
 				if(PlayerInfo[i][pNeon] >= 2) UpdateHunger(i, PlayerInfo[i][pNeon] - 1); // Сытость

				// Менструация
				TimeMenstruation(i);
			}
		}
		if(dpsdoor[0] == 1 || dpsdoor[1] == 1) // Блок пост LS-1 Закрыт
		{
		    if(cops1 == 0)
		    {
				dpsdoor[0] = 0, MoveDynamicObject(dps[0], 69.9686, -1526.3273, -0.8447, 1.0), MoveDynamicObject(dps[1], 39.7771, -1522.4994, -0.8447, 1.0);
				dpsdoor[1] = 0, MoveDynamicObject(dps[2], 67.8088, -1541.6418, -0.8447, 1.0), MoveDynamicObject(dps[3], 37.5760, -1537.8923, -0.8447, 1.0);
			}
		}
		if(dpsdoor[2] == 1 || dpsdoor[3] == 1) // Блок пост SF-1 Закрыт
		{
		    if(cops2 == 0)
		    {
				dpsdoor[2] = 0, MoveDynamicObject(dps[4], -1689.8130, -754.8738, 48.8798, 1.0);
				dpsdoor[3] = 0, MoveDynamicObject(dps[5], -1693.4056, -761.0960, 48.8798, 1.0);
			}
		}
		// Сливаем Дом
		for(new d = 0; d < sizeof(DomInfo); d++)
	 	{
	 		if(DomInfo[d][dSost] >= 1 && DomInfo[d][dFreeze] == 0)
	 		{
	 			if(unixtime > DomInfo[d][dData])
	 			{
	 				notify(0, "", DomInfo[d][dSost], DomInfo[d][dVlad], "Ваш дом продан, вы не отыграли месячную норму");
	 				HouseLog(0, "slivdom", DomInfo[d][dSost], DomInfo[d][dVlad], "", d, 0, "Автоматический Слив");
	 				DomInfo[d][dSost] = 0;
	 				DomInfo[d][dPastime] = 0;
	 				DomInfo[d][dData] = 0;
	 				DomInfo[d][dTaxes] = 0;
	 				DomInfo[d][dTaxday] = 0;
	 				DomInfo[d][dLock] = 0;
					DomInfo[d][dElectroConnect] = 0;
					DomInfo[d][dElectroStatus] = 0;
	 				if(DomInfo[d][dFam] >= 1) FamilyInfo[DomInfo[d][dFam]][fDop5] = 0, SaveFamily(DomInfo[d][dFam]), DomInfo[d][dFam] = 0;
	 				DomInfo[d][dSell] = 0;
	 				DomInfo[d][dAcccupO] = 0, DomInfo[d][dAcccupP] = 0, DomInfo[d][dAcccupG] = 0, DomInfo[d][dAcccupD] = 0, DomInfo[d][dAccgar] = 0, DomInfo[d][dAccdoo] = 0, DomInfo[d][dAccfur] = 0;
					DomInfo[d][dAccint] = 0;
	 				DomInfo[d][dArest] = 0, DomInfo[d][dFamcar] = 0;
	 				if(DomInfo[d][dDescrip] == 2) DomInfo[d][dDescrip] = 0;
					strmid(DomInfo[d][dVlad], "none", 0, strlen("none"));
					if(DomInfo[d][dIngar] >= 1) DomInfo[d][dIngar] = 0, DestroyDynamicPickup(DomGarage[d]), DestroyDynamic3DTextLabel(IngarLabel[d]);
					UpdateDom(d);
					SaveDom(d);
					SaveElectro_Dom(d);
					SaveTax_Dom(d);
	 			}
	 		}
		}
		// Сливаем Бизнес
		for(new b = 0; b < sizeof(BizzInfo); b++)
	 	{
	 		if(BizzInfo[b][bSost] >= 1 && BizzInfo[b][bFreeze] == 0)
	 		{
	 			if(unixtime > BizzInfo[b][bData])
	 			{
	 				notify(0, "", BizzInfo[b][bSost], BizzInfo[b][bVlad], "Ваш бизнес продан, вы не отыграли месячную норму");
	 				BizLog("slivbiz", 0, "", "", b, 0, "");
	 				BizzInfo[b][bSost] = 0;
	 				BizzInfo[b][bPastime] = 0;
	 				BizzInfo[b][bData] = 0;
	 				BizzInfo[b][bTaxes] = 0;
	 				BizzInfo[b][bTaxday] = 0;
	 				BizzInfo[b][bSell] = 0;
	 				if(BizzInfo[b][bFam] >= 1)
				 	{
				 		if(FamilyInfo[BizzInfo[b][bFam]][fSost] >= 1) famdeat_biz(BizzInfo[b][bFam], b), SaveFamily(BizzInfo[b][bFam]);
	 					BizzInfo[b][bFam] = 0;
					}
	 				BizzInfo[b][bSchet] = 0;
	 				BizzInfo[b][bArest] = 0;
	 				bizsbrosprava(b);
	 				strmid(BizzInfo[b][bVlad], "none", 0, strlen("none"), 24);
	 				if(BizzInfo[b][bLab] == 1) UpdateBizLabel(b, BizzInfo[b][bLab]);
	 				SaveBizz(b);
					SaveTax_Biz(b);
	 			}
	 		}
	 	}
	 	
	 	// Тушим Свечи
		for(new cand = 0; cand < MAX_CANDLES; cand++)
		{
		    if(CandlesStat[cand] == true && unixtime >= CandlesUnix[cand])
		    {
		        CandlesStat[cand] = false;
		        SetDynamicObjectPos(CandlesFireObject[cand], CandlesFirePos[cand][CF_X], CandlesFirePos[cand][CF_Y], CandlesFirePos[cand][CF_Z]-50.0);
		        CandlesUnix[cand] = 0;
		    }
		}

		for (new i = 0; i < POLICE_DATABASE_MAX_ORG; i++)
		{
			if (policeDatabaseInfo[i][pdiResetTime] > 0) {
				policeDatabaseInfo[i][pdiResetTime]--;

				if (policeDatabaseInfo[i][pdiResetTime] == 0)
				{
					PDatabase_SetState(i, POLICE_DATABASE_STATE_NORMAL);
				}
			}
		}
 	}
 	loadroadtrash();

	ChangeStatusTramplinArea51();
	return 1;
}
public SyncTime()
{
	new tmphour, tmpminute, tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	FixHour(tmphour); tmphour = shifthour;
	if(tmphour == 0 && tmpminute == 1)
	{
	    // Активация Праздников
		where_holiday();
	}
	if(tmpminute == 0)
	{
	    //SetWorldTime(tmphour);
	    //foreach(Player,i) PearsTime(i);
		ghour = tmphour;
		//========[ GANG ZONE ]============
		new zp[MAX_ORG], ourGraffity[MAX_ORG], theirGraffity[MAX_ORG];
		new precentGraffity = (ServerInfo[43] * GRAFFITY_PRECENT) / 100;

		// Считаем территории и граффити на них
        for(new g = 1; g < GZONES; g++)
        {
			if(GZInfo[g][gFrakVlad] > 0) // Территория захвачена бандой
			{
				zp[GZInfo[g][gFrakVlad]] ++; // Подсчитываем территории для банды
				if(GraphitiInfo[g][graphitiStatus] == 1 && GraphitiInfo[g][graphitiOrg] == GZInfo[g][gFrakVlad]) ourGraffity[GZInfo[g][gFrakVlad]] ++; // На территории есть граффити нашей банды
				if(GraphitiInfo[g][graphitiStatus] == 1 && GraphitiInfo[g][graphitiOrg] != GZInfo[g][gFrakVlad]) theirGraffity[GZInfo[g][gFrakVlad]] ++; // На территории граффити чужой банды
			}
        }

		// Расчитываем зп бандам
		for(new g = 1; g < MAX_ORG; g++)
        {
			if(g != 13 && g != 14 && g != 15 && g != 16 && g != 17) continue;
			if(zp[g] > 0)
			{
				bigint_add(OrganInfo[g][glave], zp[g] * ServerInfo[43] + precentGraffity * ourGraffity[g] - precentGraffity * theirGraffity[g]);

				if(server == 0) printf("SyncTime PayDay %02d:%02d: %s [Территории %d$][Граффити %d$][Чужие Граффити -%d$]", tmphour, tmpminute, frakeasyName[g], zp[g] * ServerInfo[43], precentGraffity * ourGraffity[g], precentGraffity * theirGraffity[g]);
			}
		}
        SaveOrgan(7);
        SaveStuff();
        if(mafstat == 0 && tmphour != 3) Mafia_Ship(0);
        ReopenPrison(0);
        if(nasa_flystat <= 0) start_falcon();
	}
	new unix = gettime();
	if(tmphour == 0 && tmpminute == 5) // Сохранение Статистики Бизнесов
	{
 		if(unix > ServerInfo[49])
 		{
 		    bizstat();
 			ServerInfo[49] = unix+84000;
 			SaveServer(49);
		}
	}
	if((tmphour >= 21 || tmphour <= 11) && tmphour != 3 && tmpminute == 0) create_ufo();
	if(tmphour == 2 && tmpminute == 51)
	{
		SendClientMessageToAll(COLOR_WHITE, "{FFFFFF}Автоматический Рестарт Сервера: {ff9000}через 10 минут");
		foreach (Player, i)
		{
				if(IsOnline(i)) GameTextForPlayer(i, "~r~Restart ~y~3:01", 5000, 0);
		}
	}
	if(tmphour == 3 && tmpminute == 1 && Restart == false)
	{
		SaveAccounts();
		if(server > 0)
		{
        	RestartServer();
			AdminLog("Autorestart", 0, "", "", 0, "", "", 0, "Restart 3 Utra");
		}
 	}
 	if(tmphour == 4 && tmpminute == 10)
	{
		new f_str[240];
		mysql_format(pearsq, f_str,sizeof(f_str),"SELECT user_id, Name, Houserent, Family FROM `pp_igroki` WHERE `Banned` = '2' AND `BanDayz` <= '%d' LIMIT 500", unix);
		mysql_tquery(pearsq, f_str, "Call_delets", "");
	}
	if(tmphour == 4 && tmpminute == 15)
	{
		new f_str[130];
		mysql_format(pearsq, f_str,sizeof(f_str),"SELECT org, playerid FROM `blacklist` WHERE `term` <= '%d' LIMIT 500", unix);
		mysql_tquery(pearsq, f_str, "Call_outbl", "");
	}
	if(tmphour == 5 && tmpminute == 10)
	{
		new year, month,day;
 		getdate(year, month, day);
 		if(ServerInfo[47] != day) // Налоги на Недвижимость и на Бизнес
 		{
 			ServerInfo[47] = day;
 			SaveServer(47);
 			taxes_realty();
 			for(new b = 1; b < sizeof(BizzInfo); b++)
			{
				if(BizzInfo[b][bSost] > 0 && BizzInfo[b][bTaxes] > 0) BizzInfo[b][bTaxday] ++, BizzInfo[b][bUpdate] = 1;
 			}
 		}
	}
	if(tmphour == 19 && tmpminute == 30)
	{
	  //SlivBizov();
	}
	if(tmphour == 23 && tmpminute == 57)
	{
		if(reproofday == 0 && server == 1 && freezereproof == 0)
		{
			new f_str[250];
			mysql_format(pearsq, f_str,sizeof(f_str),"SELECT user_id, Name, GameTime, GameAfk, Soska, Leader, Reproof, AdmWarns, Vig, VacEnd, Rank \
				FROM `pp_igroki` WHERE `Soska` >= '1' OR `Leader` >= '1' LIMIT 100");
			mysql_tquery(pearsq, f_str, "Call_reproof", "");
			reproofday = 1;
		}
	}
	if(tmphour == 6 && tmpminute == 0) SaveStuff();
	if(tmpminute == 0) SaveRally();
	if(tmpminute == 10)
	{
		ReopenPrison(1);
	}
	if(tmpminute == 20)
	{
		ReopenPrison(0);
		if(nasa_flystat <= 0) start_falcon();
	}
	if(tmpminute == 25)
	{
		mysql_tquery(pearsq, "SELECT * FROM `crypto_log`", "LoadCryptoLog", ""); // Высчитываем курс
    	UpdateLabelBank();
	}
	if(tmpminute == 30)
	{
		ReopenPrison(1);
	}
	if(tmpminute == 40)
	{
		ReopenPrison(0);
		if(nasa_flystat <= 0) start_falcon();
	}
	if(tmpminute == 50)
	{
		ReopenPrison(1);
		SaveDom(104);
	}
	return 1;
}
stock updatedrawtime(playerid, tmphour, tmpminute)
{
    new string[34];
    format(string, sizeof(string), "%02d:%02d",tmphour, tmpminute);
    
	if(IsPlayerSyncModels(playerid)) // Если с лаунчера, показываем пиздатое время
	{
		new year, month,day;
		getdate(year, month, day);

		new string_date[34];
		format(string_date, sizeof(string_date), "%02d.%02d.%d", day, month, year);
		SetPlayerHudTimeDate(playerid, string, string_date);
	}
	else
	{
		if(PlayerInfo[playerid][pDrawVisible][3] == false) // Только если отображение не выкл
		{
			PlayerTextDrawSetString(playerid, PlayerSiteDraw[4][playerid], string), PlayerTextDrawShow(playerid, PlayerSiteDraw[4][playerid]);
			if(OnlineInfo[playerid][oShowInterface] == 2) PlayerTextDrawSetString(playerid, PlayerSmartDraw[4][playerid], string), PlayerTextDrawShow(playerid, PlayerSmartDraw[4][playerid]);
		}
	}
	return 1;
}
stock showsiteserver(playerid)
{
	if(IsPlayerSyncModels(playerid)) return false; // Если чел с лаунчера, не включаем это отображение

	if(IsACristmas()) PlayerTextDrawShow(playerid, PlayerSiteDraw[3][playerid]);
	PlayerTextDrawShow(playerid, PlayerSiteDraw[0][playerid]), PlayerTextDrawShow(playerid, PlayerSiteDraw[1][playerid]);
	return 1;
}
stock showtimeserver(playerid)
{
	new tmphour, tmpminute, tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	updatedrawtime(playerid, tmphour, tmpminute);
	if(Iamzz[playerid] == true) TextDrawShowForPlayer(playerid, GreenDraw), TextDrawShowForPlayer(playerid, GreenDraw2), TextDrawShowForPlayer(playerid, GreenDraw3);
	return 1;
}
public SohranBizne()
{
	// Сытость в аквариуме
	AquariumFishSatiety(0);

	new g;
    foreach (Player, i)
	{
	  if(OnlineInfo[i][oLogged] >= 1)
	  {
	  	infectback(i); // Откатываем слегка зависимости

		// Снимаем WARN
		while (PlayerInfo[i][pWarnClearTime] <= gettime())
		{
			if (PlayerInfo[i][pWarns] < 1) break;
			TakePlayerWarn(i);
		}

		g = fraction(i);
		if(GetPVarInt(i,"afksystem") <= 2 && OverHear[i] == 0 && GetPlayerState(i) != PLAYER_STATE_SPECTATING
			&& ADUTY[i] == 0
			&& Kapt[g] == 0 // Капт банды
			&& Strel[g] == 0 // Стрела мафии
			&& Zahvat[g] == 0 // Порт мафии
			&& MPGO[i] == 0 // Мероприятие админов
			&& !DeathInfo[i][deathStatus]
			 && MenuInfo[i][zStat] == 0) // Игрок мертвый на земле
		{

			// Гигиена
	    	if(PlayerInfo[i][pInfoload] >= 10)
			{
				PlayerInfo[i][pInfoload] -= 10;
				if(PlayerInfo[i][pInfoload] <= 50)
  				{
	  				SetPlayerAttachedObject(i,0,18698,1,0.388000,0.000000,-1.475000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);
			    	if(PlayerInfo[i][pInfoload] == 50 || PlayerInfo[i][pInfoload] == 30 || PlayerInfo[i][pInfoload] <= 20) 
				    {
				    	if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i,RusToGame("Я хочу помыться")," ");
				    	else SendMindMessage(i,"I want to bathe"," ");
			    	}
		  		}
  			}
  			else
		  	{
		  		PlayerInfo[i][pInfoload] = 0;
			  	SetPlayerAttachedObject(i,0,18698,1,0.388000,0.000000,-1.475000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);
			  	SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Фу, от меня неприятный запах, хочу помыться [ Я могу это сделать дома в душе ]");
			  	switch(random(3))
	        	{
					case 0:
					{
						if(getillness(i, 7) == -1 || getillness(i, 8) == -1) infect(i, 6, 20);
					}
					case 1:
					{
						if(getillness(i, 6) == -1 || getillness(i, 8) == -1) infect(i, 7, 20);
					}
					case 2:
					{
						if(getillness(i, 6) == -1 || getillness(i, 7) == -1) infect(i, 8, 20);
					}
				}
			  	
		  	}

			// Желание посцать
	   		if(PlayerInfo[i][pCap] >= 1)
	    	{
	       		if(PlayerInfo[i][pCap] <= 30 && PlayerInfo[i][pCap] >= 10)
		   		{
					InfoPissMessage(i, 0);
		      		SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Хочется в туалет [ /piss ]");
		      		if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i,"• xo¤y ў ¦yaћe¦","[ /piss ]");
		      		else SendMindMessage(i,"I have to pee","[ /piss ]");
		      		SetPlayerChatBubble(i,"хочет в туалет",COLOR_PURPLE,20.0,7000);
              		TextDrawShowForPlayer(i, PissDraw), TextDrawShowForPlayer(i, PissDraw2);
           		}
	       		else if(PlayerInfo[i][pCap] <= 9)
		   		{
					InfoPissMessage(i, 1);
		      		SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Ох чёрт, в туалет хочу сильно-о-о! [ /piss ]");
		      		if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i,"• xo¤y ў ¦yaћe¦","[ /piss ]");
					else SendMindMessage(i,"I have to pee","[ /piss ]");
		      		SetPlayerChatBubble(i,"сильно хочет в туалет",COLOR_PURPLE,20.0,7000);
				    TextDrawShowForPlayer(i, PissDraw), TextDrawShowForPlayer(i, PissDraw2);
           		}
	   	   		PlayerInfo[i][pCap] -= 2;
    		}

			if(PlayerInfo[i][pCap] <= 0 || getillness(i, 5) >= 0 && PlayerInfo[i][pCap] <= 30)
			{
		   		if(PlayerInfo[i][pSex] == 1)
                {
		   			SetPlayerChatBubble(i,"обмочился",COLOR_PURPLE,20.0,7000);
	       			SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Ой, блиииин! Кажется я, кхм... обмочился");
   				}
           		if(PlayerInfo[i][pSex] == 2)
				{
		   			SetPlayerChatBubble(i,"обмочилась",COLOR_PURPLE,20.0,7000);
		   			SendClientMessage(i, COLOR_GREY, "[ Мысли ]: Ой, блиииин! Кажется я, кхм... обмочилась");
	   			}
	   			if(getillness(i, 5) == -1) infect(i, 5, 300);
	   			TextDrawHideForPlayer(i, PissDraw), TextDrawHideForPlayer(i, PissDraw2);
           		PlayerInfo[i][pCap] = 100;
        	}
        }
      }
	}
	for(new tra = 0; tra < 500; tra++) random_trash(tra);
    return 1;
}
stock loadroadtrash()
{
	// Создаём мусор на дороге
	new tra[3], trashroad_type[3], Float:plusp;
	tra[0] = 0+random(99);
	tra[1] = 100+random(99);
	tra[2] = 200+random(99);
 	switch(random(4))
    {
		case 0: trashroad_type[0] = 2670, plusp = 0.15;
		case 1: trashroad_type[0] = 2671, plusp = 0.0;
		case 2: trashroad_type[0] = 2673, plusp = 0.1;
		case 3: trashroad_type[0] = 2674, plusp = 0.02;
	}
	switch(random(4))
    {
		case 0: trashroad_type[1] = 2670, plusp = 0.15;
		case 1: trashroad_type[1] = 2671, plusp = 0.0;
		case 2: trashroad_type[1] = 2673, plusp = 0.1;
		case 3: trashroad_type[1] = 2674, plusp = 0.02;
	}
	switch(random(4))
    {
		case 0: trashroad_type[2] = 2670, plusp = 0.15;
		case 1: trashroad_type[2] = 2671, plusp = 0.0;
		case 2: trashroad_type[2] = 2673, plusp = 0.1;
		case 3: trashroad_type[2] = 2674, plusp = 0.02;
	}
	if(trashroad_stat[tra[0]] == 0) 
	{
		trashroad_stat[tra[0]] = 1;
		trashroad_object[tra[0]] = CreateDynamicObject(trashroad_type[0], TrashRoad[tra[0]][TrashRoad_X], TrashRoad[tra[0]][TrashRoad_Y], TrashRoad[tra[0]][TrashRoad_Z]+plusp, 0, 0, 0, 0, 0, -1, 200.00, 200.00);
	}
	if(trashroad_stat[tra[1]] == 0) 
	{
		trashroad_stat[tra[1]] = 1;
		trashroad_object[tra[1]] = CreateDynamicObject(trashroad_type[1], TrashRoad[tra[1]][TrashRoad_X], TrashRoad[tra[1]][TrashRoad_Y], TrashRoad[tra[1]][TrashRoad_Z]+plusp, 0, 0, 0, 0, 0, -1, 200.00, 200.00);
	}
	if(trashroad_stat[tra[2]] == 0) 
	{
		trashroad_stat[tra[2]] = 1;
		trashroad_object[tra[2]] = CreateDynamicObject(trashroad_type[2], TrashRoad[tra[2]][TrashRoad_X], TrashRoad[tra[2]][TrashRoad_Y], TrashRoad[tra[2]][TrashRoad_Z]+plusp, 0, 0, 0, 0, 0, -1, 200.00, 200.00);
	}
	return 1;
}

new saveacc0;
new saveacc1;
new saveacc2;
new saveacc3;
new saveacc4;
new saveacc5;
new saveacc6;

stock SaveAccounts()
{
	new time = GetTickCount(), ids;

	new saveDatail1, saveDatail2, saveDatail3, saveDatail4, saveDatail5;
	mysql_tquery(pearsq, "START TRANSACTION;");

	saveacc0 = 0;
	saveacc1 = 0;
	saveacc2 = 0;
	saveacc3 = 0;
	saveacc4 = 0;
	saveacc5 = 0;
	saveacc6 = 0;

	new time1 = GetTickCount();
    foreach(Player, i)
	{
	    gMysqlSaveCheck[i] = 1;
		SaveLastPlayerPosition(i);
		GF_OnPlayerUpdate(i, false, true), ids++;
	}
	saveDatail1 = GetTickCount()-time1;

	new time2 = GetTickCount();
    for(new f = 0; f < sizeof(FamilyInfo); f++) // Семьи
	{
		if(FamilyInfo[f][fSost] > 0 && FamilyInfo[f][fUpdate] > 0) SaveFamily(f), ids++;
	}
	saveDatail2 = GetTickCount()-time2;

	new time3 = GetTickCount();
	for(new wh = 0; wh < sizeof(WhInfo); wh++) // Арендованные Склады
	{
		if(WhInfo[wh][wUpdate] > 0) WhInfo[wh][wUpdate] = 0, SaveRent(wh, false), ids++;
	}
	saveDatail3 = GetTickCount()-time3;

	new time4 = GetTickCount();
	for(new b = 0; b < sizeof(BizzInfo); b++) // Бизнесы
	{
		if(BizzInfo[b][bUpdate] > 0) BizzInfo[b][bUpdate] = 0, SaveBizz(b), SaveBizzProduct(b, false), ids++;
	}
	saveDatail4 = GetTickCount()-time4;

	new time5 = GetTickCount();
	UpdateSaveOrganization();
	saveDatail5 = GetTickCount()-time5;

	mysql_tquery(pearsq, "COMMIT;");

	new string[160];
	format(string, sizeof(string), " [ ADM ]: Выполнено [Сохранено: %d, i %d, f %d, wh %d, b %d, org %d][ Потрачено: %d ms]", ids, 
		saveDatail1, saveDatail2, saveDatail3, saveDatail4, saveDatail5,
		GetTickCount()-time);
	ABroadCast(COLOR_ADM,string,1);

	format(string, sizeof(string), " [ ADM ]: Результат: saveacc0 %d, saveacc1 %d, saveacc2 %d, saveacc3 %d, saveacc4 %d, saveacc5 %d, saveacc6 %d",
		saveacc0, saveacc1, saveacc2, saveacc3, saveacc4, saveacc5, saveacc6);
	ABroadCast(COLOR_ADM,string,1);
 	return 1;
}


public GetClosestPlayer(p1)
{
	new Float:dis,Float:dis2,player;
	player = -1;
	dis = 99999.99;
	foreach(Player,x)
	{
		if(x != p1)
		{
			dis2 = GetDistanceBetweenPlayers(x,p1);
			if(dis2 < dis && dis2 != -1.00)
			{
				dis = dis2;
				player = x;
			}
		}
	}
	return player;
}
stock PayDay(playerid)
{
    new string[144], othernal, porataxes, Days = getdate(), thour, kolexp = 1, allsum;
	PlayerInfo[playerid][pConnectTime] += 1;

 	if(PlayerInfo[playerid][pX2exp] >= 1) PlayerInfo[playerid][pX2exp] -= 1, kolexp += 1; // X2 Exp
	if(GetPlayerVip(playerid) > 0)
	{
	    PlayerInfo[playerid][pPayDayHad] ++;
	    if(PlayerInfo[playerid][pPayDayHad] >= 5) PlayerInfo[playerid][pPayDayHad] = 0, kolexp += 1; // 5 Exp
	}
	SendClientMessage(playerid, COLOR_GREY, "{ffcc66}|______________________ {0088ff}Pay Day {ffcc66}_______________________|");
	PlayerInfo[playerid][pExp] += kolexp;
	format(string,sizeof(string),"  {0088ff}Опыт: {ffcc66}+%d Exp", kolexp), SendClientMessage(playerid, COLOR_GREY, string);

	if(PlayerInfo[playerid][pGameDay] == Days) thour = (PlayerInfo[playerid][pGameTime]+PlayerInfo[playerid][pGameAfk])/3598;
	else thour = 0;

	format(string,sizeof(string),"  {0088ff}Часов в Игре: {ffcc66}Сегодня: %d | Общее: %d", thour, PlayerInfo[playerid][pConnectTime]), SendClientMessage(playerid, COLOR_GREY, string);

	// Налог на транспорт
	for(new i = 0; i < MAX_MYVEHICLE; i++)
	{
    	if(PlayerInfo[playerid][pMyVeh][i] != 0)
		{
			othernal += Procent(1, GetVehiclePriceGos(PlayerInfo[playerid][pMyVeh][i]));
			if(PlayerInfo[playerid][pVehTax][i] >= 20 && PlayerInfo[playerid][pVehTax][i] <= 50) porataxes = 1;
			else if(PlayerInfo[playerid][pVehTax][i] >= 51 && PlayerInfo[playerid][pVehTax][i] <= 100) porataxes = 2;
			else if(PlayerInfo[playerid][pVehTax][i] >= 101) porataxes = 3;
			if(othernal >= 1) PlayerInfo[playerid][pVehTax][i] += 1;
		}
	}
	if(othernal >= 1)
	{
	    new yes = 0;
		if(PlayerInfo[playerid][pAutoTax])
		{
		    if(PlayerInfo[playerid][pAccount] >= PlayerInfo[playerid][pTaxes][0]+othernal)
		    {
				yes = 1;
		    	PlayerInfo[playerid][pAccount] -= PlayerInfo[playerid][pTaxes][0]+othernal;
		    	allsum += PlayerInfo[playerid][pTaxes][0]+othernal;
		    	format(string, sizeof(string), "  {0088ff}Налог на Транспорт: {ffcc66}%d$ | {99ff66}Оплачен", PlayerInfo[playerid][pTaxes][0]+othernal);
				SendClientMessage(playerid, COLOR_GREY, string);
		    	PlayerInfo[playerid][pTaxes][0] = 0;
				for(new i = 0; i < MAX_MYVEHICLE; i++) PlayerInfo[playerid][pVehTax][i] = 0;
		    }
		}
		if(yes == 0)
		{
			PlayerInfo[playerid][pTaxes][0] += othernal;
    		if(porataxes == 0) format(string, sizeof(string), "  {0088ff}Налог на Транспорт: {ffcc66}%d$", othernal), SendClientMessage(playerid, COLOR_GREY, string);
    		else if(porataxes == 1) format(string, sizeof(string), "  {0088ff}Налог на Транспорт: {ffcc66}%d$ | {FF6347}Долг: %d$", othernal, PlayerInfo[playerid][pTaxes][0]), SendClientMessage(playerid, COLOR_GREY, string);
    		else if(porataxes >= 2) format(string, sizeof(string), "  {0088ff}Налог на Транспорт: {ffcc66}%d$ | {ff0000}Долг: %d$", othernal, PlayerInfo[playerid][pTaxes][0]), SendClientMessage(playerid, COLOR_GREY, string);
 		}
		SavePlayerTaxesVehicle(playerid); // Сохраняем налоги на транспорт
	}
	new d = PlayerInfo[playerid][pDom], b = PlayerInfo[playerid][pBusiness];
	if(d > 0 && DomInfo[d][dTaxes] > 0)
	{
	    new yes = 0;
		if(PlayerInfo[playerid][pAutoTax])
		{
		    new naldom;
		    if(d > 0) naldom += DomInfo[d][dTaxes];
			if(PlayerInfo[playerid][pAccount] >= naldom)
		    {
		    	PlayerInfo[playerid][pAccount] -= naldom;
		    	allsum += naldom;
				format(string, sizeof(string), "  {0088ff}Налог на Недвижимость {ffcc66}Долг: %d$ | {99ff66}Оплачен", naldom), SendClientMessage(playerid, COLOR_GREY, string);
				if(d > 0) DomInfo[d][dTaxes] = 0, DomInfo[d][dTaxday] = 0, SaveTax_Dom(d);
				yes = 1;
			}
		}
		if(yes == 0)
		{
			if(DomInfo[d][dTaxday] >= 5 ) format(string, sizeof(string), "  {0088ff}Налог на Недвижимость {FF6347}Долг: %d$", DomInfo[d][dTaxes]), SendClientMessage(playerid, COLOR_GREY, string);
		}
	}
	if(PlayerInfo[playerid][pTaxes][1] > 0)
	{
		PlayerInfo[playerid][pPlaTax] ++;
		if(PlayerInfo[playerid][pPlaTax] > 20)
		{
			format(string, sizeof(string), "  {0088ff}Подоходный Налог {FF6347}Долг: %d$", PlayerInfo[playerid][pTaxes][1]), SendClientMessage(playerid, COLOR_GREY, string);
		}
	}
	if(b > 0 && BizzInfo[b][bTaxes] > 0)
	{
		new yes = 0;
		if(PlayerInfo[playerid][pAutoTax])
		{
			if(PlayerInfo[playerid][pAccount] >= BizzInfo[b][bTaxes])
		    {
		    	PlayerInfo[playerid][pAccount] -= BizzInfo[b][bTaxes];
		    	allsum += BizzInfo[b][bTaxes];
				format(string, sizeof(string), "  {0088ff}Налог на Бизнес {ffcc66}Долг: %d$ | {99ff66}Оплачен", BizzInfo[b][bTaxes]), SendClientMessage(playerid, COLOR_GREY, string);
				BizzInfo[b][bTaxes] = 0, BizzInfo[b][bTaxday] = 0, BizzInfo[b][bUpdate] = 1;
				yes = 1;
			}
		}
		if(yes == 0)
		{
			if(BizzInfo[b][bTaxday] >= 5) format(string, sizeof(string), "  {0088ff}Налог на Бизнес {FF6347}Долг: %d$", BizzInfo[b][bTaxes]), SendClientMessage(playerid, COLOR_GREY, string);
		}
	}
    //===========================
    if(PlayerInfo[playerid][pAmmos11] >= 500 && PlayerInfo[playerid][pAmmos11] < 19999) format(string, sizeof(string), "  {0088ff}Неоплаченные Штрафы: {ffcc66}%d$", PlayerInfo[playerid][pAmmos11]), SendClientMessage(playerid, COLOR_GREY, string);
    if(PlayerInfo[playerid][pAmmos11] >= 20000)
    {
    	// if(PlayerInfo[playerid][pJailed] == 0) SetPlayerCriminal(0,playerid,255, "Неуплата штрафов",2);
		format(string, sizeof(string), "  {0088ff}Неоплаченные Штрафы: {FF6347}%d$", PlayerInfo[playerid][pAmmos11]), SendClientMessage(playerid, COLOR_GREY, string);
    }
    if(PlayerInfo[playerid][pKomnata] != 9999 && PlayerInfo[playerid][pKomnata] >= 1 && PlayerInfo[playerid][pDom] == 0 && PlayerInfo[playerid][pMember] == 0)
	{
		SendClientMessage(playerid, COLOR_GREY, "  {0088ff}Номер в Отеле: {ffcc66}-100$");
		PlayerInfo[playerid][pAccount] -= 100;
		allsum += 100;
	}

	if(PlayerInfo[playerid][pMember] > 0 && PlayerInfo[playerid][pMember] <= 18 || PlayerInfo[playerid][pFbi] > 0)
	{
		new org_salary = GetSalary(PlayerInfo[playerid][pRank], PlayerInfo[playerid][pMember], PlayerInfo[playerid][pFbi]);
		if(org_salary > 0)
		{
			MoneyLog("salary", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", org_salary, "Орг. зарплата (PayDay)");
			SendClientMessage(playerid, COLOR_GREY, "  {0088ff}Зарплата в организации: {99ff66}%d$", org_salary);
			PlayerInfo[playerid][pAccount] += org_salary;
		}
	}

	new tenhour = 0;
	if(d > 0)
	{
		DomInfo[d][dPastime] ++;
		if(DomInfo[d][dPastime] >= 10)
		{
			DomInfo[d][dPastime] = 0;
			DomInfo[d][dData] = gettime()+2592000;
			tenhour = 1;
		}
		SaveDom(d);
	}
	if(b > 0)
	{
		BizzInfo[b][bPastime] ++;
		if(BizzInfo[b][bPastime] >= 10)
		{
			BizzInfo[b][bPastime] = 0;
			BizzInfo[b][bData] = gettime()+2592000;
			if(tenhour == 1) tenhour = 3;
			else tenhour = 2;
		}
		BizzInfo[b][bUpdate] = 1;
	}
	if(tenhour == 1) SendClientMessage(playerid, COLOR_GREY, "  {0088ff}О доме: {ffcc66}10 Часов выполнено!");
	else if(tenhour == 2) SendClientMessage(playerid, COLOR_GREY, "  {0088ff}О бизнесе: {ffcc66}10 Часов выполнено!");
	else if(tenhour == 3) SendClientMessage(playerid, COLOR_GREY, "  {0088ff}О доме и бизнесе: {ffcc66}10 Часов выполнено!");

	BonusCheck(playerid); // Бонус за часы в игре (За определённый день)

	SendClientMessage(playerid, COLOR_GREY, "{ffcc66}|_____________________________________________________|");
	PlayerPlayMusic(playerid);
	PlayerInfo[playerid][pPayDay] = 0;

	// Обновляем количество Exp игрока
	UpdatePlayerExp(playerid);

	abandoned(playerid);
	
	if(PlayerInfo[playerid][pAchieve][109] == 0 && thour == 8) AchievePlayer(playerid, 109, 1);
	if(PlayerInfo[playerid][pAchieve][110] == 0 && thour == 16) AchievePlayer(playerid, 110, 1);
	if(PlayerInfo[playerid][pAchieve][111] == 0 && thour == 22) AchievePlayer(playerid, 111, 1);
	
	if(allsum > 0) 
	{
		MoneyLog("taxes", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -allsum, "Автооплата налогов");
		PutMoneyToTreasury(allsum, "Оплата налогов"); // Кладём налоги в казну
	}
	return 1;
}

// Обновляем количество Exp игрока
stock UpdatePlayerExp(playerid)
{
	new nxtlevel = PlayerInfo[playerid][pLevel]+1;
	new expamount = nxtlevel*4;
	
	if(PlayerInfo[playerid][pExp] >= expamount)
	{
		PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);PlayerPlayMusic(playerid);PlayerInfo[playerid][pLevel] +=1;
		PlayerInfo[playerid][pExp] = 0;
		PlayerInfo[playerid][pAge]++;
		if(PlayerInfo[playerid][pLevel] >= 3 && PlayerInfo[playerid][pPromoreg] >= 1) GiveMyPromo(playerid);
		if(PlayerInfo[playerid][pReferalID] >= 1)
		{
			if(PlayerInfo[playerid][pLevel] == 5)
			{
				new string[120];
				mysql_format(pearsq, string,sizeof(string),"SELECT Name, Ref5, Money FROM `pp_igroki` WHERE `user_id` = '%d'",PlayerInfo[playerid][pReferalID]);
        		mysql_tquery(pearsq, string, "Call_givereferal", "dd", playerid,PlayerInfo[playerid][pReferalID]);
			}
		}
		if(PlayerInfo[playerid][pAchieve][2] == 0 && PlayerInfo[playerid][pLevel] >= 5) AchievePlayer(playerid, 2, 1);
		if(PlayerInfo[playerid][pAchieve][56] == 0 && PlayerInfo[playerid][pLevel] >= 10) AchievePlayer(playerid, 56, 1);
		if(PlayerInfo[playerid][pAchieve][57] == 0 && PlayerInfo[playerid][pLevel] >= 20) AchievePlayer(playerid, 57, 1);
		if(PlayerInfo[playerid][pAchieve][58] == 0 && PlayerInfo[playerid][pLevel] >= 30) AchievePlayer(playerid, 58, 1);
		if(PlayerInfo[playerid][pAchieve][59] == 0 && PlayerInfo[playerid][pLevel] >= 40) AchievePlayer(playerid, 59, 1);
		if(PlayerInfo[playerid][pAchieve][60] == 0 && PlayerInfo[playerid][pLevel] >= 50) AchievePlayer(playerid, 60, 1);
		if(PlayerInfo[playerid][pAchieve][61] == 0 && PlayerInfo[playerid][pLevel] >= 100) AchievePlayer(playerid, 61, 1);
	}
	mysql_save(playerid, 2);
	return true;
}


public split(const strsrc[], strdest[][], delimiter)
{
	new i, li;
	new aNum;
	new len;
	while(i <= strlen(strsrc)){
	    if(strsrc[i]==delimiter || i==strlen(strsrc)){
	        len = strmid(strdest[aNum], strsrc, li, i, 128);
	        strdest[aNum][len] = 0;
	        li = i+1;
	        aNum++;
		}
		i++;
	}
	return 1;
}

// NEW MYSQL
//====================
function CheckRegister(playerid, const password[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		TextDrawShowForPlayer(playerid, Chernifon);
		new str[74],sctring[222];
		format(str,sizeof(str),"\n{cccccc}Извините, {FF6347}%s. {cccccc}Этот никнейм занят!", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Пожалуйста, придумайте новый никнейм и возвращайтесь"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ff9000}[ Esc >> Выход ]\n"), strcat(sctring,str);
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Регистрация",sctring,"Ок","");
		Kickx(playerid);
		return 1;
	}
	else
	{
		bcrypt_hash(playerid, "OnPasswordHashRegister", password, BCRYPT_COST);
	}
	return 1;
}

function Call_yesref(playerid, refid)
{
    new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new datad4, f_str[160];
	    cache_get_value_name_int(0, "RefReg", datad4);
	    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `RefReg` = '%d' WHERE `user_id`='%d'", datad4+1, refid);
		query_empty(pearsq, f_str);
	    mysql_format(pearsq, f_str,sizeof(f_str),"UPDATE `pp_igroki` SET `Referal` = '%e', `ReferalID` = '%d' WHERE `user_id`='%d'", 
			PlayerInfo[playerid][pReferal],PlayerInfo[playerid][pReferalID], PlayerInfo[playerid][pID]);
		query_empty(pearsq, f_str);
	    new giveplayerid = ReturnUser(PlayerInfo[playerid][pReferal], 1);
	    if(IsOnline(giveplayerid)) PlayerInfo[giveplayerid][pRefreg] ++;
	}
	return 1;
}

function Call_getid(playerid)
{
	new string[194];
	PlayerInfo[playerid][pID] = cache_insert_id();

	// Записываем GPCI игрока
	if(CreateGPCI(playerid)) return 1;

	// Процесс создания аккаунта
	CreateAccountProcess(playerid);

	// Создаём дополнительные таблицы игрока в базу данных
	CreateAdditionalyDatabase(PlayerInfo[playerid][pID]);

	// Отправляем запрос в pears bridge
	RegisterAccountBridge(playerid);
	
	// Логинимся
	OnPlayerLogin(playerid, 0);
	
	// Реферал
	if(PlayerInfo[playerid][pReferalID] > 0)
	{
		mysql_format(pearsq, string,sizeof(string),"SELECT RefReg FROM `pp_igroki` WHERE `user_id` = '%d'",PlayerInfo[playerid][pReferalID]);
 		mysql_tquery(pearsq, string, "Call_yesref", "dd", playerid,PlayerInfo[playerid][pReferalID]);
	}
	
	// Игрок использовал промокод при регистрации
	if(PlayerInfo[playerid][pPromoreg] > 0)
	{
	    new pf;
		for(new f = 0; f < MAX_PROMO; f++)
		{
			if(PromoInfo[f][roNewid] == PlayerInfo[playerid][pPromoreg])
			{
				pf = f;
				break;
			}
		}
		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Promoreg` = '%d', `Promoins` = '%d' WHERE `user_id` = '%d'", 
			PromoInfo[pf][roNewid], PromoInfo[pf][roNewid], PlayerInfo[playerid][pID]);
		mysql_tquery(pearsq, string);
		PromoInfo[pf][roNumber] ++;
		SavePromo(10, pf);

		// Записываем в лог, что мы взяли этот промокод
		PromoLog(playerid, pf);
	}
	
	// Логируем Регистрацию
	ConnectLog(playerid, "register");
	
	// Показываем на Сервере
	foreach(Player,i)
	{
         if(GetPVarInt(i,"Readcon") == 1) SendDeathMessageToPlayer(i, INVALID_PLAYER_ID, playerid, 200);
 	}

	// Включаем подсказки на работах по умолчанию
	PlayerInfo[playerid][pJobHint] = true;
 	
 	// Сохраняем Аккаунт
 	gMysqlSaveCheck[playerid] = 1;
	PlayerInfo[playerid][pTypoihyi] = 0;
	GF_OnPlayerUpdate(playerid);
	Login[3][playerid] = 1;
	printf("GF_OnPlayerUpdate(%s) регистрация (MySQL ID: %d)", PlayerInfo[playerid][pName], PlayerInfo[playerid][pID]);
	return 1;
}
public OnPlayerRegister(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		TextDrawShowForPlayer(playerid, Chernifon);
		new str[114],sctring[282];
		format(str,sizeof(str),"\n{cccccc}Извините, {FF6347}%s. {cccccc}Такой аккаунт уже зарегистрирован!", PlayerInfo[playerid][pName]), strcat(sctring,str);
		format(str,sizeof(str),"\n{FF6347}Пожалуйста, придумайте новый никнейм и возвращайтесь"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ff9000}[ Esc >> Выход ]\n"), strcat(sctring,str);
		ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{ff9000}Регистрация",sctring,"Ок","");
		Kickx(playerid);
		return 1;
	}
	else
	{
	    printf("OnPlayerRegister %s",PlayerInfo[playerid][pName]);
		new f_str[534];
		new unixtime = gettime();
		PlayerInfo[playerid][pRegData] = unixtime;
		mysql_format(pearsq, f_str, sizeof(f_str), "INSERT INTO `pp_igroki` SET `Name`='%e',`Key`='%e',`Mail`='%e',`MailStat`='%d',`Model`='%d',`RegData`='%d'", 
			PlayerInfo[playerid][pName], PlayerInfo[playerid][pKey], PlayerInfo[playerid][pMail], PlayerInfo[playerid][pMailStat], PlayerInfo[playerid][pModel], unixtime);
		mysql_tquery(pearsq, f_str, "Call_getid", "d", playerid);
	}
	return 1;
}

// NEW MYSQL
//====================================
stock GF_OnPlayerUpdate(playerid, bool:transaction = true, bool:saveall = false)
{
		if(OnlineInfo[playerid][oLogged] >= 1)
		{
			// Начало транзакции
			if(transaction == true) mysql_tquery(pearsq, "START TRANSACTION;");

			new big_query[3600];

			new time0 = GetTickCount();
			mysql_format(pearsq, big_query, sizeof(big_query), "UPDATE `pp_igroki` SET `Level`='%d',\
				`Banned`='%d',`Soska`='%d',`DonateRank`='%d',`ConnectTime`='%d',",PlayerInfo[playerid][pLevel],
				PlayerInfo[playerid][pBanned], PlayerInfo[playerid][pSoska], PlayerInfo[playerid][pDonateRank], PlayerInfo[playerid][pConnectTime]); // 108 + 55
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Sex`='%d',`Age`='%d',`Origin`='%d',`Komnata`='%d',`KomnataCity`='%d',`Exp`='%d',\
				`Money`='%d',`Account`='%d',`Crimes`='%d',`Kills`='%d',`Deaths`='%d',`Abandoned`='%d',`AData`='%d',`TrackSm`='%d',`TrackRac`='%d',", big_query,
				PlayerInfo[playerid][pSex],PlayerInfo[playerid][pAge],PlayerInfo[playerid][pOrigin],PlayerInfo[playerid][pKomnata],PlayerInfo[playerid][pKomnataCity],PlayerInfo[playerid][pExp],
				oGetPlayerMoney(playerid),PlayerInfo[playerid][pAccount],PlayerInfo[playerid][pCrimes],PlayerInfo[playerid][pKills],PlayerInfo[playerid][pDeaths],
				PlayerInfo[playerid][pAbandoned], PlayerInfo[playerid][pAData], PlayerInfo[playerid][pTrackSm], PlayerInfo[playerid][pTrackRac]); // 221 + 165
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Jailed`='%d',`JailTime`='%d',`MuteTime`='%d',`Leader`='%d',`Member`='%d',\
				`Rank`='%d',`Vig`='%d',`BoxSkill`='%d',`LawSkill`='%d',`MechSkill`='%d',`draw_lang`='%d',`PameText2`='%e',", big_query,
				PlayerInfo[playerid][pJailed],PlayerInfo[playerid][pJailTime],PlayerInfo[playerid][pMuteTime],PlayerInfo[playerid][pLeader],PlayerInfo[playerid][pMember],
				PlayerInfo[playerid][pRank],PlayerInfo[playerid][pVig],PlayerInfo[playerid][pBoxSkill],PlayerInfo[playerid][pLawSkill],PlayerInfo[playerid][pMechSkill],PlayerInfo[playerid][pDrawLanguage],PameText2[playerid]); // 207 + 132 + 84
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Team`='%d',`Model`='%d',`Houserent`='%d',\
				`CarLic`='%f',`FlyLic`='%f',`BoatLic`='%f',`MotoLic`='%f',`GunLic`='%d',`HeliLic`='%f',`Model2`='%d',`Model3`='%d',`Pame`='%d',`PameText`='%e',",  big_query,
				PlayerInfo[playerid][pTeam],PlayerInfo[playerid][pModel],PlayerInfo[playerid][pHouserent],
				PlayerInfo[playerid][pCarLic],PlayerInfo[playerid][pFlyLic],PlayerInfo[playerid][pBoatLic],PlayerInfo[playerid][pMotoLic],PlayerInfo[playerid][pGunLic],PlayerInfo[playerid][pHeliLic],PlayerInfo[playerid][pModel2],PlayerInfo[playerid][pModel3], Pame[playerid], PameText[playerid]); // 195 + 77 + 100 + 84
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Hit`='%d',`Qwest`='%d',`Salary`='%d',`Placement`='%d',`Anima`='%d',`Animb`='%d',`Animc`='%d',\
				`Animd`='%d',`Anime`='%d',`Animf`='%d',`PrisonRank`='%d',`Hodka`='%d',`BonHour`='%d',`Today`='%d',`Plaip`='%e',`Question`='%d',`Exchat`='%d',", big_query,
				gHitMoney[playerid],PlayerInfo[playerid][pQwest],PlayerInfo[playerid][pSalary],PlayerInfo[playerid][pPlacement],AnimInfo[0][playerid],AnimInfo[1][playerid],AnimInfo[2][playerid],
				AnimInfo[3][playerid],AnimInfo[4][playerid],AnimInfo[5][playerid],PlayerInfo[playerid][pPrisonRank],PlayerInfo[playerid][pHodka],PlayerInfo[playerid][pBonHour],PlayerInfo[playerid][pToday],PlayerInfo[playerid][pPlaIP],
				PlayerInfo[playerid][pQuestion], PlayerInfo[playerid][pExchat]); // 340 + 253 + 24
			mysql_format(pearsq, big_query, sizeof(big_query), "%s `Ammo1`='%d',`Ammo2`='%d',`Ammo5`='%d',`Ammo6`='%d',`Ammo7`='%d',\
				`Ammo8`='%d',`PayDay`='%d',`PayDayHad`='%d',`DrugPerk`='%d',`Sty`='%d',`StyBack`='%d',`GameDay`='%d',`GameTime`='%d',`GameAfk`='%d' WHERE `user_id`='%d'", big_query,
				PlayerInfo[playerid][pAmmos1],PlayerInfo[playerid][pAmmos2],PlayerInfo[playerid][pHidden],
				PlayerInfo[playerid][pAmmos6],PlayerInfo[playerid][pAmmos7],PlayerInfo[playerid][pAmmos8],PlayerInfo[playerid][pPayDay],PlayerInfo[playerid][pPayDayHad],PlayerInfo[playerid][pDrugPerk],
				PlayerInfo[playerid][pSty],PlayerInfo[playerid][pStyBack],PlayerInfo[playerid][pGameDay], PlayerInfo[playerid][pGameTime], PlayerInfo[playerid][pGameAfk],
				PlayerInfo[playerid][pID]); // 236 + 176
			query_empty(pearsq, big_query); // Итого 2457 (02.01.24)
			if(saveall) saveacc0 += GetTickCount() - time0;

			new time1 = GetTickCount();
			mysql_format(pearsq, big_query, sizeof(big_query), "UPDATE `pp_igroki` SET `TraderPerk`='%d',`Tut`='%d',`AdmWarns`='%d',`Married`='%d',`Newname`='%d',`MarriedTo`='%e',`SetName`='%e',`Neon`='%d',\
				`Style`='%d',`Cap`='%d',`Beret`='%d',`Voennik`='%d',`Repaa`='%d',\
				`RepTime`='%d',`Warns`='%d',`WarnClearTime`='%d',`Bkyrenie`='%d',",
				PlayerInfo[playerid][pTraderPerk],PlayerInfo[playerid][pTut],PlayerInfo[playerid][pAdmWarns],PlayerInfo[playerid][pMarried],PlayerInfo[playerid][pNewname],PlayerInfo[playerid][pMarriedTo],PlayerInfo[playerid][pSetName],PlayerInfo[playerid][pNeon],
				PlayerInfo[playerid][pStyle],PlayerInfo[playerid][pCap],PlayerInfo[playerid][pBeret],PlayerInfo[playerid][pAbility][2],PlayerInfo[playerid][pRepaa],
				PlayerInfo[playerid][pRepTime],PlayerInfo[playerid][pWarns],PlayerInfo[playerid][pWarnClearTime],PlayerInfo[playerid][pBkyrenie]); // 293 + 176 + 24 + 24
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Meshk1`='%d',`Meshk11`='%d',`Fmute`='%d',`FmuteTime`='%d',`DonateMoney`='%d',`BanDayz`='%d',`BanMonzz`='%d',\
				`BdPoletDayz`='%d',`Typoihyi`='%d',`Djpears`='%d',\
				`Rusk`='%d',`Yapon`='%d',`Italy`='%d',`Kitai`='%d',`Ispan`='%d',`Debil`='%d',", big_query,
				PlayerInfo[playerid][pBusiness],PlayerInfo[playerid][pMeshk11],PlayerInfo[playerid][pFmute],PlayerInfo[playerid][pFmuteTime],PlayerInfo[playerid][pDonateMoney],PlayerInfo[playerid][pBanDayz],PlayerInfo[playerid][pBanMonzz],
				PlayerInfo[playerid][pBdPoletDayz],PlayerInfo[playerid][pTypoihyi],PlayerInfo[playerid][pDjpears],
				PlayerInfo[playerid][pRusk],PlayerInfo[playerid][pYapon],PlayerInfo[playerid][pItaly],PlayerInfo[playerid][pKitai],PlayerInfo[playerid][pIspan],PlayerInfo[playerid][pDebil]); // 270 + 187
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Ranentors`='%d',`Arab`='%d',`Rab`='%d',`Victim`='%e',`Razok`='%d',`Worked1`='%d',\
				`Worked2`='%d',`Worked3`='%d',`Worked4`='%d',`Worked5`='%d',`Infoload`='%d',`Sped`='%d',`Family`='%d',`Famrank`='%d',`Spawnchange`='%d',`Bilet`='%d',", big_query,
				PlayerInfo[playerid][pRanentors],PlayerInfo[playerid][pArab],PlayerInfo[playerid][pRab],PlayerInfo[playerid][pVictim],PlayerInfo[playerid][pRazok],PlayerInfo[playerid][pWorked1],
				PlayerInfo[playerid][pWorked2],PlayerInfo[playerid][pWorked3],PlayerInfo[playerid][pWorked4],PlayerInfo[playerid][pWorked5],PlayerInfo[playerid][pInfoload],PlayerInfo[playerid][pSped],
				PlayerInfo[playerid][pFamily],PlayerInfo[playerid][pFamrank],PlayerInfo[playerid][pSpawnchange],PlayerInfo[playerid][pBilet]); // 284 + 198 + 24
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`HataCena`='%d',\
			    `Gun11`='%d',`Gun13`='%d',`Ammo11`='%d',`Worked6`='%d',`Fbi`='%d',`RukzWorld`='%d',`Unit`='%d',`X2exp`='%d',`Insult`='%d',`CallSign`='%e',`AccessoryReload`='%d',\
				`pLastPos0`='%f',`pLastPos1`='%f',`pLastPos2`='%f',`pLastPos3`='%f',`pLastWorld`='%d',`pLastInt`='%d',\
				`deathStatus`='%d',`deathTime`='%d',`deathUnix`='%d',`deathReason`='%d',", big_query,
				PlayerInfo[playerid][pHataCena],PlayerInfo[playerid][pGuns11],PlayerInfo[playerid][pDom],
				PlayerInfo[playerid][pAmmos11],PlayerInfo[playerid][pWorked6],PlayerInfo[playerid][pFbi],PlayerInfo[playerid][pRukzWorld],PlayerInfo[playerid][pUnit],
				PlayerInfo[playerid][pX2exp],PlayerInfo[playerid][pInsult],PlayerInfo[playerid][pCallSign], PlayerInfo[playerid][pAccessoryReload],
				PlayerInfo[playerid][pLastPos][0],PlayerInfo[playerid][pLastPos][1],PlayerInfo[playerid][pLastPos][2],PlayerInfo[playerid][pLastPos][3],
				PlayerInfo[playerid][pLastWorld],PlayerInfo[playerid][pLastInt],
				DeathInfo[playerid][deathStatus],DeathInfo[playerid][deathTime],DeathInfo[playerid][deathUnix],DeathInfo[playerid][deathReason]); // 328 + 165 + 24 + 80
			mysql_format(pearsq, big_query, sizeof(big_query), "%s`Taxes0`='%d',`Taxes1`='%d',`AutoTax`='%d',`PlaTax`='%d',\
				`Ability0`='%d',`AbilStat0`='%d',`Ability1`='%d',`AbilStat1`='%d',`RentBenz0`='%d',`RentBenz1`='%d',`Armour`='%f',`Message`='%d',`MessUnix`='%d',`Gpci`='%e',`Offtime` = NOW() WHERE `user_id`='%d'", big_query,
				PlayerInfo[playerid][pTaxes][0],PlayerInfo[playerid][pTaxes][1],
				PlayerInfo[playerid][pAutoTax],PlayerInfo[playerid][pPlaTax],PlayerInfo[playerid][pAbility][0],PlayerInfo[playerid][pAbilStat][0],PlayerInfo[playerid][pAbility][1],
				PlayerInfo[playerid][pAbilStat][1],PlayerInfo[playerid][pRentBenz][0],PlayerInfo[playerid][pRentBenz][1],PlayerInfo[playerid][pArmor],PlayerInfo[playerid][pMessage],PlayerInfo[playerid][pMessUnix],PlayerInfo[playerid][pGpci],
				PlayerInfo[playerid][pID]); // 257 + 143 + 20 + 64
			query_empty(pearsq, big_query); // Итого 2561 (02.01.24)
			if(saveall) saveacc1 += GetTickCount() - time1;

			new time2 = GetTickCount();
			mysql_format(pearsq, big_query, sizeof(big_query), "UPDATE `pp_igroki` SET `find_X`='%f',`find_Y`='%f',`find_Z`='%f',`pBottlePoint`='%d',\
			 	`pNotCloseVeh`='%d',`pSunScreen`='%d',`pManiacCD`='%d',`pRadioInterceptorFindCd`='%d',`pCDAd`='%d',`pCDGraves`='%d',`pDatabaseActive`='%d' WHERE `user_id`='%d'",
				PlayerInfo[playerid][find_X],PlayerInfo[playerid][find_Y],PlayerInfo[playerid][find_Z],PlayerInfo[playerid][pBottlePoint],
				PlayerInfo[playerid][pNotCloseVeh], PlayerInfo[playerid][pSunScreen], PlayerInfo[playerid][pManiacCD], PlayerInfo[playerid][pRadioInterceptorFindCd],
				PlayerInfo[playerid][pCDAd], PlayerInfo[playerid][pCDGraves], PlayerInfo[playerid][pDatabaseActive],
				PlayerInfo[playerid][pID]);
			query_empty(pearsq, big_query);

			mysql_format(pearsq, big_query, sizeof(big_query), "UPDATE `pp_igroki` SET `pCourtsStatus`='%d',`pJobHint`='%d',`pHankServices`='%d',`Fame`='%d',\
				`pDamagInf`='%d' WHERE `user_id`='%d'",\
				PlayerInfo[playerid][pCourtsStatus],
				PlayerInfo[playerid][pJobHint],
				PlayerInfo[playerid][pHankServices],
				Fame[playerid],
				PlayerInfo[playerid][pDamagInf],
				PlayerInfo[playerid][pID]); // 88 + 12 + 12
			query_empty(pearsq, big_query); // Итого 112 (08.05.24)

			mysql_format(pearsq, big_query, sizeof(big_query), "UPDATE `pp_igroki` SET `pUnixRename`='%d' WHERE `user_id`='%d'",\
				PlayerInfo[playerid][pUnixRename],
				PlayerInfo[playerid][pID]);
			query_empty(pearsq, big_query); // (09.08.24)
			if(saveall) saveacc2 += GetTickCount() - time2;
			
			new time3 = GetTickCount();
			SaveGun(playerid);
			//mysql_save(playerid, 18);
			mysql_save(playerid, 39);
			mysql_save(playerid, 8); // квартиры
			update_allillness(playerid);
			if(saveall) saveacc3 += GetTickCount() - time3;

			new time5 = GetTickCount();
			SaveInventAll(playerid, transaction);
			if(saveall) saveacc5 += GetTickCount() - time5;

			new time6 = GetTickCount();
			if(IsAUpdateM(playerid) > 0) SaveMarkAll(playerid, transaction);
			if(saveall) saveacc6 += GetTickCount() - time6;
			
			new time4 = GetTickCount();
			if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pLeader] >= 1) mysql_save(playerid, 31);
			
			for(new pdra = 0; pdra < 14; pdra++)
			{
				if(PlayerInfo[playerid][pDrawUpdate][pdra] == true) update_draw(playerid, pdra);
			}

			// Сохраняем настройки чатов
    		if(PlayerInfo[playerid][pTransmitterUpdate] == true) SaveTransmitterOff(playerid);
			if(saveall) saveacc4 += GetTickCount() - time4;

			// Завершение транзакции
			if(transaction == true) mysql_tquery(pearsq, "COMMIT;");
			
            printf("GF_OnPlayerUpdate %s",PlayerInfo[playerid][pName]);
		}
		gMysqlSaveCheck[playerid] = 0;
	    return 1;
}
function AutoLogin(playerid)
{
	ATimerStat[playerid] = 0, KillTimer(AutoTimer[playerid]);
	KickThisPlayer(playerid);
	GoSpawn(playerid);
	return 1;
}
stock OnPlayerLogin(playerid, stat)
{
	printf("OnPlayerLogin(%d, stat %d) - %s", playerid, stat, PlayerInfo[playerid][pName]);

    new unixtime = gettime();
    if(PlayerInfo[playerid][pBanned] == 1)
    {
		if(unixtime >= PlayerInfo[playerid][pBanDayz])
    	{
    		PlayerInfo[playerid][pBanDayz] = 0;PlayerInfo[playerid][pBanned] = 0;
      		GameTextForPlayer(playerid, RusToGame("~g~Аккаунт Разбанен"), 10000, 4);
    	}
		else
		{
			new ostalos = PlayerInfo[playerid][pBanDayz]-unixtime;
			new osday = ostalos/86400;
			new vrem = ostalos-osday*86400;
   			new oshour = vrem/3600;
   			new vrem2 = vrem-oshour*3600;
   			new osminute = vrem2/60;
   			TextDrawShowForPlayer(playerid, Chernifon);
			new str[100],sctring[640];
			format(str,sizeof(str),"{ff0000}______________________________________________________________________________");
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ffffff}Здравствуйте! {FF8282}%s",PlayerInfo[playerid][pName]);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}К сожалению этот аккаунт {FF8282}Забанен");
			strcat(sctring,str);
			if(ostalos >= 86400) format(str,sizeof(str),"\n{ffffff}До окончания бана осталось: {FF8282}%d дней, %d часов, %d минут",osday,oshour,osminute), strcat(sctring,str);
			else if(ostalos <= 86399 && ostalos >= 3600) format(str,sizeof(str),"\n{ffffff}До окончания бана осталось: {FF8282}%d часов, %d минут",ostalos/3600,osminute), strcat(sctring,str);
			else format(str,sizeof(str),"\n{ffffff}До окончания бана осталось: {FF8282}%d минут",ostalos/60), strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Имя Администратора: {FF8282}%s",PlayerInfo[playerid][pBanAdmin]);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Дата и Время Бана: {FF8282}%s",PlayerInfo[playerid][pBanData]);
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Причина Бана: {cccccc}%s",PlayerInfo[playerid][pBanResult]);
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ffffff}Если вы считаете, что это ошибка. Сделайте скриншот {FF8282}[ F8 ]");
			strcat(sctring,str);
			format(str,sizeof(str),"\n{ffffff}Затем напишите жалобу на администратора на форум {FF8282}forum.pears.fun");
			strcat(sctring,str);
			format(str,sizeof(str),"\n\n{ff0000}______________________________________________________________________________");
			strcat(sctring,str);
			ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{FFFFFF}**** {FF0000}*Аккаунт Забанен* {FFFFFF}****",sctring,"*","");
			Kickx(playerid);
		    return 1;
		}
    }
    else if(PlayerInfo[playerid][pBanned] == 2)
    {
    	new ostalos = PlayerInfo[playerid][pBanDayz]-unixtime;
		new osday = ostalos/86400;
		TextDrawShowForPlayer(playerid, Chernifon);
		new str[100],sctring[640];
		format(str,sizeof(str),"{ff0000}______________________________________________________________________________");
		strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ffffff}Здравствуйте! {FF8282}%s",PlayerInfo[playerid][pName]);
		strcat(sctring,str);
		format(str,sizeof(str),"\n{ffffff}К сожалению этот аккаунт {FF8282}Забанен Навсегда");
		strcat(sctring,str);
		if(ostalos >= 86400) format(str,sizeof(str),"\n{ffffff}До удаления аккаунта осталось: {FF8282}%d дней",osday), strcat(sctring,str);
		else format(str,sizeof(str),"\n{ffffff}Удаление Аккаунта: {FF8282}Сегодня в 4:00"), strcat(sctring,str);
		format(str,sizeof(str),"\n{ffffff}Имя Администратора: {FF8282}%s",PlayerInfo[playerid][pBanAdmin]);
		strcat(sctring,str);
		format(str,sizeof(str),"\n{ffffff}Дата и Время Бана: {FF8282}%s",PlayerInfo[playerid][pBanData]);
		strcat(sctring,str);
		format(str,sizeof(str),"\n{ffffff}Причина Бана: {cccccc}%s",PlayerInfo[playerid][pBanResult]);
		strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ffffff}Если вы считаете, что это ошибка. Сделайте скриншот {FF8282}[ F8 ]");
		strcat(sctring,str);
		format(str,sizeof(str),"\n{ffffff}Затем напишите жалобу на администратора на форум {FF8282}forum.pears.fun");
		strcat(sctring,str);
		format(str,sizeof(str),"\n\n{ff0000}______________________________________________________________________________");
		strcat(sctring,str);
		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{FFFFFF}**** {FF0000}*Аккаунт Забанен* {FFFFFF}****",sctring,"*","");
		Kickx(playerid);
	    return 1;
    }

    if(gWindowPass[playerid] == 1)
	{
		new quan_player = GetThisPlayer(playerid);
		if(quan_player >= 1)
		{
			TextDrawShowForPlayer(playerid, Chernifon);
			ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","\n{FF6347}Игрок с таким именем уже авторизовался\n{cccccc}Чтобы выйти из игры введите в чат команду {FF6347}/q или ESC >> Выход\n","Ок","");
			Kickx(playerid);
			return 1;
		}
		else
		{
			Login[0][playerid] = 1; // Отмечаем, что мы ввели пароль
			if(stat == 0)
			{
				if(PlayerInfo[playerid][pGoogle] >= 1 && server > 0)
				{
					PlayerPlaySound(playerid,17803,0,0,0);
					new str[200],sctring[460];
					format(str,sizeof(str),"{cccccc}Привет, {ff9000}%s",PlayerInfo[playerid][pName]);
					strcat(sctring,str);
					format(str,sizeof(str),"\n{ff9000}Введите одноразовый код {6699ff}G{ff6666}o{ffcc00}o{6699ff}g{99ff66}l{ff6666}e");
					strcat(sctring,str);
					format(str,sizeof(str),"\n\n{cccccc}Если вы не имеете доступ к коду Google обратитесь на форум");
					strcat(sctring,str);
					ShowDialog(playerid,798,DIALOG_STYLE_INPUT,"{ff9000}Авторизация",sctring,"Далее","Отмена");
				}
				else
				{
				    KickThisPlayer(playerid);
					Login[1][playerid] = 1;

					// Обновляем Данные Автологина
					if(PlayerInfo[playerid][pBdPoletDayz] == 0)
					{
						format(PlayerInfo[playerid][pSafeIP], 30, PlayerInfo[playerid][pPlaIP]);
						PlayerInfo[playerid][pSafeUnix] = unixtime+28800;
						mysql_save2(playerid, 38);
					}
					if(Login[0][playerid] == 1 && Login[1][playerid] == 1) GoSpawn(playerid);
				}
				mysql_save2(playerid, 32);
				PlayerPlaySound(playerid,40405,0,0,0);
				stop_dialog(playerid);
			}
			else ATimerStat[playerid] = 1, AutoTimer[playerid] = SetTimerEx("AutoLogin", 3000, false, "d", playerid);
		}
	}
	return 1;
}
forward OnAdminLoad(playerid);
public OnAdminLoad(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new plrIP[16];
		new pip1[24],pip2[24],pip3[24],pip4[24],pip5[24],pip6[24],pip7[24],pip8[24],pip9[24],pip10[24];
		GetPlayerIp(playerid, plrIP, sizeof(plrIP));
		cache_get_value_name(0, "ip1", pip1, 64);
		cache_get_value_name(0, "ip2", pip2, 64);
		cache_get_value_name(0, "ip3", pip3, 64);
		cache_get_value_name(0, "ip4", pip4, 64);
		cache_get_value_name(0, "ip5", pip5, 64);
		cache_get_value_name(0, "ip6", pip6, 64);
		cache_get_value_name(0, "ip7", pip7, 64);
		cache_get_value_name(0, "ip8", pip8, 64);
		cache_get_value_name(0, "ip9", pip9, 64);
		cache_get_value_name(0, "ip10", pip10, 64);
		if(strfind(plrIP, pip1, true) == 0 || strfind(plrIP,pip2, true) == 0 || strfind(plrIP, pip3, true) == 0 || strfind(plrIP, pip4, true) == 0 || strfind(plrIP, pip5, true) == 0
		|| strfind(plrIP, pip6, true) == 0 || strfind(plrIP, pip7, true) == 0 || strfind(plrIP, pip8, true) == 0 || strfind(plrIP, pip9, true) == 0 || strfind(plrIP, pip10, true) == 0)
		{
               //SendClientMessage(playerid, 0x00C3F6AA,"{0088ff}[Project]: {FFFFFF}Вы прошли ёпта проверку сука");
		}
		else
	    {
			SendClientMessage(playerid, COLOR_WHITE, "{0088ff}[ Аутентификация ]{ffffff}: Вы не прошли проверку аутентификации! (Неверный IP)");
			Kickx(playerid);
			printf("[ Аутентификация ] %s не прошёл проверку (неверный IP)",PlayerInfo[playerid][pName]);
			return 1;
	    }
	}
	else
	{
		SendClientMessage(playerid, COLOR_WHITE, "{0088ff}[ Аутентификация ]{ffffff}: Вы не прошли проверку аутентификации! (Отсутствие Привязки)");
        Kickx(playerid);
        printf("[ Аутентификация ] %s не прошёл проверку (отсутствие файла)",PlayerInfo[playerid][pName]);
        return 1;
	}
	return true;
}
