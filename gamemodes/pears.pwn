CMD:domupgold(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Повысить gold стоимость домов по классам [ /domupgold Класс Сумма ]");
    if(params[0] > 5 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс дома 1 - 5");
	if(params[1] > 100000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сумма повышения не меньше 1G и не больше 100.000G");
 	
	new string_mysql[100];
	mysql_tquery(pearsq, "START TRANSACTION;");
	for(new d = 0; d < sizeof(DomInfo); d++)
	{
	    if(DomInfo[d][dClass] != params[0]) continue;
		DomInfo[d][dGold] += params[1];
		UpdateDom(d);
		
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_dom` SET `dGold`='%d' WHERE `Ids`='%d'", DomInfo[d][dGold], d);
		query_empty(pearsq, string_mysql);
	}
	mysql_tquery(pearsq, "COMMIT;");

	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s повысил gold стоимость домов %d класса {cccccc}[+%dG]", PlayerInfo[playerid][pName],params[0],params[1]);
 	ABroadCast(COLOR_ADM,string,1);
 	AdminLog("domupgold", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Повысил gold стоимость домов");
	return 1;
}

CMD:domdowngold(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Понизить gold стоимость домов по классам [ /domdowngold Класс Сумма ]");
    if(params[0] > 5 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс дома 1 - 5");
	if(params[1] > 100000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сумма понижения не меньше 1G и не больше 100.000G");
 	
	new string_mysql[100];
	mysql_tquery(pearsq, "START TRANSACTION;");
	for(new d = 0; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dClass] != params[0]) continue;
		if(DomInfo[d][dGold]-params[1] <= 1) DomInfo[d][dGold] = 1;
		DomInfo[d][dGold] -= params[1];
		UpdateDom(d);

		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_dom` SET `dGold`='%d' WHERE `Ids`='%d'", DomInfo[d][dGold], d);
		query_empty(pearsq, string_mysql);
	}
	mysql_tquery(pearsq, "COMMIT;");

	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s понизил gold стоимость домов %d класса {cccccc}[-%dG]", PlayerInfo[playerid][pName],params[0],params[1]);
 	ABroadCast(COLOR_ADM,string,1);
 	AdminLog("domdowngold", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Понизил gold стоимость домов");
	return 1;
}

alias:domgoldall("dgall")
CMD:domgoldall(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 22) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");

	if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить gold стоимость домов по классу [ /domgoldall Class Курс ]");
	if(params[0] > 5 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Класс дома 1 - 5");
	if(params[1] > 10000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Курс не меньше 1 и не больше 10.000");

	new string_mysql[100];
	mysql_tquery(pearsq, "START TRANSACTION;");
	for(new d = 0; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dClass] != params[0] || DomInfo[d][dSost2] <= 0) continue;
		DomInfo[d][dGold] = DomInfo[d][dSost2] / params[1];
		UpdateDom(d);

		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_dom` SET `dGold`='%d' WHERE `Ids`='%d'", DomInfo[d][dGold], d);
		query_empty(pearsq, string_mysql);
	}
	mysql_tquery(pearsq, "COMMIT;");

 	new string[144];
	format(string, sizeof(string), " [ ADM ]: %s изменил gold стоимости домов %d класса по курсу %d$", PlayerInfo[playerid][pName], params[0], params[1]);
 	ABroadCast(COLOR_ADM,string,1);

	format(string, sizeof(string), "Gold цена домов %d класса",params[0]);
	AdminLog("domgoldall", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], string);
	return 1;
}

CMD:domlvl(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_MANAGER)) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить уровень дома [ /domlevel ID Уровень ] {ffcc00}[ Выше 50 - Зарезервирован ]");
	if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(params[1] > 100 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Уровень дома не меньше 1 и не больше 100 {ffcc00}[ Выше 50 - Зарезервирован ]");
 	new string[144];
	DomInfo[params[0]][dLevel] = params[1];
	if(params[1] <= 49) format(string, sizeof(string), " [ ADM ]: %s изменил уровень дома № %d {cccccc}[%d]", PlayerInfo[playerid][pName],params[0],params[1]);
	else format(string, sizeof(string), " [ ADM ]: %s зарезервировал дом № %d", PlayerInfo[playerid][pName],params[0]);
	ABroadCast(COLOR_ADM,string,1);
 	UpdateDom(params[0]);
	SaveDom(params[0]);
	HouseLog(0, "domlevel", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], params[1], "");

	format(string, sizeof(string), "Изменил lvl дома № %d",params[0]);
	AdminLog("domlvl", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], string);
	return 1;
}
CMD:domfam(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить id привязанной семьи [ /domfam ID Семья ]");
	if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
	if(params[1] > 500 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер семьи не меньше 1 и не больше 500");
 	new string[144];
	if(params[1] >= 1)
	{
		format(string, sizeof(string), " [ ADM ]: %s привязал к дому № %d семью {cccccc}[%d]", PlayerInfo[playerid][pName],params[0],params[1]);
		ABroadCast(COLOR_ADM,string,1);
		DomInfo[params[0]][dFam] = params[1];
		FamilyInfo[params[1]][fDop5] = params[0], SaveFamily(params[0]);
		if(DomInfo[params[0]][dIngar] >= 1) DomInfo[params[0]][dIngar] = 0, DestroyDynamicPickup(DomGarage[params[0]]), DestroyDynamic3DTextLabel(IngarLabel[params[0]]);
		HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], params[1], "Привязал Семью");
		FamilyLog(params[1], "fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Привязал Дом");
	}
	else
	{
		format(string, sizeof(string), " [ ADM ]: %s отвязал от дома № %d семью {cccccc}[%d]", PlayerInfo[playerid][pName],params[0],DomInfo[params[0]][dFam]);
 		ABroadCast(COLOR_ADM,string,1);
 		if(DomInfo[params[0]][dFam] >= 1 && DomInfo[params[0]][dFam] == FamilyInfo[DomInfo[params[0]][dFam]][fDop5])
		{
	  		FamilyInfo[DomInfo[params[0]][dFam]][fDop5] = 0, SaveFamily(DomInfo[params[0]][dFam]);
	  		FamilyLog(params[1], "fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Отвязал Дом");
		}
		DomInfo[params[0]][dFam] = 0;
		if(DomInfo[params[0]][dIngar] >= 1) DomInfo[params[0]][dIngar] = 0, DestroyDynamicPickup(DomGarage[params[0]]), DestroyDynamic3DTextLabel(IngarLabel[params[0]]);
		HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], params[1], "Отвязал Семью");
	}
	SaveDom(params[0]);
	return 1;
}
CMD:famdom(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Изменить id привязанного дома [ /famdom ID Дом ]");
	if(params[0] > 500 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер семьи не меньше 1 и не больше 500");
	if(params[1] > 1000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");
 	new string[144];
	if(params[1] >= 1)
	{
		format(string, sizeof(string), " [ ADM ]: %s привязал к семье № %d дом {cccccc}[%d]", PlayerInfo[playerid][pName],params[0],params[1]);
		ABroadCast(COLOR_ADM,string,1);
		FamilyInfo[params[0]][fDop5] = params[1];
		if(DomInfo[params[1]][dIngar] >= 1) DomInfo[params[1]][dIngar] = 0, DestroyDynamicPickup(DomGarage[params[1]]), DestroyDynamic3DTextLabel(IngarLabel[params[1]]);
		DomInfo[params[1]][dFam] = params[0], SaveDom(params[1]);
		FamilyLog(params[0], "fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Привязал Дом");
		HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[1], params[0], "Привязал Семью");
	}
	else
	{
		format(string, sizeof(string), " [ ADM ]: %s отвязал от семьи № %d дом {cccccc}[%d]", PlayerInfo[playerid][pName],params[0],FamilyInfo[params[0]][fDop5]);
 		ABroadCast(COLOR_ADM,string,1);
 		if(FamilyInfo[params[0]][fDop5] >= 1 && FamilyInfo[params[0]][fDop5] == DomInfo[FamilyInfo[params[0]][fDop5]][dFam])
		{
			if(DomInfo[FamilyInfo[params[0]][fDop5]][dIngar] >= 1) DomInfo[FamilyInfo[params[0]][fDop5]][dIngar] = 0, DestroyDynamicPickup(DomGarage[FamilyInfo[params[0]][fDop5]]), DestroyDynamic3DTextLabel(IngarLabel[FamilyInfo[params[0]][fDop5]]);
	  		DomInfo[FamilyInfo[params[0]][fDop5]][dFam] = 0, SaveDom(FamilyInfo[params[0]][fDop5]);
	  		HouseLog(0, "dfam", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[1], params[0], "Отвязал Семью");
  		}
		FamilyInfo[params[0]][fDop5] = 0;
		FamilyLog(params[0], "fdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[1], "Отвязал Дом");
	}
	SaveFamily(params[0]);
	return 1;
}
CMD:rbizsklad(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 6) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Очистить склад бизнеса [ /rbizsklad ID ]");
    if(params[0] > 200 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер бизнеса не меньше 1 и не больше 200");

	mysql_tquery(pearsq, "START TRANSACTION;");
	for(new inva = 0; inva < 80; inva++)
	{
	    new bilo;
	    bilo = BizzInfo[params[0]][bInvent][inva];
		BizzInfo[params[0]][bInvent][inva] = 0;
		BizzInfo[params[0]][bInv][inva] = 0;
		BizzInfo[params[0]][bInvPara][inva] = 0;
		BizzInfo[params[0]][bInvQara][inva] = 0;
		BizzInfo[params[0]][bInvType][inva] = 0;
		BizzInfo[params[0]][bInvPack][inva] = 0;
		if(bilo != BizzInfo[params[0]][bInvent][inva]) SaveSkladBiz(params[0], inva);
	}
	mysql_tquery(pearsq, "COMMIT;");

	new string[128];
	format(string, sizeof(string), " [ ADM ]: %s очистил склад бизнеса № %d", PlayerInfo[playerid][pName],params[0]);
 	ABroadCast(COLOR_ADM,string,1);
	BizLog("rbiz", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Очистил Склад");
	return 1;
}
CMD:rdomall(playerid, const params[])
