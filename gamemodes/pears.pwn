stock CheckBenz(playerid)
{
	if(PlayerInfo[playerid][pSped]==0 && UpdateSpeed[playerid] >= 1)
	{
		new vehicle = GetPlayerVehicleID(playerid);
		new str[20], fill = VehInfo[vehicle][vGas] + VehInfo[vehicle][vGelium];
		if(fill >= 80 && fill <= 90)format(str,20,"{66ff33}_________ ");
		else if(fill >= 70 && fill <= 79)format(str,20,"{99cc00}________  ");
		else if(fill >= 60 && fill <= 69)format(str,20,"{ccff00}_______   ");
		else if(fill >= 50 && fill <= 59)format(str,20,"{cccc00}_____     ");
		else if(fill >= 40 && fill <= 49)format(str,20,"{ffcc00}____      ");
		else if(fill >= 30 && fill <= 39)format(str,20,"{ff9900}___       ");
		else if(fill >= 20 && fill <= 29)format(str,20,"{ff6600}__        ");
		else if(fill >= 10 && fill <= 19)format(str,20,"{ff3300}_        ");
		else if(fill <= 9)format(str,20,"{ff0000}_         ");
		else format(str,20,"{33ff00}__________");
		if(UpdateSpeed[playerid]==1)SetDynamicObjectMaterialText(SpdObj[playerid][1],0,str,OBJECT_MATERIAL_SIZE_256x128,"Arial",24,true,0xFF4EFD71,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
		else if(UpdateSpeed[playerid]==2)SetDynamicObjectMaterialText(SpdObj[playerid][1],0,str,OBJECT_MATERIAL_SIZE_512x256,"Arial",64,true,0xFF4EFD71,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
	}
	if(PlayerInfo[playerid][pDrawVisible][7] == false && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8 && DrawSpeed[playerid] == true)
	{
		new v = GetPlayerVehicleID(playerid);
		if(Cars[v] != 52)
		{
		    new fill = VehInfo[v][vGas] + VehInfo[v][vGelium];
			if(fill <= 0) PlayerTextDrawHide(playerid, PlayerSpeedDraw[playerid][7]);
			else
			{
			    new Float:sized_x = PlayerInfo[playerid][pDrawSize_X][7], Float:sized_y = PlayerInfo[playerid][pDrawSize_Y][7];
			    if(Device[playerid] == 1 && PlayerInfo[playerid][pTypeSpeed] == 1) sized_y += DrawSizeSmart_Y[7];
				new Float:maxi, Float:section, Float:her, vremfill;
				if(PlayerInfo[playerid][pTypeSpeed] == 0) maxi = 31.2+sized_y;
				else if(PlayerInfo[playerid][pTypeSpeed] == 1) maxi = 78.0+sized_x/2;
				if(fill > 100) vremfill = 100;
				else vremfill = fill;
				section = (maxi/100)*vremfill;
				her = section;
				her -= her*2;
				if(PlayerInfo[playerid][pTypeSpeed] == 0) PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][7], 4.38+sized_x/4, her);
				else if(PlayerInfo[playerid][pTypeSpeed] == 1) PlayerTextDrawTextSize(playerid, PlayerSpeedDraw[playerid][7], her, 20.0+sized_y/2);
				PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][7]);
			}
			new string[4];
			format(string, sizeof(string), "%d", fill), PlayerTextDrawSetString(playerid, PlayerSpeedDraw[playerid][9], string);
			PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][9]);
		}
	}
}
stock afk_cam(playerid)
{
	if(SleepRP[playerid] == 0 && PlayerInfo[playerid][pSoska] < 10 && OverHear[playerid] == 0 && PlayerInfo[playerid][pJailed] == 0)
	{
		new Float:X, Float:Y, Float:Z, Float:rX, Float:rY, Float:rZ;
		GetPlayerPos(playerid, X, Y, Z);
		GetPlayerCameraFrontVector(playerid, rX, rY, rZ);
		if(AntiAFKX[playerid] == X && AntiAFKY[playerid] == Y && AntiAFKZ[playerid] == Z || AntiCAMX[playerid] == rX && AntiCAMY[playerid] == rY && AntiCAMZ[playerid] == rZ && OnlineInfo[playerid][oLogged] == 1)
		{
			if(AntiAFKX[playerid] != 0.0 && AntiCAMX[playerid] != 0.0)
			{
				AntiCam[playerid] ++;
				if(AntiCam[playerid] >= 3600)
				{
       				SendClientMessage(playerid, COLOR_LIGHTRED, "{ffcc00}Вы были кикнуты сервером по причине: AFK больше 1 Часа");
       				ShowDialog(playerid,1700, 0, "******* {FFcc00}*Вы были Кикнуты* {FFFFFF}*******", "{FFcc00}Вы были кикнуты сервером \n{0088ff}Причина: {FFcc00}AFK больше 1 Часа. ", "Ок", "");
      		 		Kickx(playerid);
	 			}
	 		}
	 		else AntiCam[playerid] = 0;
		}
		else
		{
			AntiAFKX[playerid] = X; AntiAFKY[playerid] = Y; AntiAFKZ[playerid] = Z;
			AntiCAMX[playerid] = rX; AntiCAMY[playerid] = rY; AntiCAMZ[playerid] = rZ;
			AntiCam[playerid] = 0;
		}
	}
}

public Skolkobenza()
{
	new tickTimer = GetTickCount();

	new tmphour, tmpminute, tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	
	if(SektaCNN[0] > -1 && SektaCNN[1] > -1) SektaCNNStart();

	new unix = gettime(), opa;
	for(new v = 0; v < MAX_CARS; v++)
	{
		if(VehInfo[v][vModel] == 0) continue;

		// Выключаем сигнализацию в машине
		if(VehInfo[v][vAlarmSound] > 0)
		{
			VehInfo[v][vAlarmSound] -= 10;
			if(VehInfo[v][vAlarmSound] <= 0)
			{
				GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
				SetVehicleParamsEx(v, engine, lights, false, doors, bonnet, boot, objective);
			}
		}

		if(Cars[v] == 52 || IsAVello(v)) continue;

		// Личные тачки, ручной спавн
		if(Cars[v] == 88)
		{
			if(VehInfo[v][vNospawn] == 0 && VehInfo[v][vSeat] == 0) // Можно спавнить и за рулём никого нет
			{
				if(VehInfo[v][vTimerSpawn] >= 0) VehInfo[v][vTimerSpawn] -= 1;
				else PP_SetVehicleToRespawn(v); // Спавним, если время вышло
			}
		}

		if(VehInfo[v][vEngine] == 1 // Двигатель заведён
			&& (VehInfo[v][vGas] >= 1 || VehInfo[v][vGelium] >= 1) // Есть топливо
			&& VehInfo[v][vTestDrive] == 0) // Транспорт не в тестдрайве автосервиса
		{
		    if(VehInfo[v][vGelium] >= 1)
			{
				VehInfo[v][vGeliumSet]++;
				if(VehInfo[v][vGeliumSet] >= 4) VehInfo[v][vGelium]--, VehInfo[v][vGeliumSet] = 0;
			}
			else VehInfo[v][vGas]--;
			if(VehInfo[v][vGas] == 0 && VehInfo[v][vGelium] == 0)
			{
				GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
			    SetVehicleParamsEx(v, false, lights, alarm, doors, bonnet, boot, objective);
				VehInfo[v][vEngine] = 0, opa = 1;
			}
			if(VehInfo[v][vSeat] > 0)
			{
				new dryaver = VehInfo[v][vSeat]-1;
				if(IsOnline(dryaver))
	    		{
	    		    CheckBenz(dryaver);
	    		    if(opa == 1) UpdateVehEngine(dryaver);
				}
			}
		}
		if(VehInfo[v][vRent] > 0 && VehInfo[v][vRent] > unix)
		{
		    new ost = VehInfo[v][vRent]-unix;
		    if(ost >= 300 && ost <= 329 && VehInfo[v][vSeat] > 0)
		    {
				if(IsOnline(VehInfo[v][vSeat]-1)) ShowDialog(VehInfo[v][vSeat]-1,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Аренда этого транспорта завершится через 5 минут!\n{ff9000}Рекомендуем продлить аренду [ Y >> Транспорт ]","*","");
			}
		}
		if(VehInfo[v][vRent] > 0 && unix > VehInfo[v][vRent])
		{
			if(VehInfo[v][vSeat] > 0)
			{
				if(IsOnline(VehInfo[v][vSeat]-1)) ShowDialog(VehInfo[v][vSeat]-1,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Срок аренды транспорта завершился! Транспорт отправлен на стоянку","*","");
			}
			ACDestroyVehicle(v);
		}
	}
	
	if(ViborInfo[vfunk2] < unix && ViborInfo[vstat] != 0) SelectVoteAfterRally();

	NarcoFarmTick();

	new moonpeople = 0, g;
	foreach (Player, i)
	{
		if(OnlineInfo[i][oLogged] == 1)
		{
			// Создаём маньяка для игрока
			if(IsPlayerSyncModels(i)
				&& !IsPlayerAfk(i)
				&& PlayerInfo[i][pLevel] >= 3
				&& (tmphour >= 22 || tmphour <= 4 || server == 0)
				&& GetPlayerState(i) == PLAYER_STATE_ONFOOT
				&& !(IsAGhetto(i) && CaptInfo[cCaptStat] == true) // Если мы в гетто и сейчас есть активный капт (маньяк не создаётся)
				&& Kapt[fraction(i)] == 0) // Если у нашей организации нет капта
				{
					ProcessCreateManiac(i);
				}

			// Процесс срабатывания ловушки для акулы
			if(Trap[i] == 1) ProcessSharpTrap(i, unix);

			// Сохраняем настройки чатов
    		if(PlayerInfo[i][pTransmitterUpdate] == true) SaveTransmitterOff(i);

		    if(AeroStat[i] == 0) updatedrawtime(i, tmphour, tmpminute);
		
		  	g = fraction(i);
		  	if(GetPVarInt(i,"afksystem") <= 2 && OverHear[i] == 0 && GetPlayerState(i) != PLAYER_STATE_SPECTATING
				&& ADUTY[i] == 0
				&& Kapt[g] == 0 // Капт банды
				&& Strel[g] == 0 // Стрела мафии
				&& Zahvat[g] == 0 // Порт мафии
				&& MPGO[i] == 0 // Мероприятие админов
				&& !DeathInfo[i][deathStatus] // Игрок мертвый на земле
				&& MenuInfo[i][zStat] == 0)
			{
				// Лучевая Болезнь в Космосе
				if(PlayerInfo[i][pBkyrenie] >= 2 &&
					(GetPlayerVirtualWorld(i) == 221 && GetPlayerInterior(i) == 221 || GetPlayerVirtualWorld(i) == 222 && GetPlayerInterior(i) == 222)) infect(i, 4, 5);

				// Усталость
				if(PlayerInfo[i][pMechSkill] > 0)
				{
					if(getillness(i, 18) >= 0)
					{
						if(PlayerInfo[i][pNeon] < 100) PlayerInfo[i][pMechSkill] --;
					}
					else PlayerInfo[i][pMechSkill] --;
				}

				// Желание пожрать
				if(PlayerInfo[i][pNeon] <= 100 && PlayerInfo[i][pNeon] > 20) InfoEatMessage(i, 0);
				else if(PlayerInfo[i][pNeon] <= 20)
				{
					if(HealthAC[i] > 1.0) ACSetPlayerHealth(i, HealthAC[i]-1.0);

					InfoEatMessage(i, 1);
					
					// Копим болезни
					if(getillness(i, 12) >= 0) infect(i, 13, 1);
					else infect(i, 12, 2);
				}
				if(Dei[i] == 203) ShowWildAnimalsZone(i);
				// Кровотечение
				if(PlayerInfo[i][pRanentors] == 1)
				{
					if(HealthAC[i] > 10.0) ACSetPlayerHealth(i, HealthAC[i]-10.0);
					TextDrawShowForPlayer(i, PearsDraw[0]);
					Stopeee2[i] = 15;
					Stopee[i] = 1;
				}
				
				// Болезни (хп в минус)
				if(getillness(i, 3) >= 0 || getillness(i, 4) >= 0 || getillness(i, 5) >= 0 || getillness(i, 6) >= 0 || getillness(i, 7) >= 0 || getillness(i, 8) >= 0 || getillness(i, 9) >= 0 || getillness(i, 12) >= 0 || getillness(i, 13) >= 0 || getillness(i, 14) >= 0 || getillness(i, 15) >= 0 || getillness(i, 16) >= 0 || getillness(i, 17) >= 0)
				{
					if(getillness(i, 3) >= 0 || getillness(i, 5) >= 0 || getillness(i, 6) >= 0 || getillness(i, 7) >= 0 || getillness(i, 8) >= 0 || getillness(i, 9) >= 0 || getillness(i, 12) >= 0 || getillness(i, 14) >= 0 || getillness(i, 15) >= 0 || getillness(i, 16) >= 0 || getillness(i, 17) >= 0)
					{
						if(HealthAC[i] > 2.0) ACSetPlayerHealth(i, HealthAC[i]-2.0);
					}
					else if(getillness(i, 4) >= 0 || getillness(i, 13) >= 0)
					{
						if(HealthAC[i] > 4.0) ACSetPlayerHealth(i, HealthAC[i]-4.0);
					}
					if(HealthAC[i] > 10.0 && HealthAC[i] < GetMaxPlayerHealth(i) && fmod(HealthAC[i], 10) == 0)
					{
						SetPlayerChatBubble(i,"корчит лицо от боли",COLOR_RED,20.0,5000);
						if(PlayerInfo[i][pDrawLanguage] == false && Device[i] != 1) SendMindMessage(i, RusToGame("Что-то мне плохо"),RusToGame("[Персонаж болен]"));
						else SendMindMessage(i, "I feel bad","[Character is sick]");
					}
				}
	        }
	        if(PlayerInfo[i][pBkyrenie] == 2) moonpeople ++;
			if(SektaCNN[0] > -1 && SektaCNN[1] > -1)
			{
				if(Sekta[SektaCNN[0]][sektaTimer] > 0) SektaCNNUpdate(i);
			}
        }
	}

	if(SektaCNN[0] > -1 && SektaCNN[1] > -1)
	{
		if(Sekta[SektaCNN[0]][sektaTimer] <= 0) SektaCNNClose();
	}
	if(moonpeople > 0) create_meteorite();

	GlobalTickTimer2 = GetTickCount() - tickTimer;
	return 1;
}
stock Uninvite(playerid,stat)
{
	if(stat == 0) // Online
	{
		new g = PlayerInfo[playerid][pMember];

		Onli[PlayerInfo[playerid][pMember]] --;
		if(gRedakt[playerid] == REDAKT_TYPE_GANG_SPAWN_SET || gRedakt[playerid] == REDAKT_TYPE_GANG_SPAWN_MOVE || ObjLabStat[playerid] > 0) stop_map(playerid);
		if(PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8)
		{
			if(NameTag[playerid] == true) pc_cmd_nametag(playerid);
			if(gSign[playerid] == true) SetPlayerName(playerid, PlayerInfo[playerid][pName]), gSign[playerid] = false;
		}
		Protect_Remove(playerid, 34);
		if(TempWeapon[playerid][6] == 34 && TempAmmo[playerid][6] >= 1) TempWeaponClear(playerid, 6);
	 	if(PlayerInfo[playerid][pModel2] > 0)
	 	{
	 		GiveThingPlayer(playerid, PlayerInfo[playerid][pModel], 1, PlayerInfo[playerid][pModel2], PlayerInfo[playerid][pModel3], 3, 0, 9999);
	 		TakeOffClothes(playerid);
 			PlayerInfo[playerid][pModel2] = 0;
 			PlayerInfo[playerid][pModel3] = 0;
 			keep(playerid);
	 	}
		PlayerInfo[playerid][pMember] = 0;
		PlayerInfo[playerid][pRank] = 0;
		PlayerInfo[playerid][pVig] = 0;
		resetPlayerTransmitter(playerid); // Сбрасываем чтение раций
		SetPlayerColor(playerid,INV_COLOR);
		DelUpdate(playerid); // Отключаем его чекер ганг зон
		mysql_save(playerid, 9);
		Dismiss[playerid] = 0;
		Payment[playerid] = 0;
		PayCash[playerid] = 0;
  		for(new gp2 = 0; gp2 < MAX_GANG_CAPT_STATA; gp2++) PlayerInfo[playerid][pGangTemp][gp2] = 0;

		if(PlayerInfo[playerid][pHidden] == 0) UninvitePlayerBridge(PlayerInfo[playerid][pID], g);

		// Очищаем патруль
		if(PlayerInfo[playerid][patroolID] >= 0) ClosePatrool(playerid, -1);

		// Очищаем подфракцию
		uninviteDivision(playerid, g);

		// Очищаем созданные радары
		Radar_DeleteAllByOwner(PlayerInfo[playerid][pID]);
	}
	return 1;
}
stock AnimSet1(playerid)
{
	new teta,tetb,tetc,tetd,tete,tetf;
	teta = AnimInfo[0][playerid];
	tetb = AnimInfo[1][playerid];
	tetc = AnimInfo[2][playerid];
	tetd = AnimInfo[3][playerid];
	tete = AnimInfo[4][playerid];
	tetf = AnimInfo[5][playerid];
	new str[100],sctring[3500];
	for(new ana = 1; ana < 101; ana++ )
    {
    	if(teta == ana || tetb == ana || tetc == ana || tetd == ana || tete == ana || tetf == ana)format(str,sizeof(str),"{99ff66}%s\n",animName[ana]); // Включена такая анимка
    	else format(str,sizeof(str),"{cccccc}%s\n",animName[ana]); // Нет такой анимки
     	strcat(sctring,str);
   	}
    ShowDialog(playerid,700,DIALOG_STYLE_LIST,"{0088ff}Анимации [ 1 - 99 ]",sctring,"Выбор","Отмена");
    return 1;
}
