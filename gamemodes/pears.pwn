		format(str,sizeof(str),"\n{cccccc}0.10%%\t50.000$	\t{99ff66}50$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}0.50%%\t50.000$	\t{99ff66}250$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}1.00%%\t50.000$	\t{99ff66}500$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}5.00%%\t50.000$	\t{99ff66}2.500$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}10.0%%\t50.000$	\t{99ff66}5.000$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}20.0%%\t50.000$	\t{99ff66}10.000$"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Вычисление налога: Зарплата {ff9000}умножить {cccccc}на Процент {ff9000}разделить {cccccc}на 100"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{444444}- Налог начисляется при любой полученной зарплате или доходе"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}- В случае неоплаченных налогов более {cccccc}50 часов: {FF6347}Уголовный Розыск + Изъятие"), strcat(sctring,str);
		ShowDialog(playerid,518,DIALOG_STYLE_INPUT,"{66ff66}Министерство Финансов",sctring,"Принять","Отмена");
	}
	if(stat == 3)
	{
		DP[0][playerid] = stat;
		new str[134],sctring[1764];
		format(str,sizeof(str),"{cccccc}Введите проценты [1.0 - 50.0] в качестве налога на {99ff66}Доход с Бизнеса"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Текущий Налог: %.3f %%", nalog[3]), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Примеры:"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}Налог\tЗарплата\tИтоговый Налог от суммы зарплаты"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}0.10%%\t50.000$	\t{99ff66}50$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}0.50%%\t50.000$	\t{99ff66}250$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}1.00%%\t50.000$	\t{99ff66}500$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}5.00%%\t50.000$	\t{99ff66}2.500$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}10.0%%\t50.000$	\t{99ff66}5.000$"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}20.0%%\t50.000$	\t{99ff66}10.000$"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Вычисление налога: Доход в бизнес {ff9000}умножить {cccccc}на Процент {ff9000}разделить {cccccc}на 100"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{444444}- Налог начисляется при каждом пополнение денег на счёт бизнеса"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}- Начисление происходит даже если игрок Offline"), strcat(sctring,str);
		format(str,sizeof(str),"\n{444444}- В случае неоплаченных налогов более 15 суток: {FF6347}Арест Бизнеса"), strcat(sctring,str);
		ShowDialog(playerid,518,DIALOG_STYLE_INPUT,"{66ff66}Министерство Финансов",sctring,"Принять","Отмена");
	}
	return 1;
}
stock setcen(playerid, stat)
{
	new thingId;
	new line[100],lines[600];
	if(stat == 0 || stat == 156) thingId = 156, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Водительских Прав"), strcat(lines,line);
	else if(stat == 1 || stat == 157) thingId = 157, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Лицензии Пилота"), strcat(lines,line);
	else if(stat == 2 || stat == 158) thingId = 158, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Лицензии Водного Транспорта"), strcat(lines,line);
	else if(stat == 3 || stat == 159) thingId = 159, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Лицензии Мототранспорта"), strcat(lines,line);
	else if(stat == 4 || stat == 161) thingId = 161, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Лицензии на Оружие [1]"), strcat(lines,line);
	else if(stat == 5 || stat == 162) thingId = 162, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Лицензии на Оружие [2]"), strcat(lines,line);
	else if(stat == 6 || stat == 160) thingId = 160, format(line,sizeof(line),"{cccccc}Введите стоимость получения {ff9000}Высшего Образования"), strcat(lines,line);
	else if(stat == 7) thingId = 7, format(line,sizeof(line),"{cccccc}Введите стоимость {ff9000}Изучения Языков"), strcat(lines,line);
	DP[0][playerid] = thingId;
	
	format(line,sizeof(line),"\n{FF6347}Стоимость не меньше 1000$ и не больше 1.000.0000$"), strcat(lines,line);
	if(stat == 7) format(line,sizeof(line),"\n{cccccc}Текущая стоимость: {99ff66}%d$ [%s]",Minfin[8], get_k(Minfin[8])), strcat(lines,line);
	else format(line,sizeof(line),"\n{cccccc}Текущая стоимость: {99ff66}%d$ [%s]",friskPrice[thingId], get_k(friskPrice[thingId])), strcat(lines,line);
	
	format(line,sizeof(line),"\n\n{444444}Гос. цены очень сильно влияют на экономику!"), strcat(lines,line);
	format(line,sizeof(line),"\n{444444}Прочитайте инструкцию и правила на форуме, прежде чем редактировать стоимость"), strcat(lines,line);
	ShowDialog(playerid,569,DIALOG_STYLE_INPUT,"{66ff66}Министерство Финансов: {cccccc}Цены",lines,"Принять","Отмена");
	return 1;
}

stock PercentOfNumber(const number, const percent)
{
	new Float:number_float = float(number);
	new Float:percent_float = float(percent);
	return floatround(percent_float * number_float / 100.0);
}

stock Procent(vid, lave)
{
	new Float:fill = lave * nalog[vid]/100; // Вычисляем Налог
	return floatround(fill, floatround_round);
}
stock taxes_realty()
{
	for(new d = 1; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dSost] >= 1)
		{
			DomInfo[d][dTaxes] += Procent(0, DomInfo[d][dSost2]);
			if(DomInfo[d][dElectroConnect] > 0) // Электростанции
			{
				DomInfo[d][dTaxes] += 12*BizzInfo[DomInfo[d][dElectroConnect]][bPrice][0];
				paybiz(DomInfo[d][dElectroConnect],12*BizzInfo[DomInfo[d][dElectroConnect]][bPrice][0]);
			}
			if(DomInfo[d][dTaxes] >= 1) DomInfo[d][dTaxday] ++;
			SaveTax_Dom(d);
		}
	}
	for(new r = 0; r < sizeof(ApartmentsRoom); r++)
 	{
 		if(ApartmentsRoom[r][aprStatus] >= 1)
		{
			ApartmentsRoom[r][aprTaxes] += Procent(0, Apartments[ApartmentsRoom[r][aprApartmentsID]][apPrice]);
			ApartmentsRoom[r][aprTaxday] ++;
			SaveApartmentsRoom(r);
		}
 	} // квартиры
	return 1;
}
stock paysalary(p, pay, o)
{
	new tax = Procent(2, pay);
	PlayerPlaySound(p,1052,0,0,0);
	new string[100];
	format(string,sizeof(string),"~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Haћo™: ~r~%d$~n~~w~Њpњ—Ёћ©: ~g~%d$", tax, pay);
	GameTextForPlayer(p,string,8000,3);
	if(PlayerInfo[p][pAutoTax]) pay = pay-tax;
	else PlayerInfo[p][pTaxes][1] += tax;

	if(o == 0) PlayerInfo[p][pMoney] += pay, ResetPlayerMoney(p),CompleteBattlePassTask(p, 0, 1, pay);
	else PlayerInfo[p][pAccount] += pay;
	mysql_save(p, 0);
	if(PlayerInfo[p][pAchieve][7] == 0) AchievePlayer(p, 7, 1);
	return 1;
}
stock paybiz(b, pay)
{
	// Вычисляем допрасходы
	new taxesMoney = 0;
	new mafia = 0;
	pay = ComputeWithTwoShares(pay,
		.first_out = taxesMoney,
		.second_out = mafia,
		.first_prop = PercentageToMultiplier(3), // Налоги
		.second_prop = PercentageToMultiplier(MAFIA_BABKI) // Доля мафии
	);

	BizzInfo[b][bIncome] += pay;
	if(BizzInfo[b][bLab] == 1) BizzInfo[b][bMafiaSchet] += mafia;
	else
	{
		if(BizzInfo[b][bMafia] > 0) bigint_add(OrganInfo[BizzInfo[b][bMafia]][glave], mafia), OrganInfo[BizzInfo[b][bMafia]][gUpdate] = 1;
	}

    if(BizzInfo[b][bSost] > 0)
	{
		if(BizzInfo[b][bArest] > 0) 
		{
			PutMoneyToTreasury(pay + taxesMoney, "Оплата товаров (бизнес арестован)"); // Биз арестован, сразу кладём деньги в казну
			BizzInfo[b][bTaxes] -= taxesMoney;
			if(BizzInfo[b][bTaxes] < 0) BizzInfo[b][bTaxes] = 0;
		}
		else
		{
			BizzInfo[b][bSchet] += pay;
			BizzInfo[b][bTaxes] += taxesMoney;
			BizzInfo[b][bBablo] += pay;
		}
		BizzInfo[b][bUpdate] = 1;
	}
    else PutMoneyToTreasury(pay + taxesMoney, "Оплата товаров (бизнес в гос.)"); // Бизнес никому не принадлежит, кладём деньги в казну
}
stock bizstat()
{
	for(new b = 1; b < sizeof(BizzInfo); b++)
	{
		BizzInfo[b][bHiscome][29] = BizzInfo[b][bHiscome][28];
		BizzInfo[b][bHiscome][28] = BizzInfo[b][bHiscome][27];
		BizzInfo[b][bHiscome][27] = BizzInfo[b][bHiscome][26];
		BizzInfo[b][bHiscome][26] = BizzInfo[b][bHiscome][25];
		BizzInfo[b][bHiscome][25] = BizzInfo[b][bHiscome][24];
		BizzInfo[b][bHiscome][24] = BizzInfo[b][bHiscome][23];
		BizzInfo[b][bHiscome][23] = BizzInfo[b][bHiscome][22];
		BizzInfo[b][bHiscome][22] = BizzInfo[b][bHiscome][21];
		BizzInfo[b][bHiscome][21] = BizzInfo[b][bHiscome][20];
		BizzInfo[b][bHiscome][20] = BizzInfo[b][bHiscome][19];
		BizzInfo[b][bHiscome][19] = BizzInfo[b][bHiscome][18];
		BizzInfo[b][bHiscome][18] = BizzInfo[b][bHiscome][17];
		BizzInfo[b][bHiscome][17] = BizzInfo[b][bHiscome][16];
		BizzInfo[b][bHiscome][16] = BizzInfo[b][bHiscome][15];
		BizzInfo[b][bHiscome][15] = BizzInfo[b][bHiscome][14];
		BizzInfo[b][bHiscome][14] = BizzInfo[b][bHiscome][13];
		BizzInfo[b][bHiscome][13] = BizzInfo[b][bHiscome][12];
		BizzInfo[b][bHiscome][12] = BizzInfo[b][bHiscome][11];
		BizzInfo[b][bHiscome][11] = BizzInfo[b][bHiscome][10];
		BizzInfo[b][bHiscome][10] = BizzInfo[b][bHiscome][9];
		BizzInfo[b][bHiscome][9] = BizzInfo[b][bHiscome][8];
		BizzInfo[b][bHiscome][8] = BizzInfo[b][bHiscome][7];
		BizzInfo[b][bHiscome][7] = BizzInfo[b][bHiscome][6];
		BizzInfo[b][bHiscome][6] = BizzInfo[b][bHiscome][5];
		BizzInfo[b][bHiscome][5] = BizzInfo[b][bHiscome][4];
		BizzInfo[b][bHiscome][4] = BizzInfo[b][bHiscome][3];
		BizzInfo[b][bHiscome][3] = BizzInfo[b][bHiscome][2];
		BizzInfo[b][bHiscome][2] = BizzInfo[b][bHiscome][1];
		BizzInfo[b][bHiscome][1] = BizzInfo[b][bHiscome][0];
		BizzInfo[b][bHiscome][0] = BizzInfo[b][bIncome];
		BizzInfo[b][bIncome] = 0;
		SaveBizzHistory(b);
	}
}
stock SaveBizzHistory(b)
{
	if(LIMITED_LOADING_SERVER >= 2) return 1;

	new string_mysql[1000];
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_bizz` SET `Income`='0',`Hiscome0`='%d',`Hiscome1`='%d',`Hiscome2`='%d',`Hiscome3`='%d',`Hiscome4`='%d',`Hiscome5`='%d',\
	`Hiscome6`='%d',`Hiscome7`='%d',`Hiscome8`='%d',`Hiscome9`='%d',`Hiscome10`='%d',`Hiscome11`='%d',`Hiscome12`='%d',`Hiscome13`='%d',`Hiscome14`='%d',`Hiscome15`='%d',",
	BizzInfo[b][bHiscome][0], BizzInfo[b][bHiscome][1], BizzInfo[b][bHiscome][2], BizzInfo[b][bHiscome][3], BizzInfo[b][bHiscome][4], BizzInfo[b][bHiscome][5], BizzInfo[b][bHiscome][6], BizzInfo[b][bHiscome][7],
	BizzInfo[b][bHiscome][8], BizzInfo[b][bHiscome][9], BizzInfo[b][bHiscome][10], BizzInfo[b][bHiscome][11], BizzInfo[b][bHiscome][12], 
	BizzInfo[b][bHiscome][13], BizzInfo[b][bHiscome][14], BizzInfo[b][bHiscome][15]); // 301 + 176
	mysql_format(pearsq, string_mysql, sizeof(string_mysql), "%s`Hiscome16`='%d',`Hiscome17`='%d',`Hiscome18`='%d',`Hiscome19`='%d',`Hiscome20`='%d',`Hiscome21`='%d',`Hiscome22`='%d',\
	`Hiscome23`='%d',`Hiscome24`='%d',`Hiscome25`='%d',`Hiscome26`='%d',`Hiscome27`='%d',`Hiscome28`='%d',`Hiscome29`='%d' WHERE `newid`='%d'", string_mysql,
	BizzInfo[b][bHiscome][16], BizzInfo[b][bHiscome][17], BizzInfo[b][bHiscome][18], BizzInfo[b][bHiscome][19], BizzInfo[b][bHiscome][20], BizzInfo[b][bHiscome][21], BizzInfo[b][bHiscome][22], BizzInfo[b][bHiscome][23],
	BizzInfo[b][bHiscome][24], BizzInfo[b][bHiscome][25], BizzInfo[b][bHiscome][26], BizzInfo[b][bHiscome][27], BizzInfo[b][bHiscome][28], 
	BizzInfo[b][bHiscome][29], b); // 263 + 165
	query_empty(pearsq, string_mysql); // 905
	return true;
}
stock IsACity(playerid)
{
	if(IsPlayerInDynamicArea(playerid, zones_city[0]) || IsPlayerInDynamicArea(playerid, zones_city[1]) || IsPlayerInDynamicArea(playerid, zones_city[2]) || IsPlayerInDynamicArea(playerid, zones_city[3])
	|| IsPlayerInDynamicArea(playerid, zones_city[4]) || IsPlayerInDynamicArea(playerid, zones_city[5]) || IsPlayerInDynamicArea(playerid, zones_city[6]) || IsPlayerInDynamicArea(playerid, zones_city[7])
	|| IsPlayerInDynamicArea(playerid, zones_city[8]) || IsPlayerInDynamicArea(playerid, zones_city[9]) || IsPlayerInDynamicArea(playerid, zones_city[10]) || IsPlayerInDynamicArea(playerid, zones_city[11])
	|| IsPlayerInDynamicArea(playerid, zones_city[12]) || IsPlayerInDynamicArea(playerid, zones_city[13]) || IsPlayerInDynamicArea(playerid, zones_city[14]) || IsPlayerInDynamicArea(playerid, zones_city[15])
	|| IsPlayerInDynamicArea(playerid, zones_city[16]) || IsPlayerInDynamicArea(playerid, zones_city[17])) return 1;
	return 0;
}
stock IsBigFish(playerid)
{
	if(IsPlayerInDynamicArea(playerid, zones[0]) || IsPlayerInDynamicArea(playerid, zones[1]) || IsPlayerInDynamicArea(playerid, zones[2]) || IsPlayerInDynamicArea(playerid, zones[3])) return 1;
	return 0;
}
stock IsMinFish(playerid)
{
	if(IsPlayerInDynamicArea(playerid, zones[4]) || IsPlayerInDynamicArea(playerid, zones[5]) || IsPlayerInDynamicArea(playerid, zones[6]) || IsPlayerInDynamicArea(playerid, zones[7])
	|| IsPlayerInDynamicArea(playerid, zones[8]) || IsPlayerInDynamicArea(playerid, zones[9]) || IsPlayerInDynamicArea(playerid, zones[10]) || IsPlayerInDynamicArea(playerid, zones[11])
	|| IsPlayerInDynamicArea(playerid, zones[12]) || IsPlayerInDynamicArea(playerid, zones[13]) || IsPlayerInDynamicArea(playerid, zones[14]) || IsPlayerInDynamicArea(playerid, zones[15])
	|| IsPlayerInDynamicArea(playerid, zones[16]) || IsPlayerInDynamicArea(playerid, zones[17]) || IsPlayerInDynamicArea(playerid, zones[18]) || IsPlayerInDynamicArea(playerid, zones[19])
	|| IsPlayerInDynamicArea(playerid, zones[20]) || IsPlayerInDynamicArea(playerid, zones[21]) || IsPlayerInDynamicArea(playerid, zones[22]) || IsPlayerInDynamicArea(playerid, zones[23])) return 1;
	return 0;
}
stock IsNonFish(playerid)
{
	new f = -1;
	for(new z = 0; z < 100; z++)
	{
		if(IsPlayerInDynamicArea(playerid, fish_zone[z])) f = z;
	}
	return f;
}
stock CreateNonFish(playerid)
{
	for(new z = 0; z < 100; z++)
	{
		if(fish_stat[z] == 0)
		{
			fish_stat[z] = 1, fish_quan[z] = 999;
			fish_zone[z] = CreateDynamicSphere(Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], 100.0, 0, 0);
		    break;
		}
	}
}
stock fish(playerid)
{
    if(PlayerInfo[playerid][pMechSkill] == 0) return ErrorMessage(playerid, "{FF6347}Ваш персонаж устал и хочет спать\n{ffcc66}Вы можете поспать в отеле или в своём доме");
	if(CheckInvent(playerid) && get_invent2(playerid, 20, 0) <= 0) return ErrorMessage(playerid, "{FF6347}В вашем инвентаре нет места"), ClearAnim(playerid);
	if(GetPVarInt(playerid,"antiflood") > 0) return GameTextForPlayer(playerid, RusToGame("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~Наживка не готова"), 3000, 3);
	if(get_invent(playerid, 18, 0) == 0) return ErrorMessage(playerid, "{FF6347}У вас нет наживки\n{ffcc66}Приобретите наживку в рыболовном магазине на причале"), ClearAnim(playerid);
	new myfish = get_invent(playerid, 20, 0), pow = get_power(playerid), unix = gettime();
	if(unix > get_para(playerid, 18)) return ErrorMessage(playerid, "{FF6347}Наживка испорчена\n{ffcc66}Когда вы складываете свежую наживку к испорченной - она портится вся!"), ClearAnim(playerid);

	new maxFishInventory = 20*pow;

	// Исправление рыбы в инвентаре
	new slot = get_invent2_Slot(playerid, 20, 0, false);
	if(slot >= 0)
	{
		if(myfish < 0 || myfish > maxFishInventory) PlayerInfo[playerid][pInvenQuan][slot] = 1; // Если вдруг рыба в минусовом значение или больше лимитов, ставим 1
	}

	new string[400];
	if(myfish >= maxFishInventory)
	{
		format(string,sizeof(string),"{FF6347}Вы не можете носить в инвентаре больше %d кг. рыбы\
									\n{ffcc66}Увеличивайте силу, чтобы повысить грузоподъёмность [ Y >> Меню >> Навыки ]\
									\n{ffcc66}Прокачать навык силы можно в спортзале [ Y >> GPS >> Услуги >> Спортзал ]\
									\n\n{ffcc00}Вы можете прокачать навык силы в меню Donate [ Y >> Donate ]", maxFishInventory);
		ErrorMessage(playerid, string);
		ClearAnim(playerid);
	}

	new findTypeFish, findHighFish, bool:bigOrMin;
	if(IsBigFish(playerid)) // Крупная Рыба
	{
		findTypeFish = random(20);
		findHighFish = 2 + random(9);
		bigOrMin = true;
	}
	else if(IsMinFish(playerid)) // Мелкую
	{
		findTypeFish = 1 + random(11);
		findHighFish = 1 + random(2);
		bigOrMin = false;
	}

	if(findTypeFish == 0) // Попалась Акула
	{
		if(GetPVarInt(playerid, "akula") == 0)
		{
			GameTextForPlayer(playerid, " ", 3000, 3);

			TakeInvent(playerid, 18, 1, 0, 999, false); // Вычитаем наживку
			PlayerPlaySound(playerid, 14408, 0,0,0);
			ApplyAnimation(playerid,"SWORD","sword_block",1.0, false, true, true, true, true);
    	    SetPVarInt(playerid, "akula", 1);
    	    new Float:obx, Float:oby, Float:obz, Float:oba;
    	    GetPlayerPos(playerid,obx, oby, obz);
    	    GetPlayerFacingAngle(playerid,oba);
    	    obx=obx+4.0*floatsin(-oba,degrees);
    	    oby=oby+4.0*floatcos(-oba,degrees);
    	    akula[playerid] = CreateDynamicObject(1608,obx, oby, obz-5.0,25.400001, 0.000000, 70.899986, 0, 0, -1, 300.00, 300.00);
    	    MoveDynamicObject(akula[playerid], obx, oby, obz+10.0, 3);
    	    AkulaTimer[playerid] = SetTimerEx("DelAkula", 1400, false, "d", playerid);
    	    SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: А-а-а! Акула!!!");
    	    ShowDialog(playerid, 1742, 0, "{FF9000}Рыбалка", "{cccccc}Вы закинули удочку и Акула Весом {FF6347}125 кг сломала её", "Ок", "");
    	    SetPlayerChatBubble(playerid,"пытается вытянуть акулу и ломает удочку",COLOR_PURPLE,20.0,7000);
			TakeInvent(playerid, 31, 1, 0, 999); // Отбираем удочку
    	    SetPVarInt(playerid,"antiflood",3);
    	    ClearAnim(playerid);
		}
		return 1;
	}
	else if(findTypeFish >= 1 && findTypeFish <= 4) // Попался Мусор
	{
		GameTextForPlayer(playerid, " ", 3000, 3);

		ApplyAnimation(playerid,"SWORD","sword_block",1.0, false, true, true, true, true);
		TakeInvent(playerid, 18, 1, 0, 999, false); // Вычитаем наживку
		PlayerPlaySound(playerid, 5602, 0,0,0);

		static const trashNames[][] = {"Старый Ботинок", "Металлическую Банку", "Водоросли", "Тряпку", "Целлофановый Пакет"};
		format(string, sizeof(string), "{cccccc}Вы закинули удочку и поймали {444444}%s", trashNames[findTypeFish - 1]);
		ShowDialog(playerid, 1742, 0, "{FF9000}Рыбалка", string, "Ок", "");

		SetPVarInt(playerid,"antiflood",3);
		return 1;
	}
	else
	{
		// Навык влияет на вес рыбы (только если ловим большую рыбу)
		if(bigOrMin == true)
		{
			new gf = get_ability(playerid, 0);
			if (random(3) == 0) {
				if(gf >= 2) findHighFish += gf/2;
			}
		}

		// Если итоговое количество рыбы не влезает мне в инвентарь, режем ровно под инвент
		findHighFish = min(maxFishInventory - myfish, findHighFish);

		if(findHighFish > 0)
		{
			new fz = IsNonFish(playerid);
			if(fz >= 0)
			{
				if(fish_quan[fz] <= 0) return ErrorMessage(playerid, "{FF6347}В этой зоне поймали всю рыбу\n{cccccc}Восстанавливается со временем"), PlayerPlaySound(playerid,4203,0,0,0), ClearAnim(playerid);
				fish_quan[fz] --;
			}
			else CreateNonFish(playerid);

			GameTextForPlayer(playerid, " ", 3000, 3);
			
			ApplyAnimation(playerid, "SWORD", "sword_block", 1.0, false, true, true, true, true);
			GiveThingPlayer(playerid, 20, findHighFish, gettime() + 432000, 0, 0, 0, 9999);
			TakeInvent(playerid, 18, 1, 0, 999, false);
			PlayerPlaySound(playerid, 1084, 0,0,0);

			static const fishNames[][] = {"Леща", "Язя", "Лосося", "Сёмгу", "Тунца"};
			format(string, sizeof(string), "{cccccc}Вы закинули удочку и поймали %s весом {FF9000}%d кг.", fishNames[random(sizeof(fishNames))], findHighFish);

			ShowDialog(playerid, 1742, 0, "{FF9000}Рыбалка", string, "Ок", "");
			SetPVarInt(playerid, "antiflood", 3);
			update_ability(playerid, 0, 1);
			if(PlayerInfo[playerid][pAchieve][24] == 0 && findHighFish >= 15) AchievePlayer(playerid, 24, 1);

			// Ловить рыбу
			CompletingDaily(playerid, 1, findHighFish);
		}
	}
	return 1;
}
stock TakeSeaStar(playerid)
{
	new s = IsSeaStar(playerid);
	if(s >= 0)
	{
	    if(SeaStarStat[s] == 1)
	    {
	    	if(CheckInvent(playerid) && get_invent(playerid, 46, 0) <= 0) return ErrorMessage(playerid, "{FF6347}В вашем инвентаре нет места");
	    	
	    	new getQuan, getLimit;
		    i_limit(playerid, 46, getQuan, getLimit);
		    if(getQuan+1 > getLimit)
			{
				new string[160];
				format(string,sizeof(string),"{FF6347}У вас нет места в инвентаре\nЛимит для этого предмета: %d\n\n{cccccc}Предметы учитываются из раздела торговли и упаковок с подарками и рюкзаков", getLimit);
				ErrorMessage(playerid, string);
				return 1;
			}
	    	
			update_ability(playerid, 0, 10);
			GiveThingPlayer(playerid, 46, 1, 0, 0, 0, 0, 9999);
	  	    PlayerPlaySound(playerid,6401,0,0,0);
	  	    DestroyDynamicObject(SeaStarObject[s]);
			DestroyDynamic3DTextLabel(SeaStar[s]);
			SeaStarStat[s] = 2, SeaStarTime[s] = 180;
			if(PlayerInfo[playerid][pAchieve][103] == 0) AchievePlayer(playerid, 103, 1);

			// Собрать морские звёзды
			CompletingDaily(playerid, 3, 1);
		}
	}
	return 1;
}
stock IsSeaStar(p)
{
	new hers = -1;
	if(GetPlayerInterior(p) == 0 && GetPlayerVirtualWorld(p) == 0 && GetPlayerState(p) == PLAYER_STATE_ONFOOT)
	{
		for(new i = 0; i < 21; i++)
		{
		    if(SeaStarStat[i] == 1)
		    {
				new Float:pos[3];
				GetDynamicObjectPos(SeaStarObject[i], pos[0], pos[1], pos[2]);
				if(IsPlayerInRangeOfPoint(p,2.0,pos[0], pos[1], pos[2]))
				{
				    hers = i;
				    break;
				}
			}
		}
	}
	return hers;
}
