}
stock update_quan_cards_desk(desk, quan) // Количество карт на столе
{
    new string[5];
	if(quan >= 0)
	{
    	format(string,sizeof(string),"%d",quan);
    	SetDynamicObjectMaterialText(CardDesk[desk], 0, string, 140, "Segoe Keycaps", 90, 1, 0xFF333333, 0x00000000, 2);
 	}
	else SetDynamicObjectMaterialText(CardDesk[desk], 0, " ", 140, "Segoe Keycaps", 90, 1, 0xFF333333, 0x00000000, 2);
	if((DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) && DeskInfo[desk][Status] >= 2)
	{
		for(new p = 0; p < MAX_PLAYER_DESK; p++)
		{
	    	if(DeskInfo[desk][Playerstatus][p] > 0)
			{
				new memberid = DeskInfo[desk][Playerid][p];
			    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
				{
				    format(string,sizeof(string),"%d",DeskInfo[desk][Quancard]);
					PlayerTextDrawSetString(memberid, DeskPlayerMenuDraw[12][memberid], string);
	    			PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[12][memberid]);
	    			if(quan > 0) reset_textdraw_trumpcard(memberid, DeskInfo[desk][TrumpCard]), PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[9][memberid]);
	    			else PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[9][memberid]);
				}
			}
		}
	}
	return 1;
}
stock shuffle_cards(desk) // Перемешиваем карты
{
	if(DeskInfo[desk][Deck] == 52) DeskInfo[desk][Mindistri] = 0;
	else if(DeskInfo[desk][Deck] == 36) DeskInfo[desk][Mindistri] = 16;
	DeskInfo[desk][Maxdistri] = 52;
	DeskInfo[desk][Quancard] = DeskInfo[desk][Deck];
	DeskInfo[desk][Givecard] = 0;
 	update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
  	for(new dc = 0; dc < 52; dc++) DeskInfo[desk][Card][dc] = 0, DeskInfo[desk][Distributioncard][dc] = dc+1;
	for(new c = 0; c < DeskInfo[desk][Deck]; c++) DeskInfo[desk][Card][c] = get_shuffle(desk);
	return 1;
}
stock get_shuffle(desk) // Цикл перемешивания
{
	new value = randomEx(DeskInfo[desk][Mindistri],DeskInfo[desk][Maxdistri]);
	new cardvalue = DeskInfo[desk][Distributioncard][value];
	for(new dc = value; dc > DeskInfo[desk][Mindistri]; dc--) DeskInfo[desk][Distributioncard][dc] = DeskInfo[desk][Distributioncard][dc-1];
	DeskInfo[desk][Distributioncard][DeskInfo[desk][Mindistri]] = 0;
	DeskInfo[desk][Mindistri] ++;
	return cardvalue;
}
stock reset_textdraw_trumpcard(playerid, trump) // Показываем козырь на столе
{
	new string[24];
    format(string,sizeof(string),"%s",cardtextDraw[trump]);
	PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[9][playerid], string);
	return 1;
}
stock update_allhud_card(desk)
{
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
    	if(DeskInfo[desk][Playerstatus][p] > 0)
		{
			new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1) show_hud_deskcard(memberid, p, desk);
		}
	}
	return 1;
}
stock show_hud_deskcard(memberid, place, desk)
{
	new string[4];
    PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[8][memberid]);
    reset_textdraw_trumpcard(memberid, DeskInfo[desk][TrumpCard]);
    PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[9][memberid]);
    PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[10][memberid]);
    PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[11][memberid]);
    format(string,sizeof(string),"%d",DeskInfo[desk][Quancard]);
	PlayerTextDrawSetString(memberid, DeskPlayerMenuDraw[12][memberid], string);
    PlayerTextDrawShow(memberid, DeskPlayerMenuDraw[12][memberid]);

    textdraw_desk_card_walk(desk, place, 0);
    textdraw_desk_card_walk(desk, place, 1);
    textdraw_desk_card_walk(desk, place, 2);
    textdraw_desk_card_walk(desk, place, 3);
    textdraw_desk_card_walk(desk, place, 4);
    textdraw_desk_card_walk(desk, place, 5);
    textdraw_desk_card_underwalk(desk, place, 0);
    textdraw_desk_card_underwalk(desk, place, 1);
    textdraw_desk_card_underwalk(desk, place, 2);
    textdraw_desk_card_underwalk(desk, place, 3);
    textdraw_desk_card_underwalk(desk, place, 4);
    textdraw_desk_card_underwalk(desk, place, 5);
	return 1;
}
stock find_min_trump_player(desk, p, &card, &cardid)
{
    card = 999;
	new findtrump;
    for(new dc = 0; dc < 52; dc++)
    {
        if(CardPlayer[dc][desk][p] > 0)
        {
	        if(DeskInfo[desk][Trump] == cardSuit[CardPlayer[dc][desk][p]]) // Козырные карта
	        {
	            if(card <= (findtrump = CardPlayer[dc][desk][p])) continue;
                card = findtrump;
                cardid = dc;
	        }
		}
    }
	return 1;
}
stock whose_turn(desk) // Ищем кто ходит первый
{
	if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
	{
		new card[MAX_PLAYER_DESK], cardid[MAX_PLAYER_DESK], yestrump, findtrump, place;
		for(new p = 0; p < MAX_PLAYER_DESK; p++) // 1. находим самый маленький козырь у каждого игрока на руках
	 	{
	    	if(DeskInfo[desk][Playerstatus][p] == 3 && QuanCardPlayer[desk][p] > 0) find_min_trump_player(desk, p, card[p], cardid[p]), yestrump = 53;
		}
		for(new p = 0; p < MAX_PLAYER_DESK; p++) // 2. ищем среди всех игроков наименьший козырь
	 	{
	 	    if(card[p] > 0)
	 	    {
		        if(yestrump <= (findtrump = card[p])) continue;
		        yestrump = findtrump;
		        place = p;
       		}
		}
		if(yestrump > 0 && yestrump <= 52) DeskInfo[desk][Dctrump] = cardid[place], DeskInfo[desk][Dcplayer] = place+1, go_walk(desk, place, cardid[place], 0); // 3. ходит тот, у кого меньшая карта
		else // 4. меньшей карты нет, Ходит следующий от лидера
		{
		    new lidplace = DeskInfo[desk][Leaderidstatus]-1, place_walk;
		    place_walk = get_member_next(desk, lidplace);
		    go_walk(desk, place_walk, 0, 0);
		}
	}
	else if(DeskInfo[desk][Game] == 3) // 4. в покере ходит всегда следующий от лидера
	{
	    new lidplace = DeskInfo[desk][Leaderidstatus]-1, place_walk;
	    place_walk = get_member_next(desk, lidplace);
	    go_walk(desk, place_walk, 0, 0);
	}
	return 1;
}
stock get_member_next(desk, lidplace)
{
	new etoplace;
    new nextid0 = get_next_place(lidplace);
	if(is_member_game(desk, nextid0, 3)) etoplace = nextid0;
	else
	{
	    new nextid1 = get_next_place(nextid0);
	    if(is_member_game(desk, nextid1, 3)) etoplace = nextid1;
	    else
		{
		    new nextid2 = get_next_place(nextid1);
	    	if(is_member_game(desk, nextid2, 3)) etoplace = nextid2;
	    	else
			{
			    new nextid3 = get_next_place(nextid2);
		    	if(is_member_game(desk, nextid3, 3)) etoplace = nextid3;
		    	else
				{
				    new nextid4 = get_next_place(nextid3);
			    	if(is_member_game(desk, nextid4, 3)) etoplace = nextid4;
			    	else
					{
					    new nextid5 = get_next_place(nextid4);
				    	if(is_member_game(desk, nextid5, 3)) etoplace = nextid5;
				    	else etoplace = lidplace;
			 		}
		 		}
	 		}
 		}
	}
	return etoplace;
}
stock get_next_place(place) // Порядок мест
{
	if(place == 0) place = 1;
	else if(place == 1) place = 2;
	else if(place == 2) place = 3;
	else if(place == 3) place = 4;
	else if(place == 4) place = 5;
	else if(place == 5) place = 0;
	return place;
}
stock is_member_game(desk, place, status) // Проверка на онлайн
{
    if(DeskInfo[desk][Playerstatus][place] == status && QuanCardPlayer[desk][place] > 0)
	{
		new memberid = DeskInfo[desk][Playerid][place];
		if(IsOnline(memberid) && DeskStatus[memberid] == 1) return 1;
	}
	return 0;
}
stock desk_card_poke(desk, desk_cardid)
{
    DeskInfo[desk][DeskCard][desk_cardid] = DeskInfo[desk][Card][DeskInfo[desk][Givecard]], DeskInfo[desk][Givecard] ++;
    DeskInfo[desk][Quancard] --;
    DeskInfo[desk][QuanDeskCard] ++;
    update_desk_card_walk(desk, desk_cardid);
    return 1;
}
stock go_walk(desk, targetplace, dc, hod) // Активируем ход игрока
{
	new predwalk;
    if(DeskInfo[desk][Walk] > 0) predwalk = DeskInfo[desk][Walk], SetDynamicObjectMaterial(MarkPlayerDesk[desk][DeskInfo[desk][Walk]-1], 0, 14581, "ab_mafiasuitea", "cof_wood2", 0x00000000);
    DeskInfo[desk][WalkTimer] = DeskInfo[desk][Shotclock];
    DeskInfo[desk][Walk] = targetplace+1;
    DeskInfo[desk][Push] = 0;
    if(DeskInfo[desk][Playerstatus][targetplace] == 3)
    {
        SetDynamicObjectMaterial(MarkPlayerDesk[desk][targetplace], 0, 18646, "matcolours", "orange", 0x00000000);
        SelectCard[desk][targetplace] = 0;
        new walkid = DeskInfo[desk][Playerid][targetplace];
    	if(IsOnline(walkid) && DeskStatus[walkid] == 1)
		{
			PlayerPlaySound(walkid,1084,0,0,0);
			if(DeskInfo[desk][Walking] == 0)
			{
				if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
				{
				    ShowDialog(walkid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{99ff66}Ваш ход!\n{cccccc}Нажмите на любую карту в ваших руках, чтобы сделать ход","*","");
				}
				else if(DeskInfo[desk][Game] == 3)
				{
				    ShowDialog(walkid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{99ff66}Ваш ход!\n{cccccc}Оцените свои карты и примите решение","*","");
				}
			}
			GameTextForPlayer(walkid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~‹AЋ XOѓ",4000,3);
		}
    }
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
	    if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
	    	if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
			    if(OnlineInfo[memberid][oShowInterface] == 11)
				{
				    if(predwalk > 0 && DeskInfo[desk][Playerstatus][predwalk-1] > 0)
					{
						//PlayerTextDrawFont(memberid, HudPlaceDraw[0][memberid][predwalk-1], TEXT_DRAW_FONT:5);
						//PlayerTextDrawColour(memberid, HudPlaceDraw[0][memberid][predwalk-1], -1);
						//PlayerTextDrawBackgroundColour(memberid, HudPlaceDraw[0][memberid][predwalk-1], 1488315452);
						//PlayerTextDrawShow(memberid, HudPlaceDraw[0][memberid][predwalk-1]);
						PlayerTextDrawHide(memberid, HudPlaceDraw[14][memberid][predwalk-1]);
					}
					//PlayerTextDrawFont(memberid, HudPlaceDraw[0][memberid][targetplace], TEXT_DRAW_FONT:4);
					//PlayerTextDrawColour(memberid, HudPlaceDraw[0][memberid][targetplace], PlayerInfo[memberid][pStyle1]);
                    //PlayerTextDrawBackgroundColour(memberid, HudPlaceDraw[0][memberid][targetplace], -1);
					//PlayerTextDrawShow(memberid, HudPlaceDraw[0][memberid][targetplace]); // Фон
					upd_walk_timer(desk, memberid, targetplace);
        			if(dc > 0 && DeskInfo[desk][Walking] == 0 && DeskInfo[desk][Game] != 3) show_trump_card(desk, memberid, targetplace, dc);
  				}
 			}
 		}
	}
	if(hod == 0 && (DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)) new_underwalk(desk, targetplace); // Под кого ходим
	return 1;
}
stock upd_walk_timer(desk, playerid, targetplace)
{
	if(DeskInfo[desk][Shotclock] > 0)
	{
		new Float:koef = 63.362632/DeskInfo[desk][Shotclock];
		new Float:itog = koef*DeskInfo[desk][WalkTimer];
	    PlayerTextDrawTextSize(playerid, HudPlaceDraw[14][playerid][targetplace], itog, 7.0);
    	PlayerTextDrawShow(playerid, HudPlaceDraw[14][playerid][targetplace]);
	}
	else PlayerTextDrawHide(playerid, HudPlaceDraw[14][playerid][targetplace]);
    return 1;
}
stock new_underwalk(desk, targetplace)
{
	new beforewalk = DeskInfo[desk][Underwalk];
    DeskInfo[desk][Goes] = targetplace+1;
    DeskInfo[desk][Underwalk] = get_member_next(desk, targetplace)+1;
    arrow_desk_pos(desk, DeskInfo[desk][Underwalk]-1, 1);
    if(DeskInfo[desk][Underwalk] > 0) // Новому обновляем пульт
	{
    	new memberid = DeskInfo[desk][Playerid][DeskInfo[desk][Underwalk]-1];
    	if(IsOnline(memberid)) show_draw_player_menu(memberid, desk);
	}
	if(beforewalk > 0) // Старому обновляем пульт
	{
	    new memberid = DeskInfo[desk][Playerid][beforewalk-1];
		show_draw_player_menu(memberid, desk);
	}
	return DeskInfo[desk][Underwalk];
}
stock show_trump_card(desk, memberid, targetplace, dc) // Показываем козырную карту
{
    new string[24];
    format(string,sizeof(string),"%s",cardtextDraw[CardPlayer[dc][desk][targetplace]]);
	PlayerTextDrawSetString(memberid, HudPlaceDraw[12][memberid][targetplace], string);
	PlayerTextDrawShow(memberid, HudPlaceDraw[12][memberid][targetplace]);
	return 1;
}
stock hide_trumpcard_all(desk, targetplace)
{
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
	    if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
			if(IsOnline(memberid) && DeskStatus[memberid] == 1) PlayerTextDrawHide(memberid, HudPlaceDraw[12][memberid][targetplace]);
		}
	}
	return 1;
}
stock go_game_card(desk, action) // Начинаем игру
{
    ServerInfo[64] ++;
	SaveServer(64);
    for(new gdc = 0; gdc < 6; gdc++)
	{
		DeskInfo[desk][DeskCard][gdc] = 0, DeskInfo[desk][DeskCardCover][gdc] = 0, DeskInfo[desk][CardWalk][gdc] = 0, DeskInfo[desk][CardUnderwalk][gdc] = 0;
		DeskInfo[desk][Combo][gdc] = 0, DeskInfo[desk][ComboTwicker][gdc] = 0, DeskInfo[desk][ComboKicker][gdc] = 0;
	}
    DeskInfo[desk][QuanDeskCard] = 0, DeskInfo[desk][Goes] = 0, DeskInfo[desk][Dctrump] = 0, DeskInfo[desk][Dcplayer] = 0;
    DeskInfo[desk][Walking] = 0, DeskInfo[desk][Walk] = 0, DeskInfo[desk][Underwalk] = 0, DeskInfo[desk][Nowhod] = 0, DeskInfo[desk][Lastor] = 0;
    DeskInfo[desk][Outwin] = 0, DeskInfo[desk][Nakidali] = 0, DeskInfo[desk][Push] = 0, DeskInfo[desk][Hodwalk] = 0;
    DeskInfo[desk][Kon] = 0, DeskInfo[desk][Raise] = 0;
    for(new dc = 0; dc < 9; dc++) DeskInfo[desk][DesComb][dc] = 0;
    
    new quancard, yesgame = 0;
    if(action == 1 || action == 2) quancard = 6;
    else if(action == 3) quancard = 2;
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
	{
	    new memberid = DeskInfo[desk][Playerid][p];
	    DeskInfo[desk][Playerwin][p] = 0, DeskInfo[desk][Playerwalk][p] = 0, DeskInfo[desk][Playerbet][p] = 0;
	    if(DeskInfo[desk][Playerstatus][p] > 0 && DeskInfo[desk][Playermessage][p] > 0) DeskInfo[desk][Playermessage][p] = 0, hide_hud_message_members(memberid, desk, p);
    	if(DeskInfo[desk][Playerstatus][p] >= 2)
		{
		    yesgame = 1;
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
				new string[100];
			    if(DeskInfo[desk][Typebid] == 0 && PlayerInfo[memberid][pAmmos1] < DeskInfo[desk][Bet]) format(string,sizeof(string),"{FF6347}Вам не хватает Фишек {cccccc}[Ставка стола: %d F]", DeskInfo[desk][Bet]), ErrorMessage(memberid, string), yesgame = 0;
      			if(DeskInfo[desk][Typebid] == 1 && PlayerInfo[memberid][pAmmos8] < DeskInfo[desk][Bet]) format(string,sizeof(string),"{FF6347}Вам не хватает Gold Фишек {cccccc}[Ставка стола: %d GF]", DeskInfo[desk][Bet]), ErrorMessage(memberid, string), yesgame = 0;
				if(OnlineInfo[memberid][oShowInterface] == 11)
				{
					PlayerTextDrawHide(memberid, HudPlaceDraw[5][memberid][p]), PlayerTextDrawHide(memberid, HudPlaceDraw[6][memberid][p]), PlayerTextDrawHide(memberid, HudPlaceDraw[7][memberid][p]);
				}
				if(yesgame == 0) DeskInfo[desk][Playerstatus][p] = 1, DeskInfo[desk][QuanGame] --;
				if(yesgame == 1 && DeskInfo[desk][QuanGame] >= 2)
				{
				    DeskInfo[desk][Playerstatus][p] = 3;
				    put_bank_desk(memberid, desk, p, DeskInfo[desk][Bet], 0);
					give_member_card(desk, p, quancard); // Выдаём карты
					if(OnlineInfo[memberid][oShowInterface] == 11) close_draw_player_menu(memberid), show_draw_player_menu(memberid, desk);
				}
			}
		}
	}
	DeskInfo[desk][QuanThisGame] = DeskInfo[desk][QuanGame];
	update_bank_desk(desk);
	// Включаем первый ход
	if(action == 1 || action == 2 && DeskInfo[desk][QuanGame] >= 2)
 	{
		DeskInfo[desk][Trump] = cardSuit[DeskInfo[desk][Card][DeskInfo[desk][Deck]-1]]; // Козырная масть
		DeskInfo[desk][TrumpCard] = DeskInfo[desk][Card][DeskInfo[desk][Deck]-1]; // Козырная карта
		update_allhud_card(desk);
	}
	return 1;
}
stock put_bank_desk(playerid, desk, place, bet, stat)
{
	new btext[3], string[24];
    if(DeskInfo[desk][Typebid] == 0) PlayerInfo[playerid][pAmmos1] -= bet, btext = "F";
    else if(DeskInfo[desk][Typebid] == 1) PlayerInfo[playerid][pAmmos8] -= bet, btext = "GF";
    update_object_chips(desk, place);
    
    // Логируем
	if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) format(string,sizeof(string),"[Ставка] Дурак | %s", btext);
	else
	{
		if(stat == 0) format(string,sizeof(string),"[Ставка] Покер | %s", btext);
		else if(stat == 1) format(string,sizeof(string),"[Ставка] Рейз | %s", btext);
		else if(stat == 2) format(string,sizeof(string),"[Ставка] Колл | %s", btext);
	}
	CasinoLog(ServerInfo[64], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], -bet, string);
    
    update_hud_money(playerid, desk, place);
    DeskInfo[desk][Playerbet][place] += bet;
    DeskInfo[desk][Bank] += bet;
	return 1;
}
stock update_bank_desk(desk)
{
	if(DeskInfo[desk][Bank] > 0)
	{
		new string[24];
	    if(DeskInfo[desk][Typebid] == 0) format(string,sizeof(string),"{99FF66}%d$",DeskInfo[desk][Bank]);
	    else if(DeskInfo[desk][Typebid] == 1) format(string,sizeof(string),"{FFCC00}%dG",DeskInfo[desk][Bank]);
	    SetDynamicObjectMaterialText(BankDesk[desk], 0, string, 140, "Arial", 55, 1, 0xFFFFFFFF, 0x00000000, 1);
  	}
  	else SetDynamicObjectMaterialText(BankDesk[desk], 0, " ", 140, "Arial", 55, 1, 0xFFFFFFFF, 0x00000000, 1);
  	update_bank_chips(desk);
  	streamer_update_object_member(desk);
	return 1;
}
stock update_hud_money(playerid, desk, place)
{
	new string[24];
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid))
			{
			    if(OnlineInfo[memberid][oShowInterface] == 11 && DeskStatus[memberid] == 1)
			    {
			    	if(PlayerInfo[playerid][pAmmos1] >= 1000) format(string,sizeof(string),"%d [%s]",PlayerInfo[playerid][pAmmos1],get_k(PlayerInfo[playerid][pAmmos1]));
			    	else format(string,sizeof(string),"%d",PlayerInfo[playerid][pAmmos1]);
					PlayerTextDrawSetString(memberid, HudPlaceDraw[3][memberid][place], string), PlayerTextDrawShow(memberid, HudPlaceDraw[3][memberid][place]); // Фишки
					if(PlayerInfo[playerid][pAmmos8] >= 1000) format(string,sizeof(string),"%d [%s]",PlayerInfo[playerid][pAmmos8],get_k(PlayerInfo[playerid][pAmmos8]));
					else format(string,sizeof(string),"Gold_F:_%d",PlayerInfo[playerid][pAmmos8]);
					PlayerTextDrawSetString(memberid, HudPlaceDraw[4][memberid][place], string), PlayerTextDrawShow(memberid, HudPlaceDraw[4][memberid][place]); // Gold Фишки
				}
			}
		}
  	}
	return 1;
}
stock give_takedesk_card(desk, place)
{
    SelectCard[desk][place] = 0;
    for(new tdc = 0; tdc < 6; tdc++)
	{
	    if(DeskInfo[desk][DeskCard][tdc] > 0)
	 	{
	        for(new pdc = 0; pdc < 52; pdc++)
	        {
	        	if(CardPlayer[pdc][desk][place] == 0)
				{
					CardPlayer[pdc][desk][place] = DeskInfo[desk][DeskCard][tdc], QuanCardPlayer[desk][place] ++;
					break;
				}
			}
	    }
	    if(DeskInfo[desk][DeskCardCover][tdc] > 0)
	 	{
	        for(new pdc = 0; pdc < 52; pdc++)
	        {
	        	if(CardPlayer[pdc][desk][place] == 0)
				{
					CardPlayer[pdc][desk][place] = DeskInfo[desk][DeskCardCover][tdc], QuanCardPlayer[desk][place] ++;
					break;
				}
			}
	    }
	}
	update_textdraw_card_player(desk, place);
	update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
	if(DeskInfo[desk][Playerstatus][place] > 0)
	{
	    new memberid = DeskInfo[desk][Playerid][place];
	    if(IsOnline(memberid) && DeskStatus[memberid] == 1) PlayerPlaySound(memberid,31000,0,0,0);
	}
	return 1;
}
stock get_order_give_card(desk, stat)
{
    find_order_givecard(desk, 1, stat);
    find_order_givecard(desk, 2, stat);
    find_order_givecard(desk, 3, stat);
    find_order_givecard(desk, 4, stat);
    find_order_givecard(desk, 5, stat);
    find_order_givecard(desk, 6, stat);
	return 1;
}
stock find_order_givecard(desk, order, stat)
{
    for(new place = 0; place < MAX_PLAYER_DESK; place++)
	{
	    if(DeskInfo[desk][Playerstatus][place] == 3 && QuanCardPlayer[desk][place] < 6 && DeskInfo[desk][Playerwalk][place] == order && DeskInfo[desk][Quancard] > 0)
		{
		    if(stat == 1 || stat == 0 && place != DeskInfo[desk][Underwalk]-1) give_member_card(desk, place, 6);
		}
	}
	return 1;
}
stock reset_walk(desk, stat, lastor) // Сбрасываем карты на столе и даём карты тем, у кого закончились
{
	new yes_dalee = 1, quangame;
    DeskInfo[desk][Nakidali] = 0;
    DeskInfo[desk][Status] = 3;
    DeskInfo[desk][Hodwalk] = 0;
    DeskInfo[desk][Kon] ++;
    if(DeskInfo[desk][Quancard] > 0) get_order_give_card(desk, stat);
    
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(DeskInfo[desk][Playermessage][p] > 0) DeskInfo[desk][Playermessage][p] = 0, hide_hud_message_members(memberid, desk, p);
	        for(new tdc = 0; tdc < 6; tdc++)
	   		{
	   		    DeskInfo[desk][DeskCard][tdc] = 0, DeskInfo[desk][DeskCardCover][tdc] = 0, DeskInfo[desk][CardWalk][tdc] = 0, DeskInfo[desk][CardUnderwalk][tdc] = 0;
			   	textdraw_desk_card_walk(desk, p, tdc), textdraw_desk_card_underwalk(desk, p, tdc);
		   	}
		   	DeskInfo[desk][QuanDeskCard] = 0;
		   	if(DeskInfo[desk][Playerstatus][p] == 3)
			{
 				if(DeskInfo[desk][Quancard] <= 0 && QuanCardPlayer[desk][p] <= 0) player_out_card_durak(desk, DeskInfo[desk][Underwalk]-1, lastor);
			}
			if(lastor == 2) show_draw_player_menu(memberid, desk);
			if(DeskInfo[desk][Playerstatus][p] == 3) quangame ++;
		}
    }
    if(quangame <= 1) yes_dalee = 0;
	return yes_dalee;
}
stock player_out_card_durak(desk, p, lastor)
{
    if(DeskInfo[desk][Playerstatus][p] > 0)
	{
	    new memberid = DeskInfo[desk][Playerid][p];
	    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
		{
		    DeskInfo[desk][Playerstatus][p] = 4;
		    DeskInfo[desk][Outwin] ++;
		    DeskInfo[desk][Playerwin][p] = DeskInfo[desk][Outwin];
		    DeskInfo[desk][QuanGame] --;
		    if(DeskInfo[desk][QuanGame] >= 2)
			{
			    if(DeskInfo[desk][Status] >= 3 && DeskInfo[desk][Nowhod] == p) DeskInfo[desk][Nowhod] = get_member_next(desk, DeskInfo[desk][Underwalk]-1); // Сбрасываем возвращаемый ход
				ShowDialog(memberid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{99ff66}Поздравляем!\n{ff9000}Не покидайте стол и дождитесь завершения игры, чтобы получить свой выигрыш!","*","");
			}
		    PlayerPlaySound(memberid,6401,0,0,0);
		    if(DeskInfo[desk][QuanGame] <= 1) endgame_card(desk, lastor);
		}
	}
	return 1;
}
stock endgame_card(desk, lastor)
{
    DeskInfo[desk][Dctrump] = 0;
    new Float:koef = DeskInfo[desk][Bank]/100, Float:winquan[MAX_PLAYER_DESK+1];
	new qgamemembers, qwins;
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] >= 3) DeskInfo[desk][Playerstatus][p] = 4;
        if(DeskInfo[desk][Playerstatus][p] == 4)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
				qgamemembers ++;
				if(DeskInfo[desk][Playerwin][p] == 1) qwins ++;
			}
  		}
	}
    
    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
    {
		if(qgamemembers <= 2) // (1 - 2 игрока)
		{
	 		winquan[1] = DeskInfo[desk][Bank]; // Первое место
		}
		else if(qgamemembers == 3) // (3 игрока)
		{
			winquan[1] = koef*70; // Первое место
			winquan[2] = koef*30; // Второе место
		}
		else if(qgamemembers == 4) // (4 игрока)
		{
			winquan[1] = koef*60; // Первое место
			winquan[2] = koef*30; // Второе место
			winquan[3] = koef*10; // Третье место
		}
		else if(qgamemembers == 5) // (5 игроков)
		{
			winquan[1] = koef*50; // Первое место
			winquan[2] = koef*25; // Второе место
			winquan[3] = koef*15; // Третье место
			winquan[4] = koef*10; // Четвёртое место
		}
		else if(qgamemembers == 6) // (6 игроков)
		{
			winquan[1] = koef*50; // Первое место
			winquan[2] = koef*20; // Второе место
			winquan[3] = koef*15; // Третье место
			winquan[4] = koef*10; // Четвёртое место
			winquan[5] = koef*5; // Пятое место
		}

		if(lastor == 3) // Ничья
		{
		    winquan[5] = winquan[4];
		    winquan[4] = winquan[3];
		    winquan[3] = winquan[2];
		    winquan[1] = winquan[1]/2;
		    winquan[2] = winquan[1]/2;
		}
	}
	else if(DeskInfo[desk][Game] == 3)
    {
        if(qwins > 0) winquan[1] = DeskInfo[desk][Bank]/qwins;
    }
    
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
			    DeskInfo[desk][Winsumma][p] = 0;
				if(DeskInfo[desk][Playerstatus][p] == 4) win_game(desk, p, memberid, floatround(winquan[DeskInfo[desk][Playerwin][p]], floatround_round), 0, DeskInfo[desk][Game]);
	  		}
		}
	}
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1) show_endgame_dialog(desk, memberid);
  		}
	}
	stop_game(desk);
	return 1;
}
stock win_game(desk, p, memberid, summa, stat, game)
{
	new string[114], atext[9], btext[3], ctext[10];
	if(DeskInfo[desk][Typebid] == 0) atext = "{0088ff}", btext = "F";
	else if(DeskInfo[desk][Typebid] == 1) atext = "{ffcc00}", btext = "GF";
	if(game == 1 || game == 2) ctext = "Дурак";
	else if(game == 3) ctext = "Покер";
    // Выдаём бабки
	DeskInfo[desk][Winsumma][p] = summa;

    // Достижения
    new chisfishki;
    if(DeskInfo[desk][Typebid] == 0)
    {
    	if(DeskInfo[desk][Winsumma][p] > DeskInfo[desk][Playerbet][p]) chisfishki = DeskInfo[desk][Winsumma][p]-DeskInfo[desk][Playerbet][p], AchievePlayer(memberid, 87, chisfishki);
		if(DeskInfo[desk][Playerbet][p] > DeskInfo[desk][Winsumma][p]) chisfishki = DeskInfo[desk][Playerbet][p]-DeskInfo[desk][Winsumma][p], AchievePlayer(memberid, 88, chisfishki);
	}
	else if(DeskInfo[desk][Typebid] == 1)
    {
    	if(DeskInfo[desk][Winsumma][p] > DeskInfo[desk][Playerbet][p]) chisfishki = DeskInfo[desk][Winsumma][p]-DeskInfo[desk][Playerbet][p], AchievePlayer(memberid, 89, chisfishki);
		if(DeskInfo[desk][Playerbet][p] > DeskInfo[desk][Winsumma][p]) chisfishki = DeskInfo[desk][Playerbet][p]-DeskInfo[desk][Winsumma][p], AchievePlayer(memberid, 90, chisfishki);
	}
	if(DeskInfo[desk][Winsumma][p] > 0)
	{
		if(game == 1 || game == 2) AchievePlayer(memberid, 91, 1);
		else if(game == 3) AchievePlayer(memberid, 92, 1);
		give_chips_player(memberid, desk, DeskInfo[desk][Typebid], DeskInfo[desk][Winsumma][p]);
	}
	else
	{
		if(game == 1 || game == 2) AchievePlayer(memberid, 93, 1);
		else if(game == 3) AchievePlayer(memberid, 94, 1);
	}
	
	if(stat == 0)
	{
		// Логируем
		if(game == 1 || game == 2) format(string,sizeof(string),"[Результат] %s: %d Место | %s", ctext, DeskInfo[desk][Playerwin][p], btext);
		else if(game == 3) format(string,sizeof(string),"[Результат] %s: %s | %s", ctext, comboName[DeskInfo[desk][Combo][p]], btext);
		CasinoLog(ServerInfo[64], PlayerInfo[memberid][pID], PlayerInfo[memberid][pName], PlayerInfo[memberid][pPlaIP], DeskInfo[desk][Winsumma][p], string);
	}
	else if(stat == 1)
	{
	    ShowDialog(memberid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Противник покинул игру. {99ff66}Все фишки с банка стола принадлежат вам","*","");
	    format(string,sizeof(string),"{99ff66}[1 место] {cccccc}%s | %s%d %s [%s]", PlayerInfo[memberid][pName], atext, summa, btext, get_k(summa));
		SendClientMessage(memberid, COLOR_GREY, string);

		// Логируем
		format(string,sizeof(string),"[Результат] %s: Противник вышел | %s", ctext, btext);
		CasinoLog(ServerInfo[64], PlayerInfo[memberid][pID], PlayerInfo[memberid][pName], PlayerInfo[memberid][pPlaIP], DeskInfo[desk][Winsumma][p], string);
	}
	else if(stat == 2)
	{
	    // Последний противник пасанул в покере
	    ShowDialog(memberid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Противник пасует. {99ff66}Все фишки с банка стола принадлежат вам","*","");
		for(new i = 0; i < MAX_PLAYER_DESK; i++)
		{
		    if(DeskInfo[desk][Playerstatus][i] > 0)
	    	{
		        new gamerid = DeskInfo[desk][Playerid][i];
		    	if(IsOnline(gamerid) && DeskStatus[gamerid] == 1)
		    	{
		    	    format(string,sizeof(string),"{99ff66}[1 место] {cccccc}%s | %s%d %s [%s]", PlayerInfo[memberid][pName], atext, summa, btext, get_k(summa));
					SendClientMessage(gamerid, COLOR_GREY, string);
		    	}
			}
		}
		
		// Логируем
		format(string,sizeof(string),"[Результат] %s: %d Место | %s", ctext, DeskInfo[desk][Playerwin][p], btext);
		CasinoLog(ServerInfo[64], PlayerInfo[memberid][pID], PlayerInfo[memberid][pName], PlayerInfo[memberid][pPlaIP], DeskInfo[desk][Winsumma][p], string);
	}
	return 1;
}
stock stop_game(desk)
{
    if(DeskInfo[desk][Walk] > 0) SetDynamicObjectMaterial(MarkPlayerDesk[desk][DeskInfo[desk][Walk]-1], 0, 14581, "ab_mafiasuitea", "cof_wood2", 0x00000000);
    DeskInfo[desk][Dctrump] = 0;
    shuffle_cards(desk); // Тасуем карты
	update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
	new vremwalk = DeskInfo[desk][Walk];
	DeskInfo[desk][Status] = 0;
	DeskInfo[desk][Walk] = 0, DeskInfo[desk][Underwalk] = 0;
	for(new gdc = 0; gdc < 6; gdc++) DeskInfo[desk][DeskCard][gdc] = 0, DeskInfo[desk][DeskCardCover][gdc] = 0, DeskInfo[desk][CardWalk][gdc] = 0, DeskInfo[desk][CardUnderwalk][gdc] = 0;
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(DeskInfo[desk][Playermessage][p] > 0) DeskInfo[desk][Playermessage][p] = 0, hide_hud_message_members(memberid, desk, p);
		    QuanCardPlayer[desk][p] = 0;
		    SetDynamicObjectMaterialText(TextPlayerDesk[desk][p], 0, " ", 140, "Arial", 100, 1, 0xFF333333, 0x00000000, 1);
			DeskInfo[desk][Playerstatus][p] = 1;
			if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
			    for(new cd = 0; cd < 52; cd++) // Чистим карты на руках
				{
				    if(CardPlayer[cd][desk][p] > 0) CardPlayer[cd][desk][p] = 0, PlayerTextDrawHide(memberid, PlayerCardDraw[cd][memberid]);
		  		}
			    if(OnlineInfo[memberid][oShowInterface] == 11) show_all_hud_desk(desk, memberid), show_draw_player_menu(memberid, desk);
			    PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[8][memberid]);
			    PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[9][memberid]);
			    PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[10][memberid]);
			    PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[11][memberid]);
	    		PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[12][memberid]);
			    for(new tdc = 0; tdc < 12; tdc++) PlayerTextDrawHide(memberid, DeskCardDraw[tdc][memberid]);
			    if(vremwalk > 0) PlayerTextDrawHide(memberid, HudPlaceDraw[14][memberid][vremwalk-1]);
   			}
		}
    }
    arrow_desk_pos(desk, 0, 0);
	DeskInfo[desk][QuanGame] = 0;
	DeskInfo[desk][Bank] = 0;
	update_bank_desk(desk);
	return 1;
}
stock playaudiodesk(desk, audioid)
{
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1) PlayerPlaySound(memberid,audioid,0,0,0);
  		}
	}
	return 1;
}
stock show_endgame_dialog(desk, memberid)
{
    new stro[144],sctringo[860], atext[9], btext[3], string[184];
    if(DeskInfo[desk][Typebid] == 0) atext = "{0088ff}", btext = "F";
	else if(DeskInfo[desk][Typebid] == 1) atext = "{ffcc00}", btext = "GF";
	
	format(string,sizeof(string),"{ffcc66}Результаты Игры: {0088ff}%s", gamekasName[DeskInfo[desk][Game]]);
	SendClientMessage(memberid, COLOR_GREY, string);
	format(stro,sizeof(stro),"{ff9000}%s\n", gamekasName[DeskInfo[desk][Game]]), strcat(sctringo,stro);
	for(new winner = 1; winner < DeskInfo[desk][QuanThisGame]; winner++)
	{
	    for(new p = 0; p < MAX_PLAYER_DESK; p++)
		{
		    if(DeskInfo[desk][Playerwin][p] == winner)
			{
			    if(DeskInfo[desk][Playerstatus][p] == 4)
			    {
				    new winnerid = DeskInfo[desk][Playerid][p];
				    if(IsOnline(winnerid) && DeskStatus[winnerid] == 1)
					{
					    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
					    {
							format(stro,sizeof(stro),"\n{cccccc}[%d место] %s | %s%d %s [%s]", winner, PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p])), strcat(sctringo,stro);
							format(string,sizeof(string),"{cccccc}[%d место] %s | %s%d %s [%s]", winner, PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]));
							SendClientMessage(memberid, COLOR_GREY, string);
						}
						else if(DeskInfo[desk][Game] == 3)
					    {
					        if(DeskInfo[desk][Combo][p] == 0)
					        {
								format(stro,sizeof(stro),"\n{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]]), strcat(sctringo,stro);
								format(string,sizeof(string),"{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]]);
								SendClientMessage(memberid, COLOR_GREY, string);
							}
							else if(DeskInfo[desk][Combo][p] == 3)
					        {
					            if(DeskInfo[desk][ComboTwicker][p] > 0)
					            {
									format(stro,sizeof(stro),"\n{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboTwicker][p]]), strcat(sctringo,stro);
									format(string,sizeof(string),"{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboTwicker][p]]);
									SendClientMessage(memberid, COLOR_GREY, string);
								}
								else
								{
									format(stro,sizeof(stro),"\n{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]]), strcat(sctringo,stro);
									format(string,sizeof(string),"{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]]);
									SendClientMessage(memberid, COLOR_GREY, string);
								}
							}
							else
							{
								format(stro,sizeof(stro),"\n{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]]), strcat(sctringo,stro);
								format(string,sizeof(string),"{cccccc}%s | %s%d %s [%s] | {ff9000}%s {cccccc}[Кикер: %s]", PlayerInfo[winnerid][pName], atext, DeskInfo[desk][Winsumma][p], btext, get_k(DeskInfo[desk][Winsumma][p]), comboName[DeskInfo[desk][Combo][p]], cardName[DeskInfo[desk][ComboKicker][p]]);
								SendClientMessage(memberid, COLOR_GREY, string);
							}
						}
					}
					else
					{
						format(stro,sizeof(stro),"\n{FF6347}[%d место] {cccccc}покинул стол", winner), strcat(sctringo,stro);
						format(string,sizeof(string),"{FF6347}[%d место] {cccccc}покинул стол", winner);
						SendClientMessage(memberid, COLOR_GREY, string);
					}
				}
				else
				{
					format(stro,sizeof(stro),"\n{FF6347}[%d место] {cccccc}покинул стол", winner), strcat(sctringo,stro);
					format(string,sizeof(string),"{FF6347}[%d место] {cccccc}покинул стол", winner);
					SendClientMessage(memberid, COLOR_GREY, string);
				}
			}
		}
	}
	ShowDialog(memberid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Результаты Игры",sctringo,"Ок","");
	return 1;
}
stock give_chips_player(playerid, desk, type, quan)
{
	new place = DeskMyPlace[playerid];
	if(type == 0) PlayerInfo[playerid][pAmmos1] += quan;
	else if(type == 1) PlayerInfo[playerid][pAmmos8] += quan;
	update_object_chips(desk, place);
	mysql_save(playerid, 1);
	update_hud_money(playerid, desk, place);
	return 1;
}
stock give_member_card(desk, place, quan)
{
	new reloadquan;
	if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) quan = 6-QuanCardPlayer[desk][place];
	else if(DeskInfo[desk][Game] == 3) quan = 2-QuanCardPlayer[desk][place];
	if(quan > DeskInfo[desk][Quancard]) reloadquan = quan-DeskInfo[desk][Quancard];
	else reloadquan = quan;
	SelectCard[desk][place] = 0;
	DeskInfo[desk][Playerwalk][place] = 0;
    for(new pdc = 0; pdc < 52; pdc++)
    {
        if(CardPlayer[pdc][desk][place] == 0 && reloadquan >= 1 && DeskInfo[desk][Givecard] < DeskInfo[desk][Deck])
		{
			CardPlayer[pdc][desk][place] = DeskInfo[desk][Card][DeskInfo[desk][Givecard]];
			DeskInfo[desk][Givecard] ++;
			QuanCardPlayer[desk][place] ++;
			DeskInfo[desk][Quancard] --;
			reloadquan --;
		}
   	}
	update_textdraw_card_player(desk, place);
	update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
	if(DeskInfo[desk][Playerstatus][place] > 0)
	{
	    new memberid = DeskInfo[desk][Playerid][place];
	    if(IsOnline(memberid) && DeskStatus[memberid] == 1) PlayerPlaySound(memberid,31000,0,0,0);
	}
	return 1;
}
stock cancel_go_game(desk)
{
    DeskInfo[desk][QuanGame] = 0;
    DeskInfo[desk][Timer] = 0;
    DeskInfo[desk][Status] = 0;
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    DeskInfo[desk][Playerstatus][p] = 1;
		    if(DeskInfo[desk][Playermessage][p] > 0) DeskInfo[desk][Playermessage][p] = 0, hide_hud_message_members(memberid, desk, p);
  		}
	}
	return 1;
}
stock join_player_desk(playerid, desk, place) // Присоединяемся к игре (0 - значит главный за столом)
{
    if(DeskInfo[desk][QuanPlayer] >= MAX_PLAYER_DESK)
	{
		ErrorMessage(playerid, "{FF6347}За этим столом нет свободных мест");
		return 0;
	}
	if(DeskInfo[desk][Playerstatus][place] > 0)
	{
		ErrorMessage(playerid, "{FF6347}Это место занято");
		return 0;
	}
	if(OnlineInfo[playerid][oShowInterface] == 1) CloseFrisk(playerid), CancelSelectTextDraw(playerid);
	if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
	
	DeskStatus[playerid] = 1;
	DeskID[playerid] = desk;
	DeskMyPlace[playerid] = place;
	PlayerPlaySound(playerid,30800,0,0,0);
	
	QuanCardPlayer[desk][place] = 0;
	SelectCard[desk][place] = 0;
	
	if(DeskInfo[desk][QuanPlayer] == 0) // Создаём лидера
	{
	    show_dialog_help(playerid, 1);
		DeskInfo[desk][Leaderid] = playerid, DeskInfo[desk][Leaderidstatus] = place+1;
		
		// Сбрасываем стол
		DeskInfo[desk][Joinorder] = 0;
		DeskInfo[desk][QuanGame] = 0;
		DeskInfo[desk][Timer] = 0;
		DeskInfo[desk][Status] = 0;
		DeskInfo[desk][Bank] = 0;
		DeskInfo[desk][Walk] = 0;
		DeskInfo[desk][Underwalk] = 0;
		DeskInfo[desk][Room] = 0;
		DeskInfo[desk][Table] = 0;
        DeskInfo[desk][Game] = 1;
        DeskInfo[desk][Deck] = 52;
        shuffle_cards(desk); // Тасуем карты
		DeskInfo[desk][Shotclock] = 20;
		reset_stavka_stol(desk);
	}
	else show_dialog_help(playerid, 0);
    DeskInfo[desk][QuanPlayer] ++;
    DeskInfo[desk][Playerid][place] = playerid, DeskInfo[desk][Playerstatus][place] = 1;
    
    DeskInfo[desk][Joinorder] ++;
    DeskInfo[desk][Playerjoin][place] = DeskInfo[desk][Joinorder];
    
    // Синхронизация с игроками
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        create_textdraw_huddeskplace(playerid, place, p); // PlayerText: худы игроков и свой [78]
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
				if(memberid != playerid)
				{
				    PlayerPlaySound(memberid,1083,0,0,0);
					if(OnlineInfo[memberid][oShowInterface] == 11) show_hudplayer_desk(memberid, playerid, desk, place); // Показываем себя другим (если у них открыто меню)
				}
			}
		}
	}
	create_mark_player_desk(desk, place); // Метка объект на столе
	create_object_chips(desk, place); // Фишки на столе
	
	create_textdraw_hudleader(playerid, place); // PlayerText: лидер [1]
	create_textdraw_playermenu(playerid); // PlayerText: управление [13]
	create_textdraw_deskcard(playerid, DeskInfo[desk][Game]); // PlayerText: карты на столе [12]
	// Очищаем карты
	for(new dc = 0; dc < 52; dc++) CardPlayer[dc][desk][place] = 0, PlayerCardDraw[dc][playerid] = CreatePlayerTextDraw(playerid, 1.0, 1.0, cardtextDraw[0]);
	
	if(DeskInfo[desk][Status] >= 3 && (DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)) show_hud_deskcard(playerid, place, desk);
	update_desk_label(desk);
	return 1;
}
stock show_hud_desk(playerid, desk) // Показываем худы игрока при переключении режима
{
	new myplace = DeskMyPlace[playerid];
	if(myplace == 0 || myplace == 5) FlyCameraPos(playerid,1376.922119, 1576.139770, 13.792738,  1380.457519, 1576.169189, 10.257206  ,600,500);
	else if(myplace == 1) FlyCameraPos(playerid,1380.238891, 1580.223754, 13.700102,  1380.237304, 1576.289428, 10.614471  ,600,500);
	else if(myplace == 2 || myplace == 3) FlyCameraPos(playerid,1383.582275, 1576.160644, 13.464631,  1379.733886, 1576.136352, 10.272586  ,600,500);
    else if(myplace == 4) FlyCameraPos(playerid,1380.189331, 1572.253662, 13.470508,  1380.201049, 1576.221435, 10.428092  ,600,500);
    
    show_all_hud_desk(desk, playerid);
	if(DeskInfo[desk][Leaderid] == playerid && DeskInfo[desk][Leaderidstatus] >= 0) PlayerTextDrawShow(playerid, DeskLeaderDraw[playerid]);
	show_draw_player_menu(playerid, desk);
	
	PlayerPlaySound(playerid,40405,0,0,0);
	OnlineInfo[playerid][oShowInterface] = 11;
	SelectTextDraw(playerid,0x666666AA);
	return 1;
}
stock show_all_hud_desk(desk, playerid)
{
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p], targetplace;
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
			    targetplace = DeskMyPlace[memberid];
			    show_hudplayer_desk(playerid, memberid, desk, targetplace);
			}
		}
	}
	return 1;
}
stock show_hudplayer_desk(playerid, memberid, desk, targetplace)
{
    new string[24];
    if(DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == targetplace) // Ход этого игрока
	{
		//PlayerTextDrawFont(playerid, HudPlaceDraw[0][playerid][targetplace], TEXT_DRAW_FONT:4);
		//PlayerTextDrawColour(playerid, HudPlaceDraw[0][playerid][targetplace], PlayerInfo[playerid][pStyle1]);
  		//PlayerTextDrawBackgroundColour(playerid, HudPlaceDraw[0][playerid][targetplace], -1);
		upd_walk_timer(desk, playerid, targetplace);
	}
    else
	{
	    //PlayerTextDrawFont(playerid, HudPlaceDraw[0][playerid][targetplace], TEXT_DRAW_FONT:5);
		//PlayerTextDrawColour(playerid, HudPlaceDraw[0][playerid][targetplace], -1);
		//PlayerTextDrawBackgroundColour(playerid, HudPlaceDraw[0][playerid][targetplace], 1488315452);
	}
    PlayerTextDrawShow(playerid, HudPlaceDraw[0][playerid][targetplace]); // Фон
    PlayerTextDrawShow(playerid, HudPlaceDraw[1][playerid][targetplace]); // Ава
    format(string,sizeof(string),"%s",PlayerInfo[memberid][pName]);
	PlayerTextDrawSetString(playerid, HudPlaceDraw[2][playerid][targetplace], string), PlayerTextDrawShow(playerid, HudPlaceDraw[2][playerid][targetplace]); // Имя
	if(PlayerInfo[memberid][pAmmos1] >= 1000) format(string,sizeof(string),"%d [%s]",PlayerInfo[memberid][pAmmos1],get_k(PlayerInfo[memberid][pAmmos1]));
	else format(string,sizeof(string),"%d",PlayerInfo[memberid][pAmmos1]);
	PlayerTextDrawSetString(playerid, HudPlaceDraw[3][playerid][targetplace], string), PlayerTextDrawShow(playerid, HudPlaceDraw[3][playerid][targetplace]); // Фишки
	if(PlayerInfo[memberid][pAmmos8] >= 1000) format(string,sizeof(string),"%d [%s]",PlayerInfo[memberid][pAmmos8],get_k(PlayerInfo[memberid][pAmmos8]));
	else format(string,sizeof(string),"Gold_F:_%d",PlayerInfo[memberid][pAmmos8]);
	PlayerTextDrawSetString(playerid, HudPlaceDraw[4][playerid][targetplace], string), PlayerTextDrawShow(playerid, HudPlaceDraw[4][playerid][targetplace]); // Gold Фишки
	if(DeskInfo[desk][Playermessage][targetplace] > 0) show_player_hud_message(playerid, targetplace, DeskInfo[desk][Playermessage][targetplace]); // Показываем сообщение
	show_hudtwoplayer_desk(playerid, desk, targetplace);
	if(DeskInfo[desk][Underwalk] > 0 && DeskInfo[desk][Underwalk]-1 == targetplace) PlayerTextDrawShow(playerid, HudPlaceDraw[13][playerid][targetplace]);
	return 1;
}
stock show_hudtwoplayer_desk(playerid, desk, targetplace)
{
	if(DeskInfo[desk][Status] == 0) return PlayerTextDrawHide(playerid, HudPlaceDraw[8][playerid][targetplace]), PlayerTextDrawHide(playerid, HudPlaceDraw[9][playerid][targetplace]), PlayerTextDrawHide(playerid, HudPlaceDraw[10][playerid][targetplace]), PlayerTextDrawHide(playerid, HudPlaceDraw[12][playerid][targetplace]);
    if(DeskInfo[desk][Playerstatus][targetplace] == 3 || DeskInfo[desk][Playerstatus][targetplace] == 4 && DeskInfo[desk][Status] >= 3)
    {
		new string[8];
		PlayerTextDrawShow(playerid, HudPlaceDraw[8][playerid][targetplace]);
		PlayerTextDrawShow(playerid, HudPlaceDraw[9][playerid][targetplace]);
		format(string,sizeof(string),"%d",QuanCardPlayer[desk][targetplace]);
		PlayerTextDrawSetString(playerid, HudPlaceDraw[10][playerid][targetplace], string);
		PlayerTextDrawShow(playerid, HudPlaceDraw[10][playerid][targetplace]);
		if(DeskInfo[desk][Walking] == 0 && DeskInfo[desk][Game] != 3 && DeskInfo[desk][Dctrump] > 0 && DeskInfo[desk][Dcplayer]-1 == targetplace) show_trump_card(desk, playerid, targetplace, DeskInfo[desk][Dctrump]);
	}
	else PlayerTextDrawHide(playerid, HudPlaceDraw[8][playerid][targetplace]), PlayerTextDrawHide(playerid, HudPlaceDraw[9][playerid][targetplace]), PlayerTextDrawHide(playerid, HudPlaceDraw[10][playerid][targetplace]), PlayerTextDrawHide(playerid, HudPlaceDraw[12][playerid][targetplace]);
	return 1;
}
stock update_hudtwoplayer_desk(desk, targetplace)
{
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
			    if(OnlineInfo[memberid][oShowInterface] == 11) show_hudtwoplayer_desk(memberid, desk, targetplace);
			}
		}
	}
	return 1;
}
stock close_hud_desk(playerid)
{
    new desk = DeskID[playerid];
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
		    new memberid = DeskInfo[desk][Playerid][p], targetplace;
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
                targetplace = DeskMyPlace[memberid];
    			for(new i = 0; i < 15; i++) PlayerTextDrawHide(playerid, HudPlaceDraw[i][playerid][targetplace]);
			}
		}
	}
	if(DeskInfo[desk][Leaderid] == playerid && DeskInfo[desk][Leaderidstatus] > 0) PlayerTextDrawHide(playerid, DeskLeaderDraw[playerid]);
	close_draw_player_menu(playerid);
	SetCameraBehindPlayer(playerid);
	OnlineInfo[playerid][oShowInterface] = 0;
	HidePlayerDialog(playerid);
	return 1;
}
stock send_hud_message(playerid, desk, place, idm) // Отправляем Сообщение
{
	if(playerid == 0) { }
    DeskInfo[desk][Playermessage][place] = idm;
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
            new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
				if(OnlineInfo[memberid][oShowInterface] == 11) show_player_hud_message(memberid, place, idm);
			}
		}
	}
	/*
	if(idm == 1) create_mind_object(playerid, "ПЕРЕВОЖУ");
	else if(idm == 2) create_mind_object(playerid, "БЕРУ");
	else if(idm == 3) create_mind_object(playerid, "БИТО");
	else if(idm == 4) create_mind_object(playerid, "FOLD");
	else if(idm == 5) create_mind_object(playerid, "CHECK");
	else if(idm == 6) create_mind_object(playerid, "CALL");
	else if(idm == 7) create_mind_object(playerid, "RAISE");
	else if(idm == 9) create_mind_object(playerid, "НЕТ");
	*/
    return 1;
}
stock show_player_hud_message(playerid, place, idm) // Показываем сообщение
{
	if(idm == 1) // Перевожу
	{
		PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], -1), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], -1);
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "ЊEPE‹O„Y");
		else PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "TRANSFER");
	}
	else if(idm == 2) // Беру
	{
		PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], -1), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], -1);
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "ЂEPY");
		else PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "TAKE");
	}
	else if(idm == 3) // Бито
	{
		PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], -1), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], -1);
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "Ђ…ЏO");
		else PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "BEAT");
	}
	else if(idm == 4) PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], -1523963137), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], -1523963137), PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "FOLD"); // FOLD (вышел - пас)
	else if(idm == 5) PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], -1), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], -1), PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "CHECK"); // CHECK (чек - пропуск круга)
	else if(idm == 6) PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], 1995271167), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], 1995271167), PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "CALL"); // CALL (колл - принял повышение ставки)
	else if(idm == 7) PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], 1995271167), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], 1995271167), PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "RAISE"); // RAISE (рейз - повысил ставку)
	else if(idm == 8) PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], 1995271167), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], 1995271167), PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "GO!"), PlayerPlaySound(playerid,21000,0,0,0); // Готов играть
	else if(idm == 9) // НЕТ
	{
		PlayerTextDrawColour(playerid, HudPlaceDraw[5][playerid][place], -1), PlayerTextDrawColour(playerid, HudPlaceDraw[6][playerid][place], -1);
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "HET");
		else PlayerTextDrawSetString(playerid, HudPlaceDraw[7][playerid][place], "NO");
	}
	PlayerTextDrawShow(playerid, HudPlaceDraw[5][playerid][place]);
    PlayerTextDrawShow(playerid, HudPlaceDraw[6][playerid][place]);
	PlayerTextDrawShow(playerid, HudPlaceDraw[7][playerid][place]);
	return 1;
}
stock create_mind_object(playerid, const text[])
{
    if(MindStatObject[playerid] == true) close_mind_object(playerid);
    MindStatObject[playerid] = true;
	MindTime[playerid] = 5;
    MindObject[0][playerid] = CreateDynamicObject(19483, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], 0.0, 0.0, 0.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 20.00, 20.00); // oblako_nad_golovoi
	SetDynamicObjectMaterialText(MindObject[0][playerid], 0, "]", 130, "Webdings", 90, 1, 0xFFFFFFFF, 0x00000000, 1);
    MindObject[1][playerid] = CreateDynamicObject(19475, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], 0.0, 0.0, 0.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 20.00, 20.00); // text_nad_golovoi (max10)
	SetDynamicObjectMaterialText(MindObject[1][playerid], 0, text, 140, "Comic Sans MS", 85, 1, 0xFF222222, 0x00000000, 1);
	
	// Если за столом в казино
	if(DeskStatus[playerid] == 1) streamer_update_object_member(DeskID[playerid]);
	else
	{
		around_update(100.0, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid], GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	}

	// Если игрок сидит
	if(playerSeat[playerid])
	{
		AttachDynamicObjectToPlayer(MindObject[0][playerid], playerid, -0.37, -0.450, 0.32, 0.0, 0.0, 90.0);
		AttachDynamicObjectToPlayer(MindObject[1][playerid], playerid, -0.37, -0.445, 0.34, 0.0, 0.0, 90.0);
	}
	else
	{
		AttachDynamicObjectToPlayer(MindObject[0][playerid], playerid, -0.37, -0.02, 0.92, 0.0, 0.0, 90.0);
		AttachDynamicObjectToPlayer(MindObject[1][playerid], playerid, -0.37, -0.015, 0.94, 0.0, 0.0, 90.0);
	}
	return 1;
}
stock hide_hud_message_members(playerid, desk, place) // Закрываем сообщение для всех
{
    if(playerid == 0) { }
    /*if(IsOnline(playerid))
    {
		if(MindStatObject[playerid] == true) close_mind_object(playerid);
	}*/
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
            new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
				if(OnlineInfo[memberid][oShowInterface] == 11) PlayerTextDrawHide(memberid, HudPlaceDraw[5][memberid][place]), PlayerTextDrawHide(memberid, HudPlaceDraw[6][memberid][place]), PlayerTextDrawHide(memberid, HudPlaceDraw[7][memberid][place]);
			}
		}
	}
	return 1;
}
stock destroy_hud_desk(playerid, targetplace)
{
    for(new i = 0; i < 15; i++) PlayerTextDrawHide(playerid, HudPlaceDraw[i][playerid][targetplace]), PlayerTextDrawDestroy(playerid, HudPlaceDraw[i][playerid][targetplace]);
}
stock hide_hud_desk(playerid, targetplace)
{
    for(new i = 0; i < 15; i++) PlayerTextDrawHide(playerid, HudPlaceDraw[i][playerid][targetplace]);
}
stock destroy_object_chips(desk, place)
{
    for(new ch = 0; ch < MAX_CHIPS_PLAYER; ch++)
    {
        if(ObjectChipsStat[desk][ch][place] == 1) ObjectChipsStat[desk][ch][place] = 0, DestroyDynamicObject(ObjectChips[desk][ch][place]);
    }
    return 1;
}
stock leave_desk(playerid) // Выходим из-за стола (отключение, выход, смерть, отошли далеко и т.д.)
{
    if(DeskStatus[playerid] == 1)
	{
		new desk = DeskID[playerid], place = DeskMyPlace[playerid];
		DeskInfo[desk][Playermessage][place] = 0;
		DeskInfo[desk][Playerbet][place] = 0;
		
		// Удаляем Объекты Фишек
		destroy_object_chips(desk, place);
		
		// Удаляем метки игрока
		DestroyDynamicObject(MarkPlayerDesk[desk][place]);
		DestroyDynamicObject(TextPlayerDesk[desk][place]);
		
		destroy_textdraw_deskcard(playerid); // PlayerText: карты на столе
		
		// Очищаем карты
		for(new cd = 0; cd < 52; cd++)
		{
		    if(CardPlayer[cd][desk][place] > 0) CardPlayer[cd][desk][place] = 0;
			PlayerTextDrawHide(playerid, PlayerCardDraw[cd][playerid]), PlayerTextDrawDestroy(playerid, PlayerCardDraw[cd][playerid]); // Карты игрока
  		}
  		QuanCardPlayer[desk][place] = 0;
  		SelectCard[desk][place] = 0;
		
		// Удаляем текстдравы меню управления
		for(new ptm = 0; ptm < 13; ptm++) PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[ptm][playerid]), PlayerTextDrawDestroy(playerid, DeskPlayerMenuDraw[ptm][playerid]);
		for(new p = 0; p < MAX_PLAYER_DESK; p++)
	    {
	    	if(place != p && DeskInfo[desk][Playerjoin][p] > DeskInfo[desk][Playerjoin][place]) DeskInfo[desk][Playerjoin][p] --;
	        destroy_hud_desk(playerid, p);
	        if(DeskInfo[desk][Playerstatus][p] > 0)
			{
			    new memberid = DeskInfo[desk][Playerid][p];
			    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
				{
				    if(DeskInfo[desk][Playerjoin][p] == 1 && p != place)
				    {
				        DeskInfo[desk][Leaderid] = memberid, DeskInfo[desk][Leaderidstatus] = p+1;
						if(OnlineInfo[memberid][oShowInterface] == 11) PlayerTextDrawShow(memberid, DeskLeaderDraw[memberid]);
				    }
				    hide_hud_desk(memberid, place); // Удаляем текстравы окна игроков и свой (худы)
				    PlayerPlaySound(memberid,14408,0,0,0);
				}
			}
		}
		
		DeskStatus[playerid] = 0;
		DeskID[playerid] = 0;
		OnlineInfo[playerid][oShowInterface] = 0;
		SetCameraBehindPlayer(playerid);
		CancelSelectTextDraw(playerid);
		HidePlayerDialog(playerid);
		PlayerPlaySound(playerid,30802,0,0,0);
		if(DeskInfo[desk][Joinorder] > 0) DeskInfo[desk][Joinorder] --;
		DeskInfo[desk][Playerjoin][place] = 0;
		PlayerTextDrawHide(playerid, DeskLeaderDraw[playerid]), PlayerTextDrawDestroy(playerid, DeskLeaderDraw[playerid]); // PlayerText: текстдрав управления
		if(DeskInfo[desk][Status] >= 1 && DeskInfo[desk][Playerstatus][place] > 1 && DeskInfo[desk][Playerstatus][place] <= 3) DeskInfo[desk][QuanGame] --;
		if(DeskInfo[desk][Playerstatus][place] > 0 && DeskInfo[desk][Playerid][place] == playerid) DeskInfo[desk][Playerid][place] = 0, DeskInfo[desk][Playerstatus][place] = 0;
		DeskInfo[desk][QuanPlayer] --;

		if(DeskInfo[desk][QuanPlayer] <= 0) // Последний чел вышел - природа очистилась
		{
		    DeskInfo[desk][Status] = 0;
			DeskInfo[desk][Quancard] = -1;
			DeskInfo[desk][Walk] = 0;
			DeskInfo[desk][Underwalk] = 0;
			DeskInfo[desk][Bank] = 0;
			DeskInfo[desk][QuanGame] = 0;
			DeskInfo[desk][QuanPlayer] = 0;
			DeskInfo[desk][Table] = 0;
			DeskInfo[desk][Room] = 0;
			
			update_bank_desk(desk);
 			update_quan_cards_desk(desk, DeskInfo[desk][Quancard]);
 			arrow_desk_pos(desk, 0, 0);
		}
		else // Выходы из игры
		{
		    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2)
		    {
			    new net;
			    if(DeskInfo[desk][QuanGame] <= 1 && DeskInfo[desk][Status] >= 3) // Последний Вышел
			    {
			        for(new p = 0; p < MAX_PLAYER_DESK; p++)
					{
					    if(DeskInfo[desk][Playerstatus][p] > 0)
						{
						    new memberid = DeskInfo[desk][Playerid][p];
						    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
							{
								if(DeskInfo[desk][Playerstatus][p] == 3) win_game(desk, p, memberid, DeskInfo[desk][Bank], 1, DeskInfo[desk][Game]);
							}
						}
					}
			        stop_game(desk);
			        net = 1;
			    }
			    if(DeskInfo[desk][Status] >= 3 && DeskInfo[desk][Underwalk] > 0 && DeskInfo[desk][Underwalk]-1 == place && net == 0) // Чел который кроется
			    {
			        DeskInfo[desk][Lastor] = 0;
				    new yeahkas = reset_walk(desk, 1, 1);
				    if(yeahkas == 1)
				    {
	   				    // Передаём ход следующему после того, кто крылся
	   					new place_walk = get_member_next(desk, DeskInfo[desk][Underwalk]-1);
	    				go_walk(desk, place_walk, 0, 0);
					}
	                go_walk(desk, get_member_next(desk, place), 0, 1);
					net = 1;
			    }

			    if(DeskInfo[desk][Status] >= 3 && DeskInfo[desk][Nowhod] == place && net == 0) DeskInfo[desk][Nowhod] = get_member_next(desk, DeskInfo[desk][Underwalk]-1); // Сбрасываем возвращаемый ход
			    if(DeskInfo[desk][Status] == 3 && DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place && net == 0) go_walk(desk, get_member_next(desk, place), 0, 0); // Чел который ходит
			}
			else if(DeskInfo[desk][Game] == 3)
		    {
			    new net;
			    if(DeskInfo[desk][QuanGame] <= 1 && DeskInfo[desk][Status] >= 3) // Последний Вышел
			    {
			        for(new p = 0; p < MAX_PLAYER_DESK; p++)
					{
					    if(DeskInfo[desk][Playerstatus][p] > 0)
						{
						    new memberid = DeskInfo[desk][Playerid][p];
						    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
							{
								if(DeskInfo[desk][Playerstatus][p] == 3) win_game(desk, p, memberid, DeskInfo[desk][Bank], 1, DeskInfo[desk][Game]);
							}
						}
					}
			        stop_game(desk);
			        net = 1;
			    }
			    if(DeskInfo[desk][Status] >= 3 && DeskInfo[desk][Walk] > 0 && DeskInfo[desk][Walk]-1 == place && net == 0) go_walk(desk, get_member_next(desk, place), 0, 0); // Чел который ходит
			}
		}
		update_desk_label(desk);
		//if(MindStatObject[playerid] == true) close_mind_object(playerid);
	}
	return 1;
}
stock reset_game_desk(desk) // Изменяется игра, перезапускаем все текстдравы
{
    for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
            new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1)
			{
			    // Удаляем Текстдравы
			    destroy_textdraw_deskcard(memberid); // PlayerText: карты на столе
				for(new cd = 0; cd < 52; cd++)
				{
				    PlayerTextDrawHide(memberid, PlayerCardDraw[cd][memberid]), PlayerTextDrawDestroy(memberid, PlayerCardDraw[cd][memberid]); // PlayerText: Карты игрока
		  		}
				for(new ptm = 0; ptm < 13; ptm++) PlayerTextDrawHide(memberid, DeskPlayerMenuDraw[ptm][memberid]), PlayerTextDrawDestroy(memberid, DeskPlayerMenuDraw[ptm][memberid]);
				PlayerTextDrawHide(memberid, DeskLeaderDraw[memberid]), PlayerTextDrawDestroy(memberid, DeskLeaderDraw[memberid]); // PlayerText: текстдрав управления
				
				new memplace = DeskMyPlace[memberid];
			    for(new p2 = 0; p2 < MAX_PLAYER_DESK; p2++)
				{
					destroy_hud_desk(memberid, p2);
				// Создаём Текстдравы
					create_textdraw_huddeskplace(memberid, memplace, p2); // PlayerText: худы игроков и свой [78]
				}
			    create_textdraw_hudleader(memberid, p); // PlayerText: лидер [1]
			    create_textdraw_playermenu(memberid); // PlayerText: управление [13]
			    create_textdraw_deskcard(memberid, DeskInfo[desk][Game]); // PlayerText: карты на столе [12]
				if(OnlineInfo[memberid][oShowInterface] == 11)
				{
				    show_all_hud_desk(desk, memberid);
				    if(DeskInfo[desk][Leaderid] == memberid && DeskInfo[desk][Leaderidstatus] > 0) PlayerTextDrawShow(memberid, DeskLeaderDraw[memberid]);
                    show_draw_player_menu(memberid, desk);
				}
			}
		}
	}
	return 1;
}
stock show_draw_player_menu(playerid, desk) // Формируем и показываем кнопки управления (go, fold, check и так далее)
{
    new place = DeskMyPlace[playerid];
	if(DeskInfo[desk][Status] <= 1 || DeskInfo[desk][Playerstatus][place] <= 2 || DeskInfo[desk][Playerstatus][place] == 4) // Ожидание
	{
	    if(DeskInfo[desk][Game] == 3)
	    {
			PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[0][playerid]), PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[1][playerid]);
			PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[4][playerid]), PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[5][playerid]);
			PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[6][playerid]), PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[7][playerid]);
		}
    	PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[2][playerid], 1995271167), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[2][playerid]);
    	PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[3][playerid], 933117951), PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "GO"), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[3][playerid]);
	}
	else if(DeskInfo[desk][Playerstatus][place] == 3)
	{
	    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) // Дурак Подкидной и Переводной
	    {
	        if(DeskInfo[desk][Underwalk]-1 == place) // Ходят под меня (я могу только брать)
	        {
	            PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[2][playerid], -1523963137), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[2][playerid]);
	        	PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[3][playerid], 1091177215);
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "ЂEPY");
				else PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "TAKE");
				PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[3][playerid]);
	        }
	        else
	        {
	            if(DeskInfo[desk][Lastor] == 2) // Другой чел берёт карты (я могу только подкинуть)
	    		{
	                PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[2][playerid], -2139062017), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[2][playerid]);
	    			PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[3][playerid], 505290495);
					if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "HET");
					else PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "NO");
					PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[3][playerid]);
	        	}
	        	else // Я хожу или подкидываю (я могу только сказать БИТО)
	        	{
	                PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[2][playerid], 766172415), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[2][playerid]);
	    			PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[3][playerid], 6533375);
					if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "Ђ…ЏO");
					else PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "BEAT");
					PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[3][playerid]);
	        	}
	        }
	    }
	    else if(DeskInfo[desk][Game] == 3) // Покер Техасский
	    {
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[0][playerid], -1523963137), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[0][playerid]);
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[1][playerid], 1091177215), PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[1][playerid], "FOLD"), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[1][playerid]);
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[2][playerid], -2139062017), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[2][playerid]);
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[3][playerid], 505290495), PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[3][playerid], "CHECK"), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[3][playerid]);
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[4][playerid], 766172415), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[4][playerid]);
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[5][playerid], 6533375), PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[5][playerid], "CALL"), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[5][playerid]);
	        
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[6][playerid], 1995271167), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[6][playerid]);
	        PlayerTextDrawColour(playerid, DeskPlayerMenuDraw[7][playerid], 933117951), PlayerTextDrawSetString(playerid, DeskPlayerMenuDraw[7][playerid], "RAISE"), PlayerTextDrawShow(playerid, DeskPlayerMenuDraw[7][playerid]);
	    }
	}
	return 1;
}
stock close_draw_player_menu(playerid) // Закрываем кнопки управления
{
	for(new ptm = 0; ptm < 8; ptm++) PlayerTextDrawHide(playerid, DeskPlayerMenuDraw[ptm][playerid]);
	return 1;
}
function show_dialog_member_kasino(desk, const string[])
{
	for(new p = 0; p < MAX_PLAYER_DESK; p++)
    {
        if(DeskInfo[desk][Playerstatus][p] > 0)
		{
            new memberid = DeskInfo[desk][Playerid][p];
		    if(IsOnline(memberid) && DeskStatus[memberid] == 1) SuccessMessage(memberid, string);
		}
	}
}
function streamer_update_object_member(desk)
{
    foreach(Player,i)
	{
	    if(GetPlayerInterior(i) == 199 && GetPlayerVirtualWorld(i) > 0 && GetPlayerVirtualWorld(i)-1 == desk) Streamer_Update(i);
	}
}
stock dialog_setting_kasino(playerid)
{
   	new str[100],sctring[630],desk = DeskID[playerid];
   	if(DeskInfo[desk][Room] == 0) format(str,sizeof(str),"{cccccc}Комната \t {99ff66}[Открыта]"), strcat(sctring,str);
   	else if(DeskInfo[desk][Room] == 1) format(str,sizeof(str),"{cccccc}Комната \t {FF6347}[Закрыта]"), strcat(sctring,str);
   	if(DeskInfo[desk][Table] == 0) format(str,sizeof(str),"\n{cccccc}Стол \t {99ff66}[Открыт]"), strcat(sctring,str);
   	else if(DeskInfo[desk][Table] == 1) format(str,sizeof(str),"\n{cccccc}Стол \t {FF6347}[Закрыт]"), strcat(sctring,str);
   	format(str,sizeof(str),"\n{ff9000}Игра \t {ff9000}[%s]", gamekasName[DeskInfo[desk][Game]]), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Карт в колоде \t {ff9000}%d", DeskInfo[desk][Deck]), strcat(sctring,str);
   	
	if(DeskInfo[desk][Typebid] == 0)
	{
	    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) format(str,sizeof(str),"\n{cccccc}Ставка стола \t {99ff66}[%d F]", DeskInfo[desk][Bet]), strcat(sctring,str);
	    else format(str,sizeof(str),"\n{cccccc}Начальная ставка \t {99ff66}[%d F]", DeskInfo[desk][Bet]), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}Максимальная ставка \t {FF6347}[%d F]", DeskInfo[desk][Maxbet]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Тип ставок \t {0088ff}Фишки [$]"), strcat(sctring,str);
		if(DeskInfo[desk][Betsize] == 0) format(str,sizeof(str),"\n{cccccc}Фишки для ставок \t {0088ff}10 - 5000 (маленькие фишки)"), strcat(sctring,str);
		else if(DeskInfo[desk][Betsize] == 1) format(str,sizeof(str),"\n{cccccc}Фишки для ставок \t {0088ff}1000 - 500.000 (крупные фишки)"), strcat(sctring,str);
	}
	else if(DeskInfo[desk][Typebid] == 1)
	{
	    if(DeskInfo[desk][Game] == 1 || DeskInfo[desk][Game] == 2) format(str,sizeof(str),"\n{cccccc}Ставка стола \t {ffcc00}[%d GF]", DeskInfo[desk][Bet]), strcat(sctring,str);
	    else format(str,sizeof(str),"\n{cccccc}Начальная ставка \t {ffcc00}[%d GF]", DeskInfo[desk][Bet]), strcat(sctring,str);
	    format(str,sizeof(str),"\n{cccccc}Максимальная ставка \t {FF6347}[%d GF]", DeskInfo[desk][Maxbet]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Тип ставок \t {ffcc00}Gold Фишки [G]"), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Фишки для ставок \t {ffcc00}1 - 500"), strcat(sctring,str);
	}
	format(str,sizeof(str),"\n{cccccc}Шот-клок (время для хода) \t {ffffff}[%d сек.]", DeskInfo[desk][Shotclock]), strcat(sctring,str);
	ShowDialog(playerid,1195,DIALOG_STYLE_TABLIST,"{ff9000}Казино",sctring,"Выбор","Выход");
	return 1;
}
stock dialog_member_kasino(playerid, memberid, p)
{
	new str[100],sctring[200],desk = DeskID[playerid];
	DP[0][playerid] = memberid, DP[1][playerid] = p;
	if(DeskInfo[desk][Leaderid] == memberid && DeskInfo[desk][Leaderidstatus] > 0) format(str,sizeof(str),"{ff9000}Лидер Стола: {cccccc}%s[%d]",PlayerInfo[memberid][pName],memberid), strcat(sctring,str);
	else format(str,sizeof(str),"{cccccc}Участник: {cccccc}%s[%d]",PlayerInfo[memberid][pName],memberid), strcat(sctring,str);
   	format(str,sizeof(str),"\n{cccccc}Статистика"), strcat(sctring,str);
   	format(str,sizeof(str),"\n{FF6347}Выгнать Участника"), strcat(sctring,str);
	ShowDialog(playerid,1201,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Казино",sctring,"Выбор","Выход");
	return 1;
}
stock dialog_infomember_kasino(playerid, memberid, place)
{
    new stro[86],sctringo[960],desk = DeskID[playerid];
    if(DeskInfo[desk][Leaderid] == memberid && DeskInfo[desk][Leaderidstatus] > 0) format(stro,sizeof(stro),"{ff9000}Лидер Стола: {cccccc}%s[%d]",PlayerInfo[memberid][pName],memberid), strcat(sctringo,stro);
    else format(stro,sizeof(stro),"{ff9000}Участник: {cccccc}%s[%d]",PlayerInfo[memberid][pName],memberid), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{ff9000}Место за столом: {cccccc}%d", place+1), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{0088ff}Фишки: {cccccc}%d", PlayerInfo[memberid][pAmmos1]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{ffcc00}Gold Фишки: {cccccc}%d", PlayerInfo[memberid][pAmmos8]), strcat(sctringo,stro);
    
    format(stro,sizeof(stro),"\n\n{cccccc}Выиграл денег в карты: {99ff66}%d$", PlayerInfo[memberid][pAchieveStat][87]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Выиграл gold в карты: {ffcc00}%dG", PlayerInfo[memberid][pAchieveStat][88]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Проиграл денег в карты: {FF6347}%d$", PlayerInfo[memberid][pAchieveStat][89]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Проиграл gold в карты: {FF6347}%dG", PlayerInfo[memberid][pAchieveStat][90]), strcat(sctringo,stro);
    
    format(stro,sizeof(stro),"\n\n{cccccc}Побед в дурака: {ff9000}%d", PlayerInfo[memberid][pAchieveStat][91]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Побед в покере: {ff9000}%d", PlayerInfo[memberid][pAchieveStat][92]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Проигрышей в дурака: {FF6347}%d", PlayerInfo[memberid][pAchieveStat][93]), strcat(sctringo,stro);
    format(stro,sizeof(stro),"\n{cccccc}Проигрышей в покере: {FF6347}%d\n", PlayerInfo[memberid][pAchieveStat][94]), strcat(sctringo,stro);
    ShowDialog(playerid,1200,DIALOG_STYLE_MSGBOX,"{ff9000}Казино",sctringo,"Ок","");
    return 1;
}
