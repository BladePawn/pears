					if(DomInfo[d][dAcccupD] == 1 && PlayerInfo[playerid][pHouserent] != d) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа может только владелец и проживающие");
					if(DomInfo[d][dAcccupD] == 2 && (DomInfo[d][dFam] == 0 || DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[d][dFam])) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа может только владелец и семья");
					if(DomInfo[d][dAcccupD] == 3 && (DomInfo[d][dFam] == 0 || DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[d][dFam]) && PlayerInfo[playerid][pHouserent] != d) return ErrorMessage(playerid, "{FF6347}Выбрасывать предметы из шкафа может только владелец, проживающие и семья");
				}
				if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят ремонтом или настройкой объекта");
				if(thingType == 4 && DomInfo[d][dInv][inva] == 1000) return ErrorMessage(playerid, "{FF6347}Этот предмет мебели кто-то устанавливает"), i_resettabs(playerid);

				if(PlayerInfo[playerid][pSex] == 1)format(string, sizeof(string), "[ Мысли ]: Я выбросил из дома {FF6347}%s",GetNameThing(0, fpick, thingType, thingPack));
				else format(string, sizeof(string), "[ Мысли ]: Я выбросила из дома {FF6347}%s",GetNameThing(0, fpick, thingType, thingPack));
    			SendClientMessage(playerid, COLOR_GREY, string);
    			format(string, sizeof(string), "выбрасывает [ %s ]",GetNameThing(0, fpick, thingType, thingPack));
			    SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,7000);
    			d_del(playerid, d, inva);
				OnlineInfo[playerid][oInventSelectRight] = 9999;
				PlayerPlaySound(playerid,31200,0,0,0);
				Veshi[playerid] = 0;

				format(string, sizeof(string), "Выбросил %s", GetNameThing(1, fpick, thingType, thingPack));
				HouseLog(0, "wb", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], d, thingQuan, string);
			}
