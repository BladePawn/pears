// Аксессуары
stock IsAAkses(playerid)
{
 	if((IsPlayerInRangeOfPoint(playerid,1.0,207.6112,-100.3266,1005.2578) || IsPlayerInRangeOfPoint(playerid,1.0,204.3615,-159.3508,1000.5234)
	|| IsPlayerInRangeOfPoint(playerid,1.0,207.0857,-129.1776,1003.5078) || IsPlayerInRangeOfPoint(playerid,1.0,203.8450,-43.2612,1001.8047)
	|| IsPlayerInRangeOfPoint(playerid,1.0,206.4356,-8.1493,1001.2109) || IsPlayerInRangeOfPoint(playerid,1.0,161.4233,-83.4750,1001.8047))
	&& GetPlayerVirtualWorld(playerid) >= 173 && GetPlayerVirtualWorld(playerid) <= 182) // Магаз одежды
    {
		return 1;
	}
	return 0;
}
stock akses(playerid)
{
	if(GetPlayerVirtualWorld(playerid) >= 173 && GetPlayerVirtualWorld(playerid) <= 182) // Магаз одежды
    {
    	if(gSkafandr[playerid] > 0 || gFormavvs[playerid] > 0) return SendClientMessage(playerid,COLOR_GREY, "[ Мысли ]: Я сейчас в особой форме");
		if(howstun(playerid) || HealthAC[playerid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне плохо");
		Bid[playerid] = GetPlayerVirtualWorld(playerid);
		ShowDialog(playerid,1081,DIALOG_STYLE_MSGBOX,"{ff9000}Аксессуары","{cccccc}Вы уверены, что хотите {ff9000}выбрать аксессуары?","Да","Нет");
	}
	return 1;
}
