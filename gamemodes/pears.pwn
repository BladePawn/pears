stock buyinferm(playerid)
{
	new str[64],sctring[384];
	format(str,sizeof(str),"{cccccc}Купить предметы на ферме \t "), strcat(sctring,str);
	//format(str,sizeof(str),"\n{ff9000}Удобрение \t {99ff66}%d$", friskPrice[106]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Бычья Кровь \t {99ff66}%d$", friskPrice[107]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Банан \t {99ff66}%d$", friskPrice[99]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Яблоко \t {99ff66}%d$", friskPrice[100]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ff9000}Апельсин \t {99ff66}%d$", friskPrice[101]), strcat(sctring,str);
	ShowDialog(playerid,1162,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Ферма",sctring,"Выбор","Отмена");
	return 1;
}

stock opencontact(playerid, c)
{
	if(c >= MAX_FRIENDS) return 0;
	if(ContactInfo[playerid][cFriend][c] == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Этот контакт пустой [ Ошибка ]"), pc_cmd_contacts(playerid);
	new str[76], sctring[304];
	format(str,sizeof(str),"{cccccc}Контакт: %s | ID: %d", ContactName[playerid][c], ContactInfo[playerid][cFriend][c]), strcat(sctring,str);
	format(str,sizeof(str),"\n{ffcc00}Написать Сообщение"), strcat(sctring,str);
	format(str,sizeof(str),"\n{99ff66}Позвонить"), strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Переименовать"), strcat(sctring,str);
	format(str,sizeof(str),"\n{FF6347}Удалить из Контактов"), strcat(sctring,str);
	ShowDialog(playerid,1112,DIALOG_STYLE_TABLIST_HEADERS,"{ff9000}Мои Контакты",sctring,"Выбрать","Назад");
	return 1;
}
stock getcreateterm(b, term, &Float:X, &Float:Y, &Float:Z, &Float:A)
{
	if(b <= 0 || b >= MAX_BIZ || term < 0 || term >= MAX_TERMINAL_BIZ) return 0;
    new br = numnrent(b);
    new Float:ObX, Float:ObY, Float:ObZ, Float:ObROZ;
	ObX = RentPos_X[br][term], ObY = RentPos_Y[br][term], ObZ = RentPos_Z[br][term];
    ObROZ = RentPos_RZ[br][term];
    
	ObROZ += 90.0;
	ObX += 6.0*floatsin(-ObROZ,degrees);
 	ObY += 6.0*floatcos(-ObROZ,degrees);
	X = ObX, Y = ObY, Z = ObZ+1.0, A = ObROZ;
	return 1;
}
