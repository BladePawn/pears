{
	if(CamInfo[cam][cStat] >= 1)
	{
		new str[100],sctring[700];
		new tyear, tmonth, tday, thour, tminute, tsecond;
		stamp2datetime(CamInfo[cam][cDate], tyear, tmonth, tday, thour, tminute, tsecond, 3);
	 	format(str,sizeof(str),"\n\n{444444}Камера [ {ff9000}%s {444444}]",CamInfo[cam][cName]), strcat(sctring,str);
	 	format(str,sizeof(str),"\n\n{cccccc}Установил: %s",CamInfo[cam][cVlad]), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Дата и Время установки: [ %02d.%02d.%d %02d:%02d ]", tday, tmonth, tyear, thour, tminute), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Виртуальный Мир: %d", CamInfo[cam][cWorld]), strcat(sctring,str);
	 	format(str,sizeof(str),"\n{cccccc}Интерьер: %d\n\n", CamInfo[cam][cInterior]), strcat(sctring,str);
		ShowDialog(playerid,955,DIALOG_STYLE_MSGBOX,"{444444}Камеры Слежения",sctring,"*","");
	}
	return 1;
}

stock infoorg(playerid, g)
{
	new str[100],sctring[1000];
 	format(str,sizeof(str),"%s",frakName[g]), strcat(sctring,str);
	new glave_str[MAX_BIGINT_LEN];
	bigint_get_str(OrganInfo[g][glave], glave_str);
 	format(str,sizeof(str),"\n\n{cccccc}Счет: {99ff66}%s$ {cccccc}[%s]", glave_str, get_k(OrganInfo[g][glave])), strcat(sctring,str);
	if(IsAMafiaID(g)) {
		format(str, sizeof(str), "\n{cccccc}Офшорный счет: {99ff66}%d$ {cccccc}[%s]", OrganInfo[g][goffshore], get_k(OrganInfo[g][goffshore])), strcat(sctring, str);
		format(str, sizeof(str), "\n{cccccc}Монеты Континенталь: {ff4500}%d {cccccc}[%s]", GetFractionContinentalCoins(g), get_k(GetFractionContinentalCoins(g))), strcat(sctring, str);
	}
 	if(g == 5 || g == 6 || g == 10 || g == 12 || g == 18)
	{
		new kolvo;
        for(new bizik = 0; bizik < sizeof(BizzInfo); bizik++){if(BizzInfo[bizik][bMafia] == g) kolvo ++; }
		format(str, sizeof(str),"\n{cccccc}Бизнесов: {99ff66}%d {ff9000}[ %d %% от дохода ]",kolvo, MAFIA_BABKI), strcat(sctring,str);
 	}
  	else if(g == 13 || g == 14 || g == 15 || g == 16 || g == 17 || g == 19 || g == 20)
	{
		new kolvo, ourGraffity, theirGraffity;
		new precentGraffity = (ServerInfo[43] * GRAFFITY_PRECENT) / 100;

        for(new z = 0; z < GZONES; z++)
		{
			if(GZInfo[z][gFrakVlad] == g) 
			{
				kolvo ++;
				if(GraphitiInfo[z][graphitiStatus] == 1 && GraphitiInfo[z][graphitiOrg] != g) theirGraffity ++;
			}
			if(GraphitiInfo[z][graphitiStatus] == 1 && GraphitiInfo[z][graphitiOrg] == g) ourGraffity ++;
		}
		format(str, sizeof(str),"\n{cccccc}Территорий: {ff9000}%d / %d {cccccc}[ Одна территория {99ff66}%d$ {cccccc}в час ]",kolvo, GZONES, ServerInfo[43]), strcat(sctring,str);
		format(str, sizeof(str),"\n{cccccc}Граффити: {ff9000}%d {cccccc}[ Одно граффити {99ff66}%d$ {cccccc}в час ]", ourGraffity, precentGraffity), strcat(sctring,str);
		format(str, sizeof(str),"\n{cccccc}Чужие Граффити: {666666}%d {cccccc}[ Одно граффити {FF6347}-%d$ {cccccc}в час ]", theirGraffity, precentGraffity), strcat(sctring,str);
		format(str, sizeof(str),"\n{666666}- Ваши граффити начисляют %d процентов дохода от территории", GRAFFITY_PRECENT), strcat(sctring,str);
		format(str, sizeof(str),"\n{666666}- Чужие граффити на ваших территориях отнимают %d процентов", GRAFFITY_PRECENT), strcat(sctring,str);

		format(str, sizeof(str),"\n\n{cccccc}%s: {0088ff}%d U", unitName[5], OrganInfo[g][gUnit][5]), strcat(sctring,str);
		format(str, sizeof(str),"\n{cccccc}%s: {0088ff}%d U", unitName[6] ,OrganInfo[g][gUnit][6]), strcat(sctring,str);
		format(str, sizeof(str),"\n{cccccc}%s: {0088ff}%d U {cccccc}за единицу припасов", unitName[0], OrganInfo[g][gUnit][0]), strcat(sctring,str);
	}
	ShowDialog(playerid,706,DIALOG_STYLE_MSGBOX,"{ff9000}Организация",sctring,"*","");
	return 1;
}
stock infoguard(playerid, g, guard)
{
	new str[100],sctring[700], string[64];
 	format(str,sizeof(str),"\n\n{444444}Пост %s {ff9000}№ %d", frakName[g], guard+1), strcat(sctring,str);
 	if(OrganInfo[g][gGuOccup][guard] >= 1)
	{
 		format(str,sizeof(str),"\n{99ff66}Находится под охраной\n\n"), strcat(sctring,str);
 		foreach(Player,i)
		{
		    if(OnlineInfo[i][oLogged] == 1 && GuardOrg[i] == g && Guard[i] >= 1 && Guard[i]-1 == guard)
		    {
		        new minf = GuardTime[i]/60;
		        new sekf = GuardTime[i]-minf*60;
		    	format(str,sizeof(str),"{cccccc}%s[%d] [%02d:%02d на посту]\n",PlayerInfo[i][pName],i,minf,sekf), strcat(sctring,str);
		    }
		}
 	}
 	else format(str,sizeof(str),"\n{FF6347}Не находится под охраной\n\n"), strcat(sctring,str);
 	format(str,sizeof(str),"\n\n"), strcat(sctring,str);
 	format(string,sizeof(string),"{ff9000}Пост Наблюдения {cccccc}№%d",guard+1);
	ShowDialog(playerid,984,DIALOG_STYLE_MSGBOX,string,sctring,"Ок","");
	return 1;
}
stock ShowStats(playerid,targetid)
{
    if(IsOnline(playerid) && IsOnline(targetid))
	{
		new g = fraction(targetid), r = PlayerInfo[targetid][pRank];
		new gz = g;

		new married[24];
		strmid(married, PlayerInfo[targetid][pMarriedTo], 0, strlen(PlayerInfo[targetid][pMarriedTo]));
		new nxtlevel = PlayerInfo[targetid][pLevel]+1;
		new expamount = nxtlevel*4;
		new year, month,day, unixtime = gettime(), tmphour, tmpminute, tmpsecond;
        getdate(year, month, day);
        gettime(tmphour, tmpminute, tmpsecond);
        new playerip[24];
		GetPlayerIp(targetid, playerip, sizeof(playerip));
        if (PlayerInfo[playerid][pSoska] >= 0)
		{
			new str[188],sctring[2900];
			format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n");
			strcat(sctring,str);
			if(PlayerInfo[targetid][pMedia] >= 1) format(str,sizeof(str),"{0088ff}Аккаунт № {ffffff}%d | {ff6699}Media [%d]\n",PlayerInfo[targetid][pID],PlayerInfo[targetid][pMedia]), strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Аккаунт № {ffffff}%d\n",PlayerInfo[targetid][pID]), strcat(sctring,str);
			if(PlayerInfo[targetid][pDjpears] >= 1) format(str,sizeof(str),"{0088ff}Radio DJ: {ffffff}%d\n",PlayerInfo[targetid][pDjpears]), strcat(sctring,str);
			new vip = GetPlayerVip(targetid);
			if(vip == 0) format(str,sizeof(str),"{0088ff}VIP: {444444}нет [ Y >> Донат или /donate ]\n"), strcat(sctring,str);
			else if(vip == 1 || vip == 2)
			{
				new days, hour, minute, second;
				getunix(PlayerInfo[targetid][pUpgrade]-unixtime, days, hour, minute, second);
				format(str,sizeof(str),"{ffcc00}VIP: {ffffff}Осталось %02d дней, %02d часов, %02d минут\n", days, hour, minute), strcat(sctring,str);
			}
			else if(vip == 3 || vip == 4) format(str,sizeof(str),"{7474da}Platinum VIP\n"), strcat(sctring,str);
			format(str,sizeof(str),"{ffcc00}Gold: {ff9000}%dG\n",PlayerInfo[targetid][pDonateMoney]), strcat(sctring,str);
			if(PlayerInfo[targetid][pX2exp] >= 1)
			{
				format(str,sizeof(str),"{0088ff}Уровень: {ffffff}%d   {0088ff}|   Опыт: {ffffff}%d/%d   {ff9000}X2 Exp {cccccc}Осталось: %d\n",PlayerInfo[targetid][pLevel],PlayerInfo[targetid][pExp],expamount, PlayerInfo[targetid][pX2exp]), strcat(sctring,str);
			}
			else
			{
				format(str,sizeof(str),"{0088ff}Уровень: {ffffff}%d   {0088ff}|   Опыт: {ffffff}%d/%d \n",PlayerInfo[targetid][pLevel],PlayerInfo[targetid][pExp],expamount), strcat(sctring,str);
			}
			format(str,sizeof(str),"{0088ff}Часов в игре: {ffffff}%d \n",PlayerInfo[targetid][pConnectTime]); // Обновлено
			strcat(sctring,str);

			{
				new w_day, w_hour, w_minute, w_second;
				getunix(PlayerInfo[targetid][pWarnClearTime] - unixtime, w_day, w_hour, w_minute, w_second);
				
				new remains[100];
				format(remains, sizeof(remains), "%d %s %d %s %d %s", 
					w_day, PluralToText(w_day, "день", "дня", "дней"),
					w_hour, PluralToText(w_hour, "час", "часа", "часов"),
					w_minute, PluralToText(w_minute, "минута", "минуты", "минуту")
				);

				if(PlayerInfo[targetid][pWarns] >= 1 && PlayerInfo[targetid][pWarns] < MAX_WARNS - 1) format(str,sizeof(str),"{0088ff}Warn: {ffffff}%d/%d {cccccc}[ Снимется через %s ] \n",PlayerInfo[targetid][pWarns], MAX_WARNS, remains), strcat(sctring,str);
				if(PlayerInfo[targetid][pWarns] >= MAX_WARNS - 1) format(str,sizeof(str),"{0088ff}Warn: {ff0000}%d/%d {cccccc}[ Снимется через %s ]\n",PlayerInfo[targetid][pWarns], MAX_WARNS, remains), strcat(sctring,str);
			}

			{
				new zz_time[144];
				if (PlayerInfo[targetid][pGunWarnsZZTime] > unixtime)
				{
					new w_day, w_hour, w_minute, w_second;
					getunix(PlayerInfo[targetid][pGunWarnsZZTime] - unixtime, w_day, w_hour, w_minute, w_second);
					
					new remains[100];
					format(remains, sizeof(remains), "%d %s %d %s %d %s", 
						w_day, PluralToText(w_day, "день", "дня", "дней"),
						w_hour, PluralToText(w_hour, "час", "часа", "часов"),
						w_minute, PluralToText(w_minute, "минута", "минуты", "минут")
					);

					format(zz_time, sizeof(zz_time), "{cccccc}[ Время ограничения: %s ]", remains);
				}

				if(PlayerInfo[targetid][pGunWarns] >= 1 && PlayerInfo[targetid][pGunWarns] < MAX_GUN_WARNS - 1) format(str,sizeof(str),"{0088ff}GunWarn: {ffffff}%d/%d %s\n",PlayerInfo[targetid][pGunWarns], MAX_GUN_WARNS, zz_time), strcat(sctring,str);
				if(PlayerInfo[targetid][pGunWarns] >= MAX_GUN_WARNS - 1) format(str,sizeof(str),"{0088ff}GunWarn: {ff0000}%d/%d %s\n",PlayerInfo[targetid][pGunWarns], MAX_GUN_WARNS, zz_time), strcat(sctring,str);
			}
			
			if(PlayerInfo[targetid][pBanMonzz] >= 1 && PlayerInfo[targetid][pBanMonzz] <= 3)
			{
			  format(str,sizeof(str),"{0088ff}Кол-во банов: {ffffff}%d/5 \n",PlayerInfo[targetid][pBanMonzz]); // Обновлено
			  strcat(sctring,str);
	        }
	        if(PlayerInfo[targetid][pBanMonzz] >= 4)
			{
			  format(str,sizeof(str),"{0088ff}Кол-во банов: {ff0000}%d/5 {cccccc}[ Следующий BAN удалит аккаунт /donate ]\n",PlayerInfo[targetid][pBanMonzz]); // Обновлено
			  strcat(sctring,str);
	        }
			if(PlayerInfo[targetid][pRepaa] >= 0) format(str,sizeof(str),"{0088ff}Репутация: {33CCFF}%d{cccccc} [ /rep ]\n",PlayerInfo[targetid][pRepaa]), strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Репутация: {FF6347}%d{cccccc} [ /rep ]\n",PlayerInfo[targetid][pRepaa]), strcat(sctring,str);
			if(PlayerInfo[targetid][pDrugPerk] >= 1) format(str,sizeof(str),"{0088ff}Номер Телефона: {ffffff}%d {cccccc}[ Баланс: %d$ ]\n",PlayerInfo[targetid][pDrugPerk],PlayerInfo[targetid][pTraderPerk]), strcat(sctring,str);
			if(PlayerInfo[targetid][pExpert] >= 1) format(str,sizeof(str),"{66ffcc}Эксперт: {cccccc}[ Рейтинг: %d | Обращений: %d ]\n",PlayerInfo[targetid][pAmmos6],PlayerInfo[targetid][pQuestion]), strcat(sctring,str);
			new Days = getdate();
			if(PlayerInfo[targetid][pGameDay] == Days)
			{
				new thour = PlayerInfo[targetid][pGameTime]/3600;
				new vremh = thour*3600;
				new vremmin = PlayerInfo[targetid][pGameTime]-vremh;
				new tmin = vremmin/60;
				new tsek = vremmin-tmin*60;
				new ahour = PlayerInfo[targetid][pGameAfk]/3600;
				new avremh = ahour*3600;
				new avremmin = PlayerInfo[targetid][pGameAfk]-avremh;
				new amin = avremmin/60;
				new asek = avremmin-amin*60;
				format(str,sizeof(str),"{0088ff}Online Сегодня: {cccccc}%02d:%02d {444444}%02d сек. {0088ff}| AFK: {cccccc}%02d:%02d {444444}%02d сек.\n",thour,tmin,tsek,ahour,amin,asek), strcat(sctring,str);
			}
			else format(str,sizeof(str),"{0088ff}Online Сегодня: {cccccc}00:00 {444444}00 сек. {0088ff}| AFK: {cccccc}00:00 {444444}00 сек.\n"), strcat(sctring,str);
			format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n");
			strcat(sctring,str);
			format(str,sizeof(str),"{0088ff}Семейное положение: {ffffff}%s \n",married); // Обновлено
			strcat(sctring,str);

			if(PlayerInfo[targetid][pFamily]!=0)
			{
				format(str,sizeof(str),"\n{0088ff}%s: {ffffff}№ %d %s", famTypeName[FamilyInfo[PlayerInfo[targetid][pFamily]][fType]],PlayerInfo[targetid][pFamily],FamilyInfo[PlayerInfo[targetid][pFamily]][fName]), strcat(sctring,str);
				format(str,sizeof(str),"\n{0088ff}Ранг: {ffffff}%d\n",PlayerInfo[targetid][pFamrank]), strcat(sctring,str);
			}

			if(g > 0)
			{
			  	format(str,sizeof(str),"\n{0088ff}Организация: {ffffff}%s\n",orgName[gz]), strcat(sctring,str);
			  
				if(gz == 8) format(str,sizeof(str),"{0088ff}Ранг: {ffffff}%s [%d] {950000}%s\n",getNameRank(targetid),r,PlayerInfo[targetid][pCallSign]), strcat(sctring,str);
				else format(str,sizeof(str),"{0088ff}Ранг: {ffffff}%s [%d]\n",getNameRank(targetid),r), strcat(sctring,str);

				if(PlayerInfo[targetid][pLeader] >= 1)
				{
						if(PlayerInfo[targetid][pSoska] == 0)
						{
							if(PlayerInfo[targetid][pReproof] >= 2) format(str,sizeof(str),"{0088ff}Reproof: {ff0000}%d/3 {cccccc}[ Следующее предупреждение = выговор ]\n",PlayerInfo[targetid][pReproof]), strcat(sctring,str);
							else format(str,sizeof(str),"{0088ff}Reproof: {ffffff}%d/3\n",PlayerInfo[targetid][pReproof]), strcat(sctring,str);
						}
						if(PlayerInfo[targetid][pVig] <= 3) format(str,sizeof(str),"{0088ff}Лид. Выговоры: {ffffff}%d/5 \n",PlayerInfo[targetid][pVig]), strcat(sctring,str);
						else if(PlayerInfo[targetid][pVig]>=4) format(str,sizeof(str),"{0088ff}Лид. Выговоры: {ff0000}%d/5 {cccccc}[ Следующий выговор снимет с лидерки ]\n",PlayerInfo[targetid][pVig]),strcat(sctring,str);
						if(PlayerInfo[targetid][pSoska] == 0)
						{
							format(str,sizeof(str),"{0088ff}Point: {ffffff}%d {0088ff}| Score: {ffffff}%d\n",PlayerInfo[targetid][pAdmPoint],PlayerInfo[targetid][pAdmScore]), strcat(sctring,str);
						}
				}
				else
				{
						if(PlayerInfo[targetid][pVig] <= 3) format(str,sizeof(str),"{0088ff}Выговоры: {ffffff}%d/5 \n",PlayerInfo[targetid][pVig]), strcat(sctring,str);
						else if(PlayerInfo[targetid][pVig]>=4) format(str,sizeof(str),"{0088ff}Выговоры: {ff0000}%d/5 {cccccc}[ Следующий выговор уволит из организации ]\n",PlayerInfo[targetid][pVig]),strcat(sctring,str);
				}
				format(str,sizeof(str),"{0088ff}Юниты: {9900ff}%d {cccccc}[%s]\n",PlayerInfo[targetid][pUnit],get_k(PlayerInfo[targetid][pUnit])), strcat(sctring,str);
				if(IsAMafiaID(fraction(targetid))) format(str,sizeof(str),"{0088ff}Монеты Континенталь: {ff4500}%d {cccccc}[%s]\n", GetPlayerContinentalCoins(targetid), get_k(GetPlayerContinentalCoins(targetid))), strcat(sctring,str);

				if(PlayerInfo[targetid][pDivision][0] > 0) 
				{
					new i = PlayerInfo[targetid][pDivision][0] - 1;
					format(str,sizeof(str),"\n{0088ff}Подфракция: {ffffff}%s [%d]\n",DivisionInfo[g-1][i][divName], i + 1), strcat(sctring,str);
					format(str,sizeof(str),"{0088ff}Ранг: {ffffff}%d\n", PlayerInfo[targetid][pDivRank][0]), strcat(sctring,str);
				}
	        }
	        
			format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n"), strcat(sctring,str);
			
			if(oGetPlayerMoney(targetid) >= 0) format(str,sizeof(str),"{0088ff}Наличные: {99ff66}%d$ {cccccc}[%s]\n",oGetPlayerMoney(targetid),get_k(oGetPlayerMoney(targetid))), strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Наличные: {FF6347}%d$ {cccccc}[%s]\n",oGetPlayerMoney(targetid),get_k(oGetPlayerMoney(targetid))), strcat(sctring,str);
			if(PlayerInfo[targetid][pAccount] >= 0) format(str,sizeof(str),"{0088ff}Банковский Счёт: {99ff66}%d$ {cccccc}[%s]\n",PlayerInfo[targetid][pAccount],get_k(PlayerInfo[targetid][pAccount])),strcat(sctring,str);
			else format(str,sizeof(str),"{0088ff}Банковский Счёт: {FF6347}%d$ {cccccc}[%s]\n",PlayerInfo[targetid][pAccount],get_k(PlayerInfo[targetid][pAccount])),strcat(sctring,str);
			
			format(str,sizeof(str),"{0088ff}Фишек в Казино: {ffffff}%dF | {ffcc00}Gold %dF\n",PlayerInfo[targetid][pAmmos1], PlayerInfo[targetid][pAmmos8]); // Обновлено
			strcat(sctring,str);
	        if(PlayerInfo[targetid][pDom]!=0)
            {
			  format(str,sizeof(str),"{0088ff}Дом №: {ffffff}%d\n",PlayerInfo[targetid][pDom]); // Обновлено
			  strcat(sctring,str);
	        }
			if(PlayerInfo[targetid][pTrailer]!=0) format(str,sizeof(str),"{0088ff}Трейлер №: {ffffff}%d\n",PlayerInfo[targetid][pTrailer]), strcat(sctring,str);

	        if(PlayerInfo[targetid][pBusiness] > 0) format(str,sizeof(str),"{0088ff}Бизнес: {ffffff}%s [%d]\n",bizname(PlayerInfo[targetid][pBusiness]),PlayerInfo[targetid][pBusiness]), strcat(sctring,str);
	        if(PlayerInfo[targetid][pCrimes] >= 1)
            {
			  format(str,sizeof(str),"{0088ff}Уровень Розыска: {ff9000}%d\n",PlayerInfo[targetid][pCrimes]); // Обновлено
			  strcat(sctring,str);
	        }
   			if(PlayerInfo[playerid][pSoska] >= 1)
            {
              format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n");
	  		  strcat(sctring,str);
			  format(str,sizeof(str),"{0088ff}IP: {ffffff}[ %s ] \n",playerip), strcat(sctring,str);
			  if(PlayerInfo[targetid][pSoska] >= 1)
  			  {
  			  		format(str,sizeof(str),"{0088ff}Рейтинг Администратора: {ffffff}%d\n",PlayerInfo[targetid][pAmmos6]), strcat(sctring,str);
					format(str,sizeof(str),"{0088ff}Point: {ffffff}%d {0088ff}| Score: {ffffff}%d\n",PlayerInfo[targetid][pAdmPoint],PlayerInfo[targetid][pAdmScore]), strcat(sctring,str);
					format(str,sizeof(str),"{0088ff}Предупреждения ADM: {ffffff}[Reproof %d/3] [ADM Warn %d/6]\n",PlayerInfo[targetid][pReproof],PlayerInfo[targetid][pAdmWarns]), strcat(sctring,str);
	          		format(str,sizeof(str),"{0088ff}Уровень ADM: {ffffff}%d \n",PlayerInfo[targetid][pSoska]), strcat(sctring,str);
  			  }
			  new boot_vehicleid = GetPVarInt(targetid, "Boot");
			  if(boot_vehicleid > 0)
			  {
			  	format(str,sizeof(str),"{0088ff}В багажнике: {ffffff}Авто ID: {ff9000}%d\n", boot_vehicleid); // Обновлено
			  	strcat(sctring,str);
	  		  }
     		  if(PlayerInfo[targetid][pGoogle] >= 1) format(str,sizeof(str),"{0088ff}Google Authenticator: {ffffff}установлен \n"), strcat(sctring,str); // Обновлено
          	  else format(str,sizeof(str),"{0088ff}Google Authenticator: {ff6347}не установлен \n"), strcat(sctring,str); // Обновлено
			  format(str,sizeof(str),"{0088ff}GPCI: {ffffff}%s \n",PlayerInfo[targetid][pGpci]), strcat(sctring,str);
			  if(!strcmp(PlayerInfo[targetid][pMail],"\0",true)) format(str,sizeof(str),"{0088ff}Email: {ffffff}не установлен \n"), strcat(sctring,str);
			  else
			  {
			    if(PlayerInfo[playerid][pMailStat] == 0) format(str,sizeof(str),"{0088ff}Email: {ffffff}%s \n",PlayerInfo[targetid][pMail]), strcat(sctring,str);
			    else format(str,sizeof(str),"{0088ff}Email: {FF6347}%s [ не подтверждён ]\n",PlayerInfo[targetid][pMail]), strcat(sctring,str);
	  		  }
			  if(PlayerInfo[targetid][pRegData] >= 1)
			  {
			      new tyear, tmonth, tday, thour, tminute, tsecond;
				  stamp2datetime(PlayerInfo[targetid][pRegData], tyear, tmonth, tday, thour, tminute, tsecond, 3);
			      format(str,sizeof(str),"{0088ff}Регистрация: {444444}[ %02d.%02d.%d %02d:%02d ] \n", tday, tmonth, tyear, thour, tminute), strcat(sctring,str);
			  }
			  else format(str,sizeof(str),"{0088ff}Регистрация: {444444}[ нет данных ] \n"), strcat(sctring,str);
			  if(GetPVarInt(targetid,"afksystem") >= 3)
			  {
			    format(str,sizeof(str),"{0088ff}AFK: {ffffff}%d сек.\n",GetPVarInt(targetid,"afksystem")); // Обновлено
			    strcat(sctring,str);
			  }
			  if(PlayerInfo[targetid][pAData] < gettime()) format(str,sizeof(str),"{0088ff}Статус Игрока: {FF6347}Неактивный [%d/10] \n",PlayerInfo[targetid][pAbandoned]), strcat(sctring,str);
	  		  else format(str,sizeof(str),"{0088ff}Статус Игрока: {99ff66}Активный\n"), strcat(sctring,str);

			  if(IsPlayerSyncModels(targetid)) format(str,sizeof(str),"{0088ff}Модпак: {99ff66}Установлен\n"), strcat(sctring,str);
			  else format(str,sizeof(str),"{0088ff}Модпак: {FF6347}Не установлен\n"), strcat(sctring,str);
            }
            format(str,sizeof(str),"{ffcc66}__________________________________________________________________________________________\n\n");
			strcat(sctring,str);
	        new lol[128];
	        format(lol,sizeof(lol),"{ffffff}%s[%d] {ff9000}%02d:%02d %02d.%02d.%d",PlayerInfo[targetid][pName],targetid,tmphour, tmpminute,day,month,year);
	        ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,lol,sctring,"*","");
		}
	}
	return 1;
}
stock put_dom_fromboot(playerid, v, dom, fpick, kolko, inva)
{
    i_resetveshi(playerid);
	i_resettabs(playerid);

	if(OnlineInfo[playerid][oShowInterface] != 1 || OnlineInfo[playerid][oShowTabs] == 9999 || Tabs_Load[playerid] != 5) return 1;
	new fpara = VehInfo[v][vInvPara][inva], fqara = VehInfo[v][vInvQara][inva], thingType = VehInfo[v][vInvType][inva], thingPack = VehInfo[v][vInvPack][inva];
	if(fpick == 0 || v == INVALID_VEHICLE_ID) return 1;
	
	if(DomInfo[dom][dIngar] == 0) return ErrorMessage(playerid, "{FF6347}В этом доме не установлен гараж");
	if(!IsVehicleInRangeOfPoint(v, 10.0, DomInfo[dom][dGarageX], DomInfo[dom][dGarageY], DomInfo[dom][dGarageZ])) return ErrorMessage(playerid, "{FF6347}Транспорт далеко от гаража дома");
	if(thingPack == 2 || thingPack == 3 || thingPack == 4) return ErrorMessage(playerid, "{FF6347}Мешок или ящик нельзя перекладывать в дом\n\nРаспкакуйте предмет на базе вашей организации");

	new string[120];
    // Проверка на лимиты количественного предмета
	if(thingType == 0) // Обычный предмет
	{
	    if(CheckThingQuan(fpick) == 1) // Предмет имеет количество
		{
		    new getQuan, getLimit;
		    d_limit(dom, fpick, getQuan, getLimit);
		    if(getQuan+kolko > getLimit) return format(string,sizeof(string),"{FF6347}В доме нет места\n\nЛимит для этого предмета: %d", getLimit), ErrorMessage(playerid, string);
		}
		if (fpick == 35) return ErrorMessage(playerid, "{FF6347}Этот предмет нельзя переложить в дом"); // Человек
	}
	
	new put_inva = PutThingDom(dom, fpick, kolko, fpara, fqara, thingType, thingPack, 999);
	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}В доме нет места");
	
	PlayerPlaySound(playerid,1053,0,0,0);
	format(string, sizeof(string), "* %s перекладывает из багажника в дом %s.", playername(playerid), GetNameThing(0, fpick, thingType, thingPack));
	ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	TakeBoot(v, fpick, kolko, thingType, inva);
	
	format(string,sizeof(string),"Положил в дом %d: %s", dom, GetNameThing(1, fpick, thingType, thingPack));
	UserLog("wb", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", kolko, string);
	format(string, sizeof(string), "Положил %s", GetNameThing(1, fpick, thingType, thingPack));
	HouseLog(0, "wb", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], dom, kolko, string);
	return 1;
}
stock put_boot_fromdom(playerid, dom, veh, fpick, kolko, inva)
{
    i_resetveshi(playerid);
    i_resettabs(playerid);
	if(GetPlayerInterior(playerid) == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете перекладывать предметы в доме на улице"), i_resettabs(playerid);
	new fpara = DomInfo[dom][dInvPara][inva], fqara = DomInfo[dom][dInvQara][inva], thingType = DomInfo[dom][dInvType][inva], thingPack = DomInfo[dom][dInvPack][inva];
	if(thingType == 4 && DomInfo[dom][dInv][inva] == 1000) return ErrorMessage(playerid, "{FF6347}Этот предмет мебели кто-то устанавливает");

	new string[120];
    // Проверка на лимиты количественного предмета
	if(thingType == 0) // Обычный предмет
	{
	    if(CheckThingQuan(fpick) == 1) // Предмет имеет количество
		{
		    new getQuan, getLimit;
		    v_limit(veh, fpick, getQuan, getLimit);
		    if(getQuan+kolko > getLimit) return format(string,sizeof(string),"{FF6347}В багажнике нет места\n\nЛимит для этого предмета: %d", getLimit), ErrorMessage(playerid, string);
		}
	}
	
	new put_inva = PutThingBoot(veh, fpick, kolko, fpara, fqara, thingType, thingPack, 999);
	if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}В багажнике нет места");

	PlayerPlaySound(playerid,1053,0,0,0);
	TakeDom(dom, fpick, kolko, thingType, inva);

	format(string, sizeof(string), "Взял %s", GetNameThing(1, fpick, thingType, thingPack));
	HouseLog(0, "wb", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], dom, kolko, string);
	return 1;
}
stock put_biz_fromboot(playerid, v, biz, fpick, kolko, inva)
{
    i_resetveshi(playerid);
	i_resettabs(playerid);
	
	if(OnlineInfo[playerid][oShowInterface] != 1 || OnlineInfo[playerid][oShowTabs] == 9999 || Tabs_Load[playerid] != 5) return 1;
    new fpara = VehInfo[v][vInvPara][inva], fqara = VehInfo[v][vInvQara][inva], thingType = VehInfo[v][vInvType][inva], thingPack = VehInfo[v][vInvPack][inva];
    if(fpick == 0 || v == INVALID_VEHICLE_ID) return 1;

	if(!IsVehicleInRangeOfPoint(v, 10.0, BizzInfo[biz][bX], BizzInfo[biz][bY], BizzInfo[biz][bZ])) return ErrorMessage(playerid, "{FF6347}Транспорт далеко от бизнеса");
	if(thingPack > 0) return ErrorMessage(playerid, "{FF6347}Запакованый предмет нельзя перекладывать в бизнес\n\nРаспкакуйте предмет на базе вашей организации");

	if(thingType == 4)
	{
		new put_inva = PutThingBiz(biz, fpick, kolko, fpara, fqara, 4, 999);
		if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}На складе бизнеса нет места");
		TakeBoot(v, fpick, kolko, thingType, inva);
		
		PlayerPlaySound(playerid,1053,0,0,0);

		new string[40];
		format(string, sizeof(string), "Положил %s", GetNameThing(1, fpick, thingType, thingPack));
		BizLog("wb", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], biz, 0, string);
	}
	else ErrorMessage(playerid, "{FF6347}Этот предмет нельзя перекладывать на склад бизнеса\n\nНа склад бизнеса можно помещать только мебель");
	return 1;
}
stock put_boot_frombiz(playerid, biz, veh, fpick, kolko, inva)
{
    i_resetveshi(playerid);
	i_resettabs(playerid);

	if(BizzInfo[biz][bInvent][inva] <= 0) return 1;
	if(GetPlayerInterior(playerid) == 0) return ErrorMessage(playerid, "{FF6347}Вы не можете перекладывать предметы в бизнесе на улице"), i_resettabs(playerid);
	if((VehInfo[veh][vSost] == PlayerInfo[playerid][pID] || VehInfo[veh][vKey] == PlayerInfo[playerid][pID] && VehInfo[veh][vKeyUnix] > gettime()) && GetPlayerVip(playerid) > 0) {}
	else
	{
		if(VehInfo[veh][vCarLock] >= 1) return ErrorMessage(playerid, "{FF6347}Транспорт заперт");
	}
	if(!IsVehicleInRangeOfPoint(veh, 10.0, BizzInfo[biz][bX], BizzInfo[biz][bY], BizzInfo[biz][bZ])) return ErrorMessage(playerid, "{FF6347}Транспорт далеко от места разгрузки/загрузки [Точка бизнеса]");

	new thingType = BizzInfo[biz][bInvType][inva], thingPack = BizzInfo[biz][bInvPack][inva];
	if(thingType == 4)
	{
	    new put_inva = PutThingBoot(veh, fpick, kolko, BizzInfo[biz][bInvPara][inva], BizzInfo[biz][bInvQara][inva], thingType, thingPack, 999);
	    if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}В багажнике нет места");
	    
		PlayerPlaySound(playerid,1053,0,0,0);
		new string[40];
	    TakeThingBiz(biz, fpick, kolko, thingType, inva);
	    format(string, sizeof(string), "Взял %s", GetNameThing(1, fpick, thingType, thingPack));
		BizLog("wb", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], biz, 0, string);
	}
	else ErrorMessage(playerid, "{FF6347}Ошибка! На складе бизнеса может находиться только мебель");
	return 1;
}
stock invent_draw_settint(playerid)
{
    for(new p = 0; p < PLAINVENTDRAW_MAX; p ++) PlayerTextDrawShow(playerid, PlaInventDraw[p][playerid]); // Новые фоны и кнопки
	for(new p = 0; p < 5; p ++) PlayerTextDrawShow(playerid, PlaNestAkses[p][playerid]); // Ячейки аксессуаров
	for(new p = 0; p < 40; p ++) PlayerTextDrawShow(playerid, PlaNestPick[p][playerid]); // Ячейки
	
	PlayerTextDrawShow(playerid, PlaNestOthe[0][playerid]), PlayerTextDrawShow(playerid, PlaNestOthe[2][playerid]);
	PlayerTextDrawShow(playerid, PlaNestAct[0][playerid]), PlayerTextDrawShow(playerid, PlaNestAct[1][playerid]);
	//PlayerTextDrawShow(playerid, PlaNestPrice[playerid]);
	PlayerTextDrawShow(playerid, PlaNestNeeds[0][playerid]), PlayerTextDrawShow(playerid, PlaNestNeeds[1][playerid]), PlayerTextDrawShow(playerid, PlaNestNeeds[2][playerid]), PlayerTextDrawShow(playerid, PlaNestNeeds[3][playerid]);
	for(new p = 0; p < 6; p ++) PlayerTextDrawShow(playerid, PlaNestGun[p][playerid]);
	PlayerTextDrawShow(playerid, PlaNestTabs[0][playerid]), PlayerTextDrawShow(playerid, PlaNestTabs[1][playerid]), PlayerTextDrawShow(playerid, PlaNestTabs[2][playerid]), PlayerTextDrawShow(playerid, PlaNestTabs[3][playerid]);
	PlayerTextDrawShow(playerid, PlaNestTabs[4][playerid]);
	// PlayerTextDrawShow(playerid, PlaNestTabs[8][playerid]), PlayerTextDrawShow(playerid, PlaNestTabs[9][playerid]), PlayerTextDrawShow(playerid, PlaNestTabs[10][playerid]), PlayerTextDrawShow(playerid, PlaNestTabs[11][playerid]);
	return 1;
}
stock CloseFrisk(playerid)
{
	OnlineInfo[playerid][oShowInterface] = 0;
	for(new p = 0; p < PLAINVENTDRAW_MAX; p ++) PlayerTextDrawHide(playerid, PlaInventDraw[p][playerid]), PlayerTextDrawDestroy(playerid, PlaInventDraw[p][playerid]);
	for(new plas = 0; plas < 5; plas ++) PlayerTextDrawHide(playerid, PlaNestAkses[plas][playerid]), PlayerTextDrawDestroy(playerid, PlaNestAkses[plas][playerid]);
	for(new plapi = 0; plapi < 40; plapi ++) PlayerTextDrawHide(playerid, PlaNestPick[plapi][playerid]), PlayerTextDrawDestroy(playerid, PlaNestPick[plapi][playerid]), PlayerTextDrawHide(playerid, PlaNestPickNum[plapi][playerid]), PlayerTextDrawDestroy(playerid, PlaNestPickNum[plapi][playerid]);
	PlayerTextDrawHide(playerid, PlaNestOthe[0][playerid]), PlayerTextDrawHide(playerid, PlaNestOthe[1][playerid]), PlayerTextDrawHide(playerid, PlaNestOthe[2][playerid]);
	PlayerTextDrawDestroy(playerid, PlaNestOthe[0][playerid]), PlayerTextDrawDestroy(playerid, PlaNestOthe[1][playerid]), PlayerTextDrawDestroy(playerid, PlaNestOthe[2][playerid]);
	PlayerTextDrawHide(playerid, PlaNestAct[0][playerid]), PlayerTextDrawHide(playerid, PlaNestAct[1][playerid]);
	PlayerTextDrawDestroy(playerid, PlaNestAct[0][playerid]), PlayerTextDrawDestroy(playerid, PlaNestAct[1][playerid]);
	PlayerTextDrawHide(playerid, PlaNestPrice[playerid]), PlayerTextDrawDestroy(playerid, PlaNestPrice[playerid]);
	PlayerTextDrawHide(playerid, PlaNestNeeds[0][playerid]), PlayerTextDrawHide(playerid, PlaNestNeeds[1][playerid]), PlayerTextDrawHide(playerid, PlaNestNeeds[2][playerid]), PlayerTextDrawHide(playerid, PlaNestNeeds[3][playerid]);
	PlayerTextDrawHide(playerid, PlaNestNeeds[4][playerid]), PlayerTextDrawHide(playerid, PlaNestNeeds[5][playerid]), PlayerTextDrawHide(playerid, PlaNestNeeds[6][playerid]), PlayerTextDrawHide(playerid, PlaNestNeeds[7][playerid]);
	PlayerTextDrawDestroy(playerid, PlaNestNeeds[0][playerid]), PlayerTextDrawDestroy(playerid, PlaNestNeeds[1][playerid]), PlayerTextDrawDestroy(playerid, PlaNestNeeds[2][playerid]), PlayerTextDrawDestroy(playerid, PlaNestNeeds[3][playerid]);
	PlayerTextDrawDestroy(playerid, PlaNestNeeds[4][playerid]), PlayerTextDrawDestroy(playerid, PlaNestNeeds[5][playerid]), PlayerTextDrawDestroy(playerid, PlaNestNeeds[6][playerid]), PlayerTextDrawDestroy(playerid, PlaNestNeeds[7][playerid]);
	for(new plagun = 0; plagun < 6; plagun ++) PlayerTextDrawHide(playerid, PlaNestGun[plagun][playerid]), PlayerTextDrawDestroy(playerid, PlaNestGun[plagun][playerid]), PlayerTextDrawHide(playerid, PlaNestGunNum[plagun][playerid]), PlayerTextDrawDestroy(playerid, PlaNestGunNum[plagun][playerid]);
	for(new p = 0; p < PLANESTTABS_MAX; p ++) PlayerTextDrawHide(playerid, PlaNestTabs[p][playerid]), PlayerTextDrawDestroy(playerid, PlaNestTabs[p][playerid]);

    DrawInvent[playerid] = false;
	HidePlayerDialog(playerid);
	if(Tabs_Load[playerid] == 5) boot_close(playerid);
	if(Tabs_Load[playerid] == 10) bonet_close(playerid);
	if(Tabs_Load[playerid] == 11 || Tabs_Load[playerid] == 12 || Tabs_Load[playerid] == 13 || Tabs_Load[playerid] == 17) workbench_close(playerid);
	OnlineInfo[playerid][oShowTabs] = 9999;
	OnlineInfo[playerid][oInventSelectLeft] = 9999, Veshi[playerid] = 0, LoadPick[playerid] = 9999, LoadGun[playerid] = 9999;
	OnlineInfo[playerid][oInventSelectRight] = 9999;
	OnlineInfo[playerid][oInventSelectBackPack] = 9999;
	Backpack[playerid] = 0;
	Page[playerid] = 0, Pagetwo[playerid] = 0;
	Tabs_Type[playerid] = 0, Tabs_ID[playerid] = 0, Tabs_Load[playerid] = 0;
	if(Hold[playerid] == 4) Hold[playerid] = 0;
	
	// Возвращаем спидометр и подсказки
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    new vehicleid = GetPlayerVehicleID(playerid);
        if(VehInfo[vehicleid][vModel] != 509 && VehInfo[vehicleid][vModel] != 510 && VehInfo[vehicleid][vModel] != 481 && Cars[vehicleid] != 52)
		{
            if(PlayerInfo[playerid][pDrawVisible][7] == false && setting_pos_draw[playerid] != 8 && setting_size_draw[playerid] != 8) ShowVehSpeed(playerid);
  		}
  		if(PlayerInfo[playerid][pDrawVisible][9] == false && VehInfo[vehicleid][vEngine] == 0 && setting_pos_draw[playerid] != 10 && setting_size_draw[playerid] != 10) show_hint_player(playerid, vehicleid);
	}
	return 1;
}
stock update_power(p, quan)
{
	new yes, poew, qwer[64];
	new aks = HasABustAks(p,3);
	if(aks != -1) quan += ResultCountBustAks(PlayerInfo[p][pOdet][aks], 3,PlayerInfo[p][pOdetPara][aks]);
	if(GetPlayerVip(p) > 0) PlayerInfo[p][pBoxSkill] += quan*2, poew = quan*2;
	else PlayerInfo[p][pBoxSkill] += quan, poew = quan;
	CompleteBattlePassTask(p,26,1,quan), CompleteBattlePassTask(p,35,1,quan);
	format(qwer, sizeof(qwer), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~C…‡A: ~w~+%d",poew);
	GameTextForPlayer(p, qwer, 2000, 3);
	if(PlayerInfo[p][pBoxSkill] >= 200 && PlayerInfo[p][pBoxSkill] <= 499 && PlayerInfo[p][pPower] <= 1) yes = 1, PlayerInfo[p][pPower] = 2;
	else if(PlayerInfo[p][pBoxSkill] >= 500 && PlayerInfo[p][pBoxSkill] <= 999 && PlayerInfo[p][pPower] <= 2) yes = 1, PlayerInfo[p][pPower] = 3;
	else if(PlayerInfo[p][pBoxSkill] >= 1000 && PlayerInfo[p][pBoxSkill] <= 1999 && PlayerInfo[p][pPower] <= 3) yes = 1, PlayerInfo[p][pPower] = 4;
	else if(PlayerInfo[p][pBoxSkill] >= 2000 && PlayerInfo[p][pBoxSkill] <= 2999 && PlayerInfo[p][pPower] <= 4) yes = 1, PlayerInfo[p][pPower] = 5;
	else if(PlayerInfo[p][pBoxSkill] >= 3000 && PlayerInfo[p][pBoxSkill] <= 4999 && PlayerInfo[p][pPower] <= 5) yes = 1, PlayerInfo[p][pPower] = 6;
	else if(PlayerInfo[p][pBoxSkill] >= 5000 && PlayerInfo[p][pBoxSkill] <= 9999 && PlayerInfo[p][pPower] <= 6) yes = 1, PlayerInfo[p][pPower] = 7;
	else if(PlayerInfo[p][pBoxSkill] >= 10000 && PlayerInfo[p][pBoxSkill] <= 14999 && PlayerInfo[p][pPower] <= 7) yes = 1, PlayerInfo[p][pPower] = 8;
	else if(PlayerInfo[p][pBoxSkill] >= 15000 && PlayerInfo[p][pBoxSkill] <= 19999 && PlayerInfo[p][pPower] <= 8) yes = 1, PlayerInfo[p][pPower] = 9;
	else if(PlayerInfo[p][pBoxSkill] >= 20000 && PlayerInfo[p][pPower] <= 9) yes = 1;
 	if(yes == 1)
 	{
 	    new string[144];
 		if(OnlineInfo[p][oListenRadioPears] == 0) PlayAudioStreamForPlayer(p, "https://cdn.pears.fun/sound/upskill.mp3");
 		if(PlayerInfo[p][pBoxSkill] >= 20000 && PlayerInfo[p][pPower] <= 9)
 		{
 			PlayerInfo[p][pPower] = 10;
 			format(string, sizeof(string),"{0088ff}[ Навык ]: {99ff66}У вас максимальный навык силы! Дрыщи будут щемиться! {ff9000}[ %d ]", get_power(p));
			SendClientMessage(p, COLOR_GREY, string);
			ShowDialog(p,1012,DIALOG_STYLE_MSGBOX, "{0088ff}Навык", "{ffcc66}У вас максимальный навык силы! Дрыщи будут щемиться!\n{99ff66}Теперь можно носить большее количество предметов в инвентаре", "Ок", "");
		}
		else
		{
 			format(string, sizeof(string),"{0088ff}[ Навык ]: {ffcc66}Навык силы повышен! Теперь можно носить большее количество предметов в инвентаре {ff9000}[ %d ][ /skill ]", get_power(p));
			SendClientMessage(p, COLOR_GREY, string);
			ShowDialog(p,1012,DIALOG_STYLE_MSGBOX, "{0088ff}Навык", "{ffcc66}Навык силы повышен!\n{99ff66}Теперь можно носить большее количество предметов в инвентаре", "Ок", "");
		}
		mysql_save(p, 3);
 	}
}
stock get_power(p) // Узнаём скилл силы у игрока
{
	new pow;
	if(PlayerInfo[p][pBoxSkill] >= 200 && PlayerInfo[p][pBoxSkill] <= 499) pow = 2;
	else if(PlayerInfo[p][pBoxSkill] >= 500 && PlayerInfo[p][pBoxSkill] <= 999) pow = 3;
	else if(PlayerInfo[p][pBoxSkill] >= 1000 && PlayerInfo[p][pBoxSkill] <= 1999) pow = 4;
	else if(PlayerInfo[p][pBoxSkill] >= 2000 && PlayerInfo[p][pBoxSkill] <= 2999) pow = 5;
	else if(PlayerInfo[p][pBoxSkill] >= 3000 && PlayerInfo[p][pBoxSkill] <= 4999) pow = 6;
	else if(PlayerInfo[p][pBoxSkill] >= 5000 && PlayerInfo[p][pBoxSkill] <= 9999) pow = 7;
	else if(PlayerInfo[p][pBoxSkill] >= 10000 && PlayerInfo[p][pBoxSkill] <= 14999) pow = 8;
	else if(PlayerInfo[p][pBoxSkill] >= 15000 && PlayerInfo[p][pBoxSkill] <= 19999) pow = 9;
	else if(PlayerInfo[p][pBoxSkill] >= 20000) pow = 10;
	else pow = 1;
	return pow;
}
/*
Пляжные Коврики:
1640, 1641, 1642, 1643
*/
stock i_unpackgift(playerid, inva, thingPack) // Распаковываем подарок или шкатулку
{
	new string[600];
	if(IsACasePackID(thingPack))
	{
		// Проверяем, требуется ли ключ для открытия шкатулки
		new keyid = GetKeyIDCustomCase(GetInventoryPackCustomCase(thingPack));
		if(keyid > 0)
		{
			if(get_invent4(playerid, keyid, 0) <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет ключа, чтобы открыть эту шкатулку\n{ffcc66}Ключ от шкатулки, как правило, можно отыскать там же, где вы нашли саму шкатулку");
			TakeInvent(playerid, keyid, 1, 0, 999); // Забираем ключ
		}

		// Перезапускаем переменные портящихся продуктов
		if(PerishableThing(PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva]))
		{
			new quan, para;
			ThingParameters(playerid, PlayerInfo[playerid][pInven][inva], quan, para);
			PlayerInfo[playerid][pInvenQuan][inva] = quan;
			PlayerInfo[playerid][pInvenPara][inva] = para;
		}

		new line[214];
		format(line,sizeof(line),"{99ff66}Вы открыли шкатулку и получили: %s", GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], 0)), strcat(string,line);
		if(PlayerInfo[playerid][pInvenType][inva] == 3) format(line,sizeof(line),"\n{cccccc}Редкость: %s", GetSkinClassName(PlayerInfo[playerid][pInven][inva])), strcat(string,line);
	
		new string_log[200];
        if(PlayerInfo[playerid][pInvenType][inva] == 3) format(string_log, sizeof(string_log), "%s: %s [%d] Редк: %s", 
			GetCaseName(thingPack), GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], 0), PlayerInfo[playerid][pInvenQuan][inva], GetSkinClassName(PlayerInfo[playerid][pInven][inva]));
		else if(PlayerInfo[playerid][pInvenType][inva] == 5) format(string_log, sizeof(string_log), "%s: %s [%d] Gold: %d", 
			GetCaseName(thingPack), GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], 0), PlayerInfo[playerid][pInvenQuan][inva], GetVehiclePriceGold(PlayerInfo[playerid][pInven][inva]));
		else format(string_log, sizeof(string_log), "%s: %s [%d]", 
			GetCaseName(thingPack), GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], 0), PlayerInfo[playerid][pInvenQuan][inva]);
		
		UserLog("opencase", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", PlayerInfo[playerid][pInvenQuan][inva], string_log);
		CompleteBattlePassTask(playerid, 2, 0);
		if(thingPack == 9) CompleteBattlePassTask(playerid, 2, 2);
		if(thingPack == 18) CompleteBattlePassTask(playerid, 1, 2);
	}
	else
	{
		if(Kapt[fraction(playerid)] >= 1 || IsMafiaMember(playerid) && gMifga[playerid] != 9999) return ErrorMessage(playerid, "{FF6347}Нельзя распаковать подарок во время капта или стрел мафий");
		format(string,sizeof(string),"{99ff66}Вы распаковали подарок и получили: %s", GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], 0));
	}
	SuccessMessage(playerid, string);
	PlayerPlaySound(playerid,1139,0,0,0);
	
	new fpick = PlayerInfo[playerid][pInven][inva], fquan = PlayerInfo[playerid][pInvenQuan][inva], fpara = PlayerInfo[playerid][pInvenPara][inva], fqara = PlayerInfo[playerid][pInvenQara][inva], thingType = PlayerInfo[playerid][pInvenType][inva];
	if(thingType == 0) // Если предмет обычный
	{
		if(CheckThingQuan(fpick) == 1) // Имеет количество
		{
		    if(get_invent4(playerid, fpick, thingType) > 0) // И такой уже есть в инвентаре, то мы распаковывая перекладываем всё из подарка в ту самую ячейку инвентаря
		    {
		        i_del(playerid, inva);
		        GiveThingPlayer(playerid, fpick, fquan, fpara, fqara, thingType, 0, 9999);
		        i_resetveshi(playerid);
		        return 1; // Прерываем дальнейший код
		    }
	    }
	}
	
	// Если все предыдущее не учитывается, отображаем ячейки и снимаем упаковку
	PlayerInfo[playerid][pInvenPack][inva] = 0; // Снимаем упаковку
    i_resetveshi(playerid);
	if(OnlineInfo[playerid][oShowInterface] == 1) i_tile(playerid, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenQuan][inva], inva, PlayerInfo[playerid][pInvenPara][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]);
	return 1;
}
stock b_del(p, i, cell)
{
	if(IsABackPack(BizzInfo[i][bInvent][cell]) && BizzInfo[i][bInvQara][cell] != 0) DeleteBackPack(BizzInfo[i][bInvQara][cell]);
	BizzInfo[i][bInvent][cell] = 0;
	BizzInfo[i][bInv][cell] = 0;
	BizzInfo[i][bInvPara][cell] = 0;
	BizzInfo[i][bInvQara][cell] = 0;
	BizzInfo[i][bInvType][cell] = 0;
	BizzInfo[i][bInvPack][cell] = 0;
	item_second(p, 0, 0, cell, 0, 0, 0, 0, 0);
	SaveSkladBiz(i, cell);
}
stock d_del(p, i, cell)
{
	if(IsABackPack(DomInfo[i][dInvent][cell]) && DomInfo[i][dInvQara][cell] != 0) DeleteBackPack(DomInfo[i][dInvQara][cell]);
	if(DomInfo[i][dInvType][cell] == 6 && DomInfo[i][dInvPara][cell] != 0) DeletePet(DomInfo[i][dInvPara][cell]);
	DomInfo[i][dInvent][cell] = 0;
	DomInfo[i][dInv][cell] = 0;
	DomInfo[i][dInvPara][cell] = 0;
	DomInfo[i][dInvQara][cell] = 0;
	DomInfo[i][dInvType][cell] = 0;
	DomInfo[i][dInvPack][cell] = 0;
	item_second(p, 0, 0, cell, 0, 0, 0, 0, 00);
	SaveOneTainik(i, cell);
}
stock i_takehands(playerid, item)
{
	/*
	Убираем любой предмет из рук
	Это фиксит баг с перекладыванием предмета в рюкзак, когда он в руках
	Но, это может создать непредвиденные приколы, о которых я не могу предположить
	Мы продолжаем следить за событиями, оставайтесь с нами
	*/
	if(Hold[playerid] == item)
    {
        Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0, HoldQuan[playerid] = 0, HoldInva[playerid] = 0, HoldPara[playerid] = 0, HoldQara[playerid] = 0;
        RemovePlayerAttachedObject(playerid,1);

		// Офаем текстдраы подсказку, че кликать когда предмет в руке (если только мы не сидим на стуле)
		if(SitPlayer[playerid] == 0) TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
    }

    if(item == 3)
	{
		if(Dei[playerid] == 1003) RemovePlayerAttachedObject(playerid, 1), Dei[playerid] = 0;
	}
 	if(item == 9)
	{
	    if(Dei[playerid] == 8) RemovePlayerAttachedObject(playerid, 1), Dei[playerid] = 0;
 	}
	if(item == 10) RemovePlayerAttachedObject(playerid, 9);
	if(item == 26)
	{
		pc_cmd_hangup(playerid);
		if(OnlineInfo[playerid][oShowInterface] == 2) CloseSmartfon(playerid), CancelSelectTextDraw(playerid);
	}
	if(item == 32)
	{
		if(Hold[playerid] == 1) RemovePlayerAttachedObject(playerid,1), RemovePlayerAttachedObject(playerid,2), Hold[playerid] = 0;
	}
	if(item == 38 || item == 122)
	{
		if(Hold[playerid] == 2) RemovePlayerAttachedObject(playerid,1), Hold[playerid] = 0;
	}
	if(item == 39) // Подарочная Упаковка
	{
		if(Hold[playerid] == 4) Hold[playerid] = 0;
	}
	if(item == 42) // Ноутбук
	{
		if(Hold[playerid] == 11)
		{
		    if(Komputer[playerid] == 1 || Komputer[playerid] == 2) closecomp(playerid), CancelSelectTextDraw(playerid);
			Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0;
			RemovePlayerAttachedObject(playerid,1); PPP15[playerid] = 0;
			if(!IsPlayerInAnyVehicle(playerid) && NoAnim[playerid] == 0) ClearAnimations(playerid), ClearAnim(playerid);
		}
	}
	if(item == 43 || item == 44 || item == 31 || item == 90) // Электрошокер, Лопата, Удочка, Монтировка
	{
		if(Hold[playerid] == 5 || Hold[playerid] == 6 || Hold[playerid] == 7) RemovePlayerAttachedObject(playerid,1), Hold[playerid] = 0;
	}
	if(item == 45)
	{
		if(Dei[playerid] == 3) Close_Seamap(playerid);
	}
	if(item == 203)
	{
		if(Dei[playerid] == 203) Close_Huntmap(playerid);
	}
	if(item == 50)
	{
		if(GetPVarInt(playerid,"Arobsklad") == 9) SetPVarInt(playerid,"Arobsklad",0), SetPVarInt(playerid,"oryjtemp",0);
	}
	if(item == 61)
	{
	    if(Dei[playerid] == 12) RemovePlayerAttachedObject(playerid, 1), Dei[playerid] = 0;
 	}
	if(item == 62) SetPVarInt(playerid,"PlayBoy",0);
	if(item == 91)
	{
	    if(Riches[playerid] > 0)
		{
			Riches[playerid] = 0;
			if(object_stat[playerid] == 1) DestroyDynamicObject(player_object[playerid]), object_stat[playerid] = 0;
		}
 	}
 	if(item == 97)
	{
	    if(Hold[playerid] == 14)
	    {
 			Hold[playerid] = 0, HoldFrisk[playerid] = 0, HoldStat[playerid] = 0, HoldQuan[playerid] = 0, HoldInva[playerid] = 0, HoldPara[playerid] = 0, HoldQara[playerid] = 0;
 			RemovePlayerAttachedObject(playerid,1);
		}
 	}
 	if(item == 88 || item == 106 || item == 108 || item == 109 || item == 110)
	{
		if(Dei[playerid] == item) RemovePlayerAttachedObject(playerid, 1), Dei[playerid] = 0;
	}
	if(item == 14 || item == 37 || item >= 112 && item <= 121 || item >= 124 && item <= 139 || item == 167 || item == 141 || item == 172 || item == 173 || item == 261 || item == 262) stopdrink(playerid), PlayerPlaySound(playerid,5601,0,0,0), RemovePlayerAttachedObject(playerid,1); 
	if(item >= 145 && item <= 155)
	{
	    if(Ash[playerid] == item-144 && AshTime[playerid] > 0) Ash[playerid] = 0, AshTime[playerid] = 0, ErrorMessage(playerid, "{FF6347}Вы лишились учебника и прервали обучение");
	}
	if(item == 163 || item == 164 || item == 165 || item == 166 || item == 167)
	{
	    Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0, HoldPara[playerid] = 0, HoldQara[playerid] = 0, HoldQuan[playerid] = 0;
		RemovePlayerAttachedObject(playerid,1), PPP15[playerid] = 0;
		if(SitPlayer[playerid] == 0) TextDrawHideForPlayer(playerid, MindDraw[3]), PlayerTextDrawHide(playerid, HintButton);
	}
	if(item == 197) // Баллончик с краской в руке
	{
		if(Hold[playerid] == item) RemovePlayerAttachedObject(playerid, 1), Hold[playerid] = 0;
	}
	if(item == 262 || (item >= 280 && item <= 283)) // Предметы для петов
	{
		if(Hold[playerid] == item) RemovePlayerAttachedObject(playerid, 1), Hold[playerid] = 0, HoldStat[playerid] = 0, HoldFrisk[playerid] = 0, HoldPara[playerid] = 0, HoldQara[playerid] = 0, HoldQuan[playerid] = 0;
	}
}
stock wear(playerid, fpick, inva)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerSpeed(playerid) > 3 || MPGO[playerid] > 0 || gSkafandr[playerid] > 0 || gFormavvs[playerid] > 0
	|| GetPVarInt(playerid,"gantel") >= 1 || GetPVarInt(playerid,"sport") >= 1 || Sleep[playerid] >= 1 || SleepRP[playerid] >= 1
	|| CnnVed[playerid] >= 11 || Ash[playerid] >= 1 || GetPlayerVirtualWorld(playerid) == 2001 || GetPVarInt(playerid, "SelectCharPlace") >= 1
	|| HospBed[playerid] >= 0 && HospBed[playerid] <= 25) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не может сейчас переодеться");
	
   	if(Piss[playerid] >= 1 || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вашего персонажа заняты руки");
   	if(!isnaked(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж уже в одежде");
   	
	new skin = fpick;
	if (PlayerInfo[playerid][pSoska] < 1) {
		if(GetSkinSex(skin) == 2 && PlayerInfo[playerid][pSex] == 1) return ErrorMessage(playerid, "{FF6347}Ваш персонаж мужчина и он не может использовать женскую одежду");
		else if(GetSkinSex(skin) == 1 && PlayerInfo[playerid][pSex] == 2) return ErrorMessage(playerid, "{FF6347}Ваш персонаж женщина и она не может использовать мужскую одежду");
	}
	
	if(PlayerInfo[playerid][pMember] != 8 && PlayerInfo[playerid][pLeader] != 8 && PlayerInfo[playerid][pMember] != 2 && PlayerInfo[playerid][pLeader] != 2
 	&& PlayerInfo[playerid][pMember] != 18 && PlayerInfo[playerid][pLeader] != 18)
	{
		if(PlayerInfo[playerid][pInvenPara][inva] > 0 && PlayerInfo[playerid][pInvenPara][inva] < 40 && PlayerInfo[playerid][pInvenPara][inva] != fraction(playerid)) return ErrorMessage(playerid, "{FF6347}Нельзя носить одежду этой организации");
	}
	PlayerPlaySound(playerid,5600,0,0,0);
	PlayerInfo[playerid][pModel] = skin;
	PlayerInfo[playerid][pModel2] = PlayerInfo[playerid][pInvenPara][inva];
	PlayerInfo[playerid][pModel3] = PlayerInfo[playerid][pInvenQara][inva];

	m_custom_sync_SetPlayerSkin(playerid, PlayerInfo[playerid][pModel]);

	if(PlayerInfo[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"надел одежду",COLOR_PURPLE,20.0,5000);
	else SetPlayerChatBubble(playerid,"надела одежду",COLOR_PURPLE,20.0,5000);
	if(OnlineInfo[playerid][oShowInterface] == 1) PlayerTextDrawSetPreviewModel(playerid, PlaNestOthe[0][playerid], GetModelSkin(playerid, PlayerInfo[playerid][pModel])), PlayerTextDrawShow(playerid, PlaNestOthe[0][playerid]);
	i_del(playerid, inva, false);
	ApplyAnimation(playerid,"PED","Turn_R",4.0, false, true, true, false, false);

	mysql_save(playerid, 75);
	return 1;
}
stock comeback_item(playerid, inva)
{
	new giveplayerid = -1;
    foreach(Player, i)
	{
		if(PlayerInfo[i][pID] == PlayerInfo[playerid][pInvenQara][inva])
		{
			giveplayerid = i;
			break;
		}
	}
	if(giveplayerid >= 0)
	{
		if(OnlineInfo[giveplayerid][oLogged] == 0) return ErrorMessage(playerid, "{FF6347}Игрок в сети, но не залогинился [ Пожалуйста дождитесь его авторизации, во избежание ошибок ]"), i_resetveshi(playerid);
		new put_inven = GiveThingPlayer(giveplayerid, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenQuan][inva], PlayerInfo[playerid][pInvenPara][inva], 0, PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva], 9999);
		
		new string[140];
		if(put_inven == -1)
		{
			format(string,sizeof(string),"{FF6347}Владелец найден, но в его инвентаре нет места: %s[%d]\n{cccccc}Свяжитесь с ним и выполните возврат украденного предмета", PlayerInfo[giveplayerid][pName], giveplayerid);
			ErrorMessage(playerid, string), i_resetveshi(playerid);
			return 1;
		}
		
  		new g = fraction(playerid);
    	if(PlayerInfo[playerid][pFbi] >= 1) g = 2;
		OrgLog(g, "comeback", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pInvenQuan][inva], GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]));
		format(string, sizeof(string), "Возвращён украденный предмет: %s", GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]));
	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], string);
	    if(PlayerInfo[giveplayerid][pDrawVisible][2] == false) PlayerTextDrawShow(giveplayerid, PlayerSiteDraw[2][giveplayerid]);
	    PlayerPlaySound(giveplayerid,6401,0,0,0);
	    del_comeback(playerid, inva, g, PlayerInfo[giveplayerid][pName]);
	    if(PlayerInfo[playerid][pAchieve][98] == 0) AchievePlayer(playerid, 98, 1);
	}
	else
	{
	    ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff9000}Возвращение","{cccccc}Ищем владельца предмета..","*","");
		new string_mysql[240];
	    mysql_format(pearsq, string_mysql,sizeof(string_mysql),"SELECT pp_igroki.Name, pp_igroki_inventory.* \
			FROM pp_igroki \
			INNER JOIN pp_igroki_inventory ON pp_igroki_inventory.user_id = pp_igroki.user_id \
			WHERE pp_igroki.user_id = %d", PlayerInfo[playerid][pInvenQara][inva]);
		mysql_tquery(pearsq, string_mysql, "Call_combackitem", "dd", playerid, inva);
	}
	return 1;
}
function Call_combackitem(playerid, inva)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datadid, putinven, quan;
	    cache_get_value_name(0, "Name", ListName[playerid], 24);
	    cache_get_value_name_int(0, "user_id", datadid);
        for(new i = 0; i < MAX_INVEN; i++)
		{
		    List[i][playerid] = 0;
			new bool:is_null, string_slot[20];
			format(string_slot, sizeof(string_slot), "i_slot_%d", i);
			cache_is_value_name_null(0, string_slot, is_null);

			if(is_null == true)
			{
				putinven = i;
				break;
			}
			else quan ++;
  		}

		new string[160];
		if(quan >= MAX_INVEN)
		{
			format(string,sizeof(string),"{FF6347}Владелец найден, но в его инвентаре нет места: %s\n{cccccc}Игрок Offline, попробуйте с ним связаться с помощью SMS /sms Nick_Name", ListName[playerid]);
			ErrorMessage(playerid, string), i_resetveshi(playerid);
			SendClientMessage(playerid, -1, "[ Мысли ]: Владелец предмета %s: %s", GetNameThing(0, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]), ListName[playerid]);
			return 1;
		}
		if(datadid != PlayerInfo[playerid][pInvenQara][inva]) return ErrorMessage(playerid, "{FF6347}Ошибка! Возвращаемый предмет был перемещён в вашем инвентаре"), i_resetveshi(playerid);
		
		new JsonNode:node;
		CreateJsonInvent(playerid, inva, node); // Собираем node для сохранения
		SaveInventByUserID(datadid, putinven, node); // Сохраняем игроку

        new g = fraction(playerid);
    	if(PlayerInfo[playerid][pFbi] >= 1) g = 2;
		OrgLog(g, "comeback", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, ListName[playerid], "", PlayerInfo[playerid][pInvenQuan][inva], GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]));
		format(string, sizeof(string), "Возвращён украденный предмет: {ff9000}%s", GetNameThing(1, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]));
	    notify(PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], datadid, ListName[playerid], string);
	    del_comeback(playerid, inva, g, ListName[playerid]);
	    if(PlayerInfo[playerid][pAchieve][98] == 0) AchievePlayer(playerid, 98, 1);
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт владельца не найден, возможно он был удалён [ Предмет очищен из розыска, вы можете оставить его себе ]"), PlayerInfo[playerid][pInvenQara][inva] = 0, i_resetveshi(playerid);
	return 1;
}
stock del_comeback(playerid, inva, g, const tmp[])
{
	new string[80];
    format(string,sizeof(string),"{99ff66}Вы вернули украденный предмет владельцу: %s", tmp);
	SuccessMessage(playerid, string);
    i_del(playerid, inva);
	ApplyAnimation(playerid,"CASINO","Roulette_win",4.0, false, true, true, false, false);
	SetPlayerChatBubble(playerid,"возвращает украденный предмет",COLOR_PURPLE,20.0,3000);
    PlayerPlaySound(playerid,6401,0,0,0);

	GivePlayerUnit(playerid, OrganInfo[g][gUnit][4]);
	return 1;
}
stock put_inventgun(playerid, weapon, ammo)
{
	if(PlayerInfo[playerid][pBeret] >= 1) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас убрать оружие [ Временное лишение ]");
	if(MPGO[playerid] != 0) return ErrorMessage(playerid, "{FF6347}Вы на мероприятии");
	new weaponType = WeaponAmmoType(weapon);
	if(weapon >= 1 && weapon <= 15 || weaponType > 0)
	{
		new sl = Protect_Slot(weapon);
		if(ProtectInfo[playerid][prWeapon][sl] >= 1 && ProtectInfo[playerid][prAmmo][sl] >= 1)
		{
			if(weapon == 34) return ErrorMessage(playerid, "{FF6347}Вы не можете передать или убрать снайперскую винтовку");
			if(weapon == 9) return ErrorMessage(playerid, "{FF6347}Вы не можете передать или убрать бензопилу");
			if(ProtectInfo[playerid][prAmmo][sl] < ammo) return ErrorMessage(playerid, "{FF6347}У вас нет такого количества патронов");
			
			// Кладём оружие, которое не имеет патронов
			if(weapon >= 1 && weapon <= 15)
			{
				new put_inva = GiveThingPlayer(playerid, weapon, 1, 0, ProtectInfo[playerid][prQet][sl], 1, 0, 9999);
    			if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}У вас нет места в инвентаре"); // Получили -1 в ответ, значит не нашли ячейку, куда класть предмет
    			
				Protect_Remove(playerid, weapon);
				UpdateGun(playerid);
				PlayerPlaySound(playerid, 36401, 0,0,0);
				if(LoadGun[playerid] != 9999) reset_gun_tile(playerid);
				return 1;
			}
			
			new fitem;
			if(weaponType == 1) fitem = 27; // Дробовик (Ammo 20,8mm)
			else if(weaponType == 2 || weaponType == 3) fitem = 28; // Пистолет (Ammo 11,43mm)
			else if(weaponType == 4) fitem = 29; // Автомат (Ammo 5,45mm)
			else if(weaponType == 5) fitem = 30; // Винтовка (Ammo 45mm)
			
			new getQuan, getLimit;
		    i_limit(playerid, fitem, getQuan, getLimit);

			new string[150];
		    if(getQuan+ammo > getLimit) return format(string,sizeof(string),"{FF6347}У вас нет места в инвентаре\nЛимит для патронов: %d\n\n{cccccc}Предметы учитываются из раздела торговли и упаковок с подарками и рюкзаков", getLimit), ErrorMessage(playerid, string);
			if(check_invent_free(playerid) <= 1) return ErrorMessage(playerid, "{FF6347}В инвентаре не хватает места [ Требуется 2 слота: Оружие и патроны ]");
			
			GiveThingPlayer(playerid, fitem, ammo, 0, 0, 0, 0, 9999); // Кладём патроны
			if(ProtectInfo[playerid][prAmmo][sl]-ammo <= 0) GiveThingPlayer(playerid, weapon, 1, ProtectInfo[playerid][prDet][sl], ProtectInfo[playerid][prQet][sl], 1, 0, 9999); // Кладём оружие
			Protect_GiveWeapons(playerid, weapon, -ammo, 0, -1);
			UpdateGun(playerid);
			PlayerPlaySound(playerid, 36401, 0,0,0);
			if(LoadGun[playerid] != 9999) reset_gun_tile(playerid);
		}
	}
	return 1;
}
stock reset_gun_tile(playerid)
{
	new inva = LoadGun[playerid];
	LoadGun[playerid] = 9999;
	PlayerTextDrawBackgroundColour(playerid, PlaNestGun[inva][playerid], PlayerInfo[playerid][pStyle2]);
	PlayerTextDrawShow(playerid, PlaNestGun[inva][playerid]);
	return 1;
}
stock gun_tile(playerid, inva)
{
	if(OnlineInfo[playerid][oLogged] == 0) return 1;
	if(Veshi[playerid] >= 1) return 0;
	new slot;
	if(inva == 0) slot = 1;
	else if(inva == 1) slot = 4;
	else if(inva == 2) slot = 2;
	else if(inva == 3) slot = 3;
	else if(inva == 4) slot = 5;
	else if(inva == 5) slot = 6;
	PlayerPlaySound(playerid,17803,0,0,0);
	if(LoadPick[playerid] != 9999) return reset_aksess_tile(playerid);
	if(OnlineInfo[playerid][oInventSelectLeft] != 9999) return i_resetveshi(playerid);
	if(OnlineInfo[playerid][oInventSelectRight] != 9999) return i_resettabs(playerid);
	if(LoadGun[playerid] == inva)
	{
		if(PlayerInfo[playerid][pBeret] >= 1) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас убрать оружие [ Временное лишение ]");
		if(ProtectInfo[playerid][prAmmo][slot] <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет оружия в этом слоте");
		new gunid = ProtectInfo[playerid][prWeapon][slot];
		if(gunid == 23) return ErrorMessage(playerid, "{FF6347}Нельзя убрать электрошокер");
		else if(gunid == 38) return ErrorMessage(playerid, "{FF6347}Нельзя убрать миниган");
		else if(gunid == 41) return ErrorMessage(playerid, "{FF6347}Нельзя убрать баллончик");
		else if(gunid == 42) return ErrorMessage(playerid, "{FF6347}Нельзя убрать огнетушитель");
		else if(gunid == 43) return ErrorMessage(playerid, "{FF6347}Нельзя убрать фотоаппарат");
		else if(gunid == 46) return ErrorMessage(playerid, "{FF6347}Нельзя убрать парашют");
		else if(gunid >= 2 && gunid <= 15) put_inventgun(playerid, gunid, 1);
		else
		{
			if(ProtectInfo[playerid][prAmmo][slot] <= 0) return ErrorMessage(playerid, "{FF6347}У вас нет оружия в этом слоте");
			else if(ProtectInfo[playerid][prAmmo][slot] >= 9998) return SendClientMessage(playerid, COLOR_GREY, "Ошибка! [ Code: 3008 ]");
			else if(ProtectInfo[playerid][prAmmo][slot] == 1) return put_inventgun(playerid, gunid, 1);
			else if(ProtectInfo[playerid][prAmmo][slot] >= 2)
			{
    			DP[0][playerid] = gunid;
    			new string[144];
				format(string,sizeof(string),"{cccccc}Чтобы положить {ff9000}%s в инвентарь {cccccc}введите количество\n\nНе меньше 1 и не больше 1000",gunName[gunid]);
				ShowDialog(playerid,902,DIALOG_STYLE_INPUT,"{ff9000}Инвентарь",string,"Принять","Отмена");
			}
		}
	}
	if(LoadGun[playerid] != 9999 && LoadGun[playerid] != inva) reset_gun_tile(playerid); // Если до этого плитка была выбрана - отрубаем её
	if(ProtectInfo[playerid][prWeapon][slot] >= 1 && ProtectInfo[playerid][prAmmo][slot] >= 1 && LoadGun[playerid] != inva)
	{
		PlayerTextDrawBackgroundColour(playerid, PlaNestGun[inva][playerid], PlayerInfo[playerid][pStyle3]);
		LoadGun[playerid] = inva;
		PlayerTextDrawShow(playerid, PlaNestGun[inva][playerid]);
		return 1;
	}
	return 1;
}
stock reset_aksess_tile(playerid)
{
	new inva = LoadPick[playerid];
	LoadPick[playerid] = 9999;
 	PlayerTextDrawBackgroundColour(playerid, PlaNestAkses[inva][playerid], PlayerInfo[playerid][pStyle2]);
	PlayerTextDrawShow(playerid, PlaNestAkses[inva][playerid]);
	PlayerTextDrawHide(playerid, PlaInventDraw[11][playerid]);
	return 1;
}
stock aksess_tile(playerid, inva)
{
	if(OnlineInfo[playerid][oLogged] == 0) return 1;
	if(Veshi[playerid] >= 1) return 0;
 	PlayerPlaySound(playerid,17803,0,0,0);
 	if(OnlineInfo[playerid][oInventSelectLeft] != 9999) return i_resetveshi(playerid);
 	if(LoadGun[playerid] != 9999) return reset_gun_tile(playerid);
 	if(OnlineInfo[playerid][oInventSelectRight] != 9999) return i_resettabs(playerid);
	if(LoadPick[playerid] == inva)
	{
		if(IsABackPack(PlayerInfo[playerid][pOdet][inva]) && Backpack[playerid] == 1) return ErrorMessage(playerid, "{FF6347}Вы не можете убрать аксессуар в инвентарь [ Вы используете рюкзак ]");
		if(PlayerInfo[playerid][pOdet][inva] >= 1)
	 	{
	 		if(CheckInvent(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете убрать аксессуар в инвентарь [ Нет места ]");
	 		RemoveAksess(playerid, inva);
	 		reset_aksess_tile(playerid);
 		}
	}
	if(LoadPick[playerid] != 9999 && LoadPick[playerid] != inva) reset_aksess_tile(playerid); // Если до этого плитка была выбрана - отрубаем её
	if(PlayerInfo[playerid][pOdet][inva] >= 1 && LoadPick[playerid] != inva)
	{
		PlayerTextDrawBackgroundColour(playerid, PlaNestAkses[inva][playerid], PlayerInfo[playerid][pStyle3]);
		LoadPick[playerid] = inva;
		PlayerTextDrawShow(playerid, PlaNestAkses[inva][playerid]);
		PlayerTextDrawShow(playerid, PlaInventDraw[11][playerid]);
		return 1;
	}
	return 1;
}
stock tilesklad(playerid, pick, kol, inva, thingType)
{
	inva = inva+20;
	PlayerTextDrawFont(playerid, PlaNestPick[inva][playerid], TEXT_DRAW_FONT:4);
	PlayerTextDrawBackgroundColour(playerid, PlaNestPick[inva][playerid], PlayerInfo[playerid][pStyle1]);
	PlayerTextDrawColour(playerid, PlaNestPick[inva][playerid], PlayerInfo[playerid][pStyle1]);
 	PlayerTextDrawShow(playerid, PlaNestPick[inva][playerid]);
 	PlayerTextDrawHide(playerid, PlaNestPick[inva][playerid]);
 	PlayerTextDrawHide(playerid, PlaNestPickNum[inva][playerid]);
	if(pick >= 1)
	{
		PlayerTextDrawBackgroundColour(playerid, PlaNestPick[inva][playerid], PlayerInfo[playerid][pStyle1]);
		PlayerTextDrawColour(playerid, PlaNestPick[inva][playerid], -1);
		PlayerTextDrawBoxColour(playerid, PlaNestPick[inva][playerid], 0);
		PlayerTextDrawFont(playerid, PlaNestPick[inva][playerid], TEXT_DRAW_FONT:5);
		
		new modelId;
		if(thingType == 0) modelId = friskPick[pick]; // Обычные предметы
		else if(thingType == 1) modelId = friskGun[pick]; // Оружие
	 	else if(thingType == 2) modelId = pick; // Аксессуары

		new Float:modelPos[4], findIt;
		GetModelTextDraw(modelId, thingType,0, modelPos[0], modelPos[1], modelPos[2], modelPos[3], findIt);
		PlayerTextDrawSetPreviewModel(playerid, PlaNestPick[inva][playerid], modelId);
		PlayerTextDrawSetPreviewRot(playerid, PlaNestPick[inva][playerid], modelPos[0], modelPos[1], modelPos[2], modelPos[3]);
		
		if(kol >= 1)
		{
			new string[24];
			format(string, sizeof(string), "%d", kol);
			PlayerTextDrawSetString(playerid, PlaNestPickNum[inva][playerid], string);
			if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlaNestPickNum[inva][playerid], 673720575);
			else PlayerTextDrawColour(playerid, PlaNestPickNum[inva][playerid], -1);
			PlayerTextDrawShow(playerid, PlaNestPickNum[inva][playerid]);
		}
	}
	PlayerTextDrawShow(playerid, PlaNestPick[inva][playerid]);
	return 1;
}
stock showsklad(playerid, wh)
{
	if(CnnVed[playerid] >= 11 || OnlineInfo[playerid][oShowInterface] != 1 || MenuInfo[playerid][zStat] == 1 || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;

	if(wh != fraction(playerid)) return ErrorMessage(playerid, "{FF6347}У вас нет доступа к этому складу");
	if(OrganInfo[wh][gWarehouse] == true) return ErrorMessage(playerid, "{FF6347}Склад закрыт");
	OnlineInfo[playerid][oShowTabs] = wh;
	i_tabs(playerid, 4, 1);
   	for(new inva = 0; inva < 20; inva++) tilesklad(playerid, OrganInfo[wh][gInvent][inva], OrganInfo[wh][gInv][inva], inva, OrganInfo[wh][gInvType][inva]);
	return 1;
}
stock showrent(playerid, wh)
{
	if(OnlineInfo[playerid][oShowInterface] != 1) return 1;
	if(WhInfo[wh][wStat] <= 0) return ErrorMessage(playerid, "{FF6347}Этот склад никем не арендован");
	new string[144], g = fraction(playerid);
	if(WhInfo[wh][wStat] != g) return format(string, sizeof(string), "{FF6347}Этот склад принадлежит %s", frakName[WhInfo[wh][wStat]]), ErrorMessage(playerid, string);
	if(!GetAccessRankOrg(playerid, g, 21, NO_FBI)) return 1;
	PlayerPlaySound(playerid,40405,0,0,0);
	OnlineInfo[playerid][oShowTabs] = wh;
	i_tabs(playerid, 4, 1);
   	for(new inva = 0; inva < 20; inva++) tilesklad(playerid, WhInfo[wh][wInvent][inva], WhInfo[wh][wInv][inva], inva, WhInfo[wh][wInvType][inva]);
	return 1;
}
stock closetab(playerid, stat)
{
	if(Tabs_Load[playerid] > 0)
	{
		if(Tabs_Load[playerid] == 6) i_tabs(playerid, 2, 0); // MyGoods
		else if(Tabs_Load[playerid] == 7) i_tabs(playerid, 3, 0); // Throw
		else i_tabs(playerid, 4, 0);

		if(Tabs_Load[playerid] == 1 || Tabs_Load[playerid] == 6) PlayerTextDrawHide(playerid, PlaNestPrice[playerid]);
		if(Tabs_Load[playerid] == 2 || Tabs_Load[playerid] == 9) 
		{
			PlayerTextDrawHide(playerid, PlaNestTabs[8][playerid]);
			PlayerTextDrawHide(playerid, PlaNestTabs[9][playerid]);
			PlayerTextDrawHide(playerid, PlaNestTabs[10][playerid]);
			PlayerTextDrawHide(playerid, PlaNestTabs[11][playerid]);
			PlayerTextDrawHide(playerid, PlaNestAct[0][playerid]); // Иконка авто
		}
		if(Tabs_Load[playerid] == 5) boot_close(playerid);
		if(Tabs_Load[playerid] == 10) bonet_close(playerid);
		if(Tabs_Load[playerid] == 11 || Tabs_Load[playerid] == 12 || Tabs_Load[playerid] == 13 || Tabs_Load[playerid] == 17) workbench_close(playerid);

		Tabs_Load[playerid] = 0;
		for(new inva = 20; inva < 40; inva++) PlayerTextDrawHide(playerid, PlaNestPick[inva][playerid]), PlayerTextDrawHide(playerid, PlaNestPickNum[inva][playerid]);

		OnlineInfo[playerid][oShowTabs] = 9999;
		if(stat == 1) 
		{
			Tabs_Type[playerid] = 0;
			PlayerTextDrawHide(playerid, PlaNestTabs[4][playerid]);
			PlayerTextDrawHide(playerid, PlaNestTabs[7][playerid]);
			PlayerPlaySound(playerid,4203,0,0,0);
			UpdateInventTwoBlock(playerid, 0, 0);
		}
	}
    return 1;
}
stock close_interaction(playerid)
{
	Moiactor[playerid] = 9999;
	Moiplayer[playerid] = 9999;
	PlayerTextDrawHide(playerid, PlaInter[0][playerid]);
	PlayerTextDrawHide(playerid, PlaInter[1][playerid]);
	PlayerTextDrawHide(playerid, PlaInter[2][playerid]);
	PlayerTextDrawHide(playerid, PlaInter[3][playerid]);
	PlayerTextDrawHide(playerid, PlaInter[4][playerid]);
	HidePlayerDialog(playerid);
	return 1;
}
stock show_interaction(p, t)
{
 	Moiplayer[p] = t;
	PlayerTextDrawShow(p, PlaInter[0][p]);
	PlayerTextDrawShow(p, PlaInter[1][p]);
	PlayerTextDrawShow(p, PlaInter[2][p]);
	PlayerTextDrawSetPreviewModel(p, PlaInter[4][p], GetSkinPresentation(p, t)), PlayerTextDrawShow(p, PlaInter[4][p]);
	new string[24];
	if(!NameTag[t]) format(string, sizeof(string), "%s", playername(t));
	else
	{
		if(PlayerInfo[p][pDrawLanguage] == false && Device[p] != 1) format(string, sizeof(string), RusToGame("Неизвестно"));
		else format(string, sizeof(string), "Unknown");
	}
	PlayerTextDrawSetString(p, PlaInter[3][p], string);
	PlayerTextDrawShow(p, PlaInter[3][p]);
	PlayerPlaySound(p,40405,0,0,0);
   	new str[100],sctring[900], quan;
   	if(getillness(p, 18) >= 0 && getillness(t, 18) <= 0)
 	{
 	    List[quan][p] = 1, quan ++;
 		format(str,sizeof(str),"{6600cc}Выпить Кровь\n"), strcat(sctring,str);
	}
	if(IsPoliceMember(p) || PlayerInfo[p][pFbi] >= 1 || PlayerInfo[p][pSoska] >= 1)
	{
 	    List[quan][p] = 2, quan ++;
 		format(str,sizeof(str),"{0066ff}Отнять предметы\n"), strcat(sctring,str);
	}
	if(IsPoliceMember(p) || PlayerInfo[p][pFbi] >= 1 || PlayerInfo[p][pMember] == 7 && (PlayerInfo[p][pRank] == 4 || PlayerInfo[p][pRank] == 5 || PlayerInfo[p][pRank] == 6)
	|| PlayerInfo[p][pSoska] >= 1)
	{
	    List[quan][p] = 3, quan ++;
 		format(str,sizeof(str),"{0066ff}Обыскать\n"), strcat(sctring,str);
		List[quan][p] = 6, quan ++;
 		if(Stun[4][t] == 0) format(str,sizeof(str),"{0066ff}Заковать в наручники\n"), strcat(sctring,str);
		else format(str,sizeof(str),"{0066ff}Снять наручники\n"), strcat(sctring,str);
		List[quan][p] = 7, quan ++;
 		format(str,sizeof(str),"{0066ff}Вести за собой\n"), strcat(sctring,str);
	}
	if(DeathInfo[t][deathStatus] == true && FamilyInfo[PlayerInfo[p][pFamily]][fType] == 3)
	{
		List[quan][p] = 4, quan ++;
 		format(str,sizeof(str),"{0066ff}Съесть органы\n"), strcat(sctring,str);
	}
	if(DeathInfo[t][deathStatus] == true && get_invent4(p,8,0) > 0)
	{
		List[quan][p] = 5, quan ++;
 		format(str,sizeof(str),"{99ff66}Реанимировать [ Поднять игрока ]\n"), strcat(sctring,str);
	}
	if(DeathInfo[t][deathStatus] == true && ProtectInfo[p][prWeapon][1] == 4)
	{
		List[quan][p] = 8, quan ++;
 		format(str,sizeof(str),"{99ff66}Добить умирающего \n"), strcat(sctring,str);
	}
	if(computerClubPlayerInfo[t][ccpiInGame] == true && PlayerInfo[t][pCrimes] > 0 && IsPoliceMember(p))
	{
		List[quan][p] = 9;//, quan ++;
 		format(str,sizeof(str),"{99ff66}Вытащить игрока из комп.клуба \n"), strcat(sctring,str);
	}
	if(GetPlayerLoadPet(p) > 0)
	{
		List[quan][p] = 10, quan++;
 		format(str,sizeof(str),"{99ff66}Приказать питомцу атакавать игрока\n"), strcat(sctring,str);
		List[quan][p] = 11;// quan++;
 		format(str,sizeof(str),"{99ff66}Приказать питомцу обнюхать игрока\n"), strcat(sctring,str);
	}
	ShowDialog(p,1165,DIALOG_STYLE_TABLIST,"{ff9000}Действия",sctring,"Выбор","Отмена");
	return 1;
}
stock i_akses(playerid, sl)
{
	if(PlayerInfo[playerid][pOdet][sl] == 0)
	{
   		PlayerTextDrawFont(playerid, PlaNestAkses[sl][playerid], TEXT_DRAW_FONT:4);
	 	PlayerTextDrawBackgroundColour(playerid, PlaNestAkses[sl][playerid], PlayerInfo[playerid][pStyle2]);
   		PlayerTextDrawColour(playerid, PlaNestAkses[sl][playerid], PlayerInfo[playerid][pStyle2]);
	 	PlayerTextDrawShow(playerid, PlaNestAkses[sl][playerid]);
	}
 	else
	{
		PlayerTextDrawBackgroundColour(playerid, PlaNestAkses[sl][playerid], PlayerInfo[playerid][pStyle2]);
		PlayerTextDrawColour(playerid, PlaNestAkses[sl][playerid], -1);
		PlayerTextDrawBoxColour(playerid, PlaNestAkses[sl][playerid], 0);
		PlayerTextDrawFont(playerid, PlaNestAkses[sl][playerid], TEXT_DRAW_FONT:5);
		PlayerTextDrawSetPreviewModel(playerid, PlaNestAkses[sl][playerid], PlayerInfo[playerid][pOdet][sl]); // Модель
		
		new Float:modelPos[4], findIt;
		GetModelTextDraw(PlayerInfo[playerid][pOdet][sl], 2,0, modelPos[0], modelPos[1], modelPos[2], modelPos[3], findIt);
		PlayerTextDrawSetPreviewRot(playerid, PlaNestAkses[sl][playerid], modelPos[0], modelPos[1], modelPos[2], modelPos[3]);
		PlayerTextDrawShow(playerid,PlaNestAkses[sl][playerid]);
	}
	return 1;
}
stock i_switches(playerid, sw, stat)
{
	if(stat == 0) close_i_switches(playerid, sw);
	else show_i_switches(playerid, sw);
	PlayerTextDrawShow(playerid, PlaNestTabs[sw][playerid]);
}

stock close_i_switches(playerid, sw)
{
	PlayerTextDrawColour(playerid, PlaNestTabs[sw][playerid], 100);
	PlayerTextDrawFont(playerid, PlaNestTabs[sw][playerid], TEXT_DRAW_FONT:4);
	return true;
}

stock show_i_switches(playerid, sw)
{
	PlayerTextDrawColour(playerid, PlaNestTabs[sw][playerid], PlayerInfo[playerid][pStyle1]);
	PlayerTextDrawFont(playerid, PlaNestTabs[sw][playerid], TEXT_DRAW_FONT:4);
	return true;
}

stock i_tabs(playerid, tabs, stat)
{
	if(stat == 0)
	{
		PlayerTextDrawSetPreviewModel(playerid, PlaNestTabs[tabs][playerid], 2485);
		PlayerTextDrawSetPreviewRot(playerid, PlaNestTabs[tabs][playerid], 0.0, 0.0, 0.0, -1.0);
		PlayerTextDrawBackgroundColour(playerid, PlaNestTabs[tabs][playerid], 200);
		PlayerTextDrawColour(playerid, PlaNestTabs[tabs][playerid], 100);
		PlayerTextDrawBoxColour(playerid, PlaNestTabs[tabs][playerid], 0);
		PlayerTextDrawFont(playerid, PlaNestTabs[tabs][playerid], TEXT_DRAW_FONT:5);
	}
	else
	{
		PlayerTextDrawBackgroundColour(playerid, PlaNestTabs[tabs][playerid], PlayerInfo[playerid][pStyle2]);
		PlayerTextDrawColour(playerid, PlaNestTabs[tabs][playerid], PlayerInfo[playerid][pStyle2]);
		PlayerTextDrawFont(playerid, PlaNestTabs[tabs][playerid], TEXT_DRAW_FONT:4);
	}
	PlayerTextDrawShow(playerid, PlaNestTabs[tabs][playerid]);
}
stock i_pagetwo(playerid, page)
{
	new t = OnlineInfo[playerid][oShowTabs];
	if(t == 9999 || t == 0) return 1;
	if(Tabs_Load[playerid] == 2)
	{
		if(PlayerInfo[playerid][pDom] != t)
		{
			if(DomInfo[t][dAcccupO] == 0) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец");
			if(DomInfo[t][dAcccupO] == 1 && PlayerInfo[playerid][pHouserent] != t) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец и проживающие");
			if(DomInfo[t][dAcccupO] == 2 && (DomInfo[t][dFam] == 0 || DomInfo[t][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[t][dFam])) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец и семья");
			if(DomInfo[t][dAcccupO] == 3 && (DomInfo[t][dFam] == 0 || DomInfo[t][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[t][dFam]) && PlayerInfo[playerid][pHouserent] != t) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец, проживающие и семья");
		}
	}
	if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж редактирует предмет");
	if(page == 0 && Pagetwo[playerid] != 0)
	{
		PlayerPlaySound(playerid,17803,0,0,0);
		i_switches(playerid, Pagetwo[playerid]+8, 0);
		Pagetwo[playerid] = 0;
		i_switches(playerid, 8, 1);
		if(Tabs_Load[playerid] == 2) for(new i = 0; i < 20; i++) item_second(playerid, DomInfo[t][dInvent][i], DomInfo[t][dInv][i], i, 0, DomInfo[t][dInvPara][i], DomInfo[t][dInvType][i], DomInfo[t][dInvPack][i], 0);
		else if(Tabs_Load[playerid] == 9) for(new i = 0; i < 20; i++) item_second(playerid, BizzInfo[t][bInvent][i], BizzInfo[t][bInv][i], i, 0, BizzInfo[t][bInvPara][i], BizzInfo[t][bInvType][i], BizzInfo[t][bInvPack][i], 0);
	}
	else if(page == 1 && Pagetwo[playerid] != 1)
	{
		PlayerPlaySound(playerid,17803,0,0,0);
		i_switches(playerid, Pagetwo[playerid]+8, 0);
		Pagetwo[playerid] = 1;
		i_switches(playerid, 9, 1);
		if(Tabs_Load[playerid] == 2) for(new i = 20; i < 40; i++) item_second(playerid, DomInfo[t][dInvent][i], DomInfo[t][dInv][i], i, 0, DomInfo[t][dInvPara][i], DomInfo[t][dInvType][i], DomInfo[t][dInvPack][i], 0);
		else if(Tabs_Load[playerid] == 9) for(new i = 20; i < 40; i++) item_second(playerid, BizzInfo[t][bInvent][i], BizzInfo[t][bInv][i], i, 0, BizzInfo[t][bInvPara][i], BizzInfo[t][bInvType][i], BizzInfo[t][bInvPack][i], 0);
	}
	else if(page == 2 && Pagetwo[playerid] != 2)
	{
		PlayerPlaySound(playerid,17803,0,0,0);
		i_switches(playerid, Pagetwo[playerid]+8, 0);
		Pagetwo[playerid] = 2;
		i_switches(playerid, 10, 1);
		if(Tabs_Load[playerid] == 2) for(new i = 40; i < 60; i++) item_second(playerid, DomInfo[t][dInvent][i], DomInfo[t][dInv][i], i, 0, DomInfo[t][dInvPara][i], DomInfo[t][dInvType][i], DomInfo[t][dInvPack][i], 0);
		else if(Tabs_Load[playerid] == 9) for(new i = 40; i < 60; i++) item_second(playerid, BizzInfo[t][bInvent][i], BizzInfo[t][bInv][i], i, 0, BizzInfo[t][bInvPara][i], BizzInfo[t][bInvType][i], BizzInfo[t][bInvPack][i], 0);
	}
	else if(page == 3 && Pagetwo[playerid] != 3)
	{
		PlayerPlaySound(playerid,17803,0,0,0);
		i_switches(playerid, Pagetwo[playerid]+8, 0);
		Pagetwo[playerid] = 3;
		i_switches(playerid, 11, 1);
		if(Tabs_Load[playerid] == 2) for(new i = 60; i < 80; i++) item_second(playerid, DomInfo[t][dInvent][i], DomInfo[t][dInv][i], i, 0, DomInfo[t][dInvPara][i], DomInfo[t][dInvType][i], DomInfo[t][dInvPack][i], 0);
		else if(Tabs_Load[playerid] == 9) for(new i = 60; i < 80; i++) item_second(playerid, BizzInfo[t][bInvent][i], BizzInfo[t][bInv][i], i, 0, BizzInfo[t][bInvPara][i], BizzInfo[t][bInvType][i], BizzInfo[t][bInvPack][i], 0);
	}
	return 1;
}
stock set_color_server(playerid)
{
	if(PlayerInfo[playerid][pSty] == 1) // Sampik Online
	{
		PlayerInfo[playerid][pStyle1] = -5427201; // Желтый
		PlayerInfo[playerid][pStyle2] = -9622017; // Оранжевый
		PlayerInfo[playerid][pStyle3] = 926363135; // Серо-желтый (выделенный)
	}
	else if(PlayerInfo[playerid][pSty] == 2) // Красный
	{
		PlayerInfo[playerid][pStyle1] = -463714049;
		PlayerInfo[playerid][pStyle2] = -1523963137;
		PlayerInfo[playerid][pStyle3] = 926363135;
	}
	else if(PlayerInfo[playerid][pSty] == 3) // Зеленый
	{
		PlayerInfo[playerid][pStyle1] = 2045008127;
		PlayerInfo[playerid][pStyle2] = 949370111;
		PlayerInfo[playerid][pStyle3] = 926363135;
	}
	else if(PlayerInfo[playerid][pSty] == 4) // Синий
	{
		PlayerInfo[playerid][pStyle1] = 380628479;
		PlayerInfo[playerid][pStyle2] = 477880063;
		PlayerInfo[playerid][pStyle3] = 892240127;
	}
	else if(PlayerInfo[playerid][pSty] == 5) // Розовый
	{
		PlayerInfo[playerid][pStyle1] = -476315649;
		PlayerInfo[playerid][pStyle2] = -1770389505;
		PlayerInfo[playerid][pStyle3] = 992108799;
	}
	else if(PlayerInfo[playerid][pSty] == 6) // Белый
	{
		PlayerInfo[playerid][pStyle1] = -673720321;
		PlayerInfo[playerid][pStyle2] = -1263225601;
		PlayerInfo[playerid][pStyle3] = 842150655;
	}
	else if(PlayerInfo[playerid][pSty] == 7) // Черный
	{
		PlayerInfo[playerid][pStyle1] = 842150655;
		PlayerInfo[playerid][pStyle2] = 218959359;
		PlayerInfo[playerid][pStyle3] = 1684301055;
	}
	else if(PlayerInfo[playerid][pSty] == 8) // Сиреневый
	{
		PlayerInfo[playerid][pStyle1] = -2072845569;
		PlayerInfo[playerid][pStyle2] = 1885200639;
		PlayerInfo[playerid][pStyle3] = 992108799;
	}
	else if(PlayerInfo[playerid][pSty] == 9) // Персиковый
	{
		PlayerInfo[playerid][pStyle1] = -6529537;
		PlayerInfo[playerid][pStyle2] = -9348353;
		PlayerInfo[playerid][pStyle3] = 926363135;
	}
	else if(PlayerInfo[playerid][pSty] == 10) // MyGame World
	{
		PlayerInfo[playerid][pStyle1] = -376421889;
		PlayerInfo[playerid][pStyle2] = 842150655;
		PlayerInfo[playerid][pStyle3] = 926363135;
	}
	else// Pears Project
	{
	    PlayerInfo[playerid][pSty] = 0;
		PlayerInfo[playerid][pStyle1] = 93782015; // Голубой
		PlayerInfo[playerid][pStyle2] = 9848575; // Зелёный
		PlayerInfo[playerid][pStyle3] = 926363135; // Цвет Выделенного Предмета (993777151 - старый сиреневый)
	}

	// Фон меню
	if(PlayerInfo[playerid][pStyBack] == 1) PlayerInfo[playerid][pStyle4] = 1521338467; // Pears Glass
	else if(PlayerInfo[playerid][pStyBack] == 2) PlayerInfo[playerid][pStyle4] = -588189506; // Белый
	else if(PlayerInfo[playerid][pStyBack] == 3) PlayerInfo[playerid][pStyle4] = 1960358590; // Зелёный
	else if(PlayerInfo[playerid][pStyBack] == 4) PlayerInfo[playerid][pStyle4] = -1549211458; // Сиреневый
	else PlayerInfo[playerid][pStyle4] = 421075440; // Pears Dark
	return 1;
}

// Отображаем количество переключателей страниц инвентаря
stock ShowSwitchPages(playerid, switches)
{
	if(switches == 2)
	{
		PlayerTextDrawShow(playerid, PlaNestTabs[0][playerid]);
		PlayerTextDrawShow(playerid, PlaNestTabs[1][playerid]);
		PlayerTextDrawHide(playerid, PlaNestTabs[12][playerid]);
		PlayerTextDrawHide(playerid, PlaNestTabs[13][playerid]);
	}
	else if(switches == 3) 
	{
		PlayerTextDrawShow(playerid, PlaNestTabs[0][playerid]);
		PlayerTextDrawShow(playerid, PlaNestTabs[1][playerid]);
		PlayerTextDrawShow(playerid, PlaNestTabs[12][playerid]);
		PlayerTextDrawHide(playerid, PlaNestTabs[13][playerid]);
	}
	else if(switches == 4) 
	{
		PlayerTextDrawShow(playerid, PlaNestTabs[0][playerid]);
		PlayerTextDrawShow(playerid, PlaNestTabs[1][playerid]);
		PlayerTextDrawShow(playerid, PlaNestTabs[12][playerid]);
		PlayerTextDrawShow(playerid, PlaNestTabs[13][playerid]);
	}
	else 
	{
		PlayerTextDrawHide(playerid, PlaNestTabs[0][playerid]);
		PlayerTextDrawHide(playerid, PlaNestTabs[1][playerid]);
		PlayerTextDrawHide(playerid, PlaNestTabs[12][playerid]);
		PlayerTextDrawHide(playerid, PlaNestTabs[13][playerid]);
	}
	return true;
}

// Загружаем иконки инвентаря (Предметы 1 страница)
stock InventoryLoadPick(playerid)
{
	OffSwitchInventory(playerid); // Выключаем все переключатели страниц
	CloseSwitchInventory(playerid); // Закрываем все переключатели

	Backpack[playerid] = 0; // Рюкзак закрыт (или любая другая вкладка)

	// Открыта первая страница
	Page[playerid] = 0;
	i_switches(playerid, 0, 1); // Отображаем выбранную первую страницу (ведь мы именно её и грузим)

	PositionSwitchPages(playerid, 2); // Меняем позиции положения кнопок страниц инвентаря (в обычном инвенте всегда две страницы)
	ShowSwitchPages(playerid, 2); // Показываем нужное количество кнопок страниц инвентаря
	for(new inva = 0; inva < 20; inva++) i_tile(playerid, PlayerInfo[playerid][pInven][inva], PlayerInfo[playerid][pInvenQuan][inva], inva, PlayerInfo[playerid][pInvenPara][inva], PlayerInfo[playerid][pInvenType][inva], PlayerInfo[playerid][pInvenPack][inva]);
	return true;
}

stock ShowFrisk2(playerid,targetid)
{
	if(CnnVed[playerid] >= 11 || OnlineInfo[playerid][oShowInterface] >= 2
	|| MenuInfo[playerid][zStat] == 1 || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || howstun(playerid)
	|| gAutosalon[playerid] >= 183 && gAutosalon[playerid] <= 192 || HealthAC[playerid] <= 0
	|| gVrakete[playerid] > 0) return 1;
	if(DeskStatus[playerid] > 0 || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || gSpectateID[playerid] != INVALID_PLAYER_ID) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас открыть инвентарь");
	if(setting_pos_draw[playerid] > 0 || setting_size_draw[playerid] > 0) return ErrorMessage(playerid, "{FF6347}Завершите редактирование текстдравов");
	
	// Закрываем спидометр и подсказки (чтобы не мешали)
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    if(DrawSpeed[playerid] == true) CloseVehSpeed(playerid);
		HideOldHint(playerid);
	}
	
	if(DrawInvent[playerid] == false) create_textdraw_inventory(playerid);
	PlayerPlaySound(playerid,40405,0,0,0);
	//new animname[32], animlib[32];
	//GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
	//if(strcmp(animlib, "SWIM", true) == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу открыть инвентарь, находясь в воде");

	OnlineInfo[playerid][oShowTabs] = 9999;
	OnlineInfo[playerid][oInventSelectLeft] = 9999, LoadPick[playerid] = 9999, LoadGun[playerid] = 9999;
	Pagetwo[playerid] = 0, Veshi[playerid] = 0;
	Tabs_Type[playerid] = 0, Tabs_ID[playerid] = 0, Tabs_Load[playerid] = 0;
	
	set_color_server(playerid);
	if(PlayerInfo[playerid][pSoska] >= 1 || PlayerInfo[playerid][pHidden] >= 1 || PlayerInfo[playerid][pMedia] >= 1)
	{
	    if(PlayerInfo[playerid][pNeon] <= 993) PlayerTextDrawSetSelectable(playerid, PlaInventDraw[7][playerid], true);
	    if(PlayerInfo[playerid][pMechSkill] <= 999) PlayerTextDrawSetSelectable(playerid, PlaInventDraw[8][playerid], true);
	    if(PlayerInfo[playerid][pCap] <= 99) PlayerTextDrawSetSelectable(playerid, PlaInventDraw[9][playerid], true);
	    if(PlayerInfo[playerid][pInfoload] <= 999) PlayerTextDrawSetSelectable(playerid, PlaInventDraw[10][playerid], true);
	}
	PlayerTextDrawShow(playerid, PlaInventDraw[0][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[1][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[2][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[3][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[4][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[5][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[6][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[7][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[8][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[9][playerid]);
	PlayerTextDrawShow(playerid, PlaInventDraw[10][playerid]);
	
	PlayerTextDrawSetPreviewModel(playerid, PlaNestOthe[0][playerid], GetModelSkin(playerid, PlayerInfo[playerid][pModel])), PlayerTextDrawShow(playerid, PlaNestOthe[0][playerid]);
	PlayerTextDrawShow(playerid, PlaNestOthe[2][playerid]);

	if(HasABustAks(playerid,1) != -1) TabBackpackShow(playerid);

	// Аксессуары
   	for(new ode = 0; ode < 5; ode ++) i_akses(playerid, ode);

   	// Предметы 1 Страница
	InventoryLoadPick(targetid);

	// Потребности
	UpdatePotreb(playerid);

	// Переключатели
	i_switches(playerid, 0, 1);
	i_switches(playerid, 1, 0);

	// Мои Товары [1]
	i_tabs(playerid, 2, 0);
	PlayerTextDrawShow(playerid, PlaNestTabs[5][playerid]);

	// Рядом [2]
	i_tabs(playerid, 3, 0);
	PlayerTextDrawShow(playerid, PlaNestTabs[6][playerid]);

	new tabs2 = -1, string[34];
	// Торговые Лавки [3]
	if(!IsPlayerInAnyVehicle(playerid))
	{
		foreach(Player,i)
		{
			if(OnlineInfo[i][oLogged] == 0) continue;
			if(Goods[i] == 0) continue;
			if(!ProxDetectorS(3.0, playerid, i)) continue;
			if(i != playerid) tabs2 = i;
		}
	}
	if(tabs2 >= 0)
	{
		Tabs_Type[playerid] = 1, Tabs_ID[playerid] = tabs2;
		i_tabs(playerid, 4, 0);
		format(string,sizeof(string),"‡A‹KA: %d",tabs2);
		PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], string);
		PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
	}

	// Тюремная Тумбочка [3]
	if(tabs2 == -1)
	{
		new prisonTable = IsAPrisonBedTable(playerid);
		if(prisonTable > -1)
		{
			Tabs_Type[playerid] = 14, Tabs_ID[playerid] = prisonTable;
			tabs2 = 1;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "ЏYMЂA");
			else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "LOCKER");
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Взаимодействие с Предметом (Плита, Верстак, Холодильник) [3]
	if(tabs2 == -1)
	{
		new type = IsANearbyObject(playerid);
		if(type)
		{
			if(type == 1)
			{
				Tabs_Type[playerid] = 12, Tabs_ID[playerid] = 1;
				tabs2 = 1;
				i_tabs(playerid, 4, 0);
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "Њ‡…ЏA");
				else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "COOKER");
				PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
			}
			else if(type == 2) tabs2 = 1, WorkBenchInventoryTabs(playerid); // Верстак
			else if(type == 3) // Холодос
			{
				new fridgeid = GetPlayerRefrigerator(playerid);
				if(fridgeid != -1){
					Tabs_Type[playerid] = 16, Tabs_ID[playerid] = fridgeid;
					tabs2 = 1;
					i_tabs(playerid, 4, 0);
					if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "XO‡Oѓ…‡’H…K");
					else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "FRIDGE");
					PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
				}
			}
			else if(type == 7)
			{
				Tabs_Type[playerid] = 17, Tabs_ID[playerid] = 1;
				tabs2 = 1;
				i_tabs(playerid, 4, 0);
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "CЏAHOK");
				else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "Machine");
				PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
			}
		}
	}

	// Квартирная Тумбочка [3]
	if(tabs2 == -1)
	{
		new apartmentsTable = IsAApartmentsTable(playerid);
		if(apartmentsTable > -1)
		{
			Tabs_Type[playerid] = 15, Tabs_ID[playerid] = apartmentsTable;
			tabs2 = 1;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "ЏYMЂA");
			else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "LOCKER");
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Багажник и Капот [3]
	if(tabs2 == -1)
	{
		new type;
		new baga = IsAPosBootOrBonet(playerid, type);
		if(baga > 0)
		{
			if(type == 1) // Багажник
			{
				Tabs_Type[playerid] = 5, Tabs_ID[playerid] = baga;
				i_tabs(playerid, 4, 0);
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "ЂA‚A„H…K");
				else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "TRUNK");
			}
			else if(type == 2) // Капот
			{
				Tabs_Type[playerid] = 10, Tabs_ID[playerid] = baga;
				i_tabs(playerid, 4, 0);
				if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "ѓ‹…‚AЏE‡’");
				else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "ENGINE");
			}
			tabs2 = baga;
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Мусор [3]
	if(tabs2 == -1)
	{
		new tra = IsATrashBox(playerid);
		if(tra > -1)
		{
			Tabs_Type[playerid] = 8, Tabs_ID[playerid] = tra;
			tabs2 = tra;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "MYCOP");
			else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "TRASH");
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Шкаф Дома [3]
	if(tabs2 == -1)
	{
	    new nd = IsAWardrobeDom(playerid);
		if(nd > -1)
		{
			Tabs_Type[playerid] = 2, Tabs_ID[playerid] = nd;
			tabs2 = nd;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string,sizeof(string),"ѓOM: %d", tabs2);
			else format(string,sizeof(string),"HOUSE: %d", tabs2);
			PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], string);
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}
	
	// Склад Бизнеса [3]
	if(tabs2 == -1)
	{
	    new nb = IsAWardrobeBiz(playerid);
		if(nb > -1)
		{
			Tabs_Type[playerid] = 9, Tabs_ID[playerid] = nb;
			tabs2 = nb;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string,sizeof(string),"Ђ…3HEC: %d", tabs2);
			else format(string,sizeof(string),"BIZ: %d", tabs2);
			PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], string);
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Склад Организации [3]
	if(tabs2 == -1)
	{
		new skladstat = GetSkladStat(playerid);
		if(skladstat > -1)
		{
			Tabs_Type[playerid] = 3, Tabs_ID[playerid] = skladstat;
			tabs2 = skladstat;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "CK‡Aѓ");
			else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "STORAGE");
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Верстак [3]
	if(tabs2 == -1)
	{
		if(IsAVerstak(playerid)) tabs2 = 1, WorkBenchInventoryTabs(playerid); // Верстак
	}

	// Хим Стол [3]
	if(tabs2 == -1)
	{
		if(IsAHimLab(playerid))
		{
			Tabs_Type[playerid] = 13, Tabs_ID[playerid] = 1;
			tabs2 = 1;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "X…M CЏO‡");
			else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "TABLE");
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	// Арендованный Склад [3]
	if(tabs2 == -1)
	{
		new rendsk = IsARentSklad(playerid);
		if(rendsk >= 0)
		{
			Tabs_Type[playerid] = 4, Tabs_ID[playerid] = rendsk;
			// tabs2 = rendsk;
			i_tabs(playerid, 4, 0);
			if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "CK‡Aѓ");
			else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "STORAGE");
			PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
		}
	}

	OnlineInfo[playerid][oShowInterface] = 1;
	UpdateGun(playerid); // Оружие
	
	// Грузим Рядом
	Tabs_Load[playerid] = 7, showthrow(playerid);
	UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
	
	SelectColorDraw(playerid);
	if((Piss[playerid] == 1 || Piss[playerid] == 8) && PissTime[playerid] > 0) PlayerPlaySound(playerid,14200,0,0,0);
	return 1;
}

stock WorkBenchInventoryTabs(playerid)
{
	Tabs_Type[playerid] = 11, Tabs_ID[playerid] = 1;
	i_tabs(playerid, 4, 0);
	if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "‹EPCЏAK");
	else PlayerTextDrawSetString(playerid, PlaNestTabs[7][playerid], "WORKBEHCN");
	PlayerTextDrawShow(playerid, PlaNestTabs[7][playerid]);
}

stock showbiz(playerid,b)
{
	if(OnlineInfo[playerid][oShowInterface] != 1 || howstun(playerid)) return 1;
	if(IsANearWardrobeBiz(playerid, Tabs_ID[playerid]))
	{
		if(!GetAccessBiz(playerid, b, 6)) return 0;
	
   		if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят редактированием объекта");

		Pagetwo[playerid] = 0;
		i_switches(playerid, 8, 1);
		i_switches(playerid, 9, 0);
		i_switches(playerid, 10, 0);
		i_switches(playerid, 11, 0);

		OnlineInfo[playerid][oShowTabs] = b;
		i_tabs(playerid, 4, 1);
		for(new inva = 0; inva < 20; inva++) item_second(playerid, BizzInfo[b][bInvent][inva], BizzInfo[b][bInv][inva], inva, 0, BizzInfo[b][bInvPara][inva], BizzInfo[b][bInvType][inva], BizzInfo[b][bInvPack][inva], 0);

		new yes = 0;
		for(new veh = 1; veh < MAX_CARS; veh++)
		{
			if(!IsABoot(veh)) continue;
			new Float:fDisveh = GetVehicleDistanceFromPoint(veh, BizzInfo[b][bX], BizzInfo[b][bY], BizzInfo[b][bZ]);
			if(fDisveh <= 10.0) yes = veh;
		}
		if(yes > 0)
		{
			PlayerTextDrawSetPreviewModel(playerid, PlaNestAct[0][playerid], GetVehicleModelSync(playerid, VehInfo[yes][vModel]));
			if(IsABootFront(yes)) PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[0][playerid], -10.000000, 0.000000, 0.000000, 1.000000);
			else PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[0][playerid], -10.000000, 0.000000, 180.000000, 1.000000);
			PlayerTextDrawSetPreviewVehicleColours(playerid, PlaNestAct[0][playerid], VehInfo[yes][vVehcol1], VehInfo[yes][vVehcol2]);
			PlayerTextDrawShow(playerid, PlaNestAct[0][playerid]);
			UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 1);
		}
		else UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
	}
	else PlayerTextDrawHide(playerid, PlaNestTabs[4][playerid]), PlayerTextDrawHide(playerid, PlaNestTabs[7][playerid]);
	return 1;
}
stock showdom(playerid,dom)
{
	if(OnlineInfo[playerid][oShowInterface] != 1 || howstun(playerid)) return 1;
	if(IsANearWardrobeDom(playerid, Tabs_ID[playerid]))
	{
   		if(PlayerInfo[playerid][pDom] != dom)
		{
			if(DomInfo[dom][dAcccupO] == 0) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец");
			if(DomInfo[dom][dAcccupO] == 1 && PlayerInfo[playerid][pHouserent] != dom) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец и проживающие");
			if(DomInfo[dom][dAcccupO] == 2 && (DomInfo[dom][dFam] == 0 || DomInfo[dom][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[dom][dFam])) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец и семья");
			if(DomInfo[dom][dAcccupO] == 3 && (DomInfo[dom][dFam] == 0 || DomInfo[dom][dFam] >= 1 && PlayerInfo[playerid][pFamily] != DomInfo[dom][dFam]) && PlayerInfo[playerid][pHouserent] != dom) return ErrorMessage(playerid, "{FF6347}Открывать шкаф в этом доме может только владелец, проживающие и семья");
		}
   		if(IsPlayerEditObject(playerid)) return ErrorMessage(playerid, "{FF6347}Ваш персонаж занят редактированием объекта");

		Pagetwo[playerid] = 0;
		i_switches(playerid, 8, 1);
		i_switches(playerid, 9, 0);
		i_switches(playerid, 10, 0);
		i_switches(playerid, 11, 0);
		
		OnlineInfo[playerid][oShowTabs] = dom;
		i_tabs(playerid, 4, 1);
		for(new inva = 0; inva < 20; inva++) item_second(playerid, DomInfo[dom][dInvent][inva], DomInfo[dom][dInv][inva], inva, 0, DomInfo[dom][dInvPara][inva], DomInfo[dom][dInvType][inva], DomInfo[dom][dInvPack][inva], 0);

		if(DomInfo[dom][dIngar] >= 1)
		{
			new mojno = 0, yes = 0;
			if(PlayerInfo[playerid][pDom] == dom) mojno = 1;
			else if(PlayerInfo[playerid][pDom] != dom)
			{
				if(DomInfo[dom][dAcccupP] == 1 && PlayerInfo[playerid][pHouserent] == dom) mojno = 1;
				if(DomInfo[dom][dAcccupP] == 2 && (DomInfo[dom][dFam] >= 1 && PlayerInfo[playerid][pFamily] == DomInfo[dom][dFam])) mojno = 1;
				if(DomInfo[dom][dAcccupP] == 3 && (DomInfo[dom][dFam] >= 1 && PlayerInfo[playerid][pFamily] == DomInfo[dom][dFam] || PlayerInfo[playerid][pHouserent] == dom)) mojno = 1;
				if(DomInfo[dom][dAcccupP] == 4) mojno = 1;
			}
			if(mojno == 1)
			{
				for(new veh = 1; veh < MAX_CARS; veh++)
				{
					if(!IsABoot(veh)) continue;
					new Float:fDisveh = GetVehicleDistanceFromPoint(veh, DomInfo[dom][dGarageX], DomInfo[dom][dGarageY], DomInfo[dom][dGarageZ]);
     				if(fDisveh <= 10.0) yes = veh;
				}
				if(yes > 0)
				{
					PlayerTextDrawSetPreviewModel(playerid, PlaNestAct[0][playerid], GetVehicleModelSync(playerid, VehInfo[yes][vModel]));
					if(IsABootFront(yes)) PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[0][playerid], -10.000000, 0.000000, 0.000000, 1.000000);
					else PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[0][playerid], -10.000000, 0.000000, 180.000000, 1.000000);
					PlayerTextDrawSetPreviewVehicleColours(playerid, PlaNestAct[0][playerid], VehInfo[yes][vVehcol1], VehInfo[yes][vVehcol2]);
					PlayerTextDrawShow(playerid, PlaNestAct[0][playerid]);
					UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 1);
				}
				else UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
			}
			else UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
		}
		else UpdateInventTwoBlock(playerid, Tabs_Load[playerid], 0);
	}
	else PlayerTextDrawHide(playerid, PlaNestTabs[4][playerid]), PlayerTextDrawHide(playerid, PlaNestTabs[7][playerid]);
	return 1;
}
stock showbonet(playerid, v)
{
	if(IsPlayerInAnyVehicle(playerid)) return 0;
	if(IsAMoto(VehInfo[v][vModel]) || IsABoat(VehInfo[v][vModel]))
	{
		new Float:pos_veh[3];
		GetVehiclePos(v, pos_veh[0], pos_veh[1], pos_veh[2]);
		if(!IsPlayerInRangeOfPoint(playerid, 2.0, pos_veh[0], pos_veh[1], pos_veh[2])) return 0;
	}
	else if(IsAPlane(VehInfo[v][vModel]))
	{
		new Float:pos_veh[3];
		GetVehiclePos(v, pos_veh[0], pos_veh[1], pos_veh[2]);
		if(!IsPlayerInRangeOfPoint(playerid, 4.0, pos_veh[0], pos_veh[1], pos_veh[2])) return 0;
	}
	else
	{
		if(!GetVehicleNear_Bonet(playerid, v)) return 0;
	}

	if(!IsVehicleOpen(playerid, v))
	{
		ErrorMessage(playerid, "{FF6347}Транспорт заперт");
		return 0;
	}

	new quanPlayer;
	foreach(Player,i)
	{
		if(OnlineInfo[i][oLogged] == 0) continue;
		if(OnlineInfo[i][oShowInterface] != 1) continue;
		if(Tabs_Load[i] != 10) continue;
		if(OnlineInfo[i][oShowTabs] == v)
		{
			quanPlayer ++;
			break;
		}
	}
	if(quanPlayer > 0)
	{
		ErrorMessage(playerid, "{FF6347}Двигатель этого транспорта осматривает другой игрок\n\n{cccccc}Одновременный осмотр или ремонт невозможен");
		return 0;
	}

	TurnPlayerFaceToVehicle(playerid, v);
	OnlineInfo[playerid][oShowTabs] = v;
	i_tabs(playerid, 4, 1);
	veh_openbonnet(v);

	showDraw_CraftProcess(playerid, 0); // Грузим и отображаем текстдравы ремонта двигателя

	// Квест ремонт транспорта
	if(NoCompleteQuest(playerid, 4) && IsACar(VehInfo[v][vModel]) && VehInfo[v][vHealth] <= 400.0)
	{
		PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_repair4.mp3");
		SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Выбери рем комплект в инвентаре, а затем нажми на двигатель");
		SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Ну и просто почини свою колымагу");
	}
	return 1;
}
stock showboot(playerid, v)
{
	if(OnlineInfo[playerid][oShowInterface] != 1 || IsPlayerInAnyVehicle(playerid)) return 0;
	if(!GetVehicleNear_Boot(playerid, v)) return 0;

	if(!IsVehicleOpen(playerid, v))
	{
		if(IsACar(VehInfo[v][vModel]) || IsAPlane(VehInfo[v][vModel]))
		{
			if(IsAHardLockVeicle(VehInfo[v][vModel])) ErrorMessage(playerid, "{FF6347}Транспорт заперт\n{ffcc66}Вам нужна бомба липучка, чтобы вскрыть этот транспорт\n\n{cccccc}Бомбу липучку можно создать на любом верстаке");
			else ErrorMessage(playerid, "{FF6347}Транспорт заперт\n{ffcc66}Вы можете взломать замок транспорта отмычками - ALT\n\n{cccccc}Отмычки можно приобрести в любом супермаркете");
		}
		else ErrorMessage(playerid, "{FF6347}Транспорт заперт\n{cccccc}Замок этого транспорта нельзя взломать");
		return 0;
	}

	if(Cars[v] != 88 && OnlineInfo[playerid][oBootMessageVehicle] != v && !IsNoMessageVehicle(v)) 
	{
		OnlineInfo[playerid][oBootMessageVehicle] = v;
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ffcc00}*","{ffcc66}Внимание! В этом багажнике предметы не сохраняются!\n{FF6347}После спавна или удаления транспорта - предметы исчезнут\n\n{cccccc}Предметы сохраняются только в личном транспорте","*","");
	}
	TurnPlayerFaceToVehicle(playerid, v);
	OnlineInfo[playerid][oShowTabs] = v;
	Pagetwo[playerid] = 0;
	i_tabs(playerid, 4, 1);
	veh_openboot(v);
	for(new inva = 0; inva < 20; inva++) item_boot(playerid, v, VehInfo[v][vInvent][inva], VehInfo[v][vInv][inva], inva, VehInfo[v][vInvPara][inva], VehInfo[v][vInvType][inva], VehInfo[v][vInvPack][inva]);
	PlayerTextDrawSetPreviewModel(playerid, PlaNestAct[0][playerid], 19134);
	PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[0][playerid], 0.0, 0.0, 90.0, 1.000000);
	PlayerTextDrawShow(playerid, PlaNestAct[0][playerid]);

	// Квест ремонт транспорта
	if(NoCompleteQuest(playerid, 4) && IsACar(VehInfo[v][vModel]) && VehInfo[v][vHealth] <= 400.0 && get_boot(v, 183) > 0)
	{
		PlayAudioStreamForPlayer(playerid, "https://cdn.pears.fun/sound/characters/jone/jone_repair2.mp3");
		SendClientMessage(playerid, COLOR_YELLOW,"Джоне (голосовое): Возьми ремкомплект. Просто тыкни по нему два раза");
	}

	// Пиктограмма Дома
	new mojno = 0;
	for(new d = 0; d < sizeof(DomInfo); d++)
	{
		if(DomInfo[d][dIngar] >= 1 && d >= 1)
		{
			if(IsPlayerInRangeOfPoint(playerid,5.0,DomInfo[d][dGarageX], DomInfo[d][dGarageY], DomInfo[d][dGarageZ]))
			{
				if(PlayerInfo[playerid][pDom] == d) mojno = 1;
				else if(PlayerInfo[playerid][pDom] != d)
				{
					if(DomInfo[d][dAcccupP] == 1 && PlayerInfo[playerid][pHouserent] == d) mojno = 1;
					if(DomInfo[d][dAcccupP] == 2 && (DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] == DomInfo[d][dFam])) mojno = 1;
					if(DomInfo[d][dAcccupP] == 3 && (DomInfo[d][dFam] >= 1 && PlayerInfo[playerid][pFamily] == DomInfo[d][dFam] || PlayerInfo[playerid][pHouserent] == d)) mojno = 1;
					if(DomInfo[d][dAcccupP] == 4) mojno = 1;
				}
			}
		}
	}
	if(mojno == 0 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
	{
		for(new b = 0; b < sizeof(BizzInfo); b++)
		{
			if(IsABizInteriorFrame(b))
			{
				if(IsPlayerInRangeOfPoint(playerid,5.0,BizzInfo[b][bX], BizzInfo[b][bY], BizzInfo[b][bZ]))
				{
					if(GetAccessBizMay(playerid, b, 6)) mojno = 2;
				}
			}
		}
	}
	if(mojno == 1)
	{
		PlayerTextDrawSetPreviewModel(playerid, PlaNestAct[1][playerid], 1272);
		PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[1][playerid], 0.0, 0.0, 0.0, 1.0);
		PlayerTextDrawShow(playerid, PlaNestAct[1][playerid]);
	}
	else if(mojno == 2)
	{
		PlayerTextDrawSetPreviewModel(playerid, PlaNestAct[1][playerid], 1212);
		PlayerTextDrawSetPreviewRot(playerid, PlaNestAct[1][playerid], 334.0, -1.0, 1.0, 1.0);
		PlayerTextDrawShow(playerid, PlaNestAct[1][playerid]);
	}
	return 1;
}
stock showtrash(playerid, mytra)
{
	if(OnlineInfo[playerid][oShowInterface] != 1 || IsPlayerInAnyVehicle(playerid)) return 1;
    new tra = IsATrashBox(playerid);
	if(tra == mytra)
	{
		OnlineInfo[playerid][oShowTabs] = mytra;
		i_tabs(playerid, 4, 1);
		for(new inva = 0; inva < 20; inva++) item_second(playerid, gTrash[inva][mytra], gTrashKol[inva][mytra], inva, 0, gTrashPara[inva][mytra], gTrashType[inva][mytra], gTrashPack[inva][mytra], 0);
	}
	return 1;
}
stock IsATrashBox(playerid)
{
	if(GetPlayerVirtualWorld(playerid) == 0)
	{
		new Float: x, Float: y, Float: z;
		GetPlayerPos(playerid, x, y, z);

		new nearest_objects[1];
		new count = Streamer_GetNearbyItems(x, y, z, STREAMER_TYPE_OBJECT, nearest_objects, .range = 2.0, .worldid = 0);
		if (count > 0) {
			new objectid = nearest_objects[0];

			new Float: trashX, Float: trashY, Float: trashZ;
			GetDynamicObjectPos(objectid, trashX, trashY, trashZ);

			if (Streamer_HasIntData(STREAMER_TYPE_OBJECT, objectid, STREAMER_TRASHBOX_OBJECT)) {
				new tra = Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, STREAMER_TRASHBOX_OBJECT);
				if (IsPlayerInRangeOfPoint(playerid, 2.0, TrashPos[tra][TrashPos_X], TrashPos[tra][TrashPos_Y], TrashPos[tra][TrashPos_Z]))
					return tra;
			}
		}
	}
	return -1;
}
stock IsARentSklad(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0,1371.6943,-19.6758,1000.9112) && GetPlayerInterior(playerid) == 238)
	{
		new mw = GetPlayerVirtualWorld(playerid);
		new r = mw-81;
		if(r >= 0 && r <= 14)
	    {
	    	if(WhInfo[r][wStat] >= 1) return r;
		}
	}
	return -1;
}

stock IsANearWardrobeBiz(playerid, b)
{
	if(GetPlayerVirtualWorld(playerid) == b + 3000 && GetPlayerInterior(playerid) == 90)
	{
		if(IsPlayerInRangeOfPoint(playerid,200.0,BizzInfo[b][bInteriorX], BizzInfo[b][bInteriorY], BizzInfo[b][bInteriorZ]))
		{
			return 1;
		}
	}
	else if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(IsPlayerInRangeOfPoint(playerid,15.0,BizzInfo[b][bEnterX],BizzInfo[b][bEnterY],BizzInfo[b][bEnterZ])
			&& BizzInfo[b][bBizOStat][0] == 1)
		{
			return 1;
		}
	}
	return 0;
}
stock IsANearWardrobeDom(playerid, nd)
{
	if(GetPlayerVirtualWorld(playerid) == nd + 1000 && GetPlayerInterior(playerid) == 90)
	{
		if(IsPlayerInRangeOfPoint(playerid,200.0,DomInfo[nd][dEnterX], DomInfo[nd][dEnterY], DomInfo[nd][dEnterZ]))
		{
			return 1;
		}
	}
	else if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(IsPlayerInRangeOfPoint(playerid,DomInfo[nd][dMapDistance],DomInfo[nd][dKoordinatX], DomInfo[nd][dKoordinatY], DomInfo[nd][dKoordinatZ]))
		{
			return 1;
		}
	}
	return 0;
}
stock IsAWardrobeDom(playerid)
{
	// Персонаж внутри
	if(GetPlayerVirtualWorld(playerid) >= 1001 && GetPlayerVirtualWorld(playerid) <= 3000 && GetPlayerInterior(playerid) == 90)
	{
		new nd = GetPlayerVirtualWorld(playerid)-1000;
		if(IsPlayerInRangeOfPoint(playerid,200.0,DomInfo[nd][dEnterX], DomInfo[nd][dEnterY], DomInfo[nd][dEnterZ]))
			return nd;
	}
	// Персонаж снаружи
	else if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		new Float: x, Float: y, Float: z;
		GetPlayerPos(playerid, x, y, z);

		new nearest_objects[10];
		new count = Streamer_GetNearbyItems(x, y, z, STREAMER_TYPE_PICKUP, nearest_objects, .worldid = 0);
		if (count > 0) {
			for (new i = 0; i < min(count, sizeof(nearest_objects)); i++) {
				new pickupid = nearest_objects[i];
				if (Streamer_HasIntData(STREAMER_TYPE_PICKUP, pickupid, STREAMER_HOUSE_ENTER)) {
					new nd = Streamer_GetIntData(STREAMER_TYPE_PICKUP, pickupid, STREAMER_HOUSE_ENTER);
					if (IsPlayerInRangeOfPoint(playerid, DomInfo[nd][dMapDistance], DomInfo[nd][dKoordinatX], DomInfo[nd][dKoordinatY], DomInfo[nd][dKoordinatZ]))
						return nd;
				}
			}
		}
	}

	return -1;
}
stock IsAWardrobeBiz(playerid)
{
	// Персонаж внутри
	if(GetPlayerVirtualWorld(playerid) >= 3001 && GetPlayerVirtualWorld(playerid) < 4000 && GetPlayerInterior(playerid) == 90)
	{
		new b = GetPlayerVirtualWorld(playerid)-3000;
		if(IsPlayerInRangeOfPoint(playerid,200.0,BizzInfo[b][bInteriorX],BizzInfo[b][bInteriorY],BizzInfo[b][bInteriorZ]))
			return b;
	}
	// Персонаж снаружи
	else if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		new Float: x, Float: y, Float: z;
		GetPlayerPos(playerid, x, y, z);

		new nearest_objects[10];
		new count = Streamer_GetNearbyItems(x, y, z, STREAMER_TYPE_PICKUP, nearest_objects, .worldid = 0);
		if (count > 0) {
			for (new i = 0; i < min(count, sizeof(nearest_objects)); i++) {
				new pickupid = nearest_objects[i];

				if (Streamer_HasIntData(STREAMER_TYPE_PICKUP, pickupid, STREAMER_BIZ_ENTER)) {
					new b = Streamer_GetIntData(STREAMER_TYPE_PICKUP, pickupid, STREAMER_BIZ_ENTER);
					
					if (IsPlayerInRangeOfPoint(playerid, 15.0, BizzInfo[b][bEnterX], BizzInfo[b][bEnterY], BizzInfo[b][bEnterZ])
						&& BizzInfo[b][bBizOStat][0] != 0 && IsABizInteriorFrame(b)) return b;
				}
			}
		}
	}

	return -1;
}

stock ShowPotreb(playerid,targetid)
{
    new line[214],lines[4096];
    
	// Сытость
	if(getillness(targetid, 18) >= 0)
	{
	    format(line,sizeof(line),"\n{ff9000}Жажда Крови {ffcc66}%d / 100",PlayerInfo[targetid][pNeon]/10), strcat(lines,line);
		if(PlayerInfo[targetid][pNeon] <= 20) format(line,sizeof(line),"\n{cccccc}Статус: {ffcc66}Сильный голод [ Теряется хп и падает бодрость ]"), strcat(lines,line);
		else format(line,sizeof(line),"\n{cccccc}Статус: {99ff66}Не влияет на здоровье и болезни"), strcat(lines,line);

		format(line,sizeof(line),"\n{666666}Если ваш персонаж не будет пить кровь, бодрость будет падать"), strcat(lines,line);
		format(line,sizeof(line),"\n{666666}Вампир не может заболеть обычными болезнями"), strcat(lines,line);
	}
	else
	{
		format(line,sizeof(line),"\n{ff9000}Сытость {ffcc66}%d / 100",PlayerInfo[targetid][pNeon]/10), strcat(lines,line);
		if(PlayerInfo[targetid][pNeon] <= 20) format(line,sizeof(line),"\n{cccccc}Статус: {ffcc66}Сильный голод [ Теряется хп и накапливается болезнь ]"), strcat(lines,line);
		else format(line,sizeof(line),"\n{cccccc}Статус: {99ff66}Не влияет на здоровье и болезни"), strcat(lines,line);

		format(line,sizeof(line),"\n{666666}Если ваш персонаж не будет кушать, у него разовьется гастрит, а затем язва"), strcat(lines,line);
		format(line,sizeof(line),"\n{666666}Болезнь будет отнимать здоровье гораздо быстрее чем просто голод"), strcat(lines,line);
	}


	// Бодрость
    format(line,sizeof(line),"\n\n{ff9000}Бодрость {ffcc66}%d / 100",PlayerInfo[targetid][pMechSkill]/10), strcat(lines,line);
	if(PlayerInfo[targetid][pMechSkill] > 0) format(line,sizeof(line),"\n{cccccc}Статус: {99ff66}Не влияет на здоровье и болезни"), strcat(lines,line);
	else format(line,sizeof(line),"\n{cccccc}Статус: {ffcc66}Переутомление [ Недоступны некоторые работы и активность ]"), strcat(lines,line);
	
	format(line,sizeof(line),"\n{666666}Если ваш персонаж не будет спать, то сильно устанет и не сможет работать"), strcat(lines,line);
	format(line,sizeof(line),"\n{666666}При переутомлении появляется покачивание камеры, как при опьянении"), strcat(lines,line);
	
	
	// Нужда
    format(line,sizeof(line),"\n\n{ff9000}Нужда {ffcc66}%d / 100",PlayerInfo[targetid][pCap]), strcat(lines,line);
    if(PlayerInfo[targetid][pCap] <= 30 || getillness(targetid, 5) >= 0 && PlayerInfo[targetid][pCap] <= 60) format(line,sizeof(line),"\n{cccccc}Статус: {ffcc66}Желание справить нужду"), strcat(lines,line);
	else format(line,sizeof(line),"\n{cccccc}Статус: {99ff66}Не влияет на здоровье и болезни"), strcat(lines,line);

	format(line,sizeof(line),"\n{666666}Если ваш персонаж не будет справлять нужду в туалете, он сделает это под себя"), strcat(lines,line);
	format(line,sizeof(line),"\n{666666}В результате будет развиваться болезнь: перитонит мочевого пузыря"), strcat(lines,line);
	
	
	// Гигиена
    format(line,sizeof(line),"\n\n{ff9000}Гигиена {ffcc66}%d / 100",PlayerInfo[targetid][pInfoload]/10), strcat(lines,line);
    if(PlayerInfo[targetid][pInfoload] < 10) format(line,sizeof(line),"\n{cccccc}Статус: {ffcc66}Необходимо принять душ"), strcat(lines,line);
	else format(line,sizeof(line),"\n{cccccc}Статус: {99ff66}Не влияет на здоровье и болезни"), strcat(lines,line);

	format(line,sizeof(line),"\n{666666}Если ваш персонаж не будет мыться, вокруг него будут летать мухи"), strcat(lines,line);
	format(line,sizeof(line),"\n{666666}При длительном игнорировании гигиены развиваются болезни: грибок ногтей, дерматит, акне\n"), strcat(lines,line);
	
	
	new lol[56];
	format(lol,sizeof(lol),"{ff9000}Потребности: {cccccc}%s",PlayerInfo[targetid][pName]);
	ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,lol,lines,"*","");
}

public GameModeInitExitFunc()
{
	foreach(Player, i) Kickx(i);
	SetTimer("GameModeExitFunc", 3000, false);
	return 1;
}

public GameModeExitFunc() return GameModeExit(), SendRconCommand("exit");

stock GoGame(playerid)
{
    if(Login[0][playerid] == 0){}
    else if(Login[0][playerid] == 1)
    {
      if(PlayerInfo[playerid][pBanned] == 0)
      {
		// Блокируем вход в игру, если данные из базы не успели придти
		if(PlayerInfo[playerid][pTut] == 0)
		{
			TextDrawShowForPlayer(playerid, Chernifon);
			ShowDialog(playerid,2017,DIALOG_STYLE_MSGBOX,"{FF6347}*","{FF6347}Ошибка! Ваш аккаунт не успел загрузиться\n{cccccc}Чтобы выйти из игры введите в чат команду {FF6347}/q или ESC >> Выход","Ок","");
			Kickx(playerid);
			return 1;
		}

        if(PlayerInfo[playerid][pTut] >= 1)
        {
           if(OnlineInfo[playerid][oLogged] == 0)
           {
			// Записываем GPCI игрока
			if(CreateGPCI(playerid)) return 1;

			OnlineInfo[playerid][oLoggedUnix] = gettime(); // Unix время когда игрок залогинился на сервере

			CloseSpawnChoise(playerid); // Закрываем меню выбора спавна
			resetPlayerTransmitter(playerid); // Перезагружаем настройки чтения рации
			OnlineInfo[playerid][oLogged] = 1;
			SetPlayerName(playerid, PlayerInfo[playerid][pName]);
			LoadTextDraw(playerid);
			HideMainLogoServer(playerid);
			if(PlayerInfo[playerid][pDrawVisible][2] == false) showsiteserver(playerid);
			showtimeserver(playerid);
			
			// Загружаем временные сохранения капта
			if(CaptInfo[cCaptStat] == true)
			{
			if(PlayerInfo[playerid][pMember] == CaptInfo[cAttack] || PlayerInfo[playerid][pLeader] == CaptInfo[cAttack]
			|| PlayerInfo[playerid][pMember] == CaptInfo[cDefend] || PlayerInfo[playerid][pLeader] == CaptInfo[cDefend])
			{
				new line[20],lines[20 * MAX_GANG_CAPT_STATA];
				for(new idx = 0; idx < MAX_GANG_CAPT_STATA; idx++) 
				{
					format(line,sizeof(line),"GangTemp%d%s ", idx, (idx < MAX_GANG_CAPT_STATA - 1) ? "," : ""), strcat(lines,line);
				}
				new string_mysql[200 + sizeof(lines)];
				mysql_format(pearsq, string_mysql, sizeof(string_mysql), "SELECT %e FROM `pp_igroki` WHERE `user_id`='%d' AND `MyCapt`='%d'", lines, PlayerInfo[playerid][pID], ServerInfo[42]);
				mysql_tquery(pearsq, string_mysql, "LoadCaptTemp", "dd", playerid, g_MysqlRaceCheck[playerid]);
			}
			}

			// Загружаем личные сохранения капта
			if(IsAGangCapt(playerid)) OnLoadPlayerCapt(playerid);
			
			// Загрузка достижений
			new qwer[144];
			mysql_format(pearsq, qwer,sizeof(qwer),"SELECT * FROM `pp_achieve` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "Call_loadachieve", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Загрузка судебных решений
			mysql_format(pearsq, qwer, sizeof(qwer),
				"SELECT * FROM `court_decisions` WHERE `suspect` = '%d' ORDER BY `slot` ASC LIMIT %d",
				PlayerInfo[playerid][pID], MAX_COURT_PLAYER_DECISIONS
			);
			mysql_tquery(pearsq, qwer, "LoadPlayerCourtDecisions", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Загрузка монет Континенталь
			mysql_format(pearsq, qwer, sizeof(qwer), "SELECT * FROM `pp_user_continental` WHERE `userid` = %d", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "LoadPlayerContinentalCoins", "d", playerid);
			 
			new string2[184], mtext[12];
			new year, month,day;
			getdate(year, month, day);
			if(month == 1) mtext = "Января";
			else if(month == 2) mtext = "Февраля";
			else if(month == 3) mtext = "Марта";
			else if(month == 4) mtext = "Апреля";
			else if(month == 5) mtext = "Мая";
			else if(month == 6) mtext = "Июня";
			else if(month == 7) mtext = "Июля";
			else if(month == 8) mtext = "Августа";
			else if(month == 9) mtext = "Сентября";
			else if(month == 10) mtext = "Октября";
			else if(month == 11) mtext = "Ноября";
			else if(month == 12) mtext = "Декабря";
			
			if(month == 2 && day == 14) format(string2, sizeof(string2), "{0088ff}Привет, {FFFFFF}%s! Сегодня {ffcc66}%02d %s %d | {ff3366}Праздник [ /love ]",PlayerInfo[playerid][pName],day,mtext,year), SendClientMessage(playerid, COLOR_GREY,string2);
			else if(month == 4 && day == 1) format(string2, sizeof(string2), "{0088ff}Привет, {FFFFFF}%s! Сегодня {ffcc66}%02d %s %d | {ff9000}Праздник [ /fun ]",PlayerInfo[playerid][pName],day,mtext,year), SendClientMessage(playerid, COLOR_GREY,string2);
			else format(string2, sizeof(string2), "{0088ff}Привет, {FFFFFF}%s! Сегодня {ffcc66}%02d %s %d",PlayerInfo[playerid][pName],day,mtext,year), SendClientMessage(playerid, COLOR_GREY,string2);
			
			if(newskidka1 > 0) SendClientMessage(playerid, COLOR_GREY,"{FFFFFF}Активна Акция {ff9000}X%d Donate Y >> Донат или /donate", newskidka1);
			else if(ServerInfo[55] > 0) format(string2, sizeof(string2), "{FFFFFF}Активна Акция {ff9000}Скидка %d процентов на всё меню Y >> Донат или /donate",ServerInfo[55]), SendClientMessage(playerid, COLOR_GREY,string2);
			
			mysql_format(pearsq, qwer, sizeof(qwer), "SELECT status FROM `pp_message` WHERE `playerid` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "Call_UnreadMessagesNotify", "dd", playerid, g_MysqlRaceCheck[playerid]);

			foreach(Player,i)
			{
			if(GetPVarInt(i,"Readcon") == 1) SendDeathMessageToPlayer(i,INVALID_PLAYER_ID,playerid,200);
			}
			
			new /*Days = getdate(),*/unix = gettime();
			new douse = PlayerInfo[playerid][pDom];
			new bouse = PlayerInfo[playerid][pBusiness];
			new akka = PlayerInfo[playerid][pID];
			if(PlayerInfo[playerid][pFamily] >= 1)
			{
			new f = PlayerInfo[playerid][pFamily];
			if(FamilyInfo[f][fSost] >= 1)
			{
				FamilyInfo[f][fLoss] = unix+2592000;
				if(PlayerInfo[playerid][pSelectspawn] == 6)
				{
					if(FamilyInfo[f][fDop5] >= 1 && DomInfo[FamilyInfo[f][fDop5]][dFam] != f) PlayerInfo[playerid][pSelectspawn] = 0;
				}
				FamilyInfo[f][fUpdate] = 1;
			}
			}
			if(PlayerInfo[playerid][pDom] > 0 && LIMITED_LOADING_SERVER <= 1)
			{
			if(DomInfo[douse][dSost] != akka) PlayerInfo[playerid][pDom] = 0, PlayerInfo[playerid][pSelectspawn] = 0;
			else if(DomInfo[douse][dSost] == akka)
			{
				if(strfind(PlayerInfo[playerid][pName],DomInfo[douse][dVlad],true) != (-1)) {}
				else
				{
					format(DomInfo[douse][dVlad], 24, "%s", PlayerInfo[playerid][pName]);
					SaveDom(douse);
				}
			}
			}
			for(new room; room < 10; room++)
			{
				if(PlayerInfo[playerid][pApartmentsRoom][room] != 0)
				{
					if(PlayerInfo[playerid][pID] != ApartmentsRoom[PlayerInfo[playerid][pApartmentsRoom][room]-1][aprOwn]) PlayerInfo[playerid][pApartmentsRoom][room] = 0;
				}
			}
			if(PlayerInfo[playerid][pBusiness] > 0 && LIMITED_LOADING_SERVER <= 1)
			{
			if(BizzInfo[bouse][bSost] != akka) PlayerInfo[playerid][pBusiness] = 0;
			else if(BizzInfo[bouse][bSost] == akka)
			{
				if(strfind(PlayerInfo[playerid][pName],BizzInfo[bouse][bVlad],true) != (-1)) {}
				else
				{
					format(BizzInfo[bouse][bVlad], 24, "%s", PlayerInfo[playerid][pName]);
					BizzInfo[bouse][bUpdate] = 1;
				}
			}
			}
			if(PlayerInfo[playerid][pCap] <= 30) TextDrawShowForPlayer(playerid, PissDraw), TextDrawShowForPlayer(playerid, PissDraw2);
			if(PlayerInfo[playerid][pMember] >= 1)
			{
				bigint_add(OrganInfo[PlayerInfo[playerid][pMember]][glave], 100);
				OrganInfo[PlayerInfo[playerid][pMember]][gUpdate] = 1;
			}

			if(server >= 1) // Уведомления о безопасности (Только на основных серверах)
			{
			if(!strcmp(PlayerInfo[playerid][pMail],"\0",true)) SendClientMessage(playerid, COLOR_GREY,"{0088ff}Рекомендуем привязать {99ff66}Email {ffcc66}[ Y >> Меню >> Аккаунт ]");
			else
			{
				if(PlayerInfo[playerid][pMailStat] > 0) SendClientMessage(playerid, COLOR_GREY,"{0088ff}Рекомендуем подтвердить {99ff66}Email {ffcc66}[ Y >> Меню >> Аккаунт ]");
				else if(PlayerInfo[playerid][pGoogle] == 0) SendClientMessage(playerid, COLOR_GREY,"{0088ff}Рекомендуем установить {99ff66}Google Authenticator {ffcc66}[ /mm >> Аккаунт ]");
			}
			}

			if(PlayerInfo[playerid][pGoogle] == 0 && server >= 1)
			{
			if(PlayerInfo[playerid][pSoska] >= 1)
			{
				if(PlayerInfo[playerid][pLeader] > 0) 
				{
					UnmakeleaderPlayerBridge(PlayerInfo[playerid][pID], PlayerInfo[playerid][pLeader], PlayerInfo[playerid][pRank]);
					PlayerInfo[playerid][pLeader] = 0;
				}
				MakeadminPlayerBridge(PlayerInfo[playerid][pID], 0);
				PlayerInfo[playerid][pSoska] = 0, SendClientMessage(playerid, COLOR_GREY,"{0088ff}Админка отключена: {ff9000}Отсутствие Google Authenticator");
			}
			if(PlayerInfo[playerid][pLeader] >= 1 && PlayerInfo[playerid][pSoska] == 0)
			{
				UnmakeleaderPlayerBridge(PlayerInfo[playerid][pID], PlayerInfo[playerid][pLeader], PlayerInfo[playerid][pRank]);
				PlayerInfo[playerid][pLeader] = 0, SendClientMessage(playerid, COLOR_GREY,"{0088ff}Лидерка отключена: {ff9000}Отсутствие Google Authenticator");
			}
			}

			if(PlayerInfo[playerid][pHidden] > 0)
			{
			mysql_format(pearsq, string2,sizeof(string2),"SELECT Soska FROM `pp_igroki` WHERE `user_id` = '%d'", PlayerInfo[playerid][pHidden]);
			mysql_tquery(pearsq, string2, "Call_hiddenadmin", "dd", playerid, g_MysqlRaceCheck[playerid]);
			}
			//ReloadInventSlot(playerid);
			if(PlayerInfo[playerid][pInfoload] <= 2) PlayerInfo[playerid][pInfoload] = 800;
			SetPVarInt(playerid,"antipodbor",120);
			new playerip[24];
			GetPlayerIp(playerid, playerip, sizeof(playerip));
			
			ConnectLog(playerid, "login");

			new g = fraction(playerid);
			if(g > 0) Onli[g] ++;

			CheckAndRemoveSniperRifle(playerid);
			
			mysql_save(playerid, 11);
			PPExitSpectating(playerid); // Спавним
			
			// Читаем игроков с запросами и одинаковыми IP
			new plaip[24],plaiptwo[24],kolip = 0, kolname = 0, kolrep = 0, koldom = 0;
			GetPlayerIp(playerid, plaip, sizeof(plaip));
			foreach (Player, i)
			{
			GetPlayerIp(i, plaiptwo, sizeof(plaiptwo));
			if(strfind(plaiptwo,plaip,true) == 0) kolip ++;
			if(OnlineInfo[i][oLogged] == 1)
			{
				if(PlayerInfo[i][pNewname] >= 1) kolname ++;
				if(PlayerInfo[i][pReportStat] >= 1) kolrep ++;
			}
			}
			
			// Показываем админам количество запросов на смену описания дома
			if(PlayerInfo[playerid][pSoska] >= 5)
			{
			for(new d = 0; d < sizeof(DomInfo); d++)
			{
				if(DomInfo[d][dSost] >= 1 && DomInfo[d][dDescrip] == 2) koldom ++;
			}
			if(koldom >= 1)
			{
				if(koldom == 1)format(string2,sizeof(string2),"{FF8282}Очередь описании {0088ff}%d домов {ff9000}[ /doms ]",koldom);
				else if(koldom >= 2 && koldom <= 4)format(string2,sizeof(string2),"{FF8282}Очередь описании {0088ff}%d дома {ff9000}[ /doms ]",koldom);
				else format(string2,sizeof(string2),"{FF8282}Очередь описании {0088ff}%d домов {ff9000}[ /doms ]",koldom);
				SendClientMessage(playerid, COLOR_GREY,string2);
			}
			}
			
			// Показываем админам количество запросов на смену никнеймов
			if(kolname >= 1 && PlayerInfo[playerid][pSoska] >= 3)
			{
			if(kolname == 1)format(string2,sizeof(string2),"{FF8282}Очередь смены никнеймов {0088ff}%d игрок {ff9000}[ /setnames ]",kolname);
			else if(kolname >= 2 && kolname <= 4)format(string2,sizeof(string2),"{FF8282}Очередь смены никнеймов {0088ff}%d игрока {ff9000}[ /setnames ]",kolname);
			else format(string2,sizeof(string2),"{FF8282}Очередь смены никнеймов {0088ff}%d игроков {ff9000}[ /setnames ]",kolname);
			SendClientMessage(playerid, COLOR_GREY,string2);
			}
			
			// Показываем админам количество обращений от игроков
			if(kolrep >= 1 && PlayerInfo[playerid][pSoska] >= 1)
			{
			if(kolrep == 1)format(string2,sizeof(string2),"{FF8282}Обращения к администрации от {0088ff}%d игрока {ff9000}[ /rt ]",kolrep);
			else format(string2,sizeof(string2),"{FF8282}Обращения к администрации от {0088ff}%d игроков {ff9000}[ /rt ]",kolrep);
			SendClientMessage(playerid, COLOR_GREY,string2);
			}
			
			// Оповещаем об аккаунтах с одного IP
			if(kolip >= 3)
			{
			format(string2, sizeof(string2), " [ ADM ]: Совпадения IP {ff0000}%s[%d] {cccccc}[ Количество: %d ]", PlayerInfo[playerid][pName],playerid,kolip);
			ABroadCast(COLOR_ADM,string2,2);
			}
			
			// Если игрок эксперт
			if(PlayerInfo[playerid][pExpert] >= 1)
			{
			if(PlayerInfo[playerid][pGoogle] == 0 && server > 0) PlayerInfo[playerid][pExpert] = 0, mysql_save(playerid, 16);
			}
			
			TextDrawShowForPlayer(playerid,Text:Textdraw1);

			// Участнику мафии показываем битву за порт
			if(PortInfo[wStat] >= 1)
			{
			if(IsMafiaMember(playerid) && PortInfo[wTwo] >= 1 && PortInfo[wTwo] == fraction(playerid)) show_mafiabattle(playerid);
			}
			
			// Удаляем описание персонажа, если это администратор
			//if(PlayerInfo[playerid][pSoska] > 0 && Pame[playerid] >= 1) Pame[playerid] = 0;

			// Удаляем специальные скины, если игрок не администратор 22+
			if(PlayerInfo[playerid][pSoska] < 20) DeleteSpecialSystemSkins(playerid);
			
			// Крепим описание персонажа
			if(Pame[playerid] >= 1) CreatePame(playerid);
			
			// Сбрасываем переменные
			SetPVarInt(playerid,"antiflood",0);

			#if defined SAMPVOICE_COMPILE_3
			Sampvoice3InitializationPlayer(playerid);
			#endif
			
			// Даём всем паспорта (Вдруг его нет в инвентаре)
			if(get_invent2(playerid, 51, 0) <= 0) GiveThingPlayer(playerid, 51, 1, 0, 0, 0, 0, 9999);
			
			// Если игрок не находится в организации и носит одежду организации - раздеваем игрока и кидаем одежду в инвентарь
			if(g == 0 && PlayerInfo[playerid][pModel2] != 0 && PlayerInfo[playerid][pModel2] < 30)
			{
			GiveThingPlayer(playerid, PlayerInfo[playerid][pModel], 1, PlayerInfo[playerid][pModel2], PlayerInfo[playerid][pModel3], 3, 0, 9999);
			PlayerInfo[playerid][pModel2] = 0, PlayerInfo[playerid][pModel3] = 0;
			TakeOffClothes(playerid);
			}
			
			// Сохраняем аккаунт
			gMysqlSaveCheck[playerid] = 1;
			GF_OnPlayerUpdate(playerid);
			
			new f_str2[240];
			// Проверка непрочитанных сообщений
			mysql_format(pearsq, f_str2,sizeof(f_str2),"SELECT * FROM `pp_message` WHERE `playerid` = '%d' ORDER BY `newid` DESC LIMIT 100", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "Call_message2", "dd", playerid, g_MysqlRaceCheck[playerid]);
			
			// Загрузка Контактов
			mysql_format(pearsq, f_str2,sizeof(f_str2),"SELECT * FROM `pp_igroki_contacts` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "Call_loadcontact", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Простуда
			createcold(playerid);
			
			// Летающая Тарелка
			if(ufo_stat == 1 && PlayerInfo[playerid][pAbilStat][1] >= 5) show_remindufo(playerid);
			
			// Медиа
			if(server == 0 && serverType != 0) SendClientMessage(playerid, COLOR_GREY,"{0088ff}Деньги и лицензии на тестовом сервере пожно получить в этом меню {ffcc66}[ /test ]");
			else if(PlayerInfo[playerid][pMedia] >= 1) SendClientMessage(playerid, COLOR_GREY,"{0088ff}Вы медиа партнёр Pears Project {ffcc66}[ /media ]");

			// Проверяем устаревшие Gold Trade игрока
			CheckCancelCrypto(playerid, 1);

			// Загрузка wanted игрока
			WantedInfo[playerid][wanLoad] = true;
			mysql_format(pearsq, qwer,sizeof(qwer),"SELECT * FROM `pp_wanted` WHERE `playerid` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "Call_loadwanted", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Загружаем ежедневные задания
			mysql_format(pearsq, qwer, sizeof(qwer), "SELECT * FROM `pp_quests` WHERE `user_id` = %d", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "OnPlayerQuestsLoad", "d", playerid);

			// Загружаем данные о прохождении заброшенной шахты
			mysql_format(pearsq, qwer, sizeof(qwer), "SELECT * FROM `minewar` WHERE `user_id` = %d", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "MineWar_Load", "d", playerid);

			// Загружаем данные о прохождении гробницы фараона
			mysql_format(pearsq, qwer, sizeof(qwer), "SELECT * FROM `tomb` WHERE `user_id` = %d", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, qwer, "Tomb_Load", "d", playerid);

			// Закрываем диаоговые окна
			HidePlayerDialog(playerid);

			// Сбросим все номера телефонов
			if(server == 0 && PlayerInfo[playerid][pDrugPerk] == 0) NumberSmartfonPlayer(playerid);

			// Баг трекер для админов
			//AdminBugTracker(playerid);

			// Выключаем музыку
			if(OnlineInfo[playerid][oListenRadioPears] == 0) StopAudioStreamForPlayer(playerid);

			// Загружаем подсказки
			mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_igroki_hint` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "Call_OnPlayerHintLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Ловушка для акулы сработала
			if(Trap[playerid] == 2) MessageSharkTrap(playerid);

			// Обновляем данные для системы радаров
			Radar_OnPlayerConnect(playerid);

			// Получаем информацию об IP-адресе
			PlayerGeo_OnPlayerConnect(playerid);

			// Загружаем пользовательские данные о наркопритоне/лаборатории
			mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_user_narco_spots` WHERE `user_id` = %d", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "NarcoSpotPlayerLoad", "d", playerid);

			// Загружаем квест и маски маньяка для игрока
			mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_igroki_maniac` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "Call_OnPlayerMaskManiacLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);

			// Загружаем статистику для топа
			mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_igroki_top` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "Call_OnPlayerTopLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
			
			// Загружаем хеллуинский квест
			if(IsAHalloween())
			{
				mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_quest_temp` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
				mysql_tquery(pearsq, f_str2, "Call_OnPlayerHalloweenBallLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
			}
			// Новогодние системки
			if(IsANewYear())
			{
				mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_quest_temp` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
				mysql_tquery(pearsq, f_str2, "Call_OnPlayerNewYearLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
			}

			// Запускаем месячные
			TimeMenstruation(playerid);
			
			// BattlePass
			mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `battlepass` WHERE `user_id` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "OnPlayerBattlePassLoad", "dd",playerid, g_MysqlRaceCheck[playerid]);

			// Загружаем архив интерьеров игрока
			mysql_format(pearsq, f_str2, sizeof(f_str2), "SELECT * FROM `pp_pack_interiors` WHERE `piUserid` = '%d'", PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, f_str2, "Call_OnPlayerPackInteriorLoad", "dd", playerid, g_MysqlRaceCheck[playerid]);
           }
        }
      }
    }
	return 1;
}

stock UpdateContact(playerid, idx, stat)
{
	if(stat == 0)
	{
		if(ContactInfo[playerid][cFriend][idx] == 0)
		{
			new string_mysql[120];
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki_contacts` SET `c%d`= NULL WHERE `user_id` = '%d'", idx, PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, string_mysql);
		}
		else
		{
			new JsonNode:node = JSON_Object(
				"id", JSON_Int(ContactInfo[playerid][cFriend][idx]),
				"name", JSON_String(ContactName[playerid][idx])
			);

			new string_json[512];
			if (JSON_Stringify(node, string_json) == JSON_CALL_NO_ERR) 
			{
				new string_mysql[640];
				mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki_contacts` SET `c%d`= '%e' WHERE `user_id` = '%d'", idx, string_json, PlayerInfo[playerid][pID]);
				mysql_tquery(pearsq, string_mysql);
			}
		}
	}
	else
	{
		if(ContactInfo[playerid][cBlack][idx] == 0)
		{
			new string_mysql[120];
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki_contacts` SET `b%d`= NULL WHERE `user_id` = '%d'", idx, PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, string_mysql);
		}
		else
		{
			new JsonNode:node = JSON_Object(
				"id", JSON_Int(ContactInfo[playerid][cBlack][idx]),
				"name", JSON_String(BlackName[playerid][idx])
			);

			new string_json[512];
			if (JSON_Stringify(node, string_json) == JSON_CALL_NO_ERR) 
			{
				new string_mysql[640];
				mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki_contacts` SET `b%d`= '%e' WHERE `user_id` = '%d'", idx, string_json, PlayerInfo[playerid][pID]);
				mysql_tquery(pearsq, string_mysql);
			}
		}
	}
  	return 1;
}

function Call_loadcontact(playerid, race_check)
{
	new rows;
	cache_get_row_count(rows);
	if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);
	
	if(rows)
	{
        for(new c = 0; c < MAX_FRIENDS; c++)
		{
			new string[20];
			new bool:is_null;

			// Контакты
			format(string, sizeof(string), "c%d", c);
			cache_is_value_name_null(0, string, is_null);
			if(is_null == false)
			{
				new string_json[512];
				cache_get_value_name(0, string, string_json, 512);

				new JsonNode:node = JSON_INVALID_NODE;
				if (JSON_Parse(string_json, node) == JSON_CALL_NO_ERR) 
				{
					JSON_GetInt(node, "id", ContactInfo[playerid][cFriend][c]);
					JSON_GetString(node, "name", ContactName[playerid][c]);
				}
			}

			// Черный Список
			format(string, sizeof(string), "b%d", c);
			cache_is_value_name_null(0, string, is_null);
			if(is_null == false)
			{
				new string_json[512];
				cache_get_value_name(0, string, string_json, 512);

				new JsonNode: node = JSON_INVALID_NODE;
				if (JSON_Parse(string_json, node) == JSON_CALL_NO_ERR) 
				{
					JSON_GetInt(node, "id", ContactInfo[playerid][cBlack][c]);
					JSON_GetString(node, "name", BlackName[playerid][c]);
				}
			}
		}
	}
	else 
	{
		new string_mysql[70];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `pp_igroki_contacts` SET `user_id` = '%d'", PlayerInfo[playerid][pID]);
		query_empty(pearsq, string_mysql);
	}
	return 1;
}
function Call_loadachieve(playerid, race_check)
{
	new rows;
	cache_get_row_count(rows);
	if(g_MysqlRaceCheck[playerid] != race_check) return Kickx(playerid);
	if(rows)
	{
        for(new a = 0; a < MAX_ACHIEVE; a++)
		{
			new string[20];
			new bool:is_null;
			format(string, sizeof(string), "a%d", a);
			cache_is_value_name_null(0, string, is_null);

			if(is_null == false)
			{
				new string_json[512];
				cache_get_value_name(0, string, string_json, 512);

				new JsonNode:node = JSON_INVALID_NODE;
				if (JSON_Parse(string_json, node) == JSON_CALL_NO_ERR) 
				{
					JSON_GetInt(node, "info", PlayerInfo[playerid][pAchieve][a]);
					JSON_GetInt(node, "unix", PlayerInfo[playerid][pAchieveUnix][a]);
					JSON_GetInt(node, "stat", PlayerInfo[playerid][pAchieveStat][a]);
				}
			}
		}
	}
	else 
	{
		new string_mysql[70];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `pp_achieve` SET `user_id` = '%d'", PlayerInfo[playerid][pID]);
		query_empty(pearsq, string_mysql);
	}
	PlayerInfo[playerid][pAchieveLoad] = true;
	
	// Проверка Голды на Аккаунте
	if(PlayerInfo[playerid][pAchieve][26] == 0 && PlayerInfo[playerid][pDonateMoney] >= 10000) AchievePlayer(playerid, 26, 1);
	// Проверка на Лидера
	if(PlayerInfo[playerid][pAchieve][48] == 0 && PlayerInfo[playerid][pLeader] >= 1) AchievePlayer(playerid, 48, 1);
	// Проверка на Админа
	if(PlayerInfo[playerid][pAchieve][49] == 0 && PlayerInfo[playerid][pSoska] >= 2) AchievePlayer(playerid, 49, 1);
	// Проверка на Эксперта
	if(PlayerInfo[playerid][pAchieve][66] == 0 && PlayerInfo[playerid][pExpert] >= 1) AchievePlayer(playerid, 66, 1);
	// Проверка на существующую Випку
	if(PlayerInfo[playerid][pAchieve][118] == 0 && PlayerInfo[playerid][pDonateRank] == 4) AchievePlayer(playerid, 118, 1);
	// Проверка на военник
	if(PlayerInfo[playerid][pAchieve][65] == 0 && PlayerInfo[playerid][pBilet] == 1) AchievePlayer(playerid, 65, 1);
	return 1;
}

stock UpdateAchieve(playerid, a)
{
	if(PlayerInfo[playerid][pAchieve][a] == 0)
	{
		new string_mysql[120];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_achieve` SET `a%d`= NULL WHERE `user_id` = '%d'", a, PlayerInfo[playerid][pID]);
		mysql_tquery(pearsq, string_mysql);
	}
	else
	{
		new JsonNode:node = JSON_Object(
			"info", JSON_Int(PlayerInfo[playerid][pAchieve][a]),
			"unix", JSON_Int(PlayerInfo[playerid][pAchieveUnix][a]),
			"stat", JSON_Int(PlayerInfo[playerid][pAchieveStat][a])
		);

		new string_json[512];
		if (JSON_Stringify(node, string_json) == JSON_CALL_NO_ERR) 
		{
			new string_mysql[640];
			mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_achieve` SET `a%d`= '%e' WHERE `user_id` = '%d'", a, string_json, PlayerInfo[playerid][pID]);
			mysql_tquery(pearsq, string_mysql);
		}
	}
  	return 1;
}

