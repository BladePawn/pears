	else if(IsPlayerInRangeOfPoint(playerid,2.0,2191.8091,1938.2816,68.0781) && GetPlayerVirtualWorld(playerid) == WORLD_GYM_HALL && GetPlayerInterior(playerid) == INT_GYM_HALL)
	{
