						format(string, sizeof(string), "\n{ff33ff}%s {cccccc}предлагает вам заняться {ff33ff}Анальным Сексом\n\n{ffffff}Вы согласны?", playername(playerid));
						ShowDialog(giveplayerid,839,DIALOG_STYLE_MSGBOX,"{ff33ff}Секс",string,"Да","Нет");
						format(string, sizeof(string), "[ Мысли ]: Я предлагаю {ffffff}%s {cccccc}заняться {ff33ff}Анальным Сексом", playername(giveplayerid));
