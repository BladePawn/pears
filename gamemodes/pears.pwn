stock SetSpawnInHotel(playerid, frakid, models)
{
	if(PlayerInfo[playerid][pKomnata] != 9999 && PlayerInfo[playerid][pKomnata] >= 1)
	{
		if(PlayerInfo[playerid][pKomnataCity] <= 1) ProtectSetSpawnInfo(playerid, frakid, models, 1659.3291,-2273.7668,30.3279, 180.0, 0, 0, 0, 0, 0, 0);
		else ProtectSetSpawnInfo(playerid, frakid, models, 1759.1321,1381.7913,28.0187,132.5543, 0, 0, 0, 0, 0, 0);
	}
	else
	{
		if(PlayerInfo[playerid][pKomnataCity] <= 1)
		{
			switch(random(5))
			{
				case 0: ProtectSetSpawnInfo(playerid, frakid, models, 1604.0627,-2276.5786,13.5228, 182.1165, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
				case 1: ProtectSetSpawnInfo(playerid, frakid, models, 1600.1864,-2276.7048,13.5256, 179.9231, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
				case 2: ProtectSetSpawnInfo(playerid, frakid, models, 1595.5018,-2276.1111,13.5291, 182.7432, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
				case 3: ProtectSetSpawnInfo(playerid, frakid, models, 1598.8920,-2299.5447,13.5430, 0.7182, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
				case 4: ProtectSetSpawnInfo(playerid, frakid, models, 1621.7104,-2297.5889,13.5402, 70.5923, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 4;
			}
		}
		else
		{
			switch(random(5))
			{
				case 0: ProtectSetSpawnInfo(playerid, frakid, models, 1724.6954,1419.8087,10.8467, 285.4941, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 0;
				case 1: ProtectSetSpawnInfo(playerid, frakid, models, 1730.2910,1407.5309,10.8467, 346.5947, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 1;
				case 2: ProtectSetSpawnInfo(playerid, frakid, models, 1749.1842,1421.8966,10.8767, 66.4954, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 2;
				case 3: ProtectSetSpawnInfo(playerid, frakid, models, 1754.4534,1427.4142,10.8767, 79.9688, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 3;
				case 4: ProtectSetSpawnInfo(playerid, frakid, models, 1753.0085,1436.7079,10.8767, 106.2891, 0, 0, 0, 0, 0, 0), Protect_Spawn[playerid] = 4;
			}
		}
	}
	return 1;
}

stock ACGetPlayerHealth(playerid, &Float:helalph)
{
	if (!IsOnline(playerid)) return 0;
	
	helalph = HealthAC[playerid];
	return 1;
}
stock ACGetPlayerArmour(playerid,&Float:helalph)
{
	if (!IsOnline(playerid)) return 0;

	helalph = PlayerInfo[playerid][pArmor];
	return 1;
}

stock ACSetPlayerHealth(playerid, Float:helalph)
{
	if(debugDeath) SendClientMessage(playerid, COLOR_GREY,"[debug] ACSetPlayerHealth %s %f", PlayerInfo[playerid][pName], helalph);

	if (!IsOnline(playerid)) return 0;

	new result; // Результат смерти

	HP_Tick[playerid] = GetTickCount();
	HealthAC[playerid] = helalph;
	if(HealthAC[playerid] <= 0)
	{
		// Если игрок был в транспорте, высаживаем его
		if(IsPlayerInAnyVehicle(playerid)) RemovePlayerFromVehicle(playerid);

		// Игрок был живой
		if(DeathInfo[playerid][deathStatus] == false)
		{
			result = SetPlayerDeath(playerid, 0);
			if (result == 1) HealthAC[playerid] = GetMaxPlayerHealth(playerid) * 0.9;
		}
		else // Игрок был мертв
		{
			// Отправляем в госпиталь после смерти
			if(!NoHospital(playerid) && gYda[playerid] == 0) 
			{
				DeathEnd(playerid, 2);
				GoPlayerInHospital(playerid);
			}
		}
	}
	else if(HealthAC[playerid] >= GetMaxPlayerHealth(playerid))
	{
		HealthAC[playerid] = GetMaxPlayerHealth(playerid);
		if(DeathInfo[playerid][deathStatus]) DeathEnd(playerid, 1);
	}
	SetPlayerHealth(playerid, HealthAC[playerid]);
	return result;
}

// Отправляем игрока в госпиталь
stock GoPlayerInHospital(playerid)
{
	PlayerInfo[playerid][pJailed] = 4;
	PlayerInfo[playerid][pJailTime] = 600;
	gYda[playerid] = 2;
	return true;
}

stock ACSetPlayerArmour(playerid,Float:helalph)
{
	if (!IsOnline(playerid)) return 0;

	HA_Tick[playerid] = GetTickCount();
	PlayerInfo[playerid][pArmor] = helalph;
	
	if(PlayerInfo[playerid][pArmor] <= 0)
	{
		PlayerInfo[playerid][pArmor] = 0;
		if(IsArmor(PlayerInfo[playerid][pOdet][0])) RemoveAksess(playerid, 0);
		if(IsArmor(PlayerInfo[playerid][pOdet][1])) RemoveAksess(playerid, 1);
		if(IsArmor(PlayerInfo[playerid][pOdet][2])) RemoveAksess(playerid, 2);
		if(IsArmor(PlayerInfo[playerid][pOdet][3])) RemoveAksess(playerid, 3);
		if(IsArmor(PlayerInfo[playerid][pOdet][4])) RemoveAksess(playerid, 4);
	}
	else if(PlayerInfo[playerid][pArmor] >= 100.0) PlayerInfo[playerid][pArmor] = 100.0;
	SetPlayerArmour(playerid, PlayerInfo[playerid][pArmor]);
	return 1;
}

stock StopJob(playerid)
{
	switch(PlayerInfo[playerid][pPlacement])
	{
		case 7: ErrorMessage(playerid, "{FF6347}Вы не забрали зарплату в Транспортной Компании [ Y >> GPS >> Работа или /job ]");
		case 8: ErrorMessage(playerid, "{FF6347}Вы не забрали зарплату в Городской Клининговой Службе [ Y >> GPS >> Работа или /job  ]");
		case 9: ErrorMessage(playerid, "{FF6347}Вы не забрали зарплату на Ферме [ Y >> GPS >> Работа или /job  ]");
		case 10: ErrorMessage(playerid, "{FF6347}Вы не забрали зарплату в Автобусном Депо [ Y >> GPS >> Работа или /job  ]");
		case 13: ErrorMessage(playerid, "{FF6347}Вы не забрали зарплату на работе Инкассатором [ Y >> GPS >> Работа или /job  ]");
		default: return PlayerInfo[playerid][pPlacement] = 0, PlayerInfo[playerid][pSalary] = 0, mysql_save(playerid, 58), ErrorMessage(playerid, "{FF6347}До обновления вы работали на работе, которая сейчас удалена {cccccc}[ История работы очищена ]\n\n{ff9000}Теперь повторите трудоустройство, чтобы начать работу");
	}
	return 1;
}
stock PPExitSpectating(playerid)
{
	PPSetSpawnInfo(playerid);
	PPTogglePlayerSpectating(playerid, false);
	return 1;
}

stock PPTogglePlayerSpectating(playerid, bool:status)
{
	new bool:success = TogglePlayerSpectating(playerid, status);
	if (success) OnlineInfo[playerid][oSpec] = status;
	return success;
}

stock PPSpawnPlayer(playerid)
{
	#if defined NPC_SAMP
	if(IsPlayerNPC(playerid))
	{
		SetNpcSpawn(playerid);
		SpawnPlayer(playerid);
	}
	#endif

	// Защита от игнора спавна
	OnlineInfo[playerid][oSpawnDo] = true;
	OnlineInfo[playerid][oSpawnUnix] = gettime();

	PPSetSpawnInfo(playerid);
	SpawnPlayer(playerid);

	// Проходим по погоде и времени ещё разок
	PearsWeather(playerid);
	PearsTime(playerid);
	return 1;
}

stock PPOpenSpectating(playerid, Float:x, Float:y, Float:z)
{
	ProteStat[playerid] = 14;
	GetPlayerPos(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // Protect Project
	Protect_X[playerid] = x; Protect_Y[playerid] = y; Protect_Z[playerid] = z; // Protect Project
	Move_X[playerid] = x, Move_Y[playerid] = y, Move_Z[playerid] = z;
	AfterProtect_X[playerid] = x; AfterProtect_Y[playerid] = y; AfterProtect_Z[playerid] = z; // Protect Project
	PPTogglePlayerSpectating(playerid, true);
	return 1;
}

stock EjectCar(playerid, vehicleid)
{
	if(vehicleid != INVALID_VEHICLE_ID) // Проверка на правильность ID транспорта
	{
		if(IsOnline(playerid)) // В сети ли игрок
		{
			if(GetPVarInt(playerid,"afksystem") <= 1)
			{
				new Float:X, Float:Y ,Float:Z, Float:A;
		  		GetVehiclePos(vehicleid, X, Y, Z);
		    	GetVehicleZAngle(vehicleid, A);
		     	X = X + 4.5 * floatsin(-A, degrees);
		      	Y = Y + 4.5 * floatcos(-A, degrees);
		       	PPSetPlayerPos(playerid, X, Y, Z);
		        PPSetPlayerFacingAngle(playerid, A + 180.0);

		        if(!IsPlayerInRangeOfPoint(playerid, 1.0, X, Y, Z))
				{
     				printf("[SProtect Kick]: Seat Drive Car %s", PlayerInfo[playerid][pName]);
					SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Seat Drive Car]");
					ShowDialog(playerid, 1700, DIALOG_STYLE_MSGBOX, "{ff0000}Protect Project", "{ff0000}Вы были кикнуты по подозрению в читерстве [Seat Drive Car]", "*", "");
					Kickx(playerid);
	    			return 1;
  				}
	        }
	        else PPSpawnPlayer(playerid);
        }
	}
	return 1;
}

