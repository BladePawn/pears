	if(sscanf(params, "s[121]", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сокращённое действие [ /rme действие (reduction me) или /ame ]");
	new string[144];
	if(isamute(playerid) == 1) return 1;
	if(AntiFloodText(playerid, params[0])) return 1;

	format(string, sizeof(string), "%s", params[0]);
	SetPlayerChatBubble(playerid,string,COLOR_PURPLE,30.0,7000);
	format(string, sizeof(string), ">> %s %s", playername(playerid), params[0]);
	SendClientMessage(playerid, COLOR_PURPLE, string);
