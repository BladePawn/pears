stock UpdatePotreb(playerid)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;
	new string[24];
	
	new satityPlayer = PlayerInfo[playerid][pNeon];
	if(satityPlayer >= 994) satityPlayer = 1000;
	
	if(getillness(playerid, 18) >= 0)
	{
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), "„A„ѓA:_%d/100", satityPlayer/10);
		else format(string, sizeof(string), "SATIETY:_%d/100", satityPlayer/10);
	}
	else
	{
		if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), "C‘ЏOCЏ’:_%d/100", satityPlayer/10);
		else format(string, sizeof(string), "SATIETY:_%d/100", satityPlayer/10);
	}
	PlayerTextDrawSetString(playerid, PlaNestNeeds[4][playerid], string);
	if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlaNestNeeds[4][playerid], 673720575);
	else PlayerTextDrawColour(playerid, PlaNestNeeds[4][playerid], -1);
	PlayerTextDrawShow(playerid, PlaNestNeeds[4][playerid]);
	if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), "HY„ѓA:_%d/100", PlayerInfo[playerid][pCap]);
	else format(string, sizeof(string), "TOILET:_%d/100", PlayerInfo[playerid][pCap]);
	PlayerTextDrawSetString(playerid, PlaNestNeeds[6][playerid], string);
	if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlaNestNeeds[6][playerid], 673720575);
	else PlayerTextDrawColour(playerid, PlaNestNeeds[6][playerid], -1);
	PlayerTextDrawShow(playerid, PlaNestNeeds[6][playerid]);
	if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), "‚…‚…EHA:_%d/100", PlayerInfo[playerid][pInfoload]/10);
	else format(string, sizeof(string), "HYGIENE:_%d/100", PlayerInfo[playerid][pInfoload]/10);
	PlayerTextDrawSetString(playerid, PlaNestNeeds[7][playerid], string);
	if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlaNestNeeds[7][playerid], 673720575);
	else PlayerTextDrawColour(playerid, PlaNestNeeds[7][playerid], -1);
	PlayerTextDrawShow(playerid, PlaNestNeeds[7][playerid]);
	if(PlayerInfo[playerid][pDrawLanguage] == false && Device[playerid] != 1) format(string, sizeof(string), "ЂOѓPOCЏ’:_%d/100", PlayerInfo[playerid][pMechSkill]/10);
	else format(string, sizeof(string), "ENERGY:_%d/100", PlayerInfo[playerid][pMechSkill]/10);
	PlayerTextDrawSetString(playerid, PlaNestNeeds[5][playerid], string);
	if(PlayerInfo[playerid][pSty] == 6 || PlayerInfo[playerid][pSty] == 11) PlayerTextDrawColour(playerid, PlaNestNeeds[5][playerid], 673720575);
	else PlayerTextDrawColour(playerid, PlaNestNeeds[5][playerid], -1);
	PlayerTextDrawShow(playerid, PlaNestNeeds[5][playerid]);

    new Float:positiond_x, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 7 || setting_size_draw[playerid] == 7) positiond_x = inventdraw_x+set_pos_x[playerid];
    else positiond_x = inventdraw_x+PlayerInfo[playerid][pDrawPos_X][6];

    if(setting_pos_draw[playerid] == 7 || setting_size_draw[playerid] == 7) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][6], sized_y = PlayerInfo[playerid][pDrawSize_Y][6];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[6], sized_y += DrawSizeSmart_Y[6];

    new Float:vrem_x, Float:vrem_y, Float:vrem_x2, Float:vrem_y2;
    PlayerTextDrawGetPos(playerid, PlaNestGun[5][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetPos(playerid, PlaNestAkses[4][playerid], vrem_x2, vrem_y2);
	new Float:otstyp_x = 4.0+sized_x/8, Float:otstyp_y = 4.0+sized_y/8;
	new Float:size_pick_menu_X = 33.0+sized_x/2, Float:size_pick_menu_Y = 33.0+sized_y/2;
	new Float:size_gun_X = size_pick_menu_X/2-(1.0/2), Float:size_gun_Y = size_pick_menu_Y/2-(1.0/2);
	new Float:pos_potreb_X = positiond_x+size_pick_menu_X+otstyp_x, Float:pos_potreb_Y = vrem_y+size_gun_Y+otstyp_y; // Начало расположения потребностей
    new Float:size_potreb_X = (vrem_x+size_gun_X)-pos_potreb_X, Float:size_potreb_Y = (vrem_y2+size_pick_menu_Y)-pos_potreb_Y-otstyp_y*3; // Размер окна с потребностями
 	new Float:pick_potreb_X = (size_potreb_X)-2.0, Float:pick_potreb_Y = (size_potreb_Y/4)-2.0;
 	
	if(satityPlayer >= 10) // Голод
	{
	    new stat = satityPlayer/10;
		new Float:defa = 0.0; // Max = 79.666664
		new Float:plusik = stat*(pick_potreb_X/100);
		PlayerTextDrawTextSize(playerid, PlaNestNeeds[0][playerid], defa+plusik, pick_potreb_Y);
		PlayerTextDrawColour(playerid, PlaNestNeeds[0][playerid], PlayerInfo[playerid][pStyle1]);
		PlayerTextDrawShow(playerid, PlaNestNeeds[0][playerid]);
	}
	if(PlayerInfo[playerid][pCap] >= 1) // Piss
	{
	    new stat = PlayerInfo[playerid][pCap];
		new Float:defa = 0.0; // Max = 79.666664
		new Float:plusik = stat*(pick_potreb_X/100);
		PlayerTextDrawTextSize(playerid, PlaNestNeeds[2][playerid], defa+plusik, pick_potreb_Y);
		PlayerTextDrawColour(playerid, PlaNestNeeds[2][playerid], PlayerInfo[playerid][pStyle2]);
		PlayerTextDrawShow(playerid, PlaNestNeeds[2][playerid]);
	}
	if(PlayerInfo[playerid][pInfoload] >= 10) // Гигиена
	{
	    new stat = PlayerInfo[playerid][pInfoload]/10;
		new Float:defa = 0.0; // Max = 79.666664
		new Float:plusik = stat*(pick_potreb_X/100);
		PlayerTextDrawTextSize(playerid, PlaNestNeeds[3][playerid], defa+plusik, pick_potreb_Y);
		PlayerTextDrawColour(playerid, PlaNestNeeds[3][playerid], PlayerInfo[playerid][pStyle2]);
		PlayerTextDrawShow(playerid, PlaNestNeeds[3][playerid]);
	}
	if(PlayerInfo[playerid][pMechSkill] >= 1)// Усталость
	{
	    new stat = PlayerInfo[playerid][pMechSkill];
		new Float:defa = 0.0; // Max = 79.666664
		new Float:plusik = stat*(pick_potreb_X/1000);
		PlayerTextDrawTextSize(playerid, PlaNestNeeds[1][playerid], defa+plusik, pick_potreb_Y);
		PlayerTextDrawColour(playerid, PlaNestNeeds[1][playerid], PlayerInfo[playerid][pStyle2]);
		PlayerTextDrawShow(playerid, PlaNestNeeds[1][playerid]);
	}
	return 1;
}
public Float:GetVehicleSpeed(playerid)
{
    new Float:Pos[3];
    GetVehicleVelocity(GetPlayerVehicleID(playerid),Pos[0],Pos[1],Pos[2]);
    return floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1] + Pos[2] * Pos[2]) * 100.3;
}
public Float:GetPlayerSpeed(playerid)
{
    new Float:Pos[3];
    GetPlayerVelocity(playerid,Pos[0],Pos[1],Pos[2]);
    return floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1] + Pos[2] * Pos[2]) * 100.0;
}
public Float:NonRPEzda(playerid)
{
      new Float:Pos[3];
      GetPlayerVelocity(playerid,Pos[0],Pos[1],Pos[2]);
      return floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1]) * 140.0;
}
public Float:AntiSpeedHack(playerid)
{
      new Float:Pos[3];
      GetVehicleVelocity(GetPlayerVehicleID(playerid),Pos[0],Pos[1],Pos[2]);
      return floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1]) * 140.0;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	if(ADUTY[playerid] == 0 && NameTag[forplayerid] == true) ShowPlayerNameTagForPlayer(playerid, forplayerid, false);
    return 1;
}
public OnPlayerStreamOut(playerid, forplayerid)
{
    return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 1;

	// Лейбл кастомного транспорта
	if(VehInfo[vehicleid][vModel] >= 2000 && PlayerInfo[forplayerid][pCustomLabel] == 0) 
	{
		new Float:dist = 12.0;
    	if(VehShopInfo[forplayerid][vsVehicleLoad] == true && VehShopInfo[forplayerid][vsVehicleID] == vehicleid) dist = 40.0;
		CreateCustomVehicleLabel(forplayerid, vehicleid, dist);
	}

	// Музыка в транспорте
	if(IsVehicleHavingMusicStream(vehicleid) && IsPlayerSyncModels(forplayerid)) CreateRadioVehicleLabel(forplayerid, vehicleid, 12.0);

	// Обновляем статус дверей
    if(VehInfo[vehicleid][vCarLock] == 0) SetVehicleParamsForPlayer(vehicleid,forplayerid,false,false); // Делаем Тачку Открытой
    else if(VehInfo[vehicleid][vCarLock] == 1) SetVehicleParamsForPlayer(vehicleid,forplayerid,false,true); // Делаем Тачку Закрытой

	// Инкассаторская машина
	if(vehicleid == collectorveh && NPCInfo[3][npcStart] == true) SetVehicleParamsForPlayer(vehicleid, forplayerid, true, true);

	// Самолёт
	if(vehicleid == flyveh && NPCInfo[4][npcStart] == true) SetVehicleParamsForPlayer(vehicleid, forplayerid, true, true);

	// Доминик
	if(vehicleid == dominicveh && NPCInfo[5][npcStart] == true) SetVehicleParamsForPlayer(vehicleid, forplayerid, true, true);
    return 1;
}
public OnVehicleStreamOut(vehicleid, forplayerid)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 1;

	// Лейбл кастомного транспорта
	if(PlayerInfo[forplayerid][pCustomLabel] == 0) DestroyCustomVehicleLabel(forplayerid, vehicleid);

	// Музыка в транспорте
	if(IsVehicleHavingMusicStream(vehicleid) && IsPlayerSyncModels(forplayerid)) DestroyRadioVehicleLabel(forplayerid, vehicleid);
    return 1;
}

// Защита от подмены интерьера
stock AntiNopInteriorChange(playerid)
{
	if(OnlineInfo[playerid][oInteriorTime] <= 0 && OnlineInfo[playerid][oInteriorChange] == true
		&& OnlineInfo[playerid][oInteriorPlayer] != GetPlayerInterior(playerid))
	{
		printf("[SProtect Kick]: NopInterior %s (GetPlayerInterior: %d oInteriorPlayer: %d) (ping: %d)",
			PlayerInfo[playerid][pName], GetPlayerInterior(playerid), OnlineInfo[playerid][oInteriorPlayer], GetPlayerPing(playerid));
        SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [NopInterior]");
        ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [NopInterior]","*","");
        Kickx(playerid);
		return 1;
	}
	return 0;
}

// Проверка на afk игрока
stock IsPlayerAfk(playerid) return GetPVarInt(playerid,"afksystem") >= 3;

public OnPlayerUpdate(playerid)
{
	// Блокируем апдейты, если кикаем игрока
	if(OnlineInfo[playerid][oKickTimer] > 0) return 0;

	// Если игрок NPC, игнорируем все проверки и обработки
	if(IsPlayerNPC(playerid)) return 1;

	// Защита от высокого пинга
	if(GetPlayerPing(playerid) >= 1000) //Максимальный пинг игрока
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по по причине: Высокий Пинг %d [Code: 1011])",GetPlayerPing(playerid));
		ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по причине: Высокий Пинг","*","");
		Kickx(playerid);//кикаем
		return 0;
	}

	// Защита от подмены интерьера
	if(AntiNopInteriorChange(playerid)) return false;

    TeleportCheat(playerid);

	// Если машина в автосервисе поменялась
	{
		new vehicleid = OnlineInfo[playerid][oAutoserviceVeh];
		new vehiclenewid = OnlineInfo[playerid][oAutoserviceVehNewid];
		if (vehicleid > 0 && vehicleid != GetPlayerVehicleID(playerid))
		{
			if (IsValidVehicle(vehicleid) && vehiclenewid == VehInfo[vehicleid][vNewid])
			{
				foreach (new id : Player)
				{
					if (id == playerid) continue;

					new curvehicleid = GetPlayerVehicleID(id);
					if (IsValidVehicle(curvehicleid) && curvehicleid == vehicleid)
					{
						if (GetPlayerVehicleSeat(id) == 0)
						{
							SetPlayerPos(id, Protect_X[id], Protect_Y[id], Protect_Z[id] + 0.5);
							break;
						}
					}
				}
				
				if (!OnlineInfo[playerid][oTimerAutoservice]) {
					Protect_PutPlayerInVehicle(playerid, vehicleid, 0);
					SetTimerEx("CloseVehSpeed", 1000, false, "d", playerid);
					TogglePlayerControllable(playerid, false);
					S_SetPlayerVirtualWorld(playerid,playerid+1,223);
					PPSetPlayerInterior(playerid,223);
					playerDefaultCameraAutoservice(playerid);
				}
			} else {
				ExitTuning(playerid);
				ErrorMessage(playerid, "{ff6347}Произошла ошибка, вы были автоматически возвращены из автосервиса");
			}
		}
	}

	// Возвращаем на позицию до AFK
	if(IsPlayerAfk(playerid))
	{
		new seat = GetPlayerVehicleSeat(playerid);

		// Серф на транспорте или на объекте
		if(GetPlayerSurfingVehicleID(playerid) != INVALID_VEHICLE_ID || GetPlayerSurfingObjectID(playerid) != INVALID_OBJECT_ID)
		{
			PPSetPlayerPos(playerid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
		}

		// Сидит на пассажирском месте
		else if(IsPlayerInAnyVehicle(playerid) && seat > 0)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(VehInfo[vehicleid][vSeat] == 0)
			{
				new Float:vehposX, Float:vehposY, Float:vehposZ;
				GetVehiclePos(vehicleid, vehposX, vehposY, vehposZ);
				SendSetVehiclePosRpc(playerid, vehicleid, vehposX, vehposY, vehposZ);
				PPSetPlayerPos(playerid, vehposX, vehposY, vehposZ);
				PutPlayerInVehicle(playerid, vehicleid, seat);
			}
		}
	}

	// Если игрок не залогинился, все другие функции пропускаем
	if(OnlineInfo[playerid][oLogged] == 0) return true;

    AntiMoneyCheat(playerid);

    new Float:dist = GetPlayerDistanceFromPoint(playerid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]); // Текущая
	new Float:dist_before = GetPlayerDistanceFromPoint(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid], BeforeProtect_Z[playerid]); // До
	new Float:dist_after = GetPlayerDistanceFromPoint(playerid, AfterProtect_X[playerid], AfterProtect_Y[playerid], AfterProtect_Z[playerid]); // После
	new Float:skora;
	if(!IsPlayerInAnyVehicle(playerid)) // Игрок пешком
	{
		if(camerni == playerid && camerni >= 0)
		{
			new string[144];
	        format(string, sizeof(string), "%f", PlayerSpeedPlane(playerid)), SendFounder(string);
		}
		new Float:Pos[3], Float:posic[3];
		GetPlayerVelocity(playerid,Pos[0],Pos[1],Pos[2]);
		skora = floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1] + Pos[2] * Pos[2]) * 100.0;
		GetPlayerPos(playerid, posic[0], posic[1], posic[2]);
		if(kogofind == playerid && kogofind >= 0)
		{
			new string[144];
			format(string, sizeof(string), "[%d] (HP: %.2f) %.4f, %.4f, %.4f (%.4f) [dist_c: %.4f] [dist_b: %.4f] [dist_a: %.4f] state %d", playerid, HealthAC[playerid], posic[0], posic[1], posic[2], skora, dist,dist_before,dist_after, GetPlayerState(playerid));
			SendFounder(string);
		}
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && OnlineInfo[playerid][oLogged] == 1)
 		{
 			if(PlayerInfo[playerid][pSoska] <= 1) AntiCoordMaster(playerid);

			// Защита от падения под текстуры
			if(posic[2] <= -70.0 && OnlineInfo[playerid][oSpawnDo] == false)
			{
				// Если спавн игрока под текстурами и он мёртый, возврат на спавн будет его без конца тыкать в ту-же позицию
				// Для этого мы сбрасываем статус смерти, чтобы вернуть бедолагу на нормальный спавн
				new team, skin, Float:spawnX, Float:spawnY, Float:spawnZ, Float:angle, WEAPON:weapon1, ammo1, WEAPON:weapon2, ammo2, WEAPON:weapon3, ammo3;
				GetSpawnInfo(playerid, team, skin, spawnX, spawnY, spawnZ, angle, weapon1, ammo1, weapon2, ammo2, weapon3, ammo3);
				if(spawnZ <= -70.0 && DeathInfo[playerid][deathStatus] == true) DeathInfo[playerid][deathStatus] = false;

				PPSpawnPlayer(playerid);
				SendClientMessage(playerid, COLOR_LIGHTRED, "* Вы упали под текстуры и были отправлены на Spawn.");
				ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{000000}.","{FF6347}Вы упали под текстуры и были отправлены на Spawn","Oк","");
				return 0;
			}

			if(testanti == playerid && testanti >= 0)
			{
   				new string[144], animname[32], animlib[32];
       			GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
		        format(string, sizeof(string), "Anim: %s %s", animlib, animname);
		        SendFounder(string);
			}
			
			new bool: disableTeleportAC = false;
			#if defined ADMINS_DISABLE_TELEPORT_AC
				if (PlayerInfo[playerid][pSoska] >= 1 && server > 0) disableTeleportAC = true;
				if (PlayerInfo[playerid][pSoska] >= 2 && server > 0) disableTeleportAC = true;
				if (serverType == 0) disableTeleportAC = true;
			#endif

			// Временный костыль, чтобы игроков не кикало когда они на мгновение появляются на респе grove street
			if(IsPlayerInRangeOfPoint(playerid, 10.0, 2488.562011, -1666.864013, 13.875699)
				&& DeathInfo[playerid][deathStatus] == true) disableTeleportAC = true;

			if(!disableTeleportAC && protect[5] == 0) // Teleport Player
			{
				if(dist >= 20.0 && dist_before >= 20.0 && dist_after >= 20.0) // Маленький прыжок
				{
					if(dist >= 80.0 && dist_before >= 80.0 && dist_after >= 80.0) // Слишком сильный прыжок
					{
						PrintSprotect2(playerid, posic[0], posic[1], posic[2], dist, dist_before, dist_after);
						new string[121];
					    printf("[SProtect Kick]: Teleport Player %s (80 m)",PlayerInfo[playerid][pName]);
						format(string, sizeof(string), " [ PP ]: %s[%d] Teleport Player (ping %d) {cccccc}[ KICK ]", PlayerInfo[playerid][pName], playerid, GetPlayerPing(playerid)), ABroadCast(COLOR_ADM,string,2);
						SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [ Teleport Player ]");
						ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [ Teleport Player ]","*","");
						Kickx(playerid);
						return 0;
					}
					else
					{
						ProteWarn[playerid] ++;
						if(ProteWarn[playerid] >= 3)
						{
							PrintSprotect2(playerid, posic[0], posic[1], posic[2], dist, dist_before, dist_after);
							new string[121];
						    printf("[SProtect Kick]: Teleport Player Warning %s (20 m)",PlayerInfo[playerid][pName]);
						 	format(string, sizeof(string), " [ PP ]: %s[%d] Teleport Player (ping %d) {cccccc}[ warning KICK ]", PlayerInfo[playerid][pName], playerid, GetPlayerPing(playerid));
							ABroadCast(COLOR_ADM,string,2);
						    SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве (warning) [ Teleport Player ]");
							ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве (warning) [ Teleport Player ]","*","");
							Kickx(playerid);
							return 0;
			    		}
	    			}
				}
			}
			if(Sniper[playerid] == 0)
			{
			    if(GetPlayerCameraMode(playerid) == CAM_MODE_SNIPER || GetPlayerCameraMode(playerid) == CAM_MODE_CAMERA)
			    {
			    	Sniper[playerid] = 1;
			    	if(PlayerInfo[playerid][pOdet][0] > 0) RemovePlayerAttachedObject(playerid, 5);
			    	if(PlayerInfo[playerid][pOdet][1] > 0) RemovePlayerAttachedObject(playerid, 6);
			    	if(PlayerInfo[playerid][pOdet][2] > 0) RemovePlayerAttachedObject(playerid, 7);
			    	if(PlayerInfo[playerid][pOdet][3] > 0) RemovePlayerAttachedObject(playerid, 8);
			    	if(PlayerInfo[playerid][pOdet][4] > 0) RemovePlayerAttachedObject(playerid, 9);
			    }
			}
		}
	}
	else
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 		{
 			new veh = GetPlayerVehicleID(playerid);

			if(VehInfo[veh][vModel] == 433 && VehicleEscort > 0 && VehicleEscort == veh && EscortStatus == 2) CheckInSquareEscort(playerid, veh); // Escort NGSA

 			if(camerni == playerid && camerni >= 0)
			{
				new string[144];
		        format(string, sizeof(string), "%f", VehicleSpeedPlane(veh));
		        SendFounder(string);
			}

			new Float:vhp;
			GetVehicleHealth(veh, vhp);

			// Античит на хп транспорта
			new current_tick = GetTickCount();
			new interval = GetTickDiff(current_tick, VehInfo[veh][vHealthFix]);
			if(interval >= 3000) // Если с последнего ремонта прошло больше 3 секунд
			{
				if(vhp > VehInfo[veh][vHealth]) vhp = VehInfo[veh][vHealth], SetVehicleHealth(veh, vhp); // Возвращаем хп, если оно выше записанного
			}
			VehInfo[veh][vHealth] = vhp;
			//

			if(vhp > 0 && vhp < 400.0 // ХП транспорта больше 0 и меньше 400
				&& !IsARC(veh)) // Не RC транспорт
			{
				// Выключаем Test Drive
				if(VehShopInfo[playerid][vsTest] && !IsAAir(VehInfo[veh][vModel])) closeTestDrive(playerid);
				else // Глушим двигатель при сильных повреждениях
				{
					if(VehInfo[veh][vEngine] == 1 && OnlineInfo[playerid][oFlipTriger] <= 0) engineStalled(playerid, veh);
				}

				VehInfo[veh][vHealth] = 400.0;
				SetVehicleHealth(veh, VehInfo[veh][vHealth]);
			}

  			new Float:Pos[3], Float:posic[3];
  			GetVehicleVelocity(veh,Pos[0],Pos[1],Pos[2]);
   			skora = floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1] + Pos[2] * Pos[2]) * 200.0;
   			GetPlayerPos(playerid, posic[0], posic[1], posic[2]);
   			//new Float:raznica = floatabs(skora-ProtectSpeed[playerid]); // Если так >= 80 - то можно считывать nobike если чел на мото не падает (срабатывает как резкая остановка)
			new Float:raznica = skora-ProtectSpeed[playerid];
   			if(kogofind == playerid && kogofind >= 0)
			{
				new string[180];
				//format(string, sizeof(string), "[%d] %f %f %f", playerid, Pos[0],Pos[1],Pos[2]);
				//SendFounder(string);
				format(string, sizeof(string), "[%d] %.4f, %.4f, %.4f (%.3f) [dist: %.3f] [dist_b: %.3f] [dist_a: %.3f] [Veh: %d] [raznica %.2f]", playerid, posic[0], posic[1], posic[2], skora, dist,dist_before,dist_after,veh, raznica);
				SendFounder(string);
			}
			if(dist >= 1.0 && (raznica >= 80.0 || raznica <= -80.0) && protect[9] == 0) // Rvanka (Рванка рывками)
			{
				new string[144];
				prote[4][playerid] ++;
				if(prote[4][playerid] >= 5)
				{
					printf("[SProtect Kick]: Rvanka Kick %s [dist: %f, raznica: %f]",PlayerInfo[playerid][pName], dist, raznica);
					format(string, sizeof(string), " [ PP ]: %s[%d] Rvanka Vehicle (ping %d)", PlayerInfo[playerid][pName], playerid, GetPlayerPing(playerid)), ABroadCast(COLOR_ADM,string,2);

					SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве (warning) [ Rvanka ]");
					ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве (warning) [ Rvanka ]","*","");
					Kickx(playerid);
					return false;
				}
				else
				{
					printf("[SProtect]: Rvanka (trigger) %s",PlayerInfo[playerid][pName]);
					TriggerCheat(playerid, 0);
				}
			}

			new bool: disableTeleportVehicleAC = false;
			#if defined ADMINS_DISABLE_TELEPORT_AC
				if (PlayerInfo[playerid][pSoska] >= 1 && server > 0) disableTeleportVehicleAC = true;
			#endif

			if(!disableTeleportVehicleAC && protect[2] == 0) // Teleport in Vehicle
			{
			    if(dist >= 20.0 && dist_before >= 20.0 && dist_after >= 20.0) // Маленький прыжок
				{
					if(dist >= 300.0 && dist_before >= 300.0 && dist_after >= 300.0) // Слишком сильный прыжок
					{
					    new string[121];
					    PrintSprotect1(playerid, posic[0], posic[1], posic[2], dist, dist_before, dist_after);
					    printf("[SProtect Kick]: TP Driver 300m %s",PlayerInfo[playerid][pName]);
						format(string, sizeof(string), " [ PP ]: %s[%d] Teleport in Vehicle (ping %d) {cccccc}[ KICK ]", PlayerInfo[playerid][pName], playerid, GetPlayerPing(playerid)), ABroadCast(COLOR_ADM,string,2);

						SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [ Teleport in Vehicle ]");
						ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [ Teleport in Vehicle ]","*","");
						Kickx(playerid);
					}
					else if(dist >= 100.0 && dist_before >= 100.0 && dist_after >= 100.0) // Cильный прыжок
					{
						ProteWarn[playerid] ++;
						if(ProteWarn[playerid] >= 2) // повторения, кикаем
						{
							new string[121];
							PrintSprotect1(playerid, posic[0], posic[1], posic[2], dist, dist_before, dist_after);
							printf("[SProtect Kick]: TP Driver 100m Warning %s",PlayerInfo[playerid][pName]);
							format(string, sizeof(string), " [ PP ]: %s[%d] Teleport in Vehicle (ping %d) {cccccc}[ warning KICK 100m ]", PlayerInfo[playerid][pName], playerid, GetPlayerPing(playerid)), ABroadCast(COLOR_ADM,string,2);

							SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [ Teleport in Vehicle ]");
							ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [ Teleport in Vehicle ]","*","");
							Kickx(playerid);
						}
					}
					else
					{
						ProteWarn[playerid] ++;
						if(ProteWarn[playerid] >= 3)
						{
						    new string[121];
						    PrintSprotect1(playerid, posic[0], posic[1], posic[2], dist, dist_before, dist_after);
						    printf("[SProtect Kick]: TP Driver 20m Warning %s",PlayerInfo[playerid][pName]);
						    format(string, sizeof(string), " [ PP ]: %s[%d] Teleport in Vehicle (ping %d) {cccccc}[ warning KICK 20m ]", PlayerInfo[playerid][pName], playerid, GetPlayerPing(playerid));
							ABroadCast(COLOR_ADM,string,2);
						    
							SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве (warning) [ Teleport in Vehicle ]");
							ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве (warning) [ Teleport in Vehicle ]","*","");
							Kickx(playerid);
			    		}
	    			}
				}
			}
   		}
	}

	// Система FollowMe ведём игрока за собой
	ProcessFollowMe(playerid);

	// Тренировочные маршруты
	Obstacle_OnPlayerUpdate(playerid);

	// Записываем позицию игрока для античита
	if(!IsPlayerInAnyVehicle(playerid)) {
		GetPlayerPos(playerid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
	} else {
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new veh = GetPlayerVehicleID(playerid);
			GetVehiclePos(veh, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
		}
		else GetPlayerPos(playerid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);
	}

	// Записываем скорость игрока для систем
	ProtectSpeed[playerid] = skora;

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
    	if(GetPlayerSurfingVehicleID(playerid) != INVALID_VEHICLE_ID) // На крыше авто
    	{
			if(GetPlayerSpeed(playerid) >= 400.0)
			{
				printf("[SProtect Kick]: Veh Speed %s",PlayerInfo[playerid][pName]);
				SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Veh Speed Limit]");
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Veh Speed Limit]","*","");
				Kickx(playerid);
				return 1;
			}
    	}
    	else AntiFly(playerid, PlayerSpeedPlane(playerid));

		if(GetPVarInt(playerid,"kas") == 5)
		{
			new Keys,ud,lr;
		    GetPlayerKeys(playerid,KEY:Keys,ud,lr);

		    if(ud == KEY_UP) KasVerh(playerid);
		    else if(ud == KEY_DOWN) KasVniz(playerid);

		    if(lr == KEY_LEFT) KasLevo(playerid);
		    else if(lr == KEY_RIGHT) KasPravo(playerid);
		}
		if(GetPVarInt(playerid,"Roll") >= 2)
		{
			new keys,ud,lr,stope = 0;
			GetPlayerKeys(playerid,KEY:keys,ud,lr);

			if(ud == KEY_UP){        ApplyAnimation(playerid,"SKATE","skate_run",3.9, false, true, true, true, true); stope = 1; }
	 		else if(ud == KEY_DOWN){ ApplyAnimation(playerid,"SKATE","skate_run",3.9, false, true, true, true, true); stope = 1; }

			if(lr == KEY_LEFT){      ApplyAnimation(playerid,"SKATE","skate_run",3.9, false, true, true, true, true); stope = 1; }
	 		else if(lr == KEY_RIGHT){ApplyAnimation(playerid,"SKATE","skate_run",3.9, false, true, true, true, true); stope = 1; }

			if(stope == 0) ApplyAnimation(playerid,"SKATE","skate_idle",3.9, false, true, true, true, true);
		}
	}
	if(setting_pos_draw[playerid] > 0)
	{
	    new Keys,ud,lr;
	    GetPlayerKeys(playerid,KEY:Keys,ud,lr);
	    if(ud == KEY_UP) position_draw(playerid, 0);
	    else if(ud == KEY_DOWN) position_draw(playerid, 1);

	    if(lr == KEY_LEFT) position_draw(playerid, 2);
	    else if(lr == KEY_RIGHT) position_draw(playerid, 3);
	}
	if(setting_size_draw[playerid] > 0)
	{
	    new Keys,ud,lr;
	    GetPlayerKeys(playerid,KEY:Keys,ud,lr);
	    if(ud == KEY_UP) size_draw(playerid, 0);
	    else if(ud == KEY_DOWN) size_draw(playerid, 1);

	    if(lr == KEY_LEFT) size_draw(playerid, 2);
	    else if(lr == KEY_RIGHT) size_draw(playerid, 3);
	}
	if(OverHear[playerid] >= 1 && OverHear[playerid] <= 999 && GetPVarInt(playerid,"aflist") == 0 && camerafbi >= 2)
	{
		new Keys,ud,lr;
  		GetPlayerKeys(playerid,KEY:Keys,ud,lr);
  		if(lr == KEY_LEFT) leftcam(playerid);
    	else if(lr == KEY_RIGHT) rightcam(playerid);
	}
	if(OverHear[playerid] == 1000)
	{
		new Keys,ud,lr;
  		GetPlayerKeys(playerid,KEY:Keys,ud,lr);
  		new Float:CP[3], Float:FP[3], Float:plus;
		GetPlayerCameraPos(playerid, CP[0], CP[1], CP[2]);
		GetPlayerCameraLookAt(playerid, FP[0], FP[1], FP[2]);
    	if(ud == KEY_UP)
    	{
			if(CP[2] >= 30 && CP[2] <= 200) plus = 10.0;
    	    else if(CP[2] >= 201 && CP[2] <= 300) plus = 20.0;
    	    else if(CP[2] >= 301 && CP[2] <= 400) plus = 30.0;
    	    else if(CP[2] >= 401) plus = 40.0;
    		if(CP[1] <= 3060) SetPlayerCameraPos(playerid, CP[0], CP[1]+plus, CP[2]), SetPlayerCameraLookAt(playerid, FP[0], FP[1]+plus, FP[2]);
		}
		if(ud == KEY_DOWN)
		{
			if(CP[2] >= 30 && CP[2] <= 200) plus = 10.0;
    	    else if(CP[2] >= 201 && CP[2] <= 300) plus = 20.0;
    	    else if(CP[2] >= 301 && CP[2] <= 400) plus = 30.0;
    	    else if(CP[2] >= 401) plus = 40.0;
			if(CP[1] >= -3010) SetPlayerCameraPos(playerid, CP[0], CP[1]-plus, CP[2]), SetPlayerCameraLookAt(playerid, FP[0], FP[1]-plus, FP[2]);
		}
		if(lr == KEY_LEFT)
		{
			if(CP[2] >= 30 && CP[2] <= 200) plus = 10.0;
    	    else if(CP[2] >= 201 && CP[2] <= 300) plus = 20.0;
    	    else if(CP[2] >= 301 && CP[2] <= 400) plus = 30.0;
    	    else if(CP[2] >= 401) plus = 40.0;
			if(CP[0] >= -3100) SetPlayerCameraPos(playerid, CP[0]-plus, CP[1], CP[2]), SetPlayerCameraLookAt(playerid, FP[0]-plus, FP[1], FP[2]);
		}
		if(lr == KEY_RIGHT)
		{
			if(CP[2] >= 30 && CP[2] <= 200) plus = 10.0;
    	    else if(CP[2] >= 201 && CP[2] <= 300) plus = 20.0;
    	    else if(CP[2] >= 301 && CP[2] <= 400) plus = 30.0;
    	    else if(CP[2] >= 401) plus = 40.0;
			if(CP[0] <= 3500) SetPlayerCameraPos(playerid, CP[0]+plus, CP[1], CP[2]), SetPlayerCameraLookAt(playerid, FP[0]+plus, FP[1], FP[2]);
		}
		if(Keys == 4)
		{
			if(CP[2] >= 50) SetPlayerCameraPos(playerid, CP[0], CP[1], CP[2]-10.0), SetPlayerCameraLookAt(playerid, FP[0], FP[1], FP[2]-10.0);
	    }
	    if(Keys == 128)
		{
			if(CP[2] <= 570) SetPlayerCameraPos(playerid, CP[0], CP[1], CP[2]+10.0), SetPlayerCameraLookAt(playerid, FP[0], FP[1], FP[2]+10.0);
	    }
	}

	if(GpsStat[playerid] > 0) UpdateGps(playerid);

	// FlyCam
	if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY) FlyCamProcess(playerid);

	// Cбрасываем AFK
    SetPVarInt(playerid, "afksystem", 0);

	return true;
}
stock position_draw(playerid, stat)
{
	new num_detail = setting_pos_draw[playerid]-1, yes;
	if(stat == 0) // Вверх
	{
	    if(!get_detail_draw(playerid, num_detail, 0)) return 0;
		set_pos_y[playerid] -= 4.0, yes = 1;
	}
	else if(stat == 1) // Вниз
	{
	    if(!get_detail_draw(playerid, num_detail, 1)) return 0;
		set_pos_y[playerid] += 4.0, yes = 1;
	}
	else if(stat == 2) // Влево
	{
	    if(!get_detail_draw(playerid, num_detail, 2)) return 0;
		set_pos_x[playerid] -= 4.0, yes = 1;
	}
	else if(stat == 3) // Вправо
	{
	    if(!get_detail_draw(playerid, num_detail, 3)) return 0;
		set_pos_x[playerid] += 4.0, yes = 1;
	}
	if(yes == 1) reset_draw(playerid, num_detail);
	return 1;
}
stock get_detail_draw(playerid, num_detail, stat)
{
	new Float:positiond_x, Float:positiond_y, Float:size_x, Float:size_y;
	if(num_detail == 0) // Чекер Каптов
	{
    	PlayerTextDrawGetPos(playerid, PlayerGangDraw[0][playerid], positiond_x, positiond_y);
    	PlayerTextDrawGetTextSize(playerid, PlayerGangDraw[0][playerid], size_x, size_y);
    	positiond_x -= 10.0;
	}
	else if(num_detail == 1) // Меню взаимодействия
	{
		PlayerTextDrawGetPos(playerid, PlaInter[0][playerid], positiond_x, positiond_y);
		PlayerTextDrawGetTextSize(playerid, PlaInter[0][playerid], size_x, size_y);
  	}
  	else if(num_detail == 2) // Название сервера
	{
		PlayerTextDrawGetPos(playerid, PlayerSiteDraw[0][playerid], positiond_x, positiond_y);
		size_x = 20.0, size_y = 10.0;
  	}
  	else if(num_detail == 3) // Время
	{
		PlayerTextDrawGetPos(playerid, PlayerSiteDraw[4][playerid], positiond_x, positiond_y);
		size_x = 20.0, size_y = 10.0;
  	}
  	else if(num_detail == 4) // Ноутбук
	{
		PlayerTextDrawGetPos(playerid, PlayerPcDraw[0][playerid], positiond_x, positiond_y);
		PlayerTextDrawGetTextSize(playerid, PlayerPcDraw[0][playerid], size_x, size_y);
		positiond_x -= 2.0, positiond_y -= 2.0;
		size_x += 4.0, size_y += 4.0;
  	}
  	else if(num_detail == 5) // Смартфон
	{
		PlayerTextDrawGetPos(playerid, PlayerSmartDraw[0][playerid], positiond_x, positiond_y);
		PlayerTextDrawGetTextSize(playerid, PlayerSmartDraw[0][playerid], size_x, size_y);
		positiond_x -= 2.0, positiond_y -= 2.0;
		size_x += 4.0, size_y += 4.0;
  	}
  	else if(num_detail == 6) // Инвентарь
	{
	    if(stat == 0 || stat == 1)
		{
			PlayerTextDrawGetPos(playerid, PlaInventDraw[5][playerid], positiond_x, positiond_y);
			PlayerTextDrawGetTextSize(playerid, PlaInventDraw[5][playerid], size_x, size_y);
	    }
	    else if(stat == 2)
		{
			PlayerTextDrawGetPos(playerid, PlaInventDraw[6][playerid], positiond_x, positiond_y);
			PlayerTextDrawGetTextSize(playerid, PlaInventDraw[6][playerid], size_x, size_y);
	    }
	    else if(stat == 3)
		{
			PlayerTextDrawGetPos(playerid, PlaInventDraw[5][playerid], positiond_x, positiond_y);
			PlayerTextDrawGetTextSize(playerid, PlaInventDraw[5][playerid], size_x, size_y);
	    }
  	}
  	else if(num_detail == 7) // Спидометр
	{
	    if(PlayerInfo[playerid][pTypeSpeed] == 0)
	    {
	    	PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][6], positiond_x, positiond_y);
	    	PlayerTextDrawGetTextSize(playerid, PlayerSpeedDraw[playerid][6], size_x, size_y);
	    	positiond_x -= 10.0, positiond_y -= 10.0;
    	}
    	else if(PlayerInfo[playerid][pTypeSpeed] == 1)
	    {
	    	PlayerTextDrawGetPos(playerid, PlayerSpeedDraw[playerid][6], positiond_x, positiond_y);
	    	PlayerTextDrawGetTextSize(playerid, PlayerSpeedDraw[playerid][6], size_x, size_y);
	    	positiond_x -= 40.0, positiond_y -= 20.0;
	    	size_x += 10;
    	}
 	}
  	else if(num_detail == 8) // Меню Покупок
	{
	    if(stat == 0 || stat == 1 || stat == 3)
	    {
  	    	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[0][playerid], positiond_x, positiond_y);
			PlayerTextDrawGetTextSize(playerid, PlayerBuyDraw[0][playerid], size_x, size_y);
		}
		else if(stat == 2)
	    {
  	    	PlayerTextDrawGetPos(playerid, PlayerBuyDraw[1][playerid], positiond_x, positiond_y);
			PlayerTextDrawGetTextSize(playerid, PlayerBuyDraw[1][playerid], size_x, size_y);
		}
  	}
  	else if(num_detail == 9) // Подсказка двигателя
	{
	    PlayerTextDrawGetPos(playerid, PlayerHintDraw[0][playerid], positiond_x, positiond_y);
		PlayerTextDrawGetTextSize(playerid, PlayerHintDraw[0][playerid], size_x, size_y);
	}
	else if(num_detail == 10) // Кислород
	{
	    PlayerTextDrawGetPos(playerid, OxygenDraw[0][playerid], positiond_x, positiond_y);
		PlayerTextDrawGetTextSize(playerid, OxygenDraw[0][playerid], size_x, size_y);
	    if(stat == 0) positiond_x -= size_y;
		else if(stat == 1) positiond_x += size_y;
	}
	else if(num_detail == 13) // Админский Spec
	{
	    PlayerTextDrawGetPos(playerid, PlayerSpecDraw[0][playerid], positiond_x, positiond_y);
	    PlayerTextDrawGetTextSize(playerid, PlayerSpecDraw[0][playerid], size_x, size_y);
	}
  	
	if(stat == 0) // Вверх Y
	{
	    if(positiond_y <= 0.0) return 0;
	}
	else if(stat == 1) // Вниз Y
	{
	    if(positiond_y+size_y >= 448.0) return 0;
	}
	else if(stat == 2) // Влево X
	{
	    if(positiond_x <= 0.0) return 0;
	}
	else if(stat == 3) // Вправо X
	{
	    if(positiond_x+size_x >= 640.0) return 0;
	}
	return 1;
}
stock size_draw(playerid, stat)
{
	new num_detail = setting_size_draw[playerid]-1, yes;
	if(stat == 0 && set_size_y[playerid] > -10.0)
	{
	    if((num_detail == 4 || num_detail == 5 || (num_detail == 7 && PlayerInfo[playerid][pTypeSpeed] == 0)) && set_size_y[playerid] <= 0.0) return 0;
		set_size_y[playerid] -= 1.0, yes = 1;
	}
	else if(stat == 1 && set_size_y[playerid] < 25.0) set_size_y[playerid] += 1.0, yes = 1;
	else if(stat == 2 && set_size_x[playerid] > -10.0)
	{
	    if((num_detail == 4 || num_detail == 5 || (num_detail == 7 && PlayerInfo[playerid][pTypeSpeed] == 0)) && set_size_x[playerid] <= 0.0) return 0;
		set_size_x[playerid] -= 1.0, yes = 1;
	}
	else if(stat == 3 && set_size_x[playerid] < 25.0) set_size_x[playerid] += 1.0, yes = 1;

	if(yes == 1) reset_draw(playerid, num_detail);
	return 1;
}
stock reset_draw(playerid, num_detail)
{
    if(num_detail == 0)
	{
	    PosGangDraw(playerid);
		for(new i = 0; i < 17; i++) PlayerTextDrawShow(playerid, PlayerGangDraw[i][playerid]);
	}
	else if(num_detail == 1)
	{
	    PosInterDraw(playerid);
		for(new i = 0; i < 5; i++) PlayerTextDrawShow(playerid, PlaInter[i][playerid]);
	}
	else if(num_detail == 2)
	{
	    PosSiteDraw(playerid);
		PlayerTextDrawShow(playerid, PlayerSiteDraw[0][playerid]), PlayerTextDrawShow(playerid, PlayerSiteDraw[1][playerid]), PlayerTextDrawShow(playerid, PlayerSiteDraw[2][playerid]);
		PlayerTextDrawShow(playerid, PlayerSiteDraw[3][playerid]);
	}
	else if(num_detail == 3)
	{
	    PosTimeDraw(playerid);
		PlayerTextDrawShow(playerid, PlayerSiteDraw[4][playerid]);
	}
	else if(num_detail == 4) // Ноутбук
	{
	    PosPcDraw(playerid);
		for(new i = 0; i < 26; i++) PlayerTextDrawShow(playerid, PlayerPcDraw[i][playerid]);
	}
	else if(num_detail == 5) // Смартфон
	{
	    PosSmartDraw(playerid);
	    ShowDetailSmartfon(playerid);
		SmartfonMenu(playerid);
		//PlayerTextDrawShow(playerid, PlayerSmartDraw[29][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[30][playerid]), PlayerTextDrawShow(playerid, PlayerSmartDraw[31][playerid]);
		//PlayerTextDrawShow(playerid, PlayerSmartDraw[41][playerid]);
	}
	else if(num_detail == 6) // Инвентарь
	{
	    if(DrawInvent[playerid] == true) PosInventDraw(playerid), invent_draw_settint(playerid);
	}
	else if(num_detail == 7) // Спидометр
	{
	    PosSpeedDraw(playerid);
	    for(new i = 0; i < 10; i++) PlayerTextDrawShow(playerid, PlayerSpeedDraw[playerid][i]);
	}
	else if(num_detail == 8) //Меню покупок
    {
        PosBuymenuDraw(playerid);
        for(new i = 0; i < 4; i ++) PlayerTextDrawShow(playerid, PlayerBuyDraw[i][playerid]);
	    for(new i = 0; i < 16; i ++) PlayerTextDrawShow(playerid, PlayerBuyDraw_Items[i][playerid]);
	    for(new i = 0; i < 5; i ++)
	    {
	        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectFon[i][playerid]);
	        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectPick[i][playerid]);
	        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectName[i][playerid]);
	        PlayerTextDrawShow(playerid, PlayerBuyDraw_SelectPrice[i][playerid]);
	    }
    }
    else if(num_detail == 9) // Подсказка двигателя
    {
    	PosHintDraw(playerid);
    	PlayerTextDrawShow(playerid, PlayerHintDraw[0][playerid]), PlayerTextDrawShow(playerid, PlayerHintDraw[1][playerid]);
    }
    else if(num_detail == 10) // Кислород в скафандре
    {
        if(DrawOxygen[playerid] == true)
        {
    		PosOxygenDraw(playerid);
    		PlayerTextDrawShow(playerid, OxygenDraw[0][playerid]), PlayerTextDrawShow(playerid, OxygenDraw[1][playerid]), PlayerTextDrawShow(playerid, OxygenDraw[2][playerid]);
  		}
    }
    else if(num_detail == 13) // Админ слежка
    {
        if(LoadSP[playerid] == true)
        {
    		PosSpecDraw(playerid);
    		for(new i = 0; i < 31; i ++) PlayerTextDrawShow(playerid, PlayerSpecDraw[i][playerid]);
    		if(PlayerInfo[playerid][pAspecBlock1] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[10][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[11][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[13][playerid]);
      		if(PlayerInfo[playerid][pAspecBlock2] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[17][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[18][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[19][playerid]);
      		if(PlayerInfo[playerid][pAspecBlock3] == true) PlayerTextDrawHide(playerid, PlayerSpecDraw[29][playerid]), PlayerTextDrawHide(playerid, PlayerSpecDraw[30][playerid]);
  		}
    }
	return 1;
}
stock AntiCoordMaster(playerid)
{
	new Float:max_dist = 3.0;

	// Если мы сёрфим на транспорте
	new vehicleid = GetPlayerSurfingVehicleID(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		if(VehInfo[vehicleid][vSeat] > 0)
		{
			new currentid = VehInfo[vehicleid][vSeat]-1;
			if(IsOnline(currentid)) max_dist = 8.0;
		}
	}

	new Float:dist = GetPlayerDistancePoint2D(playerid, Protect_X[playerid], Protect_Y[playerid]); // Текущая
	new Float:dist_before = GetPlayerDistancePoint2D(playerid, BeforeProtect_X[playerid], BeforeProtect_Y[playerid]); // До
	new Float:dist_after = GetPlayerDistancePoint2D(playerid, AfterProtect_X[playerid], AfterProtect_Y[playerid]); // После
	if(dist >= max_dist && dist_before >= max_dist && dist_after >= max_dist)
	{
		CoordMaster_Warn[playerid] ++;
	    if(CoordMaster_Warn[playerid] >= 15) SendCheat(playerid, 1, protect[13]);
	}
	if(coordmasta == playerid && coordmasta >= 0)
	{
		new string[144];
        format(string, sizeof(string), "dist: %f, dist_before: %f, dist_after: %f", dist, dist_before, dist_after);
        SendFounder(string);
	}
	return 1;
}
stock SendCheat(playerid, type, stat)
{
	new string[128];
	if(type == 0)
	{
	    if(stat == 0)
		{
		    if(Antichit[playerid] == 0)
		    {
				SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве (warning) [ Fly ]");
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве (warning) [ Fly ]","*","");

				// Если игрок не за рулём транспорта, но был до этого за рулём мототранспорта
				// Вероятно его ложно кикнуло, когда он ехал на нрг задирая переднюю часть, а потом упал с мотика (ищу ложный кик)
				if(Protect_Veh[playerid] == 9999 && IsAMoto(PreviousModelVehicle[playerid]))
				{
					printf("[SProtect Kick]: Fly %s PreviousModelVehicle %d", PlayerInfo[playerid][pName], PreviousModelVehicle[playerid]);
				}

				printf("[SProtect Kick]: Fly (warning) %s",PlayerInfo[playerid][pName]);
				Antichit[playerid] = 1;
				Kickx(playerid);
			}
		}
	    else if(stat == 1)
		{
			new unix = gettime();
    		if(unix > GetPVarInt(playerid,"afsend"))
    		{
				printf("[SProtect]: Fly (warning) %s",PlayerInfo[playerid][pName]);
				format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на {FF6347}Fly {cccccc}(warning)", PlayerInfo[playerid][pName],playerid), ABroadCast(COLOR_ADM,string,1);
				SetPVarInt(playerid,"afsend",unix+2);
			}
		}
	}
	else if(type == 1)
	{
	    if(stat == 0)
		{
		    if(Antichit[playerid] == 0)
		    {
				SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [ Teleport CoordMaster ]");
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [ Teleport CoordMaster ]","*","");
				printf("[SProtect Kick]: Teleport CoordMaster %s",PlayerInfo[playerid][pName]);
				Antichit[playerid] = 1;
				Kickx(playerid);
			}
		}
	    else if(stat == 1)
		{
			new unix = gettime();
    		if(unix > GetPVarInt(playerid,"afsend"))
    		{
				printf("[SProtect]: Teleport CoordMaster %s",PlayerInfo[playerid][pName]);
				format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на {FF6347}Teleport CoordMaster", PlayerInfo[playerid][pName],playerid), ABroadCast(COLOR_ADM,string,1);
				SetPVarInt(playerid,"afsend",unix+2);
			}
		}
	}
	else if(type == 2)
	{
	    if(stat == 0)
		{
		    if(Antichit[playerid] == 0)
		    {
				SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [ Damager ]");
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [ Damager ]","*","");
				printf("[SProtect Kick]: Damager %s",PlayerInfo[playerid][pName]);
				Antichit[playerid] = 1;
				Kickx(playerid);
			}
		}
		else if(stat == 1)
		{
			new unix = gettime();
    		if(unix > GetPVarInt(playerid,"afsend"))
    		{
				format(string, sizeof(string), " [ ADM ]: %s[%d] Подозрение на {FF6347}Damager", PlayerInfo[playerid][pName],playerid), ABroadCast(COLOR_ADM,string,1);
				SetPVarInt(playerid,"afsend",unix+2);
			}
		}
	}
	return 1;
}
stock AntiFly(playerid, Float:speed)
{
	new Float:maxspeed;
	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK) maxspeed = 60.0;
	else if(ProtectInfo[playerid][prWeapon][11] == 46 && ProtectInfo[playerid][prAmmo][11] > 0) maxspeed = 90.0;
	else maxspeed = 45.0;
	for(new i = 14; i > 0; i--) PSpeed[i][playerid] = PSpeed[i-1][playerid];
	PSpeed[0][playerid] = speed;
	if(GetPlayerSurfingObjectID(playerid) != INVALID_OBJECT_ID)
    {
        new obj = GetPlayerSurfingObjectID(playerid);
		if(obj == train_object1 && train_object1 || obj == train_object2 && train_object2 || obj == train_object3 && train_object3) return 1; // Игнорим объекты поезда
    }

	if(PlayerSpeedPlane(playerid) >= maxspeed && PlayerSpeedPlane(playerid) < 200.0)
	{
	    // Античит Fly на Разгон
	    if(PSpeed[0][playerid] > PSpeed[1][playerid] && PSpeed[1][playerid] > PSpeed[2][playerid] && PSpeed[2][playerid] > PSpeed[3][playerid] && PSpeed[3][playerid] > PSpeed[4][playerid]
	    && PSpeed[4][playerid] > PSpeed[5][playerid] && PSpeed[5][playerid] > PSpeed[6][playerid] && PSpeed[6][playerid] > PSpeed[7][playerid] && PSpeed[7][playerid] > PSpeed[8][playerid]
	    && PSpeed[8][playerid] > PSpeed[9][playerid] && PSpeed[9][playerid] > PSpeed[10][playerid] && PSpeed[10][playerid] > PSpeed[11][playerid] && PSpeed[11][playerid] > PSpeed[12][playerid]
	    && PSpeed[12][playerid] > PSpeed[13][playerid] && PSpeed[13][playerid] > PSpeed[14][playerid]) SendCheat(playerid, 0, protect[12]);
	    
	    // Античит Fly на Длительный полёт
	    Fly_Warn[playerid] ++;
	    if(Fly_Warn[playerid] >= 40 && Fly_Warn[playerid] < 60) SendCheat(playerid, 0, 1);
	    if(Fly_Warn[playerid] >= 60) SendCheat(playerid, 0, protect[12]);
	}
	if(PlayerSpeedPlane(playerid) >= 200.0)
	{
		if(Antichit[playerid] == 0)
        {
			SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [ Fly Max Speed ]");
			ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [ Fly Max Speed ]","*","");
			printf("[SProtect Kick]: Fly (max speed) %s",PlayerInfo[playerid][pName]);
			Antichit[playerid] = 1;
			Kickx(playerid);
    	}
	}
    return 1;
}
stock TurnPlayerFaceToPlayer(playerid, facingtoid)
{
	if(playerid != facingtoid)
	{
	    new Float:angle;
	    new Float:misc = 5.0;
	    new Float:x, Float:y, Float:z;
	    new Float:ix, Float:iy, Float:iz;
	    GetPlayerPos(facingtoid, x, y, z);
	    GetPlayerPos(playerid, ix, iy, iz);
	    angle = 180.0-atan2(ix-x,iy-y);
	    angle += misc;
	    misc *= -1;
	    PPSetPlayerFacingAngle(playerid, angle+misc, false);
 	}
}
stock TurnPlayerFaceToVehicle(p, v)
{
    new Float:angle;
    new Float:misc = 5.0;
    new Float:x, Float:y, Float:z;
    new Float:ix, Float:iy, Float:iz;
    GetVehiclePos(v, x, y, z);
    GetPlayerPos(p, ix, iy, iz);
    angle = 180.0-atan2(ix-x,iy-y);
    angle += misc;
    misc *= -1;
    PPSetPlayerFacingAngle(p, angle+misc, false);
}
stock TurnDynamicObjectToPlayer(objectid, playerid) {
	if (!IsValidDynamicObject(objectid)) return 0;
	if (!IsOnline(playerid)) return 0;

	new Float:angle;
    new Float:misc = 5.0;
    new Float:x, Float:y, Float:z;
    new Float:ix, Float:iy, Float:iz;
	
	new vehicleid = GetPlayerVehicleID(playerid);
	if (IsValidVehicle(vehicleid)) GetVehiclePos(vehicleid, x, y, z);
    else GetPlayerPos(playerid, x, y, z);
    GetDynamicObjectPos(objectid, ix, iy, iz);
    angle = 180.0-atan2(ix-x,iy-y);
    angle += misc;
    misc *= -1;
	Streamer_SetFloatData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_R_Z, angle + misc);

	return 1;
}
stock SetPlayerLookAt(playerid, Float:X, Float:Y)
{
    new Float:pX, Float:pY, Float:pZ;
    GetPlayerPos(playerid, pX, pY, pZ);
    return PPSetPlayerFacingAngle(playerid, -acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 90.0);
}
stock CloseTrade(playerid)
{
	PlayerInfo[playerid][pTstat] = 0;
	if(PlayerInfo[playerid][pTid] >= 0)
	{
		new para1 = PlayerInfo[playerid][pTid];
		if(IsOnline(para1))
		{
			new string[144];
			if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"{ff9000}[ Центр Обмена ] {cccccc}%s отменил сделку с вами",PlayerInfo[playerid][pName]);
			else format(string,sizeof(string),"{ff9000}[ Центр Обмена ] {cccccc}%s отменила сделку с вами",PlayerInfo[playerid][pName]);

			if(PlayerInfo[playerid][pSex] == 1) format(string,sizeof(string),"{FF6347}[Отмена Сделки]\n\n{cccccc}%s отменил сделку с вами",PlayerInfo[playerid][pName]);
			else format(string,sizeof(string),"{FF6347}[Отмена Сделки]\n\n{cccccc}%s отменила сделку с вами",PlayerInfo[playerid][pName]);
			ShowDialog(para1,1700,DIALOG_STYLE_MSGBOX,"{ff9000}Центр Обмена",string,"Ок","");
			SendClientMessage(para1, COLOR_GREY, string);
			PlayerInfo[para1][pTstat] = 1;
			PlayerInfo[para1][pTid] = -1;
			UpdateTrade(para1);
		}
	}

	new vehicleid;
	for(new i = 0; i < 3; i++)
	{
		if(PlayerInfo[playerid][pTslot][i] == 4) // Отключаем запрет на спавн транспорта
		{
			vehicleid = PlayerInfo[playerid][pTmodel][i];
			VehInfo[vehicleid][vNospawn] = 0;
		}
		PlayerInfo[playerid][pTslot][i] = 0;
		PlayerInfo[playerid][pTmodel][i] = 0;
		PlayerInfo[playerid][pTamount][i] = 0;
		PlayerInfo[playerid][pTdone][i] = 0;
		PlayerInfo[playerid][pTstope][i] = 0;
	}
	PlayerInfo[playerid][pTid] = -1;
	for(new i = 0; i < MAX_MYVEHICLE; i++) PlayerInfo[playerid][pTnoveh][i] = 0;
	
	DestroyDynamic3DTextLabel(TradeLabel[playerid]);
}
