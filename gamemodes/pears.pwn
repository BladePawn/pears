CMD:konki(playerid)
{
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу надеть коньки в машине");
	if(PlayerInfo[playerid][pBkyrenie] >= 2) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Чего, блин ?! Я не на земле");
	if(GetPVarInt(playerid, "Boot") > 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я в багажнике");
   	if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
   	if(GetPVarInt(playerid,"Roll") == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Мне нужно взять коньки на прокат");
   	if(IsPlayerInRangeOfPoint(playerid,7.0, -2196.2212,254.3901,897.4857))
    {
		if(GetPVarInt(playerid,"Roll") == 1)
		{
	 		if(PlayerInfo[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"надел коньки",COLOR_PURPLE,20.0,7000);
	 		else SetPlayerChatBubble(playerid,"надела коньки",COLOR_PURPLE,20.0,7000);
			SetPVarInt(playerid, "Roll", 2);
			SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Коньки {99ff66}надеты {ff9000}[ /time ]");
		}
		else
		{
		 	if(PlayerInfo[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"снял коньки",COLOR_PURPLE,20.0,7000);
	 		else SetPlayerChatBubble(playerid,"сняла коньки",COLOR_PURPLE,20.0,7000);
			SetPVarInt(playerid, "Roll", 1);
			ClearAnim(playerid);
			ClearAnimations(playerid);
		}
	}
	return 1;
}

alias:drop("dtop", "deop")
CMD:drop(playerid)
{
    if(MPGO[playerid] != 0 || Sleep[playerid] >= 1 || SleepRP[playerid] >= 1 || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMessage(playerid, "{FF6347}Ваш персонаж не может сейчас выбросить предмет");
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "{FF6347}Вы не можете выбросить предмет в транспорте");
	if(PlayerInfo[playerid][pBeret] >= 1) return ErrorMessage(playerid, "{FF6347}Вы не можете сейчас выбросить оружие [ Временное лишение ]");
	if(GetPlayerWeapon(playerid) == WEAPON:0) return ErrorMessage(playerid, "{FF6347}Возьмите в руки оружие, которое хотите выбросить");
	PlayerPlaySound(playerid,31200,0,0,0);
	new weaponid = WEAPON:GetPlayerWeapon(playerid);
	new sl = Protect_Slot(weaponid);
	if(ProtectInfo[playerid][prWeapon][sl] != weaponid) return ErrorMessage(playerid, "{FF6347}Ошибка! Согласно системе, у вас в руках другое оружие");
	if(ProtectInfo[playerid][prAmmo][sl] <= 0) return ErrorMessage(playerid, "{FF6347}Ошибка! У вас в руках нет оружия");
	if(weaponid >= 16 && weaponid <= 18 || weaponid == 23 || weaponid >= 34) return ErrorMessage(playerid, "{FF6347}Это оружие нельзя выбросить на землю");
	if(weaponid >= 1 && weaponid <= 15)
	{
	    Throw(playerid, ProtectInfo[playerid][prWeapon][sl], 1, 0, ProtectInfo[playerid][prQet][sl], 1, 0);
	}
	else
	{
	    new fitem;
		new weaponType = WeaponAmmoType(weaponid);
		if(weaponType == 1) fitem = 27; // Дробовики
		else if(weaponType == 2 || weaponType == 3) fitem = 28; // Пистолеты
		else if(weaponType == 4) fitem = 29; // Автомат
		else fitem = 30; // Дробовик
		Throw(playerid, fitem, ProtectInfo[playerid][prAmmo][sl], 0, 0, 0, 0);
		Throw(playerid, ProtectInfo[playerid][prWeapon][sl], 1, ProtectInfo[playerid][prDet][sl], ProtectInfo[playerid][prQet][sl], 1, 0);
	}
	if(weaponid == 23) OnDuty[playerid] = 0;
	Protect_Remove(playerid, weaponid);
	PlayerPlaySound(playerid,6801,0,0,0); //sound drop sound
	SetPlayerChatBubble(playerid,"выбрасывает предмет из рук",COLOR_PURPLE,20.0,3000);
	return 1;
}

CMD:stopwash(playerid)
{
	if(Piss[playerid] == 3 || Piss[playerid] == 6)
	{
		if(Piss[playerid] == 6 && AeroStat[playerid] > 0) DestroyPlayerObject(playerid, AeroObj[playerid]), AeroStat[playerid] = 0;
		Piss[playerid] = 0; PissTime[playerid] = 0; NoAnim[playerid] = 0; PPP15[playerid] = 0;
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		PlayerPlaySound(playerid,6400,0,0,0);
		ClearAnim(playerid);
		TogglePlayerControllable(playerid, true);
  	}
 	return 1;
}

CMD:hammer(playerid)
{
	if(PlayerInfo[playerid][pSoska] >= 22) gethammer(playerid);
	return 1;
}
stock gethammer(playerid)
{
	if(Dei[playerid] == 0)
	{
		if(Hand[playerid] >= 1 || (GetPlayerWeapon(playerid) >= WEAPON:2 && GetPlayerWeapon(playerid) != WEAPON:46) || Hold[playerid] >= 1) return ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
		Dei[playerid] = 4, DeiStat[playerid] = 0, PlayerPlaySound(playerid,5600,0,0,0);
		ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
		SetPlayerAttachedObject(playerid, 1, 19631, 6, 0.084999, 0.031000, 0.136999, -86.500038, -91.500038, 0.000000, 1.000000, 1.000000, 1.000000, 0, 0);
		if(PlayerInfo[playerid][pAbility][1] < 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Странно... Почему кувалда вся в крови?");
	}
	else if(Dei[playerid] == 4) Dei[playerid] = 0, RemovePlayerAttachedObject(playerid,1), PlayerPlaySound(playerid,5601,0,0,0), ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
	else ErrorMessage(playerid, "{FF6347}У вас заняты руки [Предмет или оружие]");
	return 1;
}
CMD:putpail(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0, -43.0062,55.0530,3.1179) || IsPlayerInRangeOfPoint(playerid,2.0, -61.1256,60.9370,3.1103))
	{
		if(Dei[playerid] == 13)
		{
		    if(DeiStat[playerid] < 20) return ErrorMessage(playerid, "{FF6347}Ведро пустое или в нём недостаточно молока");
		    if(PlayerInfo[playerid][pPlacement] == 0 || PlayerInfo[playerid][pPlacement] == 9)
    		{
				PlayerPlaySound(playerid,6401,0,0,0), ApplyAnimation(playerid,"GANGS","DRUGS_BUY",3.0, false, true, true, false, false);
				RemovePlayerAttachedObject(playerid,1), Dei[playerid] = 0, DeiStat[playerid] = 0;
				PlayerInfo[playerid][pPlacement] = 9;
				new zp = friskPrice[102]*20; // Дойка коров зарплата
				PlayerInfo[playerid][pSalary] += zp;
				new string[84];
				format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~+%d$~n~~w~JOB: ~g~%d$", zp, PlayerInfo[playerid][pSalary]), GameTextForPlayer(playerid,string,7000,3);
				mysql_save(playerid, 58);
				
				new bool:yes;
				switch(random(5))
				{
					case 0..3: yes = true;
					default: yes = false;
				}

				if(yes)
				{
					new put_inva = GiveThingPlayer(playerid, 102, 1, 0, 0, 0, 0, 9999);
					if(put_inva == -1) ErrorMessage(playerid, "{FF6347}У меня нет места в инвентаре");
					if(OnlineInfo[playerid][oNewYearQuest] == 2) 
					{
						SuccessMessage(playerid,"{44ff99}Я получил молоко, нужно успеть отдать его Йольскому Парню");
						CreateGps(playerid,3271.8430, -326.0200, 8.3832, 0, 0, 5.0);
						OnlineInfo[playerid][oNewYearQuestDop] = 1;
					}
				}

		 		update_ability(playerid, 5, 14);
	 		}
		}
		else ErrorMessage(playerid, "{FF6347}У вас в руках нет ведра с молоком");
	}
	return 1;
}
