stock PosSiteDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y, Float:dop_x, Float:dop_y;

	if(IsPlayerSyncModels(playerid)) dop_x = 12.0, dop_y = -2.0;

    if(setting_pos_draw[playerid] == 3 || setting_size_draw[playerid] == 3) positiond_x = sitedraw_x+set_pos_x[playerid] + dop_x, positiond_y = sitedraw_y+set_pos_y[playerid] + dop_y;
    else positiond_x = sitedraw_x+PlayerInfo[playerid][pDrawPos_X][2] + dop_x, positiond_y = sitedraw_y+PlayerInfo[playerid][pDrawPos_Y][2] + dop_y;

    if(setting_pos_draw[playerid] == 3 || setting_size_draw[playerid] == 3) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][2], sized_y = PlayerInfo[playerid][pDrawSize_Y][2];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[2], positiond_y += DrawPosSmart_Y[2], sized_y += DrawSizeSmart_Y[2];

    PlayerTextDrawSetPos(playerid, PlayerSiteDraw[0][playerid], positiond_x, positiond_y); // Pears
    PlayerTextDrawSetPos(playerid, PlayerSiteDraw[1][playerid], positiond_x, positiond_y+9.333411+sized_y/4); // Project
    PlayerTextDrawSetPos(playerid, PlayerSiteDraw[2][playerid], positiond_x+4.873474, positiond_y+0.933359); // Chat
    PlayerTextDrawSetPos(playerid, PlayerSiteDraw[3][playerid], positiond_x-32.67389-sized_x/1.2, positiond_y-8.111135-sized_y/4); // Christmas
    
    PlayerTextDrawLetterSize(playerid, PlayerSiteDraw[0][playerid], 0.299279+sized_x*(0.299279/50), 1.114665+sized_y*(1.114665/40)); // Pears
    PlayerTextDrawLetterSize(playerid, PlayerSiteDraw[1][playerid], 0.159431+sized_x*(0.159431/50), 0.652666+sized_y*(0.652666/40)); // Project
    PlayerTextDrawTextSize(playerid, PlayerSiteDraw[2][playerid], 11.997642+sized_x/4, 13.533340+sized_y/4);
    PlayerTextDrawTextSize(playerid, PlayerSiteDraw[3][playerid], 15.333312+sized_x/2, 16.592590+sized_y/2);
	return 1;
}
