CMD:off(playerid)
{
	if(PlayerInfo[playerid][pSoska] <= 1) return  SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	SetCameraBehindPlayer(playerid), TogglePlayerControllable(playerid, true);
	return 1;
}
CMD:cam(playerid)
{
	if(PlayerInfo[playerid][pSoska] <= 1) return  SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	
	new Float:cam_pos[6];
	GetPlayerCameraPos(playerid, cam_pos[0], cam_pos[1], cam_pos[2]);
	GetPlayerCameraLookAt(playerid, cam_pos[3], cam_pos[4], cam_pos[5]);

	SetPlayerCameraPos(playerid, cam_pos[0], cam_pos[1], cam_pos[2]);
   	SetPlayerCameraLookAt(playerid, cam_pos[3], cam_pos[4], cam_pos[5]);
	return 1;
}

CMD:newskidka1(playerid)
{
	if(PlayerInfo[playerid][pSoska] < 23) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
	if(newskidka1 == 0) newskidka1 = 2, SendClientMessage(playerid,COLOR_LIGHTBLUE,"{0088ff}Server: {00cc00}X2 Активирована");
   	else newskidka1 = 0, SendClientMessage(playerid,COLOR_LIGHTBLUE,"{0088ff}Server: {ff0000}X2 Отключена");

	XDonate(newskidka1);
	SaveStuff();
	return 1;
}
stock where_holiday()
{
	// Включаем дефолтные ценники на donate меню
	defaultPriceDonate();

	// Отключаем праздники
	holiday(0);

	new year, month,day;
 	getdate(year, month, day);
 	if(month >= 2 && month <= 11)
	{
	    if(day == 1)
	    {
			switch(random(5))
	        {
				case 0: ServerInfo[58] = 5;
				case 1: ServerInfo[58] = 10;
				case 2: ServerInfo[58] = 15;
				case 3: ServerInfo[58] = 20;
				case 4: ServerInfo[58] = 25;
			}
		}

		if(ServerInfo[56] != month) // Скидки в этом месяце ещё не прошла
		{
		    if(ServerInfo[57] == day) holiday(2); // Сегодня тот самый день скидки
		    else if(day > ServerInfo[57]) // Сегодня дни после скидки
		    {
		    	ServerInfo[56] = month;
		    	ServerInfo[57] = 1+random(27);
		    	SaveServer(56);
		    	SaveServer(57);
		    }
		}
	}

	if(month == 1) // Январь
	{
	    if(day >= 1 && day <= 7) holiday(1); // X2
	}
	else if(month == 2) // Февраль
	{
	    if(day == 14) holiday(1); // X2
	    else if(day == 23) holiday(1); // X2

		// Обновление Питомцы
		else if(day >= 25) holiday(1); // X2
	}
	else if(month == 3) // Март
	{
		// Обновление Питомцы
		if(day <= 2) holiday(1); // X2

		else if(day == 8) holiday(1); // X2
	}
	else if(month == 6) // Июнь
	{
		if(day >= 1 && day <= 15) holiday(1); // X2 Др сервера
	}
	else if(month == 7) // Июль
	{
		//if(day >= 22 && day <= 28) holiday(1); // X2 Мой др
	}
	else if(month == 9) // Сентябрь
	{
		if(day >= 1 && day <= 3) holiday(1); // X2
	}
	else if(month == 12) // Декабрь
	{
		if(day == 15) holiday(3); // X3

		if(day >= 25 && day <= 31) holiday(1); // X2
	}

	// Чтобы включить X3, нужно ебануть holiday(3); // X3
	return 1;
}

stock XDonate(result)
{
	if(server == 0) return false;
	new string_mysql[100];
	new Float:X2 = 1.0;

	if(result == 2) X2 = 0.5; // Это X2
	else if(result == 3) X2 = 0.33; // Это X3
	else if(result == 4) X2 = 0.25; // Это X4
	else X2 = 1.0; // Это нихуя

	mysql_format(pearsq_3, string_mysql, sizeof(string_mysql), "UPDATE `properties` SET `value` = '%f' WHERE `name` = 'goldPrice'", X2);
    mysql_tquery(pearsq_3, string_mysql);
	return true;
}

stock holiday(stat) // Праздник
{
	if(stat == 0) // Отключение Всех Акций
	{
		newskidka1 = 0;
		XDonate(newskidka1);
		if(ServerInfo[55] > 0)
	    {
	    	ServerInfo[55] = 0;
	    	SaveServer(55);

	    	defaultPriceDonate();
    	}
	}
	else if(stat == 1) // Включение X2
	{
		newskidka1 = 2;
		XDonate(newskidka1);
	}
	else if(stat == 2) // Включение Скидки на Меню
	{
	    if(ServerInfo[55] == 0)
	    {
			if(ServerInfo[58] == 0) ServerInfo[58] = 10;
			else ServerInfo[55] = ServerInfo[58];
			SaveServer(55);

			discount();
		}
	}
	else if(stat == 3) // Включение X3
	{
		newskidka1 = 3;
		XDonate(newskidka1);
	}
	return 1;
}

CMD:newskidka2(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 23) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    if(sscanf(params, "i",params[0])) return  SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Включить скидки на донат меню [ /newskidka2 Проценты ]");
	if(ServerInfo[55] == 0)
	{
	    if(params[0] <= 0 || params[0] > 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Скидка не меньше 1 и не больше 20 процентов");
		ServerInfo[55] = 1;
  	    ServerInfo[58] = params[0];
  	    new string[124];
  	    format(string, sizeof(string), "{0088ff}Скидка на донат меню включена: %d процентов {99ff66}[ /donate ]", ServerInfo[58]);
  	   	SendClientMessage(playerid,COLOR_GREY,string), PlayerPlaySound(playerid,6401,0,0,0);
  	   	SaveServer(55);
		
  	   	// Подсчёт Скидки
		discount();
	}
	else
	{
		ServerInfo[55] = 0;
		ServerInfo[58] = 0;
 		SendClientMessage(playerid,COLOR_LIGHTBLUE,"{0088ff}Скидка на донат меню {FF6347}Отключена"), PlayerPlaySound(playerid,6801,0,0,0);
 		SaveServer(55);

 		// Отключение Скидки
 		defaultPriceDonate();
	}
	return 1;
}
CMD:gokamera(playerid, const params[])
{
   if(IsPlayerInRangeOfPoint(playerid,2.0,-1759.9336,802.9238,137.4583))
   {
   		new string[128];
		if(PlayerInfo[playerid][pLeader] == 9 || PlayerInfo[playerid][pMember] == 9 && PlayerInfo[playerid][pRank] >= 2)
		{
		  if(cnnkam == 9999)
		  {
					cnnkam = playerid;
					if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я взял Видеокамеру {ff9000}[ Достать /kamera ]");
					else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я взяла Видеокамеру {ff9000}[ Достать /kamera ]");
		  }
		  else if(cnnkam == playerid)
		  {
		  			cnnkam = 9999;
					if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я положил на место видеокамеру");
					else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я положила на место видеокамеру");
					if(CnnVed[playerid] == 2)
 					{
						CnnVed[playerid] = 0;
