    		{
				new benz = strval(inputtext); // Сколько бенза заправляем
				if(!sscanf(inputtext, "i", benz))
				{
					if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;
					new vehicle = GetPlayerVehicleID(playerid);
					new fill = VehInfo[vehicle][vGas] + VehInfo[vehicle][vGelium];
					if(fill <= GasMax - 1)
					{
						if(benz > GasMax || benz <= 0) return ErrorMessage(playerid, "{FF6347}Не меньше 1 и не больше "#GasMax" литров");
						if(fill+benz > GasMax) return ErrorMessage(playerid, "{FF6347}Объём бака не больше "#GasMax" литров");
						if(oGetPlayerMoney(playerid) < benz*friskPrice[178]) return ErrorMessage(playerid, "{FF6347}Вам не хватает денег");
						format(string, sizeof(string), "заправляет %d литров топлива",benz);
						SetPlayerChatBubble(playerid,string,COLOR_PURPLE,20.0,5000);
						format(string, sizeof(string), "{99ff66}Транспорт заправлен на {ff9000}%d литров\n{cccccc}Стоимость: {99ff66}%d$",benz,benz*friskPrice[178]);
						SuccessMessage(playerid, string);
						VehInfo[vehicle][vGas] += benz;
						oGivePlayerMoney(playerid, -benz*friskPrice[178]);
						CheckBenz(playerid);
						MoneyLog("fillcar", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -benz*friskPrice[178], "Заправка лодки");
					}
					else ErrorMessage(playerid, "{FF6347}Вам не нужно заправлять транспорт, бак полон");
				}
