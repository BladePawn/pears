				else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Управление ядерными запусками производится с помощью компьютеров в центре управления NGSA"), pc_cmd_boom(playerid);
			}
			if(listitem == 1) // Устанавливаем Точку ( от 5 ранга )
			{
				if(PlayerInfo[playerid][pRank] <= 4) return SendClientMessage(playerid,COLOR_GREY,"[ Мысли ]: Я не имею доступа [ Ранг 5+ ]"), pc_cmd_boom(playerid);
			    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу устанавливать точку для удара из транспорта"), pc_cmd_boom(playerid);
			    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу устанавливать точку для удара в здании"), pc_cmd_boom(playerid);
