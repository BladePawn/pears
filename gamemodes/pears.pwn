	case 886:
	{
	    new i = DP[0][playerid];
		new pavilion = DP[1][playerid];
        if(response)
        {
            if(IsPlayerInRangeOfPoint(playerid, 0.7, IkeaInfo[i][iBuyX], IkeaInfo[i][iBuyY], IkeaInfo[i][iBuyZ]) && IkeaInfo[i][iPavilion] == pavilion)
			{
			    if(!IsValidDynamicObject(IkeaInfo[i][iObject])) return ErrorMessage(playerid, "{FF6347}Предмет был удалён администрацией");
			    if(IkeaInfo[i][iSale] == 0) return ErrorMessage(playerid, "{FF6347}Этот предмет временно не продаётся");
			    new yesbuy;
	        	if(listitem == 0)
				{
                    if(PlayerInfo[playerid][pDom] == 0) return ErrorMessage(playerid, "{FF6347}У вас нет дома");
                    
					new put_inva = PutThingDom(PlayerInfo[playerid][pDom], IkeaInfo[i][iModel], 1, 0, 0, 4, 0, 999);
					if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}В доме нет места");
					format(string,sizeof(string),"{ffcc66}[ IKEA ]: {cccccc}Предмет {0088ff}%s {cccccc}[Model: %d] доставлен в Дом № %d",IkeaInfo[i][iName], IkeaInfo[i][iModel], PlayerInfo[playerid][pDom]);
					SendClientMessage(playerid, COLOR_GREY, string);
					yesbuy = 1;
				}
				if(listitem == 1)
				{
                    if(PlayerInfo[playerid][pBusiness] == 0) return ErrorMessage(playerid, "{FF6347}У вас нет бизнеса");
                    if(!IsABizInteriorFrame(PlayerInfo[playerid][pBusiness])) return ErrorMessage(playerid, "{FF6347}Ваш бизнес не поддерживает режим строительства интерьеров");
                    
					new put_inva = PutThingBiz(PlayerInfo[playerid][pBusiness], IkeaInfo[i][iModel], 1, 0, 0, 4, 999);
					if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}На складе бизнеса нет места");
					format(string,sizeof(string),"{ffcc66}[ IKEA ]: {cccccc}Предмет {0088ff}%s {cccccc}[Model: %d] доставлен в %s № %d",IkeaInfo[i][iName], IkeaInfo[i][iModel], bizname(PlayerInfo[playerid][pBusiness]), PlayerInfo[playerid][pBusiness]);
					SendClientMessage(playerid, COLOR_GREY, string);
					
					yesbuy = 1;
				}
				if(listitem >= 2 && listitem <= 12)
				{
				    new fb = List[listitem-2][playerid];
				    if(fb == 0) return ErrorMessage(playerid, "{FF6347}В слоте покупки нет бизнеса");
				    if(!IsABizInteriorFrame(fb)) return ErrorMessage(playerid, "{FF6347}Этот бизнес не поддерживает режим строительства интерьеров");
                    
					new put_inva = PutThingBiz(fb, IkeaInfo[i][iModel], 1, 0, 0, 4, 999);
					if(put_inva == -1) return ErrorMessage(playerid, "{FF6347}На складе бизнеса нет места");
					format(string,sizeof(string),"{ffcc66}[ IKEA ]: {cccccc}Предмет {0088ff}%s {cccccc}[Model: %d] доставлен в %s № %d",IkeaInfo[i][iName], IkeaInfo[i][iModel], bizname(fb), fb);
					SendClientMessage(playerid, COLOR_GREY, string);
					yesbuy = 1;
				}
				if(yesbuy == 1)
				{
					new price = IkeaInfo[i][iPrice];
					if(oGetPlayerMoney(playerid) < price) return format(string, sizeof(string), "{FF6347}Вам не хватает денег\n{cccccc}Стоимость %s: %d$ [%s]",IkeaInfo[i][iName],price,get_k(price)), ErrorMessage(playerid, string);
					oGivePlayerMoney(playerid, -price);
					PutMoneyToTreasury(price, "Покупка мебели в IKEA"); // Кладём деньги в казну за покупку товара в икеа
					PlayerPlaySound(playerid,6401,0,0,0);
					CompleteBattlePassTask(playerid, 27, 1, price);
					CompleteBattlePassTask(playerid, 28, 1);
					MoneyLog("buyfurn", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", -price, IkeaInfo[i][iName]);
				}
			}
			else ErrorMessage(playerid, "{FF6347}Вы отошли от предмета");
        }
	}
