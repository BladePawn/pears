stock PosPcDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 5 || setting_size_draw[playerid] == 5) positiond_x = pcdraw_x+set_pos_x[playerid], positiond_y = pcdraw_y+set_pos_y[playerid];
    else positiond_x = pcdraw_x+PlayerInfo[playerid][pDrawPos_X][4], positiond_y = pcdraw_y+PlayerInfo[playerid][pDrawPos_Y][4];

    if(setting_pos_draw[playerid] == 5 || setting_size_draw[playerid] == 5) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][4], sized_y = PlayerInfo[playerid][pDrawSize_Y][4];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[4], positiond_y += DrawPosSmart_Y[4], sized_y += DrawSizeSmart_Y[4];
    
    new Float:vrem_x, Float:vrem_y;
	new Float:koef_y, Float:reset;
	koef_y = (198.799957+sized_y)/100;

    PlayerTextDrawSetPos(playerid, PlayerPcDraw[0][playerid], positiond_x, positiond_y); // Фон + Обои
    PlayerTextDrawSetPos(playerid, PlayerPcDraw[1][playerid], positiond_x-0.749985, positiond_y-1.399963); // Левая Полоска
    PlayerTextDrawSetPos(playerid, PlayerPcDraw[2][playerid], positiond_x+230.930124+sized_x/1.15, positiond_y-1.399963); // Правая Полоска
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[3][playerid], positiond_x+2.374939, positiond_y-4.066666); // Верхняя Полоска
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[5][playerid], positiond_x-1.998856, positiond_y-5.800057); // Левое Скругление
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[6][playerid], positiond_x+228.081314+sized_x, positiond_y-5.800057); // Правое Скругление
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[7][playerid], positiond_x+1.500229, positiond_y-0.266579); // Вторичная Полоска Верхняя
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[8][playerid], positiond_x+3.3741+sized_x/8, positiond_y+koef_y*91.0); // Панель Пуск
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[8][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[4][playerid], positiond_x-0.749283, vrem_y+12.599981+sized_y*(12.599981/50)); // Нижняя Полоска
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[9][playerid], vrem_x+1.37503+sized_x*(1.37503/50), vrem_y+1.366614+sized_y*(1.366614/50)); // Сборная Кнопка Пуск
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[10][playerid], vrem_x+5.749374+sized_x*(5.749374/50), vrem_y+1.366614+sized_y*(1.366614/50)); // Сборная Кнопка Пуск
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[11][playerid], vrem_x+1.37503+sized_x*(1.37503/50), vrem_y+6.499853+sized_y*(6.499853/50)); // Сборная Кнопка Пуск
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[12][playerid], vrem_x+5.749374+sized_x*(5.749374/50), vrem_y+6.499853+sized_y*(6.499853/50)); // Сборная Кнопка Пуск
	
	
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[0][playerid], 232.829544+sized_x, 198.799957+sized_y); // Фон + Обои
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[1][playerid], 4.124197+sized_x/8, 200.666564+sized_y); // Левая Полоска
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[2][playerid], 4.124197+sized_x/8, 200.666564+sized_y); // Правая Полоска
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[3][playerid], 229.830200+sized_x, 4.199961+sized_y/8); // Верхняя Полоска
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[4][playerid], 235.778979+sized_x, 7.933294+sized_y/8); // Нижняя Полоска
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[5][playerid], 8.248452, 10.733291); // Левое Скругление
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[6][playerid], 8.248452, 10.733291); // Правое Скругление
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[7][playerid], 229.830200+sized_x, 4.199961+sized_y/8); // Вторичная Полоска Верхняя
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[8][playerid], 227.480581+sized_x-sized_x/4, 12.599981+sized_y*(12.599981/50)); // Панель Пуск
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[9][playerid], 3.749255+sized_x*(3.749255/50), 4.666678+sized_y*(4.666678/50)); // Сборная Кнопка Пуск
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[10][playerid], 3.749255+sized_x*(3.749255/50), 4.666678+sized_y*(4.666678/50)); // Сборная Кнопка Пуск
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[11][playerid], 3.749255+sized_x*(3.749255/50), 4.666678+sized_y*(4.666678/50)); // Сборная Кнопка Пуск
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[12][playerid], 3.749255+sized_x*(3.749255/50), 4.666678+sized_y*(4.666678/50)); // Сборная Кнопка Пуск
	
	new Float:size_pick_x = 29.994127+sized_x*(29.994127/70), Float:size_pick_y = 34.066665+sized_y*(34.066665/70), Float:razm_left_x, Float:razm_left_y, Float:vrem_x2, Float:vrem_y2, Float:razm_left_x2, Float:razm_left_y2;
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[1][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[7][playerid], reset, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[13][playerid], 2.0+vrem_x+4.124197+sized_x/8, 2.0+vrem_y+4.199961+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[17][playerid], 2.0+vrem_x+4.124197+sized_x/8, 4.0+vrem_y+4.199961+sized_y/8+size_pick_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[19][playerid], 2.0+vrem_x+4.124197+sized_x/8, 6.0+vrem_y+4.199961+sized_y/8+size_pick_y*2);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[15][playerid], 4.0+vrem_x+4.124197+sized_x/8+size_pick_x, 2.0+vrem_y+4.199961+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[21][playerid], 6.0+vrem_x+4.124197+sized_x/8+size_pick_x*2, 2.0+vrem_y+4.199961+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[24][playerid], 8.0+vrem_x+4.124197+sized_x/8+size_pick_x*3, 2.0+vrem_y+4.199961+sized_y/8);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[26][playerid], 10.0+vrem_x+4.124197+sized_x/8+size_pick_x*4, 2.0+vrem_y+4.199961+sized_y/8);
	
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[13][playerid], size_pick_x, size_pick_y); // bank_pick
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[15][playerid], size_pick_x, size_pick_y); // biznes_pick
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[17][playerid], size_pick_x, size_pick_y); // baza_pick
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[19][playerid], size_pick_x, size_pick_y); // fbi_pick
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[21][playerid], size_pick_x, size_pick_y); // komp_pick
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[24][playerid], size_pick_x, size_pick_y); // trade_pick
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[26][playerid], size_pick_x, size_pick_y); // GamingPick
	
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[13][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[14][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[15][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[16][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[17][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[18][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[19][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[20][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[21][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[22][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[24][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[25][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[26][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[27][playerid], vrem_x+size_pick_x/2, vrem_y+(size_pick_y/100)*80);
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[14][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // Ђa®k_Online
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[16][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // Ђњџ®ec
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[18][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // Ђaџa_ѓa®®Ёx
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[20][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // Cњc¦eЇa_FBI
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[22][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // KoЇЈ©«¦ep
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[25][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // KoЇЈ©«¦ep
	PlayerTextDrawLetterSize(playerid, PlayerPcDraw[27][playerid], 0.120439+sized_x*(0.120439/50), 0.545333+sized_y*(0.545333/40)); // Comp Club
	
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[2][playerid], vrem_x, vrem_y); // Правая Полоска
	PlayerTextDrawGetTextSize(playerid, PlayerPcDraw[2][playerid], razm_left_x, razm_left_y); // Правая Полоска
	PlayerTextDrawGetPos(playerid, PlayerPcDraw[4][playerid], vrem_x2, vrem_y2); // Нижняя Полоска
	PlayerTextDrawGetTextSize(playerid, PlayerPcDraw[4][playerid], razm_left_x2, razm_left_y2); // Нижняя Полоска
	
	PlayerTextDrawSetPos(playerid, PlayerPcDraw[23][playerid], vrem_x+razm_left_x, vrem_y2+razm_left_y2-(40.0+sized_y)); // Кнопка положить на землю или на стол
	PlayerTextDrawTextSize(playerid, PlayerPcDraw[23][playerid], 40.0+sized_x, 40.0+sized_y);
	return 1;
