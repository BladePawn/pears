function Call_clearsu(playerid, fractionid, const str_name[])
{
	new rows, string[144];
	cache_get_row_count(rows);

	if (!PDatabase_IsPlayerNearHack(playerid, fractionid) || !policeDatabaseInfo[fractionid][pdiHacked]) return ErrorMessage(playerid, "{FF6347}Вы далеко от базы данных или она не была взломана");
	if (policeDatabaseInfo[fractionid][pdiLastHackerID] != PlayerInfo[playerid][pID]) return ErrorMessage(playerid, "{FF6347}У вас нет доступа к базе данных");

	if(rows)
	{
		new datad;
		stop_dialog(playerid);
		cache_get_value_name_int(0, "Crimes", datad);
		if(datad == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Это не преступник.. [ Он не находится в розыске ]");

		if(datad > 12 && fractionid == 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В базе данных SAPD нельзя очищать розыск особо опасным преступникам.");
		if(datad < 6 && fractionid == 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: В базе данных FBI нельзя очищать розыск мелким преступникам.");

		mysql_format(pearsq, string,sizeof(string),"UPDATE `pp_igroki` SET `Crimes`='0' WHERE `Name`='%e'", str_name);
		query_empty(pearsq, string);
		PlayerPlaySound(playerid, 6401, 0, 0, 0);
		format(string, sizeof(string), "* %s очищен уровень розыска", str_name);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);

		policeDatabaseInfo[fractionid][pdiClearSuspectRemains]--;
	}
	else
	{
		format(string, sizeof(string), "[ Мысли ]: Такого человека не существует [ {ff0000}%s {cccccc}]", str_name), SendClientMessage(playerid, COLOR_GREY, string);
		PDatabase_Dialog_ClearId(playerid);
	}
	return 1;
}
function Call_mdc(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
	    new datad[25], married[24], victim[24], vehmdc[MAX_MYVEHICLE], loadt[20], Admin;

		cache_get_value_name_int(0, "Soska", Admin);

		if(Admin > 0) return SendClientLongMessage(playerid,COLOR_GREY, "[ Мысли ]: Кажется данного человека нет в базе данных"), pc_cmd_mdc(playerid);
		cache_get_value_name_int(0, "Sex", datad[0]);
		cache_get_value_name_int(0, "Model", datad[1]);
		cache_get_value_name_int(0, "Model2", datad[2]);
		cache_get_value_name_int(0, "Age", datad[3]);
		cache_get_value_name(0, "MarriedTo", married, 24);
		cache_get_value_name_int(0, "Member", datad[4]);
		cache_get_value_name_int(0, "Leader", datad[5]);
		cache_get_value_name_int(0, "Family", datad[6]);
		cache_get_value_name_int(0, "Money", datad[7]);
		cache_get_value_name_int(0, "Account", datad[8]);
		cache_get_value_name_int(0, "Gun13", datad[9]);
		cache_get_value_name_int(0, "Meshk1", datad[12]);

		for(new i = 0; i < MAX_MYVEHICLE; i++)
		{
			format(loadt,sizeof(loadt),"MyVeh%d",i);
	  		cache_get_value_name_int(0, loadt, vehmdc[i]);
		}
		cache_get_value_name_int(0, "Crimes", datad[18]);
		cache_get_value_name(0, "Victim", victim, 24); // Арестовал
		cache_get_value_name_int(0, "Jailed", datad[19]);
		cache_get_value_name_int(0, "JailTime", datad[20]);
		cache_get_value_name_int(0, "Level", datad[21]);
		cache_get_value_name_int(0, "user_id", datad[22]);
		cache_get_value_name_int(0, "Taxes0", datad[23]);
		cache_get_value_name_int(0, "Taxes1", datad[24]);
		//cache_get_value_name_int(0, "Nation", datad[25]);
		new atext[10], frakid;//, getskin;
		// Вычисляем Организацию
		if(datad[5] >= 1) frakid = datad[5];
		else if(datad[5] == 0) frakid = datad[4];
		// Вычисляем используемый Скин
		//if(frakid >= 1) getskin = datad[2];
		//else if(frakid == 0) getskin = datad[1];
		if(datad[0] == 1) atext = "Мужчина";
	    if(datad[0] == 2) atext = "Женщина";
	    //if(datad[25] == 0) ctext = "Светлокожий";
	    //else if(datad[25] == 1) ctext = "Темнокожий";
		new str[200],sctring[4500];
		format(str,sizeof(str),"\n	{ff9000}%s {444444}[ Level: %d ]\n",str_name,datad[21]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Возраст: {ff9000}%d",datad[3]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Пол: %s",atext), strcat(sctring,str);
		//format(str,sizeof(str),"\n{cccccc}Дополнительно: %s",ctext), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Семейное Положение: {ff9000}%s",married), strcat(sctring,str);
		if(frakid == 0 || frakid == 8) format(str,sizeof(str),"\n{cccccc}Организация: {444444}нет"), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Организация: %s",frakName[frakid]), strcat(sctring,str);
		if(datad[6] >= 1) format(str,sizeof(str),"\n{cccccc}Семья: %s [№%d]",FamilyInfo[datad[6]][fName],datad[6]), strcat(sctring,str);
		else format(str,sizeof(str),"\n{cccccc}Семья: {444444}нет"), strcat(sctring,str);
		format(str,sizeof(str),"\n\n{cccccc}Деньги: {99ff66}%d$",datad[7]), strcat(sctring,str);
		format(str,sizeof(str),"\n{cccccc}Банковский Счёт: {99ff66}%d$",datad[8]), strcat(sctring,str);

		new d = datad[9], b = datad[12], taxes;
		if(d > 0 && DomInfo[d][dSost] == datad[22]) taxes += DomInfo[d][dTaxes];
 		if(b > 0 && BizzInfo[b][bTaxes] == datad[22]) taxes += BizzInfo[b][bTaxes];
		format(str,sizeof(str),"\n{cccccc}Налоги: {FF6347}%d$",taxes+datad[23]+datad[24]), strcat(sctring,str);

		if(datad[9] >= 1) format(str,sizeof(str),"\n{cccccc}Дом: № %d",datad[9]), strcat(sctring,str);
		else if(datad[9] == 0) format(str,sizeof(str),"\n{cccccc}Дом: {444444}нет"), strcat(sctring,str);
		if(datad[12] >= 1) format(str,sizeof(str),"\n{cccccc}Бизнес: № %d {ff9000}[%s]\n",datad[12], bizname(datad[12])), strcat(sctring,str);
		else if(datad[12] == 0) format(str,sizeof(str),"\n{cccccc}Бизнес: {444444}нет\n"), strcat(sctring,str);

		for(new i = 0; i < MAX_MYVEHICLE; i++)
		{
			if(vehmdc[i] >= 400) format(str,sizeof(str),"\n{cccccc}Транспорт %d: {ff9000}%s", i + 1,GetVehicleName(vehmdc[i])), strcat(sctring,str);
		}
		if(datad[18] >= 1)
		{
			format(str,sizeof(str),"\n\n{cccccc}Розыск: {ff0000}%d",datad[18]), strcat(sctring,str);
		}
		else if(datad[18] == 0) format(str,sizeof(str),"\n\n{cccccc}Розыск: {444444}не находится в розыске"), strcat(sctring,str);
		if(datad[19] == 1 || datad[19] == 3 || datad[19] == 5)
		{
			format(str,sizeof(str),"\n\n{cccccc}Тюремный Срок: %d сек {444444}[ Арестовал: %s ]",datad[20],victim), strcat(sctring,str);
		}
		if(datad[19] == 4) format(str,sizeof(str),"\n\n{cccccc}Лечение в Больнице: %d сек",datad[20]), strcat(sctring,str);
		if(datad[19] == 2) format(str,sizeof(str),"\n\n{cccccc}Психиатрическая Больница: %d сек",datad[20]), strcat(sctring,str);
		ShowDialog(playerid,511,DIALOG_STYLE_MSGBOX,"{444444}База Данных",sctring,"Ок","");
	}
	else
	{
		new string[144];
		format(string,sizeof(string),"[ Мысли ]: Такого человека не существует [ {ff0000}%s {cccccc}]",str_name), SendClientMessage(playerid,COLOR_GREY,string);
		ShowDialog(playerid,566,DIALOG_STYLE_INPUT,"{444444}База Данных","{cccccc}Введите {ff9000}ID или никнейм {cccccc}игрока\nчтобы посмотреть всю информацию о нём","Принять","Отмена");
	}
	return 1;
}
forward Call_check(playerid, str_name[], stat);
public Call_check(playerid, str_name[], stat)
{
	new rows,married[24],datad0,datad1,datad2,datad3,datad5,datad6,datad7,datad8,datad9,datad36,datad44;
	new datad12,datad13,datad14,datad15,datad16,datad17,datad18,datad19,datad21,datad22,datad24[80],datad25[24],datad26,datad27,datad28,datad29,datad30,datad40;
	new datad49,datad50,datad51,datad52,datad53,datad55,datad56,datad57,ndat[24],datgpci[64],banrea[44],names[24],datad54[24], Division0, DivRank, DJ;
