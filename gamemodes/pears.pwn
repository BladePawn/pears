		if(MafGz[0][mTimer] <= 0)
		{
			MafGz[0][mStat] = 2;
			PlayFrak(MafGz[0][mZashita], 3201);
			PlayFrak(MafGz[0][mNapad], 3201);
			Strel[MafGz[0][mZashita]] = MafGz[0][mNapad];
			Strel[MafGz[0][mNapad]] = MafGz[0][mZashita];
			SendRadioMessage(MafGz[0][mZashita],COLOR_LIGHTRED,"{0088ff}[ Mafia War ]: Битва началась! {ffcc66}Все в бой!");
			SendRadioMessage(MafGz[0][mNapad],COLOR_LIGHTRED,"{0088ff}[ Mafia War ]: Битва началась! {ffcc66}Все в бой!");
