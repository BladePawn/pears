						GetDynamicObjectPos(Les[setles], X,Y,Z);
						Brevno[setles] = CreateDynamicObject(837, X, Y, Z, -84.0000, 2.0000, 86.0000);
						SetDynamicObjectPos(Les[setles], X, Y, Z-100.0);
						SetDynamicObjectRot(Les[setles], 0.0, 0.0, 0.0);
						GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~b~--- ~r~50/50 ~b~---", 4000, 3); PlayerPlaySound(playerid,6401,0,0,0);
