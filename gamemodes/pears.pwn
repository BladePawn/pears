		DomInfo[params[0]][dInvQara][inva] = 0;
		DomInfo[params[0]][dInvType][inva] = 0;
		DomInfo[params[0]][dInvPack][inva] = 0;
		if(oldthing != DomInfo[params[0]][dInvent][inva]) SaveOneTainik(params[0], inva);
	}
	mysql_tquery(pearsq, "COMMIT;");

	new string[128];
	format(string, sizeof(string), " [ ADM ]: %s очистил шкаф дома № %d", PlayerInfo[playerid][pName],params[0]);
 	ABroadCast(COLOR_ADM,string,1);
	HouseLog(0, "rgom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Очистил Шкаф");

	format(string, sizeof(string), "Очистил шкаф дома № %d",params[0]);
	AdminLog("rdom", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], string);
	return 1;
}
CMD:rdomgun(playerid, const params[])
{
    if(PlayerInfo[playerid][pSoska] < 15) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать..");
    if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Удалить оружие из шкафа дома [ /rgomgun ID ]");
    if(params[0] > 1000 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Номер дома не меньше 1 и не больше 1000");

	mysql_tquery(pearsq, "START TRANSACTION;");
	for(new inva = 0; inva < 80; inva++)
	{
		if(DomInfo[params[0]][dInvType][inva] == 1)
		{
			new oldthing = DomInfo[params[0]][dInvent][inva];
			DomInfo[params[0]][dInvent][inva] = 0;
			DomInfo[params[0]][dInv][inva] = 0;
			DomInfo[params[0]][dInvPara][inva] = 0;
			DomInfo[params[0]][dInvQara][inva] = 0;
			DomInfo[params[0]][dInvType][inva] = 0;
			DomInfo[params[0]][dInvPack][inva] = 0;
			if(oldthing != DomInfo[params[0]][dInvent][inva]) SaveOneTainik(params[0], inva);
		}
	}
	mysql_tquery(pearsq, "COMMIT;");

	new string[128];
	format(string, sizeof(string), " [ ADM ]: %s удалил оружие из шкафа дома № %d", PlayerInfo[playerid][pName],params[0]);
 	ABroadCast(COLOR_ADM,string,1);
	HouseLog(0, "rgomgun", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], params[0], 0, "Удалил Оружие");

	format(string, sizeof(string), "Удалил оружие из дома № %d",params[0]);
	AdminLog("rdomgun", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], string);
	return 1;
}

