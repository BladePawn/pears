	return 1;
}

public OnPlayerEditAttachedObject(playerid, EDIT_RESPONSE:response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	new slot;
    if(index == 5) slot = 0;
    else if(index == 6) slot = 1;
    else if(index == 7) slot = 2;
    else if(index == 8) slot = 3;
    else if(index == 9) slot = 4;
    if(response)
    {
    	if(modelid <= 320 || modelid > MAX_OBJECT_MODEL_ID) return RemovePlayerAttachedObject(playerid,index), CancelPlayerEditObject(playerid), PlayerInfo[playerid][pOdet][slot] = 0;
    	if(fOffsetX >= 0.6 || fOffsetX <= -0.6 || fOffsetY >= 0.6 || fOffsetY <= -0.6 || fOffsetZ >= 0.6 || fOffsetZ <= -0.6)
		{
			if(gRedakt[playerid] == REDAKT_TYPE_ACCS) SetPlayerAttachedObject(playerid, index, PlayerInfo[playerid][pOdet][slot], boneid, PlayerInfo[playerid][pOdet_X][slot], PlayerInfo[playerid][pOdet_Y][slot], PlayerInfo[playerid][pOdet_Z][slot], PlayerInfo[playerid][pOdet_rX][slot], PlayerInfo[playerid][pOdet_rY][slot], PlayerInfo[playerid][pOdet_rZ][slot], PlayerInfo[playerid][pOdet_sX][slot], PlayerInfo[playerid][pOdet_sY][slot], PlayerInfo[playerid][pOdet_sZ][slot]);
			ErrorMessage(playerid, "{FF6347}Аксессуар слишком далеко от персонажа"), PlayerPlaySound(playerid,4203,0,0,0), CancelPlayerEditObject(playerid), fOffsetX = 0.0, fOffsetY = 0.0, fOffsetZ = 0.0;
			return 1;
		}
    	if(fScaleX >= 3.000 || fScaleX <= -3.000 || fScaleY >= 3.000 || fScaleY <= -3.000 || fScaleZ >= 3.000 || fScaleZ <= -3.000)
		{
			if(gRedakt[playerid] == REDAKT_TYPE_ACCS) SetPlayerAttachedObject(playerid, index, PlayerInfo[playerid][pOdet][slot], boneid, PlayerInfo[playerid][pOdet_X][slot], PlayerInfo[playerid][pOdet_Y][slot], PlayerInfo[playerid][pOdet_Z][slot], PlayerInfo[playerid][pOdet_rX][slot], PlayerInfo[playerid][pOdet_rY][slot], PlayerInfo[playerid][pOdet_rZ][slot], PlayerInfo[playerid][pOdet_sX][slot], PlayerInfo[playerid][pOdet_sY][slot], PlayerInfo[playerid][pOdet_sZ][slot]);
			ErrorMessage(playerid, "{FF6347}Аксессуар слишком сильно растянут или сжат"), PlayerPlaySound(playerid,4203,0,0,0), CancelPlayerEditObject(playerid), fScaleX = 0.0, fScaleY = 0.0, fScaleZ = 0.0;
			return 1;
		}
		
		// Игрок сохраняет отредактированный аксессуар
		if(gRedakt[playerid] == REDAKT_TYPE_ACCS)
		{
	    	PlayerInfo[playerid][pOdet][slot] = modelid;
	        PlayerInfo[playerid][pOdet_X][slot] = fOffsetX;
	        PlayerInfo[playerid][pOdet_Y][slot] = fOffsetY;
	        PlayerInfo[playerid][pOdet_Z][slot] = fOffsetZ;
	        PlayerInfo[playerid][pOdet_rX][slot] = fRotX;
	        PlayerInfo[playerid][pOdet_rY][slot] = fRotY;
	        PlayerInfo[playerid][pOdet_rZ][slot] = fRotZ;
	        PlayerInfo[playerid][pOdet_sX][slot] = fScaleX;
	        PlayerInfo[playerid][pOdet_sY][slot] = fScaleY;
	        PlayerInfo[playerid][pOdet_sZ][slot] = fScaleZ;
	  		PlayerInfo[playerid][pOdetBone][slot] = boneid;
	        SetPlayerAttachedObject(playerid, index, PlayerInfo[playerid][pOdet][slot], boneid, PlayerInfo[playerid][pOdet_X][slot], PlayerInfo[playerid][pOdet_Y][slot], PlayerInfo[playerid][pOdet_Z][slot], PlayerInfo[playerid][pOdet_rX][slot], PlayerInfo[playerid][pOdet_rY][slot], PlayerInfo[playerid][pOdet_rZ][slot], PlayerInfo[playerid][pOdet_sX][slot], PlayerInfo[playerid][pOdet_sY][slot], PlayerInfo[playerid][pOdet_sZ][slot]);
	        UpdateOdet(playerid, slot);
	        
	        // Записываем корректировки для каждого скина в режиме редактора
	        /*if(AccessoryEditSkin == 1)
	        {
	            new findAcc = -1;
			    for(new i = 0; i < MAX_ACCESSORY; i++)
				{
				    if(AccessoryInfo[i][acModel] == modelid && AccessoryInfo[i][acBone] == boneid)
				    {
		                findAcc = i;
		                break;
				    }
		  		}
	        
				// Корректировки по расположению относительно головы
	            //printf("case %d: X = %f, Y = %f, Z = %f, sX = %f, sY = %f, sZ = %f;", GetPlayerModelSkinOriginal(playerid), AccessoryInfo[findAcc][acX]-PlayerInfo[playerid][pOdet_X][slot], AccessoryInfo[findAcc][acY]-PlayerInfo[playerid][pOdet_Y][slot], AccessoryInfo[findAcc][acZ]-PlayerInfo[playerid][pOdet_Z][slot], AccessoryInfo[findAcc][acsX]-PlayerInfo[playerid][pOdet_sX][slot], AccessoryInfo[findAcc][acsY]-PlayerInfo[playerid][pOdet_sY][slot], AccessoryInfo[findAcc][acsZ]-PlayerInfo[playerid][pOdet_sZ][slot]);
	        }*/
     	}
     	
     	// Админ сохраняет параметры аксессуара
     	if(gRedakt[playerid] == REDAKT_TYPE_ADM_ACCS)
		{
		    new i = GetPVarInt(playerid, "gRedakt3");
		    AccessoryInfo[i][acX] = fOffsetX;
			AccessoryInfo[i][acY] = fOffsetY;
			AccessoryInfo[i][acZ] = fOffsetZ;
			AccessoryInfo[i][acrX] = fRotX;
			AccessoryInfo[i][acrY] = fRotY;
			AccessoryInfo[i][acrZ] = fRotZ;
			AccessoryInfo[i][acsX] = fScaleX;
			AccessoryInfo[i][acsY] = fScaleY;
			AccessoryInfo[i][acsZ] = fScaleZ;
		    AccessoryInfo[i][acUpdate] = true;
		    RemovePlayerAttachedObject(playerid, index);
		    AccessorySetting(playerid, i);
		    
		    AdminLog("accessory", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", AccessoryInfo[i][acModel], "Изменил крепление");
		}
        CancelPlayerEditObject(playerid);
        PlayerPlaySound(playerid,5601,0,0,0);
    }
    else
	{
		if(gRedakt[playerid] == REDAKT_TYPE_ACCS) SetPlayerAttachedObject(playerid, index, PlayerInfo[playerid][pOdet][slot], boneid, PlayerInfo[playerid][pOdet_X][slot], PlayerInfo[playerid][pOdet_Y][slot], PlayerInfo[playerid][pOdet_Z][slot], PlayerInfo[playerid][pOdet_rX][slot], PlayerInfo[playerid][pOdet_rY][slot], PlayerInfo[playerid][pOdet_rZ][slot], PlayerInfo[playerid][pOdet_sX][slot], PlayerInfo[playerid][pOdet_sY][slot], PlayerInfo[playerid][pOdet_sZ][slot]);
		else if(gRedakt[playerid] == REDAKT_TYPE_ADM_ACCS)
		{
		    new i = GetPVarInt(playerid, "gRedakt3");
			RemovePlayerAttachedObject(playerid, index);
			AccessorySetting(playerid, i);
		}
		CancelPlayerEditObject(playerid);
	}
    return 1;
}
stock check_lic(playerid, model)
{
	// Не требуем лицензию, если человек в тестдрайве (на всякий случай и проверка на виртуальный мир)
	if (VehShopInfo[playerid][vsTest] && GetPlayerVirtualWorld(playerid) != 0) return 1;

	// Не требуем лицензию, если человек администратор 2+ уровня
	if (PlayerInfo[playerid][pSoska] >= 2) return 1;

    if(IsACar(model))
	{
		if(get_invent2(playerid, 156, 0) <= 0)
		{
			ErrorMessage(playerid, "{FF6347}У вас нет водительских прав\n{cccccc}Их можно приобрести в образовательном центре {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
        if(PlayerInfo[playerid][pCarLic] <= 99)
        {
			ErrorMessage(playerid, "{FF6347}Вы не умеете управлять автомобилем [ Y >> Меню >> Навыки ]\n{cccccc}Необходимо обучиться этому навыку {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
	}
	if(IsABoat(model) && model != 473)
	{
		if(get_invent2(playerid, 158, 0) <= 0)
		{
			ErrorMessage(playerid, "{FF6347}У вас нет прав на управление катером\n{cccccc}Их можно приобрести в образовательном центре {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
        if(PlayerInfo[playerid][pBoatLic] <= 99)
        {
			ErrorMessage(playerid, "{FF6347}Вы не умеете управлять катером [ Y >> Меню >> Навыки ]\n{cccccc}Необходимо обучиться этому навыку {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
	}
	if(IsAPlane(model))
	{
	    if(get_invent2(playerid, 157, 0) <= 0)
		{
			ErrorMessage(playerid, "{FF6347}У вас нет лицензии пилота\n{cccccc}Её можно приобрести в образовательном центре {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
		if(IsAAir(model))
		{
        	if(PlayerInfo[playerid][pFlyLic] <= 99)
        	{
				ErrorMessage(playerid, "{FF6347}Вы не умеете управлять самолетом [ Y >> Меню >> Навыки ]\n{cccccc}Необходимо обучиться этому навыку {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
				return 0;
  			}
		}
		if(IsAHeli(model))
		{
        	if(PlayerInfo[playerid][pHeliLic] <= 99)
        	{
				ErrorMessage(playerid, "{FF6347}Вы не умеете управлять вертолетом [ Y >> Меню >> Навыки ]\n{cccccc}Несмотря на имеющуюся лицензию, вертолёты - отдельный, от управления самолётами, навык\n\nОтправляйтесь в библиотеку о.ц. и прочитайте учебник: Винтокрылые машины {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
				return 0;
  			}
		}
	}
	if(IsAMoto(model) && model != 462)
	{
		if(get_invent2(playerid, 159, 0) <= 0)
		{
			ErrorMessage(playerid, "{FF6347}У вас нет лицензии на мототранспорт\n{cccccc}Их можно приобрести в образовательном центре {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
        if(PlayerInfo[playerid][pMotoLic] <= 99)
        {
			ErrorMessage(playerid, "{FF6347}Вы не умеете управлять мототранспортом [ Y >> Меню >> Навыки ]\n{cccccc}Необходимо обучиться этому навыку {ffcc66}[ Y >> GPS >> Образовательный Центр ]");
			return 0;
  		}
	}
	
	return 1;
}

stock AutoCloseVehicle(playerid, vehicleid)
{	
	if(IsAVello(vehicleid)) return false; // Велик игнорим
	if(VehInfo[vehicleid][vCarLock] == 1) return false; // Транспорт уже заперт

	if(notakey(playerid, vehicleid)) // Есть ключи от транспорта
	{
		LockedVehicle(playerid, vehicleid); // Автоматически запираем транспорт
	}
	return true;
}

stock VehicleRentCar(vehicleid)
{
	if(Cars[vehicleid] == 53 || Cars[vehicleid] == 52) return true;
	return false;
}

stock notakey(playerid, vehicleid)
{
    if(Cars[vehicleid] == 88) // Личный
	{
        if(VehInfo[vehicleid][vSost] == PlayerInfo[playerid][pID]) return 1;
		else if(VehInfo[vehicleid][vKey] == PlayerInfo[playerid][pID] && VehInfo[vehicleid][vKeyUnix] > gettime()) return 1;
		else if(PlayerInfo[playerid][pSoska] >= 19 && ADUTY[playerid] == 1
			|| PlayerInfo[playerid][pSoska] >= 22) return true;
		else return 0;
	}
	if(Cars[vehicleid] == 54) // Надувная лодка
	{
		if(VehInfo[vehicleid][vAgetid] != playerid) return 0;
	}
	if(Cars[vehicleid] == 53 || Cars[vehicleid] == 52) // Новая аренда + марс ровер
	{
		if(VehInfo[vehicleid][vAgetid] != playerid) return 0;
	}

	// SAPD
	if(vehicleid >= LSPDcar[0] && vehicleid <= LSPDcar[1] || Cars[vehicleid] == 1
		|| vehicleid >= NonLSCar[0] && vehicleid <= NonLSCar[1]

		|| vehicleid >= SFPDcar[0] && vehicleid <= SFPDcar[1] || Cars[vehicleid] == 11
		|| vehicleid >= NonSFCar[0] && vehicleid <= NonSFCar[1]

		|| vehicleid >= swatcar[0] && vehicleid <= swatcar[1] 
		|| vehicleid == janswat[0] || vehicleid == janswat[1] 
		|| vehicleid == janswat[2] || vehicleid == janswat[3] 
		|| Cars[vehicleid] == 22)
	{
        if(PlayerInfo[playerid][pMember] != 1 && PlayerInfo[playerid][pLeader] != 1 
			&& PlayerInfo[playerid][pMember] != 11 && PlayerInfo[playerid][pLeader] != 11
			&& PlayerInfo[playerid][pMember] != 22 && PlayerInfo[playerid][pLeader] != 22) return 0;
	}

	// ASGH
	if(vehicleid >= Medcar[0] && vehicleid <= Medcar[1] || Cars[vehicleid] == 4)
	{
        if(PlayerInfo[playerid][pMember] != 4 && PlayerInfo[playerid][pLeader] != 4) return 0;
	}

	if(vehicleid >= fbicar[0] && vehicleid <= fbicar[1] || Cars[vehicleid] == 2) // FBI
	{
        if(PlayerInfo[playerid][pMember] != 2 && PlayerInfo[playerid][pLeader] != 2 && PlayerInfo[playerid][pFbi] == 0) return 0;
	}
	if(vehicleid >= armcar[0] && vehicleid <= armcar[1] || Cars[vehicleid] == 3) // Army
	{
	    if(PlayerInfo[playerid][pMember] != 3 && PlayerInfo[playerid][pLeader] != 3) return 0;
	}
	if(Cars[vehicleid] == 5) // Cosa Nostra
	{
        if(PlayerInfo[playerid][pMember] != 5 && PlayerInfo[playerid][pLeader] != 5) return 0;
	}
	if(Cars[vehicleid] == 6) // Yakuza Mafia
	{
        if(PlayerInfo[playerid][pMember] != 6 && PlayerInfo[playerid][pLeader] != 6) return 0;
	}

	if(vehicleid >= govcar[0] && vehicleid <= govcar[1] || Cars[vehicleid] == 7) // Правительство
	{
        if(PlayerInfo[playerid][pMember] != 7 && PlayerInfo[playerid][pLeader] != 7) return 0;
	}

	if(vehicleid >= cnncar[0] && vehicleid <= cnncar[1] || Cars[vehicleid] == 9) // CNN
	{
        if(PlayerInfo[playerid][pMember] != 9 && PlayerInfo[playerid][pLeader] != 9) return 0;
	}
	if(Cars[vehicleid] == 10) // Triada Mafia
	{
        if(PlayerInfo[playerid][pMember] != 10 && PlayerInfo[playerid][pLeader] != 10) return 0;
	}
	if(Cars[vehicleid] == 12) // Русская Мафия
	{
        if(PlayerInfo[playerid][pMember] != 12 && PlayerInfo[playerid][pLeader] != 12) return 0;
	}
 	if(Cars[vehicleid] == 13) // Grove Street
	{
        if(PlayerInfo[playerid][pMember] != 13 && PlayerInfo[playerid][pLeader] != 13) return 0;
	}
	if(Cars[vehicleid] == 14) // Ballas Gang
	{
        if(PlayerInfo[playerid][pMember] != 14 && PlayerInfo[playerid][pLeader] != 14) return 0;
	}
	if(Cars[vehicleid] == 15) // Vagos Gang
	{
        if(PlayerInfo[playerid][pMember] != 15 && PlayerInfo[playerid][pLeader] != 15) return 0;
	}
	if(Cars[vehicleid] == 16) // Los Aztecas
	{
        if(PlayerInfo[playerid][pMember] != 16 && PlayerInfo[playerid][pLeader] != 16) return 0;
	}
	if(Cars[vehicleid] == 18) // Arabian Mafia
	{
        if(PlayerInfo[playerid][pMember] != 18 && PlayerInfo[playerid][pLeader] != 18) return 0;
	}
	if(vehicleid == Hvert[7])
	{
        if(PlayerInfo[playerid][pDom] == 75 || PlayerInfo[playerid][pHouserent] == 75
		|| DomInfo[75][dFam] >= 1 && PlayerInfo[playerid][pFamily] >= 1 && DomInfo[75][dFam] == PlayerInfo[playerid][pFamily]) { }
		else return 0;
	}
	if(vehicleid == Hvert[5])
	{
        if(PlayerInfo[playerid][pDom] == 169 || PlayerInfo[playerid][pHouserent] == 169
		|| DomInfo[169][dFam] >= 1 && PlayerInfo[playerid][pFamily] >= 1 && DomInfo[169][dFam] == PlayerInfo[playerid][pFamily]) { }
		else return 0;
	}
	if(vehicleid == Hvert[1])
	{
        if(PlayerInfo[playerid][pDom] != 103 && PlayerInfo[playerid][pHouserent] != 103
		&& (DomInfo[104][dFam] >= 1 && DomInfo[104][dFam] != PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1)) return 0;
	}
	if(vehicleid == Hvert[4])
	{
        if(PlayerInfo[playerid][pDom] == 88 || PlayerInfo[playerid][pHouserent] == 88
		|| DomInfo[88][dFam] >= 1 && PlayerInfo[playerid][pFamily] >= 1 && DomInfo[88][dFam] == PlayerInfo[playerid][pFamily]) { }
		else return 0;
	}
	if(vehicleid == Hvert[2])
	{
        if(PlayerInfo[playerid][pDom] == 105 || PlayerInfo[playerid][pHouserent] == 105
		|| DomInfo[105][dFam] >= 1 && PlayerInfo[playerid][pFamily] >= 1 && DomInfo[105][dFam] == PlayerInfo[playerid][pFamily]) { }
		else return 0;
	}

	// Вертолёт дома 142
	if(vehicleid == Hvert[3])
	{
        if(PlayerInfo[playerid][pDom] == 142 || PlayerInfo[playerid][pHouserent] == 142
		|| DomInfo[142][dFam] >= 1 && PlayerInfo[playerid][pFamily] >= 1 && DomInfo[142][dFam] == PlayerInfo[playerid][pFamily]) { }
		else return 0;
	}

	if(Cars[vehicleid] >= 1000 && Cars[vehicleid] <= 2000)
	{
		if(PlayerInfo[playerid][pFamily] != Cars[vehicleid]-1000) return 0;
	}

	// Транспорт квеста (Нет ключей)
	if(vehicleid == QuestInfo[playerid][VehicleQuest] && QuestInfo[playerid][VehicleQuest]) return 0;
	return 1;
}
public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if(CallPublic(playerid, 6)) return false;

	if(IsPlayerNPC(playerid)) return 1;

	if(OnlineInfo[playerid][oLogged] == 0) return 0;
	if(vehicleid == INVALID_VEHICLE_ID) return 0;

	if(!ispassenger) EnteringVehicle[playerid] = true;

	if(Dei[playerid] == 9)
	{
		ErrorMessage(playerid, "{FF6347}Вы не можете сесть в транспорт с контейнером в руках"), ClearAnimations(playerid);
		return 0;
	}
	
	// Роняем Ящик
    if(OnlineInfo[playerid][oInHandThing][0] > 0 
		&& (OnlineInfo[playerid][oInHandThing][5] == 2 || OnlineInfo[playerid][oInHandThing][5] == 4)) Throw(playerid, OnlineInfo[playerid][oInHandThing][0], OnlineInfo[playerid][oInHandThing][1], OnlineInfo[playerid][oInHandThing][2], OnlineInfo[playerid][oInHandThing][3], OnlineInfo[playerid][oInHandThing][4], OnlineInfo[playerid][oInHandThing][5]);
    
    if(PPP15[playerid] == 3)
    {
        ErrorMessage(playerid, "{FF6347}Вы не можете сесть в транспорт с ящиком в руках"), ClearAnimations(playerid);
		return 0;
    }

	if(ispassenger == 0)
	{
	    Afenterveh[playerid] ++;
		if(Afenterveh[playerid] >= 20)
		{
		    SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347} Вы были кикнуты по причине: Флуд [Code: 4012].");
	  		ShowDialog(playerid,1996,DIALOG_STYLE_MSGBOX,"{ff0000}****  {FFFFFF}*[Protect Project]*  {ff0000}****","{ff0000}******** {ffffff}Вы были кикнуты по причине: Флуд [Code: 4012] {ff0000}********","*","");
	  		Kickx(playerid);
	  		return 0;
		}

	  	if(VehInfo[vehicleid][vSeat] > 0)
	  	{
    		ClearAnimations(playerid), ErrorMessage(playerid, "{FF6347}Транспорт занят");
			return 0;
	  	}

		if(IsAVehicleNPC(vehicleid))
	  	{
    		ClearAnimations(playerid), ErrorMessage(playerid, "{FF6347}Нельзя сесть за руль этого транспорта");
			return 0;
	  	}

		new model = VehInfo[vehicleid][vModel];
	  	if(Cars[vehicleid] == 9999 || Cars[vehicleid] == 52)
	  	{
	  		Enterveh[playerid] = vehicleid;
	  		SetPlayerArmedWeapon(playerid, WEAPON:0);
		  	return 1;
	  	}
	  	
		// 	Проверка на лицензии
	  	if(!check_lic(playerid, model))
	  	{
	  		ClearAnimations(playerid);
		  	return 0;
	  	}
		
		// Запертый транспорт
	  	if(VehInfo[vehicleid][vCarLock] >= 1)
	  	{
			ClearAnimations(playerid);
			if(IsACar(VehInfo[vehicleid][vModel]) || IsAPlane(VehInfo[vehicleid][vModel]))
			{
				ErrorMessage(playerid, "{FF6347}Транспорт заперт\n{cccccc}Вы можете взломать замок транспорта - ALT");
			}
			else ErrorMessage(playerid, "{FF6347}Транспорт заперт\n{cccccc}Замок этого транспорта нельзя взломать");
			return 0;
	  	}

		if(Cars[vehicleid] == 54)
		{
			if(VehInfo[vehicleid][vAgetid] != playerid)
			{
				new str[71],sctring[360];
				format(str,sizeof(str),"\n{FF6347}У вас нет ключей от этой лодки"), strcat(sctring,str);
				format(str,sizeof(str),"\n\n{cccccc}Тип Транспорта: {0088ff}Личный"), strcat(sctring,str);
				if(PlayerInfo[playerid][pSoska] >= 1 || IsPoliceMember(playerid))
				{
					if(IsOnline(VehInfo[vehicleid][vAgetid])) format(str,sizeof(str),"\n\n{cccccc}Принадлежит: {0088ff}%s",PlayerInfo[VehInfo[vehicleid][vAgetid]][pName]), strcat(sctring,str);
				}
				format(str,sizeof(str),"\n"), strcat(sctring,str);
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}*",sctring,"*","");
				ClearAnimations(playerid);
				PlayerPlaySound(playerid,24600,0,0,0);
				return 0;
			}
		}
		
		if(vehicleid >= bizsalonveh[0] && vehicleid <= bizsalonveh[10])
		{
		    ClearAnimations(playerid), ErrorMessage(playerid, "{FF6347}Транспорт заперт");
			return 0;
		}
		if(Cars[vehicleid] == 3)
		{
		    if(model == 432)
		    {
			    if(Tank[playerid] != 1) return ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{000000}*","{0088ff}* {ffffff}Танк Национальной Гвардии \n\n{0088ff}* {ffffff}Хм... Люк танка не так просто взломать..\n\nТолько Генерал может дать мне разрешение {ff9000}[ /tank ]","Ок",""), ClearAnimations(playerid);
		    }
		    if(model == 520 || model == 476 || model == 563 || model == 447 || model == 425)
		    {
		    	if(PlayerInfo[playerid][pMember] != 3 && !GetAccessRankOrgMay(playerid, PlayerInfo[playerid][pMember], 49, NO_FBI)) return ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{000000}*","{0088ff}* {ffffff}Транспорт ВВС \n\nУстановлена сложная система безопасности\nНа данный момент взломать замок невозможно!","Ок",""), ClearAnimations(playerid);
		    }
		}
		Enterveh[playerid] = vehicleid;
		SetPlayerArmedWeapon(playerid, WEAPON:0);
	}
	else if(ispassenger > 0)
	{
		// Вагоны поезда
		if(vehicleid == train + 1 || vehicleid == train + 2 || vehicleid == train + 3)
		{
    		ClearAnimations(playerid), ErrorMessage(playerid, "{FF6347}Вы не можете сесть в этот вагон поезда\n{cccccc}Подойдите к главному вагону и нажмите G");
			SetCameraBehindPlayer(playerid);
			return 0;
	  	}

		// Пассажирское место поезда
		if(vehicleid == train)
		{
			if(!EnterTrain(playerid, 0)) return 0;
	  	}

		if(VehInfo[vehicleid][vCarLock] >= 1 && vehicleid != train)
	  	{
    		ClearAnimations(playerid), ErrorMessage(playerid, "{FF6347}Транспорт заперт");
			return 0;
	  	}

		// Помечаем, что игрок садится в транспорт в течении 5 сек
		VehInfo[vehicleid][vSittingPassenger] = 5;
	}
	return 1;
}
public OnPlayerExitVehicle(playerid, vehicleid)
{	
	if(CallPublic(playerid, 7)) return false;

	if(OnlineInfo[playerid][oLogged] == 0) return 0;

	// Фикс античита при выходе из транспорта если чел за рулём афк
	GetVehiclePos(vehicleid, Protect_X[playerid], Protect_Y[playerid], Protect_Z[playerid]);

    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
	    SetCameraBehindPlayer(playerid);
		return 1;
	}
	new model = VehInfo[vehicleid][vModel];
	if(model == 452 || model == 453 || model == 454)
	{
		if(VehicleSpeed[vehicleid] >= 3)
		{
			new Float:X,Float:Y,Float:Z;
			GetVehiclePos(vehicleid, X,Y,Z);
	        PPSetPlayerPos(playerid, X, Y, Z+3.0);
		}
	}

	zaprcar[playerid] = vehicleid;

	// Помечаем что игрок выходит из транспорта в течении 5 сек
	VehInfo[vehicleid][vExitSeat] = 5;
	return 1;
}
stock IsPoliceMember(playerid)
{
	static const police_fractions[] = {1, 2, 11, 21, 22};
	for (new i = 0; i < sizeof(police_fractions); i++)
		if (PlayerInfo[playerid][pLeader] == police_fractions[i] || PlayerInfo[playerid][pMember] == police_fractions[i])
			return 1;

	return 0;
}

stock IsADepart(playerid)
{
	if(IsDepartmentOrganization(PlayerInfo[playerid][pMember])) return true;
	return false;
}

stock IsDepartmentOrganization(orgid)
{
	new available_fractions[] = {1, 2, 3, 4, 7, 11, 21, 22};
	for (new i = 0; i < sizeof(available_fractions); i++) {
		new fraction_id = available_fractions[i];
		if (orgid == fraction_id) return true;
	}
	return false;
}

stock IsAGunSkladDepart(g)
{
    if(g == 1 || g == 2 || g == 3 || g == 7 || g == 11 || g == 21 || g == 22) return 1;
	return 0;
}
stock IsAPoliceFunction(g)
{
	if(g == 1 || g == 2 || g == 11 || g == 21 || g == 22) return 1;
	return 0;
}
stock IsPolice(g)
{
	if(g == 1 || g == 11 || g == 21) return 1;
	return 0;
}
stock IsAUpdateMapOrganization(g)
{
	if(g == 1 || g == 2 || g == 3 || g == 4 || g == 6 || g == 7 || g == 9 || g == 11 || g == 13 || g == 14 || g == 15 || g == 16 || g == 22) return 1;
	return 0;
}
stock IsAGangCapt(playerid)
{
    new leader = PlayerInfo[playerid][pLeader];
    new member = PlayerInfo[playerid][pMember];
    if(member==13 || member==14 || member==15 || member==16) return 1;
	if(leader==13 || leader==14 || leader==15 || leader==16) return 1;
	return 0;
}
stock IsGangMember(playerid)
{
    new leader = PlayerInfo[playerid][pLeader];
    new member = PlayerInfo[playerid][pMember];
    if(member==13 || member==14 || member==15 || member==16 || member==17) return 1;
	if(leader==13 || leader==14 || leader==15 || leader==16 || leader==17) return 1;
	return 0;
}
stock IsMafiaMember(playerid)
{
    new leader = PlayerInfo[playerid][pLeader];
    new member = PlayerInfo[playerid][pMember];
    if(member==5 || member==6 || member==10 || member==12 || member==18 || leader==5 || leader==6 || leader==10 || leader==12 || leader==18) return 1;
	return 0;
}
stock IsAZams(playerid)
{
	if(PlayerInfo[playerid][pMember] >= 1)
	{
		new max_rank = get_maxrank(PlayerInfo[playerid][pMember]);
		if(PlayerInfo[playerid][pRank] >= max_rank) return 1;
	}
	return 0;
}
stock IsAWinter() // Зимние Системы ( Декабрь - Февраль)
{
	new year, month,day;
 	getdate(year, month, day);
  	if(month == 12 || month == 1 || month == 2) return 1;
	return 0;
}
stock IsACristmas() // Праздничные Системы (Декабрь - Январь)
{
	new year, month,day;
 	getdate(year, month, day);
  	if(month == 12 || month == 1) return 1;
	return 0;
}
stock IsANewYear() // Новогодние Системы (20 декабря - 20 января)
{
	new year, month,day;
 	getdate(year, month, day);
  	if(month == 12 && day >= 20 || month == 1 && day <= 20) return 1;
	return 0;
}

stock IsADecember() // Письма деду морозу только в декабре
{
	new year, month,day;
 	getdate(year, month, day);
  	if(month == 12) return 1;
	return 0;
}

stock IsAHalloween() // Систему хеллуина
{
	new year, month,day;
 	getdate(year, month, day);
  	if((month == 10 && day >= 25) || (month == 11 && day <= 10)) return 1;
	return 0;
}
stock IsAApril() // 1 Апреля
{
	new year, month,day;
 	getdate(year, month, day);
  	if(month == 4 && day == 1) return 1;
	return 0;
}
