stock PositionSwitchPages(playerid, switches)
{
	// Данные инвентаря
	new Float:sized_x, Float:sized_y;
	if(setting_pos_draw[playerid] == 7 || setting_size_draw[playerid] == 7) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][6], sized_y = PlayerInfo[playerid][pDrawSize_Y][6];

	new Float:otstyp_y = 4.0+sized_y/8;
	new Float:size_pick_menu_X = 33.0+sized_x/2, Float:size_pick_menu_Y = 33.0+sized_y/2;
	new Float:size_list_X = 12.0+sized_x/2, Float:size_list_Y = 15.0+sized_y/2;

	new Float:temp, Float:temp_y;
	PlayerTextDrawGetPos(playerid, PlaNestPick[4][playerid], temp, temp_y); // Y

	new Float:vrem_x, Float:vrem_y;
	if(switches == 2) // Количество страниц (кнопок)
	{
		PlayerTextDrawGetPos(playerid, PlaNestPick[5][playerid], vrem_x, vrem_y); // Получаем X второй колонны
		PlayerTextDrawSetPos(playerid, PlaNestTabs[0][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка первая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[0][playerid], size_list_X, size_list_Y);

		PlayerTextDrawGetPos(playerid, PlaNestPick[10][playerid], vrem_x, vrem_y); // Получаем X третьей колонны
		PlayerTextDrawSetPos(playerid, PlaNestTabs[1][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка вторая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[1][playerid], size_list_X, size_list_Y);
	}
	else if(switches == 3) // Количество страниц (кнопок)
	{
		PlayerTextDrawGetPos(playerid, PlaNestPick[0][playerid], vrem_x, vrem_y); // Получаем X первой колонны
		new Float:pos_switch_x1 = (vrem_x+size_pick_menu_X)-size_list_X/2;

		PlayerTextDrawGetPos(playerid, PlaNestPick[5][playerid], vrem_x, vrem_y); // Получаем X второй колонны
		new Float:pos_switch_x2 = (vrem_x+size_pick_menu_X)-size_list_X/2;

		PlayerTextDrawGetPos(playerid, PlaNestPick[10][playerid], vrem_x, vrem_y); // Получаем X третьей колонны
		new Float:pos_switch_x3 = (vrem_x+size_pick_menu_X)-size_list_X/2;

		PlayerTextDrawSetPos(playerid, PlaNestTabs[0][playerid], pos_switch_x1, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка первая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[0][playerid], size_list_X, size_list_Y);

		PlayerTextDrawSetPos(playerid, PlaNestTabs[1][playerid], pos_switch_x2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка вторая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[1][playerid], size_list_X, size_list_Y);

		PlayerTextDrawSetPos(playerid, PlaNestTabs[12][playerid], pos_switch_x3, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка третья Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[12][playerid], size_list_X, size_list_Y);
	}
	else if(switches == 4) // Количество страниц (кнопок)
	{
		PlayerTextDrawGetPos(playerid, PlaNestPick[0][playerid], vrem_x, vrem_y); // Получаем X первой колонны
		PlayerTextDrawSetPos(playerid, PlaNestTabs[0][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка первая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[0][playerid], size_list_X, size_list_Y);

		PlayerTextDrawGetPos(playerid, PlaNestPick[5][playerid], vrem_x, vrem_y); // Получаем X второй колонны
		PlayerTextDrawSetPos(playerid, PlaNestTabs[1][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка вторая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[1][playerid], size_list_X, size_list_Y);

		PlayerTextDrawGetPos(playerid, PlaNestPick[10][playerid], vrem_x, vrem_y); // Получаем X третьей колонны
		PlayerTextDrawSetPos(playerid, PlaNestTabs[12][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка третья Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[12][playerid], size_list_X, size_list_Y);

		PlayerTextDrawGetPos(playerid, PlaNestPick[15][playerid], vrem_x, vrem_y); // Получаем X четвёртой колонны
		PlayerTextDrawSetPos(playerid, PlaNestTabs[13][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, temp_y+size_pick_menu_Y+otstyp_y); // Кнопка четвертая Страница Инвентаря
		PlayerTextDrawTextSize(playerid, PlaNestTabs[13][playerid], size_list_X, size_list_Y);
	}
	return true;
}

stock PosInventDraw(playerid)
{
    new Float:positiond_x, Float:positiond_y, Float:sized_x, Float:sized_y;
    if(setting_pos_draw[playerid] == 7 || setting_size_draw[playerid] == 7) positiond_x = inventdraw_x+set_pos_x[playerid], positiond_y = inventdraw_y+set_pos_y[playerid];
    else positiond_x = inventdraw_x+PlayerInfo[playerid][pDrawPos_X][6], positiond_y = inventdraw_y+PlayerInfo[playerid][pDrawPos_Y][6];

    if(setting_pos_draw[playerid] == 7 || setting_size_draw[playerid] == 7) sized_x = set_size_x[playerid], sized_y = set_size_y[playerid];
    else sized_x = PlayerInfo[playerid][pDrawSize_X][6], sized_y = PlayerInfo[playerid][pDrawSize_Y][6];
    
    if(Device[playerid] == 1) positiond_x += DrawPosSmart_X[6], positiond_y += DrawPosSmart_Y[6], sized_y += DrawSizeSmart_Y[6];

	new Float:otstyp_x = 4.0+sized_x/8, Float:otstyp_y = 4.0+sized_y/8;
	new Float:vrem_x, Float:vrem_y, Float:vrem_x2, Float:vrem_y2;
	new Float:size_pick_menu_X = 33.0+sized_x/2, Float:size_pick_menu_Y = 33.0+sized_y/2;
	new Float:size_list_X = 12.0+sized_x/2, Float:size_list_Y = 15.0+sized_y/2;
	new Float:razdel_x = 8.0+sized_x/8;
	new Float:razm_left_x, Float:razm_left_y, Float:pos_pick2_x;

    // Аксессуары
 	PlayerTextDrawSetPos(playerid, PlaNestAkses[0][playerid], positiond_x, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestAkses[1][playerid], positiond_x, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestAkses[2][playerid], positiond_x, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestAkses[3][playerid], positiond_x, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestAkses[4][playerid], positiond_x, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawTextSize(playerid, PlaNestAkses[0][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaNestAkses[1][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaNestAkses[2][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaNestAkses[3][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaNestAkses[4][playerid], size_pick_menu_X, size_pick_menu_Y);
	
 	// Кнопка настройки Аксессуаров
	PlayerTextDrawSetPos(playerid, PlaInventDraw[11][playerid], positiond_x, positiond_y+4.0+size_pick_menu_Y*5);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[11][playerid], size_pick_menu_X, size_pick_menu_Y);

	// Одежда игрока (текущий скин)
	PlayerTextDrawSetPos(playerid, PlaNestOthe[0][playerid], positiond_x+size_pick_menu_X/2+razdel_x, positiond_y);
	PlayerTextDrawTextSize(playerid, PlaNestOthe[0][playerid], size_pick_menu_X*2-6.0, size_pick_menu_Y*2+1.0);

	// Оружие в руках
	new Float:size_gun_X = size_pick_menu_X/2-(1.0/2), Float:size_gun_Y = size_pick_menu_Y/2-(1.0/2);
	PlayerTextDrawGetPos(playerid, PlaNestAkses[1][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetPos(playerid, PlaNestOthe[0][playerid], vrem_x2, vrem_y2);
	PlayerTextDrawGetTextSize(playerid, PlaNestOthe[0][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestGun[0][playerid], vrem_x2-razdel_x+razm_left_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestGun[1][playerid], vrem_x2-razdel_x+razm_left_x+size_gun_X+1.0, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestGun[2][playerid], vrem_x2-razdel_x+razm_left_x+size_gun_X*2+2.0, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestGun[3][playerid], vrem_x2-razdel_x+razm_left_x, vrem_y+size_gun_Y+1.0);
	PlayerTextDrawSetPos(playerid, PlaNestGun[4][playerid], vrem_x2-razdel_x+razm_left_x+size_gun_X+1.0, vrem_y+size_gun_Y+1.0);
	PlayerTextDrawSetPos(playerid, PlaNestGun[5][playerid], vrem_x2-razdel_x+razm_left_x+size_gun_X*2+2.0, vrem_y+size_gun_Y+1.0);
	PlayerTextDrawTextSize(playerid, PlaNestGun[0][playerid], size_gun_X, size_gun_Y);
	PlayerTextDrawTextSize(playerid, PlaNestGun[1][playerid], size_gun_X, size_gun_Y);
	PlayerTextDrawTextSize(playerid, PlaNestGun[2][playerid], size_gun_X, size_gun_Y);
	PlayerTextDrawTextSize(playerid, PlaNestGun[3][playerid], size_gun_X, size_gun_Y);
	PlayerTextDrawTextSize(playerid, PlaNestGun[4][playerid], size_gun_X, size_gun_Y);
	PlayerTextDrawTextSize(playerid, PlaNestGun[5][playerid], size_gun_X, size_gun_Y);
	for(new p = 0; p < 6; p ++)
	{
        PlayerTextDrawGetPos(playerid, PlaNestGun[p][playerid], vrem_x, vrem_y);
        PlayerTextDrawSetPos(playerid, PlaNestGunNum[p][playerid], vrem_x+2.0, vrem_y+1.0);
        PlayerTextDrawLetterSize(playerid, PlaNestPickNum[p][playerid], 0.079333+sized_x*(0.079333/60), 0.538073+sized_y*(0.538073/60));
 	}

 	// Основной фон третьего раздела (персонаж)
	PlayerTextDrawSetPos(playerid, PlaInventDraw[6][playerid], positiond_x-otstyp_x, positiond_y-otstyp_y);
	PlayerTextDrawGetPos(playerid, PlaNestAkses[4][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetPos(playerid, PlaNestGun[5][playerid], vrem_x2, vrem_y2);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[6][playerid], (vrem_x2+size_gun_X+otstyp_x)-(positiond_x-otstyp_x), (vrem_y+size_pick_menu_Y+otstyp_y)-(positiond_y-otstyp_y));

	// Иконки
	PlayerTextDrawGetPos(playerid, PlaInventDraw[6][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[6][playerid], razm_left_x, razm_left_y);
	new Float:two_razdel_X = vrem_x+razm_left_x+razdel_x+otstyp_x;
	PlayerTextDrawSetPos(playerid, PlaNestPick[0][playerid], two_razdel_X, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[1][playerid], two_razdel_X, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[2][playerid], two_razdel_X, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[3][playerid], two_razdel_X, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[4][playerid], two_razdel_X, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawSetPos(playerid, PlaNestPick[5][playerid], two_razdel_X+1.0+size_pick_menu_X, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[6][playerid], two_razdel_X+1.0+size_pick_menu_X, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[7][playerid], two_razdel_X+1.0+size_pick_menu_X, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[8][playerid], two_razdel_X+1.0+size_pick_menu_X, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[9][playerid], two_razdel_X+1.0+size_pick_menu_X, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawSetPos(playerid, PlaNestPick[10][playerid], two_razdel_X+2.0+size_pick_menu_X*2, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[11][playerid], two_razdel_X+2.0+size_pick_menu_X*2, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[12][playerid], two_razdel_X+2.0+size_pick_menu_X*2, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[13][playerid], two_razdel_X+2.0+size_pick_menu_X*2, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[14][playerid], two_razdel_X+2.0+size_pick_menu_X*2, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawSetPos(playerid, PlaNestPick[15][playerid], two_razdel_X+3.0+size_pick_menu_X*3, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[16][playerid], two_razdel_X+3.0+size_pick_menu_X*3, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[17][playerid], two_razdel_X+3.0+size_pick_menu_X*3, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[18][playerid], two_razdel_X+3.0+size_pick_menu_X*3, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[19][playerid], two_razdel_X+3.0+size_pick_menu_X*3, positiond_y+4.0+size_pick_menu_Y*4);
	
	for(new p = 0; p < 40; p ++) PlayerTextDrawTextSize(playerid, PlaNestPick[p][playerid], size_pick_menu_X, size_pick_menu_Y);
	
	// Переключатели страниц Инвентаря
	PositionSwitchPages(playerid, 2);
	
	// Кнопки управления на первой странице
	PlayerTextDrawGetPos(playerid, PlaNestPick[4][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[1][playerid], two_razdel_X, vrem_y+size_pick_menu_Y+size_list_Y+otstyp_y*2);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[2][playerid], two_razdel_X+1.0+size_pick_menu_X, vrem_y+size_pick_menu_Y+size_list_Y+otstyp_y*2);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[3][playerid], two_razdel_X+2.0+size_pick_menu_X*2, vrem_y+size_pick_menu_Y+size_list_Y+otstyp_y*2);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[4][playerid], two_razdel_X+3.0+size_pick_menu_X*3, vrem_y+size_pick_menu_Y+size_list_Y+otstyp_y*2);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[1][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[2][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[3][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[4][playerid], size_pick_menu_X, size_pick_menu_Y);

	// Основной фон первого раздела
	PlayerTextDrawSetPos(playerid, PlaInventDraw[0][playerid], two_razdel_X-otstyp_x, positiond_y-otstyp_y);
	PlayerTextDrawGetPos(playerid, PlaInventDraw[1][playerid], vrem_x, vrem_y);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[0][playerid], (two_razdel_X+3.0+size_pick_menu_X*3+size_pick_menu_X+otstyp_x)-(two_razdel_X-otstyp_x), (vrem_y+size_pick_menu_Y+otstyp_y)-(positiond_y-otstyp_y));

	// Иконки 2
	PlayerTextDrawGetPos(playerid, PlaInventDraw[0][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[0][playerid], razm_left_x, razm_left_y);
	pos_pick2_x = vrem_x+razm_left_x+razdel_x+otstyp_x;
	PlayerTextDrawSetPos(playerid, PlaNestPick[20][playerid], pos_pick2_x, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[21][playerid], pos_pick2_x, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[22][playerid], pos_pick2_x, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[23][playerid], pos_pick2_x, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[24][playerid], pos_pick2_x, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawSetPos(playerid, PlaNestPick[25][playerid], pos_pick2_x+1.0+size_pick_menu_X, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[26][playerid], pos_pick2_x+1.0+size_pick_menu_X, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[27][playerid], pos_pick2_x+1.0+size_pick_menu_X, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[28][playerid], pos_pick2_x+1.0+size_pick_menu_X, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[29][playerid], pos_pick2_x+1.0+size_pick_menu_X, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawSetPos(playerid, PlaNestPick[30][playerid], pos_pick2_x+2.0+size_pick_menu_X*2, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[31][playerid], pos_pick2_x+2.0+size_pick_menu_X*2, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[32][playerid], pos_pick2_x+2.0+size_pick_menu_X*2, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[33][playerid], pos_pick2_x+2.0+size_pick_menu_X*2, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[34][playerid], pos_pick2_x+2.0+size_pick_menu_X*2, positiond_y+4.0+size_pick_menu_Y*4);
	PlayerTextDrawSetPos(playerid, PlaNestPick[35][playerid], pos_pick2_x+3.0+size_pick_menu_X*3, positiond_y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[36][playerid], pos_pick2_x+3.0+size_pick_menu_X*3, positiond_y+1.0+size_pick_menu_Y);
	PlayerTextDrawSetPos(playerid, PlaNestPick[37][playerid], pos_pick2_x+3.0+size_pick_menu_X*3, positiond_y+2.0+size_pick_menu_Y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPick[38][playerid], pos_pick2_x+3.0+size_pick_menu_X*3, positiond_y+3.0+size_pick_menu_Y*3);
	PlayerTextDrawSetPos(playerid, PlaNestPick[39][playerid], pos_pick2_x+3.0+size_pick_menu_X*3, positiond_y+4.0+size_pick_menu_Y*4);
	
	// Переключатели страниц Инвентаря Второй Раздел
	PlayerTextDrawGetPos(playerid, PlaNestPick[24][playerid], vrem_x, vrem_y); // X, Y
	PlayerTextDrawSetPos(playerid, PlaNestTabs[8][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, vrem_y+size_pick_menu_Y+otstyp_y); // Кнопка первая Страница Дом
	PlayerTextDrawTextSize(playerid, PlaNestTabs[8][playerid], size_list_X, size_list_Y);
	PlayerTextDrawGetPos(playerid, PlaNestPick[29][playerid], vrem_x, vrem_y); // X, Y
	PlayerTextDrawSetPos(playerid, PlaNestTabs[9][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, vrem_y+size_pick_menu_Y+otstyp_y); // Кнопка вторая Страница Дом
	PlayerTextDrawTextSize(playerid, PlaNestTabs[9][playerid], size_list_X, size_list_Y);
	PlayerTextDrawGetPos(playerid, PlaNestPick[34][playerid], vrem_x, vrem_y); // X, Y
	PlayerTextDrawSetPos(playerid, PlaNestTabs[10][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, vrem_y+size_pick_menu_Y+otstyp_y); // Кнопка третья Страница Дом
	PlayerTextDrawTextSize(playerid, PlaNestTabs[10][playerid], size_list_X, size_list_Y);
	PlayerTextDrawGetPos(playerid, PlaNestPick[39][playerid], vrem_x, vrem_y); // X, Y
	PlayerTextDrawSetPos(playerid, PlaNestTabs[11][playerid], (vrem_x+size_pick_menu_X/2)-size_list_X/2, vrem_y+size_pick_menu_Y+otstyp_y); // Кнопка четвертая Страница Дом
	PlayerTextDrawTextSize(playerid, PlaNestTabs[11][playerid], size_list_X, size_list_Y);

	// Кнопки Вкладок второй Раздел
	new Float:size_tabs_X = ((pos_pick2_x+3.0+size_pick_menu_X*4)-pos_pick2_x-otstyp_x*2)/3, Float:size_tabs_Y = 20.0+sized_y/2;
	PlayerTextDrawSetPos(playerid, PlaNestTabs[2][playerid], pos_pick2_x, positiond_y-size_tabs_Y-otstyp_y); // Кнопка Вкладка 1
	PlayerTextDrawTextSize(playerid, PlaNestTabs[2][playerid], size_tabs_X, size_tabs_Y);
	PlayerTextDrawGetPos(playerid, PlaNestTabs[2][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestTabs[3][playerid], vrem_x+size_tabs_X+otstyp_x, positiond_y-size_tabs_Y-otstyp_y); // Кнопка Вкладка 2
	PlayerTextDrawTextSize(playerid, PlaNestTabs[3][playerid], size_tabs_X, size_tabs_Y);
	PlayerTextDrawGetPos(playerid, PlaNestTabs[3][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestTabs[4][playerid], vrem_x+size_tabs_X+otstyp_x, positiond_y-size_tabs_Y-otstyp_y); // Кнопка Вкладка 3
	PlayerTextDrawTextSize(playerid, PlaNestTabs[4][playerid], size_tabs_X, size_tabs_Y);

	// Кнопка вкладок раздел рюкзак
	PlayerTextDrawSetPos(playerid, PlaInventDraw[13][playerid], two_razdel_X, positiond_y-size_tabs_Y-otstyp_y); // Кнопка Инвентарь
	PlayerTextDrawTextSize(playerid, PlaInventDraw[13][playerid], size_tabs_X, size_tabs_Y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[15][playerid], two_razdel_X + otstyp_x + size_tabs_X, positiond_y-size_tabs_Y-otstyp_y); // Кнопка Рюкзак
	PlayerTextDrawTextSize(playerid, PlaInventDraw[15][playerid], size_tabs_X, size_tabs_Y);

	// Фон кнопок рюкзака в верхней вкладке
	PlayerTextDrawSetPos(playerid, PlaInventDraw[12][playerid], two_razdel_X-otstyp_x, positiond_y-size_tabs_Y-otstyp_y-otstyp_y);
	PlayerTextDrawTextSize(playerid, PlaInventDraw[12][playerid], otstyp_x*3 + size_tabs_X*2, size_tabs_Y+otstyp_y);
	
	// Надписи Вкладок второй Раздел
	PlayerTextDrawGetPos(playerid, PlaNestTabs[2][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaNestTabs[2][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestTabs[5][playerid], vrem_x+razm_left_x/2, vrem_y+razm_left_y/3.4);
	PlayerTextDrawLetterSize(playerid, PlaNestTabs[5][playerid], 0.184551+sized_x*(0.184551/40), 0.755332+sized_y*(0.755332/40));
	PlayerTextDrawGetPos(playerid, PlaNestTabs[3][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaNestTabs[3][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestTabs[6][playerid], vrem_x+razm_left_x/2, vrem_y+razm_left_y/3.4);
	PlayerTextDrawLetterSize(playerid, PlaNestTabs[6][playerid], 0.184551+sized_x*(0.184551/40), 0.755332+sized_y*(0.755332/40));
	PlayerTextDrawGetPos(playerid, PlaNestTabs[4][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaNestTabs[4][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestTabs[7][playerid], vrem_x+razm_left_x/2, vrem_y+razm_left_y/3.4);
	PlayerTextDrawLetterSize(playerid, PlaNestTabs[7][playerid], 0.184551+sized_x*(0.184551/40), 0.755332+sized_y*(0.755332/40));

	// Надпись вкладок раздел рюкзак
	PlayerTextDrawGetPos(playerid, PlaInventDraw[13][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[13][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[14][playerid], vrem_x+razm_left_x/2, vrem_y+razm_left_y/3.4);
	PlayerTextDrawLetterSize(playerid, PlaInventDraw[14][playerid], 0.184551+sized_x*(0.184551/40), 0.755332+sized_y*(0.755332/40));
	PlayerTextDrawGetPos(playerid, PlaInventDraw[15][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[15][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[16][playerid], vrem_x+razm_left_x/2, vrem_y+razm_left_y/3.4);
	PlayerTextDrawLetterSize(playerid, PlaInventDraw[16][playerid], 0.184551+sized_x*(0.184551/40), 0.755332+sized_y*(0.755332/40));

 	// Кнопки управления на второй странице и ценник
	PlayerTextDrawGetPos(playerid, PlaNestPick[24][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestAct[0][playerid], vrem_x, vrem_y+size_pick_menu_Y+size_list_Y+otstyp_y*2);
	PlayerTextDrawSetPos(playerid, PlaNestPrice[playerid], vrem_x, vrem_y+size_pick_menu_Y+otstyp_y*2);
	PlayerTextDrawLetterSize(playerid, PlaNestPrice[playerid], 0.230668+sized_x*(0.230668/40), 0.941999+sized_y*(0.941999/40));
	PlayerTextDrawTextSize(playerid, PlaNestPrice[playerid], vrem_x+40.0+sized_x/2, 8.866666+sized_y/8);
	PlayerTextDrawGetPos(playerid, PlaNestPick[29][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestAct[1][playerid], vrem_x, vrem_y+size_pick_menu_Y+size_list_Y+otstyp_y*2);
	PlayerTextDrawTextSize(playerid, PlaNestAct[0][playerid], size_pick_menu_X, size_pick_menu_Y);
	PlayerTextDrawTextSize(playerid, PlaNestAct[1][playerid], size_pick_menu_X, size_pick_menu_Y);

	// Основной фон второго раздела
	PlayerTextDrawSetPos(playerid, PlaInventDraw[5][playerid], pos_pick2_x-otstyp_x, positiond_y-size_tabs_Y-otstyp_y*2);
	PlayerTextDrawGetPos(playerid, PlaNestAct[0][playerid], vrem_x, vrem_y);
 	PlayerTextDrawTextSize(playerid, PlaInventDraw[5][playerid], (pos_pick2_x+3.0+size_pick_menu_X*3+size_pick_menu_X+otstyp_x)-(pos_pick2_x-otstyp_x), (vrem_y+size_pick_menu_Y+otstyp_y)-(positiond_y-size_tabs_Y-otstyp_y*2));
	
/*
new Float:pos_vklad_x, Float:pos_vklad_y;
	new Float:size_vklad_x, Float:size_vklad_y;
	PlayerTextDrawGetPos(playerid, PlaInventDraw[5][playerid], pos_vklad_x, pos_vklad_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[5][playerid], size_vklad_x, size_vklad_y);

	new Float:sized_y = PlayerInfo[playerid][pDrawSize_Y][6];
	new Float:otstyp_y = 4.0+sized_y/8;

	if(type == 0) // Все вкладки закрыты
	{
		new Float:temp_size_x, Float:temp_size_y;
		PlayerTextDrawGetTextSize(playerid, PlaNestTabs[2][playerid], temp_size_x, temp_size_y);
		PlayerTextDrawTextSize(playerid, PlaInventDraw[5][playerid], size_vklad_x, temp_size_y + otstyp_y*2);
	}
	else if(type == 2 || type == 9) // Дом, Бизнес
	{
		if(stat == 0) // Без нижней кнопки
		{
			new Float:temp_pos_x, Float:temp_pos_y;
			PlayerTextDrawGetPos(playerid, PlaInventDraw[4][playerid], temp_pos_x, temp_pos_y);
			PlayerTextDrawTextSize(playerid, PlaInventDraw[5][playerid], size_vklad_x, temp_pos_y-pos_vklad_y);
		}
		else
		{
			new Float:temp_pos_x, Float:temp_pos_y;
			new Float:temp_size_x, Float:temp_size_y;
			PlayerTextDrawGetPos(playerid, PlaInventDraw[4][playerid], temp_pos_x, temp_pos_y);
			PlayerTextDrawGetTextSize(playerid, PlaInventDraw[4][playerid], temp_size_x, temp_size_y);

			PlayerTextDrawTextSize(playerid, PlaInventDraw[5][playerid], size_vklad_x, temp_pos_y-pos_vklad_y + temp_size_y + otstyp_y);
		}
	}
	*/


	// Цифры на всех ячейках
	for(new p = 0; p < 40; p ++)
	{
        PlayerTextDrawGetPos(playerid, PlaNestPick[p][playerid], vrem_x, vrem_y);
        PlayerTextDrawSetPos(playerid, PlaNestPickNum[p][playerid], vrem_x+2.0, vrem_y+1.0);
        PlayerTextDrawLetterSize(playerid, PlaNestPickNum[p][playerid], 0.121666+sized_x*(0.121666/20), 0.608296+sized_y*(0.608296/20));
 	}
 	
 	// Иконка выбранного предмета
 	PlayerTextDrawGetPos(playerid, PlaNestGun[0][playerid], vrem_x, vrem_y);
 	PlayerTextDrawGetTextSize(playerid, PlaNestGun[0][playerid], razm_left_x, razm_left_y);
 	PlayerTextDrawSetPos(playerid, PlaNestOthe[2][playerid], vrem_x+razm_left_x/2, positiond_y+1.0);
 	PlayerTextDrawTextSize(playerid, PlaNestOthe[2][playerid], size_pick_menu_X, size_pick_menu_Y);
 	PlayerTextDrawGetPos(playerid, PlaNestOthe[2][playerid], vrem_x, vrem_y);
 	PlayerTextDrawSetPos(playerid, PlaNestOthe[1][playerid], vrem_x+size_pick_menu_X/2, positiond_y-1.0);
 	PlayerTextDrawLetterSize(playerid, PlaNestOthe[1][playerid], 0.136666+sized_x*(0.136666/40), 0.637630+sized_y*(0.637630/40));
 	
 	// Шкалы потребностей фон
 	PlayerTextDrawGetPos(playerid, PlaNestGun[5][playerid], vrem_x, vrem_y);
 	PlayerTextDrawGetPos(playerid, PlaNestAkses[4][playerid], vrem_x2, vrem_y2);
	new Float:pos_potreb_X = positiond_x+size_pick_menu_X+otstyp_x, Float:pos_potreb_Y = vrem_y+size_gun_Y+otstyp_y; // Начало расположения потребностей
	new Float:size_potreb_X = (vrem_x+size_gun_X)-pos_potreb_X, Float:size_potreb_Y = (vrem_y2+size_pick_menu_Y)-pos_potreb_Y-otstyp_y*3; // Размер окна с потребностями
	new Float:pick_potreb_X = size_potreb_X, Float:pick_potreb_Y = size_potreb_Y/4;
	PlayerTextDrawSetPos(playerid, PlaInventDraw[7][playerid], pos_potreb_X, pos_potreb_Y); // фон потребности 1
	PlayerTextDrawTextSize(playerid, PlaInventDraw[7][playerid], pick_potreb_X, pick_potreb_Y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[8][playerid], pos_potreb_X, pos_potreb_Y+pick_potreb_Y+otstyp_y); // фон потребности 2
	PlayerTextDrawTextSize(playerid, PlaInventDraw[8][playerid], pick_potreb_X, pick_potreb_Y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[9][playerid], pos_potreb_X, pos_potreb_Y+pick_potreb_Y*2+otstyp_y*2); // фон потребности 3
	PlayerTextDrawTextSize(playerid, PlaInventDraw[9][playerid], pick_potreb_X, pick_potreb_Y);
	PlayerTextDrawSetPos(playerid, PlaInventDraw[10][playerid], pos_potreb_X, pos_potreb_Y+pick_potreb_Y*3+otstyp_y*3); // фон потребности 4
	PlayerTextDrawTextSize(playerid, PlaInventDraw[10][playerid], pick_potreb_X, pick_potreb_Y);
	
	// Шкалы потребностей
	PlayerTextDrawGetPos(playerid, PlaInventDraw[7][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[0][playerid], vrem_x+1.0, vrem_y+1.0);
	PlayerTextDrawTextSize(playerid, PlaNestNeeds[0][playerid], pick_potreb_X-2.0, pick_potreb_Y-2.0);
	PlayerTextDrawGetPos(playerid, PlaInventDraw[8][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[1][playerid], vrem_x+1.0, vrem_y+1.0);
	PlayerTextDrawTextSize(playerid, PlaNestNeeds[1][playerid], pick_potreb_X-2.0, pick_potreb_Y-2.0);
	PlayerTextDrawGetPos(playerid, PlaInventDraw[9][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[2][playerid], vrem_x+1.0, vrem_y+1.0);
	PlayerTextDrawTextSize(playerid, PlaNestNeeds[2][playerid], pick_potreb_X-2.0, pick_potreb_Y-2.0);
    PlayerTextDrawGetPos(playerid, PlaInventDraw[10][playerid], vrem_x, vrem_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[3][playerid], vrem_x+1.0, vrem_y+1.0);
	PlayerTextDrawTextSize(playerid, PlaNestNeeds[3][playerid], pick_potreb_X-2.0, pick_potreb_Y-2.0);
	
	// Текст Потребностей
	PlayerTextDrawGetPos(playerid, PlaInventDraw[7][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[7][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[4][playerid], vrem_x+4.0, vrem_y+razm_left_y/3.0); // Сытость
	PlayerTextDrawLetterSize(playerid, PlaNestNeeds[4][playerid], 0.127333+sized_x*(0.127333/60), 0.708148+sized_y*(0.708148/60));
	PlayerTextDrawGetPos(playerid, PlaInventDraw[8][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[8][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[5][playerid], vrem_x+4.0, vrem_y+razm_left_y/3.0); // Бодрость
	PlayerTextDrawLetterSize(playerid, PlaNestNeeds[5][playerid], 0.127333+sized_x*(0.127333/60), 0.708148+sized_y*(0.708148/60));
	PlayerTextDrawGetPos(playerid, PlaInventDraw[9][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[9][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[6][playerid], vrem_x+4.0, vrem_y+razm_left_y/3.0); // Нужда
	PlayerTextDrawLetterSize(playerid, PlaNestNeeds[6][playerid], 0.127333+sized_x*(0.127333/60), 0.708148+sized_y*(0.708148/60));
	PlayerTextDrawGetPos(playerid, PlaInventDraw[10][playerid], vrem_x, vrem_y);
	PlayerTextDrawGetTextSize(playerid, PlaInventDraw[10][playerid], razm_left_x, razm_left_y);
	PlayerTextDrawSetPos(playerid, PlaNestNeeds[7][playerid], vrem_x+4.0, vrem_y+razm_left_y/3.0); // Гигиена
	PlayerTextDrawLetterSize(playerid, PlaNestNeeds[7][playerid], 0.127333+sized_x*(0.127333/60), 0.708148+sized_y*(0.708148/60));
	return 1;
}
stock reset_pick_othe(playerid)
{
    PlayerTextDrawHide(playerid, PlaNestOthe[1][playerid]);
    PlayerTextDrawColour(playerid, PlaNestOthe[2][playerid], 100); // -1
    PlayerTextDrawSetPreviewModel(playerid, PlaNestOthe[2][playerid], 1956);
	PlayerTextDrawSetPreviewRot(playerid, PlaNestOthe[2][playerid], -10.000000, 0.000000, 0.000000, 1.000000);
	PlayerTextDrawSetSelectable(playerid, PlaNestOthe[2][playerid], false); // true
	return 1;
}
