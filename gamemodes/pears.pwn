			        format(stro,sizeof(stro),"{0088ff}Как заработать?"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n\n{cccccc}- Выберите пункт <<Начать Работу>> в этом меню"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Отправляйтесь на улицу и возьмите Bus (Автобус) с парковки"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Следуйте по маршруту до возвращения в автобусное депо"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Только по окончанию маршрута вы сможете забрать зарплату"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n\n{FF6347}Внимание!"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Соблюдайте правила дорожного движения"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{cccccc}- Уважайте пассажиров и всегда останавливайтесь по их просьбе"), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n\n{ff9000}Прежде всего, вы взаимодействуете с новичками на сервере."), strcat(sctringo,stro);
			        format(stro,sizeof(stro),"\n{ff9000}Будьте вежливы и не обижайте игроков ;)"), strcat(sctringo,stro);
			        ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Автобусное Депо",sctringo,"Ок","");
			        return 1;
				}
