CMD:pdd(playerid)
{
	new rulesdialog[3500];
	format(rulesdialog,sizeof(rulesdialog), "%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s",//26
	PddMSG[0],PddMSG[1],PddMSG[2],PddMSG[3],PddMSG[4],PddMSG[5],PddMSG[6],PddMSG[7],PddMSG[8],PddMSG[9],PddMSG[10],PddMSG[11],PddMSG[12],PddMSG[13],PddMSG[14],PddMSG[15],PddMSG[16],PddMSG[17],PddMSG[18],PddMSG[19],PddMSG[20],PddMSG[21],PddMSG[22],PddMSG[23],PddMSG[24],PddMSG[25]);
	ShowDialog(playerid, 90, DIALOG_STYLE_MSGBOX,"{ff9000}Правила Дорожного Движения", rulesdialog, "OK", "");
	PlayerPlaySound(playerid,40405,0,0,0);
	return 1;
}
CMD:fotik(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2.0, 957.5170,1474.1949,1029.3568) && GetPlayerVirtualWorld(playerid) == WORLD_CNN_1LVL && GetPlayerInterior(playerid) == INT_CNN_1LVL)
	{
		if(PlayerInfo[playerid][pMember] != 9 && PlayerInfo[playerid][pLeader] != 9) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не репортёр");
		if(GetPVarInt(playerid,"Fotik") == 0)
		{
			Protect_GiveWeapons(playerid, 43, 100, 0, 0);
			SendClientMessage(playerid, COLOR_GRAD1, "{0088ff}[CNN] {ffffff}Вам выдали ваш фотоаппарат");
			SetPVarInt(playerid, "Fotik",1);
		}
		else
		{
		    if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже брал свой фотоаппарат");
		    else SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я уже брала свой фотоаппарат");
			return 1;
		}
	}
	return 1;
}
CMD:dellave(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 20) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу использовать эту команду");
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Удалить бабки со счётов организации [ /dellave ID Фракции ]");
	if(params[0] > 22 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 22");
	new string[144];
  	format(string, sizeof(string), " [ ADM ]: %s удалил деньги со счёта %s",PlayerInfo[playerid][pName],frakName[params[0]]);
   	ABroadCast(COLOR_ADM,string,1);
	bigint_set(OrganInfo[params[0]][glave], 0);
   	OrganInfo[params[0]][gUpdate] = 1;
	AdminLog("dellave", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", params[0], "Очистил Счёт");
	OrgLog(params[0], "dellave", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], 0, "", "", 0, "Очистил Счёт");
	return 1;
}
CMD:bump(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] == 0 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Воткнуть игрока [ /bump ID ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
	if(IsARealNPC(params[0])) return ErrorMessage(playerid, "{FF6347}Это NPC");
	if(PlayerInfo[params[0]][pSoska] >= PlayerInfo[playerid][pSoska] && params[0] != playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу пнуть своего уровня или старше");
	new Float:sl[3],string[144];
	GetPlayerPos(params[0], sl[0], sl[1], sl[2]);
	PPSetPlayerPos(params[0], sl[0], sl[1], sl[2]-3);
	PlayerPlaySound(params[0], 4602, 0,0,0);
	if(playerid == params[0]) return 1;
	format(string, sizeof(string), " [ ADM ]: %s воткнул %s",PlayerInfo[playerid][pName] ,PlayerInfo[params[0]][pName]);
	ABroadCast(COLOR_ADM,string,1);
	format(string, sizeof(string), "{0088ff}[ Pears ]: {ffcc66}Вас сдвинул администратор %s",PlayerInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_GREY, string);
	return 1;
}
