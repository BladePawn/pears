			if(!strlen(inputtext)) return 1;
			new input;
			if(!sscanf(inputtext, "i", input))
			{
				if(IsPlayerInRangeOfPoint(playerid,50.0,1377.0898,1582.1823,10.8416) && GetPlayerInterior(playerid) == INT_CASINO_ROOM && GetPlayerVirtualWorld(playerid) >= 1 && GetPlayerVirtualWorld(playerid) <= 10
				|| GetPlayerVirtualWorld(playerid) == 2001 && GetPlayerInterior(playerid) == INT_CASINO_HOL // Казино интерьер
				|| GetPlayerVirtualWorld(playerid) == WORLD_PRISON_CELLS && GetPlayerInterior(playerid) == INT_PRISON_CELLS // Тюрьма интерьер
				|| GetPlayerVirtualWorld(playerid) == WORLD_PRISON_LAUNDY && GetPlayerInterior(playerid) == INT_PRISON_LAUNDY // Тюрьма прачечная
				|| GetPlayerVirtualWorld(playerid) == WORLD_PRISON_KITCHEN && GetPlayerInterior(playerid) == INT_PRISON_KITCHEN // Тюрьма кухня
				|| GetPlayerVirtualWorld(playerid) == WORLD_PRISON_WORKING && GetPlayerInterior(playerid) == INT_PRISON_WORKING // Тюрьма рабочая зона prison working
				)
				{
				    if(input < 1 || input > 10000000) return ErrorMessage(playerid, "{FF6347}Сумма не меньше 1$ и не больше 10.000.000$");
				}
				else
				{
				    if(input < 1 || input > 100000) return ErrorMessage(playerid, "{FF6347}Сумма не меньше 1$ и не больше 100.000$ \n{cccccc}Для игр на большие суммы необходимо находиться в казино или тюрьме");
				}
