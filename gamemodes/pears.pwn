	mysql_tquery(pearsq, "SELECT `radars`.*, `pp_igroki`.`Name` FROM `radars` LEFT JOIN `pp_igroki` ON `pp_igroki`.`user_id` = `radars`.`owner`", "LoadRadars", ""); // Загружаем радары
	mysql_tquery(pearsq, "SELECT * FROM `obstacles`", "Obstacle_Load", ""); // Загружаем тренировочные маршруты
