			|| DomInfo[108][dFam] == PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1) MoveDynamicObject(Vorota[124], 2539.81, 682.713745, 10.880325, 1.5), MoveDynamicObject(Vorota[125], 2523.53, 682.713745, 10.880325, 1.5), PlayerPlaySound(playerid, 1133,0,0,0), Statvorota[vorot] = 10;
		}
		else if(vorot >= 123 && vorot <= 128 && PlayerInfo[playerid][pMember] == 18 || zachistka == 1 && IsAGunSkladDepart(PlayerInfo[playerid][pMember])) // Arabian Mafia
		{
			new bool:yesOpen;
			if(vorot == 123) MoveDynamicObject(Vorota[126], 2085.240234, 1859.903198, 6.559640, 1.4), yesOpen = true;
			else if(vorot == 124) MoveDynamicObject(Vorota[127], 2103.041015, 1976.898437, 6.559615, 1.4), yesOpen = true; // gates right
			else if(vorot == 125) MoveDynamicObject(Vorota[128], 1969.260131, 1758.479003, 8.993866, 1.4), yesOpen = true; // gates_0 (left0)
			else if(vorot == 126) MoveDynamicObject(Vorota[129], 1872.112548, 1802.880004, 9.003872, 1.4), yesOpen = true; // gates1 (left1)
			else if(vorot == 127) MoveDynamicObject(Vorota[130], 1854.262084, 1929.217529, 3.854865, 1.4), yesOpen = true; // gates2 (back)
			else if(vorot == 128) MoveDynamicObject(Vorota[131], 1916.868774, 1963.806396, 3.864866, 1.4), yesOpen = true; // gates3 (right)

			if(yesOpen) PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0), Statvorota[vorot] = 10;
		}

		// Hospital LS
		else if(vorot >= 140 && vorot <= 141 
			&& (PlayerInfo[playerid][pMember] == 4 || PlayerInfo[playerid][pMember] == 7 || PlayerInfo[playerid][pMember] == 2))
		{
			new bool:yesOpen;
			if(vorot == 140) MoveDynamicObject(Vorota[132], 1135.413208, -1368.061645, 14.441574, 1.4), yesOpen = true; // gates 0
			else if(vorot == 141) MoveDynamicObject(Vorota[133], 1153.705322, -1291.904907, 14.266564, 1.4), yesOpen = true; // gates 1
			if(yesOpen) PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0), Statvorota[vorot] = 10;
		}

		// Дом 142
		else if(vorot >= 142 && vorot <= 143 
			&& (PlayerInfo[playerid][pDom] == 142 || PlayerInfo[playerid][pHouserent] == 142 || PlayerInfo[playerid][pMember] == 7
			|| DomInfo[142][dFam] == PlayerInfo[playerid][pFamily] && PlayerInfo[playerid][pFamily] >= 1))
		{
			new bool:yesOpen;
			if(vorot == 142) MoveDynamicObject(Vorota[134], 1245.655761, -767.476013, 89.466781, 1.4), yesOpen = true; // gates 0
			else if(vorot == 143) MoveDynamicObject(Vorota[135], 1371.819946, -856.181884, 39.776779, 1.4), yesOpen = true; // gates 1
			if(yesOpen) PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0), Statvorota[vorot] = 10;
		}

		// NGSA Полигон
		else if (vorot == 144 && fraction(playerid) == 3) {
			MoveDynamicObject(Vorota[136], 1073.038330, 1359.445434, 12.410749 - 5.4, 1.55);
			MoveDynamicObject(Vorota[137], 1065.041381, 1361.856079, 9.629673 - 0.4, 1.2);
			MoveDynamicObject(Vorota[138], 1069.823120, 1361.856079, 9.629673 - 0.4, 1.2);
			PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0), Statvorota[vorot] = 10;
		}

		// Mafia Port LS
		else if (vorot == 145 && IsMafiaMember(playerid)) {
			MoveDynamicObject(Vorota[139], 2420.523925, -2564.403076, 10.608008 - 5.0, 1.4);
			Statvorota[vorot] = 10;
		}

		// LSPD Шлагбаум
		else if (vorot == 147)
		{
			if(PlayerInfo[playerid][pLeader] == 1 || PlayerInfo[playerid][pMember] == 1 || IsPlayerNPC(playerid) || GetPVarInt(playerid,"endorse") == 1) {
				Statvorota[vorot] = 5;
				MoveDynamicObject(Vorota[141], 1594.749389, -1620.136230 - 0.05, 13.152793, 0.05, 0.0, 0.0, 90.0);
				PlayerPlaySound(playerid,6400,0,0,0);
			}
		}
	}
	return 1;
}

CMD:plworld(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить виртуальный мир [ /plworld ID Номер ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
 	new string[144];
	format(string, sizeof(string), "* Вы установили %s Виртуальный Мир %d",PlayerInfo[params[0]][pName],params[1]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "* Админ %s установил вам Виртуальный Мир %d",PlayerInfo[playerid][pName],params[1]);
	if(params[0] != playerid) SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
	S_SetPlayerVirtualWorld(params[0], params[1], GetPlayerInterior(params[0]));
 	return 1;
}
CMD:plint(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] <= 1 && PlayerInfo[playerid][pMedia] != 3) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не могу выполнить это действие");
    if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Установить интерьер [ /plint ID Int ]");
	if(!IsOnline(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Его вообще нет..");
 	new string[144];
	format(string, sizeof(string), "* Вы установили %s интерьер %d",PlayerInfo[params[0]][pName],params[1]);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "* Админ %s установил вам Интерьер %d",PlayerInfo[playerid][pName],params[1]);
	if(params[0] != playerid) SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
	PPSetPlayerInterior(params[0], params[1]);
 	return 1;
}
CMD:voenhelp(playerid)
{
	new str[200],sctring[1200];
	format(str,sizeof(str),"{ff9000} Как получить Военный Билет?");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}1. Не находиться в розыске {0088ff}[ Y >> Меню >> Статистика ]");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}2. Не находиться в Чёрном Списке NGSA");
	strcat(sctring,str);
	format(str,sizeof(str),"\n\n\n{ffffff}Если все пункты учтены, отправляйтесь в Военкомат {ff9000}[ Y >> GPS >> Прочее >> Военкомат ]");
	strcat(sctring,str);
	format(str,sizeof(str),"\n{cccccc}Вам необходимо пройти службу в Армии San Andreas для получения военного билета");
	strcat(sctring,str);
	ShowDialog(playerid,1742,DIALOG_STYLE_MSGBOX,"{ff9000}Информация о Военном Билете",sctring,"Oк","");
   	return 1;
}
CMD:paygold(playerid, const params[])
{
	if(PlayerInfo[playerid][pSoska] < 9 && PlayerInfo[playerid][pMedia] < 3 && PlayerInfo[playerid][pDjpears] < 5) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Кхм.. я не могу это сделать");
    if(CnnVed[playerid] >= 11) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я смотрю CNN Channel");
    if(MPGO[playerid] != 0) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я на мероприятии");
	new tmp[24], money, giveplayerid, string[144];
    if(sscanf(params, "s[24]i", tmp, money)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Передать золото [ /paygold ID Количество ]");
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && PlayerInfo[playerid][pSoska] == 0) return SendClientMessage(playerid, COLOR_GREY,"[ Мысли ]: Я нахожусь в слежке");
    if(money < 1 || money > 1000) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Не меньше 1 и не больше 1000 грамм золота");
    if(PlayerInfo[playerid][pDonateMoney] < money) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: У меня нет такого количества золота");
    giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
        if(giveplayerid == playerid) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу передать золото себе");
	    format(string, sizeof(string), "   Вы передали %s(%d), {00BC12}%d грамм золота.", PlayerInfo[giveplayerid][pName],giveplayerid, money);
		SendClientMessage(playerid, COLOR_GRAD1, string);
	    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
		format(string, sizeof(string), "   Вы получили %d грамм золота от %s(%d).", money, PlayerInfo[playerid][pName], playerid);
		SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		PlayerPlaySound(giveplayerid, 1052, 0.0, 0.0, 0.0);
		PlayerInfo[playerid][pDonateMoney] -= money;
		PlayerInfo[giveplayerid][pDonateMoney] += money;
		if(PlayerInfo[giveplayerid][pAchieve][26] == 0 && PlayerInfo[giveplayerid][pDonateMoney] >= 10000) AchievePlayer(giveplayerid, 26, 1);
		mysql_save(playerid, 4);
		mysql_save(giveplayerid, 4);

		DonateLog("paygold", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], -money, "Передал");
		DonateLog("givegold", PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], money, "Получил");
		AdminLog("paygold", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], money, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT * FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "Call_Offline", "dssdd", playerid, tmp, tmp,16,money);
	}
	return 1;
}
function call_relpcapt(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[144];
		format(string, sizeof(string), "   У %s сброшена статистика каптов за текущую войну", str_name), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s[%d] сбросил статистику каптов %s за текущую войну", PlayerInfo[playerid][pName],playerid,str_name);
		ABroadCast(COLOR_ADM,string,2);
		new datadid;
		cache_get_value_name_int(0, "user_id", datadid);

		new string_mysql[100 + 40 * MAX_GANG_CAPT_STATA];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki` SET `MyWar`='0',");
		new part[40];
		for(new idx = 0; idx < MAX_GANG_CAPT_STATA; idx++)
		{
			format(part, sizeof(part), "`GangCapt%d`='0'%s", idx, (idx < MAX_GANG_CAPT_STATA - 1) ? "," : "");
			strcat(string_mysql, part);
		}
		format(part, sizeof(part), " WHERE `user_id`='%d'", datadid);
		strcat(string_mysql, part);
		query_empty(pearsq, string_mysql);

		IsATopName(str_name);
		AdminLog("relpcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:relpcapt(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    new tmp[24], giveplayerid, string[144];
	if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сбросить статистику каптов игрока за текущую войну [ /relpcapt ID ]");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
		format(string, sizeof(string), "   У %s[%d] сброшена статистика каптов за текущую войну", PlayerInfo[giveplayerid][pName],giveplayerid), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), "   %s[%d] сбросил мою статистику каптов за текущую войну",PlayerInfo[playerid][pName], playerid), SendClientMessage(giveplayerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s[%d] сбросил статистику каптов %s[%d] за текущую войну", PlayerInfo[playerid][pName],playerid,PlayerInfo[giveplayerid][pName],giveplayerid);
		ABroadCast(COLOR_ADM,string,2);
		PlayerInfo[giveplayerid][pMyWar] = 0;
		for(new gp = 0; gp < MAX_GANG_CAPT_STATA; gp++) PlayerInfo[giveplayerid][pGangCapt][gp] = 0;
		SavePlayerCapt(giveplayerid);
		IsATopName(PlayerInfo[giveplayerid][pName]);
		AdminLog("relpcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], PlayerInfo[giveplayerid][pID], PlayerInfo[giveplayerid][pName], PlayerInfo[giveplayerid][pPlaIP], 0, "");
	}
	else
	{
		if(!CheckRP_Nickname(tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Игрок offline, попробую использовать его никнейм. Пример: Lol_Lolkin");
  		mysql_format(pearsq, string,sizeof(string),"SELECT user_id FROM `pp_igroki` WHERE `Name` = '%e'", tmp);
  		mysql_tquery(pearsq, string, "call_relpcapt", "ds", playerid, tmp);
	}
	return 1;
}
function call_relpallcapt(playerid, const str_name[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new string[144];
		format(string, sizeof(string), "   У %s сброшена статистика каптов за всё время", str_name), SendClientMessage(playerid, COLOR_GRAD1, string);
		format(string, sizeof(string), " [ ADM ]: %s[%d] сбросил статистику каптов %s за всё время", PlayerInfo[playerid][pName],playerid,str_name);
		ABroadCast(COLOR_ADM,string,2);
		new datadid;
		cache_get_value_name_int(0, "user_id", datadid);

		new string_mysql[100 + 40 * 2 * MAX_GANG_CAPT_STATA];
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_igroki` SET `MyWar`='0',");
		new part[40];
		for(new idx = 0; idx < MAX_GANG_CAPT_STATA; idx++)
		{
			format(part, sizeof(part), "`GangCapt%d`='0',", idx);
			strcat(string_mysql, part);

			format(part, sizeof(part), "`GangAll%d`='0'%s", idx, (idx < MAX_GANG_CAPT_STATA - 1) ? "," : "");
			strcat(string_mysql, part);
		}
		format(part, sizeof(part), " WHERE `user_id`='%d'", datadid);
		strcat(string_mysql, part);
		query_empty(pearsq, string_mysql);

		IsATopName(str_name);
		AdminLog("relpallcapt", PlayerInfo[playerid][pID], PlayerInfo[playerid][pName], PlayerInfo[playerid][pPlaIP], datadid, str_name, "", 0, "");
	}
	else ErrorMessage(playerid, "{FF6347}Аккаунт не найден");
	return 1;
}
CMD:relpallcapt(playerid, const params[])
{
	if(!admin_right(PlayerInfo[playerid][pSoska], ADM_SPHERE_LEADER)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Я не могу это сделать");
    new tmp[24], giveplayerid, string[144];
	if(sscanf(params, "s[24]", tmp)) return SendClientMessage(playerid, COLOR_GREY, "[ Мысли ]: Сбросить статистику каптов игрока за всё время [ /relpallcapt ID ]");
	giveplayerid = ReturnUser(tmp, 1);
    if(IsOnline(giveplayerid))
    {
