public LoadBankCom()
{
	new time = GetTickCount();
	new rows;
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
    	cache_get_value_name_float(f, "put", comput[f]);
    	cache_get_value_name_float(f, "take", comtake[f]);
	}
	printf("[MODE]: Комиссия в Банке [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}

public LoadBusStation()
{
	new time = GetTickCount();
	new rows;
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
    	cache_get_value_name_int(f, "idbusstation", BusStationInfo[f][idbusstation]);
    	cache_get_value_name_int(f, "bsActive", BusStationInfo[f][bsActive]);
		cache_get_value_name(f, "bsName", BusStationInfo[f][bsName],34);
		cache_get_value_name_float(f, "bsCordX", BusStationInfo[f][bsCordX]);
		cache_get_value_name_float(f, "bsCordY", BusStationInfo[f][bsCordY]);
		cache_get_value_name_float(f, "bsCordZ", BusStationInfo[f][bsCordZ]);
		cache_get_value_name_float(f, "bsCordRX", BusStationInfo[f][bsCordRX]);
		cache_get_value_name_float(f, "bsCordRY", BusStationInfo[f][bsCordRY]);
		cache_get_value_name_float(f, "bsCordRZ", BusStationInfo[f][bsCordRZ]);
		cache_get_value_name_int(f, "bsVlad", BusStationInfo[f][bsVlad]);
		cache_get_value_name(f, "bsPlayerName", BusStationInfo[f][bsPlayerName],24);
		cache_get_value_name_int(f, "bsUnix", BusStationInfo[f][bsUnix]);
		//cache_get_value_name_int(f, "bsCity", BusStationInfo[f][bsCity]);
		if(BusStationInfo[f][bsActive] > 0) 
		{
			busstationcreate(f);
		}
	}
	bsrows = rows;
	printf("[MODE]: Автобусные остановки [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
public LoadIkea()
{
	new time = GetTickCount();
	new rows, world, idx, Float:obj_pos[6];
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
	    cache_get_value_name_int(f, "newid", IkeaInfo[idx][iID]);
	    cache_get_value_name_int(f, "Model", IkeaInfo[idx][iModel]);
	    cache_get_value_name_int(f, "Price", IkeaInfo[idx][iPrice]);
	    cache_get_value_name(f, "Name", IkeaInfo[idx][iName], 24);
	    cache_get_value_name_int(f, "Pavilion", IkeaInfo[idx][iPavilion]);
	    cache_get_value_name_int(f, "Quantextures", IkeaInfo[idx][iQuantextures]);
	    cache_get_value_name_int(f, "Sale", IkeaInfo[idx][iSale]);
	    cache_get_value_name_float(f, "X", obj_pos[0]);
	    cache_get_value_name_float(f, "Y", obj_pos[1]);
	    cache_get_value_name_float(f, "Z", obj_pos[2]);
	    cache_get_value_name_float(f, "RX", obj_pos[3]);
	    cache_get_value_name_float(f, "RY", obj_pos[4]);
	    cache_get_value_name_float(f, "RZ", obj_pos[5]);
	    cache_get_value_name_float(f, "BuyX", IkeaInfo[idx][iBuyX]);
	    cache_get_value_name_float(f, "BuyY", IkeaInfo[idx][iBuyY]);
	    cache_get_value_name_float(f, "BuyZ", IkeaInfo[idx][iBuyZ]);
		cache_get_value_name_int(f, "iStreetObject", IkeaInfo[idx][iStreetObject]);

	    if(IkeaInfo[idx][iModel] > 0)
	    {
		    if(IkeaInfo[idx][iPavilion] == 0) world = 194;
		    else if(IkeaInfo[idx][iPavilion] == 1) world = 193;
		    else if(IkeaInfo[idx][iPavilion] == 2) world = 192;
			IkeaInfo[idx][iObject] = CreateDynamicObject(IkeaInfo[idx][iModel], obj_pos[0], obj_pos[1], obj_pos[2], obj_pos[3], obj_pos[4], obj_pos[5], world, world, -1, 300.00, 300.00);
			IkeaLabel[idx] = CreateDynamic3DTextLabel(" ",-1,IkeaInfo[idx][iBuyX], IkeaInfo[idx][iBuyY], IkeaInfo[idx][iBuyZ],1.5,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,world,world);
			IkeaInfo[idx][iLabelstat] = 1;
			UpdateLabelIkea(idx);
		}
		idx ++;
	}
	printf("[MODE]: IKEA [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
stock UpdateLabelIkea(idx)
{
	new string[164];
	if(IkeaInfo[idx][iSale] == 0) format(string,sizeof(string),"{FF6347}%s {cccccc}[ID: %d | Model: %d]\n\n{FF6347}Не продаётся\n{cccccc}[ ALT ]", IkeaInfo[idx][iName], idx, IkeaInfo[idx][iModel]);
	else 
	{
		if(IkeaInfo[idx][iStreetObject] == 0) format(string,sizeof(string),"{ff9000}%s {cccccc}[ID: %d | Model: %d]\nУстановка на улице: {666666}Недоступна\n\n{cccccc}Стоимость: {99ff66}%d$ [%s]\n{cccccc}[ ALT ]", IkeaInfo[idx][iName], idx, IkeaInfo[idx][iModel], IkeaInfo[idx][iPrice], get_k(IkeaInfo[idx][iPrice]));
		else format(string,sizeof(string),"{ff9000}%s {cccccc}[ID: %d | Model: %d]\nУстановка на улице: {99ff66}Доступна\n\n{cccccc}Стоимость: {99ff66}%d$ [%s]\n{cccccc}[ ALT ]", IkeaInfo[idx][iName], idx, IkeaInfo[idx][iModel], IkeaInfo[idx][iPrice], get_k(IkeaInfo[idx][iPrice]));
	}
	UpdateDynamic3DTextLabelText(IkeaLabel[idx],0xA9C4E4FF,string);
	return 1;
}
stock UpdateIkeaObject(idx)
{
	new f_str[100];
	mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_ikea` WHERE `newid` = '%d'", idx);
	mysql_tquery(pearsq, f_str, "Call_UpdateIkeaObject", "d", idx);
	return 1;
}
forward Call_UpdateIkeaObject(idx);
public Call_UpdateIkeaObject(idx)
{
    new rows;
	cache_get_row_count(rows);
	new Float:pos[3], Float:rot[3];
	GetDynamicObjectPos(IkeaInfo[idx][iObject], pos[0], pos[1], pos[2]);
	GetDynamicObjectRot(IkeaInfo[idx][iObject], rot[0], rot[1], rot[2]);

	new string_mysql[600];
	if(!rows)
	{
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `pp_ikea` SET `newid` = '%d',`Model` = '%d',`Name` = '%e',`Pavilion` = '%d',`Quantextures` = '%d',`X` = '%f',`Y` = '%f',`Z` = '%f',\
		`RX` = '%f',`RY` = '%f',`RZ` = '%f',`BuyX` = '%f',`BuyY` = '%f',`BuyZ` = '%f',`iStreetObject` = '%d'",
	 	idx, IkeaInfo[idx][iModel], IkeaInfo[idx][iName], IkeaInfo[idx][iPavilion], IkeaInfo[idx][iQuantextures], pos[0], pos[1], pos[2], rot[0], rot[1],
	 	rot[2], IkeaInfo[idx][iBuyX], IkeaInfo[idx][iBuyY], IkeaInfo[idx][iBuyZ], IkeaInfo[idx][iStreetObject]);
	 	query_empty(pearsq, string_mysql);
	}
	else
	{
	    mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_ikea` SET `Model` = '%d',`Price` = '%d',`Name` = '%e',`Pavilion` = '%d',`Quantextures` = '%d',`Sale` = '%d',\
		`X` = '%f',`Y` = '%f',`Z` = '%f',`RX` = '%f',`RY` = '%f',`RZ` = '%f',`BuyX` = '%f',`BuyY` = '%f',`BuyZ` = '%f',`iStreetObject` = '%d' WHERE `newid` = '%d'",
	 	IkeaInfo[idx][iModel], IkeaInfo[idx][iPrice], IkeaInfo[idx][iName], IkeaInfo[idx][iPavilion], IkeaInfo[idx][iQuantextures], IkeaInfo[idx][iSale],
 		pos[0], pos[1], pos[2], rot[0], rot[1], rot[2], IkeaInfo[idx][iBuyX], IkeaInfo[idx][iBuyY], IkeaInfo[idx][iBuyZ], IkeaInfo[idx][iStreetObject], idx);
	 	query_empty(pearsq, string_mysql);
	}
	return 1;
}
public LoadFrame()
{
	new time = GetTickCount();
	new rows, idx;
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
	    cache_get_value_name_int(f, "newid", FrameInfo[idx][frID]);
	    cache_get_value_name_int(f, "Model", FrameInfo[idx][frModel]);
	    cache_get_value_name_int(f, "Type", FrameInfo[idx][frType]);
	    cache_get_value_name_int(f, "Price", FrameInfo[idx][frPrice]);
	    cache_get_value_name_int(f, "Class", FrameInfo[idx][frClass]);
	    cache_get_value_name(f, "Name", FrameInfo[idx][frName], 34);
	    cache_get_value_name_int(f, "Quantextures", FrameInfo[idx][frQuantextures]);
	    cache_get_value_name_int(f, "Sale", FrameInfo[idx][frSale]);
	    cache_get_value_name_float(f, "X", FrameInfo[idx][frX]);
	    cache_get_value_name_float(f, "Y", FrameInfo[idx][frY]);
	    cache_get_value_name_float(f, "Z", FrameInfo[idx][frZ]);
	    cache_get_value_name_float(f, "RX", FrameInfo[idx][frRX]);
	    cache_get_value_name_float(f, "RY", FrameInfo[idx][frRY]);
	    cache_get_value_name_float(f, "RZ", FrameInfo[idx][frRZ]);

		// Фиксим говно координаты по Z (инты с нижними частями и с басиком были слишком низко, эта шляпа перезаписывает координаты)
		new Float:pos[3], Float:rot[3];
		GetCoordFrame(FrameInfo[idx][frModel], pos[0], pos[1], pos[2], rot[0], rot[1], rot[2]);
		if(FrameInfo[idx][frZ] != pos[2]) FrameInfo[idx][frZ] = pos[2];

		idx ++;
		frame_quan ++;
	}
	printf("[MODE]: Frame [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
stock UpdateFrameObject(idx)
{
	new f_str[100];
	mysql_format(pearsq, f_str, sizeof(f_str), "SELECT * FROM `pp_frame` WHERE `newid` = '%d'", idx);
	mysql_tquery(pearsq, f_str, "Call_UpdateFrameObject", "d", idx);
	return 1;
}
forward Call_UpdateFrameObject(idx);
public Call_UpdateFrameObject(idx)
{
    new rows;
	cache_get_row_count(rows);

	new string_mysql[600];
	if(!rows)
	{
		mysql_format(pearsq, string_mysql, sizeof(string_mysql), "INSERT INTO `pp_frame` SET `newid` = '%d',`Model` = '%d',`Type` = '%d',`Price` = '%d',`Class` = '%d',`Name` = '%e',`Quantextures` = '%d',`Sale` = '%d'\
		,`X` = '%f',`Y` = '%f',`Z` = '%f',`RX` = '%f',`RY` = '%f',`RZ` = '%f'",
	 	idx, FrameInfo[idx][frModel], FrameInfo[idx][frType], FrameInfo[idx][frPrice], FrameInfo[idx][frClass], FrameInfo[idx][frName], FrameInfo[idx][frQuantextures], FrameInfo[idx][frSale],
	 	FrameInfo[idx][frX], FrameInfo[idx][frY], FrameInfo[idx][frZ], FrameInfo[idx][frRX], FrameInfo[idx][frRY], FrameInfo[idx][frRZ]);
	 	query_empty(pearsq, string_mysql);
	}
	else
	{
	    mysql_format(pearsq, string_mysql, sizeof(string_mysql), "UPDATE `pp_frame` SET `Model` = '%d',`Type` = '%d',`Price` = '%d',`Class` = '%d',`Name` = '%e',`Quantextures` = '%d',`Sale` = '%d'\
		,`X` = '%f',`Y` = '%f',`Z` = '%f',`RX` = '%f',`RY` = '%f',`RZ` = '%f' WHERE `newid` = '%d'",
	 	FrameInfo[idx][frModel], FrameInfo[idx][frType], FrameInfo[idx][frPrice], FrameInfo[idx][frClass], FrameInfo[idx][frName], FrameInfo[idx][frQuantextures], FrameInfo[idx][frSale],
	 	FrameInfo[idx][frX], FrameInfo[idx][frY], FrameInfo[idx][frZ], FrameInfo[idx][frRX], FrameInfo[idx][frRY], FrameInfo[idx][frRZ], idx);
	 	query_empty(pearsq, string_mysql);
	}
	return 1;
}
public LoadBizz()
{
	CreateFillLabel();
	new time = GetTickCount();
	new rows, idx, string[34];
	cache_get_row_count(rows);
	for(new f; f<rows; ++f)
	{
	    cache_get_value_name_int(f, "newid", idx);
	    cache_get_value_name(f, "Vlad", BizzInfo[idx][bVlad], 24);
	    cache_get_value_name_int(f, "Level", BizzInfo[idx][bLevel]);
	    cache_get_value_name_int(f, "Sost", BizzInfo[idx][bSost]);
	    cache_get_value_name_int(f, "Data", BizzInfo[idx][bData]);
		cache_get_value_name_int(f, "bCost", BizzInfo[idx][bCost]);
		cache_get_value_name_int(f, "bGold", BizzInfo[idx][bGold]);
	    cache_get_value_name_int(f, "Freeze", BizzInfo[idx][bFreeze]);
	    cache_get_value_name_int(f, "Arest", BizzInfo[idx][bArest]);
	    cache_get_value_name_int(f, "PriceProd", BizzInfo[idx][bMafia]);
	    cache_get_value_name_int(f, "Bablo", BizzInfo[idx][bBablo]);
	    cache_get_value_name_int(f, "Schet", BizzInfo[idx][bSchet]);
	    cache_get_value_name_int(f, "Fam", BizzInfo[idx][bFam]);
	    cache_get_value_name_int(f, "Sell", BizzInfo[idx][bSell]);
	    cache_get_value_name_int(f, "Pastime", BizzInfo[idx][bPastime]);
	    cache_get_value_name_int(f, "Mafunix", BizzInfo[idx][bMafunix]);

		for(new i; i < MAX_BIZ_ACCESS; ++ i)
		{
			format(string,sizeof(string),"acc%d", i), cache_get_value_name_int(f, string, BizzInfo[idx][bAcc][i]);
			format(string,sizeof(string),"accrank%d", i), cache_get_value_name_int(f, string, BizzInfo[idx][bAccRank][i]);
		}
		for(new i; i < MAX_BIZ_SETTING; ++ i)
		{
			format(string,sizeof(string),"setting%d", i), cache_get_value_name_int(f, string, BizzInfo[idx][bSetting][i]);
		}

		cache_get_value_name_int(f, "Intorval", BizzInfo[idx][bInterval]);
		
		// Загружаем содержимое товаров бизнеса
		OnLoadBizzProduct(idx, f);
		
		cache_get_value_name_float(f, "bcX", BizzInfo[idx][bX]);
		cache_get_value_name_float(f, "bcY", BizzInfo[idx][bY]);
		cache_get_value_name_float(f, "bcZ", BizzInfo[idx][bZ]);
		cache_get_value_name_int(f, "Lab", BizzInfo[idx][bLab]);
		cache_get_value_name_int(f, "Descrip", BizzInfo[idx][bDescrip]);
    	cache_get_value_name(f, "Name", BizzInfo[idx][bName], 34);
    	cache_get_value_name_int(f, "Taxes", BizzInfo[idx][bTaxes]);
    	cache_get_value_name_int(f, "Warn", BizzInfo[idx][bWarn]);
    	cache_get_value_name_int(f, "Lien", BizzInfo[idx][bLien]);
    	cache_get_value_name_int(f, "ArTime", BizzInfo[idx][bArTime]);
    	cache_get_value_name(f, "ArReason", BizzInfo[idx][bArReason], 64);
    	cache_get_value_name_int(f, "Stat", BizzInfo[idx][bStat]);
    	cache_get_value_name(f, "StatReason", BizzInfo[idx][bStatReason], 64);
    	cache_get_value_name_int(f, "Taxday", BizzInfo[idx][bTaxday]);
    	cache_get_value_name_int(f, "Deposit", BizzInfo[idx][bDeposit]);

		for(new i = 0; i < 10; i++)
    	{
    	    format(string,sizeof(string),"parthner%d", i), cache_get_value_name_int(f, string, BizzInfo[idx][bFamilyPartner][i]);
    	}

		// Загружаем заказы товаров
		OnLoadBizzOrder(idx, f);

    	cache_get_value_name_int(f, "Income", BizzInfo[idx][bIncome]);
    	cache_get_value_name_int(f, "Hiscome0", BizzInfo[idx][bHiscome][0]);
    	cache_get_value_name_int(f, "Hiscome1", BizzInfo[idx][bHiscome][1]);
    	cache_get_value_name_int(f, "Hiscome2", BizzInfo[idx][bHiscome][2]);
    	cache_get_value_name_int(f, "Hiscome3", BizzInfo[idx][bHiscome][3]);
    	cache_get_value_name_int(f, "Hiscome4", BizzInfo[idx][bHiscome][4]);
    	cache_get_value_name_int(f, "Hiscome5", BizzInfo[idx][bHiscome][5]);
    	cache_get_value_name_int(f, "Hiscome6", BizzInfo[idx][bHiscome][6]);
    	cache_get_value_name_int(f, "Hiscome7", BizzInfo[idx][bHiscome][7]);
    	cache_get_value_name_int(f, "Hiscome8", BizzInfo[idx][bHiscome][8]);
    	cache_get_value_name_int(f, "Hiscome9", BizzInfo[idx][bHiscome][9]);
    	cache_get_value_name_int(f, "Hiscome10", BizzInfo[idx][bHiscome][10]);
    	cache_get_value_name_int(f, "Hiscome11", BizzInfo[idx][bHiscome][11]);
    	cache_get_value_name_int(f, "Hiscome12", BizzInfo[idx][bHiscome][12]);
    	cache_get_value_name_int(f, "Hiscome13", BizzInfo[idx][bHiscome][13]);
    	cache_get_value_name_int(f, "Hiscome14", BizzInfo[idx][bHiscome][14]);
    	cache_get_value_name_int(f, "Hiscome15", BizzInfo[idx][bHiscome][15]);
    	cache_get_value_name_int(f, "Hiscome16", BizzInfo[idx][bHiscome][16]);
    	cache_get_value_name_int(f, "Hiscome17", BizzInfo[idx][bHiscome][17]);
    	cache_get_value_name_int(f, "Hiscome18", BizzInfo[idx][bHiscome][18]);
    	cache_get_value_name_int(f, "Hiscome19", BizzInfo[idx][bHiscome][19]);
    	cache_get_value_name_int(f, "Hiscome20", BizzInfo[idx][bHiscome][20]);
    	cache_get_value_name_int(f, "Hiscome21", BizzInfo[idx][bHiscome][21]);
    	cache_get_value_name_int(f, "Hiscome22", BizzInfo[idx][bHiscome][22]);
    	cache_get_value_name_int(f, "Hiscome23", BizzInfo[idx][bHiscome][23]);
    	cache_get_value_name_int(f, "Hiscome24", BizzInfo[idx][bHiscome][24]);
    	cache_get_value_name_int(f, "Hiscome25", BizzInfo[idx][bHiscome][25]);
    	cache_get_value_name_int(f, "Hiscome26", BizzInfo[idx][bHiscome][26]);
    	cache_get_value_name_int(f, "Hiscome27", BizzInfo[idx][bHiscome][27]);
    	cache_get_value_name_int(f, "Hiscome28", BizzInfo[idx][bHiscome][28]);
    	cache_get_value_name_int(f, "Hiscome29", BizzInfo[idx][bHiscome][29]);
    	cache_get_value_name_float(f, "obX0", BizzInfo[idx][bBizOX][0]);
    	cache_get_value_name_float(f, "obY0", BizzInfo[idx][bBizOY][0]);
    	cache_get_value_name_float(f, "obZ0", BizzInfo[idx][bBizOZ][0]);
    	cache_get_value_name_float(f, "obRX0", BizzInfo[idx][bBizORX][0]);
    	cache_get_value_name_float(f, "obRY0", BizzInfo[idx][bBizORY][0]);
    	cache_get_value_name_float(f, "obRZ0", BizzInfo[idx][bBizORZ][0]);
    	cache_get_value_name_float(f, "obX1", BizzInfo[idx][bBizOX][1]);
    	cache_get_value_name_float(f, "obY1", BizzInfo[idx][bBizOY][1]);
    	cache_get_value_name_float(f, "obZ1", BizzInfo[idx][bBizOZ][1]);
    	cache_get_value_name_float(f, "obRX1", BizzInfo[idx][bBizORX][1]);
    	cache_get_value_name_float(f, "obRY1", BizzInfo[idx][bBizORY][1]);
    	cache_get_value_name_float(f, "obRZ1", BizzInfo[idx][bBizORZ][1]);
    	cache_get_value_name_float(f, "EnterX", BizzInfo[idx][bEnterX]);
    	cache_get_value_name_float(f, "EnterY", BizzInfo[idx][bEnterY]);
    	cache_get_value_name_float(f, "EnterZ", BizzInfo[idx][bEnterZ]);
    	cache_get_value_name_float(f, "EnterA", BizzInfo[idx][bEnterA]);
    	cache_get_value_name_float(f, "InteriorX", BizzInfo[idx][bInteriorX]);
    	cache_get_value_name_float(f, "InteriorY", BizzInfo[idx][bInteriorY]);
    	cache_get_value_name_float(f, "InteriorZ", BizzInfo[idx][bInteriorZ]);
    	cache_get_value_name_float(f, "InteriorA", BizzInfo[idx][bInteriorA]);
    	cache_get_value_name_int(f, "Inter", BizzInfo[idx][bInterior]);
		cache_get_value_name_float(f, "BizBarX", BizzInfo[idx][bBarX]);
    	cache_get_value_name_float(f, "BizBarY", BizzInfo[idx][bBarY]);
    	cache_get_value_name_float(f, "BizBarZ", BizzInfo[idx][bBarZ]);
    	cache_get_value_name_int(f, "BizBar", BizzInfo[idx][bBar]);
		cache_get_value_name_int(f, "bCity", BizzInfo[idx][bCity]);
		cache_get_value_name_int(f, "bMafiaSchet", BizzInfo[idx][bMafiaSchet]);
		cache_get_value_name_int(f, "bZZ", BizzInfo[idx][bZZ]);
		cache_get_value_name_float(f, "BizShluhaX", BizzInfo[idx][bShluhaCord][0]);
    	cache_get_value_name_float(f, "BizShluhaY", BizzInfo[idx][bShluhaCord][1]);
    	cache_get_value_name_float(f, "BizShluhaZ", BizzInfo[idx][bShluhaCord][2]);
		cache_get_value_name_float(f, "BizShluhaA", BizzInfo[idx][bShluhaCord][3]);
    	cache_get_value_name_int(f, "BizShluha", BizzInfo[idx][bShluha]);
    	
		if(LIMITED_LOADING_SERVER == 0)
		{
			// Загружаем инвентарь бизнеса
			OnLoadBizzInvent(idx, f);
		}
		cache_get_value_name_int(f, "DeliveryPay", BizzInfo[idx][bDeliveryPay]);
		cache_get_value_name_int(f, "OrderStatus", BizzInfo[idx][bOrderStatus]);
		cache_get_value_name_int(f, "bAtmCollector", BizzInfo[idx][bAtmCollector]);
		cache_get_value_name_int(f, "bElectroPayForConnect", BizzInfo[idx][bElectroPayForConnect]);
		cache_get_value_name_int(f, "bElectroPayForRepair", BizzInfo[idx][bElectroPayForRepair]);
		cache_get_value_name_int(f, "bChipsFee", BizzInfo[idx][bChipsFee]);
		cache_get_value_name_int(f, "bInteriorPack", BizzInfo[idx][bInteriorPack]);

		BizzInfo[idx][bChipsFee] = clamp(BizzInfo[idx][bChipsFee], MIN_CHIPSFEE, MAX_CHIPSFEE);
		if(BizzInfo[idx][bElectroPayForConnect] <= 0) BizzInfo[idx][bElectroPayForConnect] = MIN_PAY_ELECTRICIAN;
		if(BizzInfo[idx][bElectroPayForRepair] <= 0) BizzInfo[idx][bElectroPayForRepair] = MIN_PAY_ELECTRICIAN;
		if(BizzInfo[idx][bAtmCollector] <= 0) BizzInfo[idx][bAtmCollector] = MAX_ATM_MONEY;

		// Сбрасываем статус заказа доставки, если не была добавлена оплата дальнобойщику
		if(BizzInfo[idx][bDeliveryPay] <= 0) BizzInfo[idx][bOrderStatus] = 0;

    	if(BizzInfo[idx][bInteriorX] == 0.0 && BizzInfo[idx][bInteriorY] == 0.0 && BizzInfo[idx][bInteriorZ] == 0.0) // Устанавливаем всем бизнесам дефолт позицию
    	{
    	    BizzInfo[idx][bInteriorX] = 1387.4436, BizzInfo[idx][bInteriorY] = -16.2143, BizzInfo[idx][bInteriorZ] = 1000.8868, BizzInfo[idx][bInteriorA] = 359.7609, BizzInfo[idx][bInterior] = 90;
    	}
    	
		if(idx < 118 || idx > 122) // Рестораны игнорим
		{
			if(BizzInfo[idx][bBizOX][0] != 0)
			{
				BizzInfo[idx][bBizOStat][0] = 1;
				BizzInfo[idx][bBizObject][0] = CreateDynamicObject(1537, BizzInfo[idx][bBizOX][0], BizzInfo[idx][bBizOY][0], BizzInfo[idx][bBizOZ][0], BizzInfo[idx][bBizORX][0], BizzInfo[idx][bBizORY][0], BizzInfo[idx][bBizORZ][0], 0, 0, -1, 300.00, 300.00);
				if(idx >= 13 && idx <= 26) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 2212, "burger_tray", "bkidside", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 14479, "skuzzy_motelmain", "mp_CJ_Laminate1", 0x00000000);
				else if(idx >= 27 && idx <= 41) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 18048, "gen_mun_xtars2", "star_spang", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 3884, "samsite_sfxrf", "sam_camo-navy", 0x00000000);
				else if(idx >= 93 && idx <= 102) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 6871, "vegascourtbld", "marbletilewal1_256", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 1376, "cranes_dyn2_cj", "ws_oldpaintedblue", 0x00000000);
				else if(idx >= 103 && idx <= 117) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 2212, "burger_tray", "fries_cb", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 2212, "burger_tray", "btdeck256", 0x00000000);
				else if(idx >= 118 && idx <= 122) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 14623, "mafcasmain", "marble_wall2", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 14801, "lee_bdupsmain", "Bdup_KitchFloor", 0x00000000);
				else if(idx >= 123 && idx <= 132) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 14593, "papaerchaseoffice", "glassPartition", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 3440, "airportpillar", "metalic_64", 0x00000000);
				else if(idx >= 133 && idx <= 142) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 1, 3440, "airportpillar", "metalic_64", 0x00000000), SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][0], 2, 6064, "law_beach1", "musk1", 0x00000000);
				BizPickup2[idx] = CreateDynamicPickup(19132, 1, BizzInfo[idx][bEnterX],BizzInfo[idx][bEnterY],BizzInfo[idx][bEnterZ], 0, 0);
				Streamer_SetIntData(STREAMER_TYPE_PICKUP, BizPickup2[idx], STREAMER_BIZ_ENTER, idx);
			}
			if(BizzInfo[idx][bBizOX][1] != 0)
			{
				BizzInfo[idx][bBizOStat][1] = 1;
				BizzInfo[idx][bBizObject][1] = CreateDynamicObject(18244, BizzInfo[idx][bBizOX][1], BizzInfo[idx][bBizOY][1], BizzInfo[idx][bBizOZ][1], BizzInfo[idx][bBizORX][1], BizzInfo[idx][bBizORY][1], BizzInfo[idx][bBizORZ][1], 0, 0, -1, 300.00, 300.00);
				if(idx >= 13 && idx <= 26) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 14668, "711c", "CJ_7_11_win", 0x00000000);
				else if(idx >= 27 && idx <= 41) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 4552, "ammu_lan2", "sunsetammu2", 0x00000000);
				else if(idx >= 93 && idx <= 102) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 6988, "vgnfremnt1", "casinolights6lit3_256", 0x00000000);
				else if(idx >= 103 && idx <= 117) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 10310, "boigas_sfe", "burgershotmenu256", 0x00000000);
				else if(idx >= 118 && idx <= 122) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 15040, "cuntcuts", "GB_pendantlmp01", 0x00000000);
				else if(idx >= 123 && idx <= 132) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 14593, "papaerchaseoffice", "glassPartition", 0x00000000);
				else if(idx >= 133 && idx <= 142) SetDynamicObjectMaterial(BizzInfo[idx][bBizObject][1], 0, 4552, "ammu_lan2", "sunsetammu1", 0x00000000);
			}

			if(BizzInfo[idx][bLab] == 1) UpdateBizLabel(idx, 0);
		}
		
		// Подсчитываем количество заказов и сбрасываем статус доставки
		if(BizzInfo[idx][bOrderStatus] == 1) Orders ++, BizzInfo[idx][bOrders] ++;
		BizzInfo[idx][bDeliveryOrder] = -1;
		if(BizzInfo[idx][bZZ] == 1) CreateGreenZoneBiz(idx);
		if(idx >= 1 && idx <= 12) UpdateFillLabel(idx);
		if(idx >= 13 && idx <= 26) CreateSupermarketLabel_S(idx);

		if(BizzInfo[idx][bBar] != 0) CreateBarLabel(idx);
		if(BizzInfo[idx][bShluha] != 0) CreateShluha(idx);

		BizMapIcon(idx);
		// Сбрасываем настройки, если они пустые
		if(BizzInfo[idx][bSetting][1] == 0) bizsbrosprava(idx);
	}
	printf("[MODE]: Бизнесы [%d Quan][%d ms]",rows,GetTickCount() - time);
	return 1;
}
stock CreateBarLabel(idx)
{
	if(idx >= 93 && idx <= 102)
	{
		BizzInfo[idx][bBar] = 1;
		BizBar[idx] = CreateDynamicPickup(19823, 1, BizzInfo[idx][bBarX],BizzInfo[idx][bBarY],BizzInfo[idx][bBarZ]-0.7, 3000+idx, BizzInfo[idx][bInterior]);
		BizBarLabel[idx] = CreateDynamic3DTextLabel("{ff9000}Бар {cccccc}[ ALT ]",-1,BizzInfo[idx][bBarX],BizzInfo[idx][bBarY],BizzInfo[idx][bBarZ]-0.5,3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,3000+idx, BizzInfo[idx][bInterior]); 
	} 
	else if (idx >= 103 && idx <= 122)
	{
		BizzInfo[idx][bBar] = 1;
		BizBar[idx] = CreateDynamicPickup(2768, 1, BizzInfo[idx][bBarX],BizzInfo[idx][bBarY],BizzInfo[idx][bBarZ]-0.7, 3000+idx, BizzInfo[idx][bInterior]);
		BizBarLabel[idx] = CreateDynamic3DTextLabel("{ff9000}Заказ еды {cccccc}[ ALT ]",-1,BizzInfo[idx][bBarX],BizzInfo[idx][bBarY],BizzInfo[idx][bBarZ]-0.5,3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,3000+idx, BizzInfo[idx][bInterior]); 
	}
	return 1;
}
public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
	if(CallPublic(playerid, 24)) return false;

	new panels, vehdoors, vehlights, tires;
	GetVehicleDamageStatus(vehicleid, VEHICLE_PANEL_STATUS:panels, VEHICLE_DOOR_STATUS:vehdoors, VEHICLE_LIGHT_STATUS:vehlights, VEHICLE_TYRE_STATUS:tires);

	new Float:vehHealth;
	GetVehicleHealth(vehicleid, vehHealth);
	if(vehHealth > 0.0)
	{
		if(panels == 0 && VehInfo[vehicleid][vPanels] != 0 // || vehdoors == 0 && VehInfo[vehicleid][vDoors] != 0 Двери временно офнул ибо когда они открываются, игроков кикает
		|| tires == 0 && VehInfo[vehicleid][vTires] != 0) // || vehlights == 0 && VehInfo[vehicleid][vFara] != 0 Фары офнул, игроки используют стробоскопы и мигалки, их кикает
		{
			if(VehInfo[vehicleid][vRepairFix] == false)
			{
				SendClientMessage(playerid, -1, "[SProtect Kick]: RepairVehicle [panels %d %d, vehdoors %d %d, vehlights %d %d, tires %d %d]",
				panels, VehInfo[vehicleid][vPanels], vehdoors, VehInfo[vehicleid][vDoors], vehlights, VehInfo[vehicleid][vFara], tires, VehInfo[vehicleid][vTires]);

				SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [RepairVehicle]");
				ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [RepairVehicle]","*","");
				printf("[SProtect Kick]: RepairVehicle %s [panels %d %d, vehdoors %d %d, vehlights %d %d, tires %d %d] vehHealth %f",PlayerInfo[playerid][pName], 
				panels, VehInfo[vehicleid][vPanels], vehdoors, VehInfo[vehicleid][vDoors], vehlights, VehInfo[vehicleid][vFara], tires, VehInfo[vehicleid][vTires],
				vehHealth);
				Kickx(playerid);
				return 1;
			}
			else VehInfo[vehicleid][vRepairFix] = false;
		}
	}

	GetVehicleDamageStatus(vehicleid, VEHICLE_PANEL_STATUS:VehInfo[vehicleid][vPanels], VEHICLE_DOOR_STATUS:VehInfo[vehicleid][vDoors], VEHICLE_LIGHT_STATUS:VehInfo[vehicleid][vFara], VEHICLE_TYRE_STATUS:VehInfo[vehicleid][vTires]);

	// Проверка повреждений во время гонки с домиником
	if(OnlineInfo[playerid][oDominicRace] > 0) Dominic_CheckDamageVehicle(playerid, vehicleid);

	/*if(panels == 0 && vehdoors == 0 && tires == 0) // && vehlights == 0 Флуд фарами засунул в исключение
	{
		if(protect[3] == 0 || protect[3] == 1)
		{
			prote[3][playerid] ++;
			if(prote[3][playerid] >= 4)
			{
				if(protect[3] == 0)
				{
					SendClientMessage(playerid, COLOR_LIGHTRED, "* {0066ff}Protect Project: {FF6347}Вы были кикнуты по подозрению в читерстве [Flood Component]");
					ShowDialog(playerid,1700,DIALOG_STYLE_MSGBOX,"{ff0000}Protect Project","{ff0000}Вы были кикнуты по подозрению в читерстве [Flood Component]","*","");
					printf("[SProtect Kick]: Flood Component %s",PlayerInfo[playerid][pName]);
					Kickx(playerid);
					return 1;
				}
				else if(protect[3] == 1) 
				{
					new string[50];
					format(string, sizeof(string), " [ PP ]: %s[%d] Flood Component", PlayerInfo[playerid][pName], playerid);
					ABroadCast(COLOR_ADM,string,2);
				}
			}
		}
	}*/
	return 1;
}

public bool: OnNpcGiveDamageNpc(NPC:npc, NPC:damager, Float:amount, weaponid, bodypart)
{
	if (Pet_OnNpcGiveDamageNpc(npc, damager, amount, weaponid, bodypart)) return false;
	return true;
}
public bool: OnPlayerGiveDamageNpc(NPC:npc, damagerid, Float:amount, weaponid, bodypart)
{
	// Запрет на урон по NPC с транспорта
	if(Protect_Veh[damagerid] != 9999)
    {
        new vehicleid = Protect_Veh[damagerid];
        if(IsShootingVehicle(VehInfo[vehicleid][vModel])) return false;
    }

	if((weaponid == 38 || weaponid == 36 || weaponid == 35) && server > 0) return false; // Блокируем урон по ботам с запрещённого оружия на основном сервере

	new Aks = HasABustAks(damagerid,2);
	if(Aks != -1) amount *= float(ResultCountBustAks(PlayerInfo[damagerid][pOdet][Aks],2,PlayerInfo[damagerid][pOdetPara][Aks]))/100.0+1.0;

	if(GetPlayerLoadPet(damagerid) > 0)
	{
		for(new pet = 0; pet < MAX_PETS_AT_PLAYER; pet++)
		{
			if(OnlineInfo[damagerid][oPet][pet] == -1) continue;
			PetTaskAttacNPC(OnlineInfo[damagerid][oPet][pet],npc);
		}
	}

	if (!MineWar_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!Tomb_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!Village_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!Maniac_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!Graves_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!Pennivize_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!PennivizeWalker_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!WildAnimals_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!NewYearQuestOne_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!NarcoFarmBattle_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;
	if (!Pet_OnPlayerGiveDamageNpc(npc, damagerid, amount, weaponid, bodypart)) return false;

	return true;
}

function SavePlayerArmorNpc(playerid)
{
	if (!IsOnline(playerid)) return false;
	return GetPlayerArmour(playerid, PlayerInfo[playerid][pArmor]);
}

public OnPlayerTakeDamageNpc(NPC:npc, issuerid, Float:amount, weaponid, bodypart)
{
	SetTimerEx("SavePlayerArmorNpc", 500, false, "d", issuerid); // Сохраняем состояние брони при получении урона от NPC

	if(GetPlayerLoadPet(issuerid) > 0)
	{
		for(new pet = 0; pet < MAX_PETS_AT_PLAYER; pet++)
		{
			if(OnlineInfo[issuerid][oPet][pet] == -1) continue;
			PetTaskAttacNPC(OnlineInfo[issuerid][oPet][pet],npc);
		}
	}

	if (KatanaDuel_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	if (Graves_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;

	if (!MineWar_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	if (!Tomb_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	if (!Village_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	if (!Pennivize_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	if (!WildAnimals_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	if (!Pet_OnPlayerTakeDamageNpc(npc, issuerid, amount, weaponid, bodypart)) return false;
	return 1;
}

public OnNpcDeath(NPC:npc, killerid, reason)
{
	if(killerid == INVALID_PLAYER_ID) return true;
	// Убили бота в Катана Дуэли
	if(OnDeathKatanaDuel(npc, killerid)) return true;

	// Убили деревенского бота
    if(SetSpawnVillageNpc(npc, killerid)) return true;

    // Убили бота маньяка
    if(OnDeathManiacNpc(npc, killerid)) return true;

	// Убили Джейсона
	if(OnDeathJasonNpc(npc, killerid)) return true;

	// Обработка убийств для заброшенной шахты
	if(MineWar_OnNpcDeath(npc, killerid, reason)) return true;

	// Обработка убийств для гробницы фараона
	if(Tomb_OnNpcDeath(npc, killerid, reason)) return true;

	if(OnlineInfo[killerid][oNewYearQuest] == 1 && NewYearQuestOne_OnNpcDeath(npc, killerid, reason)) return true;
	return 1;
}

public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
	if(GetVehicleDistanceFromPoint(vehicleid, new_x, new_y, new_z) > 10.0
		|| passenger_seat > 0)
	{
		new Float:vehicle_pos[3];
    	GetVehiclePos(vehicleid, vehicle_pos[0], vehicle_pos[1], vehicle_pos[2]);
		ACSetVehiclePos(vehicleid, vehicle_pos[0], vehicle_pos[1], vehicle_pos[2]);
		return false;
	}

	if(Cars[vehicleid] != 9999)
	{
		new Float:health;
		GetVehicleHealth(vehicleid, health);
		if(health < 400.0) ACSetVehicleHealth(vehicleid,400.0);
	}
	return false;
}

